+// A revolute joint with AngleDriven on is turned to its Angle (an expression such as
+// Params.theta drives a crank): solved as a fixed joint whose first placement is turned by
+// the angle about its z axis.
+bool isAngleDriven(const App::DocumentObject* joint)
+{
+    if (!joint || getJointType(joint) != JointType::Revolute) {
+        return false;
+    }
+    auto* driven = joint->getPropertyByName<App::PropertyBool>("AngleDriven");
+    return driven && driven->getValue();
+}
+
+Base::Placement jointPlacementFromProp(App::DocumentObject* joint, const char* plcName)
+{
+    Base::Placement plc = App::GeoFeature::getPlacementFromProp(joint, plcName);
+    if (std::strcmp(plcName, "Placement1") == 0 && isAngleDriven(joint)) {
+        auto* angle = joint->getPropertyByName<App::PropertyFloat>("Angle");
+        const double a = angle ? Base::toRadians(angle->getValue()) : 0.0;
+        plc = plc * Base::Placement(Base::Vector3d(), Base::Rotation(Base::Vector3d(0, 0, 1), a));
+    }
+    return plc;
+}
+
