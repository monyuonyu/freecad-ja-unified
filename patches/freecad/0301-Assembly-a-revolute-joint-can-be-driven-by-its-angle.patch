     }
 
-    return App::GeoFeature::getGlobalPlacement(nullptr, ref)
-        * App::GeoFeature::getPlacementFromProp(joint, plcName);
+    return App::GeoFeature::getGlobalPlacement(nullptr, ref) * jointPlacementFromProp(joint, plcName);
 }
 
