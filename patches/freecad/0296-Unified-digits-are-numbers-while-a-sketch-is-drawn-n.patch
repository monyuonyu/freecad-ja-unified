From 20c977cc08a9bd5deb63b6b436233af4099dcf62 Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Fri, 23 Oct 2026 08:53:30 +0900
Subject: [PATCH 296/333] Unified: digits are numbers while a sketch is drawn,
 never the standard views

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/Mod/Unified/UnifiedChrome.py | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/src/Mod/Unified/UnifiedChrome.py b/src/Mod/Unified/UnifiedChrome.py
index c377ff3ae..2f331c26c 100644
--- a/src/Mod/Unified/UnifiedChrome.py
+++ b/src/Mod/Unified/UnifiedChrome.py
@@ -624,6 +624,24 @@ def one_key_command(event):
     return KEYS[text]
 
 
+def _digit_while_sketching(event):
+    if event.modifiers() & ~QtCore.Qt.KeypadModifier:
+        return False
+    text = event.text()
+    if len(text) != 1 or not (text.isdigit() or text in ".-"):
+        return False
+    app = QtWidgets.QApplication.instance()
+    if typing_text(app.focusWidget()):
+        return False
+    gdoc = Gui.ActiveDocument
+    try:
+        vp = gdoc.getInEdit() if gdoc is not None else None
+    except Exception:
+        vp = None
+    obj = getattr(vp, "Object", None) if vp is not None else None
+    return obj is not None and obj.isDerivedFrom("Sketcher::SketchObject")
+
+
 # More filters of the same events (one Python filter for the whole application, not one each)
 EXTRA_FILTERS = []
 
@@ -636,6 +654,11 @@ class KeyFilter(QtCore.QObject):
             for f in EXTRA_FILTERS:
                 if f.eventFilter(obj, event):
                     return True
+        if t == QtCore.QEvent.ShortcutOverride and isinstance(obj, QtWidgets.QWidget) and _digit_while_sketching(event):
+            # While a sketch is drawn the digits are numbers (a size being typed), never the
+            # standard views "1"…"6" (engine field test 0.6.9: typing 1 or 3 turned the view)
+            event.accept()
+            return False
         if t == QtCore.QEvent.ShortcutOverride and isinstance(obj, QtWidgets.QWidget):
             name = one_key_command(event)
             if name:
