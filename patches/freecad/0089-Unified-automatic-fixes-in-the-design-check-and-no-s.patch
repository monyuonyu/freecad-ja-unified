+# ------------------------------------------------------------------ 自動で直す
+def _movable(o):
+    """位置を動かして直してよい物か: 配置があり、何かに取り付けられておらず、式で決まっていない"""
+    if o is None or not hasattr(o, "Placement"):
+        return False
+    if "ReadOnly" in o.getPropertyStatus("Placement"):
+        return False
+    if getattr(o, "MapMode", "Deactivated") != "Deactivated" and getattr(o, "AttachmentSupport", None):
+        return False
+    try:
+        if any(p.startswith("Placement") for p, _ in o.ExpressionEngine):
+            return False
+    except Exception:
+        pass
+    return True
+
+
+def _move_global(o, delta):
+    """物を全体の座標で delta だけ動かす（App::Part の中でも正しい向きに）"""
+    parent = o.getGlobalPlacement().multiply(o.Placement.inverse())
+    local = parent.Rotation.inverted().multVec(delta)
+    pl = o.Placement
+    pl.Base = pl.Base + local
+    o.Placement = pl
+
+
+def _global_shape(o):
+    import Part
+    s = Part.getShape(o, "", needSubElement=False, transform=False).copy()
+    s.Placement = o.getGlobalPlacement()
+    return s
+
+
+def _fix_redundant(doc, issue):
+    sk = doc.getObject(issue.objects[0])
+    n = len(sk.RedundantConstraints)
+    sk.autoRemoveRedundants()
+    return translate("DesignCheck", "Deleted {0} constraints in {1}").format(n, sk.Label)
+
+
+def _fix_conflict_last(doc, issue):
+    # ぶつかる拘束のうち、いちばん後に足したもの（たいてい今足した寸法）を消す。番号は 1 から
+    sk = doc.getObject(issue.objects[0])
+    last = max(sk.ConflictingConstraints)
+    sk.delConstraint(last - 1)
+    return translate("DesignCheck", "Deleted constraint {0} in {1}").format(last, sk.Label)
+
+
+def _fix_malformed(doc, issue):
+    sk = doc.getObject(issue.objects[0])
+    ids = sorted(sk.MalformedConstraints, reverse=True)
+    for i in ids:
+        sk.delConstraint(i - 1)
+    return translate("DesignCheck", "Deleted {0} constraints in {1}").format(len(ids), sk.Label)
+
+
+def _fix_snap(doc, issue):
+    """浮いた部品を、いちばん近い部品に接するまで（最短の向きに）動かす"""
+    o = doc.getObject(issue.objects[0])
+    me = _global_shape(o)
+    best = None
+    for n, s in parts(doc).items():
+        if n == o.Name:
+            continue
+        d, pairs, _ = me.distToShape(s)
+        if best is None or d < best[0]:
+            best = (d, pairs[0], doc.getObject(n))
+    if best is None:
+        raise ValueError(translate("DesignCheck", "There is no other part to move it to"))
+    d, (p_me, p_other), other = best
+    _move_global(o, p_other - p_me)
+    return translate("DesignCheck", "Moved {0} by {1:.2f} mm onto {2}").format(o.Label, d, other.Label)
+
+
+def _fix_separate(doc, issue):
+    """重なった 2 つのうち小さい方（動かせる方）を、重なりが無くなるいちばん短い向きへ動かす"""
+    a, b = (doc.getObject(n) for n in issue.objects)
+    sa, sb = _global_shape(a), _global_shape(b)
+    if _movable(a) and (not _movable(b) or sa.Volume <= sb.Volume):
+        mover, ms, other = a, sa, sb
+    else:
+        mover, ms, other = b, sb, sa
+    common = ms.common(other).BoundBox
+    tol = DEFAULTS["interference_mm3"]
+    tries = []
+    for ax, ext in zip((App.Vector(1, 0, 0), App.Vector(0, 1, 0), App.Vector(0, 0, 1)),
+                       (common.XLength, common.YLength, common.ZLength)):
+        for sign in (1, -1):
+            tries.append((ext, ax * sign))
+    tries.sort(key=lambda t: t[0])
+    for ext, direction in tries:
+        # 重なりの厚みだけ動かしても離れない形（斜めの面など）では、少しずつ延ばす
+        for scale in (1.0, 1.5, 2.5, 4.0):
+            delta = direction * (ext * scale)
+            moved = ms.copy()
+            moved.translate(delta)
+            if moved.common(other).Volume <= tol:
+                _move_global(mover, delta)
+                return translate("DesignCheck", "Moved {0} by {1:.2f} mm").format(mover.Label, delta.Length)
+    raise ValueError(translate("DesignCheck", "Could not find a short move that separates them"))
+
+
+def _fix_delete_view(doc, issue):
+    o = doc.getObject(issue.objects[0])
+    label = o.Label
+    doc.removeObject(o.Name)
+    return translate("DesignCheck", "Deleted {0}").format(label)
+
+
+# 直し方: 名前 → (ボタンの説明, 関数)
+FIXES = {
+    "remove_redundant": (QT_TRANSLATE_NOOP("DesignCheck", "Delete the constraints that say the same thing twice"),
+                         _fix_redundant),
+    "remove_conflict_last": (QT_TRANSLATE_NOOP("DesignCheck", "Delete the last added of the contradicting constraints"),
+                             _fix_conflict_last),
+    "remove_malformed": (QT_TRANSLATE_NOOP("DesignCheck", "Delete the malformed constraints"), _fix_malformed),
+    "snap": (QT_TRANSLATE_NOOP("DesignCheck", "Move it until it touches the nearest part"), _fix_snap),
+    "separate": (QT_TRANSLATE_NOOP("DesignCheck", "Move the smaller part the shortest way out of the other"),
+                 _fix_separate),
+    "delete_view": (QT_TRANSLATE_NOOP("DesignCheck", "Delete the empty view"), _fix_delete_view),
+}
+
+
+def fix(doc, issue):
+    """issue を自動で直して、したことの説明を返す。直せなければ ValueError。元に戻す単位は呼ぶ側で開く"""
+    if issue.fix is None:
+        raise ValueError(translate("DesignCheck", "This problem cannot be fixed automatically"))
+    msg = FIXES[issue.fix][1](doc, issue)
+    doc.recompute()
+    return msg
+
+
+def fix_all(doc, **options):
+    """直せるものを 1 つずつ直す（1 つ直すと他の結果も変わるので、そのたびに検査し直す）。
+    したことを [{"ok": 直せたか, "message": 説明}] で返す"""
+    done = []
+    tried = set()
+    for _ in range(50):
+        todo = [i for i in run(doc, **options)
+                if i.fix is not None and (i.rule, tuple(i.objects)) not in tried]
+        if not todo:
+            break
+        i = todo[0]
+        tried.add((i.rule, tuple(i.objects)))
+        try:
+            done.append({"ok": True, "message": fix(doc, i)})
+        except Exception as e:
+            done.append({"ok": False, "message": "{0} ({1})".format(i.message, e)})
+    return done
+
