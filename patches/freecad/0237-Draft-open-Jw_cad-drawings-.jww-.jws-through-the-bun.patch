index 000000000..669f5b2d3
--- /dev/null
+++ b/src/Mod/Draft/importJWW.py
@@ -0,0 +1,99 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+
+# -*- coding: utf8 -*-
+## @package importJWW
+#  \ingroup DRAFT
+#  \brief Jw_cad (JWW) file importer
+"""
+@package importJWW
+ingroup DRAFT
+\brief Jw_cad (JWW/JWS) file importer
+
+Jw_cad is a Japanese freeware 2D CAD. Its drawings (.jww) and registered
+symbols (.jws) are converted to DXF with the jww2dxf converter
+(https://github.com/monyuonyu/jww-tools), then imported by importDXF,
+like importDWG does with DWG files.
+
+The converter is looked up in the parameter Mod/Draft/JWWConverter, next to
+the FreeCAD executable (bundled) and in the search path.
+"""
+import os
+import sys
+
+import FreeCAD
+from FreeCAD import Console as FCC
+
+if FreeCAD.GuiUp:
+    from draftutils.translate import translate
+else:
+    def translate(context, txt):
+        return txt
+
+
+def get_jww2dxf():
+    """Return the path of the jww2dxf converter, or None."""
+    import shutil
+
+    exe = "jww2dxf.exe" if os.name == "nt" else "jww2dxf"
+    grp = FreeCAD.ParamGet("User parameter:BaseApp/Preferences/Mod/Draft")
+    path = grp.GetString("JWWConverter", "")
+    if path and os.path.isfile(path):
+        return path
+    for d in (os.path.join(FreeCAD.getHomePath(), "bin"), os.path.dirname(os.path.abspath(sys.executable))):
+        path = os.path.join(d, exe)
+        if os.path.isfile(path):
+            return path
+    return shutil.which("jww2dxf")
+
+
+def convertToDxf(filename):
+    """Convert a JWW/JWS file to a temporary DXF file and return its path (or None)."""
+    import subprocess
+    import tempfile
+
+    conv = get_jww2dxf()
+    if not conv:
+        FCC.PrintError(translate("draft", "jww2dxf (the Jw_cad converter) was not found.") + "\n")
+        FCC.PrintError(translate("draft", "Install it from https://github.com/monyuonyu/jww-tools and set its path in the parameter Mod/Draft/JWWConverter.") + "\n")
+        return None
+    outdir = tempfile.mkdtemp()
+    base = os.path.splitext(os.path.basename(filename))[0]
+    dxf = os.path.join(outdir, base + ".dxf")
+    FCC.PrintMessage(translate("draft", "Converting:") + " " + filename + "\n")
+    # UTF-8 DXF (R2007): FreeCAD's DXF reader reads it without a code page conversion
+    flags = 0x08000000 if os.name == "nt" else 0  # CREATE_NO_WINDOW: no console window flashing
+    proc = subprocess.run([conv, "--utf8", filename, dxf], capture_output=True, creationflags=flags)
+    err = proc.stderr.decode("utf-8", "replace").strip()
+    if err:
+        FCC.PrintWarning(err + "\n")
+    if proc.returncode not in (0, 3) or not os.path.isfile(dxf):
+        FCC.PrintError(translate("draft", "Error during JWW conversion.") + "\n")
+        return None
+    FCC.PrintMessage(translate("draft", "Conversion successful") + "\n")
+    return dxf
+
+
+def open(filename):
+    """Open a Jw_cad drawing as a new document (via importDXF.open())."""
+    dxf = convertToDxf(filename)
+    if dxf:
+        import importDXF
+
+        doc = importDXF.open(dxf)
+        doc = doc or FreeCAD.ActiveDocument
+        if doc:
+            # name the document after the drawing, not the temporary DXF
+            name = os.path.splitext(os.path.basename(filename))[0]
+            doc.Label = name
+        return doc
+    return None
+
+
+def insert(filename, docname):
+    """Import a Jw_cad drawing into the document docname (via importDXF.insert())."""
+    dxf = convertToDxf(filename)
+    if dxf:
+        import importDXF
+
+        return importDXF.insert(dxf, docname)
+    return None
