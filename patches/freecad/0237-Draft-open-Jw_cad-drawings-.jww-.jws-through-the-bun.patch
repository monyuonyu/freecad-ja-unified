From 8206e945675d40820401acbf01057f1ccc9cca3c Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Tue, 20 Oct 2026 09:04:36 +0900
Subject: [PATCH 237/269] Draft: open Jw_cad drawings (.jww/.jws) through the
 bundled jww2dxf

importJWW converts with jww2dxf (github.com/monyuonyu/jww-tools) to a
UTF-8 DXF and imports it with importDXF, like importDWG does. The
converter is taken from Mod/Draft/JWWConverter, the bin folder of the
installation, or the search path. The bundles copy jww2dxf from JWW_BIN.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 package/bundle/linux/create_bundle.sh   |  9 +++
 package/bundle/windows/create_bundle.sh |  8 ++
 src/Mod/Draft/CMakeLists.txt            |  1 +
 src/Mod/Draft/Init.py                   |  1 +
 src/Mod/Draft/importJWW.py              | 99 +++++++++++++++++++++++++
 5 files changed, 118 insertions(+)
 create mode 100644 src/Mod/Draft/importJWW.py

diff --git a/package/bundle/linux/create_bundle.sh b/package/bundle/linux/create_bundle.sh
index 77f7d4550..610adb63e 100755
--- a/package/bundle/linux/create_bundle.sh
+++ b/package/bundle/linux/create_bundle.sh
@@ -113,6 +113,15 @@ if [ -n "${LIBREDWG_BIN:-}" ]; then
   case "${dwg_out}" in *dwg2dxf*) ;; *) echo "The bundled dwg2dxf does not start."; exit 1 ;; esac
 fi
 
+# Jw_cad の図面（.jww/.jws）: jww-tools の jww2dxf（静的リンク）を同梱する。Draft/importJWW.py が使う
+if [ -n "${JWW_BIN:-}" ]; then
+  cp "${JWW_BIN}/jww2dxf" "${conda_env}/bin/"
+  chmod +x "${conda_env}/bin/jww2dxf"  # the artifact upload drops the permissions
+  jww_out=$("${conda_env}/bin/jww2dxf" --version 2>&1 | head -1)
+  echo "jww-tools: ${jww_out}"
+  case "${jww_out}" in *jww2dxf*) ;; *) echo "The bundled jww2dxf does not start."; exit 1 ;; esac
+fi
+
 find . -name "*.h" -type f -delete
 find . -name "*.cmake" -type f -delete
 
diff --git a/package/bundle/windows/create_bundle.sh b/package/bundle/windows/create_bundle.sh
index 0250c47aa..080ac2ee2 100644
--- a/package/bundle/windows/create_bundle.sh
+++ b/package/bundle/windows/create_bundle.sh
@@ -79,6 +79,14 @@ if [ -n "${LIBREDWG_BIN:-}" ]; then
   case "${dwg_out}" in *dwg2dxf*) ;; *) echo "The bundled dwg2dxf does not start."; exit 1 ;; esac
 fi
 
+# Jw_cad の図面（.jww/.jws）: jww-tools の jww2dxf（静的リンク）を同梱する。Draft/importJWW.py が使う
+if [ -n "${JWW_BIN:-}" ]; then
+  cp "${JWW_BIN}/jww2dxf.exe" "${copy_dir}/bin/"
+  jww_out=$("${copy_dir}/bin/jww2dxf.exe" --version 2>&1 | head -1)
+  echo "jww-tools: ${jww_out}"
+  case "${jww_out}" in *jww2dxf*) ;; *) echo "The bundled jww2dxf does not start."; exit 1 ;; esac
+fi
+
 # Turn off the echo before we start actually calling "echo"
 set +x
 
