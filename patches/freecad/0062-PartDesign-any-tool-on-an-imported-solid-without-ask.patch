+PartDesign::Body* adoptPickedLooseSolid()
+{
+    auto selection = Gui::Selection().getSelectionEx();
+    if (selection.size() != 1 || selection.front().getSubNames().empty()) {
+        return nullptr;
+    }
+    App::DocumentObject* solid = selection.front().getObject();
+    const std::vector<std::string> elements = selection.front().getSubNames();
+    if (!solid || !solid->isDerivedFrom<Part::Feature>() || solid->isDerivedFrom<PartDesign::Feature>()
+        || solid->isDerivedFrom<Part::Part2DObject>() || PartDesign::Body::findBodyOf(solid)) {
+        return nullptr;
+    }
+    Gui::Application::Instance->commandManager().runCommandByName("PartDesign_Body");
+    PartDesign::Body* body = nullptr;
+    App::Document* doc = solid->getDocument();
+    for (App::DocumentObject* obj : doc->getObjectsOfType(PartDesign::FeatureBase::getClassTypeId())) {
+        auto* base = static_cast<PartDesign::FeatureBase*>(obj);
+        if (base->BaseFeature.getValue() != solid) {
+            continue;
+        }
+        body = PartDesign::Body::findBodyOf(base);
+        doc->recompute();
+        Gui::Selection().clearSelection();
+        for (const std::string& element : elements) {
+            Gui::Selection().addSelection(doc->getName(), base->getNameInDocument(), element.c_str());
+        }
+        break;
+    }
+    return body;
+}
+
 PartDesign::Body* makeBody(App::Document* doc)
 {
     bool allowCompound = PartDesign::PartDesignParameter::instance()->getAllowCompoundDefault();
