diff --git a/src/Gui/MenuManager.cpp b/src/Gui/MenuManager.cpp
index b37071a5e..ba0e5c340 100644
--- a/src/Gui/MenuManager.cpp
+++ b/src/Gui/MenuManager.cpp
@@ -363,7 +363,11 @@ void MenuManager::retranslate(QMenu* menu) const
     QByteArray menuName = menu->menuAction()->data().toByteArray();
     Command* cmd = mgr.getCommandByName(menuName);
     if (cmd) {
-        menu->setTitle(QApplication::translate(cmd->className(), cmd->getMenuText()));
+        // Python commands use their name as translation context (see
+        // PythonGroupCommand::languageChange), C++ commands their class name
+        bool isPython = dynamic_cast<PythonCommand*>(cmd) || dynamic_cast<PythonGroupCommand*>(cmd);
+        const char* context = isPython ? cmd->getName() : cmd->className();
+        menu->setTitle(QApplication::translate(context, cmd->getMenuText()));
     }
     else {
         menu->setTitle(QApplication::translate("Workbench", (const char*)menuName));
