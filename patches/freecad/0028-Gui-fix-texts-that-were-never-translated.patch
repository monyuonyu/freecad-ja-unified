From 2d11c297fe1098b30cc9a8b980e78ccfbff1c957 Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Sun, 27 Sep 2026 02:25:33 +0900
Subject: [PATCH 28/68] Gui: fix texts that were never translated
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- Tooltips of Std_ToggleTransparency, Std_SelectionBack/Forward and
  Std_ToggleFreeze were wrapped in <p> before the lookup, so they never
  matched their translations; the tooltip is laid out by Action anyway.
- Menu titles of group commands (e.g. Assembly's Insert Component) were
  retranslated with the C++ class name as context; Python commands use
  their command name as context, as PythonGroupCommand::languageChange
  already does. The submenu title also follows later text changes of
  its action.
- The window list entries were looked up in the QObject context instead
  of the command's.
- In the integrated environment, tooltips no longer end with the internal
  command name (Std_New, PartDesign_Pad, ...).
- Japanese: fix "FreeCAに寄付する", and a tooltip that named a command by
  its internal name.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/Gui/Action.cpp             | 10 +++++++++-
 src/Gui/CommandFeat.cpp        | 15 +++++----------
 src/Gui/CommandView.cpp        | 21 ++++++---------------
 src/Gui/CommandWindow.cpp      |  5 ++++-
 src/Gui/Language/FreeCAD_ja.ts |  4 ++--
 src/Gui/MenuManager.cpp        |  6 +++++-
 6 files changed, 31 insertions(+), 30 deletions(-)

diff --git a/src/Gui/Action.cpp b/src/Gui/Action.cpp
index 97677e201..8e694e4cb 100644
--- a/src/Gui/Action.cpp
+++ b/src/Gui/Action.cpp
@@ -20,6 +20,7 @@
  *                                                                         *
  ***************************************************************************/
 
+#include <App/Application.h>
 #include <QActionEvent>
 #include <QActionGroup>
 #include <QApplication>
@@ -346,7 +347,9 @@ QString Action::createToolTip(
                           .arg(text.toHtmlEscaped(), shortcut.toHtmlEscaped());
 
     QString cmdName;
-    if (command && command->getName()) {
+    // The internal command name helps macro writers; the integrated environment is for
+    // modelling and leaves it out of the tooltips
+    if (command && command->getName() && !App::Application::Config().contains("SingleWorkbench")) {
         cmdName = QString::fromLatin1(command->getName());
         if (auto groupcmd = dynamic_cast<const GroupCommand*>(command)) {
             if (auto act = command->getAction()) {
@@ -464,6 +467,11 @@ void ActionGroup::addTo(QWidget* widget)
             item->setMenuRole(action()->menuRole());
             menu->setTitle(action()->text());
             menu->addActions(groupAction()->actions());
+            // Keep the submenu title in step with the action, e.g. when its translation is
+            // (re)loaded after the menu was built
+            QObject::connect(action(), &QAction::changed, menu, [this, menu]() {
+                menu->setTitle(action()->text());
+            });
 
             QObject::connect(menu, &QMenu::aboutToShow, [this, menu]() { Q_EMIT aboutToShow(menu); });
 
