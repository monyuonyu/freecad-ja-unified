diff --git a/src/Gui/CommandWindow.cpp b/src/Gui/CommandWindow.cpp
index 994b284f8..398d17e8b 100644
--- a/src/Gui/CommandWindow.cpp
+++ b/src/Gui/CommandWindow.cpp
@@ -483,7 +483,10 @@ Action* StdCmdWindowsMenu::createAction()
     WindowAction* pcAction;
     pcAction = new WindowAction(this, getMainWindow());
     for (int i = 0; i < 10; i++) {
-        QAction* window = pcAction->addAction(QObject::tr(getToolTipText()));
+        // The text is declared in this command's context (QT_TR_NOOP in the constructor)
+        QAction* window = pcAction->addAction(
+            QCoreApplication::translate(this->className(), getToolTipText())
+        );
         window->setCheckable(true);
         window->setToolTip(QCoreApplication::translate(this->className(), getToolTipText()));
         window->setStatusTip(QCoreApplication::translate(this->className(), getStatusTip()));
