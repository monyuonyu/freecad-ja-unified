+class HoleTest(unittest.TestCase):
+    def check_coaxial(self, placement, hole, toward=-1):
+        """The fastener's Z axis lies on the hole's axis"""
+        o = placement.multVec(App.Vector(0, 0, 0))
+        z = placement.Rotation.multVec(App.Vector(0, 0, toward))
+        self.assertAlmostEqual(abs(z.dot(hole.direction)), 1, places=9)
+        d = o - hole.entry
+        self.assertLess((d - hole.direction * d.dot(hole.direction)).Length, 1e-7)
+
+    def test_clearance_over_tapped_block(self):
+        """An M6 clearance hole in a 10 mm plate on a block with an M6 tapped blind hole 15 deep"""
+        plate = _plate((40, 40, 10), (0, 0, 30), [(20, 20, 6.6, None, None)])
+        block = _plate((40, 40, 30), (0, 0, 0), [(20, 20, 5.0, 15, None)])
+        hole = PS.analyze_hole(_cyl_face(plate, 6.6), [("plate", plate), ("block", block)])
+        self.assertEqual(hole.metric.name, "M6")
+        self.assertEqual(hole.role, "clear")
+        self.assertAlmostEqual(hole.clamp, 10, places=6)
+        self.assertAlmostEqual(hole.thread, 15, places=6)
+        self.assertTrue(hole.blind)
+        self.assertAlmostEqual(hole.entry.z, 40, places=6)
+        self.assertAlmostEqual(hole.direction.z, -1, places=9)
+        plan = PS.plan_for_hole(hole)
+        self.assertEqual(plan.kind, "socket_head")
+        self.assertEqual(plan.length, 20)  # 10 held + 1.5 d of thread → 19 → 20
+        screw = plan.items[0]
+        self.check_coaxial(screw.placement, hole)
+        self.assertAlmostEqual(screw.placement.Base.z, 40, places=6)  # the head on the plate
+        # The screw does not reach the bottom of the tapped hole (40 - 20 = 20 > 15)
+        self.assertGreater(40 - plan.length, 30 - 15)
+
