+# -*- coding: utf-8 -*-
+###############################################################################
+#
+#  FastenerSearch.py
+#
+#  Copyright 2025 Shai Seger <shaise at gmail dot com>
+#  BSP modifications (c) 2025-2026 Andrey Bekhterev <info at bekhterev dot in>
