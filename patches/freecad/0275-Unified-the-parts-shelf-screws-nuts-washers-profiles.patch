+
+    if FsUseGetSetState:  # compatibility with old versions
+        FreeCAD.Console.PrintLog("Using old getstate/setstate system\n")
+
+        def __setstate__(self, state):
+            self.loads(state)
+
+        def __getstate__(self):
+            return self.dumps()
