+# -*- coding: utf-8 -*-
+###############################################################################
+#
+#  ScrewCalc.py
+#  A calculator utility to calculate needed hole sizes for selected fasteners
+#
+#  Copyright 2015 Shai Seger <shaise at gmail dot com>
