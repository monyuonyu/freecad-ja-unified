+def _plate(size=(40, 40, 10), at=(0, 0, 0), holes=()):
+    """A plate with holes: [(x, y, diameter, depth from the top or None for through, cbore)]"""
+    box = Part.makeBox(size[0], size[1], size[2], App.Vector(*at))
+    top = at[2] + size[2]
+    cuts = []
+    for x, y, d, depth, cbore in holes:
+        h = size[2] + 2 if depth is None else depth
+        cuts.append(Part.makeCylinder(d / 2, h, App.Vector(x, y, top - h + (1 if depth is None else 0))))
+        if cbore:
+            cuts.append(Part.makeCylinder(cbore[0] / 2, cbore[1] + 1, App.Vector(x, y, top - cbore[1])))
+    return box.cut(cuts) if cuts else box
+
+
+def _cyl_face(shape, diameter, at_z=None):
+    best = None
+    for f in shape.Faces:
+        if isinstance(f.Surface, Part.Cylinder) and abs(2 * f.Surface.Radius - diameter) < 1e-6:
+            if at_z is None or f.BoundBox.ZMin - 1e-6 <= at_z <= f.BoundBox.ZMax + 1e-6:
+                best = f
+                break
+    return best
