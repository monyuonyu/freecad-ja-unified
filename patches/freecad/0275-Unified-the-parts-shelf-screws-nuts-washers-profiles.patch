+
+class FSStudObject(FSScrewObject):
+    def onDocumentRestored(self, obj):
+        self.originalType = "PEMStud"
+        super().onDocumentRestored(obj)
+
+
+class FSPcbStandOffObject(FSScrewObject):
+    def onDocumentRestored(self, obj):
