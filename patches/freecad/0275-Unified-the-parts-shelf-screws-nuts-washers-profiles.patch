+                    obj.Length = origLen
+            if addCustomLen:
+                obj.addProperty("App::PropertyLength", "LengthCustom", "Parameters", translate(
+                    "FastenerCmd", "Custom length")).LengthCustom = self.inswap(slens[0])
+
+        # number of starts
