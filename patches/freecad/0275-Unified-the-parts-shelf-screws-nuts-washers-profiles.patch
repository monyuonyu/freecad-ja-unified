+# The Fasteners workbench by Shai Seger (https://github.com/shaise/FreeCAD_FastenersWB),
+# bundled unchanged with the integrated environment: GPL-2.0-or-later (see LICENSE here).
+# Its files are the add-on's own at the commit in BUNDLED_FROM; only the runtime files are
+# kept (no screenshots, documentation sources or tests). The parts shelf of the integrated
+# environment (Mod/Unified/PartsShelf.py) uses it to make the screws, nuts and washers.
+
+file(GLOB_RECURSE Fasteners_Files RELATIVE "${CMAKE_CURRENT_SOURCE_DIR}"
+    "${CMAKE_CURRENT_SOURCE_DIR}/*.py"
+    "${CMAKE_CURRENT_SOURCE_DIR}/*.ui"
+    "${CMAKE_CURRENT_SOURCE_DIR}/*.csv"
+    "${CMAKE_CURRENT_SOURCE_DIR}/*.svg"
+    "${CMAKE_CURRENT_SOURCE_DIR}/*.qm"
+    "${CMAKE_CURRENT_SOURCE_DIR}/*.ts"
+)
+list(APPEND Fasteners_Files LICENSE README.md package.xml BUNDLED_FROM)
+
+add_custom_target(FastenersScripts ALL SOURCES ${Fasteners_Files})
+fc_copy_sources(FastenersScripts "${CMAKE_BINARY_DIR}/Mod/Fasteners" ${Fasteners_Files})
+
+foreach(f ${Fasteners_Files})
+    get_filename_component(dir "${f}" DIRECTORY)
+    install(FILES "${f}" DESTINATION "Mod/Fasteners/${dir}")
+endforeach()
