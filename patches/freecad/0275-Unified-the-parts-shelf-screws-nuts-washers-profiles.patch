index 000000000..0401931de
--- /dev/null
+++ b/src/Mod/Fasteners/FsFunctions/FSmakeSelfTappingScrew.py
@@ -0,0 +1,145 @@
+# -*- coding: utf-8 -*-
+"""
+***************************************************************************
+*   Copyright (c) 2023, 2024                                              *
+*   Original code by:                                                     *
+*   hasecilu <hasecilu[at]tuta.io>                                        *
+*                                                                         *
+*   This file is a supplement to the FreeCAD CAx development system.      *
+*                                                                         *
