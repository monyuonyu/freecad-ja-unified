+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""The parts shelf (部品の棚): standard screws, nuts and washers, aluminium extrusion profiles and
+the company's own parts, put into the model with a click.
+
+No GUI here (PartsShelfGui.py does the clicking; TestPartsShelf.py tests this file headless):
+
+- the screws, nuts and washers by their Japanese standard (JIS B 1176 …) in M3–M12. The shapes
+  are made by the bundled Fasteners workbench (Mod/Fasteners, GPL-2.0-or-later, by Shai Seger),
+  the spring washer here;
+- what a hole is for (tap drill, clearance hole, counterbore, countersink → the M size), how
+  long the screw has to be (the plates it holds and the thread it goes into, also of other
+  parts on the same axis) and where it goes (coaxial, by SnapMath.snap_move);
+- generic aluminium extrusion profiles (20/30/40 series, slot 6/8) from public, generic
+  dimensions — no maker's data;
+- the company's own parts: folders of FCStd/STEP files with an optional index (shelf.csv).
+
+What is put into a document: one hidden original per kind and size (a plain Part::Feature with
+the shape, in the group "Shelf parts", with the properties a parts list needs), and a link to it
+wherever it is used. A parts list (Assembly's BOM) counts the links of an original as its
+quantity, and the file opens without the Fasteners workbench.
+"""
+
+import csv
+import math
+import os
+
+import FreeCAD as App
+
+import SnapMath
+
+TOL = 1e-6
+
+
+def translate(context, text):
+    try:
+        return App.Qt.translate(context, text)
+    except Exception:
+        return text
+
+
+def QT_TRANSLATE_NOOP(context, text):
+    return text
+
+
+def japanese():
+    """The names of new things in Japanese (the interface is Japanese, or the system is)."""
+    lang = App.ParamGet("User parameter:BaseApp/Preferences/General").GetString("Language", "")
+    if lang:
+        return lang.startswith("Japanese")
+    loc = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or ""
+    if loc.startswith("ja"):
+        return True
+    try:
+        import locale
+
+        return (locale.getlocale()[0] or "").lower().startswith(("ja", "japanese"))
+    except Exception:
+        return False
+
+
+# --------------------------------------------------------------------------- sizes
+class Metric:
+    """Dimensions of one metric size (coarse thread), from the public standards: JIS B 1001
+    (clearance holes, classes 1–3), the usual tap drills and counterbores for hexagon socket head
+    cap screws, JIS B 1176 / ISO 4762 heads, JIS B 1181 / ISO 4032 nuts, JIS B 1256 / ISO 7089
+    washers and JIS B 1251 spring washers (general, type 2)."""
+
+    def __init__(self, name, d, pitch, tap, clear, cbore, head, nut_m, washer_h, spring, csink):
+        self.name = name
+        self.d = d
+        self.pitch = pitch
+        self.tap = tap  # tap drill
+        self.clear = clear  # clearance hole, classes 1, 2, 3
+        self.cbore = cbore  # counterbore (diameter, depth)
+        self.head = head  # socket head diameter
+        self.nut_m = nut_m  # nut height
+        self.washer_h = washer_h  # plain washer thickness
+        self.spring = spring  # spring washer (inner diameter, width, thickness)
+        self.csink = csink  # countersunk head diameter (ISO 10642, theoretical)
+
+    def __repr__(self):
+        return "Metric({})".format(self.name)
+
+
+SIZES = [
+    Metric("M3", 3, 0.5, 2.5, (3.2, 3.4, 3.6), (6.5, 3.3), 5.5, 2.4, 0.5, (3.1, 1.1, 0.7), 6.72),
+    Metric("M4", 4, 0.7, 3.3, (4.3, 4.5, 4.8), (8.0, 4.4), 7.0, 3.2, 0.8, (4.1, 1.4, 1.0), 8.96),
+    Metric("M5", 5, 0.8, 4.2, (5.3, 5.5, 5.8), (9.5, 5.4), 8.5, 4.7, 1.0, (5.1, 1.7, 1.3), 11.2),
+    Metric("M6", 6, 1.0, 5.0, (6.4, 6.6, 7.0), (11.0, 6.5), 10.0, 5.2, 1.6, (6.1, 2.7, 1.5), 13.44),
+    Metric("M8", 8, 1.25, 6.8, (8.4, 9.0, 10.0), (14.0, 8.6), 13.0, 6.8, 1.6, (8.2, 3.2, 2.0), 17.92),
+    Metric("M10", 10, 1.5, 8.5, (10.5, 11.0, 12.0), (17.5, 10.8), 16.0, 8.4, 2.0, (10.2, 3.7, 2.5), 22.4),
+    Metric("M12", 12, 1.75, 10.2, (13.0, 13.5, 14.5), (20.0, 13.0), 18.0, 10.8, 2.5, (12.2, 4.2, 3.0), 26.88),
+]
+SIZE = {m.name: m for m in SIZES}
+
+
+# --------------------------------------------------------------------------- kinds
+class Kind:
+    """A kind of fastener on the shelf"""
+
+    def __init__(self, key, en, ja, standard, fasteners_type, group, length=True, washer=False):
+        self.key = key
+        self.en = en
+        self.ja = ja
+        self.standard = standard  # the Japanese standard (the ISO one in iso)
+        self.fasteners_type = fasteners_type  # type name of the Fasteners workbench (None: made here)
+        self.group = group
+        self.length = length
+        self.washer = washer
+
+    @property
+    def iso(self):
+        t = self.fasteners_type or ""
+        return "ISO " + t[3:] if t.startswith("ISO") else ""
+
+    def name(self):
+        return self.ja if japanese() else self.en
+
+    def __repr__(self):
+        return "Kind({})".format(self.key)
+
+
+G_SCREW = QT_TRANSLATE_NOOP("PartsShelf", "Screws and bolts")
+G_NUT = QT_TRANSLATE_NOOP("PartsShelf", "Nuts")
+G_WASHER = QT_TRANSLATE_NOOP("PartsShelf", "Washers")
+G_SET = QT_TRANSLATE_NOOP("PartsShelf", "Set screws")
+G_PROFILE = QT_TRANSLATE_NOOP("PartsShelf", "Aluminium profiles")
+G_COMPANY = QT_TRANSLATE_NOOP("PartsShelf", "Company parts")
+
+KINDS = [
+    Kind("socket_head", "Hexagon socket head cap screw", "六角穴付きボルト", "JIS B 1176", "ISO4762", G_SCREW),
+    Kind("hex_bolt_full", "Hexagon head screw (fully threaded)", "六角ボルト（全ねじ）", "JIS B 1180", "ISO4017", G_SCREW),
+    Kind("hex_bolt", "Hexagon head bolt (partly threaded)", "六角ボルト（半ねじ）", "JIS B 1180", "ISO4014", G_SCREW),
+    Kind("countersunk", "Hexagon socket countersunk head screw", "六角穴付き皿ボルト", "JIS B 1194", "ISO10642", G_SCREW),
+    Kind("hex_nut", "Hexagon nut (style 1)", "六角ナット（1種）", "JIS B 1181", "ISO4032", G_NUT, length=False),
+    Kind("plain_washer", "Plain washer", "平座金", "JIS B 1256", "ISO7089", G_WASHER, length=False, washer=True),
+    Kind("spring_washer", "Spring lock washer", "ばね座金", "JIS B 1251", None, G_WASHER, length=False, washer=True),
+    Kind("set_flat", "Hexagon socket set screw, flat point", "六角穴付き止めねじ（平先）", "JIS B 1177", "ISO4026", G_SET),
+    Kind("set_cup", "Hexagon socket set screw, cup point", "六角穴付き止めねじ（くぼみ先）", "JIS B 1177", "ISO4029", G_SET),
+]
+KIND = {k.key: k for k in KINDS}
+
+# The screws whose head sits on the surface (the others are flush with it)
+HEADED = ("socket_head", "hex_bolt_full", "hex_bolt")
+
+
+def size_label(size, length=None):
+    if length:
+        return "{}×{:g}".format(size, float(length))
+    return size
+
+
+def fastener_label(kind_key, size, length=None):
+    """"六角穴付きボルト M6×20" (in English "Hexagon socket head cap screw M6×20")"""
+    return "{} {}".format(KIND[kind_key].name(), size_label(size, length if KIND[kind_key].length else None))
+
+
+# --------------------------------------------------------------------------- the shapes
+_fasteners_doc = None
+_shape_cache = {}
+
+
+def fasteners_available():
+    try:
+        import FastenersCmd  # noqa: F401
+
+        return True
+    except Exception:
+        return False
+
+
+def _fasteners_object(ftype):
+    """An object of the Fasteners workbench in a hidden document of its own (to make shapes)"""
+    global _fasteners_doc
+    import FastenersCmd
+
+    if _fasteners_doc is None or _fasteners_doc.Name not in App.listDocuments():
+        _fasteners_doc = App.newDocument("PartsShelfMaker", hidden=True, temp=True)
+    obj = _fasteners_doc.getObject(ftype)
+    if obj is None:
+        obj = _fasteners_doc.addObject("Part::FeaturePython", ftype)
+        FastenersCmd.FSScrewObject(obj, ftype, None)
+    return obj
+
+
+def standard_lengths(kind_key, size):
+    """The standard lengths of a screw of this kind and size (mm), shortest first"""
+    kind = KIND[kind_key]
+    if not kind.length or not kind.fasteners_type:
+        return []
+    import ScrewMaker
+
+    try:
+        lengths = ScrewMaker.Instance.GetAllLengths(kind.fasteners_type, size, False)
+    except Exception:
+        return []
+    out = []
+    for text in lengths:
+        try:
+            out.append(float(text))
+        except ValueError:
+            pass
+    return sorted(set(out))
+
+
+def _single_solid(shape):
+    if shape.ShapeType == "Compound" and len(shape.Solids) == 1:
+        return shape.Solids[0].copy()
+    return shape.copy()
+
+
+def fastener_shape(kind_key, size, length=None):
+    """The shape of a fastener: axis Z, the screw's head on z >= 0 and its shank toward -Z (a
+    countersunk screw and a set screw end flush at z = 0); a nut or a washer lies on z = 0 and
+    goes toward +Z."""
+    kind = KIND[kind_key]
+    key = (kind_key, size, float(length) if length and kind.length else None)
+    if key in _shape_cache:
+        return _shape_cache[key].copy()
+    if kind_key == "spring_washer":
+        shape = spring_washer_shape(size)
+    else:
+        if size not in SIZE:
+            raise ValueError("unknown size " + size)
+        obj = _fasteners_object(kind.fasteners_type)
+        obj.Diameter = size
+        obj.Document.recompute()
+        if kind.length:
+            text = "{:g}".format(float(length))
+            if text in obj.getEnumerationsOfProperty("Length"):
+                obj.Length = text
+            else:
+                obj.Length = "Custom"
+                obj.LengthCustom = float(length)
+            obj.Document.recompute()
+        shape = _single_solid(obj.Shape)
+    if shape.isNull() or not shape.isValid():
+        raise ValueError("could not make {} {}".format(kind_key, size_label(size, length)))
+    _shape_cache[key] = shape
+    return shape.copy()
+
+
+def spring_washer_shape(size):
+    """A spring lock washer (JIS B 1251, general): a split ring of rectangular section on z = 0"""
+    import Part
+
+    m = SIZE[size]
+    d1, b, t = m.spring
+    outer = Part.makeCylinder(d1 / 2 + b, t)
+    inner = Part.makeCylinder(d1 / 2, t)
+    ring = outer.cut(inner)
+    # The split: a slot as wide as the washer is thick, slanted like the real one
+    gap = Part.makeBox(b + 2, t * 0.6, t * 3, App.Vector(d1 / 2 - 1, -t * 0.3, -t))
+    gap.rotate(App.Vector(d1 / 2 + b / 2, 0, t / 2), App.Vector(1, 0, 0), 25)
+    return _single_solid(ring.cut(gap))
+
+
+# --------------------------------------------------------------------------- profiles
+class Profile:
+    """A generic aluminium extrusion profile: a square of `size` with a T-slot in each side and a
+    bore in the middle. The dimensions are generic ones (what profiles of the series have in
+    common in public catalogues), not any maker's drawing."""
+
+    def __init__(self, key, size, slot, lip, cavity, depth, bore):
+        self.key = key
+        self.size = size
+        self.slot = slot  # nominal slot (6, 8)
+        self.lip = lip  # wall thickness at the opening
+        self.cavity = cavity  # width of the T inside
+        self.depth = depth  # depth of the slot from the outside
+        self.bore = bore  # bore in the middle (to tap for an end screw)
+
+    @property
+    def opening(self):
+        return self.slot + 0.2
+
+    def name(self):
+        if japanese():
+            return "アルミフレーム {0:g}×{0:g} 溝{1:g}".format(self.size, self.slot)
+        return "Aluminium profile {0:g}×{0:g} slot {1:g}".format(self.size, self.slot)
+
+
+PROFILES = [
+    Profile("20-6", 20, 6, 1.8, 11.0, 6.1, 4.2),
+    Profile("30-6", 30, 6, 2.0, 13.0, 7.5, 6.8),
+    Profile("30-8", 30, 8, 2.2, 16.5, 9.0, 6.8),
+    Profile("40-8", 40, 8, 4.3, 20.0, 12.2, 6.8),
+]
+PROFILE = {p.key: p for p in PROFILES}
+
+
+def profile_label(key, length):
+    return "{} L={:g}".format(PROFILE[key].name(), float(length))
+
+
+def _slot_outline(p):
+    """The T-slot of the side y = +size/2 as a closed polygon, open to the outside"""
+    h = p.size / 2
+    o, c = p.opening / 2, p.cavity / 2
+    lip = p.lip
+    bottom = h - p.depth
+    taper = min((c - o), (h - lip - bottom) * 0.6)
+    pts = [
+        (-o, h + 1), (-o, h - lip), (-c, h - lip), (-c, bottom + taper), (-o, bottom),
+        (o, bottom), (c, bottom + taper), (c, h - lip), (o, h - lip), (o, h + 1),
+    ]
+    return [App.Vector(x, y, 0) for x, y in pts] + [App.Vector(pts[0][0], pts[0][1], 0)]
+
+
+def profile_section(key):
+    import Part
+
+    p = PROFILE[key]
+    h = p.size / 2
+    square = Part.Face(Part.makePolygon([App.Vector(-h, -h, 0), App.Vector(h, -h, 0), App.Vector(h, h, 0),
+                                         App.Vector(-h, h, 0), App.Vector(-h, -h, 0)]))
+    slot = Part.Face(Part.makePolygon(_slot_outline(p)))
+    cut = [slot.copy()]
+    for angle in (90, 180, 270):
+        s = slot.copy()
+        s.rotate(App.Vector(0, 0, 0), App.Vector(0, 0, 1), angle)
+        cut.append(s)
+    bore = Part.Face(Part.Wire(Part.makeCircle(p.bore / 2)))
+    face = square.cut(cut + [bore])
+    faces = face.Faces
+    if len(faces) != 1:
+        raise ValueError("profile section of {} is not one face".format(key))
+    # Rounded outer corners would need fillets on a 2D face; the corners stay square (generic)
+    return faces[0]
+
+
+def profile_shape(key, length):
+    """The profile along +Z from z = 0 to z = length, the section centred on the Z axis"""
+    length = float(length)
+    if length <= 0:
+        raise ValueError("the length must be more than 0")
+    cache = ("profile", key, length)
+    if cache in _shape_cache:
+        return _shape_cache[cache].copy()
+    shape = profile_section(key).extrude(App.Vector(0, 0, length))
+    shape = _single_solid(shape)
+    _shape_cache[cache] = shape
+    return shape.copy()
+
+
+def profile_placement(key, a, b, face_normal=None):
+    """The placement of a profile from a to b. If a is on a flat face (its outward normal given)
+    and the profile runs along that face, it lies on the face instead of half in it."""
+    a, b = App.Vector(a), App.Vector(b)
+    d = b - a
+    if d.Length < TOL:
+        raise ValueError("the two points are the same")
+    d.normalize()
+    rot = SnapMath._rotation_between(App.Vector(0, 0, 1), d)
+    # Turn about the axis so that the section is square to the face (or to the global Z)
+    up = App.Vector(face_normal) if face_normal is not None else App.Vector(0, 0, 1)
+    if abs(up.dot(d)) > 1 - 1e-6:
+        up = App.Vector(1, 0, 0) if abs(d.x) < 0.9 else App.Vector(0, 1, 0)
+    y = rot.multVec(App.Vector(0, 1, 0))
+    want = up - d * up.dot(d)
+    want.normalize()
+    angle = math.degrees(math.atan2(y.cross(want).dot(d), y.dot(want)))
+    rot = App.Rotation(d, angle).multiply(rot)
+    base = App.Vector(a)
+    if face_normal is not None:
+        n = App.Vector(face_normal)
+        n.normalize()
+        if abs(n.dot(d)) < 1e-6:
+            base = base + n * (PROFILE[key].size / 2)
+    return App.Placement(base, rot)
+
+
+# --------------------------------------------------------------------------- holes
+CLEAR_MARGIN = 0.5  # a clearance hole up to this much wider than class 3 is still one
+
+
+def roles_of(diameter, m):
+    """What a hole of this diameter is for a screw of size m: a list of (role, how far off)"""
+    out = []
+    if abs(diameter - m.tap) <= 0.25:
+        out.append(("tap", abs(diameter - m.tap)))
+    if abs(diameter - m.d) <= 0.06:
+        out.append(("thread", abs(diameter - m.d) + 0.02))
+    if m.d + 0.1 < diameter <= m.clear[2] + CLEAR_MARGIN:
+        near = min(abs(diameter - c) for c in m.clear)
+        # class 3 is the last choice (it is also the clearance of a smaller screw's thread)
+        extra = 0.05 if abs(diameter - m.clear[2]) <= near + 1e-9 and abs(diameter - m.clear[1]) > near + 1e-9 else 0
+        out.append(("clear", near + extra))
+    if abs(diameter - m.cbore[0]) <= 0.8 or (m.head + 0.3 <= diameter <= m.head + 3.0):
+        out.append(("cbore", abs(diameter - m.cbore[0])))
+    return out
+
+
+def suggest_size(diameter):
+    """The M size for a hole of this diameter: (Metric, role, note) or (None, None, "").
+
+    role: "tap" (a tap drill: the screw goes into it), "thread" (a threaded hole drawn at the
+    nominal diameter), "clear" (a clearance hole: the screw goes through), "cbore" (a
+    counterbore for a socket head)."""
+    best = None
+    for m in SIZES:
+        for role, off in roles_of(diameter, m):
+            if role == "cbore":
+                continue  # a counterbore alone does not tell the size well
+            rank = (off, {"tap": 0, "thread": 1, "clear": 2}[role], m.d)
+            if best is None or rank < best[0]:
+                best = (rank, m, role)
+    if best is None:
+        return None, None, ""
+    m, role = best[1], best[2]
+    note = {
+        "tap": QT_TRANSLATE_NOOP("PartsShelf", "tap drill of {}"),
+        "thread": QT_TRANSLATE_NOOP("PartsShelf", "thread of {}"),
+        "clear": QT_TRANSLATE_NOOP("PartsShelf", "clearance hole of {}"),
+    }[role]
+    return m, role, translate("PartsShelf", note).format(m.name)
+
+
+class Piece:
+    """A round hole (or countersink) on the axis: from t0 to t1 along the axis, its diameter (a
+    cone: the larger one) and the object it is in."""
+
+    def __init__(self, t0, t1, diameter, cone=False, owner=None, d_small=None):
+        self.t0, self.t1 = min(t0, t1), max(t0, t1)
+        self.diameter = diameter
+        self.cone = cone
+        self.owner = owner
+        self.d_small = d_small if d_small is not None else diameter
+
+    @property
+    def length(self):
+        return self.t1 - self.t0
+
+    def __repr__(self):
+        return "Piece({:.3f}..{:.3f}, ⌀{:.3f}{}, {})".format(self.t0, self.t1, self.diameter,
+                                                            " cone" if self.cone else "", self.owner)
+
+
+def _axis_of(element):
+    """(point on the axis, unit axis, diameter) of a cylindrical face or a circular edge"""
+    import Part
+
+    if element.ShapeType == "Face":
+        s = element.Surface
+        if isinstance(s, Part.Cylinder):
+            axis = App.Vector(s.Axis)
+            axis.normalize()
+            return App.Vector(s.Center), axis, 2 * s.Radius
+        return None
+    if element.ShapeType == "Edge":
+        c = element.Curve
+        if isinstance(c, (Part.Circle, Part.ArcOfCircle)):
+            axis = App.Vector(c.Axis)
+            axis.normalize()
+            return _center(c), axis, 2 * c.Radius
+    return None
+
+
+def _center(curve):
+    return App.Vector(curve.Location if hasattr(curve, "Location") else curve.Center)
+
+
+def is_hole(element, solid=None):
+    """A cylindrical face whose material is outside (a hole), or a circle edge of one"""
+    import Part
+
+    ax = _axis_of(element)
+    if ax is None:
+        return False
+    origin, axis, diameter = ax
+    if element.ShapeType == "Face":
+        return _concave(element, origin, axis)
+    # A circle edge: a hole if the solid has a hole face on it
+    if solid is None:
+        return True
+    for f in solid.Faces:
+        if isinstance(f.Surface, Part.Cylinder) and abs(2 * f.Surface.Radius - diameter) < 1e-4:
+            o2, a2, _ = _axis_of(f)
+            if _coaxial(origin, axis, o2, a2) and _concave(f, o2, a2):
+                return True
+    return False
+
+
+def _concave(face, origin, axis):
+    try:
+        u0, u1, v0, v1 = face.ParameterRange
+        u, v = (u0 + u1) / 2, (v0 + v1) / 2
+        p = face.valueAt(u, v)
+        n = face.normalAt(u, v)
+    except Exception:
+        return False
+    radial = p - origin - axis * (p - origin).dot(axis)
+    return n.dot(radial) < 0
+
+
+def _coaxial(o1, a1, o2, a2, tol=1e-3):
+    if abs(abs(a1.dot(a2)) - 1) > 1e-6:
+        return False
+    d = o2 - o1
+    return (d - a1 * d.dot(a1)).Length < tol
+
+
+def pieces_on_axis(shape, origin, axis, owner=None):
+    """The hole pieces of a shape on this axis (cylinders and countersink cones)"""
+    import Part
+
+    out = []
+    if not shape.BoundBox.isInside(origin) and not _line_hits_box(shape.BoundBox, origin, axis):
+        return out
+    for f in shape.Faces:
+        s = f.Surface
+        if isinstance(s, Part.Cylinder):
+            a = App.Vector(s.Axis)
+            a.normalize()
+            if not _coaxial(origin, axis, App.Vector(s.Center), a) or not _concave(f, App.Vector(s.Center), a):
+                continue
+            ts = [(App.Vector(v.Point) - origin).dot(axis) for v in f.Vertexes] or [0]
+            for e in f.Edges:
+                ts.append((e.CenterOfMass - origin).dot(axis))
+            out.append(Piece(min(ts), max(ts), 2 * s.Radius, owner=owner))
+        elif isinstance(s, Part.Cone):
+            a = App.Vector(s.Axis)
+            a.normalize()
+            if not _coaxial(origin, axis, App.Vector(s.Apex), a):
+                continue
+            circles = [e for e in f.Edges if isinstance(e.Curve, (Part.Circle, Part.ArcOfCircle))]
+            if not circles:
+                continue
+            ts = [(_center(e.Curve) - origin).dot(axis) for e in circles]
+            ds = [2 * e.Curve.Radius for e in circles]
+            if max(ds) - min(ds) < 1e-6:
+                continue
+            # A countersink opens toward the outside: its material is outside the cone
+            if not _concave(f, origin, axis):
+                continue
+            out.append(Piece(min(ts), max(ts), max(ds), cone=True, owner=owner, d_small=min(ds)))
+    return out
+
+
+def _line_hits_box(bb, origin, axis):
+    try:
+        b = App.BoundBox(bb)
+        b.enlarge(1e-3)
+        return b.intersect(origin, axis)
+    except Exception:
+        return True
+
+
+def _merge(pieces, gap=0.05):
+    """Pieces in order along the axis; the same hole split in faces (two half cylinders) made one"""
+    out = []
+    for p in sorted(pieces, key=lambda p: (p.t0, p.diameter)):
+        for q in out:
+            if q.cone == p.cone and abs(q.diameter - p.diameter) < 1e-4 and p.t0 <= q.t1 + 1e-6 and q.owner == p.owner:
+                q.t1 = max(q.t1, p.t1)
+                q.t0 = min(q.t0, p.t0)
+                break
+        else:
+            out.append(Piece(p.t0, p.t1, p.diameter, p.cone, p.owner, p.d_small))
+    return sorted(out, key=lambda p: (p.t0, p.t1))
+
+
+def _run_around(pieces, t_pick, gap=0.05):
+    """The pieces that touch each other in a row along the axis, through the picked place"""
+    run = [p for p in pieces if p.t0 - gap <= t_pick <= p.t1 + gap]
+    if not run:
+        return []
+    lo = min(p.t0 for p in run)
+    hi = max(p.t1 for p in run)
+    changed = True
+    while changed:
+        changed = False
+        for p in pieces:
+            if p in run:
+                continue
+            if p.t1 >= lo - gap and p.t0 <= hi + gap:
+                run.append(p)
+                lo, hi = min(lo, p.t0), max(hi, p.t1)
+                changed = True
+    return sorted(run, key=lambda p: (p.t0, p.t1))
+
+
+class Hole:
+    """What was found about a picked hole: where a screw goes in and what it goes through.
+
+    entry: the point on the axis where the hole opens (global); direction: into the hole.
+    metric/role: the size and what the picked hole is for (see suggest_size).
+    pieces: [(start, end, role, diameter)] along the direction, from the entry (mm).
+    seat: where a head sits (after a counterbore); clamp: what the screw holds (clearance holes);
+    thread: the length of thread it can go into; blind: the hole ends in material;
+    through: the length to the far end (for a nut)."""
+
+    def __init__(self):
+        self.entry = None
+        self.direction = None
+        self.diameter = 0.0
+        self.metric = None
+        self.role = None
+        self.note = ""
+        self.pieces = []
+        self.seat = 0.0
+        self.clamp = 0.0
+        self.thread = 0.0
+        self.blind = False
+        self.through = 0.0
+        self.countersink = False
+        self.counterbore = False
+        self.parts = []  # labels of the parts the screw goes through
+
+    def point(self, t):
+        return self.entry + self.direction * t
+
+    def describe(self):
+        tr = lambda s: translate("PartsShelf", s)
+        bits = ["⌀{:g}".format(round(self.diameter, 2))]
+        if self.note:
+            bits.append(self.note)
+        if self.counterbore:
+            bits.append(tr("counterbore"))
+        if self.countersink:
+            bits.append(tr("countersink"))
+        if self.clamp > 1e-6:
+            bits.append(tr("holds {:g} mm").format(round(self.clamp, 2)))
+        if self.thread > 1e-6:
+            bits.append(tr("thread {:g} mm deep").format(round(self.thread, 2)))
+        bits.append(tr("blind") if self.blind else tr("through"))
+        return ", ".join(bits)
+
+    def __repr__(self):
+        return "Hole({}, {}, seat={:.2f}, clamp={:.2f}, thread={:.2f}, blind={}, through={:.2f})".format(
+            self.metric.name if self.metric else None, self.role, self.seat, self.clamp, self.thread,
+            self.blind, self.through)
+
+
+def _inside_any(solids, p):
+    for s in solids:
+        try:
+            if s.isInside(p, 1e-6, True):
+                return True
+        except Exception:
+            pass
+    return False
+
+
+def _end_open(solids, origin, axis, t, outward, radius):
+    """Whether the hole ends open at t (nothing just beyond, around the hole)"""
+    probe = []
+    side = App.Vector(1, 0, 0) if abs(axis.x) < 0.9 else App.Vector(0, 1, 0)
+    side = side - axis * side.dot(axis)
+    side.normalize()
+    other = axis.cross(side)
+    for v in (side, other, -side, -other):
+        probe.append(origin + axis * (t + outward * 0.05) + v * (radius * 0.5))
+    probe.append(origin + axis * (t + outward * 0.05))
+    return not any(_inside_any(solids, p) for p in probe)
+
+
+def analyze_hole(element, shapes, point=None, view_direction=None):
+    """What a picked hole is for. element: the picked cylindrical face or circle edge (global);
+    shapes: [(label, global shape)] of the parts that may be on the same axis (the picked part
+    among them). point: where it was clicked; view_direction: where the camera looks (a through
+    hole is entered from the side the camera sees). Returns a Hole, or None if it is no hole."""
+    ax = _axis_of(element)
+    if ax is None:
+        return None
+    origin, axis, picked_d = ax
+    pieces = []
+    solids = []
+    for label, shape in shapes:
+        if shape is None or shape.isNull():
+            continue
+        solids.extend(shape.Solids)
+        pieces.extend(pieces_on_axis(shape, origin, axis, label))
+    pieces = _merge(pieces)
+    if element.ShapeType == "Edge":
+        t_pick = (_center(element.Curve) - origin).dot(axis)
+    else:
+        ts = [(App.Vector(v.Point) - origin).dot(axis) for v in element.Vertexes]
+        t_pick = (min(ts) + max(ts)) / 2 if ts else 0.0
+    if not any(abs(p.diameter - picked_d) < 1e-4 and p.t0 - 0.05 <= t_pick <= p.t1 + 0.05 for p in pieces if not p.cone):
+        return None  # not a hole of these parts (e.g. a shaft)
+    run = _run_around(pieces, t_pick)
+    lo = min(p.t0 for p in run)
+    hi = max(p.t1 for p in run)
+    open_lo = _end_open(solids, origin, axis, lo, -1, max(p.diameter for p in run if p.t0 <= lo + 1e-6) / 2)
+    open_hi = _end_open(solids, origin, axis, hi, +1, max(p.diameter for p in run if p.t1 >= hi - 1e-6) / 2)
+    # The entry: the open end (both open: the one the camera sees, else the one clicked near)
+    if open_lo and not open_hi:
+        from_lo = True
+    elif open_hi and not open_lo:
+        from_lo = False
+    elif view_direction is not None and abs(App.Vector(view_direction).dot(axis)) > 1e-3:
+        from_lo = App.Vector(view_direction).dot(axis) > 0
+    elif element.ShapeType == "Edge":
+        from_lo = abs(t_pick - lo) <= abs(t_pick - hi)
+    elif point is not None:
+        t = (App.Vector(point) - origin).dot(axis)
+        from_lo = abs(t - lo) <= abs(t - hi)
+    else:
+        from_lo = True
+    hole = Hole()
+    hole.direction = App.Vector(axis) if from_lo else -App.Vector(axis)
+    hole.entry = origin + axis * (lo if from_lo else hi)
+    hole.blind = not (open_lo and open_hi)
+    hole.through = hi - lo
+    hole.diameter = picked_d
+    # Along the direction, from the entry
+    along = []
+    for p in run:
+        a, b = (p.t0 - lo, p.t1 - lo) if from_lo else (hi - p.t1, hi - p.t0)
+        along.append((a, b, p))
+    along.sort(key=lambda x: (x[0], x[1]))
+
+    # The size: the one for which most of the hole's length has a role, the picked piece too
+    best = None
+    for m in SIZES:
+        if not roles_of(picked_d, m):
+            continue
+        matched, off, roles = 0.0, 0.0, []
+        for a, b, p in along:
+            if p.cone:
+                role = "csink" if m.d < p.diameter <= m.csink + 3 and p.d_small <= m.clear[2] + CLEAR_MARGIN else None
+                r_off = 0.0
+            else:
+                rs = roles_of(p.diameter, m)
+                if a > 1e-6:
+                    rs = [r for r in rs if r[0] != "cbore"] or rs  # a counterbore only at the entry
+                rs.sort(key=lambda r: r[1])
+                role, r_off = (rs[0] if rs else (None, 0.0))
+            roles.append((a, b, role, p))
+            if role is not None:
+                matched += b - a
+                off += r_off
+        rank = (-round(matched, 6), off, m.d)
+        if best is None or rank < best[0]:
+            best = (rank, m, roles)
+    if best is None:
+        return None
+    m, roles = best[1], best[2]
+    hole.metric = m
+    picked_roles = [r for r, _ in sorted(roles_of(picked_d, m), key=lambda r: r[1])]
+    hole.role = picked_roles[0] if picked_roles else None
+    if hole.role == "cbore":
+        hole.role = "clear"
+    hole.note = {
+        "tap": translate("PartsShelf", "tap drill of {}"),
+        "thread": translate("PartsShelf", "thread of {}"),
+        "clear": translate("PartsShelf", "clearance hole of {}"),
+    }.get(hole.role, "{}").format(m.name)
+    hole.pieces = [(a, b, role, p.diameter) for a, b, role, p in roles]
+    # Where the head sits, what is held, how much thread there is (in this order from the entry)
+    seat = 0.0
+    i = 0
+    while i < len(roles) and roles[i][2] in ("cbore", "csink"):
+        if roles[i][2] == "cbore":
+            hole.counterbore = True
+            seat = roles[i][1]
+        else:
+            hole.countersink = True
+        i += 1
+    hole.seat = seat
+    clamp_end = seat
+    parts = []
+    while i < len(roles) and roles[i][2] == "clear":
+        clamp_end = max(clamp_end, roles[i][1])
+        if roles[i][3].owner not in parts:
+            parts.append(roles[i][3].owner)
+        i += 1
+    hole.clamp = max(0.0, clamp_end - seat)
+    thread_start = clamp_end
+    thread_end = thread_start
+    while i < len(roles) and roles[i][2] in ("tap", "thread"):
+        thread_end = max(thread_end, roles[i][1])
+        if roles[i][3].owner not in parts:
+            parts.append(roles[i][3].owner)
+        i += 1
+    hole.thread = thread_end - thread_start
+    hole.parts = parts
+    return hole
+
+
+# --------------------------------------------------------------------------- what goes in
+class Item:
+    """One thing to put: a kind and size (and length), where (global placement)"""
+
+    def __init__(self, kind, size, length, placement):
+        self.kind = kind
+        self.size = size
+        self.length = length
+        self.placement = placement
+
+    def label(self):
+        return fastener_label(self.kind, self.size, self.length)
+
+    def __repr__(self):
+        return "Item({}, {}, {}, {})".format(self.kind, self.size, self.length, self.placement)
+
+
+def pick_length(lengths, need, most=None):
+    """The shortest standard length of at least `need`, not longer than `most`; if none, the
+    longest one up to `most`"""
+    if not lengths:
+        return None
+    ok = [l for l in lengths if l >= need - 1e-6 and (most is None or l <= most + 1e-6)]
+    if ok:
+        return ok[0]
+    if most is not None:
+        below = [l for l in lengths if l <= most + 1e-6]
+        if below:
+            return below[-1]
+    return [l for l in lengths if l >= need - 1e-6][0] if any(l >= need - 1e-6 for l in lengths) else lengths[-1]
+
+
+def default_kind(hole):
+    if hole.countersink:
+        return "countersunk"
+    if hole.thread > 1e-6 or hole.counterbore:
+        return "socket_head"
+    return "hex_bolt_full"
+
+
+class Plan:
+    """The screw (and washers, nut) for a hole, with their placements"""
+
+    def __init__(self, hole, kind, size, length, washers, nut, plate, items, needed):
+        self.hole = hole
+        self.kind = kind
+        self.size = size
+        self.length = length
+        self.washers = washers
+        self.nut = nut
+        self.plate = plate
+        self.items = items
+        self.needed = needed  # the length the screw would need (before rounding to a standard one)
+
+
+def _place(direction_in_shape, origin_in_shape, hole_direction, at):
+    """The placement that puts a shape's axis (direction_in_shape, through origin_in_shape) on the
+    hole's axis, pointing along hole_direction, with origin_in_shape at `at` (SnapMath)."""
+    a = SnapMath.Feature("axis", direction_in_shape, origin_in_shape, origin_in_shape)
+    b = SnapMath.Feature("axis", hole_direction, at, at)
+    flip = a.direction.dot(b.direction) < 0
+    return SnapMath.snap_move(a, b, flip=flip)
+
+
+def plan_for_hole(hole, kind=None, size=None, length=None, washers=None, nut=None, plate=0.0):
+    """What to put into the hole: kind (default from the hole), size (from the hole), length
+    (from what it holds and the thread; else the given one), plain + spring washer under the head
+    (washers), a nut on the far side (nut: default for a bolt through clearance holes only), and
+    `plate`: the thickness of a plate on top that is not modelled (the head sits that much higher)."""
+    kind = kind or default_kind(hole)
+    m = SIZE[size] if size else hole.metric
+    k = KIND[kind]
+    headed = kind in HEADED
+    if washers is None:
+        washers = False
+    if nut is None:
+        nut = headed and hole.thread <= 1e-6 and not hole.blind
+    if not headed:
+        washers = False
+    plate = float(plate or 0.0)
+    items = []
+    n = hole.direction
+    lengths = standard_lengths(kind, m.name)
+    seat = hole.seat - plate  # where the head (or the washers) sit, from the entry
+    under = 0.0
+    if washers:
+        under = m.washer_h + m.spring[2]
+    held = hole.clamp + plate + under
+    needed = None
+    if kind == "countersunk":
+        held = hole.clamp + plate
+        seat = -plate
+    if not k.length:
+        chosen = None
+    elif length:
+        chosen = float(length)
+    elif kind in ("set_flat", "set_cup"):
+        most = hole.thread if hole.thread > 1e-6 else (hole.clamp + hole.thread or None)
+        needed = min(1.5 * m.d, most) if most else 1.5 * m.d
+        chosen = pick_length(lengths, needed, most)
+        seat = hole.seat + hole.clamp
+    elif hole.thread > 1e-6:
+        engage = min(1.5 * m.d, hole.thread - (0.5 if hole.blind else 0.0))
+        needed = held + max(engage, 0.0)
+        most = held + hole.thread - (0.5 if hole.blind else 0.0) if hole.blind else held + hole.thread + 2 * m.d
+        chosen = pick_length(lengths, needed, most)
+    elif nut:
+        needed = held + m.washer_h * (1 if washers else 0) + m.nut_m + 2 * m.pitch
+        chosen = pick_length(lengths, needed)
+    else:
+        needed = held + 1.5 * m.d
+        chosen = pick_length(lengths, needed)
+    if k.length and chosen is None:
+        chosen = needed or 10.0
+    if kind in ("hex_nut", "plain_washer", "spring_washer"):
+        # On the surface at the entry, toward the outside
+        items.append(Item(kind, m.name, None, _place(App.Vector(0, 0, 1), App.Vector(), -n, hole.point(hole.seat - plate))))
+        return Plan(hole, kind, m.name, None, False, False, plate, items, None)
+    if washers:
+        items.append(Item("plain_washer", m.name, None,
+                          _place(App.Vector(0, 0, 1), App.Vector(), -n, hole.point(seat))))
+        items.append(Item("spring_washer", m.name, None,
+                          _place(App.Vector(0, 0, 1), App.Vector(), -n, hole.point(seat - m.washer_h))))
+    head_at = seat - under
+    items.insert(0, Item(kind, m.name, chosen, _place(App.Vector(0, 0, -1), App.Vector(), n, hole.point(head_at))))
+    if nut and headed:
+        far = hole.through
+        if washers:
+            items.append(Item("plain_washer", m.name, None, _place(App.Vector(0, 0, 1), App.Vector(), n, hole.point(far))))
+            far += m.washer_h
+        items.append(Item("hex_nut", m.name, None, _place(App.Vector(0, 0, 1), App.Vector(), n, hole.point(far))))
+    return Plan(hole, kind, m.name, chosen, washers, nut, plate, items, needed)
+
+
+# --------------------------------------------------------------------------- the document
+SHELF_GROUP = "PartsShelf"
+
+
+def shelf_group(doc):
+    """The hidden group with the originals of the shelf's parts"""
+    group = doc.getObject(SHELF_GROUP)
+    if group is None:
+        group = doc.addObject("App::DocumentObjectGroup", SHELF_GROUP)
+        group.Label = translate("PartsShelf", "Shelf parts (originals)")
+        try:
+            group.Visibility = False
+        except Exception:
+            pass
+    return group
+
+
+def _add_props(obj, values):
+    for name, (value, doc) in values.items():
+        if not hasattr(obj, name):
+            obj.addProperty("App::PropertyString", name, "Shelf", doc)
+        setattr(obj, name, value)
+
+
+def originals(doc):
+    group = doc.getObject(SHELF_GROUP)
+    return list(group.Group) if group is not None else []
+
+
+def find_original(doc, key):
+    for o in originals(doc):
+        if getattr(o, "ShelfKey", None) == key:
+            return o
+    return None
+
+
+def ensure_original(doc, key, label, make_shape, props):
+    """The original of a shelf part in this document (made the first time)"""
+    obj = find_original(doc, key)
+    if obj is not None:
+        return obj
+    shape = make_shape()
+    obj = doc.addObject("Part::Feature", "ShelfPart")
+    obj.Shape = shape
+    obj.Label = label
+    values = {"ShelfKey": (key, "What the shelf made this from")}
+    values.update(props)
+    _add_props(obj, values)
+    shelf_group(doc).addObject(obj)
+    try:
+        obj.Visibility = False
+    except Exception:
+        pass
+    return obj
+
+
+def fastener_original(doc, kind_key, size, length=None):
+    kind = KIND[kind_key]
+    length = float(length) if (length and kind.length) else None
+    key = "fastener:{}:{}:{}".format(kind_key, size, "{:g}".format(length) if length else "")
+    label = fastener_label(kind_key, size, length)
+    props = {
+        "PartName": (kind.name(), "Name of the part"),
+        "Standard": (kind.standard + (" / " + kind.iso if kind.iso else ""), "Standard"),
+        "Size": (size_label(size, length), "Nominal size"),
+        "ShelfKind": ("fastener", "Kind of shelf part"),
+    }
+    obj = ensure_original(doc, key, label, lambda: fastener_shape(kind_key, size, length), props)
+    if not hasattr(obj, "ThreadDiameter"):
+        obj.addProperty("App::PropertyLength", "ThreadDiameter", "Shelf", "Nominal thread diameter")
+        obj.addProperty("App::PropertyLength", "TapDrill", "Shelf", "Tap drill diameter of the thread")
+        obj.addProperty("App::PropertyLength", "ScrewLength", "Shelf", "Nominal length")
+    m = SIZE[size]
+    obj.ThreadDiameter = m.d
+    obj.TapDrill = m.tap
+    obj.ScrewLength = length or 0.0
+    obj.Label2 = obj.Standard
+    return obj
+
+
+def profile_original(doc, key, length):
+    length = round(float(length), 3)
+    p = PROFILE[key]
+    props = {
+        "PartName": (p.name(), "Name of the part"),
+        "Standard": (translate("PartsShelf", "generic"), "Standard"),
+        "Size": ("L={:g}".format(length), "Nominal size"),
+        "ShelfKind": ("profile", "Kind of shelf part"),
+    }
+    obj = ensure_original(doc, "profile:{}:{:g}".format(key, length), profile_label(key, length),
+                          lambda: profile_shape(key, length), props)
+    return obj
+
+
+def container_for(doc, preferred=None):
+    """Where links go: the given container, else the assembly of the document, else the root"""
+    if preferred is not None:
+        return preferred
+    for o in doc.Objects:
+        if o.isDerivedFrom("Assembly::AssemblyObject"):
+            return o
+    return None
+
+
+def _global_of(container):
+    if container is None:
+        return App.Placement()
+    try:
+        return container.getGlobalPlacement()
+    except Exception:
+        return App.Placement(container.Placement)
+
+
+def place_link(doc, original, placement, container=None):
+    """A link to the original at the global placement, in the container (or the document)"""
+    count = sum(1 for o in doc.Objects if o.isDerivedFrom("App::Link") and o.LinkedObject == original)
+    link = doc.addObject("App::Link", "ShelfLink")
+    link.LinkedObject = original
+    link.Label = "{} ({})".format(original.Label, count + 1)
+    container = container_for(doc, container)
+    if container is not None:
+        container.addObject(link)
+    link.Placement = _global_of(container).inverse().multiply(placement)
+    try:
+        link.Visibility = True
+    except Exception:
+        pass
+    return link
+
+
+def put_plan(doc, plan, container=None):
+    """Put the screw (and washers, nut) of a plan into the document; returns the links"""
+    links = []
+    for item in plan.items:
+        original = fastener_original(doc, item.kind, item.size, item.length)
+        links.append(place_link(doc, original, item.placement, container))
+    return links
+
+
+def put_profile(doc, key, a, b, face_normal=None, container=None):
+    length = (App.Vector(b) - App.Vector(a)).Length
+    original = profile_original(doc, key, length)
+    return place_link(doc, original, profile_placement(key, a, b, face_normal), container)
+
+
+def is_shelf_part(obj):
+    """Whether obj is a shelf part (an original or a link to one)"""
+    try:
+        target = obj.getLinkedObject(True)
+    except Exception:
+        target = obj
+    return hasattr(target, "ShelfKind")
+
+
+def is_fastener(obj):
+    try:
+        target = obj.getLinkedObject(True)
+    except Exception:
+        target = obj
+    return getattr(target, "ShelfKind", None) == "fastener"
+
+
+def solids_of_document(doc, skip=()):
+    """[(label, global shape)] of the visible solids of a document, without shelf fasteners"""
+    import Part
+
+    out = []
+    for o in doc.Objects:
+        if o in skip or is_fastener(o) or o.Name == SHELF_GROUP:
+            continue
+        if o.isDerivedFrom("PartDesign::Body"):
+            pass
+        elif o.isDerivedFrom("App::Link"):
+            pass
+        elif o.isDerivedFrom("Part::Feature"):
+            parent = o.getParentGeoFeatureGroup() if hasattr(o, "getParentGeoFeatureGroup") else None
+            if parent is not None and parent.isDerivedFrom("PartDesign::Body"):
+                continue
+            if o.isDerivedFrom("Part::Part2DObject") or o.TypeId.startswith(("PartDesign::", "Sketcher::")):
+                continue
+            if any(g.Name == SHELF_GROUP for g in o.InList):
+                continue
+        else:
+            continue
+        if not _visible(o):
+            continue
+        try:
+            s = Part.getShape(o, "", needSubElement=False, transform=False).copy()
+            pl = o.getGlobalPlacement() if hasattr(o, "getGlobalPlacement") else App.Placement(o.Placement)
+            s.Placement = pl
+        except Exception:
+            continue
+        if s.isNull() or not s.Solids:
+            continue
+        out.append((o.Label, s))
+    return out
+
+
+def _visible(o):
+    seen = set()
+    while o is not None and o.Name not in seen:
+        seen.add(o.Name)
+        if not getattr(o, "Visibility", True):
+            return False
+        parent = None
+        for getter in ("getParentGeoFeatureGroup", "getParentGroup"):
+            try:
+                parent = getattr(o, getter)()
+            except Exception:
+                parent = None
+            if parent is not None:
+                break
+        o = parent
+    return True
+
+
+def thread_engagement(obj):
+    """For the design check: (nominal diameter, tap drill, length) of a shelf screw, or None"""
+    try:
+        target = obj.getLinkedObject(True)
+    except Exception:
+        target = obj
+    if getattr(target, "ShelfKind", None) != "fastener":
+        return None
+    try:
+        return float(target.ThreadDiameter), float(target.TapDrill), float(target.ScrewLength)
+    except Exception:
+        return None
+
+
+# --------------------------------------------------------------------------- company parts
+INDEX_NAMES = ("shelf.csv", "index.csv", "棚.csv")
+PART_SUFFIXES = (".fcstd", ".step", ".stp")
+COLUMNS = {
+    "file": ("file", "ファイル"),
+    "name": ("name", "名前", "品名"),
+    "category": ("category", "分類"),
+    "keywords": ("keywords", "別名", "キーワード"),
+    "number": ("number", "品番", "part number"),
+    "note": ("note", "メモ", "備考"),
+}
+
+
+class CompanyPart:
+    def __init__(self, path, name, category="", keywords="", number="", note="", folder=""):
+        self.path = path
+        self.name = name
+        self.category = category
+        self.keywords = keywords
+        self.number = number
+        self.note = note
+        self.folder = folder
+
+    def key(self):
+        return "company:" + os.path.normcase(os.path.abspath(self.path))
+
+    def __repr__(self):
+        return "CompanyPart({!r}, {!r})".format(self.name, self.path)
+
+
+def company_folders():
+    """The folders of the company's parts: the preference (one per line or ;-separated) and the
+    environment variable FREECAD_PARTS_SHELF (separated like PATH), for IT to set for everyone"""
+    text = App.ParamGet("User parameter:BaseApp/Preferences/Mod/Unified/PartsShelf").GetString("CompanyFolders", "")
+    folders = [f.strip() for f in text.replace("\n", ";").split(";") if f.strip()]
+    for f in os.environ.get("FREECAD_PARTS_SHELF", "").split(os.pathsep):
+        if f.strip() and f.strip() not in folders:
+            folders.append(f.strip())
+    return folders
+
+
+def set_company_folders(folders):
+    App.ParamGet("User parameter:BaseApp/Preferences/Mod/Unified/PartsShelf").SetString(
+        "CompanyFolders", ";".join(folders))
+
+
+def _read_csv(path):
+    raw = open(path, "rb").read()
+    for enc in ("utf-8-sig", "cp932"):
+        try:
+            text = raw.decode(enc)
+            break
+        except UnicodeDecodeError:
+            continue
+    else:
+        text = raw.decode("utf-8", "replace")
+    rows = list(csv.reader(text.splitlines()))
+    rows = [r for r in rows if r and not r[0].lstrip().startswith("#")]
+    if not rows:
+        return []
+    head = [h.strip().lower() for h in rows[0]]
+    col = {}
+    for key, names in COLUMNS.items():
+        for i, h in enumerate(head):
+            if h in [n.lower() for n in names]:
+                col[key] = i
+                break
+    if "file" not in col:
+        return []
+    out = []
+    for r in rows[1:]:
+        get = lambda k: r[col[k]].strip() if k in col and col[k] < len(r) else ""
+        if get("file"):
+            out.append({k: get(k) for k in COLUMNS})
+    return out
+
+
+def read_company_folder(folder):
+    """The parts of one folder: those of its index (shelf.csv) if there is one, else every FCStd
+    and STEP file in it and its subfolders (the subfolder is the category)"""
+    folder = os.path.expanduser(folder)
+    if not os.path.isdir(folder):
+        return []
+    for name in INDEX_NAMES:
+        index = os.path.join(folder, name)
+        if os.path.isfile(index):
+            out = []
+            for row in _read_csv(index):
+                path = os.path.normpath(os.path.join(folder, row["file"]))
+                if not os.path.isfile(path):
+                    App.Console.PrintWarning("Parts shelf: {} is in {} but not found\n".format(row["file"], index))
+                    continue
+                name_ = row["name"] or os.path.splitext(os.path.basename(path))[0]
+                out.append(CompanyPart(path, name_, row["category"], row["keywords"], row["number"], row["note"], folder))
+            return out
+    out = []
+    for root, dirs, files in os.walk(folder):
+        dirs.sort()
+        for f in sorted(files):
+            if f.lower().endswith(PART_SUFFIXES):
+                rel = os.path.relpath(root, folder)
+                out.append(CompanyPart(os.path.join(root, f), os.path.splitext(f)[0],
+                                       "" if rel == "." else rel.replace(os.sep, " / "), folder=folder))
+    return out
+
+
+def company_parts():
+    out = []
+    for folder in company_folders():
+        out.extend(read_company_folder(folder))
+    return out
+
+
+def company_shape(path):
+    """The shape of a company part file (STEP, or the visible parts of an FCStd)"""
+    import Part
+
+    if path.lower().endswith((".step", ".stp")):
+        shape = Part.read(path)
+        return _single_solid(shape)
+    # FCStd: the visible top-level shapes of the file
+    already = [d for d in App.listDocuments().values() if os.path.normcase(d.FileName) == os.path.normcase(path)]
+    doc = already[0] if already else App.openDocument(path, hidden=True)
+    try:
+        shapes = []
+        for o in doc.RootObjects:
+            if o.isDerivedFrom("App::DocumentObjectGroup") and not o.isDerivedFrom("App::Part"):
+                continue
+            if not (o.isDerivedFrom("Part::Feature") or o.isDerivedFrom("App::Part") or o.isDerivedFrom("App::Link")):
+                continue
+            if o.isDerivedFrom("Part::Part2DObject"):
+                continue
+            if not getattr(o, "Visibility", True):
+                continue
+            try:
+                s = Part.getShape(o)
+            except Exception:
+                continue
+            if not s.isNull() and s.Solids:
+                shapes.append(s)
+        if not shapes:
+            raise ValueError("no solid in " + path)
+        return _single_solid(shapes[0] if len(shapes) == 1 else Part.makeCompound(shapes))
+    finally:
+        if not already:
+            App.closeDocument(doc.Name)
+
+
+def company_original(doc, part):
+    props = {
+        "PartName": (part.name, "Name of the part"),
+        "PartNumber": (part.number, "Part number"),
+        "Standard": (part.category, "Category"),
+        "Size": ("", "Nominal size"),
+        "SourceFile": (part.path, "The file of the company parts shelf it came from"),
+        "ShelfKind": ("company", "Kind of shelf part"),
+    }
+    return ensure_original(doc, part.key(), part.name, lambda: company_shape(part.path), props)
+
+
+def placement_on_face(point, normal):
+    """A part's origin at the point, its Z along the face's outward normal"""
+    return App.Placement(App.Vector(point), SnapMath._rotation_between(App.Vector(0, 0, 1), App.Vector(normal)))
+
+
+# --------------------------------------------------------------------------- search
+ALIASES = {
+    "socket_head": ["ねじ", "ボルト", "六角穴付き", "六角穴付きボルト", "キャップスクリュー", "キャップボルト", "CAP", "SHCS", "socket head", "cap screw", "screw", "bolt"],
+    "hex_bolt_full": ["ねじ", "ボルト", "六角ボルト", "全ねじ", "hex bolt", "bolt"],
+    "hex_bolt": ["ねじ", "ボルト", "六角ボルト", "半ねじ", "hex bolt", "bolt"],
+    "countersunk": ["ねじ", "皿ねじ", "皿ボルト", "皿", "六角穴付き", "countersunk", "flat head"],
+    "hex_nut": ["ナット", "六角ナット", "nut"],
+    "plain_washer": ["座金", "ワッシャ", "ワッシャー", "平座金", "平ワッシャ", "washer"],
+    "spring_washer": ["座金", "ワッシャ", "ワッシャー", "ばね座金", "スプリングワッシャ", "スプリングワッシャー", "spring washer", "lock washer"],
+    "set_flat": ["ねじ", "止めねじ", "イモネジ", "いもねじ", "セットスクリュー", "六角穴付き", "set screw", "grub screw"],
+    "set_cup": ["ねじ", "止めねじ", "イモネジ", "いもねじ", "セットスクリュー", "六角穴付き", "set screw", "grub screw"],
+    "profile": ["アルミフレーム", "フレーム", "アルミ押出材", "押出材", "押し出し材", "Tスロット", "T溝", "profile", "extrusion", "aluminium", "aluminum"],
+}
