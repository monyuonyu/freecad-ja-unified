+                diam1 = self.GetClosest(diam)
+                # FreeCAD.Console.PrintLog(diam + "->" + diam1 + "\n")
+                if diam != diam1:
+                    dm.setData(dm.index(i, 1), diam1)
+                    if (
+                        dm.data(dm.index(i, 0), QtCore.Qt.CheckStateRole)
+                        == QtCore.Qt.Checked
