@@ -0,0 +1,93 @@
+# -*- coding: utf-8 -*-
+"""
+***************************************************************************
+*   Copyright (c) 2024:                                                   *
+*   Original code by:                                                     *
+*   hasecilu <hasecilu[at]tuta.io>                                        *
+*                                                                         *
