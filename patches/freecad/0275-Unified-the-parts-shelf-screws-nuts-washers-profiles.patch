+def parse_query(text):
+    """"M6×20" / "m6x20" / "M6" in a search: (size, length) found in the text, and the rest"""
+    import re
+
+    t = text.replace("×", "x").replace("Ｍ", "M").replace("ｘ", "x")
+    m = re.search(r"\b[mM](\d+)(?:\s*[xX*]\s*(\d+(?:\.\d+)?))?", t)
+    if not m:
+        return None, None, text
+    size = "M" + m.group(1)
+    length = float(m.group(2)) if m.group(2) else None
+    rest = (t[: m.start()] + t[m.end():]).strip()
+    return (size if size in SIZE else None), length, rest
+
+
+def matches(kind_key, words):
+    """Whether a shelf kind matches the search words (any word in its names or aliases)"""
+    if not words:
+        return True
+    hay = [KIND[kind_key].en.lower(), KIND[kind_key].ja, KIND[kind_key].standard.lower(),
+           KIND[kind_key].iso.lower()] if kind_key in KIND else []
+    hay += [a.lower() for a in ALIASES.get(kind_key, [])]
+    return all(any(w.lower() in h for h in hay) for w in words)
