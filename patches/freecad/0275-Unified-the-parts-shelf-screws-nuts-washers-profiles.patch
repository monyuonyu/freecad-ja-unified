+        FreeCAD.Console.PrintLog("migrating fasteners to new names\n")
+        for propName in obj.PropertiesList:
+            lc = propName[0].lower()
+            if lc != propName[0]:
+                lcname = lc + propName[1:]
+                if hasattr(obj, lcname):
