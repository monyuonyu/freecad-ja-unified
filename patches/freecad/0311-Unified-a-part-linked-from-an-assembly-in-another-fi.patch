diff --git a/src/Mod/Unified/UnifiedFiles.py b/src/Mod/Unified/UnifiedFiles.py
index b5d4a5000..23d6966a0 100644
--- a/src/Mod/Unified/UnifiedFiles.py
+++ b/src/Mod/Unified/UnifiedFiles.py
@@ -15,6 +15,12 @@ import FreeCAD as App
 translate = App.Qt.translate
 
 
+
+def root_objects(doc):
+    """The tops of the document: used by nothing in it. doc.RootObjects also leaves out a part
+    that an assembly in another document links to (the part could not be drawn, dragged, ...)"""
+    return [o for o in doc.Objects if not any(p.Document == doc for p in o.InList)]
+
 def QT_TRANSLATE_NOOP(context, text):
     return text
 
@@ -277,7 +283,7 @@ class ExportCADCommand:
 
     def Activated(self):
         Gui, QtCore, QtGui, QtWidgets = _gui()
-        objs = _picked() or [o for o in App.ActiveDocument.RootObjects if o.isDerivedFrom("Part::Feature")
+        objs = _picked() or [o for o in root_objects(App.ActiveDocument) if o.isDerivedFrom("Part::Feature")
                              or o.isDerivedFrom("App::Part") or o.isDerivedFrom("App::Link")]
         doc = App.ActiveDocument
         start = os.path.join(os.path.dirname(doc.FileName) if doc.FileName else os.path.expanduser("~"), doc.Label + ".step")
