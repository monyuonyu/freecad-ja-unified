--- a/src/Mod/Unified/TestUnifiedFiles.py
+++ b/src/Mod/Unified/TestUnifiedFiles.py
@@ -57,6 +57,26 @@ class TestUnifiedFiles(unittest.TestCase):
 
 
 
+class TestRootObjects(unittest.TestCase):
+    def test_a_part_linked_from_another_document(self):
+        # doc.RootObjects leaves the body out once an assembly elsewhere links it
+        import os
+        import tempfile
+
+        tmp = tempfile.mkdtemp()
+        part = App.newDocument("rootpart")
+        asm = App.newDocument("rootasm")
+        try:
+            body = part.addObject("PartDesign::Body", "Body")
+            part.saveAs(os.path.join(tmp, "p.FCStd"))
+            asm.saveAs(os.path.join(tmp, "a.FCStd"))
+            asm.addObject("App::Link", "L").LinkedObject = body
+            self.assertEqual(F.root_objects(part), [body])
+        finally:
+            App.closeDocument(asm.Name)
+            App.closeDocument(part.Name)
+
+
 class TestLinkPathAfterSaveAs(unittest.TestCase):
