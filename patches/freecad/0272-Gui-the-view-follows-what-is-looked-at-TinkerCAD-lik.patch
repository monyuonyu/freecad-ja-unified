diff --git a/src/Gui/Navigation/LookNavigation.h b/src/Gui/Navigation/LookNavigation.h
new file mode 100644
index 000000000..7cb21ecc0
--- /dev/null
+++ b/src/Gui/Navigation/LookNavigation.h
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+
+#include <Inventor/SbVec3f.h>
+
+/** The arithmetic of navigating towards what is looked at ("look navigation"): the wheel moves
+ * the eye towards the point under the cursor (a dolly) instead of zooming about a fixed focal
+ * point, it slows down near the surface and never passes it.
+ */
+namespace Gui::LookNavigation
+{
+
+/// Coin's variable near plane (SoRenderManager, near plane value 0.6 of a 32 bit depth range)
+/// is the far distance divided by 2^12
+constexpr float coinNearPlaneRatio = 4096.0F;
+
+/** The distance from the eye to \a distance after one dolly step of \a logFactor (negative
+ * comes closer, as the wheel of NavigationStyle::doZoom). The part of the distance above
+ * \a minDistance shrinks or grows by exp(logFactor): steps are proportional to the distance to
+ * the target, approaching slows down near it and \a minDistance is never reached. Moving away
+ * has no limit. An eye nearer than \a minDistance only moves away.
+ */
+inline float dollyDistance(float distance, float minDistance, float logFactor)
+{
+    if (!(distance > 0.0F) || !std::isfinite(logFactor)) {
+        return distance;
+    }
+    const float factor = std::exp(logFactor);
+    if (distance <= minDistance) {
+        return logFactor > 0.0F ? distance * factor : distance;
+    }
+    const float result = minDistance + (distance - minDistance) * factor;
+    // Stay where floating point arithmetic is safe (as NavigationStyle::zoom)
+    const float maxDistance = std::sqrt(std::numeric_limits<float>::max()) * 1.0e-3F;
+    return std::min(result, std::max(distance, maxDistance));
+}
+
+/** The smallest distance from the eye to a looked at point. \a sceneExtent is the largest
+ * distance from the point to the scene's bounding box: Coin puts the near clipping plane of
+ * a perspective camera at 1/4096 of the far distance, and the point must stay well in front of
+ * it (at the corner of a 45 degree view the depth is 0.85 of the distance, twice as safe).
+ * \a pointMagnitude keeps the steps above the float resolution of the coordinates.
+ */
+inline float minimumDistance(float sceneExtent, float pointMagnitude)
+{
+    constexpr float safety = 2.0F / 0.85F;
+    const float extent = std::max(sceneExtent, 0.0F);
+    // d >= safety * (extent + d) / 4096
+    const float fromClipping = safety * extent / (coinNearPlaneRatio - safety);
+    const float fromPrecision = 1.0e-5F * std::max(pointMagnitude, 1.0e-3F);
+    return std::max(fromClipping, fromPrecision);
+}
+
+/// The eye \a position moved towards (\a scale < 1) or away from \a pivot: the pivot stays at
+/// its place in the image of a perspective camera, and of an orthographic camera whose height
+/// is scaled by \a scale too
+inline SbVec3f scaleAbout(const SbVec3f& position, const SbVec3f& pivot, float scale)
+{
+    return pivot + (position - pivot) * scale;
+}
+
+/// The distance at which a 45 degree perspective camera sees as much as an orthographic camera
+/// of \a height: an orthographic camera dollies by its height
+inline float orthographicDistance(float height)
+{
+    return height / (2.0F * std::tan(0.3926991F));  // tan(22.5 degrees)
+}
+
+}  // namespace Gui::LookNavigation
