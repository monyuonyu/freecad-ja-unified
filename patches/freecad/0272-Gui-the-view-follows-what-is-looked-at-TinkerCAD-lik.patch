+        dollyAt(viewer->getSoRenderManager()->getCamera(), this->zoomStep, SbVec2f(0.5F, 0.5F));
+        return;
+    }
     zoom(viewer->getSoRenderManager()->getCamera(), this->zoomStep);
 }
 
