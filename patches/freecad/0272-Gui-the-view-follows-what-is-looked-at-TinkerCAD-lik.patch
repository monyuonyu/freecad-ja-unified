+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+#include <gtest/gtest.h>
+
+#include <cmath>
+
+#include <Inventor/SbViewVolume.h>
+#include <Inventor/SoDB.h>
+#include <Inventor/nodes/SoOrthographicCamera.h>
+#include <Inventor/nodes/SoPerspectiveCamera.h>
+
+#include <Gui/Navigation/LookNavigation.h>
+
+namespace LN = Gui::LookNavigation;
+
+namespace
+{
+constexpr float wheelIn = -0.2F;  // one notch of the wheel towards the target (ZoomStep 0.2)
+constexpr float wheelOut = 0.2F;
+
+SbVec3f screenOf(SoCamera* camera, const SbVec3f& point)
+{
+    SbViewVolume vv = camera->getViewVolume(1.0F);
+    SbVec3f screen;
+    vv.projectToScreen(point, screen);
+    return screen;
+}
+}  // namespace
+
+TEST(LookNavigation, approachingSlowsDownAndNeverReachesTheSmallestDistance)
+{
+    const float minDistance = 0.5F;
+    float distance = 1000.0F;
+    float lastStep = distance;
+    for (int i = 0; i < 80; ++i) {
+        const float next = LN::dollyDistance(distance, minDistance, wheelIn);
+        EXPECT_LT(next, distance);
+        EXPECT_GT(next, minDistance);
+        EXPECT_LE(distance - next, lastStep);  // steps get smaller near the target
+        lastStep = distance - next;
+        distance = next;
+    }
+    EXPECT_NEAR(distance, minDistance, 1.0e-3F);
+}
+
+TEST(LookNavigation, aStepIsProportionalToTheDistance)
+{
+    const float far = LN::dollyDistance(1000.0F, 0.0F, wheelIn);
+    const float near = LN::dollyDistance(10.0F, 0.0F, wheelIn);
+    EXPECT_NEAR((1000.0F - far) / 1000.0F, (10.0F - near) / 10.0F, 1.0e-6F);
+    EXPECT_NEAR((1000.0F - far) / 1000.0F, 1.0F - std::exp(wheelIn), 1.0e-6F);
+}
+
+TEST(LookNavigation, outAgainIsWhereItStarted)
+{
+    float distance = 300.0F;
+    for (int i = 0; i < 20; ++i) {
+        distance = LN::dollyDistance(distance, 2.0F, wheelIn);
+    }
+    for (int i = 0; i < 20; ++i) {
+        distance = LN::dollyDistance(distance, 2.0F, wheelOut);
+    }
+    EXPECT_NEAR(distance, 300.0F, 1.0e-2F);
+}
+
+TEST(LookNavigation, movingAwayHasNoFixedLimit)
+{
+    float distance = 1.0F;
+    for (int i = 0; i < 100; ++i) {
+        distance = LN::dollyDistance(distance, 0.01F, wheelOut);
+    }
+    EXPECT_GT(distance, 1.0e8F);
+    EXPECT_TRUE(std::isfinite(distance));
+    for (int i = 0; i < 10000; ++i) {
+        distance = LN::dollyDistance(distance, 0.01F, wheelOut);
+    }
+    EXPECT_TRUE(std::isfinite(distance));
+    EXPECT_TRUE(std::isfinite(distance * distance));
+}
+
+TEST(LookNavigation, anEyeNearerThanTheSmallestDistanceOnlyMovesAway)
+{
+    EXPECT_FLOAT_EQ(LN::dollyDistance(0.1F, 1.0F, wheelIn), 0.1F);
+    EXPECT_GT(LN::dollyDistance(0.1F, 1.0F, wheelOut), 0.1F);
+    EXPECT_FLOAT_EQ(LN::dollyDistance(5.0F, 1.0F, 0.0F), 5.0F);
+}
+
+TEST(LookNavigation, theTargetStaysInFrontOfCoinsNearPlane)
+{
+    for (float extent : {1.0F, 50.0F, 1000.0F, 1.0e5F}) {
+        const float distance = LN::minimumDistance(extent, extent);
+        // Coin's variable near plane: the far distance (the scene seen from the eye) / 4096
+        const float nearPlane = (extent + distance) / LN::coinNearPlaneRatio;
+        // At the corner of the view the target's depth is 0.85 of its distance
+        EXPECT_GT(0.85F * distance, 1.5F * nearPlane) << extent;
+        // ... and the smallest distance is still small: a thousandth of the scene
+        EXPECT_LT(distance, extent / 1000.0F) << extent;
+    }
+}
+
+TEST(LookNavigation, theSmallestDistanceIsAboveTheFloatResolution)
+{
+    const float distance = LN::minimumDistance(0.0F, 1.0e4F);
+    EXPECT_GT(distance, 1.0e4F * 1.0e-6F);
+}
+
+TEST(LookNavigation, theTargetKeepsItsPlaceInAPerspectiveImage)
+{
+    SoDB::init();
+    auto camera = new SoPerspectiveCamera;
+    camera->ref();
+    camera->position = SbVec3f(10, -200, 80);
+    camera->pointAt(SbVec3f(0, 0, 0), SbVec3f(0, 0, 1));
+    camera->nearDistance = 0.01F;
+    camera->farDistance = 1000.0F;
+    const SbVec3f target(12, 5, -3);  // not on the view axis: under the cursor
+    const SbVec3f before = screenOf(camera, target);
+    const float distance = (target - camera->position.getValue()).length();
+    for (int i = 0; i < 50; ++i) {
+        const float d = (target - camera->position.getValue()).length();
+        const float scale = LN::dollyDistance(d, 0.1F, wheelIn) / d;
+        camera->position = LN::scaleAbout(camera->position.getValue(), target, scale);
+    }
+    const SbVec3f after = screenOf(camera, target);
+    EXPECT_NEAR(after[0], before[0], 1.0e-4F);
+    EXPECT_NEAR(after[1], before[1], 1.0e-4F);
+    const float closer = (target - camera->position.getValue()).length();
+    EXPECT_LT(closer, distance * 0.01F);
+    EXPECT_GT(closer, 0.1F);
+    camera->unref();
+}
+
+TEST(LookNavigation, theTargetKeepsItsPlaceInAnOrthographicImage)
+{
+    SoDB::init();
+    auto camera = new SoOrthographicCamera;
+    camera->ref();
+    camera->position = SbVec3f(0, 0, 100);
+    camera->height = 80.0F;
+    const SbVec3f target(17, -9, 4);
+    const SbVec3f before = screenOf(camera, target);
+    for (int i = 0; i < 30; ++i) {
+        const float d = LN::orthographicDistance(camera->height.getValue());
+        const float scale = LN::dollyDistance(d, 0.01F, wheelIn) / d;
+        camera->height = camera->height.getValue() * scale;
+        camera->position = LN::scaleAbout(camera->position.getValue(), target, scale);
+    }
+    const SbVec3f after = screenOf(camera, target);
+    EXPECT_NEAR(after[0], before[0], 1.0e-4F);
+    EXPECT_NEAR(after[1], before[1], 1.0e-4F);
+    EXPECT_LT(camera->height.getValue(), 80.0F * 0.01F);
+    camera->unref();
+}
+
+TEST(LookNavigation, anOrthographicHeightIsSeenAtTheSameDistanceByA45DegreeCamera)
+{
+    const float distance = LN::orthographicDistance(10.0F);
+    EXPECT_NEAR(2.0F * distance * std::tan(M_PI / 8.0), 10.0F, 1.0e-4F);
+}
