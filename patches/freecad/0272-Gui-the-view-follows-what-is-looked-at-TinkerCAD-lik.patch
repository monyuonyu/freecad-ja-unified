+void NavigationStyle::setLookTarget(const SbVec3f& point)
+{
+    lookTarget = point;
+    lookTargetValid = true;
+    dollyPixel = SbVec2s(-1, -1);
+}
+
+bool NavigationStyle::pickScenePoint(const SbVec2s& pixel, SbVec3f& point) const
+{
+    SoNode* scene = viewer->getSoRenderManager()->getSceneGraph();
+    if (!scene) {
+        return false;
+    }
+    SoRayPickAction rpaction(viewer->getSoRenderManager()->getViewportRegion());
+    rpaction.setPoint(pixel);
+    rpaction.setRadius(viewer->getPickRadius());
+    rpaction.apply(scene);
+    const SoPickedPoint* picked = rpaction.getPickedPoint();
+    if (!picked) {
+        return false;
+    }
+    point = picked->getPoint();
+    return true;
+}
+
+bool NavigationStyle::isInView(const SbVec3f& point) const
+{
+    const SoCamera* camera = getCamera();
+    if (!camera) {
+        return false;
+    }
+    SbVec3f direction;
+    camera->orientation.getValue().multVec(SbVec3f(0, 0, -1), direction);
+    if (camera->isOfType(SoPerspectiveCamera::getClassTypeId())
+        && (point - camera->position.getValue()).dot(direction) <= 0.0F) {
+        return false;
+    }
+    const SbViewportRegion& vp = viewer->getSoRenderManager()->getViewportRegion();
+    const float ratio = vp.getViewportAspectRatio();
+    SbViewVolume vv = camera->getViewVolume(ratio);
+    if (ratio < 1.0F) {
+        vv.scale(1.0F / ratio);
+    }
+    SbVec3f screen;
+    vv.projectToScreen(point, screen);
+    return screen[0] >= 0.0F && screen[0] <= 1.0F && screen[1] >= 0.0F && screen[1] <= 1.0F;
+}
+
+bool NavigationStyle::visibleGeometryCenter(SbVec3f& center) const
+{
+    const SbVec2s size = viewer->getSoRenderManager()->getViewportRegion().getViewportSizePixels();
+    constexpr int grid = 5;
+    SbVec3f sum(0, 0, 0);
+    int count = 0;
+    for (int i = 0; i < grid; ++i) {
+        for (int j = 0; j < grid; ++j) {
+            const SbVec2s pixel(
+                static_cast<short>((i + 0.5F) * size[0] / grid),
+                static_cast<short>((j + 0.5F) * size[1] / grid)
+            );
+            SbVec3f point;
+            if (pickScenePoint(pixel, point)) {
+                sum += point;
+                ++count;
+            }
+        }
+    }
+    if (count == 0) {
+        return false;
+    }
+    center = sum / static_cast<float>(count);
+    return true;
+}
+
+void NavigationStyle::setFocalDepth(SoCamera* camera, const SbVec3f& point) const
+{
+    if (!camera) {
+        return;
+    }
+    SbVec3f direction;
+    camera->orientation.getValue().multVec(SbVec3f(0, 0, -1), direction);
+    const SbVec3f position = camera->position.getValue();
+    const float depth = (point - position).dot(direction);
+    if (camera->isOfType(SoOrthographicCamera::getClassTypeId())) {
+        // Nothing depends on the place of an orthographic eye along the view direction (the
+        // clipping planes follow the scene, also behind the eye): keep the focal distance and
+        // move the eye
+        float focalDistance = camera->focalDistance.getValue();
+        if (!(focalDistance > 0.0F)) {
+            focalDistance = 1.0F;
+            camera->focalDistance = focalDistance;
+        }
+        camera->position = position + (depth - focalDistance) * direction;
+    }
+    else if (depth > 0.0F) {
+        camera->focalDistance = depth;
+    }
+}
+
+void NavigationStyle::setupPanningPlaneAt(SoCamera* camera, const SbVec2f& pos)
+{
+    if (camera) {
+        const SbVec2s size
+            = viewer->getSoRenderManager()->getViewportRegion().getViewportSizePixels();
+        const SbVec2s pixel(
+            static_cast<short>(pos[0] * std::max(size[0] - 1, 1)),
+            static_cast<short>(pos[1] * std::max(size[1] - 1, 1))
+        );
+        // The grabbed point of the model stays under the cursor, and is looked at after moving
+        SbVec3f point;
+        if (pickScenePoint(pixel, point)) {
+            setFocalDepth(camera, point);
+            lookTarget = point;
+            lookTargetValid = true;
+        }
+    }
+    setupPanningPlane(camera);
+}
+
+void NavigationStyle::findLookPivot(const SbVec2s& pixel)
+{
+    SbVec3f pivot;
+    // The point of the model under the cursor
+    if (pickScenePoint(pixel, pivot)) {
+        setRotationCenter(pivot);
+        rotationCenterIsScenePointAtCursor = true;
+    }
+    // Else what was looked at last, while it is in the view
+    else if (lookTargetValid && isInView(lookTarget)) {
+        setRotationCenter(lookTarget);
+        pivot = lookTarget;
+    }
+    // Else the middle of the model that is seen
+    else if (visibleGeometryCenter(pivot)) {
+        setRotationCenter(pivot);
+    }
+    else {
+        pivot = viewer->getFocalPoint();
+        setRotationCenter(pivot);
+    }
+    lookTarget = pivot;
+    lookTargetValid = true;
+    dollyPixel = SbVec2s(-1, -1);
+}
+
+void NavigationStyle::dollyAt(SoCamera* camera, float logfactor, const SbVec2f& pos)
+{
+    if (!camera || logfactor == 0.0F) {
+        return;
+    }
+    animator->stop();
+
+    const SbViewportRegion& vp = viewer->getSoRenderManager()->getViewportRegion();
+    const float ratio = vp.getViewportAspectRatio();
+    const SbVec2s size = vp.getViewportSizePixels();
+    const SbVec2f at = this->zoomAtCursor ? pos : SbVec2f(0.5F, 0.5F);
+    const SbVec2s pixel(
+        static_cast<short>(at[0] * std::max(size[0] - 1, 1)),
+        static_cast<short>(at[1] * std::max(size[1] - 1, 1))
+    );
+
+    // The target: while the cursor and the camera stay as the last step left them, the same
+    // point (it is still under the cursor); else the point of the model under the cursor; else
+    // the point under the cursor at the depth of the focal point
+    SbVec3f target;
+    const bool sameAsLastStep = lookTargetValid && pixel == dollyPixel
+        && camera->position.getValue() == dollyCameraPosition
+        && camera->orientation.getValue() == dollyCameraOrientation;
+    if (sameAsLastStep) {
+        target = lookTarget;
+    }
+    else if (!pickScenePoint(pixel, target)) {
+        SbViewVolume vv = camera->getViewVolume(ratio);
+        if (ratio < 1.0F) {
+            vv.scale(1.0F / ratio);
+        }
+        SbLine line;
+        vv.projectPointToLine(at, line);
+        const SbPlane plane = vv.getPlane(camera->focalDistance.getValue());
+        if (!plane.intersect(line, target)) {
+            return;
+        }
+    }
+
+    // The smallest distance keeps the target in front of the near clipping plane
+    float extent = 0.0F;
+    const SbBox3f box = viewer->getBoundingBox();
+    if (!box.isEmpty()) {
+        const SbVec3f& lo = box.getMin();
+        const SbVec3f& hi = box.getMax();
+        for (int corner = 0; corner < 8; ++corner) {
+            const SbVec3f point(
+                (corner & 1) ? hi[0] : lo[0],
+                (corner & 2) ? hi[1] : lo[1],
+                (corner & 4) ? hi[2] : lo[2]
+            );
+            extent = std::max(extent, (point - target).length());
+        }
+    }
+    const float minDistance = LookNavigation::minimumDistance(extent, target.length());
+
+    const SbVec3f position = camera->position.getValue();
+    float scale = 1.0F;
+    if (camera->isOfType(SoOrthographicCamera::getClassTypeId())) {
+        // No eye to move: zoom about the target by the height of the view, as far as a
+        // perspective eye would come
+        auto ortho = static_cast<SoOrthographicCamera*>(camera);
+        const float height = ortho->height.getValue();
+        const float distance = LookNavigation::orthographicDistance(height);
+        if (!(distance > 0.0F)) {
+            return;
+        }
+        scale = LookNavigation::dollyDistance(distance, minDistance, logfactor) / distance;
+        ortho->height = height * scale;
+    }
+    else {
+        const float distance = (target - position).length();
+        if (!(distance > 0.0F)) {
+            return;
+        }
+        scale = LookNavigation::dollyDistance(distance, minDistance, logfactor) / distance;
+    }
+    if (!(scale > 0.0F) || !std::isfinite(scale)) {
+        return;
+    }
+    camera->position = LookNavigation::scaleAbout(position, target, scale);
+    // The focal point follows (fit all, the navigation cube and turning use it)
+    setFocalDepth(camera, target);
+
+    lookTarget = target;
+    lookTargetValid = true;
+    dollyPixel = pixel;
+    dollyCameraPosition = camera->position.getValue();
+    dollyCameraOrientation = camera->orientation.getValue();
+
+    if (this->currentmode != NavigationStyle::IDLE) {
+        hasZoomed = true;
+    }
+}
