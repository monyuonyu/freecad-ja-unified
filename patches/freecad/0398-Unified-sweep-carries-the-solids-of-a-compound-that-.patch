     hits = []
     for angle in angles:
         turn = App.Placement(App.Vector(), App.Rotation(direction, angle), point)
@@ -1090,11 +1135,11 @@ def sweep(doc=None, moving=(), axis=((0, 0, 0), (0, 0, 1)), start=0.0, end=90.0,
                 res = _common_volume(now[m], now[f])
             volume, center = res
             if volume is None or volume > opt["interference_mm3"]:
-                hits.append({"angle": angle, "a": doc.getObject(m).Label, "b": doc.getObject(f).Label,
+                hits.append({"angle": angle, "a": label(m), "b": label(f),
                              "names": [m, f], "volume": volume,
                              "center": list(center) if center is not None else None})  # fmt: skip
-    return {"angles": angles, "moving": [doc.getObject(m).Label for m in movers], "hits": hits,
-            "first": hits[0]["angle"] if hits else None}  # fmt: skip
+    return {"angles": angles, "moving": [label(m) for m in movers if "#" not in m], "carried": carried,
+            "hits": hits, "first": hits[0]["angle"] if hits else None}  # fmt: skip
 
 
 def interferences(doc=None, **options):
@@ -1208,7 +1253,7 @@ def cli_main():
             raise RuntimeError("--design-check sweep: give the motion with --sweep motion.json")
         with open(spec_file, encoding="utf-8-sig") as f:
             spec = json.load(f)
-        known = {"moving", "axis", "from", "to", "step"}
+        known = {"moving", "axis", "from", "to", "step", "carry"}
         if set(spec) - known:
             raise RuntimeError("--sweep: unknown keys %s (known: %s)" % (sorted(set(spec) - known), sorted(known)))
         moving = spec.get("moving") or []
@@ -1218,7 +1263,7 @@ def cli_main():
         if len(axis) != 6:
             raise RuntimeError("--sweep: axis is [px, py, pz, dx, dy, dz] (a point and a direction)")
         result = sweep(doc, moving, (axis[:3], axis[3:]), float(spec.get("from", 0)), float(spec.get("to", 90)),
