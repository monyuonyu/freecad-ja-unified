+    project). ignore_pairs=[(a, b)] as in interferences.
+    carry={"from": [parts], "inside": [parts], "margin": mm}: the solids of the parts `from` (a
+    compound of all the bolts) whose centre is in the box of the parts `inside` (default: the
+    moving parts), grown by `margin`, move too (the bolts of the hub); the others stay.
+    Returns {"angles": [...], "moving": [labels], "carried": ["label[k]"], "hits": [{"angle",
+    "a", "b", "volume", "center"}], "first": angle or None}"""
     import fnmatch
 
     doc = doc or App.ActiveDocument
@@ -1055,9 +1060,48 @@ def sweep(doc=None, moving=(), axis=((0, 0, 0), (0, 0, 1)), start=0.0, end=90.0,
         o = doc.getObject(n)
         return {o.Name, o.Label} | {u.Label for u in o.InListRecursive} | {u.Name for u in o.InListRecursive}
 
-    movers = sorted(n for n in shapes if any(fnmatch.fnmatchcase(x, p) for p in moving for x in names(n)))
+    def match(patterns):
+        return sorted(n for n in shapes if any(fnmatch.fnmatchcase(x, p) for p in patterns for x in names(n)))
+
+    movers = match(moving)
     if not movers:
         raise ValueError("sweep: no visible solid part matches %s" % ", ".join(moving))
+    carried = []
+    if carry:
+        # the solids of a compound that move with the moving parts: "name#k" items of their own
+        unknown = set(carry) - {"from", "inside", "margin"}
+        if unknown:
+            raise ValueError("sweep: carry has unknown keys %s (known: from, inside, margin)" % sorted(unknown))
+        inside = match(carry.get("inside") or []) if carry.get("inside") else list(movers)
+        boxes = []
+        for n in inside:
+            bb = App.BoundBox(shapes[n].BoundBox)
+            bb.enlarge(float(carry.get("margin", 0)))
+            boxes.append(bb)
+        sources = [n for n in match(carry.get("from") or []) if n not in movers]
+        if not sources:
+            raise ValueError("sweep: carry: no visible solid part matches %s" % ", ".join(carry.get("from") or []))
+        for n in sources:
+            stay = []
+            for k, solid in enumerate(shapes[n].Solids):
+                c = solid.BoundBox.Center
+                if any(bb.isInside(c) for bb in boxes):
+                    shapes["%s#%d" % (n, k)] = solid
+                    movers.append("%s#%d" % (n, k))
+                    carried.append("%s[%d]" % (doc.getObject(n).Label, k))
+                else:
+                    stay.append(solid)
+            if len(stay) != len(shapes[n].Solids):
+                if stay:
+                    shapes[n] = Part.makeCompound(stay)
+                else:
+                    del shapes[n]
+
+    def base(n):
+        return doc.getObject(n.split("#")[0])
+
+    def label(n):
+        return base(n).Label + ("[%s]" % n.split("#")[1] if "#" in n else "")
     point, direction = App.Vector(*axis[0]), App.Vector(*axis[1])
