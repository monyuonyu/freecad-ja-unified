+def sweep(doc=None, moving=(), axis=((0, 0, 0), (0, 0, 1)), start=0.0, end=90.0, step=5.0, carry=None,
+          **options):  # fmt: skip
     """Turn the parts `moving` (labels or names, * and ?; a group or App::Part takes its parts)
     about `axis` ((point), (direction)) from `start` to `end` degrees by `step`, and check at each
     angle whether they overlap the other parts (a bar turning 0-80 deg; asked from a gate's
