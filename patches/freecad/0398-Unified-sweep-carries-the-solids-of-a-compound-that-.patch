     elif what == "interference":
diff --git a/src/Mod/Unified/TestDesignCheck.py b/src/Mod/Unified/TestDesignCheck.py
index 90af500a2..eb83a3481 100644
--- a/src/Mod/Unified/TestDesignCheck.py
+++ b/src/Mod/Unified/TestDesignCheck.py
@@ -152,6 +152,30 @@ class DesignCheckSweepTest(unittest.TestCase):
         finally:
             App.closeDocument(doc.Name)
 
+    def test_solids_of_a_compound_carried(self):
+        # all the bolts in one compound: those of the hub turn with it, the others stay (a gate's
+        # bar, asked on 0.8.4)
+        doc = App.newDocument("carry")
+        try:
+            box(doc, "Bar", 0, -2, -2, l=100, w=4, h=4)
+            bolts = doc.addObject("Part::Feature", "Bolts")
+            bolts.Shape = Part.makeCompound([Part.makeCylinder(1, 10, App.Vector(20, 0, -5)),    # through the bar
+                                             Part.makeCylinder(1, 10, App.Vector(30, 40, -5))])  # on a post
+            box(doc, "Post", 25, 35, -5, l=10, w=10, h=3)  # the second bolt stands in it
+            doc.recompute()
+            plain = DesignCheck.sweep(doc, ["Bar"], ((0, 0, 0), (0, 0, 1)), 0, 30, 10)
+            self.assertIn(0.0, {h["angle"] for h in plain["hits"] if h["b"] == "Bolts"})  # left behind: hit
+            got = DesignCheck.sweep(doc, ["Bar"], ((0, 0, 0), (0, 0, 1)), 0, 30, 10,
+                                    carry={"from": ["Bolts"], "margin": 1})  # fmt: skip
+            self.assertEqual(got["carried"], ["Bolts[0]"])
+            self.assertEqual(got["hits"], [])
+            # the bar reaches the other bolt at about 53 deg: the bolt left behind is still checked
+            got = DesignCheck.sweep(doc, ["Bar"], ((0, 0, 0), (0, 0, 1)), 0, 90, 1, carry={"from": ["Bolts"]})
+            self.assertIn(("Bar", "Bolts"), {(h["a"], h["b"]) for h in got["hits"]})
+            self.assertTrue(all(48 <= h["angle"] <= 58 for h in got["hits"]), got["hits"])
+        finally:
+            App.closeDocument(doc.Name)
+
 
 class DesignCheckCommandLineTest(unittest.TestCase):
     def test_design_check_interference(self):
