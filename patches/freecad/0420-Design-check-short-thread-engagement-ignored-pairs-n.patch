+    def test_a_short_thread_engagement(self):
+        # M6 drawn at 6 mm in nuts 5 mm high with 5 mm holes: through the nut it holds; ending 2 mm
+        # into it, it does not (4.8 mm wanted: 0.8 x the diameter)
+        through = Part.makeCylinder(3, 30, App.Vector(0, 0, 0))
+        short = Part.makeCylinder(3, 12, App.Vector(30, 0, 0))
+        nuts = [Part.makeCylinder(5, 5, App.Vector(x, 0, 10)).cut(Part.makeCylinder(2.5, 7, App.Vector(x, 0, 9)))
+                for x in (0, 30)]  # fmt: skip
+        for name, shape in (("Long", through), ("Short", short), ("NutA", nuts[0]), ("NutB", nuts[1])):
+            self.doc.addObject("Part::Feature", name).Shape = shape
+        self.doc.recompute()
+        issues = DesignCheck.run(self.doc)
+        shorts = [sorted(i.objects) for i in issues if i.rule == "thread_short"]
+        self.assertEqual(shorts, [["NutB", "Short"]])
+        self.assertEqual(sorted(sorted(i.objects) for i in issues if i.rule == "thread_fit"),
+                         [["Long", "NutA"], ["NutB", "Short"]])  # fmt: skip
+
+    def test_tiny_edges_of_imported_shapes_are_not_counted(self):
+        s = Part.makeBox(10, 10, 10).fuse(Part.makeBox(5, 5, 5, App.Vector(10, 0.005, 0)))
+        self.assertTrue([e for e in s.Edges if e.Length < 0.01])
+        self.doc.addObject("Part::Feature", "Step").Shape = s
+        self.doc.recompute()
+        self.assertFalse([i for i in DesignCheck.run(self.doc) if i.rule == "tiny_edge"])
+        self.assertTrue([i for i in DesignCheck.run(self.doc, tiny_edge_imported=True) if i.rule == "tiny_edge"])
+
+    def test_pairs_ignored_are_not_measured(self):
+        box(self.doc, "A", 0, 0, 0)
+        box(self.doc, "B", 5, 5, 5)
+        box(self.doc, "C", 8, 0, 0)
+        self.doc.recompute()
+        seen = []
+        real = DesignCheck._measure_overlaps
+        DesignCheck._measure_overlaps = lambda items, wanted, opt: seen.extend(sorted(tuple(sorted(p)) for p in wanted)) \
+            or real(items, wanted, opt)  # fmt: skip
+        try:
+            DesignCheck.run(self.doc, ignore_pairs=[("A", "B")])
+        finally:
+            DesignCheck._measure_overlaps = real
+        self.assertNotIn(("A", "B"), seen)
+        self.assertIn(("A", "C"), seen)
+
     def test_touching_among_many_solids_is_quick(self):
