diff --git a/src/Mod/Unified/InitGui.py b/src/Mod/Unified/InitGui.py
index 221afd9be..8b178a55b 100644
--- a/src/Mod/Unified/InitGui.py
+++ b/src/Mod/Unified/InitGui.py
@@ -4,17 +4,52 @@
 # FreeCAD shows only this workbench. It gathers the tools of Sketcher, PartDesign and
 # friends in one place, so the user never has to pick or switch workbenches.
 
+# Loaded right away (not in Initialize) so that its translations are there for the start
+# page, and the context bar is installed from the beginning
+import UnifiedGui
+
 
 class UnifiedWorkbench(Workbench):
     MenuText = "FreeCAD"
     ToolTip = "Sketch, model and check parts in one place"
 
     def Initialize(self):
+        import importlib
+
+        def load_optional(*modules):
+            # Import modules that may not be built; continue if one is missing
+            for name in modules:
+                try:
+                    importlib.import_module(name)
+                except ImportError as err:
+                    FreeCAD.Console.PrintLog("Unified: {} not available ({})\n".format(name, err))
+                    return False
+            return True
+
         # Load the modules whose commands are used here. Their workbenches are never shown.
         import PartGui
         import SketcherGui
         import PartDesignGui
-        import UnifiedGui
+
+        # Tools used less often, reachable from the menus: technical drawings and assemblies
+        load_optional("TechDrawGui", "TechDrawTools")
+        if load_optional("AssemblyGui"):
+            # What the Assembly workbench does in its Initialize(), without showing it
+            load_optional(
+                "CommandCreateAssembly",
+                "CommandInsertLink",
+                "CommandInsertNewPart",
+                "CommandCreateJoint",
+                "CommandSolveAssembly",
+                "CommandExportASMT",
+                "CommandCreateView",
+                "CommandCreateSimulation",
+                "CommandCreateSnapshot",
+                "CommandCreateBom",
+            )
+
+        # Rebuild the menus and toolbars now that all commands exist
+        import UnifiedGui  # noqa: F811
 
     def GetClassName(self):
         return "UnifiedGui::Workbench"
