From 66f4231a2893bba485bf42ed24d7db267c643168 Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Sun, 27 Sep 2026 01:22:10 +0900
Subject: [PATCH 16/55] Unified: drawings and assemblies in the menus; menu
 tooltips

- The Drawing and Assemblies menus give access to TechDraw and Assembly
  without switching workbench; their commands are registered when the
  integrated environment initializes.
- Menus show the tooltip of the hovered command (all workbenches): many
  commands are only reachable from menus, and their names alone often do
  not tell what they do.
- UnifiedGui is imported at startup, so its translations are available
  for the start page and the context bar exists from the beginning.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/Gui/MenuManager.cpp                       |  4 ++
 .../Gui/Resources/translations/Unified_ja.ts  | 12 +++++
 src/Mod/Unified/Gui/Workbench.cpp             | 53 +++++++++++++++++++
 src/Mod/Unified/InitGui.py                    | 37 ++++++++++++-
 4 files changed, 105 insertions(+), 1 deletion(-)

diff --git a/src/Gui/MenuManager.cpp b/src/Gui/MenuManager.cpp
index b4426101c..b37071a5e 100644
--- a/src/Gui/MenuManager.cpp
+++ b/src/Gui/MenuManager.cpp
@@ -238,6 +238,9 @@ void MenuManager::setup(MenuItem* menuItems) const
                 // create a new menu
                 std::string menuName = item->command();
                 QMenu* menu = menuBar->addMenu(QApplication::translate("Workbench", menuName.c_str()));
+                // Show what a command does when hovering it: many commands are only reachable
+                // from the menus, and their names alone often do not tell what they are for
+                menu->setToolTipsVisible(true);
                 action = menu->menuAction();
                 menu->setObjectName(QString::fromLatin1(menuName.c_str()));
                 action->setObjectName(QString::fromLatin1(menuName.c_str()));
@@ -292,6 +295,7 @@ void MenuManager::setup(MenuItem* item, QMenu* menu) const
                     QMenu* submenu = menu->addMenu(
                         QApplication::translate("Workbench", menuName.c_str())
                     );
+                    submenu->setToolTipsVisible(true);
                     QAction* action = submenu->menuAction();
                     submenu->setObjectName(QString::fromLatin1(item->command().c_str()));
                     action->setObjectName(QString::fromLatin1(item->command().c_str()));
