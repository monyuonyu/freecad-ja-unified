diff --git a/src/Mod/Unified/Gui/Workbench.cpp b/src/Mod/Unified/Gui/Workbench.cpp
index c66aa1725..748175a04 100644
--- a/src/Mod/Unified/Gui/Workbench.cpp
+++ b/src/Mod/Unified/Gui/Workbench.cpp
@@ -216,6 +216,45 @@ Gui::ToolBarItem* Workbench::setupToolBars() const
     return root;
 }
 
+void Workbench::setupContextMenu(const char* recipient, Gui::MenuItem* item) const
+{
+    StdWorkbench::setupContextMenu(recipient, item);
+
+    // Keep the right-click menu short: what is needed for modelling. Links, selectability,
+    // freezing, window docking and the Python console stay in the main menus.
+    const char* rarelyUsed[] = {
+        "Link Actions",
+        "Std_TreeSelection",
+        "Std_TreeSelectAllInstances",
+        "Std_ToggleSelectability",
+        "Std_ToggleFreeze",
+        "Std_ViewDockUndockFullscreen",
+        "Std_SendToPythonConsole",
+    };
+    for (const char* name : rarelyUsed) {
+        while (Gui::MenuItem* found = item->findItem(name)) {
+            Gui::MenuItem* parent = item->findParentOf(name);
+            (parent ? parent : item)->removeItem(found);
+            delete found;
+        }
+    }
+    // No separators at the start, at the end or next to each other
+    QList<Gui::MenuItem*> items = item->getItems();
+    bool lastWasSeparator = true;
+    for (int i = 0; i < items.size(); ++i) {
+        bool isSeparator = items[i]->command() == "Separator";
+        bool atEnd = std::all_of(items.begin() + i + 1, items.end(), [](Gui::MenuItem* m) {
+            return m->command() == "Separator";
+        });
+        if (isSeparator && (lastWasSeparator || atEnd)) {
+            item->removeItem(items[i]);
+            delete items[i];
+            continue;
+        }
+        lastWasSeparator = isSeparator;
+    }
+}
+
 Gui::ToolBarItem* Workbench::setupCommandBars() const
 {
     return new Gui::ToolBarItem;
diff --git a/src/Mod/Unified/Gui/Workbench.h b/src/Mod/Unified/Gui/Workbench.h
