 TYPESYSTEM_SOURCE(UnifiedGui::Workbench, Gui::StdWorkbench)
 
+namespace
+{
+// Move the named commands of a menu, in the given order, into a submenu
+void moveIntoSubmenu(Gui::MenuItem* menu, Gui::MenuItem* submenu, std::initializer_list<const char*> names)
+{
+    for (const char* name : names) {
+        QList<Gui::MenuItem*> items = menu->getItems();
+        auto it = std::find_if(items.begin(), items.end(), [name](Gui::MenuItem* m) {
+            return m->command() == name;
+        });
+        if (it != items.end()) {
+            menu->removeItem(*it);
+            submenu->appendItem(*it);
+        }
+    }
+}
+
+// No separators at the start, at the end or next to each other
+void tidySeparators(Gui::MenuItem* menu)
+{
+    QList<Gui::MenuItem*> items = menu->getItems();
+    bool lastWasSeparator = true;
+    for (int i = 0; i < items.size(); ++i) {
+        bool isSeparator = items[i]->command() == "Separator";
+        bool atEnd = std::all_of(items.begin() + i + 1, items.end(), [](Gui::MenuItem* m) {
+            return m->command() == "Separator";
+        });
+        if (isSeparator && (lastWasSeparator || atEnd)) {
+            menu->removeItem(items[i]);
+            delete items[i];
+            continue;
+        }
+        lastWasSeparator = isSeparator;
+    }
+}
+}  // namespace
+
 // The toolbar names below are also listed in SketcherGui (nonEditModeToolbarNames) so that
 // they are hidden while a sketch is edited and only the sketch tools are shown.
 
