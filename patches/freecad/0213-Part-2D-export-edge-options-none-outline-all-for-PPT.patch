+def read_slide(path):
+    """The spTree element of the only slide of a PPTX file."""
+    with zipfile.ZipFile(path) as z:
+        root = ET.fromstring(z.read("ppt/slides/slide1.xml"))
+    return root.find("p:cSld/p:spTree", NS)
+
+
+def shape_line(sp):
+    """Line colour of a shape ('RRGGBB') or None without a line."""
+    ln = sp.find("p:spPr/a:ln", NS)
+    clr = ln.find("a:solidFill/a:srgbClr", NS) if ln is not None else None
+    return clr.get("val") if clr is not None else None
+
+
+def shape_fill(sp):
+    clr = sp.find("p:spPr/a:solidFill/a:srgbClr", NS)
+    return clr.get("val") if clr is not None else None
+
