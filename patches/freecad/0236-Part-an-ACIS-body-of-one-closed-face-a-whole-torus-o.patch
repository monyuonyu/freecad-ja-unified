From 622c17ebaa86c92b4c94adaea36ea4c704f12e0f Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Tue, 20 Oct 2026 08:41:41 +0900
Subject: [PATCH 236/326] Part: an ACIS body of one closed face (a whole torus
 or sphere) becomes a solid

Sewing leaves a single face alone, so no shell was found and the body came out
as a face; 1 of the 81 3DSOLIDs of the DWG test drawings (a whole torus) was
imported as a face instead of a solid.  Make the shell of the one face and close
it like the others.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/Mod/Part/AcisSat.py               |  7 +++++++
 src/Mod/Part/parttests/TestAcisSat.py | 15 +++++++++++++++
 2 files changed, 22 insertions(+)

diff --git a/src/Mod/Part/AcisSat.py b/src/Mod/Part/AcisSat.py
index eda9a79a6..1b097095c 100644
--- a/src/Mod/Part/AcisSat.py
+++ b/src/Mod/Part/AcisSat.py
@@ -999,6 +999,13 @@ def _build_body(sat, body, apply_units):
         sewn = _sew(faces, size * k)
         shells = sewn.Shells if sewn.ShapeType != "Shell" else [sewn]
         shells = [s for s in shells]
+        if not shells and len(faces) == 1:
+            # a body of one face that closes on itself (a whole torus or sphere):
+            # sewing leaves the face alone, so make its shell here
+            try:
+                shells = [Part.Shell(faces)]
+            except Part.OCCError:
+                pass
         free_faces = len(faces) - sum(len(s.Faces) for s in shells)
         if shells and all(s.isClosed() for s in shells) and free_faces <= 0:
             solids = [_close(s) for s in shells]
diff --git a/src/Mod/Part/parttests/TestAcisSat.py b/src/Mod/Part/parttests/TestAcisSat.py
index 9e84837ca..f8b9edc53 100644
--- a/src/Mod/Part/parttests/TestAcisSat.py
+++ b/src/Mod/Part/parttests/TestAcisSat.py
@@ -42,6 +42,16 @@ End-of-ACIS-data
 """
 
 # the same with a cone: radius 5 at z 0, 2.5 at z 10
+# hand written: a whole torus R 10 r 2, one face without loops (sphere-like closed bodies too)
+TORUS = """106 0 1 0
+body $-1 $1 $-1 $-1 #
+lump $-1 $-1 $2 $0 #
+shell $-1 $-1 $-1 $3 $1 #
+face $-1 $-1 $-1 $2 $-1 $4 forward single #
+torus-surface $-1 0 0 0 0 0 1 10 2 1 0 0 forward I I I I #
+End-of-ACIS-data
+"""
+
 CONE = """106 0 1 0
 body $-1 $1 $-1 $-1 #
 lump $-1 $-1 $2 $0 #
@@ -215,6 +225,11 @@ class TestAcisSat(unittest.TestCase):
         shape = self.check(CONE, 3.14159265358979 * 10 / 3 * (25 + 12.5 + 6.25))
         self.assertIn("Part::GeomCone", [f.Surface.TypeId for f in shape.Faces])
 
+    def testWholeTorusOfOneFaceIsASolid(self):
+        # one face that closes on itself: sewing leaves it alone, the shell must still close
+        shape = self.check(TORUS, 2 * 3.14159265358979**2 * 10 * 4)
+        self.assertTrue(shape.isClosed())
+
     def testTransform(self):
         self.check(BOX_R14, 125, (15.27672547, -223.35012266, 0, 20.27672547, -218.35012266, 5))
 
