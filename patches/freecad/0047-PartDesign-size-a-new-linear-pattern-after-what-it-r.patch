 //===========================================================================
 // PartDesign_LinearPattern
 //===========================================================================
+namespace
+{
+// A first distance for a new linear pattern: twice the size of what is repeated, rounded up to
+// 1, 2 or 5 times a power of ten, so that the copy appears next to the original. A fixed
+// 100 mm put the copy of a small part far outside the view.
+double defaultPatternLength(const std::vector<App::DocumentObject*>& features)
+{
+    Base::BoundBox3d box;
+    for (App::DocumentObject* feature : features) {
+        if (auto* addSub = dynamic_cast<PartDesign::FeatureAddSub*>(feature)) {
+            box.Add(addSub->AddSubShape.getBoundingBox());
+        }
+        else if (auto* part = dynamic_cast<Part::Feature*>(feature)) {
+            box.Add(part->Shape.getBoundingBox());
+        }
+    }
+    if (!box.IsValid()) {
+        return 100.0;
+    }
+    double size = std::max({box.LengthX(), box.LengthY(), box.LengthZ()});
+    if (size <= Precision::Confusion()) {
+        return 100.0;
+    }
+    double wanted = 2.0 * size;
+    double power = std::pow(10.0, std::floor(std::log10(wanted)));
+    for (double step : {1.0, 2.0, 5.0, 10.0}) {
+        if (step * power >= wanted - Precision::Confusion()) {
+            return step * power;
+        }
+    }
+    return 10.0 * power;
+}
+}  // namespace
+
 DEF_STD_CMD_A(CmdPartDesignLinearPattern)
 
 CmdPartDesignLinearPattern::CmdPartDesignLinearPattern()
