+
+// The rules of the bar are data in Python (Mod/Unified/ContextRules.py): call a function of it
+Py::Object callRules(const char* function, const Py::Tuple& args = Py::Tuple())
+{
+    Py::Module module(PyImport_ImportModule("ContextRules"), true);
+    if (module.isNull()) {
+        throw Py::Exception();
+    }
+    return module.callMemberFunction(function, args);
+}
+
+bool commandAvailable(const std::string& command)
+{
+    Base::PyGILStateLocker lock;
+    try {
+        Py::Tuple args(1);
+        args.setItem(0, Py::String(command));
+        return callRules("available", args).isTrue();
+    }
+    catch (Py::Exception&) {
+        Base::PyException e;
+        e.reportException();
+        return false;
+    }
+}
+
+void runRules(const char* function, const std::string& command, const QString& value = QString())
+{
+    Base::PyGILStateLocker lock;
+    try {
+        Py::Tuple args(value.isNull() ? 1 : 2);
+        args.setItem(0, Py::String(command));
+        if (!value.isNull()) {
+            args.setItem(1, Py::String(value.toStdString()));
+        }
+        callRules(function, args);
+    }
+    catch (Py::Exception&) {
+        Base::PyException e;
+        e.reportException();
+    }
+}
+
+QString defaultValue(const std::string& command)
+{
+    Base::PyGILStateLocker lock;
+    try {
+        Py::Tuple args(1);
+        args.setItem(0, Py::String(command));
+        return QString::fromStdString(Py::String(callRules("default_value", args)).as_std_string("utf-8"));
+    }
+    catch (Py::Exception&) {
+        Base::PyException e;
+        return {};
+    }
+}
