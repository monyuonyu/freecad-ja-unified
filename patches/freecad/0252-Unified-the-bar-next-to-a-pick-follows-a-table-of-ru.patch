+def _picked_edges():
+    sel = Gui.Selection.getSelectionEx()
+    if len(sel) != 1:
+        return None, []
+    s = sel[0]
+    return s.Object, [(n, e) for n, e in zip(s.SubElementNames, s.SubObjects) if n.startswith("Edge")]
+
+
+class SelectParallelEdgesCommand:
+    """The other straight edges of the shape in the same direction (the four vertical edges of
+    a box, to round them at once)"""
+
+    def GetResources(self):
+        return {
+            "Pixmap": "Part_SelectFilter",
+            "MenuText": QT_TRANSLATE_NOOP("Unified_SelectParallelEdges", "Also the Edges in the Same Direction"),
+            "ToolTip": QT_TRANSLATE_NOOP(
+                "Unified_SelectParallelEdges", "Picks the other straight edges of this shape that run the same way"
+            ),
+        }
+
+    def IsActive(self):
+        obj, edges = _picked_edges()
+        return bool(edges) and type(edges[0][1].Curve).__name__ in ("Line", "LineSegment")
+
+    def Activated(self):
+        obj, edges = _picked_edges()
+        d0 = edges[0][1].Curve.Direction
+        doc = obj.Document
+        for i, e in enumerate(obj.Shape.Edges, start=1):
+            if type(e.Curve).__name__ in ("Line", "LineSegment") and abs(abs(e.Curve.Direction.dot(d0)) - 1) < 1e-6:
+                Gui.Selection.addSelection(doc.Name, obj.Name, "Edge%d" % i)
+
+
+class SelectSameCirclesCommand:
+    """The other circles of the shape of the same size (all the holes of the same diameter)"""
+
+    def GetResources(self):
+        return {
+            "Pixmap": "Part_SelectFilter",
+            "MenuText": QT_TRANSLATE_NOOP("Unified_SelectSameCircles", "Also the Circles of the Same Size"),
+            "ToolTip": QT_TRANSLATE_NOOP(
+                "Unified_SelectSameCircles", "Picks the other circles of this shape with the same radius"
+            ),
+        }
+
+    def IsActive(self):
+        obj, edges = _picked_edges()
+        return bool(edges) and type(edges[0][1].Curve).__name__ == "Circle"
+
+    def Activated(self):
+        obj, edges = _picked_edges()
+        r0 = edges[0][1].Curve.Radius
+        doc = obj.Document
+        for i, e in enumerate(obj.Shape.Edges, start=1):
+            if type(e.Curve).__name__ == "Circle" and abs(e.Curve.Radius - r0) < 1e-6:
+                Gui.Selection.addSelection(doc.Name, obj.Name, "Edge%d" % i)
+
