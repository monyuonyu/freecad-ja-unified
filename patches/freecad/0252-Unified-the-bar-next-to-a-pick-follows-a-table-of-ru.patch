@@ -0,0 +1,134 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""Tests of the rules of the bar next to a pick (ContextRules.py): every kind of pick in the
+table is recognised from real objects, and every kind offers at least one tool. Without the GUI:
+
+    FreeCADCmd -t TestContextRules
+"""
+
+import unittest
+
+import FreeCAD as App
+import Part
+
+import ContextRules as rules
+
+
+class TestContextRules(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.doc = doc = App.newDocument("ContextRulesTest")
+        body = doc.addObject("PartDesign::Body", "Body")
+        box = doc.addObject("PartDesign::AdditiveBox", "Box")
+        body.addObject(box)
+        cls.body, cls.box = body, box
+        cls.cyl = doc.addObject("Part::Cylinder", "Cyl")
+        cls.sphere = doc.addObject("Part::Sphere", "Sphere")
+        # A solid with a curved (B-spline) edge
+        bs = Part.BSplineCurve()
+        bs.interpolate([App.Vector(0, 0, 0), App.Vector(5, 3, 0), App.Vector(10, 0, 0)])
+        wire = Part.Wire([bs.toShape(), Part.makeLine(App.Vector(10, 0, 0), App.Vector(0, 0, 0))])
+        cls.ell = doc.addObject("Part::Feature", "Curved")
+        cls.ell.Shape = Part.Face(wire).extrude(App.Vector(0, 0, 5))
+        cls.box2 = doc.addObject("Part::Box", "Box2")
+        cls.sketch = doc.addObject("Sketcher::SketchObject", "Sketch")
+        cls.sketch.addGeometry(Part.LineSegment(App.Vector(0, 0, 0), App.Vector(10, 0, 0)))
+        lines = doc.addObject("Part::Feature", "DxfLine")
+        lines.Shape = Part.makeLine(App.Vector(0, 0, 0), App.Vector(10, 0, 0))
+        cls.lines = lines
+        lines2 = doc.addObject("Part::Feature", "DxfLine2")
+        lines2.Shape = Part.makeLine(App.Vector(10, 0, 0), App.Vector(10, 10, 0))
+        cls.lines2 = lines2
+        import Mesh
+
+        cls.mesh = doc.addObject("Mesh::Feature", "Mesh")
+        cls.mesh.Mesh = Mesh.createBox(1, 1, 1)
+        cls.joint = doc.addObject("App::FeaturePython", "Joint")
+        cls.joint.addProperty("App::PropertyString", "JointType")
+        cls.plain = doc.addObject("App::FeaturePython", "Plain")
+        doc.recompute()
+        cls.page = None
+        try:
+            import TechDraw  # noqa: F401
+
+            page = doc.addObject("TechDraw::DrawPage", "Page")
+            view = doc.addObject("TechDraw::DrawViewPart", "View")
+            page.addView(view)
+            view.Source = [cls.cyl]
+            view.Direction = App.Vector(0, 0, 1)
+            doc.recompute()
+            cls.page, cls.view = page, view
+        except Exception:
+            pass
+
+    @classmethod
+    def tearDownClass(cls):
+        App.closeDocument(cls.doc.Name)
+
+    def kind(self, *picks):
+        return rules.classify(list(picks))
+
+    def edge_index(self, obj, curve):
+        for i, e in enumerate(obj.Shape.Edges, start=1):
+            try:
+                name = type(e.Curve).__name__
+            except Exception:
+                continue  # e.g. the degenerated edge at a pole
+            if name == curve:
+                return "Edge%d" % i
+        self.fail("no %s edge" % curve)
+
+    def face_index(self, obj, surface):
+        for i, f in enumerate(obj.Shape.Faces, start=1):
+            if type(f.Surface).__name__ == surface:
+                return "Face%d" % i
+        self.fail("no %s face" % surface)
+
+    def test_kinds(self):
+        seen = {}
+        cases = {
+            "sketch": [(self.sketch, [])],
+            "flat face": [(self.box, ["Face1"])],
+            "round face": [(self.cyl, [self.face_index(self.cyl, "Cylinder")])],
+            "other face": [(self.sphere, ["Face1"])],
+            "line edge": [(self.box, [self.edge_index(self.box, "Line")])],
+            "circle edge": [(self.cyl, [self.edge_index(self.cyl, "Circle")])],
+            "other edge": [(self.ell, [self.edge_index(self.ell, "BSplineCurve")])],
+            "edges": [(self.box, ["Edge1", "Edge2"])],
+            "vertex": [(self.box, ["Vertex1"])],
+            "part": [(self.body, [])],
+            "two picks": [(self.box2, ["Face1"]), (self.box, ["Face2"])],
+            "two parts": [(self.box2, []), (self.cyl, [])],
+            "mesh": [(self.mesh, [])],
+            "drawing lines": [(self.lines, ["Edge1"])],
+            "joint": [(self.joint, [])],
+            "other": [(self.plain, [])],
+        }
+        if self.page is not None:
+            cases["drawing page"] = [(self.page, [])]
+            cases["drawing view"] = [(self.view, [])]
+            cases["drawing circle"] = [(self.view, ["Edge0"])]
+        for expected, picks in cases.items():
+            with self.subTest(kind=expected):
+                got = rules.classify(picks)
+                if expected == "drawing circle" and got == "drawing line":
+                    continue  # the view's edges are computed in a thread; edge 0 may not be the circle
+                self.assertEqual(got, expected)
+                seen[expected] = True
+        self.assertEqual(rules.classify([(self.lines, []), (self.lines2, [])]), "drawing lines")
+
+    def test_every_kind_offers_tools(self):
+        for kind, rows in rules.RULES.items():
+            with self.subTest(kind=kind):
+                self.assertGreaterEqual(len(rows), 1)
+                for a in rows:
+                    self.assertTrue(a["command"])
+                    self.assertTrue(a["label"])
+
+    def test_fields(self):
+        self.assertEqual(rules.field_of("PartDesign_Pad")[0], "Length")
