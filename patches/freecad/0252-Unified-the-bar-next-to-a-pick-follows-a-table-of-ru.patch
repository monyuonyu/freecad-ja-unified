@@ -0,0 +1,382 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""What the bar next to a pick offers: the rules as data (docs/ui-redesign/00-design.md, 6.4).
+
+classify() names the kind of the picked things ("flat face", "circle edge", "mesh", ...); RULES
+says, for each kind, the tools of the bar from left to right: the first one is the most likely,
+a tool with a number field is used by typing the number and Enter (its full panel with "…").
+"Ask AI" is added last but one, and "…" (every tool that works with the pick) last, by the bar.
+Kinds without tools of their own still get "measure", "hide" and "AI".
+
+No Qt here: the rules are tested without the GUI (TestContextRules.py). The bar (ContextBar.cpp)
+asks actions_for_selection() and runs a tool with run() / run_with_value().
+"""
+
+import FreeCAD as App
+
+translate = App.Qt.translate
+
+
+def QT_TRANSLATE_NOOP(context, text):
+    return text
+
+
+def A(command, label, field=None):
+    """A tool of the bar: the command, its short name on the bar, and the number field
+    (property of the new feature, unit, default) if it takes one"""
+    return {"command": command, "label": label, "field": field}
+
+
+LENGTH = ("Length", "mm", 10.0)
+RADIUS = ("Radius", "mm", 2.0)
+SIZE = ("Size", "mm", 1.0)
+THICK = ("Value", "mm", 1.0)
+SCALE = None
+
+T = lambda text: QT_TRANSLATE_NOOP("ContextRules", text)
+
+RULES = {
+    # A sketch that is closed (picked anywhere on it)
+    "sketch": [
+        A("PartDesign_Pad", T("Extrude"), LENGTH),
+        A("PartDesign_Pocket", T("Cut in"), LENGTH),
+        A("PartDesign_Revolution", T("Revolve")),
+        A("Sketcher_EditSketch", T("Edit")),
+    ],
+    "flat face": [
+        A("PartDesign_NewSketch", T("Sketch")),
+        A("PartDesign_Pad", T("Extrude"), LENGTH),
+        A("PartDesign_Pocket", T("Cut in"), LENGTH),
+        A("Unified_Hole", T("Hole")),
+        A("PartDesign_Thickness", T("Shell"), THICK),
+        A("Unified_SnapFaces", T("Snap")),
+    ],
+    "round face": [
+        A("Std_Measure", T("Measure")),
+        A("Unified_SnapAxes", T("Line up axes")),
+        A("PartDesign_Fillet", T("Fillet"), RADIUS),
+    ],
+    "other face": [
+        A("Std_Measure", T("Measure")),
+        A("PartDesign_Thickness", T("Shell"), THICK),
+    ],
+    "line edge": [
+        A("PartDesign_Fillet", T("Fillet"), RADIUS),
+        A("PartDesign_Chamfer", T("Chamfer"), SIZE),
+        A("Unified_SelectParallelEdges", T("Same direction")),
+        A("Std_Measure", T("Measure")),
+    ],
+    "circle edge": [
+        A("PartDesign_Fillet", T("Fillet"), RADIUS),
+        A("PartDesign_Chamfer", T("Chamfer"), SIZE),
+        A("Unified_SelectSameCircles", T("Same circles")),
+        A("Unified_MovePointToPoint", T("Point to point")),
+        A("Std_Measure", T("Measure")),
+    ],
+    "other edge": [
+        A("PartDesign_Fillet", T("Fillet"), RADIUS),
+        A("PartDesign_Chamfer", T("Chamfer"), SIZE),
+        A("Std_Measure", T("Measure")),
+    ],
+    "edges": [
+        A("PartDesign_Fillet", T("Fillet"), RADIUS),
+        A("PartDesign_Chamfer", T("Chamfer"), SIZE),
+        A("Std_Measure", T("Measure")),
+    ],
+    "vertex": [
+        A("Unified_MovePointToPoint", T("Point to point")),
+        A("Std_Measure", T("Measure")),
+    ],
+    "part": [
+        A("Std_TransformManip", T("Move")),
+        A("Unified_SnapFaces", T("Snap")),
+        A("Unified_MovePointToPoint", T("Point to point")),
+        A("Part_Mirror", T("Mirror")),
+        A("Std_ToggleVisibility", T("Hide")),
+    ],
+    # Two picks on two parts (the first one moves; which of these fit the commands decide)
+    "two picks": [
+        A("Unified_SnapFaces", T("Snap")),
+        A("Unified_SnapAxes", T("Line up axes")),
+        A("Unified_PointToFace", T("Point onto face")),
+        A("Unified_MovePointToPoint", T("Point to point")),
+        A("Std_Measure", T("Distance")),
+    ],
+    "two parts": [
+        A("Part_Fuse", T("Join")),
+        A("Part_Cut", T("Subtract")),
+        A("Part_Common", T("Overlap")),
+        A("Std_Measure", T("Distance")),
+    ],
+    "mesh": [
+        A("Mesh_Evaluation", T("Check and fix")),
+        A("Part_ShapeFromMesh", T("Make solid")),
+        A("Mesh_Scale", T("Scale")),
+        A("Mesh_Export", T("Export")),
+    ],
+    # Lines of an opened 2D drawing (DXF, DWG, JWW)
+    "drawing lines": [
+        A("PartDesign_Pad", T("Extrude outline"), LENGTH),
+        A("Draft_Draft2Sketch", T("To sketch")),
+        A("Draft_Upgrade", T("Join to face")),
+        A("Std_ToggleVisibility", T("Hide")),
+    ],
+    # In a technical drawing
+    "drawing circle": [
+        A("TechDraw_DiameterDimension", T("Diameter")),
+        A("TechDraw_RadiusDimension", T("Radius")),
+        A("TechDraw_CircleCenterLines", T("Center lines")),
+        A("TechDraw_CosmeticThread", T("Thread")),
+    ],
+    "drawing line": [
+        A("TechDraw_LengthDimension", T("Length")),
+        A("TechDraw_HorizontalDimension", T("Horizontal")),
+        A("TechDraw_VerticalDimension", T("Vertical")),
+        A("TechDraw_CenterLineGroup", T("Center line")),
+    ],
+    "drawing two lines": [
+        A("TechDraw_LengthDimension", T("Distance")),
+        A("TechDraw_AngleDimension", T("Angle")),
+        A("TechDraw_2LineCenterLine", T("Center line")),
+    ],
+    "drawing view": [
+        A("TechDraw_ExtensionCircleCenterLines", T("Center lines")),
+        A("TechDraw_SectionView", T("Section")),
+        A("TechDraw_DetailView", T("Detail")),
+    ],
+    "drawing page": [
+        A("TechDraw_PrintAll", T("PDF / print")),
+        A("TechDraw_ExportPageDXF", T("DXF")),
+        A("TechDraw_ExportPageSVG", T("SVG")),
+    ],
+    "joint": [
+        A("Std_ToggleVisibility", T("Hide")),
+        A("Std_Delete", T("Delete")),
+    ],
+    # Something picked that none of the rows above knows
+    "other": [
+        A("Std_Measure", T("Measure")),
+        A("Std_ToggleVisibility", T("Hide")),
+    ],
+}
+
+
+def _is(obj, type_name):
+    try:
+        return obj.isDerivedFrom(type_name)
+    except Exception:
+        return False
+
+
+def _sub_shape(obj, sub):
+    try:
+        return obj.getSubObject(sub)
+    except Exception:
+        return None
+
+
+def _surface_kind(face):
+    try:
+        name = type(face.Surface).__name__
+    except Exception:
+        return "other face"
+    if name == "Plane":
+        return "flat face"
+    if name in ("Cylinder", "Cone"):
+        return "round face"
+    return "other face"
+
+
+def _curve_kind(edge):
+    try:
+        name = type(edge.Curve).__name__
+    except Exception:
+        return "other edge"
+    if name in ("Line", "LineSegment"):
+        return "line edge"
+    if name == "Circle":
+        return "circle edge"
+    return "other edge"
+
+
+def is_loose_2d(obj):
+    """Lines of a 2D drawing: a shape of edges only, not in a part (see LooseOutline.py)"""
+    if not _is(obj, "Part::Feature") or _is(obj, "PartDesign::Feature") or _is(obj, "Part::Part2DObject"):
+        return False
+    if any(_is(p, "PartDesign::Body") for p in obj.InList):
+        return False
+    shape = obj.Shape
+    return not shape.isNull() and bool(shape.Edges) and not shape.Faces and not shape.Solids
+
+
+def _drawing_edge_kind(view, sub):
+    try:
+        index = int(sub[4:])
+        edge = view.getEdgeByIndex(index)
+        name = type(edge.Curve).__name__ if hasattr(edge, "Curve") else ""
+    except Exception:
+        name = ""
+    return "drawing circle" if name in ("Circle", "ArcOfCircle") else "drawing line"
+
+
+def classify(picks):
+    """The kind of what is picked. picks: a list of (object, [element names])"""
+    if not picks:
+        return None
+    objs = [o for o, _ in picks]
+    subs = [list(s) for _, s in picks]
+    flat = [s for ss in subs for s in ss]
+
+    # In a technical drawing
+    if all(_is(o, "TechDraw::DrawViewPart") for o in objs):
+        edges = [s for s in flat if s.startswith("Edge")]
+        if len(picks) == 1 and not flat:
+            return "drawing view"
+        if len(edges) == 1 and len(flat) == 1:
+            return _drawing_edge_kind(objs[0], edges[0])
+        if len(edges) == 2 and len(flat) == 2:
+            return "drawing two lines"
+        return "drawing view"
+    if len(picks) == 1 and _is(objs[0], "TechDraw::DrawPage") and not flat:
+        return "drawing page"
+    if all(_is(o, "Assembly::JointGroup") or hasattr(o, "JointType") for o in objs):
+        return "joint"
+
+    if len(picks) == 1:
+        obj, ss = objs[0], subs[0]
+        if _is(obj, "Sketcher::SketchObject"):
+            return "sketch"
+        if _is(obj, "Mesh::Feature"):
+            return "mesh"
+        if is_loose_2d(obj):
+            return "drawing lines"
+        if not ss:
+            if _is(obj, "Part::Feature") or _is(obj, "App::Part") or _is(obj, "App::Link"):
+                return "part"
+            return "other"
+        if len(ss) == 1:
+            shape = _sub_shape(obj, ss[0])
+            if ss[0].startswith("Face") and shape is not None:
+                return _surface_kind(shape)
+            if ss[0].startswith("Edge") and shape is not None:
+                return _curve_kind(shape)
+            if ss[0].startswith("Vertex"):
+                return "vertex"
+            return "other"
+        if all(s.startswith("Edge") for s in ss):
+            return "edges"
+        return "other"
+
+    # Several picks
+    if all(is_loose_2d(o) for o in objs):
+        return "drawing lines"
+    if all(len(s) == 1 for s in subs) and len(picks) == 2 and objs[0] != objs[1]:
+        return "two picks"
+    if all(not s for s in subs) and len(picks) == 2:
+        return "two parts"
+    if all(s and all(x.startswith("Edge") for x in s) for s in subs):
+        return "edges"
+    return "other"
+
+
+def actions_for(kind):
+    return [dict(a) for a in RULES.get(kind or "", [])]
+
+
+# --------------------------------------------------------------------------- with the GUI
+def selection_picks():
+    import FreeCADGui as Gui
+
+    return [(s.Object, list(s.SubElementNames)) for s in Gui.Selection.getSelectionEx()]
+
+
+def actions_for_selection():
+    """For the bar: [(command, translated label, field unit or "")]"""
+    kind = classify(selection_picks())
+    out = []
+    for a in actions_for(kind):
+        label = translate("ContextRules", a["label"])
+        field = a["field"]
+        out.append((a["command"], label, field[1] if field else ""))
+    return out
+
+
+def _entry(command):
+    import CommandSearchGui
+
+    CommandSearchGui.entries()
+    return CommandSearchGui._by_name.get(command)
+
+
+def available(command):
+    """The command can be offered: registered, or in the catalog (its module is loaded when used)"""
+    import FreeCADGui as Gui
+
+    if command in Gui.listCommands():
+        try:
+            return Gui.Command.get(command).isActive()
+        except Exception:
+            return False
+    e = _entry(command)
+    return e is not None and bool(e.get("wb"))
+
+
+def run(command):
+    import FreeCADGui as Gui
+
+    if command in Gui.listCommands():
+        Gui.runCommand(command)
+        return
+    e = _entry(command)
+    if e:
+        import CommandSearchGui
+
+        CommandSearchGui.run(e)
+
+
+def field_of(command):
+    for rows in RULES.values():
+        for a in rows:
+            if a["command"] == command and a["field"]:
+                return a["field"]
+    return None
+
+
+def default_value(command):
+    """The number shown in the field: the last one used with this tool, else the default"""
+    field = field_of(command)
+    if not field:
+        return ""
+    p = App.ParamGet("User parameter:BaseApp/Preferences/Mod/Unified/ContextBar")
+    return p.GetString(command, "{:g} {}".format(field[2], field[1]))
+
+
+def run_with_value(command, text):
+    """Run the tool and give its new feature the typed number, without its panel"""
+    import FreeCADGui as Gui
+    from PySide import QtWidgets
+
+    field = field_of(command)
+    run(command)
+    QtWidgets.QApplication.processEvents()
+    gdoc = Gui.ActiveDocument
+    edit = gdoc.getInEdit() if gdoc else None
+    obj = edit.Object if edit is not None else None
+    if field is None or obj is None or not hasattr(obj, field[0]):
+        return  # the panel stays open: the number is set there
+    try:
+        value = App.Units.Quantity(text if any(c.isalpha() for c in text) else text + " " + field[1])
+    except Exception as e:
+        App.Console.PrintWarning("Context bar: {}: {}\n".format(command, e))
+        return
+    # Close the panel first (it writes its own fields into the feature), then the number: the
+    # tool and its number are one step to undo
+    import UnifiedChrome
+
+    UnifiedChrome.band().finish()
+    QtWidgets.QApplication.processEvents()
+    try:
+        setattr(obj, field[0], value)
+        obj.Document.recompute()
+        App.ParamGet("User parameter:BaseApp/Preferences/Mod/Unified/ContextBar").SetString(command, text)
+    except Exception as e:
+        App.Console.PrintWarning("Context bar: {}: {}\n".format(command, e))
