+        specialist_started = False
+        for wb, specialist in KINDS:
+            if not any(module_of(e) == wb and not core.hidden(e) for e in self.entries):
+                continue
+            if specialist and not specialist_started:
+                head = QtWidgets.QListWidgetItem(translate("Unified", "Specialist toolboxes"))
+                head.setFlags(QtCore.Qt.NoItemFlags)
+                f = head.font()
+                f.setBold(True)
+                head.setFont(f)
+                self.kinds.addItem(head)
+                specialist_started = True
+            item = QtWidgets.QListWidgetItem(core.MODULE_JA.get(wb, wb))
+            item.setData(QtCore.Qt.UserRole, wb)
+            self.kinds.addItem(item)
+        self.kinds.blockSignals(False)
+        self.kinds.setCurrentRow(0)
+        self.show_kind(0)
+        mw = Gui.getMainWindow()
+        geo = mw.geometry()
+        self.move(geo.x() + (geo.width() - self.width()) // 2, geo.y() + 90)
+        self.show()
