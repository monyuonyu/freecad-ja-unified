@@ -0,0 +1,544 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""The window of the integrated environment without modes (docs/ui-redesign/00-design.md, 0.2).
+
+- The top: "☰" (files, the window, help; the menus come from Workbench.cpp) and, at the right,
+  undo / redo, the tool search, the AI and the preferences
+- One tool strip that is the same whatever is picked or open (Workbench.cpp)
+- One-key shortcuts for the tools of the strip, which never fire while text is typed (a text field
+  has the focus, or the Japanese input method composes) or while a sketch is edited (its own
+  keys then)
+- "Other tools": every tool of every module by kind, loaded when first used
+- Commands: new part / assembly / drawing, put a part into an assembly, edit the sketch of a step
+"""
+
+import os
+
+import FreeCAD as App
+import FreeCADGui as Gui
+from PySide import QtCore, QtGui, QtWidgets
+
+import CommandSearchCore as core
+
+translate = App.Qt.translate
+HERE = os.path.dirname(os.path.abspath(__file__))
+
+
+def QT_TRANSLATE_NOOP(context, text):
+    return text
+
+
+def params():
+    return App.ParamGet("User parameter:BaseApp/Preferences/Mod/Unified")
+
+
+def classic():
+    return params().GetBool("ClassicChrome", False)
+
+
+# --------------------------------------------------------------------------- commands
+def _new_document():
+    Gui.runCommand("Std_New")
+    return App.ActiveDocument
+
+
+class NewPartCommand:
+    def GetResources(self):
+        return {
+            "Pixmap": "PartDesign_Body",
+            "MenuText": QT_TRANSLATE_NOOP("Unified_NewPart", "New Part"),
+            "ToolTip": QT_TRANSLATE_NOOP("Unified_NewPart", "A new file with a part; then click where to draw"),
+            "Accel": "Ctrl+N",
+        }
+
+    def IsActive(self):
+        return True
+
+    def Activated(self):
+        _new_document()
+        Gui.runCommand("PartDesign_Body")
+        if not Gui.Control.activeDialog():
+            Gui.runCommand("PartDesign_NewSketch")
+
+
+class NewAssemblyCommand:
+    def GetResources(self):
+        return {
+            "Pixmap": "Geoassembly",
+            "MenuText": QT_TRANSLATE_NOOP("Unified_NewAssembly", "New Assembly"),
+            "ToolTip": QT_TRANSLATE_NOOP("Unified_NewAssembly", "A new file to put parts together in"),
+        }
+
+    def IsActive(self):
+        return True
+
+    def Activated(self):
+        _new_document()
+        Gui.runCommand("Assembly_CreateAssembly")
+
+
+def _shapes_to_draw():
+    """The parts to draw: the picked ones, else the visible parts of the document"""
+    doc = App.ActiveDocument
+    picked = [s.Object for s in Gui.Selection.getSelectionEx()]
+    if picked:
+        return picked
+    if not doc:
+        return []
+    out = []
+    for obj in doc.RootObjects:
+        if obj.isDerivedFrom("TechDraw::DrawPage"):
+            continue
+        if obj.isDerivedFrom("App::Part") or obj.isDerivedFrom("Part::Feature") or obj.isDerivedFrom("App::Link"):
+            if getattr(obj, "Visibility", True):
+                out.append(obj)
+    return out
+
+
+class NewDrawingCommand:
+    def GetResources(self):
+        return {
+            "Pixmap": "actions/TechDraw_ProjectionGroup",
+            "MenuText": QT_TRANSLATE_NOOP("Unified_NewDrawing", "Make Drawing"),
+            "ToolTip": QT_TRANSLATE_NOOP(
+                "Unified_NewDrawing",
+                "A drawing sheet with the three views of the picked part (of all parts if none is picked)",
+            ),
+        }
+
+    def IsActive(self):
+        return App.ActiveDocument is not None
+
+    def Activated(self):
+        shapes = _shapes_to_draw()
+        if not shapes:
+            Gui.getMainWindow().statusBar().showMessage(
