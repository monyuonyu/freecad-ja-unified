+    def show_kind(self, row):
+        import CommandSearchGui
+
+        item = self.kinds.item(row)
+        wb = item.data(QtCore.Qt.UserRole) if item else None
+        self.tools.clear()
+        if not wb:
+            return
+        text = self.filter.text().strip()
+        if text:
+            shown = core.search(text, [e for e in self.entries if module_of(e) == wb], limit=500)
+        else:
+            shown = [e for e in self.entries if module_of(e) == wb and not core.hidden(e)]
+        groups = {}
+        for e in shown:
+            path = ""
+            for place in e.get("places", []):
+                if place.get("wb") == wb and place.get("menu"):
+                    # Below the module's own menu; its tools at the top of that menu go first
+                    path = " › ".join(place["menu"][1:]) or core.MODULE_JA.get(wb, place["menu"][0])
+                    break
+            groups.setdefault(path, []).append(e)
+        loaded = set(Gui.listCommands())
+        top = core.MODULE_JA.get(wb, "")
+        for path in sorted(groups, key=lambda p: (p == "", p != top, p)):
+            parent = QtWidgets.QTreeWidgetItem([path or translate("Unified", "Not in a menu")])
+            parent.setFlags(QtCore.Qt.ItemIsEnabled)
+            self.tools.addTopLevelItem(parent)
+            for e in sorted(groups[path], key=lambda x: x.get("ja") or x.get("en") or x["name"]) if not text else groups[path]:
+                CommandSearchGui.refresh_texts(e)
+                name = e.get("ja") or e.get("en") or e["name"]
+                child = QtWidgets.QTreeWidgetItem([name])
+                child.setData(0, QtCore.Qt.UserRole, e["name"])
+                child.setToolTip(0, CommandSearchGui.strip_tags(e.get("tip_ja") or e.get("tip_en")))
