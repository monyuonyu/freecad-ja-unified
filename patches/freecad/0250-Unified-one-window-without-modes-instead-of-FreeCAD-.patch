+# --------------------------------------------------------------------------- one-key shortcuts
+KEYS = {
+    "S": "PartDesign_NewSketch",
+    "E": "PartDesign_Pad",
+    "C": "PartDesign_Pocket",
+    "H": "Unified_Hole",
+    "F": "PartDesign_Fillet",
+    "M": "Std_TransformManip",
+    "D": "Std_Measure",
+}
