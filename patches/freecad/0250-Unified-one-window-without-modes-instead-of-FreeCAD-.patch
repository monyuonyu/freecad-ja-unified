+class OtherTools(QtWidgets.QWidget):
+    """Every tool by kind (module) and by the menu its module put it in"""
+
+    def __init__(self, parent):
+        super().__init__(parent, QtCore.Qt.Tool)
+        self.setObjectName("UnifiedOtherTools")
+        self.setWindowTitle(translate("Unified", "Other tools"))
+        self.resize(900, 620)
