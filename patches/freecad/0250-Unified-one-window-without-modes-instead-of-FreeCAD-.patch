+def install():
+    if classic():
+        import CommandSearchGui
+
+        CommandSearchGui.install_field()
+        return
+    # After the menus and toolbars are set up (the actions of the commands exist then)
+    QtCore.QTimer.singleShot(0, install_top)
+    QtCore.QTimer.singleShot(0, strip_tooltips)
+    install_keys()
