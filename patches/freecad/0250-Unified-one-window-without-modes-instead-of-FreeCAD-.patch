+TEXT_WIDGETS = (
+    QtWidgets.QLineEdit,
+    QtWidgets.QTextEdit,
+    QtWidgets.QPlainTextEdit,
+    QtWidgets.QAbstractSpinBox,
+)
+
+
+def typing_text(widget):
+    """True when keys go into text: a text field has the focus, or an input method composes"""
+    if widget is None:
+        return False
+    if isinstance(widget, TEXT_WIDGETS):
+        return True
+    if isinstance(widget, QtWidgets.QComboBox) and widget.isEditable():
+        return True
+    if isinstance(widget, QtWidgets.QAbstractItemView) and widget.state() == QtWidgets.QAbstractItemView.EditingState:
+        return True
+    # Any other widget that takes text through the input method (e.g. the Japanese IME)
+    if widget.testAttribute(QtCore.Qt.WA_InputMethodEnabled):
+        try:
+            if widget.inputMethodQuery(QtCore.Qt.ImEnabled):
+                return True
+        except Exception:
+            pass
+    return False
+
+
+def one_key_command(event):
+    """The command a key press runs, or None"""
+    if event.modifiers() & ~QtCore.Qt.KeypadModifier:
+        return None
+    text = event.text().upper()
+    if len(text) != 1 or text not in KEYS:
+        return None
+    app = QtWidgets.QApplication.instance()
+    if app.activePopupWidget() or app.activeModalWidget():
+        return None
+    if typing_text(app.focusWidget()):
+        return None
+    # While a sketch is edited, its own keys (dimension D, coincident C …)
+    gdoc = Gui.ActiveDocument
+    if gdoc is not None and gdoc.getInEdit() is not None:
+        return None
+    window = app.activeWindow()
+    if window is not Gui.getMainWindow():
+        return None
+    return KEYS[text]
+
+
+class KeyFilter(QtCore.QObject):
+    def eventFilter(self, obj, event):
+        if event.type() == QtCore.QEvent.ShortcutOverride and isinstance(obj, QtWidgets.QWidget):
+            name = one_key_command(event)
+            if name:
+                event.accept()
+                QtCore.QTimer.singleShot(0, lambda: Gui.runCommand(name))
+                return True
+        return False
+
+
+_key_filter = None
+
+
+def install_keys():
+    """One-key shortcuts for the tool strip. Commands that had one of these keys lose it
+    (the integrated environment's keys win: the assembly joints are on the bar next to the
+    picked faces); the sketch keys stay, as they only act while a sketch is edited."""
+    global _key_filter
+    if _key_filter is None:
+        _key_filter = KeyFilter()
+        QtWidgets.QApplication.instance().installEventFilter(_key_filter)
+    ours = set(KEYS.values())
+    for name in Gui.listCommands():
+        if name in ours or name.startswith("Sketcher_"):
+            continue
+        try:
+            cmd = Gui.Command.get(name)
+            first = cmd.getShortcut().replace(" ", "").split(",")[0].upper()
+        except Exception:
+            continue
+        if first in KEYS:
+            cmd.setShortcut("")
+
+
+# --------------------------------------------------------------------------- the top of the window
+def _tool_button(parent, command, text_too=False):
+    if command not in Gui.listCommands():
+        return None
+    actions = Gui.Command.get(command).getAction()
+    if actions:
+        action = actions[0]
+    else:
+        # A command in no menu or toolbar has no action yet: one that runs it
+        info = Gui.Command.get(command).getInfo()
+        ctx = command if info.get("className") in ("PythonCommand", "PythonGroupCommand") else info.get("className")
+        pixmap = info.get("pixmap") or ""
+        icon = QtGui.QIcon(pixmap) if os.path.isfile(pixmap) else Gui.getIcon(pixmap) if pixmap else QtGui.QIcon()
+        action = QtGui.QAction(icon, core.plain(QtCore.QCoreApplication.translate(ctx, info.get("menuText") or "")), parent)
+        action.setToolTip(QtCore.QCoreApplication.translate(ctx, info.get("toolTip") or ""))
+        action.triggered.connect(lambda checked=False, c=command: Gui.runCommand(c))
+    b = QtWidgets.QToolButton(parent)
+    b.setDefaultAction(action)
+    b.setAutoRaise(True)
+    b.setToolButtonStyle(QtCore.Qt.ToolButtonTextBesideIcon if text_too else QtCore.Qt.ToolButtonIconOnly)
+    b.setObjectName("UnifiedTop_" + command)
+    return b
+
+
+def install_top():
+    """Undo, redo, the search, the AI and the preferences at the right of "☰" """
+    import CommandSearchGui
+
+    mw = Gui.getMainWindow()
+    bar = mw.menuBar()
+    if mw.findChild(QtWidgets.QWidget, "UnifiedTopRight"):
+        return
+    holder = QtWidgets.QWidget(bar)
+    holder.setObjectName("UnifiedTopRight")
+    lay = QtWidgets.QHBoxLayout(holder)
+    lay.setContentsMargins(4, 0, 6, 0)
+    lay.setSpacing(2)
+    for command in ("Std_Undo", "Std_Redo"):
+        b = _tool_button(holder, command)
+        if b:
+            lay.addWidget(b)
+    lay.addSpacing(12)
+    lay.addWidget(CommandSearchGui.SearchField(holder))
+    lay.addSpacing(12)
+    for command, text in (("Unified_AIChat", True), ("Std_DlgPreferences", False)):
+        b = _tool_button(holder, command, text)
+        if b:
+            lay.addWidget(b)
+    corner = bar.cornerWidget(QtCore.Qt.TopRightCorner)
+    if corner is not None and corner.layout() is not None:
+        corner.layout().insertWidget(0, holder)
+    else:
+        bar.setCornerWidget(holder, QtCore.Qt.TopRightCorner)
+    holder.show()
+    bar.adjustSize()
+
+
+def strip_tooltips():
+    """The key of each tool of the strip in its tooltip"""
+    for key, name in KEYS.items():
+        try:
+            for action in Gui.Command.get(name).getAction():
+                tip = action.toolTip()
+                mark = translate("Unified", "(key {})").format(key)
+                if mark not in tip:
+                    action.setToolTip(tip + " " + mark)
+        except Exception:
+            pass
+
