+namespace
+{
+// The stock menus and toolbars instead of the integrated environment's own (Preferences ›
+// Unified › "Show FreeCAD's menus and toolbars"), for those who miss them
+bool classicChrome()
+{
+    return App::GetApplication()
+        .GetParameterGroupByPath("User parameter:BaseApp/Preferences/Mod/Unified")
+        ->GetBool("ClassicChrome", false);
+}
+
+// Take a menu out of the menu bar (to put it into another one)
+Gui::MenuItem* takeMenu(Gui::MenuItem* root, const char* name)
+{
+    Gui::MenuItem* menu = root->findItem(name);
+    if (menu) {
+        root->removeItem(menu);
+    }
+    return menu;
+}
+
+// The tools of the tool strip: the same whatever is picked or open (no modes). The rest is
+// reached through the search (Ctrl+K), "Other tools", the bar next to what is picked and the
+// right-click menu.
+void addToolStrip(Gui::ToolBarItem& strip)
+{
+    strip << "PartDesign_NewSketch"
+          << "Separator"
+          << "PartDesign_Pad"
+          << "PartDesign_Pocket"
+          << "PartDesign_Revolution"
+          << "Unified_Hole"
+          << "Separator"
+          << "PartDesign_Fillet"
+          << "PartDesign_Chamfer"
+          << "PartDesign_Thickness"
+          << "Separator"
+          << "PartDesign_Mirrored"
+          << "PartDesign_LinearPattern"
+          << "PartDesign_PolarPattern"
+          << "Separator"
+          << "Std_TransformManip"
+          << "Unified_SnapFaces"
+          << "Std_Measure"
+          << "Separator"
+          << "Unified_NewDrawing"
+          << "Unified_PlacePart"
+          << "Separator"
+          << "Unified_OtherTools";
+}
+}  // namespace
+
+Gui::MenuItem* Workbench::setupMenuBar() const
+{
+    if (classicChrome()) {
+        return classicMenuBar();
+    }
+    // One menu ("☰") instead of a menu bar: files, the window and help. Tools are not in
+    // menus: the tool strip, the search, "Other tools", the bar next to what is picked.
+    // FreeCAD's own menus stay inside it as submenus, so that their shortcuts keep working.
+    Gui::MenuItem* stock = StdWorkbench::setupMenuBar();
+    auto root = new Gui::MenuItem;
+    auto main = new Gui::MenuItem(root);
+    main->setCommand("Unified Main Menu");
+    auto exportMenu = new Gui::MenuItem;
+    exportMenu->setCommand("Unified Import Export");
+    *exportMenu << "Std_Import" << "Std_Export" << "Separator" << "Std_Print" << "Std_PrintPreview"
+                << "Std_PrintPdf";
+    *main << "Unified_NewPart"
+          << "Unified_NewAssembly"
+          << "Unified_NewDrawing"
+          << "Separator"
+          << "Std_Open"
+          << "Std_RecentFiles"
+          << "Separator"
+          << "Std_Save"
+          << "Std_SaveAs"
+          << "Std_SaveCopy"
+          << "Std_CloseActiveWindow"
+          << "Separator" << exportMenu
+          << "Separator"
+          << "Unified_Search"
+          << "Unified_OtherTools"
+          << "Separator";
+    for (const char* name : {"&Edit", "&View", "&Tools", "&Macro", "&Windows", "&Help"}) {
+        if (Gui::MenuItem* menu = takeMenu(stock, name)) {
+            main->appendItem(menu);
+        }
+    }
+    // The tools for add-ons are not in the integrated environment, the Python console is a
+    // developer's tool: in the Tools submenu as before
+    if (Gui::MenuItem* tools = main->findItem("&Tools")) {
+        for (const char* name : {"Std_AddonMgr", "Std_AddonMgrPip"}) {
+            if (Gui::MenuItem* found = tools->findItem(name)) {
+                tools->removeItem(found);
+                delete found;
+            }
+        }
+        tidySeparators(tools);
+    }
+    if (Gui::MenuItem* help = main->findItem("&Help")) {
+        *help << "Separator" << "Unified_About";
+    }
+    // Replace "Duplicate selection" with the variant that understands bodies, as PartDesign does
+    Gui::MenuItem* edit = main->findItem("&Edit");
+    if (Gui::MenuItem* dup = edit ? edit->findItem("Std_DuplicateSelection") : nullptr) {
+        dup->setCommand("PartDesign_DuplicateSelection");
+    }
+    *main << "Separator"
+          << "Std_DlgPreferences"
+          << "Std_Quit";
+    // No duplicates: preferences and quit were in the Edit and File menus
+    if (edit) {
+        if (Gui::MenuItem* prefs = edit->findItem("Std_DlgPreferences")) {
+            edit->removeItem(prefs);
+            delete prefs;
+        }
+        tidySeparators(edit);
+    }
+    delete stock;
+    return root;
+}
+
+Gui::ToolBarItem* Workbench::setupToolBars() const
+{
+    if (classicChrome()) {
+        return classicToolBars();
+    }
+    auto root = new Gui::ToolBarItem;
+    auto strip = new Gui::ToolBarItem(root);
+    strip->textUnderIcons = true;  // names under the icons: "Extrude" is found without hovering
+    strip->setCommand("Unified Tools");
+    addToolStrip(*strip);
+
+    // Sketch tools: the toolbars of Sketcher, while a sketch is edited
+    using Vis = Gui::ToolBarItem::DefaultVisibility;
+    auto editMode = new Gui::ToolBarItem(root, Vis::Unavailable);
+    editMode->setCommand("Edit Mode");
+    SketcherGui::addSketcherWorkbenchSketchEditModeActions(*editMode);
+    auto geom = new Gui::ToolBarItem(root, Vis::Unavailable);
+    geom->setCommand("Geometries");
+    SketcherGui::addSketcherWorkbenchGeometries(*geom);
+    auto cons = new Gui::ToolBarItem(root, Vis::Unavailable);
+    cons->setCommand("Constraints");
+    SketcherGui::addSketcherWorkbenchConstraints(*cons);
+    auto tools = new Gui::ToolBarItem(root, Vis::Unavailable);
+    tools->setCommand("Sketcher Tools");
+    SketcherGui::addSketcherWorkbenchTools(*tools);
+    return root;
+}
+
 void Workbench::setupContextMenu(const char* recipient, Gui::MenuItem* item) const
 {
     StdWorkbench::setupContextMenu(recipient, item);
@@ -404,6 +557,23 @@ void Workbench::setupContextMenu(const char* recipient, Gui::MenuItem* item) con
         }
     }
     tidySeparators(item);
+
+    // A step of a part: change it where it came from, put the next step after it, move it
+    // (the commands are only active when they apply)
+    if (!classicChrome()) {
+        auto steps = Gui::Selection().getObjectsOfType(Base::Type::fromName("PartDesign::Feature"));
+        if (!steps.empty()) {
+            auto first = new Gui::MenuItem;
+            first->setCommand("Unified_EditSourceSketch");
+            QList<Gui::MenuItem*> items = item->getItems();
+            if (items.isEmpty() || !item->insertItem(items.front(), first)) {
+                item->appendItem(first);
+            }
+            *item << "Separator"
+                  << "PartDesign_MoveTip"
+                  << "PartDesign_MoveFeatureInTree";
+        }
+    }
 }
 
