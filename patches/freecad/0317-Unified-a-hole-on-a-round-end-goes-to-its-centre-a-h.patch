     # The hole goes where the face was clicked, also on faces with round edges (a fillet's
-    # arc, another hole). PartDesign's hole at a circle's center is there for a picked circle.
-    return obj, name, sel.PickedPoints[0]
+    # arc, another hole). Near the middle of a round end or eye: its centre (engine field test
+    # 0.7.3: a hole on a connecting rod's eye could not be put at the eye's centre)
+    import SnapMath
+
+    point = sel.PickedPoints[0]
+    return obj, name, SnapMath.round_center_near(face, point) or point
+
+
+def _picked_round_face():
+    """A cylindrical outside face of a solid picked in the 3D view, with the picked point and
+    the face's outward normal there (a hole goes in along it: a piston's pin hole)"""
+    import Part
+
+    selection = FreeCADGui.Selection.getSelectionEx()
+    if len(selection) != 1 or len(selection[0].SubElementNames) != 1:
+        return None
+    sel = selection[0]
+    name = sel.SubElementNames[0]
+    if not name.startswith("Face") or not sel.PickedPoints or sel.Object.isDerivedFrom("Sketcher::SketchObject"):
+        return None
+    face = sel.SubObjects[0]
+    if not isinstance(face.Surface, Part.Cylinder):
+        return None
+    point = sel.PickedPoints[0]
+    u, v = face.Surface.parameter(point)
+    normal = face.normalAt(u, v)
+    # an outside face: the normal points away from the axis (a hole's own wall points inward)
+    radial = point - face.Surface.Center
+    radial = radial - face.Surface.Axis * radial.dot(face.Surface.Axis)
+    if radial.Length < 1e-9 or normal.dot(radial) <= 0:
+        return None
+    return sel.Object, name, point, normal
+
+
+def _hole_on_round_face(obj, point, normal):
+    """The sketch of a hole on a cylindrical face: a point on a plane touching the face there,
+    facing out (the hole goes in along the face's normal, toward the axis). None outside a body."""
+    import Part
+
+    body = obj.getParentGeoFeatureGroup()
+    if body is None or not body.isDerivedFrom("PartDesign::Body"):
+        return None
+    sketch = body.newObject("Sketcher::SketchObject", "Sketch")
+    sketch.MapMode = "Deactivated"
+    local = body.getGlobalPlacement().inverse()
+    where = FreeCAD.Placement(point, FreeCAD.Rotation(FreeCAD.Vector(0, 0, 1), normal))
+    sketch.Placement = local.multiply(where)
+    sketch.addGeometry(Part.Point(FreeCAD.Vector(0, 0, 0)))
+    body.Document.recompute()
+    return sketch
 
 
 class _PickFacePanel:
@@ -89,7 +137,8 @@ class HoleCommand:
         }
 
     def IsActive(self):
-        return FreeCADGui.isCommandActive("PartDesign_Hole") or _picked_plane_face() is not None
