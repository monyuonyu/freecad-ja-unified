+def round_center_near(face, point, share=0.5):
+    """The centre of a circle of the face (an edge, or the arc of a rounded end) when the point
+    is within `share` of its radius from it: a hole clicked near the middle of a connecting
+    rod's eye goes to the eye's centre. The smallest such circle, or None."""
+    best = None
+    for e in face.Edges:
+        c = e.Curve
+        if c.TypeId != "Part::GeomCircle":
+            continue
+        d = (point - c.Center).Length
+        if d <= share * c.Radius and (best is None or c.Radius < best[0]):
+            best = (c.Radius, App.Vector(c.Center))
+    return None if best is None else best[1]
+
+
 def describe(movable):
