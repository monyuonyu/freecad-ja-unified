From d8410a10a803a7cffb8a9b66a2bfa81b2f4de1bc Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Sun, 27 Sep 2026 02:30:07 +0900
Subject: [PATCH 31/90] Unified: preferences without BIM and add-on pages;
 Japanese group names
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- In single workbench mode the preferences leave out the pages of the
  BIM workbench (IFC import/export, native IFC, DAE, SH3D, WebGL) and the
  Addon Manager, which the integrated environment does not have.
- Preference groups use the terms of the integrated environment (形,
  スケッチ, 図面, 組立), and the DXF preference texts are translated.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/Gui/Dialogs/DlgPreferencesImp.cpp         | 25 ++++++++++++++++++-
 .../Draft/Resources/translations/Draft_ja.ts  | 12 ++++-----
 .../Gui/Resources/translations/Unified_ja.ts  | 16 ++++++++++++
 3 files changed, 46 insertions(+), 7 deletions(-)

diff --git a/src/Gui/Dialogs/DlgPreferencesImp.cpp b/src/Gui/Dialogs/DlgPreferencesImp.cpp
index ac7a0e7db..71778b6df 100644
--- a/src/Gui/Dialogs/DlgPreferencesImp.cpp
+++ b/src/Gui/Dialogs/DlgPreferencesImp.cpp
@@ -400,11 +400,34 @@ void DlgPreferencesImp::setupPages()
     // make sure that pages are ready to create
     GetWidgetFactorySupplier();
 
+    // The integrated environment has no BIM workbench and no add-ons: leave out their pages
+    const bool single = App::Application::Config().contains("SingleWorkbench");
+    auto leftOut = [single](const std::string& group, const std::string& page) {
+        if (!single) {
+            return false;
+        }
+        if (group == "Addon Manager") {
+            return true;
+        }
+        for (const char* part : {"preferences-ifc", "preferencesNativeIFC", "preferences-dae",
+                                 "preferences-sh3d", "preferences-webgl"}) {
+            if (page.find(part) != std::string::npos) {
+                return true;
+            }
+        }
+        return false;
+    };
+
     for (const auto& [name, pages] : _pages) {
+        if (std::all_of(pages.begin(), pages.end(), [&](const std::string& p) { return leftOut(name, p); })) {
+            continue;
+        }
         auto* group = createGroup(name);
 
         for (const auto& page : pages) {
-            createPageInGroup(group, page);
+            if (!leftOut(name, page)) {
+                createPageInGroup(group, page);
+            }
         }
     }
 
