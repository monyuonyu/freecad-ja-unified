+# SPDX-License-Identifier: LGPL-2.1-or-later
+# Tests of MagnetDrag (dragging a part, the magnet), headless:
+#   FreeCADCmd -t TestMagnetDrag
+
+import math
+import time
+import unittest
+
+import numpy as np
+
+import FreeCAD as App
+import Part
+
+import MagnetDrag as M
+
+ISO = np.array((-1.0, -1.0, -1.0)) / math.sqrt(3)  # the camera looks down at 35 degrees
+FRONT = np.array((0.0, 1.0, 0.0))
+
+
+def box(x, y, z, l=10, w=10, h=10):
+    return Part.makeBox(l, w, h, App.Vector(x, y, z))
+
+
+def ray_to(point, d=ISO):
+    """A cursor ray that passes through the point (as if the cursor were on it)."""
+    p = np.array(point, dtype=float)
+    return p - d * 500, d
+
+
+class MagnetDragTest(unittest.TestCase):
+    def drag(self, moving, others, grab, d=ISO):
+        targets = M.Targets([(i, M.capture(s)) for i, s in enumerate(others)])
+        return M.Drag(M.capture(moving), grab, d, targets)
+
+    def moved(self, res, p):
+        return res.R.dot(np.array(p, dtype=float) - res.g0) + res.g0 + res.t
+
+    def assertVec(self, a, b, tol=1e-6):
+        self.assertLess(np.linalg.norm(np.array(a, dtype=float) - np.array(b, dtype=float)), tol, "{} != {}".format(a, b))
+
+    # -- the plain drag ----------------------------------------------------------------------
+
+    def test_slides_on_its_level_with_the_grabbed_point_under_the_cursor(self):
+        d = self.drag(box(0, 0, 0), [], (5, 5, 10))
+        res = d.solve(*ray_to((40, 25, 10)), tol=1.0)
+        self.assertVec(res.t, (35, 20, 0))
+        self.assertTrue(np.allclose(res.R, np.eye(3)))
+        self.assertTrue(res.free)
+
+    def test_side_view_moves_in_the_vertical_plane(self):
+        d = self.drag(box(0, 0, 0), [], (5, 0, 5), FRONT)
+        self.assertFalse(d.horizontal)
+        res = d.solve(*ray_to((25, 0, 30), FRONT), tol=1.0)
+        self.assertVec(res.t, (20, 0, 25))
+
+    # -- the magnet: faces ------------------------------------------------------------------
+
+    def test_box_toward_box_snaps_flush(self):
+        other = box(20, 0, 0)
+        d = self.drag(box(0, 0, 0), [other], (5, 5, 10))
+        # 1.5 mm short of touching (the right face of the moving box at x=18.5)
+        res = d.solve(*ray_to((13.5, 5, 10)), tol=2.0)
+        self.assertIn("contact", res.kinds())
+        self.assertAlmostEqual(self.moved(res, (10, 0, 0))[0], 20.0, places=6)
+        # The faces face each other and stay where the cursor put them sideways
+        self.assertAlmostEqual(res.t[2], 0.0, places=9)
+
+    def test_overshoot_is_pushed_back_and_far_breaks_free(self):
+        other = box(20, 0, 0)
+        d = self.drag(box(0, 0, 0), [other], (5, 5, 10))
+        res = d.solve(*ray_to((16, 5.5, 10)), tol=2.0)  # 1 mm into the other box
+        self.assertAlmostEqual(self.moved(res, (10, 0, 0))[0], 20.0, places=6)
+        # Held a bit further than it caught (the magnet), then free
+        res = d.solve(*ray_to((17.8, 5.5, 10)), tol=2.0)
+        self.assertIn("contact", res.kinds())
+        res = d.solve(*ray_to((19.5, 5.5, 10)), tol=2.0)
