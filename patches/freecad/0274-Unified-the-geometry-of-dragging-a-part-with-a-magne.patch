+            shapes.append(s)
+        t0 = time.perf_counter()
+        targets = M.Targets([(i, M.capture(s)) for i, s in enumerate(shapes)])
+        t_capture = time.perf_counter() - t0
+        d = M.Drag(M.capture(Part.makeCylinder(1.9, 15, App.Vector(-30, -30, 0))), (-30, -30, 15), ISO, targets)
+        times = []
+        for k in range(120):
+            x = -20 + k * 2.5
+            t0 = time.perf_counter()
+            d.solve(*ray_to((x, x * 0.7, 25)), tol=1.0)
+            times.append(time.perf_counter() - t0)
