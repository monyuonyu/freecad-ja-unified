@@ -380,7 +381,12 @@ void View3DSettings::OnChange(ParameterGrp::SubjectType& rCaller, ParameterGrp::
     }
     else if (strcmp(Reason, "UseNavigationAnimations") == 0) {
         for (auto _viewer : _viewers) {
