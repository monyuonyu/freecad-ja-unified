From f39222844357e4922030148c6293770367d7c43f Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Sat, 26 Sep 2026 23:13:30 +0900
Subject: [PATCH 02/84] Gui: make '--hidden' usable for scripted, headless runs

- Return exit code 1 when a command line file fails with a hidden main
  window, instead of always 0.
- Disable navigation animations while the main window is hidden, so
  viewIsometric(); fitAll(); saveImage() saves the final view instead of a
  half-turned camera.
- Keep print() on the terminal when the main window is hidden instead of
  redirecting it into the (invisible) report view.
- Flush Python's stdout/stderr before exit().

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/Gui/MainWindow.cpp     | 15 ++++++++++++---
 src/Gui/ReportView.cpp     |  5 +++--
 src/Gui/View3DSettings.cpp |  8 +++++++-
 src/Main/MainGui.cpp       | 28 ++++++++++++++++++++++++++--
 4 files changed, 48 insertions(+), 8 deletions(-)

diff --git a/src/Gui/MainWindow.cpp b/src/Gui/MainWindow.cpp
index 4c1fb5176..8d6057689 100644
--- a/src/Gui/MainWindow.cpp
+++ b/src/Gui/MainWindow.cpp
@@ -1884,10 +1884,12 @@ void MainWindow::delayedStartup()
     }
 
     // processing all command line files
+    bool allFilesProcessed = true;
     try {
-        std::list<std::string> files = App::Application::getCmdLineFiles();
-        files = App::Application::processFiles(files);
-        for (const auto& file : files) {
+        const std::list<std::string> files = App::Application::getCmdLineFiles();
+        const std::list<std::string> processed = App::Application::processFiles(files);
+        allFilesProcessed = processed.size() == files.size();
+        for (const auto& file : processed) {
             QString filename = QString::fromUtf8(file.c_str(), file.size());
             FileDialog::setWorkingDirectory(filename);
             QFileInfo fi(filename);
@@ -1895,11 +1897,18 @@ void MainWindow::delayedStartup()
         }
     }
     catch (const Base::SystemExitException&) {
+        QApplication::quit();
         throw;
     }
 
     if (Application::hiddenMainWindow()) {
         QApplication::quit();
+        if (!allFilesProcessed) {
+            // Scripted use: report the failure through the exit code
+            Base::PyGILStateLocker lock;
+            PyErr_SetObject(PyExc_SystemExit, Py::Long(1).ptr());
+            throw Base::SystemExitException();
+        }
         return;
     }
 
diff --git a/src/Gui/ReportView.cpp b/src/Gui/ReportView.cpp
index f1cdc5bdc..c4cb58b90 100644
--- a/src/Gui/ReportView.cpp
+++ b/src/Gui/ReportView.cpp
@@ -935,13 +935,14 @@ void ReportOutput::OnChange(Base::Subject<const char*>& rCaller, const char* sRe
         setTabStopDistance(width);
     }
     else if (strcmp(sReason, "RedirectPythonOutput") == 0) {
-        bool checked = rclGrp.GetBool(sReason, true);
+        // With a hidden main window nobody can read the report view: keep print() on the terminal
+        bool checked = rclGrp.GetBool(sReason, true) && !Application::hiddenMainWindow();
         if (checked != d->redirected_stdout) {
             onToggleRedirectPythonStdout();
         }
     }
     else if (strcmp(sReason, "RedirectPythonErrors") == 0) {
-        bool checked = rclGrp.GetBool(sReason, true);
+        bool checked = rclGrp.GetBool(sReason, true) && !Application::hiddenMainWindow();
         if (checked != d->redirected_stderr) {
             onToggleRedirectPythonStderr();
         }
diff --git a/src/Gui/View3DSettings.cpp b/src/Gui/View3DSettings.cpp
index 584839fb3..a1ed887d3 100644
--- a/src/Gui/View3DSettings.cpp
+++ b/src/Gui/View3DSettings.cpp
@@ -34,6 +34,7 @@
 #include "Navigation/NavigationStyle.h"
 #include "Selection/SelectionColors.h"
