diff --git a/src/Main/MainGui.cpp b/src/Main/MainGui.cpp
index 00975ed7b..543304e4e 100644
--- a/src/Main/MainGui.cpp
+++ b/src/Main/MainGui.cpp
@@ -92,6 +92,24 @@ private:
     FILE* file;
 };
 
+// exit() skips Python's finalization, so text still buffered in sys.stdout/sys.stderr
+// (e.g. print() output right before an exception or sys.exit()) would be lost.
+static void flushPythonStreams()
+{
+    if (!Py_IsInitialized()) {
+        return;
+    }
+    Base::PyGILStateLocker lock;
+    for (const char* name : {"stdout", "stderr"}) {
+        PyObject* stream = PySys_GetObject(name);  // borrowed
+        if (stream && stream != Py_None) {
+            PyObject* result = PyObject_CallMethod(stream, "flush", nullptr);
+            Py_XDECREF(result);
+        }
+    }
+    PyErr_Clear();
+}
+
 static bool inGuiMode()
 {
     // if console option is set then run in cmd mode
@@ -263,8 +281,10 @@ int main(int argc, char** argv)
 
         Gui::Application::initApplication();
 
-        // Only if 'RunMode' is set to 'Gui' do the replacement
-        if (App::Application::Config()["RunMode"] == "Gui") {
+        // Only if 'RunMode' is set to 'Gui' do the replacement. With a hidden main window
+        // (--hidden, scripted use) keep Python's stdout/stderr on the terminal.
+        if (App::Application::Config()["RunMode"] == "Gui"
+            && !Gui::Application::hiddenMainWindow()) {
             Base::Interpreter().replaceStdOutput();
         }
     }
@@ -347,17 +367,21 @@ int main(int argc, char** argv)
         }
     }
     catch (const Base::SystemExitException& e) {
+        flushPythonStreams();
         exit(e.getExitCode());
     }
     catch (const Base::Exception& e) {
+        flushPythonStreams();
         e.reportException();
         exit(1);
     }
     catch (const std::exception& e) {
+        flushPythonStreams();
         Base::Console().error("Application unexpectedly terminated: {}\n", e.what());
         exit(1);
     }
     catch (...) {
+        flushPythonStreams();
         Base::Console().error("Application unexpectedly terminated\n");
         exit(1);
     }
