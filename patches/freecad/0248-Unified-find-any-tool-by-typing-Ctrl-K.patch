diff --git a/src/Mod/CMakeLists.txt b/src/Mod/CMakeLists.txt
index ea5c36b6a..2d4b830a8 100644
--- a/src/Mod/CMakeLists.txt
+++ b/src/Mod/CMakeLists.txt
@@ -135,3 +135,38 @@ endif(BUILD_TUX)
 if(BUILD_WEB)
     add_subdirectory(Web)
 endif(BUILD_WEB)
+
+# The catalog of every command of every module for the tool search of the integrated environment
+# (Unified/make_catalog.py), made with the built FreeCAD once all modules are there. If it cannot
+# be made (e.g. no Qt offscreen platform), the catalog kept in the sources is installed.
+if(BUILD_UNIFIED AND BUILD_GUI)
+    function(unified_collect_targets dir out)
+        get_property(targets DIRECTORY ${dir} PROPERTY BUILDSYSTEM_TARGETS)
+        set(result)
+        foreach(target ${targets})
+            get_target_property(excluded ${target} EXCLUDE_FROM_ALL)
+            if(NOT excluded)
+                list(APPEND result ${target})
+            endif()
+        endforeach()
+        get_property(subdirs DIRECTORY ${dir} PROPERTY SUBDIRECTORIES)
+        foreach(subdir ${subdirs})
+            unified_collect_targets(${subdir} sub)
+            list(APPEND result ${sub})
+        endforeach()
+        set(${out} ${result} PARENT_SCOPE)
+    endfunction()
+    unified_collect_targets(${CMAKE_CURRENT_SOURCE_DIR} unified_module_targets)
+    set(unified_catalog ${CMAKE_BINARY_DIR}/Mod/Unified/CommandCatalog.json)
+    add_custom_target(UnifiedCommandCatalog ALL
+        COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/Unified/make_catalog.py
+            --freecad $<TARGET_FILE:FreeCADMain>
+            --generator ${CMAKE_BINARY_DIR}/Mod/Unified/CommandCatalogGen.py
+            --out ${unified_catalog}
+            --fallback ${CMAKE_CURRENT_SOURCE_DIR}/Unified/CommandCatalog.json
+        COMMENT "Making the command catalog of the tool search"
+        VERBATIM
+    )
+    add_dependencies(UnifiedCommandCatalog FreeCADMain FreeCADGui ${unified_module_targets})
+    install(FILES ${unified_catalog} DESTINATION Mod/Unified)
+endif()
