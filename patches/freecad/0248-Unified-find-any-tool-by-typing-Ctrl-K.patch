new file mode 100644
index 000000000..6ca444d32
--- /dev/null
+++ b/src/Mod/Unified/TestCommandSearch.py
@@ -0,0 +1,106 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""Tests of the tool search (Ctrl+K): the catalog reaches every command of every module, and
+typical queries find the right tool first. Runs without the GUI:
+
+    FreeCADCmd -t TestCommandSearch
+"""
+
+import unittest
+
+import CommandAliases
+import CommandSearchCore as core
+
+
+def first(query, entries, **kw):
+    found = core.search(query, entries, **kw)
+    return found[0]["name"] if found else None
+
+
+class TestFold(unittest.TestCase):
+    def test_kana_width_case(self):
+        self.assertEqual(core.fold("ＳＴＬ　ナオス"), core.fold("stl なおす"))
+        self.assertEqual(core.fold("&Pad"), "pad")
+        self.assertEqual(core.fold("押し 出し"), "押し出し")
+
+
+class TestRanking(unittest.TestCase):
+    """With a small catalog, independent of the build"""
+
+    def setUp(self):
+        raw = [
+            {"name": "PartDesign_Pad", "ja": "押し出し", "en": "Pad", "tip_ja": "スケッチを押し出して立体を作る", "tip_en": "", "places": [1]},
+            {"name": "PartDesign_Pocket", "ja": "切り抜き", "en": "Pocket", "tip_ja": "スケッチの形で切り抜く", "tip_en": "", "places": [1]},
+            {"name": "Part_Extrude", "ja": "押し出し", "en": "Extrude", "tip_ja": "", "tip_en": "", "places": [1]},
+            {"name": "PartDesign_MoveTip", "ja": "先端を設定", "en": "Set Tip", "tip_ja": "", "tip_en": "", "places": [1]},
+            {"name": "Std_TestQM", "ja": "テスト", "en": "Test translation files", "tip_ja": "", "tip_en": "", "places": []},
+            {"name": "Mesh_Evaluation", "ja": "メッシュを評価して修復", "en": "Evaluate and Repair", "tip_ja": "", "tip_en": "", "places": [1]},
+        ]
+        self.entries = core.prepare(raw, CommandAliases.ALIASES)
+
+    def test_name_and_alias(self):
+        self.assertEqual(first("押し出し", self.entries, placed={"PartDesign_Pad"}), "PartDesign_Pad")
+        self.assertEqual(first("pad", self.entries), "PartDesign_Pad")
