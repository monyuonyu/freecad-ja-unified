+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""Finding a command by what the user types: the ranking of the tool search (Ctrl+K).
+
+No Qt here, so that the ranking can be tested without the GUI (TestCommandSearch.py).
+An entry is a dict as in CommandCatalog.json: name, ja, en, tip_ja, tip_en, wb, places;
+the search adds "aliases".
+"""
+
+import json
+import os
+import re
+import unicodedata
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+CATALOG = os.path.join(HERE, "CommandCatalog.json")
+
+# Commands that are not tools for the user (tests, development, workbench switching)
+HIDDEN_PREFIXES = ("Test_", "Std_Test", "Std_Workbench", "Std_ViewIvIssueCamPos", "Std_DemoMode")
+
+
+# The names of the modules as the integrated environment calls them (the workbenches themselves
+# are not shown)
+MODULE_JA = {
+    "PartDesignWorkbench": "部品づくり",
+    "PartWorkbench": "形の加工",
+    "SketcherWorkbench": "スケッチ",
+    "DraftWorkbench": "2D の作図",
+    "TechDrawWorkbench": "図面",
+    "AssemblyWorkbench": "組立",
+    "MeshWorkbench": "メッシュ・STL",
+    "SpreadsheetWorkbench": "表",
+    "MaterialWorkbench": "材料",
+    "SurfaceWorkbench": "曲面",
+    "BIMWorkbench": "建築（BIM）",
+    "CAMWorkbench": "加工（CAM）",
+    "FemWorkbench": "解析（FEM）",
+    "RobotWorkbench": "ロボット",
+    "OpenSCADWorkbench": "OpenSCAD",
+    "PointsWorkbench": "点群",
+    "ReverseEngineeringWorkbench": "リバースエンジニアリング",
+    "InspectionWorkbench": "検査",
+}
+
+
+# Of tools with the same name, those of the everyday modules first ("押し出し" is the part's
+# extrude before BIM's)
+MODULE_RANK = {
+    "": 4, "PartDesignWorkbench": 4, "SketcherWorkbench": 4,
+    "PartWorkbench": 2, "TechDrawWorkbench": 2, "AssemblyWorkbench": 2, "MeshWorkbench": 2,
+    "SpreadsheetWorkbench": 2, "DraftWorkbench": 1,
+}
+
+
+def plain(text):
+    """A menu text without its accelerator: "&Export…" and "エクスポート(&E)…" """
+    text = re.sub(r"\s*\(&[^)]\)", "", text or "")
+    return text.replace("&&", "\0").replace("&", "").replace("\0", "&").strip()
+
+
+def module_name(entry):
+    """The module of a command in the user's words"""
+    for wb in (entry.get("module_wb"), entry.get("wb")):
+        if wb in MODULE_JA:
+            return MODULE_JA[wb]
+    return entry.get("module", "")
+
+
+def fold(text):
+    """For comparing: full-width to half-width, lower case, katakana to hiragana, no spaces,
+    no accelerator marks"""
+    text = unicodedata.normalize("NFKC", text or "").lower().replace("&", "")
+    text = "".join(chr(ord(c) - 0x60) if "ァ" <= c <= "ヶ" else c for c in text)
+    return re.sub(r"[\s・_\-]+", "", text)
+
+
+def load_catalog(path=CATALOG):
+    try:
+        with open(path, encoding="utf-8") as f:
+            data = json.load(f)
+    except (OSError, ValueError):
+        return {"workbenches": {}, "commands": []}
+    return data
+
+
+def prepare(entries, aliases):
+    """Add the aliases and the folded texts that the search compares with"""
+    for e in entries:
+        e["aliases"] = list(aliases.get(e["name"], []))
+        e["_ja"] = fold(e.get("ja", ""))
+        e["_en"] = fold(e.get("en", ""))
+        e["_name"] = fold(e["name"])
+        e["_al"] = [fold(a) for a in e["aliases"]]
+        e["_tip"] = fold(e.get("tip_ja", "")) + " " + fold(e.get("tip_en", ""))
+    return entries
+
+
+def _field_score(token, value, exact, prefix, inner):
+    if not value:
+        return 0
+    if value == token:
+        return exact
+    if value.startswith(token):
+        return prefix
+    if token in value:
+        return inner
+    return 0
+
+
+def score(entry, tokens):
+    """How well the entry matches all tokens (0: not at all). Every token must match somewhere."""
+    total = 0
+    for token in tokens:
+        best = max(
+            _field_score(token, entry["_ja"], 100, 80, 60),
+            _field_score(token, entry["_en"], 90, 70, 45),
+            max((_field_score(token, a, 95, 75, 50) for a in entry["_al"]), default=0),
+            _field_score(token, entry["_name"], 85, 55, 40),
+            15 if token and token in entry["_tip"] else 0,
+        )
+        if not best:
+            return 0
+        total += best
+    return total
+
+
+def hidden(entry):
+    return entry["name"].startswith(HIDDEN_PREFIXES) or not (entry.get("ja") or entry.get("en"))
+
+
+def search(query, entries, usable=(), placed=(), limit=40):
+    """The entries for the query, best first.
+
+    usable: names of the commands that can run with the current selection (ranked up a little,
+    so that of equally good matches the one that works now comes first)
+    placed: names of the commands that the integrated environment shows somewhere (tool strip,
+    menus, context bar), ranked up a little before those of the other tools"""
+    tokens = [t for t in (fold(t) for t in (query or "").split()) if t]
+    if not tokens:
+        return []
+    usable = set(usable)
+    placed = set(placed)
+    found = []
+    for e in entries:
+        if hidden(e):
+            continue
+        s = score(e, tokens)
+        if not s:
+            continue
+        if e["name"] in usable:
+            s += 12
+        if e["name"] in placed:
+            s += 6
+        if e.get("places"):
+            s += 3  # a tool of some menu or toolbar, not an internal command
+        s += MODULE_RANK.get(e.get("module_wb") or e.get("wb") or "", 0)
+        found.append((-s, e.get("ja") or e.get("en") or e["name"], e["name"], e))
+    found.sort(key=lambda t: t[:3])
+    return [t[3] for t in found[:limit]]
diff --git a/src/Mod/Unified/CommandSearchGui.py b/src/Mod/Unified/CommandSearchGui.py
new file mode 100644
index 000000000..ecbf1fb23
--- /dev/null
+++ b/src/Mod/Unified/CommandSearchGui.py
@@ -0,0 +1,417 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""The tool search: Ctrl+K or the search field at the top, then type what you want to do.
+
+Every command of every module is found (from CommandCatalog.json for the modules that are not
+loaded yet; such a module is loaded when one of its tools is picked), by its Japanese or English
+name, by other words for it (CommandAliases.py) and by its description. Each row says where the
+tool usually is. When nothing fits, the last row hands the question to the AI.
+"""
+
+import os
+
+import FreeCAD as App
+import FreeCADGui as Gui
+from PySide import QtCore, QtGui, QtWidgets
+
+import CommandAliases
+import CommandSearchCore as core
+
+translate = App.Qt.translate
+
+
+def QT_TRANSLATE_NOOP(context, text):
+    return text
+
+
+_entries = None
+_by_name = {}
+
+
+def entries():
+    """The catalog, with the commands registered since it was made (e.g. macros) added"""
+    global _entries
+    if _entries is None:
+        catalog = core.load_catalog()
+        _entries = catalog.get("commands", [])
+        _by_name.update({e["name"]: e for e in _entries})
+    for name in Gui.listCommands():
+        if name not in _by_name:
+            e = live_entry(name)
+            if e:
+                _entries.append(e)
+                _by_name[name] = e
+    for e in _entries:
+        if "_ja" not in e:
+            core.prepare([e], CommandAliases.ALIASES)
+    return _entries
+
+
+def live_entry(name):
+    try:
+        info = Gui.Command.get(name).getInfo()
+    except Exception:
+        return None
+    cls = info.get("className", "")
+    ctx = name if cls in ("PythonCommand", "PythonGroupCommand", "") else cls
+    menu = core.plain(info.get("menuText") or "")
+    tip = info.get("toolTip") or ""
+    return {
+        "name": name, "wb": "", "module": "", "ctx": ctx, "en": menu,
+        "ja": core.plain(QtCore.QCoreApplication.translate(ctx, info.get("menuText") or "")),
+        "tip_en": tip, "tip_ja": QtCore.QCoreApplication.translate(ctx, tip),
+        "icon": info.get("pixmap") or "", "places": [],
+    }
+
+
+def refresh_texts(entry):
+    """Texts in the current translation when the command's module is loaded (the translations of
+    a module come with it; the catalog has those of the time it was made)"""
+    if entry["name"] in Gui.listCommands() and entry.get("ctx"):
+        ja = core.plain(QtCore.QCoreApplication.translate(entry["ctx"], entry.get("en_raw") or entry.get("en", "")))
+        if ja and ja != entry.get("en"):
+            entry["ja"] = ja
+            entry["_ja"] = core.fold(entry["ja"])
+
+
+def strip_tags(text):
+    import re
+
+    return re.sub(r"<[^>]+>", " ", text or "").replace("&nbsp;", " ").strip()
+
+
+def where_shown():
+    """{command name: where the integrated environment shows it} from the menus and toolbars"""
+    mw = Gui.getMainWindow()
+    places = {}
+
+    def walk(menu, path):
+        for action in menu.actions():
+            if action.menu():
+                walk(action.menu(), path + [action.text().replace("&", "")])
+            elif action.objectName() and not action.isSeparator():
+                places.setdefault(action.objectName(), " › ".join(path))
+
+    for action in mw.menuBar().actions():
+        if action.menu():
+            walk(action.menu(), [action.text().replace("&", "")])
+    for bar in mw.findChildren(QtWidgets.QToolBar):
+        if bar.isVisible():
+            for action in bar.actions():
+                if action.objectName():
+                    places[action.objectName()] = translate("CommandSearch", "Tool strip")
+    return places
+
+
+def usable(names):
+    ok = set()
+    loaded = set(Gui.listCommands())
+    for name in names:
+        if name in loaded:
+            try:
+                if Gui.Command.get(name).isActive():
+                    ok.add(name)
+            except Exception:
+                pass
+    return ok
+
+
+def run(entry):
+    """Run the command, loading its module first if needed"""
+    name = entry["name"]
+    if name not in Gui.listCommands() and entry.get("wb"):
+        mw = Gui.getMainWindow()
+        mw.statusBar().showMessage(
+            translate("CommandSearch", "Loading the tools of {}…").format(core.module_name(entry) or entry["wb"])
+        )
+        QtWidgets.QApplication.setOverrideCursor(QtCore.Qt.WaitCursor)
+        try:
+            QtWidgets.QApplication.processEvents()
+            Gui.activateWorkbench(entry["wb"])
+            Gui.updateLocale()
+        except Exception as e:
+            App.Console.PrintWarning("Tool search: loading {} failed: {}\n".format(entry["wb"], e))
+        finally:
+            QtWidgets.QApplication.restoreOverrideCursor()
+            mw.statusBar().clearMessage()
+    if name not in Gui.listCommands():
+        App.Console.PrintUserWarning(
+            translate("CommandSearch", "The tool {} is not available in this build.").format(entry.get("ja") or name) + "\n"
+        )
+        return
+    Gui.runCommand(name)
+
+
+def ask_ai(text):
+    try:
+        import AIChatGui
+    except Exception:
+        return
+    panel = AIChatGui.chat.show()
+    panel.input.setPlainText(
+        translate("CommandSearch", "I want to: {}. Which tool does it, and can you do it for me?").format(text)
+    )
+    panel.input.setFocus()
+
+
+class SearchPopup(QtWidgets.QFrame):
+    """The search field with the list of matching tools, at the top of the window"""
+
+    ROW_AI = "__ai__"
+
+    def __init__(self, parent):
+        super().__init__(parent)
+        self.setObjectName("UnifiedCommandSearch")
+        self.setFrameShape(QtWidgets.QFrame.StyledPanel)
+        self.setAutoFillBackground(True)
+        self.setStyleSheet(
+            "#UnifiedCommandSearch { background: palette(base); border: 1px solid palette(mid);"
+            " border-radius: 8px; }"
+        )
+        effect = QtWidgets.QGraphicsDropShadowEffect(self)
+        effect.setBlurRadius(24)
+        effect.setOffset(0, 4)
+        effect.setColor(QtGui.QColor(0, 0, 0, 80))
+        self.setGraphicsEffect(effect)
+        layout = QtWidgets.QVBoxLayout(self)
+        layout.setContentsMargins(8, 8, 8, 8)
+        layout.setSpacing(6)
+        self.edit = QtWidgets.QLineEdit(self)
+        self.edit.setObjectName("UnifiedCommandSearchField")
+        self.edit.setPlaceholderText(
+            translate("CommandSearch", "What do you want to do? e.g. hole, fix STL, gear, Pad")
+        )
+        self.edit.setClearButtonEnabled(True)
+        layout.addWidget(self.edit)
+        self.list = QtWidgets.QListWidget(self)
+        self.list.setObjectName("UnifiedCommandSearchList")
+        self.list.setIconSize(QtCore.QSize(24, 24))
+        self.list.setUniformItemSizes(False)
+        self.list.setWordWrap(False)
+        self.list.setTextElideMode(QtCore.Qt.ElideRight)
+        self.list.setHorizontalScrollBarPolicy(QtCore.Qt.ScrollBarAlwaysOff)
+        self.list.setFrameShape(QtWidgets.QFrame.NoFrame)
+        layout.addWidget(self.list)
+        self.hint = QtWidgets.QLabel(self)
+        self.hint.setText(translate("CommandSearch", "↑↓ choose · Enter run · Esc close"))
+        self.hint.setStyleSheet("color: palette(mid);")
+        layout.addWidget(self.hint)
+        self.edit.textChanged.connect(self.update_list)
+        self.edit.installEventFilter(self)
+        self.list.itemActivated.connect(self.activate)
+        self.list.installEventFilter(self)
+        QtWidgets.QApplication.instance().installEventFilter(self)
+        self.places = {}
+        self.hide()
+
+    # -- showing
+    def open(self, text=""):
+        mw = self.parentWidget()
+        width = min(720, max(480, mw.width() // 2))
+        height = min(520, mw.height() - 80)
+        self.setGeometry((mw.width() - width) // 2, 44, width, height)
+        self.places = where_shown()
+        entries()
+        self.show()
+        self.raise_()
+        self.edit.setText(text)
+        self.edit.setFocus()
+        self.edit.selectAll()
+        self.update_list()
+
+    def close_popup(self):
+        self.hide()
+        mdi = Gui.getMainWindow().findChild(QtWidgets.QMdiArea)
+        sub = mdi.activeSubWindow() if mdi else None
+        if sub and sub.widget():
+            sub.widget().setFocus()
+
+    # -- the list
+    def update_list(self):
+        text = self.edit.text().strip()
+        self.list.clear()
+        if not text:
+            return
+        found = core.search(text, entries(), placed=self.places.keys(), limit=80)
+        ok = usable([e["name"] for e in found])
+        found = core.search(text, found, usable=ok, placed=self.places.keys(), limit=40)
+        for e in found:
+            refresh_texts(e)
+            self.list.addItem(self.make_item(e, e["name"] in ok))
+        ai = QtWidgets.QListWidgetItem(
+            translate("CommandSearch", "Ask the AI: “{}”").format(text)
+            + "\n"
+            + translate("CommandSearch", "When no tool fits, the AI chat helps (it asks before it changes anything)")
+        )
+        ai.setData(QtCore.Qt.UserRole, self.ROW_AI)
+        ai.setIcon(QtGui.QIcon(os.path.join(os.path.dirname(__file__), "AIChat.svg")))
+        self.list.addItem(ai)
+        self.list.setCurrentRow(0)
+
+    def make_item(self, e, can_run):
+        name = e.get("ja") or e.get("en") or e["name"]
+        title = name
+        if e.get("en") and core.fold(e["en"]) != core.fold(name):
+            title += "  ({})".format(e["en"])
+        where = self.places.get(e["name"])
+        loaded = e["name"] in Gui.listCommands()
+        if where:
+            place = where
+        elif not loaded and e.get("wb"):
+            place = translate("CommandSearch", "Other tools · {} (loaded when first used)").format(
+                core.module_name(e) or e["wb"]
+            )
+        elif core.module_name(e):
+            place = translate("CommandSearch", "Other tools · {}").format(core.module_name(e))
+        else:
+            place = translate("CommandSearch", "Other tools")
+        tip = strip_tags(e.get("tip_ja") or e.get("tip_en"))
+        if len(tip) > 70:
+            tip = tip[:69] + "…"
+        second = place + ("  ·  " + tip if tip else "")
+        item = QtWidgets.QListWidgetItem(title + "\n" + second)
+        item.setData(QtCore.Qt.UserRole, e["name"])
+        item.setToolTip(strip_tags(e.get("tip_ja") or e.get("tip_en")))
+        item.setIcon(self.icon_for(e, loaded))
+        if loaded and not can_run:
+            # Not greyed out: running it says what to pick
+            item.setForeground(self.palette().color(QtGui.QPalette.Text))
+        return item
+
+    def icon_for(self, e, loaded):
+        """The command's icon; for a module not loaded yet (its icons come with it) the module's"""
+        icon = e.get("icon", "")
+        if icon and os.path.isfile(icon):
+            return QtGui.QIcon(icon)
+        if loaded and icon:
+            return Gui.getIcon(icon)
+        try:
+            wb_icon = Gui.getWorkbench(e.get("module_wb") or e.get("wb")).Icon
+        except Exception:
+            wb_icon = ""
+        if isinstance(wb_icon, str) and os.path.isfile(wb_icon):
+            return QtGui.QIcon(wb_icon)
+        return QtGui.QIcon()
+
+    def activate(self, item=None):
+        item = item or self.list.currentItem()
+        if item is None:
+            return
+        key = item.data(QtCore.Qt.UserRole)
+        text = self.edit.text().strip()
+        self.close_popup()
+        if key == self.ROW_AI:
+            ask_ai(text)
+            return
+        entry = _by_name.get(key)
+        if entry:
+            QtCore.QTimer.singleShot(0, lambda: run(entry))
+
+    # -- keys and clicks
+    def eventFilter(self, obj, ev):
+        if not self.isVisible():
+            return False
+        t = ev.type()
+        if t == QtCore.QEvent.KeyPress and obj in (self.edit, self.list):
+            key = ev.key()
+            if key == QtCore.Qt.Key_Escape:
+                self.close_popup()
+                return True
+            if obj is self.edit and key in (QtCore.Qt.Key_Down, QtCore.Qt.Key_Up):
+                row = self.list.currentRow() + (1 if key == QtCore.Qt.Key_Down else -1)
+                if 0 <= row < self.list.count():
+                    self.list.setCurrentRow(row)
+                return True
+            if key in (QtCore.Qt.Key_Return, QtCore.Qt.Key_Enter):
+                # Not while the input method is composing (Enter confirms the Japanese text)
+                self.activate()
+                return True
+        if t == QtCore.QEvent.MouseButtonPress and isinstance(obj, QtWidgets.QWidget):
+            if obj.window() is self.window() and not self.isAncestorOf(obj) and obj is not self:
+                self.hide()
+        return False
+
+
+_popup = None
+
+
+def popup():
+    global _popup
+    if _popup is None:
+        _popup = SearchPopup(Gui.getMainWindow())
+    return _popup
+
+
+class SearchField(QtWidgets.QLineEdit):
+    """The search field at the top right of the window: typing opens the search"""
+
+    def __init__(self, parent=None):
+        super().__init__(parent)
+        self.setObjectName("UnifiedSearchField")
+        self.setPlaceholderText(translate("CommandSearch", "Search tools  Ctrl+K"))
+        self.setMinimumWidth(240)
+        self.setMaximumWidth(360)
+        self.textEdited.connect(self.forward)
+
+    def forward(self, text):
+        self.clear()
+        popup().open(text)
+
+    def mousePressEvent(self, ev):
+        popup().open("")
+        ev.accept()
+
+
+class SearchCommand:
+    def GetResources(self):
+        return {
+            "Pixmap": "edit-find",
+            "MenuText": QT_TRANSLATE_NOOP("Unified_Search", "Search Tools…"),
+            "ToolTip": QT_TRANSLATE_NOOP(
+                "Unified_Search",
+                "Find any tool by typing what you want to do, in Japanese or English",
+            ),
+            "Accel": "Ctrl+K",
+        }
+
+    def IsActive(self):
+        return True
+
+    def Activated(self):
+        popup().open("")
+
+
+Gui.addCommand("Unified_Search", SearchCommand())
+
+
+def install_field():
+    """The search field in the top right corner of the menu bar"""
+    mw = Gui.getMainWindow()
+    bar = mw.menuBar()
+    if mw.findChild(QtWidgets.QLineEdit, "UnifiedSearchField"):
+        return
+    corner = bar.cornerWidget(QtCore.Qt.TopRightCorner)
+    if corner is not None and corner.layout() is not None:
+        # FreeCAD's own area at the right of the menu bar: the field goes first in it
+        corner.layout().insertWidget(0, SearchField(corner))
+        corner.adjustSize()
+        bar.adjustSize()
+        return
+    holder = QtWidgets.QWidget(bar)
+    lay = QtWidgets.QHBoxLayout(holder)
+    lay.setContentsMargins(4, 2, 8, 2)
+    lay.addWidget(SearchField(holder))
+    bar.setCornerWidget(holder, QtCore.Qt.TopRightCorner)
+    holder.show()
+
+
+def free_ctrl_k():
+    """Ctrl+K belongs to the search: take it away from any other command"""
+    for name in Gui.listCommands():
+        if name == "Unified_Search":
+            continue
+        try:
+            cmd = Gui.Command.get(name)
+            if cmd.getShortcut().replace(" ", "") == "Ctrl+K":
+                cmd.setShortcut("")
+        except Exception:
+            pass
