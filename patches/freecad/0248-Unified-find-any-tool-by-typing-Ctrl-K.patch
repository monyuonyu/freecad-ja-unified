diff --git a/src/Mod/Unified/CommandCatalogGen.py b/src/Mod/Unified/CommandCatalogGen.py
new file mode 100644
index 000000000..1a0e5a465
--- /dev/null
+++ b/src/Mod/Unified/CommandCatalogGen.py
@@ -0,0 +1,175 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""Write the catalog of every command of every module (CommandCatalog.json).
+
+The tool search (Ctrl+K) finds commands of modules that are not loaded yet from this catalog,
+and loads the module when one of them is picked. Run in the GUI, with all modules built, e.g.
+
+    FreeCAD CommandCatalogGen.py --pass <out.json>          (under xvfb-run on Linux)
+
+The catalog has, for each command: the workbench that registers it, the untranslated texts and
+their translation context, the Japanese texts, the icon and where the module put it (menus and
+toolbars of its workbench). Texts are translated again at run time when the module is loaded,
+so a changed translation shows up without making the catalog again.
+"""
+
+import json
+import os
+import sys
+
+import FreeCAD as App
+import FreeCADGui as Gui
+from PySide import QtCore, QtWidgets
+
+SKIP_WORKBENCHES = {"NoneWorkbench", "UnifiedWorkbench", "TestWorkbench"}
+
+
+def translate(context, text):
+    return QtCore.QCoreApplication.translate(context, text) if text else ""
+
+
+import sys as _sys
+
+_sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from CommandSearchCore import plain  # noqa: E402
+
+
+def context_of(name, info):
+    # Python commands are translated in the context of their name, C++ commands in that of
+    # their class
+    cls = info.get("className", "")
+    return name if cls in ("PythonCommand", "PythonGroupCommand", "") else cls
+
+
+def workbench_object(name):
+    wb = Gui.getWorkbench(name)
+    return getattr(wb, "__Workbench__", None), wb
+
+
+def walk_menu(items, path, found, wb):
+    for item in items:
+        if isinstance(item, str):
+            if item != "Separator":
+                found.setdefault(item, []).append({"wb": wb, "menu": list(path)})
+        else:
+            title, sub = item
+            walk_menu(sub, path + [plain(translate("Workbench", title))], found, wb)
+
+
+def collect(log=print):
+    # The Japanese texts: the interface in Japanese whatever the system's language
+    try:
+        Gui.setLocale("Japanese")
+    except Exception as e:
+        log("catalog: could not switch to Japanese: {}".format(e))
+    always = set(Gui.listCommands())
+    owner = {}
+    names = {}
+    for wb in sorted(Gui.listWorkbenches()):
+        if wb in SKIP_WORKBENCHES:
+            continue
+        before = set(Gui.listCommands())
+        try:
+            Gui.activateWorkbench(wb)
+        except Exception as e:
+            log("catalog: {} failed to load: {}".format(wb, e))
+            continue
+        QtWidgets.QApplication.processEvents()
+        for cmd in set(Gui.listCommands()) - before:
+            owner[cmd] = wb
+        names[wb] = plain(translate("Workbench", getattr(Gui.getWorkbench(wb), "MenuText", wb) or wb))
+
+    # The translations of the modules loaded above
+    Gui.updateLocale()
+    places = {}
+    for wb in sorted(names):
+        cpp, _ = workbench_object(wb)
+        if cpp is None:
+            continue
+        try:
+            for title, items in cpp.getMenuItems():
+                walk_menu(items, [plain(translate("Workbench", title))], places, wb)
+        except Exception as e:
+            log("catalog: menus of {}: {}".format(wb, e))
+        try:
+            for bar, cmds in cpp.getToolbarItems().items():
+                for cmd in cmds:
+                    if cmd != "Separator":
+                        places.setdefault(cmd, []).append(
+                            {"wb": wb, "toolbar": plain(translate("Workbench", bar))}
+                        )
+        except Exception as e:
+            log("catalog: toolbars of {}: {}".format(wb, e))
+
+    # The tools inside a drop-down button (a group command) are where the button is
+    for name in list(places):
+        try:
+            actions = Gui.Command.get(name).getAction()
+        except Exception:
+            continue
+        if len(actions) > 1:
+            for action in actions:
+                child = action.objectName()
+                if child and child != name and child in Gui.listCommands():
+                    for place in places[name]:
+                        entry = dict(place, group=name)
+                        if entry not in places.setdefault(child, []):
+                            places[child].append(entry)
+
+    entries = []
+    for name in sorted(Gui.listCommands()):
+        try:
+            info = Gui.Command.get(name).getInfo()
+        except Exception:
+            continue
+        ctx = context_of(name, info)
+        # The module a command belongs to by its name (Draft_Line is Draft's even though the BIM
+        # workbench, loaded before, registered it), else the one that registered it
+        prefix = name.split("_", 1)[0]
+        for wb in names:
+            if wb.lower() == (prefix + "Workbench").lower():
+                owner[name] = owner.get(name) and wb
+                module_wb = wb
+                break
+        else:
+            module_wb = owner.get(name, "")
+        menu = info.get("menuText", "") or ""
+        tip = info.get("toolTip", "") or ""
+        wb = owner.get(name, "")
+        entry = {
+            "name": name,
+            "wb": wb,
+            "module": names.get(module_wb or wb, ""),
+            "module_wb": module_wb or wb or "",
+            "ctx": ctx,
+            "en": plain(menu),
+            "en_raw": menu,
+            "ja": plain(translate(ctx, menu)),
+            "tip_en": tip,
+            "tip_ja": translate(ctx, tip),
+            "icon": info.get("pixmap", "") or "",
+            "places": places.get(name, []),
+        }
+        if name in always:
+            entry["wb"] = ""
+        entries.append(entry)
+    return {"workbenches": names, "commands": entries}
+
+
+def main(out):
+    catalog = collect(log=lambda m: App.Console.PrintWarning(m + "\n"))
+    with open(out, "w", encoding="utf-8") as f:
+        json.dump(catalog, f, ensure_ascii=False, indent=0, sort_keys=True)
+        f.write("\n")
+    App.Console.PrintMessage(
+        "catalog: {} commands of {} workbenches → {}\n".format(
+            len(catalog["commands"]), len(catalog["workbenches"]), out
+        )
+    )
+
+
+if __name__ in ("__main__", "CommandCatalogGen"):
+    out = os.environ.get("UNIFIED_CATALOG_OUT")
+    if out:
+        main(out)
+        Gui.getMainWindow().close()
+        QtCore.QTimer.singleShot(0, QtWidgets.QApplication.instance().quit)
