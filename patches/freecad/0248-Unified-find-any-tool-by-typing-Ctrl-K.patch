+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""Make the command catalog of the tool search at build time (run by CMake after all modules).
+
+    python make_catalog.py --freecad <FreeCAD executable> --generator <CommandCatalogGen.py>
+                           --out <CommandCatalog.json> --fallback <the catalog in the sources>
+
+Starts the built FreeCAD without a screen (Qt's offscreen platform) and with settings of its own,
+loads every module and writes the catalog (CommandCatalogGen.py). If that fails or the result
+looks incomplete (e.g. a module missing), the catalog kept in the sources is used, so that the
+build never fails because of the catalog. Always exits with 0.
+"""
+
+import argparse
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+
+
+def good(path, minimum):
+    try:
+        with open(path, encoding="utf-8") as f:
+            data = json.load(f)
+    except (OSError, ValueError):
+        return False, "unreadable"
+    commands = data.get("commands", [])
+    placed = sum(1 for c in commands if c.get("places"))
+    wbs = len(data.get("workbenches", {}))
+    ok = len(commands) >= minimum and placed >= minimum * 0.6 and wbs >= 10
+    return ok, "{} commands, {} in menus or toolbars, {} workbenches".format(len(commands), placed, wbs)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--freecad", required=True)
+    ap.add_argument("--generator", required=True)
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--fallback", required=True)
+    ap.add_argument("--timeout", type=int, default=300)
+    ap.add_argument("--minimum", type=int, default=900)
+    args = ap.parse_args()
+
+    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)
+    fallback_ok, fallback_info = good(args.fallback, 0)
+    if os.environ.get("UNIFIED_CATALOG_SKIP"):
+        shutil.copyfile(args.fallback, args.out)
+        print("catalog: skipped, the one in the sources is used")
+        return 0
+    with tempfile.TemporaryDirectory(prefix="fc-catalog-") as home:
+        tmp_out = os.path.join(home, "catalog.json")
+        env = dict(os.environ)
+        env.update({
+            "QT_QPA_PLATFORM": "offscreen",
+            "FREECAD_USER_HOME": home,
+            "XDG_CONFIG_HOME": os.path.join(home, "config"),
+            "XDG_DATA_HOME": os.path.join(home, "data"),
+            "XDG_CACHE_HOME": os.path.join(home, "cache"),
+            "UNIFIED_CATALOG_OUT": tmp_out,
+            # The Japanese texts of the catalog: the interface in Japanese
+            "LANG": "ja_JP.UTF-8",
+            "LANGUAGE": "ja",
+            "LC_ALL": "ja_JP.UTF-8",
+        })
+        try:
+            proc = subprocess.run([args.freecad, args.generator], env=env, timeout=args.timeout,
+                                  stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+            log = proc.stdout.decode("utf-8", "replace")
+        except (OSError, subprocess.TimeoutExpired) as e:
+            log = "catalog: FreeCAD did not finish: {}".format(e)
+        ok, info = good(tmp_out, args.minimum)
+        if ok:
+            shutil.copyfile(tmp_out, args.out)
+            print("catalog: made at build time ({})".format(info))
+            return 0
+        tail = "\n".join(log.splitlines()[-15:])
+        print("catalog: could not be made at build time ({}); the one in the sources is used ({})\n{}".format(
+            info, fallback_info, tail))
+    shutil.copyfile(args.fallback, args.out)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
