+PyObject* projectVisible(PyObject* /*self*/, PyObject* args, PyObject* kwds)
+{
+    static const char* kwlist[] = {"objects", "view", "deflection", nullptr};
+    PyObject* objs {};
+    PyObject* view = nullptr;
+    double deflection = 0.0;
+    if (!PyArg_ParseTupleAndKeywords(args, kwds, "O|Od", const_cast<char**>(kwlist), &objs, &view, &deflection)) {
+        return nullptr;
+    }
+    try {
+        std::vector<SceneItem> items = toItems(objs);
+        Camera cam = toCamera(view);
+        Projection proj = projectVisible(items, cam, deflection);
+        Py::Dict result;
+        Py::List faces;
+        for (const auto& f : proj.faces) {
+            Py::Dict d;
+            d["item"] = Py::Long(f.item);
+            d["face"] = Py::Long(f.face);
+            d["depth"] = Py::Float(f.depth);
+            d["shade"] = Py::Float(f.shade);
+            d["color"] = Py::TupleN(Py::Float(f.color[0]), Py::Float(f.color[1]), Py::Float(f.color[2]));
+            Py::List polys;
+            for (const auto& p : f.polygons) {
+                Py::Dict pd;
+                pd["outer"] = pointList(p.outer);
+                Py::List holes;
+                for (const auto& h : p.holes) {
+                    holes.append(pointList(h));
+                }
+                pd["holes"] = holes;
+                polys.append(pd);
+            }
+            d["polygons"] = polys;
+            faces.append(d);
+        }
+        Py::List edges;
+        static const char* kinds[] = {"edge", "silhouette", "smooth"};
+        for (const auto& e : proj.edges) {
+            Py::Dict d;
+            d["item"] = Py::Long(e.item);
+            d["kind"] = Py::String(kinds[std::clamp(e.kind, 0, 2)]);
+            d["points"] = pointList(e.points);
+            edges.append(d);
+        }
+        result["faces"] = faces;
+        result["edges"] = edges;
+        result["bounds"] = Py::TupleN(Py::Float(proj.xmin), Py::Float(proj.ymin), Py::Float(proj.xmax), Py::Float(proj.ymax));
+        Py::Dict camera;
+        camera["direction"] = Py::TupleN(Py::Float(cam.dir.X()), Py::Float(cam.dir.Y()), Py::Float(cam.dir.Z()));
+        camera["right"] = Py::TupleN(Py::Float(cam.right.X()), Py::Float(cam.right.Y()), Py::Float(cam.right.Z()));
+        camera["up"] = Py::TupleN(Py::Float(cam.up.X()), Py::Float(cam.up.Y()), Py::Float(cam.up.Z()));
+        result["camera"] = camera;
+        return Py::new_reference_to(result);
+    }
+    catch (const Py::Exception&) {
+        return nullptr;
+    }
+    catch (const Base::Exception& e) {
+        e.setPyException();
+        return nullptr;
+    }
+    catch (const Standard_Failure& e) {
+        PyErr_SetString(Part::PartExceptionOCCError, e.GetMessageString());
+        return nullptr;
+    }
+}
