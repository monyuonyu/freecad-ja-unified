+def _pptx_shape(sid, name, rings, x0, y0, sx, sy, fill=None, line=None, line_w=0, closed=True):
+    """Freeform shape; rings are lists of slide EMU points."""
+    xs = [p[0] for r in rings for p in r]
+    ys = [p[1] for r in rings for p in r]
+    left, top = min(xs), min(ys)
+    w = max(max(xs) - left, 1)
+    h = max(max(ys) - top, 1)
+    path = []
+    for r in rings:
+        pts = ["<a:pt x=\"%d\" y=\"%d\"/>" % (p[0] - left, p[1] - top) for p in r]
+        path.append("<a:moveTo>%s</a:moveTo>" % pts[0])
+        path.extend("<a:lnTo>%s</a:lnTo>" % p for p in pts[1:])
+        if closed:
+            path.append("<a:close/>")
+    fill_xml = ('<a:solidFill><a:srgbClr val="%s"/></a:solidFill>' % fill) if fill else "<a:noFill/>"
+    if line:
+        line_xml = '<a:ln w="%d" cap="rnd"><a:solidFill><a:srgbClr val="%s"/></a:solidFill><a:round/></a:ln>' % (line_w, line)
+    else:
+        line_xml = "<a:ln><a:noFill/></a:ln>"
+    return (
+        '<p:sp><p:nvSpPr><p:cNvPr id="%d" name="%s"/><p:cNvSpPr/><p:nvPr/></p:nvSpPr>'
+        '<p:spPr><a:xfrm><a:off x="%d" y="%d"/><a:ext cx="%d" cy="%d"/></a:xfrm>'
+        '<a:custGeom><a:avLst/><a:gdLst/><a:ahLst/><a:cxnLst/><a:rect l="0" t="0" r="r" b="b"/>'
+        '<a:pathLst><a:path w="%d" h="%d"%s>%s</a:path></a:pathLst></a:custGeom>%s%s</p:spPr></p:sp>'
+        % (sid, _xml(name), left, top, w, h, w, h, "" if closed else ' fill="none"', "".join(path), fill_xml, line_xml)
+    )  # fmt: skip
+
