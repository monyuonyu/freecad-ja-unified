+/// A visible region of one face: outer boundary (counter-clockwise) and holes (clockwise)
+struct Polygon2d
+{
+    std::vector<Point2d> outer;
+    std::vector<std::vector<Point2d>> holes;
+};
+
+struct VisibleFace
+{
+    int item = 0;
+    int face = 0;  // index in the item's face list (Shape.Faces), or a facet group of a mesh
+    double depth = 0;  // mean depth along the view direction, larger is farther
+    double shade = 1;  // 0..1, simple lighting
+    Color color {};
+    std::vector<Polygon2d> polygons;
+};
+
+struct VisibleEdge
+{
+    int item = 0;
+    int kind = 0;  // 0: sharp edge, 1: silhouette, 2: smooth (tangent) edge
+    std::vector<Point2d> points;
+};
+
+struct Projection
+{
+    std::vector<VisibleFace> faces;  // sorted far to near
+    std::vector<VisibleEdge> edges;
+    double xmin = 0, ymin = 0, xmax = 0, ymax = 0;
+};
+
+/// Project with hidden parts removed.  2D coordinates are model units: x to the right,
+/// y up on the screen.
+PartExport Projection projectVisible(
