+def export_pptx(source=None, path="view.pptx", view="iso", deflection=0.0, colors=None,
+                line_width=1.0, data=None):  # fmt: skip
+    """Write a PowerPoint file with one slide: every visible face region as a filled
+    freeform shape (far to near) and the visible edges as lines on top.  The shapes can be
+    recoloured or moved in PowerPoint.  Returns the project() dict."""
+    import zipfile
+
+    if data is None:
+        data = project(source, view=view, deflection=deflection, colors=colors)
+    xmin, ymin, xmax, ymax = data["bounds"]
+    w = max(xmax - xmin, 1e-9)
+    h = max(ymax - ymin, 1e-9)
+    margin = 0.05
+    scale = min(_PPTX_SLIDE_W * (1 - 2 * margin) / w, _PPTX_SLIDE_H * (1 - 2 * margin) / h)
+    ox = (_PPTX_SLIDE_W - w * scale) / 2
+    oy = (_PPTX_SLIDE_H - h * scale) / 2
+
+    def E(p):
+        return (int(round(ox + (p[0] - xmin) * scale)), int(round(oy + (ymax - p[1]) * scale)))
+
+    shapes = []
+    sid = 2
+    for f in data["faces"]:
+        for poly in f["polygons"]:
+            rings = [[E(p) for p in poly["outer"]]] + [[E(p) for p in hole] for hole in poly["holes"]]
+            fill = f["fill"].lstrip("#").upper()
+            # hairline in the fill colour hides seams between neighbouring faces
+            shapes.append(_pptx_shape(sid, "%s face %d" % (f["label"], f["face"] + 1), rings,
+                                      0, 0, 1, 1, fill=fill, line=fill, line_w=3175))  # fmt: skip
+            sid += 1
+    line_emu = int(round(12700 * line_width))  # 1 pt
+    for e in data["edges"]:
+        pts = [E(p) for p in e["points"]]
+        shapes.append(_pptx_shape(sid, "%s %s" % (e["object"], e["kind"]), [pts], 0, 0, 1, 1,
+                                  line="1A1A1F", line_w=line_emu, closed=False))  # fmt: skip
+        sid += 1
+    slide = (
+        '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
+        '<p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" '
+        'xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" '
+        'xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main">'
+        '<p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr>'
+        '<p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/>'
+        '<a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr>%s</p:spTree></p:cSld>'
+        '<p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>' % "".join(shapes)
+    )
+    with zipfile.ZipFile(path, "w", zipfile.ZIP_DEFLATED) as z:
+        z.writestr("[Content_Types].xml", _PPTX_STATIC["[Content_Types].xml"])
+        for name, text in _PPTX_STATIC.items():
+            if name != "[Content_Types].xml":
+                z.writestr(name, text)
+        z.writestr("ppt/theme/theme1.xml", _pptx_theme())
+        z.writestr("ppt/slides/slide1.xml", slide)
+    return data
+
