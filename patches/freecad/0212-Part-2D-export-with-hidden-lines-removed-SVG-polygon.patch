+// ------------------------------------------------------------------ hidden line removal
+
+namespace
+{
+
+using Clipper2Lib::Path64;
+using Clipper2Lib::Paths64;
+using Clipper2Lib::Point64;
+
+struct Group
+{
+    int face = 0;  // index in scene.faces
+    Paths64 region;
+    double a = 0, b = 0, c = 0;  // depth = a*X + b*Y + c in integer space
+    double dmin = 0, dmax = 0;
+    std::int64_t x0 = 0, y0 = 0, x1 = 0, y1 = 0;  // bounding box
+};
+
+struct Space
+{
+    double ox = 0, oy = 0, S = 1;
+    std::int64_t X(double x) const
+    {
+        return std::llround((x - ox) * S);
+    }
+    std::int64_t Y(double y) const
+    {
+        return std::llround((y - oy) * S);
+    }
+    double x(double X) const
+    {
+        return X / S + ox;
+    }
+    double y(double Y) const
+    {
+        return Y / S + oy;
+    }
+};
+
+class Grid
+{
+public:
+    Grid(std::int64_t x0, std::int64_t y0, std::int64_t x1, std::int64_t y1, int n)
+        : x0(x0)
+        , y0(y0)
+        , n(n)
+    {
+        cw = std::max<double>(1.0, double(x1 - x0) / n);
+        ch = std::max<double>(1.0, double(y1 - y0) / n);
+        cells.resize((size_t)n * n);
+    }
+    void cellRange(std::int64_t a0, std::int64_t b0, std::int64_t a1, std::int64_t b1, int& i0, int& j0, int& i1, int& j1) const
+    {
+        i0 = std::clamp((int)((a0 - x0) / cw), 0, n - 1);
+        i1 = std::clamp((int)((a1 - x0) / cw), 0, n - 1);
+        j0 = std::clamp((int)((b0 - y0) / ch), 0, n - 1);
+        j1 = std::clamp((int)((b1 - y0) / ch), 0, n - 1);
+    }
+    void insert(int id, const Group& g)
+    {
+        int i0 {}, j0 {}, i1 {}, j1 {};
+        cellRange(g.x0, g.y0, g.x1, g.y1, i0, j0, i1, j1);
+        for (int j = j0; j <= j1; ++j) {
+            for (int i = i0; i <= i1; ++i) {
+                cells[(size_t)j * n + i].push_back(id);
+            }
+        }
+    }
+    template<typename F>
+    void query(std::int64_t a0, std::int64_t b0, std::int64_t a1, std::int64_t b1, std::vector<int>& stamp, int mark, F&& f) const
+    {
+        int i0 {}, j0 {}, i1 {}, j1 {};
+        cellRange(a0, b0, a1, b1, i0, j0, i1, j1);
+        for (int j = j0; j <= j1; ++j) {
+            for (int i = i0; i <= i1; ++i) {
+                for (int id : cells[(size_t)j * n + i]) {
+                    if (stamp[id] != mark) {
+                        stamp[id] = mark;
+                        f(id);
+                    }
+                }
+            }
+        }
+    }
+
+private:
+    std::int64_t x0, y0;
+    int n;
+    double cw, ch;
+    std::vector<std::vector<int>> cells;
+};
+
+// convex polygon of the rectangle part where A*X + B*Y + C < 0
+Path64 halfPlaneClip(double A, double B, double C, double x0, double y0, double x1, double y1)
+{
+    std::vector<std::array<double, 2>> poly = {{x0, y0}, {x1, y0}, {x1, y1}, {x0, y1}};
+    std::vector<std::array<double, 2>> out;
+    auto f = [&](const std::array<double, 2>& p) {
+        return A * p[0] + B * p[1] + C;
+    };
+    for (size_t i = 0; i < poly.size(); ++i) {
+        const auto& p = poly[i];
+        const auto& q = poly[(i + 1) % poly.size()];
+        double fp = f(p), fq = f(q);
+        if (fp < 0) {
+            out.push_back(p);
+        }
+        if ((fp < 0) != (fq < 0)) {
+            double t = fp / (fp - fq);
+            out.push_back({p[0] + (q[0] - p[0]) * t, p[1] + (q[1] - p[1]) * t});
+        }
+    }
+    Path64 path;
+    for (const auto& p : out) {
+        path.emplace_back(std::llround(p[0]), std::llround(p[1]));
+    }
+    return path;
+}
+
+// Point in the closed region (boundary included, within tol): an edge that lies exactly
+// on the outline of a nearer face is hidden, the nearer face's own edge is drawn there.
+bool insideRegion(const Paths64& region, double X, double Y, double tol)
+{
+    // even-odd over the paths: Clipper results have holes as separate paths
+    int count = 0;
+    for (const auto& path : region) {
+        bool in = false;
+        size_t n = path.size();
+        for (size_t i = 0, j = n - 1; i < n; j = i++) {
+            double xi = (double)path[i].x, yi = (double)path[i].y;
+            double xj = (double)path[j].x, yj = (double)path[j].y;
+            double ex = xi - xj, ey = yi - yj;
+            double len2 = ex * ex + ey * ey;
+            double t = len2 > 0 ? std::clamp(((X - xj) * ex + (Y - yj) * ey) / len2, 0.0, 1.0) : 0.0;
+            if (std::hypot(xj + ex * t - X, yj + ey * t - Y) <= tol) {
+                return true;
+            }
+            if (((yi > Y) != (yj > Y)) && (X < (xj - xi) * (Y - yi) / (yj - yi) + xi)) {
+                in = !in;
+            }
+        }
+        if (in) {
+            ++count;
+        }
+    }
+    return (count % 2) == 1;
+}
+
+void collectPolygons(const Clipper2Lib::PolyPath64& node, const Space& sp, std::vector<Polygon2d>& out)
+{
+    for (const auto& child : node) {
+        // child is an outer polygon, its children are holes
+        Polygon2d poly;
+        for (const auto& pt : child->Polygon()) {
+            poly.outer.push_back({sp.x((double)pt.x), sp.y((double)pt.y)});
+        }
+        if (Clipper2Lib::Area(child->Polygon()) < 0) {
+            std::reverse(poly.outer.begin(), poly.outer.end());
+        }
+        for (const auto& hole : *child) {
+            std::vector<Point2d> h;
+            for (const auto& pt : hole->Polygon()) {
+                h.push_back({sp.x((double)pt.x), sp.y((double)pt.y)});
+            }
+            if (Clipper2Lib::Area(hole->Polygon()) > 0) {
+                std::reverse(h.begin(), h.end());
+            }
+            poly.holes.push_back(std::move(h));
+            // islands inside holes
+            collectPolygons(*hole, sp, out);
+        }
+        out.push_back(std::move(poly));
+    }
+}
+
+}  // namespace
+
+Projection Part::ViewTools::projectVisible(
+    const std::vector<SceneItem>& items,
+    const Camera& cam,
+    double deflection
+)
+{
+    Scene scene = buildScene(items, deflection);
+    Projection result;
+
+    // 2D extent
+    double xmin = 1e300, xmax = -1e300, ymin = 1e300, ymax = -1e300, dmin = 1e300, dmax = -1e300;
+    for (const auto& f : scene.faces) {
+        for (const auto& p : f.p) {
+            double x {}, y {}, d {};
+            cam.project(p, x, y, d);
+            xmin = std::min(xmin, x);
+            xmax = std::max(xmax, x);
+            ymin = std::min(ymin, y);
+            ymax = std::max(ymax, y);
+            dmin = std::min(dmin, d);
+            dmax = std::max(dmax, d);
+        }
+    }
+    for (const auto& e : scene.edges) {
+        for (const auto& p : e.p) {
+            double x {}, y {}, d {};
+            cam.project(p, x, y, d);
+            xmin = std::min(xmin, x);
+            xmax = std::max(xmax, x);
+            ymin = std::min(ymin, y);
+            ymax = std::max(ymax, y);
+        }
+    }
+    if (xmin > xmax) {
+        return result;
+    }
+    result.xmin = xmin;
+    result.xmax = xmax;
+    result.ymin = ymin;
+    result.ymax = ymax;
+
+    Space sp;
+    sp.ox = xmin;
+    sp.oy = ymin;
+    double extent = std::max({xmax - xmin, ymax - ymin, 1e-9});
+    sp.S = 1e8 / extent;
+    const double diag = std::sqrt(scene.box.IsVoid() ? 1.0 : scene.box.SquareExtent());
+    const double eps = std::max(diag * 1e-7, scene.deflection * 0.25);
+
+    // groups: planar faces as a whole, curved faces per triangle
+    std::vector<Group> groups;
+    std::vector<std::vector<int>> groupsOfFace(scene.faces.size());
+    std::vector<double> faceShade(scene.faces.size(), 1.0);
+    for (int fi = 0; fi < (int)scene.faces.size(); ++fi) {
+        const SFace& f = scene.faces[fi];
+        std::vector<double> X(f.p.size()), Y(f.p.size()), D(f.p.size());
+        for (size_t k = 0; k < f.p.size(); ++k) {
+            double x {}, y {}, d {};
+            cam.project(f.p[k], x, y, d);
+            X[k] = (double)sp.X(x);
+            Y[k] = (double)sp.Y(y);
+            D[k] = d;
+        }
+        gp_Vec nsum(0, 0, 0);
+        auto addGroup = [&](const std::vector<std::array<int, 3>>& tris, const gp_Vec& normal) {
+            // depth plane through the triangles: fit with the normal and the first point
+            gp_Vec n = normal;
+            double nx = n.XYZ().Dot(cam.right.XYZ());
+            double ny = n.XYZ().Dot(cam.up.XYZ());
+            double nd = n.XYZ().Dot(cam.dir.XYZ());
+            if (std::fabs(nd) < 1e-9 * n.Magnitude()) {
+                return;  // seen edge-on
+            }
+            if (nd > 0 && f.solid) {
+                return;  // turned away inside a solid
+            }
+            Group g;
+            g.face = fi;
+            // d = d0 - (nx (x - x0) + ny (y - y0)) / nd, with x = X/S + ox
+            const int k0 = tris.front()[0];
+            const double d0 = D[k0];
+            g.a = -nx / nd / sp.S;
+            g.b = -ny / nd / sp.S;
+            // c so that a*X + b*Y + c = d0 at (X0, Y0)
+            g.c = d0 - g.a * X[k0] - g.b * Y[k0];
+            Paths64 tri;
+            g.dmin = 1e300;
+            g.dmax = -1e300;
+            for (const auto& t : tris) {
+                Path64 path;
+                for (int e = 0; e < 3; ++e) {
+                    path.emplace_back((std::int64_t)X[t[e]], (std::int64_t)Y[t[e]]);
+                    g.dmin = std::min(g.dmin, D[t[e]]);
+                    g.dmax = std::max(g.dmax, D[t[e]]);
+                }
+                if (Clipper2Lib::Area(path) < 0) {
+                    std::reverse(path.begin(), path.end());
+                }
+                if (Clipper2Lib::Area(path) != 0) {
+                    tri.push_back(std::move(path));
+                }
+            }
+            if (tri.empty()) {
+                return;
+            }
+            g.region = tris.size() == 1 ? tri : Clipper2Lib::Union(tri, Clipper2Lib::FillRule::NonZero);
+            if (g.region.empty()) {
+                return;
+            }
+            Clipper2Lib::Rect64 r = Clipper2Lib::GetBounds(g.region);
+            g.x0 = r.left;
+            g.y0 = r.top;
+            g.x1 = r.right;
+            g.y1 = r.bottom;
+            groupsOfFace[fi].push_back((int)groups.size());
+            groups.push_back(std::move(g));
+        };
+        if (f.planar) {
+            gp_Vec n(0, 0, 0);
+            for (const auto& t : f.t) {
+                n += triNormal(f.p[t[0]], f.p[t[1]], f.p[t[2]]);
+            }
+            if (n.SquareMagnitude() > 1e-30) {
+                addGroup(f.t, n);
+                nsum = n;
+            }
+        }
+        else {
+            for (const auto& t : f.t) {
+                gp_Vec n = triNormal(f.p[t[0]], f.p[t[1]], f.p[t[2]]);
+                if (n.SquareMagnitude() < 1e-30) {
+                    continue;
+                }
+                if (n.Dot(gp_Vec(cam.dir)) < 0) {
+                    nsum += n;
+                }
+                addGroup({t}, n);
+            }
+        }
+        if (nsum.SquareMagnitude() > 1e-30) {
+            faceShade[fi] = shadeOf(cam, nsum.Normalized());
+        }
+    }
+
+    // spatial index
+    Grid grid(0, 0, (std::int64_t)1e8, (std::int64_t)1e8, std::clamp((int)std::sqrt((double)groups.size()), 1, 128));
+    for (int gi = 0; gi < (int)groups.size(); ++gi) {
+        grid.insert(gi, groups[gi]);
+    }
+    std::vector<int> stamp(groups.size(), -1);
+    int mark = 0;
+
+    // visible region of each group
+    std::vector<Paths64> visible(groups.size());
+    for (int gi = 0; gi < (int)groups.size(); ++gi) {
+        const Group& F = groups[gi];
+        Paths64 occluders;
+        ++mark;
+        grid.query(F.x0, F.y0, F.x1, F.y1, stamp, mark, [&](int hi) {
+            if (hi == gi) {
+                return;
+            }
+            const Group& G = groups[hi];
+            if (G.x1 < F.x0 || G.x0 > F.x1 || G.y1 < F.y0 || G.y0 > F.y1) {
+                return;
+            }
+            if (G.dmin >= F.dmax - eps) {
+                return;  // behind
+            }
+            if (G.dmax < F.dmin - eps) {
+                occluders.insert(occluders.end(), G.region.begin(), G.region.end());
+                return;
+            }
+            // where is G nearer than F:  dG - dF + eps < 0
+            double A = G.a - F.a, B = G.b - F.b, C = G.c - F.c + eps;
+            double bx0 = (double)std::max(F.x0, G.x0) - 2, by0 = (double)std::max(F.y0, G.y0) - 2;
+            double bx1 = (double)std::min(F.x1, G.x1) + 2, by1 = (double)std::min(F.y1, G.y1) + 2;
+            if (std::fabs(A) * (bx1 - bx0) + std::fabs(B) * (by1 - by0) < 1e-12) {
+                if (C < 0) {
+                    occluders.insert(occluders.end(), G.region.begin(), G.region.end());
+                }
+                return;
+            }
+            Path64 hp = halfPlaneClip(A, B, C, bx0, by0, bx1, by1);
+            if (hp.size() < 3) {
+                return;
+            }
+            Paths64 part = Clipper2Lib::Intersect(G.region, Paths64 {hp}, Clipper2Lib::FillRule::NonZero);
+            occluders.insert(occluders.end(), part.begin(), part.end());
+        });
+        if (occluders.empty()) {
+            visible[gi] = F.region;
+        }
+        else {
+            visible[gi] = Clipper2Lib::Difference(F.region, occluders, Clipper2Lib::FillRule::NonZero);
+        }
+    }
+
+    // per face
+    for (int fi = 0; fi < (int)scene.faces.size(); ++fi) {
+        Paths64 all;
+        double depthSum = 0, areaSum = 0;
+        for (int gi : groupsOfFace[fi]) {
+            for (const auto& path : visible[gi]) {
+                double area = std::fabs(Clipper2Lib::Area(path));
+                // centroid depth approximately from the first point
+                double cxp = 0, cyp = 0;
+                for (const auto& pt : path) {
+                    cxp += (double)pt.x;
+                    cyp += (double)pt.y;
+                }
+                cxp /= (double)path.size();
+                cyp /= (double)path.size();
+                const Group& G = groups[gi];
+                depthSum += (G.a * cxp + G.b * cyp + G.c) * area;
+                areaSum += area;
+            }
+            all.insert(all.end(), visible[gi].begin(), visible[gi].end());
+        }
+        if (all.empty() || areaSum <= 0) {
+            continue;
+        }
+        Clipper2Lib::PolyTree64 tree;
+        Clipper2Lib::Clipper64 clipper;
+        clipper.AddSubject(all);
+        clipper.Execute(Clipper2Lib::ClipType::Union, Clipper2Lib::FillRule::NonZero, tree);
+        VisibleFace vf;
+        const SFace& f = scene.faces[fi];
+        vf.item = f.item;
+        vf.face = f.face;
+        vf.color = f.color;
+        vf.shade = faceShade[fi];
+        vf.depth = depthSum / areaSum;
+        collectPolygons(tree, sp, vf.polygons);
+        // drop slivers below a square of 0.5 % of a pixel on a 1000 px picture
+        const double minArea = std::pow(extent * 1e-4, 2);
+        vf.polygons.erase(
+            std::remove_if(
+                vf.polygons.begin(),
+                vf.polygons.end(),
+                [minArea](const Polygon2d& p) {
+                    double a = 0;
+                    for (size_t i = 0, j = p.outer.size() - 1; i < p.outer.size(); j = i++) {
+                        a += p.outer[j][0] * p.outer[i][1] - p.outer[i][0] * p.outer[j][1];
+                    }
+                    return std::fabs(a) / 2 < minArea;
+                }
+            ),
+            vf.polygons.end()
+        );
+        if (!vf.polygons.empty()) {
+            result.faces.push_back(std::move(vf));
+        }
+    }
+    std::stable_sort(result.faces.begin(), result.faces.end(), [](const VisibleFace& a, const VisibleFace& b) {
+        return a.depth > b.depth;
+    });
+
+    // visible edges
+    struct Seg
+    {
+        int item;
+        int kind;
+        gp_Pnt a, b;
+        int chain;  // consecutive segments of one polyline
+    };
+    std::vector<Seg> segs;
+    int chain = 0;
+    for (const auto& e : scene.edges) {
+        for (size_t k = 1; k < e.p.size(); ++k) {
+            segs.push_back({e.item, e.kind, e.p[k - 1], e.p[k], chain});
+        }
+        ++chain;
+    }
+    for (const auto& s : scene.soft) {
+        double da = s.na.Dot(gp_Vec(cam.dir));
+        double db = s.nb.Dot(gp_Vec(cam.dir));
+        if ((da < 0) != (db < 0)) {
+            segs.push_back({s.item, 1, s.a, s.b, chain++});
+        }
+    }
+
+    const double minLen = extent * 2e-4;
+    int lastChain = -1;
+    for (const auto& seg : segs) {
+        double xa {}, ya {}, da {}, xb {}, yb {}, db {};
+        cam.project(seg.a, xa, ya, da);
+        cam.project(seg.b, xb, yb, db);
+        double XA = (double)sp.X(xa), YA = (double)sp.Y(ya), XB = (double)sp.X(xb), YB = (double)sp.Y(yb);
+        std::vector<std::pair<double, double>> hidden;
+        ++mark;
+        auto sx0 = (std::int64_t)std::floor(std::min(XA, XB)), sy0 = (std::int64_t)std::floor(std::min(YA, YB));
+        auto sx1 = (std::int64_t)std::ceil(std::max(XA, XB)), sy1 = (std::int64_t)std::ceil(std::max(YA, YB));
+        grid.query(sx0, sy0, sx1, sy1, stamp, mark, [&](int gi) {
+            const Group& G = groups[gi];
+            if (G.x1 < sx0 || G.x0 > sx1 || G.y1 < sy0 || G.y0 > sy1) {
+                return;
+            }
+            if (G.dmin >= std::max(da, db) - eps) {
+                return;
+            }
+            // f(t) = dG(t) - dseg(t) + eps, hidden where f < 0
+            double f0 = G.a * XA + G.b * YA + G.c - da + eps;
+            double f1 = G.a * XB + G.b * YB + G.c - db + eps;
+            double t0 = 0, t1 = 1;
+            if (f0 >= 0 && f1 >= 0) {
+                return;
+            }
+            if (f0 < 0 && f1 >= 0) {
+                t1 = f0 / (f0 - f1);
+            }
+            else if (f0 >= 0 && f1 < 0) {
+                t0 = f0 / (f0 - f1);
+            }
+            // where is the segment inside G's region
+            std::vector<double> ts {t0, t1};
+            double dx = XB - XA, dy = YB - YA;
+            for (const auto& path : G.region) {
+                size_t n = path.size();
+                for (size_t i = 0, j = n - 1; i < n; j = i++) {
+                    double px = (double)path[j].x, py = (double)path[j].y;
+                    double qx = (double)path[i].x - px, qy = (double)path[i].y - py;
+                    double den = dx * qy - dy * qx;
+                    if (std::fabs(den) < 1e-12) {
+                        continue;
+                    }
+                    double t = ((px - XA) * qy - (py - YA) * qx) / den;
+                    double u = ((px - XA) * dy - (py - YA) * dx) / den;
+                    if (t > t0 && t < t1 && u >= 0 && u <= 1) {
+                        ts.push_back(t);
+                    }
+                }
+            }
+            std::sort(ts.begin(), ts.end());
+            for (size_t i = 1; i < ts.size(); ++i) {
+                if (ts[i] - ts[i - 1] < 1e-12) {
+                    continue;
+                }
+                double tm = (ts[i] + ts[i - 1]) / 2;
+                if (insideRegion(G.region, XA + dx * tm, YA + dy * tm, 4.0)) {
+                    hidden.emplace_back(ts[i - 1], ts[i]);
+                }
+            }
+        });
+        // visible = [0,1] minus hidden
+        std::sort(hidden.begin(), hidden.end());
+        std::vector<std::pair<double, double>> vis;
+        double cur = 0;
+        for (const auto& h : hidden) {
+            if (h.first > cur) {
+                vis.emplace_back(cur, h.first);
+            }
+            cur = std::max(cur, h.second);
+        }
+        if (cur < 1) {
+            vis.emplace_back(cur, 1.0);
+        }
+        double len = std::hypot(xb - xa, yb - ya);
+        for (const auto& v : vis) {
+            if ((v.second - v.first) * len < minLen) {
+                continue;
+            }
+            Point2d p0 {xa + (xb - xa) * v.first, ya + (yb - ya) * v.first};
+            Point2d p1 {xa + (xb - xa) * v.second, ya + (yb - ya) * v.second};
+            if (!result.edges.empty() && lastChain == seg.chain && v.first == 0.0) {
+                auto& last = result.edges.back().points.back();
+                if (std::hypot(last[0] - p0[0], last[1] - p0[1]) < minLen * 10) {
+                    result.edges.back().points.push_back(p1);
+                    lastChain = (v.second == 1.0) ? seg.chain : -1;
+                    continue;
+                }
+            }
+            VisibleEdge ve;
+            ve.item = seg.item;
+            ve.kind = seg.kind;
+            ve.points = {p0, p1};
+            result.edges.push_back(std::move(ve));
+            lastChain = (v.second == 1.0) ? seg.chain : -1;
+        }
+        if (vis.empty() || vis.back().second != 1.0) {
+            lastChain = -1;
+        }
+    }
+    return result;
+}
