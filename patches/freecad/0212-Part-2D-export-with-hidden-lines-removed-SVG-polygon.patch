+Py::List pointList(const std::vector<Point2d>& pts)
+{
+    Py::List list;
+    for (const auto& p : pts) {
+        list.append(Py::TupleN(Py::Float(p[0]), Py::Float(p[1])));
+    }
+    return list;
+}
