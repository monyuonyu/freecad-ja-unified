+def svg_text(data, width_px=1000, line_width=1.0, edges=True, faces=True):
+    """SVG document of a project() result."""
+    xmin, ymin, xmax, ymax = data["bounds"]
+    w = max(xmax - xmin, 1e-9)
+    h = max(ymax - ymin, 1e-9)
+    margin = 0.03 * max(w, h)
+    vw, vh = w + 2 * margin, h + 2 * margin
+    px = vw / width_px  # model units per pixel
+    height_px = int(round(width_px * vh / vw))
+
+    def P(p):
+        return "%.6g,%.6g" % (p[0] - xmin + margin, ymax - p[1] + margin)
+
+    out = [
+        '<?xml version="1.0" encoding="UTF-8"?>',
+        '<svg xmlns="http://www.w3.org/2000/svg" width="%d" height="%d" viewBox="0 0 %.6g %.6g">'
+        % (width_px, height_px, vw, vh),
+        '<rect x="0" y="0" width="%.6g" height="%.6g" fill="#ffffff"/>' % (vw, vh),
+    ]
+    if faces:
+        out.append('<g id="faces" stroke-linejoin="round">')
+        for f in data["faces"]:
+            d = []
+            for poly in f["polygons"]:
+                for ring in [poly["outer"]] + poly["holes"]:
+                    d.append("M" + " L".join(P(p) for p in ring) + "Z")
+            # a hairline in the fill colour hides the seams between neighbouring faces
+            out.append('<path d="%s" fill="%s" fill-rule="evenodd" stroke="%s" stroke-width="%.4g">'
+                       '<title>%s face %d</title></path>'
+                       % (" ".join(d), f["fill"], f["fill"], 0.6 * px, _xml(f["label"]), f["face"] + 1))  # fmt: skip
+        out.append("</g>")
+    if edges:
+        out.append('<g id="edges" fill="none" stroke="#1a1a1f" stroke-width="%.4g" '
+                   'stroke-linecap="round" stroke-linejoin="round">' % (line_width * px))  # fmt: skip
+        for e in data["edges"]:
+            out.append('<polyline points="%s"/>' % " ".join(P(p) for p in e["points"]))
+        out.append("</g>")
+    out.append("</svg>")
+    return "\n".join(out) + "\n"
+
+
+def _xml(s):
+    return str(s).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
+
+
+def export_svg(source=None, path="view.svg", view="iso", deflection=0.0, colors=None,
+               width_px=1000, line_width=1.0, data=None):  # fmt: skip
+    """Write an SVG with filled visible faces and visible edges.  Returns the project() dict."""
+    if data is None:
+        data = project(source, view=view, deflection=deflection, colors=colors)
+    with open(path, "w", encoding="utf-8") as f:
+        f.write(svg_text(data, width_px=width_px, line_width=line_width))
+    return data
