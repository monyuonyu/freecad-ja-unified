+def _alive(o):
+    try:
+        return o.Document is not None and o.Document.getObject(o.Name) is o
+    except Exception:
+        return False
+
+
+def _advance_tips(watch):
+    """この回に作った手順が部品の最後にあるのに Tip が進んでいなければ、進める
+    （Python の Body.newObject で作ったパターンは、作った時に Tip へ進まない。画面のボタンで作った時と同じ結果にする）"""
+    import DesignCheck
+    notes = []
+    created = set(watch.created)
+    bodies = {}
+    for o in watch.created.values():
+        if not _alive(o):
+            continue
+        for p in o.InList:
+            if p.isDerivedFrom("PartDesign::Body"):
+                bodies[p.Name + "@" + p.Document.Name] = p
+    for b in bodies.values():
+        steps = DesignCheck._solid_steps(b)
+        tip = b.Tip
+        if tip not in steps or tip is steps[-1]:
+            continue
+        later = steps[steps.index(tip) + 1:]
+        if all(id(o) in created for o in later):
+            b.Tip = later[-1]
+            for o in steps:
+                o.Visibility = o is later[-1]
+            b.Document.recompute()
+            notes.append("部品 %s（%s）の形に使う最後の手順（Tip）を %s（%s）に進めた（Python で作ったパターンは Tip へ進まないため）"
+                         % (b.Name, b.Label, later[-1].Name, later[-1].Label))
+    return notes
+
+
+def _body_notes(doc):
+    """部品（Body）の後始末と知らせ:
+    - 形を作る最後の手順（Tip）より後にある手順は、形に使われない（Python で作ったパターンは Tip へ進まないことがある）
+    - 見える手順が 1 つも無い部品（前の手順を隠したパターンを消した時など）は、Tip を見えるようにする"""
+    import DesignCheck
+    notes = []
+    for b in doc.Objects:
+        if not b.isDerivedFrom("PartDesign::Body"):
+            continue
+        steps = DesignCheck._solid_steps(b)
+        tip = b.Tip
+        if tip in steps and steps.index(tip) + 1 < len(steps):
+            later = steps[steps.index(tip) + 1:]
+            notes.append("注意: 部品 %s（%s）の形に使われていない手順がある: %s。形に使う最後の手順（Tip）は %s。"
+                         "使うなら %s.Tip = %s" % (b.Name, b.Label, ", ".join("%s（%s）" % (o.Name, o.Label) for o in later),
+                                                     tip.Name, "doc.getObject(%r)" % b.Name, "doc.getObject(%r)" % later[-1].Name))
+        try:
+            if b.Visibility and tip is not None and steps and not any(o.Visibility for o in steps):
+                tip.Visibility = True
+                notes.append("部品 %s（%s）の手順がどれも見えていなかったので、%s（%s）を見えるようにした"
+                             % (b.Name, b.Label, tip.Name, tip.Label))
+        except Exception:
+            pass
+    return notes
+
