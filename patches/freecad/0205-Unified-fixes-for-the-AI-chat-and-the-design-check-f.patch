+def _solid_steps(body):
+    """部品の中の、形を作る手順（押し出し・切り抜き・パターンなど。スケッチ・基準は除く）を並びの順に"""
+    out = []
+    for o in body.Group:
+        if not o.isDerivedFrom("PartDesign::Feature"):
