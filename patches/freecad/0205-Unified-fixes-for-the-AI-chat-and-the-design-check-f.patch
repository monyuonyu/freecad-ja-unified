+class _Watch:
+    """実行の間に起きた変更を、文書ごとに記録する（FreeCAD の文書の見張り）。
+    増えた物・消えた物は名前でなく出来事で数える（消して同じ名前で作り直しても分かるように）"""
+
+    def __init__(self):
+        self.changed = set()    # 変わった文書の名前
+        self.created = {}       # id(物) -> 物（この回に作って、まだある物）
+        self.deleted = []       # (文書, 名前, ラベル)（前からあって、この回に消えた物）
+        self.new_docs = []
+
+    def slotCreatedObject(self, obj):
+        self.changed.add(obj.Document.Name)
+        self.created[id(obj)] = obj
+
+    def slotDeletedObject(self, obj):
+        self.changed.add(obj.Document.Name)
+        if self.created.pop(id(obj), None) is None:
+            self.deleted.append((obj.Document.Name, obj.Name, obj.Label))
+
+    def slotChangedObject(self, obj, prop):
+        try:
+            self.changed.add(obj.Document.Name)
+        except Exception:
+            pass
+
+    def slotCreatedDocument(self, doc):
+        self.new_docs.append(doc.Name)
+
+
+def _activate(name):
+    """今開いている文書を name に戻す（画面の側も）"""
+    if name is None or name not in App.listDocuments():
+        return
+    App.setActiveDocument(name)
+    Gui = _gui()
+    if Gui is not None:
+        try:
+            Gui.setActiveDocument(name)
+        except Exception:
+            pass
+
+
+_fails = [0]   # 続けて失敗した回数（成功したら 0 に戻す）
+
+
+def _log_run(desc, code, result, is_error):
+    """AI が実行したコードと結果を、FreeCAD のユーザーデータの ai/ai-runs.log に残す（落ちた時などに後で確かめられるように）。
+    大きくなったら前の分を ai-runs.log.1 に回す"""
+    import datetime
+    try:
+        d = os.path.join(App.getUserAppDataDir(), "ai")
+        os.makedirs(d, exist_ok=True)
+        path = os.path.join(d, "ai-runs.log")
+        if os.path.exists(path) and os.path.getsize(path) > 2 * 1024 * 1024:
+            os.replace(path, path + ".1")
+        with open(path, "a", encoding="utf-8") as f:
+            f.write("===== %s %s: %s\n%s\n----- %s\n%s\n" % (
+                datetime.datetime.now().isoformat(timespec="seconds"), "失敗" if is_error else "成功", desc,
+                code.rstrip(), "結果", result.rstrip()[:4000]))
+    except Exception:
+        pass
+
+
 def run_python(args):
+    code = args.get("code", "")
+    desc0 = (args.get("description") or "AI").strip()[:60]
+    # 実行の前にも書く（実行の途中で落ちても、何を実行していたか分かるように）
+    _log_run(desc0, code, "（実行中）", False)
+    r = _run_python(args)
+    text = r["content"][0]["text"]
+    if r["is_error"]:
+        _fails[0] += 1
+        if _fails[0] >= 3:
+            text += ("\n（失敗が %d 回続いている。同じやり方を繰り返さず、原因を調べてやり方を変えるか、"
+                     "止めて利用者に聞く）" % _fails[0])
+            r = _text(text, True)
+    else:
+        _fails[0] = 0
+    _log_run(desc0, "", text, r["is_error"])
+    return r
+
