@@ -141,14 +141,20 @@ class TestDwgText(unittest.TestCase):
             Draft.make_text(["日本語テスト φ60", "ASCII"], App.Placement(App.Vector(10, 10, 0), App.Rotation()))
             Draft.make_line(App.Vector(0, 0, 0), App.Vector(100, 0, 0))
             doc.recompute()
-            path = os.path.join(tmp, "t.dwg")
-            importDWG.export(doc.Objects, path)
-            with open(path, "rb") as f:
-                self.assertEqual(f.read(6), b"AC1032")
-            back = App.newDocument("dwgback")
-            importDWG.insert(path, back.Name)
-            texts = sorted(t for o in back.Objects for t in (getattr(o, "Text", None) or []))
-            self.assertEqual(texts, ["ASCII", "日本語テスト φ60"])
+            for version, magic in ((None, b"AC1015"), ("r2018", b"AC1032")):
+                path = os.path.join(tmp, "t_%s.dwg" % version)
+                importDWG.export(doc.Objects, path, version=version, keep_dxf=version is None)
+                with open(path, "rb") as f:
+                    self.assertEqual(f.read(6), magic)
+                back = App.newDocument("dwgback")
+                importDWG.insert(path, back.Name)
+                texts = sorted(t for o in back.Objects for t in (getattr(o, "Text", None) or []))
+                self.assertEqual(texts, ["ASCII", "日本語テスト φ60"], version)
+                App.closeDocument(back.Name)
+                back = None
+            self.assertTrue(os.path.exists(os.path.join(tmp, "t_None.dxf")))  # kept beside the DWG
+            with self.assertRaises(RuntimeError):
+                importDWG.export(doc.Objects, os.path.join(tmp, "x.dwg"), version="r9999")
         finally:
             App.closeDocument(doc.Name)
             if back is not None:
