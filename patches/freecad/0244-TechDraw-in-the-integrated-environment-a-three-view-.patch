 #include <Gui/Action.h>
 #include <Gui/Application.h>
@@ -1054,6 +1064,102 @@ bool CmdTechDrawDetailView::isActive()
 // TechDraw_ProjectionGroup
 //===========================================================================
 
+namespace
+{
+// The view direction and the drawing's X direction for a front view looking at the largest flat
+// face of the shapes; looking from the front (-Y) if there is none. The X direction keeps the
+// up direction of the model up in the drawing, as when looking at it from the front.
+std::pair<Base::Vector3d, Base::Vector3d> frontFromLargestFlatFace(const std::vector<App::DocumentObject*>& objects)
+{
+    std::pair<Base::Vector3d, Base::Vector3d> front {Base::Vector3d(0, -1, 0), Base::Vector3d(1, 0, 0)};
+    double bestArea = 0.0;
+    double bestScore = -2.0;
+    const gp_Dir preferred(0.3, -0.6, 0.9);
+    for (App::DocumentObject* obj : objects) {
+        TopoDS_Shape shape = Part::Feature::getShape(obj, Part::ShapeOption::ResolveLink | Part::ShapeOption::Transform);
+        if (shape.IsNull()) {
+            continue;
+        }
+        TopTools_IndexedMapOfShape faces;
+        TopExp::MapShapes(shape, TopAbs_FACE, faces);
+        for (int i = 1; i <= faces.Extent(); ++i) {
+            const TopoDS_Face& face = TopoDS::Face(faces(i));
+            BRepAdaptor_Surface surface(face);
+            if (surface.GetType() != GeomAbs_Plane) {
+                continue;
+            }
+            GProp_GProps props;
+            BRepGProp::SurfaceProperties(face, props);
+            double area = props.Mass();
+            gp_Dir normal = surface.Plane().Axis().Direction();
+            if (face.Orientation() == TopAbs_REVERSED) {
+                normal.Reverse();
+            }
+            double score = normal.Dot(preferred);
+            bool clearlyLarger = area > bestArea * 1.01;
+            bool aboutTheSame = !clearlyLarger && area > bestArea * 0.99;
+            if (clearlyLarger || (aboutTheSame && score > bestScore)) {
+                bestArea = std::max(area, bestArea);
+                bestScore = score;
+                Base::Vector3d dir(normal.X(), normal.Y(), normal.Z());
+                Base::Vector3d xdir = Base::Vector3d(0, 0, 1).Cross(dir);
+                if (xdir.Length() < 1e-6) {
+                    xdir = Base::Vector3d(1, 0, 0);  // looking down or up: X stays X
+                }
+                front = {dir, xdir.Normalize()};
+            }
+        }
+    }
+    return front;
+}
+
+// The largest standard scale (JIS Z 8314: 10:1, 5:1, 2:1, 1:1, 1:2, 1:5, 1:10, ...) at which a
+// front view with the top view above and the right view beside it fits on the page, leaving
+// room for the frame and the title block
+double fittingScale(const std::vector<App::DocumentObject*>& objects,
+                    const Base::Vector3d& dir, const Base::Vector3d& xdir, TechDraw::DrawPage* page)
+{
+    Bnd_Box box;
+    for (App::DocumentObject* obj : objects) {
+        TopoDS_Shape shape = Part::Feature::getShape(obj, Part::ShapeOption::ResolveLink | Part::ShapeOption::Transform);
+        if (!shape.IsNull()) {
+            BRepBndLib::AddOptimal(shape, box, false, false);
+        }
+    }
+    if (box.IsVoid() || !page) {
+        return 1.0;
+    }
+    double x0, y0, z0, x1, y1, z1;
+    box.Get(x0, y0, z0, x1, y1, z1);
+    // The extent of the box along a direction
+    auto extent = [&](const Base::Vector3d& d) {
+        double lo = 1e300, hi = -1e300;
+        for (double x : {x0, x1}) {
+            for (double y : {y0, y1}) {
+                for (double z : {z0, z1}) {
+                    double v = Base::Vector3d(x, y, z) * d;
+                    lo = std::min(lo, v);
+                    hi = std::max(hi, v);
+                }
+            }
+        }
+        return hi - lo;
+    };
+    Base::Vector3d ydir = dir.Cross(xdir);
+    double w = extent(xdir), h = extent(ydir), d = extent(dir);
+    const double gap = 15.0;  // between the views, as the group's default spacing (mm on paper)
+    double usableW = page->getPageWidth() - 40.0;
+    double usableH = page->getPageHeight() - 70.0;
+    for (double scale : {10.0, 5.0, 2.0, 1.0, 0.5, 0.2, 0.1, 0.05, 0.02, 0.01, 0.005, 0.002, 0.001}) {
+        if ((w + d) * scale + 2 * gap <= usableW && (h + d) * scale + 2 * gap <= usableH) {
+            return scale;
+        }
+    }
+    return 0.001;
+}
+
+}  // namespace
+
 DEF_STD_CMD_A(CmdTechDrawProjectionGroup)
 
 CmdTechDrawProjectionGroup::CmdTechDrawProjectionGroup() : Command("TechDraw_ProjectionGroup")
@@ -1157,9 +1263,18 @@ void CmdTechDrawProjectionGroup::activated(int iMsg)
     multiView->XSource.setValues(xShapes);
     doCommand(Doc, "App.activeDocument().%s.addProjection('Front')", multiViewName.c_str());
 
-    std::pair<Base::Vector3d, Base::Vector3d> dirs = !faceName.empty() ?
-        DrawGuiUtil::getProjDirFromFace(partObj, faceName)
-        : DrawGuiUtil::get3DDirAndRot();
+    std::pair<Base::Vector3d, Base::Vector3d> dirs;
+    if (!faceName.empty()) {
+        dirs = DrawGuiUtil::getProjDirFromFace(partObj, faceName);
+    }
+    else if (App::isSingleWorkbench()) {
+        // Not the direction the 3D view happens to have (an isometric front view does not fit
+        // on the page and is not a drawing): the part's largest flat face looks at the viewer
+        dirs = frontFromLargestFlatFace(shapes);
+    }
+    else {
+        dirs = DrawGuiUtil::get3DDirAndRot();
+    }
 
     Base::Vector3d checkedDir = checkDirectionVsBasis(dirs.first);
     getDocument()->setStatus(App::Document::Status::SkipRecompute, true);
@@ -1174,6 +1289,18 @@ void CmdTechDrawProjectionGroup::activated(int iMsg)
         multiViewName.c_str(), dirs.second.x, dirs.second.y, dirs.second.z);
     getDocument()->setStatus(App::Document::Status::SkipRecompute, false);
 
+    if (App::isSingleWorkbench()) {
+        // A three-view drawing from the start (front, top and right, placed by the projection
+        // convention of the drawing standard), that fits on the page
+        doCommand(Doc, "App.activeDocument().%s.addProjection('Top')", multiViewName.c_str());
+        doCommand(Doc, "App.activeDocument().%s.addProjection('Right')", multiViewName.c_str());
+        // A standard scale chosen from the size of the shapes, not by the automatic scale of
+        // the group: that one is computed before the views have their geometry (in a thread)
+        // and makes them as large as possible, larger than the page
+        double scale = fittingScale(shapes, dirs.first, dirs.second, page);
+        doCommand(Doc, "App.activeDocument().%s.ScaleType = 'Custom'", multiViewName.c_str());
+        doCommand(Doc, "App.activeDocument().%s.Scale = %.12g", multiViewName.c_str(), scale);
+    }
     doCommand(Doc, "App.activeDocument().%s.Anchor.recompute()", multiViewName.c_str());
     commitCommand();
     updateActive();
