 #include <App/Document.h>
 #include <App/DocumentObject.h>
@@ -1429,6 +1430,38 @@ bool MDIViewPage::compareSelections(std::vector<Gui::SelectionObject> treeSel,
 
 void MDIViewPage::showStatusMsg(const char* string1, const char* string2, const char* string3) const
 {
+    // In the integrated environment: the name the user sees and the kind of element in their
+    // language ("Front view, edge 11"), as in the 3D view, instead of "Unnamed.ProjItem.Edge11"
+    if (App::isSingleWorkbench()) {
+        App::Document* doc = App::GetApplication().getDocument(string1);
+        App::DocumentObject* obj = doc ? doc->getObject(string2) : nullptr;
+        if (obj) {
+            QString what = QString::fromUtf8(obj->Label.getValue());
+            std::string element = string3 ? string3 : "";
+            auto digits = element.find_first_of("0123456789");
+            std::string kind = element.substr(0, digits);
+            QString number = digits == std::string::npos
+                ? QString()
+                : QString::fromStdString(element.substr(digits));
+            QString kindText;
+            if (kind == "Face") {
+                kindText = QApplication::translate("Gui::SelectionSingleton", "face %1").arg(number);
+            }
+            else if (kind == "Edge") {
+                kindText = QApplication::translate("Gui::SelectionSingleton", "edge %1").arg(number);
+            }
+            else if (kind == "Vertex") {
+                kindText = QApplication::translate("Gui::SelectionSingleton", "vertex %1").arg(number);
+            }
+            if (!kindText.isEmpty()) {
+                what = QApplication::translate("Gui::SelectionSingleton", "%1, %2").arg(what, kindText);
+            }
+            if (Gui::getMainWindow()) {
+                Gui::getMainWindow()->showMessage(what, 6000);
+            }
+            return;
+        }
+    }
     QString msg = QStringLiteral("%1 %2.%3.%4 ")
                       .arg(tr("Selected:"), QString::fromUtf8(string1), QString::fromUtf8(string2),
                            QString::fromUtf8(string3));
