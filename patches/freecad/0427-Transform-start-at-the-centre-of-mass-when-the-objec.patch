+// The dragger starts at the object's origin (its Placement). For a shape whose geometry was built
+// away from its Placement (Placement left at the origin, as script- and STEP-made parts often are)
+// that is somewhere off in space, often the document origin, and not on the part. Then start at
+// the centre of mass instead; parts whose origin is on or in them (a box at its corner) keep the
+// object origin. Preference CentroidWhenOriginOutside (default on) turns this off.
+void TaskTransform::chooseInitialPlacementMode() const
+{
+    if (!hGrp->GetBool("CentroidWhenOriginOutside", true)) {
+        return;
+    }
+    auto obj = vp->getObject();
+    if (!obj || !centerOfMassProvider || !centerOfMassProvider->supports(obj)) {
+        return;
+    }
+    const int index = ui->placementComboBox->findData(QVariant::fromValue(PlacementMode::Centroid));
+    if (index < 0) {
+        return;
+    }
+    Base::BoundBox3d box = vp->getBoundingBox();
+    if (!box.IsValid()) {
+        return;
+    }
+    const Base::Vector3d origin = App::GeoFeature::getGlobalPlacement(obj).getPosition();
+    box.Enlarge(std::max(1e-6, 0.01 * box.CalcDiagonalLength()));
+    if (box.IsInBox(origin)) {
+        return;
+    }
+    ui->placementComboBox->setCurrentIndex(index);
+}
