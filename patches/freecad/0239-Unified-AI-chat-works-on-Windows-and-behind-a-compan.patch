index 000000000..dad53b342
--- /dev/null
+++ b/src/Mod/Unified/NetworkSettings.py
@@ -0,0 +1,148 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""ネットワークの設定（プロキシと会社の証明書）。FreeCAD 全体で使う（編集 → 設定 → 標準 → ネットワーク）。
+
+設定は User parameter:BaseApp/Preferences/Network:
+  ProxyMode   0 = システムの設定を使う（既定）、1 = 使わない、2 = 手動
+  ProxyURL    手動のときのプロキシ（例 http://proxy.example.co.jp:8080）
+  NoProxy     プロキシを通さない宛先（カンマ区切り）
+  CACertFile  会社の証明書（PEM）。通信を検査する会社のネットワークで要る
+
+起動時と設定を変えたときに、この FreeCAD の環境変数（HTTPS_PROXY・HTTP_PROXY・NO_PROXY・SSL_CERT_FILE・
+REQUESTS_CA_BUNDLE・NODE_EXTRA_CA_CERTS）に反映する。Python の urllib・requests、AI チャットの仲介役と
+claude、そのほか FreeCAD から起動するものが、これを使う。
+"""
+
+import os
+
+# FreeCAD は使うときに読む（AI チャットの仲介役は FreeCAD の外の Python で、describe_error だけを使う）
+
+PARAMS = "User parameter:BaseApp/Preferences/Network"
+SYSTEM, NONE, MANUAL = 0, 1, 2
+PROXY_VARS = ("HTTPS_PROXY", "https_proxy", "HTTP_PROXY", "http_proxy", "ALL_PROXY", "all_proxy")
+NO_PROXY_VARS = ("NO_PROXY", "no_proxy")
+CA_VARS = ("SSL_CERT_FILE", "REQUESTS_CA_BUNDLE", "NODE_EXTRA_CA_CERTS")
+LOCAL = "localhost,127.0.0.1,::1"
+
+# 起動したときの環境（利用者が自分で設定した環境変数）。設定を変えたら、ここから作り直す
+_original = None
+
+
+def params():
+    import FreeCAD
+    return FreeCAD.ParamGet(PARAMS)
+
+
+def settings():
+    p = params()
+    return {
+        "mode": p.GetInt("ProxyMode", SYSTEM),
+        "url": p.GetString("ProxyURL", "").strip(),
+        "no_proxy": p.GetString("NoProxy", "").strip(),
+        "ca": p.GetString("CACertFile", "").strip(),
+    }
+
+
+def _windows_no_proxy():
+    """Windows のプロキシの例外（インターネット オプションの ProxyOverride）を NO_PROXY の形に"""
+    try:
+        import winreg
+        with winreg.OpenKey(winreg.HKEY_CURRENT_USER,
+                            r"Software\Microsoft\Windows\CurrentVersion\Internet Settings") as k:
+            override = winreg.QueryValueEx(k, "ProxyOverride")[0]
+    except Exception:
+        return ""
+    out = []
+    for item in str(override).replace(",", ";").split(";"):
+        item = item.strip()
+        if not item or item == "<local>":
+            continue
+        if item.startswith("*."):
+            item = item[1:]          # *.example.co.jp → .example.co.jp
+        if "*" in item:
+            continue                 # 10.* などは NO_PROXY では書けない
+        out.append(item)
+    return ",".join(out)
+
+
+def system_proxy():
+    """システムのプロキシ（Windows はインターネット オプション、ほかは環境変数）。(url, no_proxy)。無ければ ("", "")"""
+    try:
+        import urllib.request
+        proxies = urllib.request.getproxies()
+    except Exception:
+        return "", ""
+    url = proxies.get("https") or proxies.get("http") or ""
+    if url and "://" not in url:
+        url = "http://" + url
+    no_proxy = proxies.get("no", "") or (_windows_no_proxy() if os.name == "nt" else "")
+    return url, no_proxy
+
+
+def compute(environ, s):
+    """設定 s を当てた環境変数（変える分だけ）。値が None のものは消す"""
+    changes = {}
+    has_env_proxy = any(environ.get(k) for k in PROXY_VARS)
+    if s["mode"] == MANUAL and s["url"]:
+        url = s["url"] if "://" in s["url"] else "http://" + s["url"]
+        no_proxy = ",".join(x for x in (LOCAL, s["no_proxy"]) if x)
+        for k in PROXY_VARS[:4]:
+            changes[k] = url
+        for k in NO_PROXY_VARS:
+            changes[k] = no_proxy
+    elif s["mode"] == NONE:
+        for k in PROXY_VARS + NO_PROXY_VARS:
+            changes[k] = None
+    elif not has_env_proxy:
+        # システムの設定: 環境変数が無ければ、OS のプロキシの設定を環境変数にする（claude などはこれしか読まない）
+        url, no_proxy = system_proxy()
+        if url:
+            for k in PROXY_VARS[:4]:
+                changes[k] = url
+            no_proxy = ",".join(x for x in (LOCAL, no_proxy) if x)
+            for k in NO_PROXY_VARS:
+                changes[k] = no_proxy
+    ca = s["ca"]
+    if ca:
+        for k in CA_VARS:
+            changes[k] = ca
+    elif environ.get("SSL_CERT_FILE") and not environ.get("NODE_EXTRA_CA_CERTS"):
+        changes["NODE_EXTRA_CA_CERTS"] = environ["SSL_CERT_FILE"]
+    return changes
+
+
+def apply():
+    """設定を、この FreeCAD の環境変数に反映する（起動時と、設定を変えたとき）"""
+    global _original
+    try:
+        if _original is None:
+            _original = {k: os.environ.get(k) for k in PROXY_VARS + NO_PROXY_VARS + CA_VARS}
+        # 前に当てた分を戻してから当て直す
+        for k, v in _original.items():
+            if v is None:
+                os.environ.pop(k, None)
+            else:
+                os.environ[k] = v
+        for k, v in compute(dict(os.environ), settings()).items():
+            if v is None:
+                os.environ.pop(k, None)
+            else:
+                os.environ[k] = v
+    except Exception as e:  # 設定に失敗しても FreeCAD の起動は止めない
+        import FreeCAD
+        FreeCAD.Console.PrintWarning("Network settings: %s\n" % e)
+
+
+def describe_error(text):
+    """接続の失敗の説明（プロキシ・証明書）を日本語で。当てはまらなければ None"""
+    t = (text or "").lower()
+    if "cannot import" in t or "no module named" in t:
+        return None
+    hint = "編集 → 設定 → 標準 → ネットワーク で、プロキシと証明書を確かめてください"
+    if any(k in t for k in ("certificate", "self_signed", "self-signed", "self signed", "issuer",
+                            "unable_to_verify", "unable to verify", "cert_has_expired")):
+        return "証明書を確かめられないので接続できない（会社のネットワークの検査など）: %s。%s" % (text, hint)
+    if any(k in t for k in ("proxy", "407", "econnrefused", "enotfound", "etimedout", "econnreset",
+                            "getaddrinfo", "connection error", "unable to connect", "fetch failed",
+                            "network is unreachable", "timed out")):
+        return "プロキシ経由で接続できない: %s。%s" % (text, hint)
+    return None
diff --git a/src/Mod/Unified/UnifiedPreferences.py b/src/Mod/Unified/UnifiedPreferences.py
new file mode 100644
index 000000000..633baab59
--- /dev/null
+++ b/src/Mod/Unified/UnifiedPreferences.py
@@ -0,0 +1,192 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""設定の画面（編集 → 設定 → 標準）: 「ネットワーク」（プロキシと会社の証明書）と「AI チャット」（API キー）"""
+
+import os
+
+import FreeCAD as App
+from PySide import QtWidgets
+
+import NetworkSettings
+
+translate = App.Qt.translate
+
+
+class NetworkPage:
+    """プロキシと会社の証明書。FreeCAD 全体で使う（AI チャット・ダウンロードなど）"""
+
+    def __init__(self, parent=None):
+        self.form = QtWidgets.QWidget(parent)
+        self.form.setWindowTitle(translate("UnifiedNetwork", "Network"))
+        lay = QtWidgets.QVBoxLayout(self.form)
+
+        box = QtWidgets.QGroupBox(translate("UnifiedNetwork", "Proxy"))
+        g = QtWidgets.QGridLayout(box)
+        self.system = QtWidgets.QRadioButton(translate("UnifiedNetwork", "Use the system proxy settings"))
+        self.none = QtWidgets.QRadioButton(translate("UnifiedNetwork", "No proxy"))
+        self.manual = QtWidgets.QRadioButton(translate("UnifiedNetwork", "Use this proxy:"))
+        self.url = QtWidgets.QLineEdit()
+        self.url.setPlaceholderText("http://proxy.example.co.jp:8080")
+        self.no_proxy = QtWidgets.QLineEdit()
+        self.no_proxy.setPlaceholderText(".example.co.jp, 192.168.1.10")
+        g.addWidget(self.system, 0, 0, 1, 2)
+        g.addWidget(self.none, 1, 0, 1, 2)
+        g.addWidget(self.manual, 2, 0)
+        g.addWidget(self.url, 2, 1)
+        g.addWidget(QtWidgets.QLabel(translate("UnifiedNetwork", "Not through the proxy:")), 3, 0)
+        g.addWidget(self.no_proxy, 3, 1)
+        self.detected = QtWidgets.QLabel()
+        self.detected.setWordWrap(True)
+        g.addWidget(self.detected, 4, 0, 1, 2)
+        for b in (self.system, self.none, self.manual):
+            b.toggled.connect(self._update)
+        lay.addWidget(box)
+
+        box = QtWidgets.QGroupBox(translate("UnifiedNetwork", "Certificate"))
+        v = QtWidgets.QVBoxLayout(box)
+        v.addWidget(QtWidgets.QLabel(translate(
+            "UnifiedNetwork",
+            "If your company network inspects encrypted connections, choose the company's "
+            "certificate file (PEM). Ask your IT department for it.")))
+        row = QtWidgets.QHBoxLayout()
+        self.ca = QtWidgets.QLineEdit()
+        row.addWidget(self.ca, 1)
+        browse = QtWidgets.QPushButton(translate("UnifiedNetwork", "Choose…"))
+        browse.clicked.connect(self._browse)
+        row.addWidget(browse)
+        v.addLayout(row)
+        lay.addWidget(box)
+        lay.addWidget(QtWidgets.QLabel(translate(
+            "UnifiedNetwork", "Used by the AI chat and by anything FreeCAD connects to the internet with.")))
+        lay.addStretch(1)
+
+    def _browse(self):
+        f, _ = QtWidgets.QFileDialog.getOpenFileName(
+            self.form, translate("UnifiedNetwork", "Certificate file"), os.path.dirname(self.ca.text()),
+            translate("UnifiedNetwork", "Certificates (*.pem *.crt *.cer);;All files (*)"))
+        if f:
+            self.ca.setText(f)
+
+    def _update(self, *args):
+        self.url.setEnabled(self.manual.isChecked())
+        self.no_proxy.setEnabled(self.manual.isChecked())
+        if self.system.isChecked():
+            url, _no = NetworkSettings.system_proxy()
+            self.detected.setText(
+                translate("UnifiedNetwork", "System proxy: {0}").format(url) if url
+                else translate("UnifiedNetwork", "System proxy: none (connects directly)"))
+            self.detected.show()
+        else:
+            self.detected.hide()
+
+    def loadSettings(self):
+        s = NetworkSettings.settings()
+        {NetworkSettings.NONE: self.none, NetworkSettings.MANUAL: self.manual}.get(s["mode"], self.system).setChecked(True)
+        self.url.setText(s["url"])
+        self.no_proxy.setText(s["no_proxy"])
+        self.ca.setText(s["ca"])
+        self._update()
+
+    def saveSettings(self):
+        p = NetworkSettings.params()
+        mode = NetworkSettings.MANUAL if self.manual.isChecked() else \
+            NetworkSettings.NONE if self.none.isChecked() else NetworkSettings.SYSTEM
+        p.SetInt("ProxyMode", mode)
+        p.SetString("ProxyURL", self.url.text().strip())
+        p.SetString("NoProxy", self.no_proxy.text().strip())
+        p.SetString("CACertFile", self.ca.text().strip())
+        NetworkSettings.apply()
+        apply_qt_proxy()
+        try:
+            import AIChatGui
+            if AIChatGui.chat.panel is not None:
+                AIChatGui.chat.panel.restart()  # 次に送るときに新しい設定で始まる
+        except Exception:
+            pass
+
+
+class AIChatPage:
+    """AI チャットの API キー（変える・消す）"""
+
+    def __init__(self, parent=None):
+        self.form = QtWidgets.QWidget(parent)
+        self.form.setWindowTitle(translate("AIChat", "AI chat"))
