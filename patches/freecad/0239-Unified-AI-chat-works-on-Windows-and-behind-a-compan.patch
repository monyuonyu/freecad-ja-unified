+# 部品が全部読めること（ssl・claude-agent-sdk・同梱の claude）。AI には接続しない
+ai_test=$(PYTHONPATH="$(cygpath -w "${copy_dir}/ai-runtime")" PYTHONNOUSERSITE=1 PYTHONUTF8=1 \
+    "${copy_dir}/bin/python.exe" "${copy_dir}/Mod/Unified/AIAgentBridge.py" --self-test \
