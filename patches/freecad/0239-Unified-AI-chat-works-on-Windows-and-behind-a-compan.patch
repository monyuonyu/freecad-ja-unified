+
+def apply_qt_proxy():
+    """Qt の通信（画面の中のダウンロードなど）にも同じプロキシを使う"""
+    try:
+        from PySide import QtNetwork
+    except ImportError:
+        try:
+            from PySide6 import QtNetwork
+        except ImportError:
+            return
+    s = NetworkSettings.settings()
+    if s["mode"] == NetworkSettings.MANUAL and s["url"]:
+        from urllib.parse import urlsplit
+        u = urlsplit(s["url"] if "://" in s["url"] else "http://" + s["url"])
+        proxy = QtNetwork.QNetworkProxy(QtNetwork.QNetworkProxy.HttpProxy, u.hostname or "", u.port or 8080,
+                                        u.username or "", u.password or "")
+        QtNetwork.QNetworkProxyFactory.setUseSystemConfiguration(False)
+        QtNetwork.QNetworkProxy.setApplicationProxy(proxy)
+    elif s["mode"] == NetworkSettings.NONE:
+        QtNetwork.QNetworkProxyFactory.setUseSystemConfiguration(False)
+        QtNetwork.QNetworkProxy.setApplicationProxy(QtNetwork.QNetworkProxy(QtNetwork.QNetworkProxy.NoProxy))
+    else:
+        QtNetwork.QNetworkProxyFactory.setUseSystemConfiguration(True)
