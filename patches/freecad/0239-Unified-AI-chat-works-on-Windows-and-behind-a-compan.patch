-mv ${copy_dir}/bin/Lib/ssl.py .ssl-orig.py
-cp ssl-patch.py ${copy_dir}/bin/Lib/ssl.py
+# ssl.py is not replaced any more: ssl-patch.py was the ssl.py of Python 3.11 (with a workaround for
+# a bad certificate in the Windows store) and broke 'import ssl' on the bundled Python 3.13
+# ("cannot import name 'RAND_pseudo_bytes' from '_ssl'"). Python 3.10+ skips bad certificates itself.
