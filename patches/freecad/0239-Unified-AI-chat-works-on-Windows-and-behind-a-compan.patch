+        self.change.clicked.connect(self._change)
+        row.addWidget(self.change)
+        self.remove = QtWidgets.QPushButton(translate("AIChat", "Remove the key"))
+        self.remove.clicked.connect(self._remove)
+        row.addWidget(self.remove)
+        row.addStretch(1)
+        v.addLayout(row)
+        v.addWidget(QtWidgets.QLabel(translate(
+            "AIChat", "The key is kept in the key store of your system, not in the FreeCAD settings. "
+                      "Create one at console.anthropic.com (usage is billed to your account).")))
+        lay.addWidget(box)
+        lay.addStretch(1)
+
+    def _refresh(self):
+        import AIChatGui
+        if AIChatGui.find_python() is None:
+            self.state.setText(translate("AIChat", "The AI is not set up yet."))
+            self.change.setEnabled(False)
+            self.remove.setEnabled(False)
+            return
+        has = AIChatGui.has_key()
+        self.state.setText(translate("AIChat", "A key is stored.") if has
+                           else translate("AIChat", "No key is stored.") if has is False
+                           else translate("AIChat", "Could not check the stored key."))
+        self.change.setEnabled(True)
+        self.remove.setEnabled(has is not False)
+
+    def _change(self):
+        import AIChatGui
+        key, ok = QtWidgets.QInputDialog.getText(
+            self.form, translate("AIChat", "Anthropic API key"),
+            translate("AIChat", "Your API key (sk-ant-…)."), QtWidgets.QLineEdit.Password)
+        if ok and key.strip():
+            _ok, msg = AIChatGui.store_key(key)
+            QtWidgets.QMessageBox.information(self.form, translate("AIChat", "AI chat"), msg)
+            self._refresh()
+
+    def _remove(self):
+        import AIChatGui
+        _ok, msg = AIChatGui.store_key("")
+        QtWidgets.QMessageBox.information(self.form, translate("AIChat", "AI chat"), msg)
+        self._refresh()
+
+    def loadSettings(self):
+        self._refresh()
+
+    def saveSettings(self):
