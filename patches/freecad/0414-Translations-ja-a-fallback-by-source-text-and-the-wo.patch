diff --git a/src/Gui/Language/make_fallback.py b/src/Gui/Language/make_fallback.py
new file mode 100644
index 000000000..10c9783db
--- /dev/null
+++ b/src/Gui/Language/make_fallback.py
@@ -0,0 +1,26 @@
+#!/usr/bin/env python3
+"""Make fallback_ja.tsv: every finished Japanese translation of the *_ja.ts files, by its source
+text alone. The application uses it when no translation file has the string under the context
+asked for: PySide's self.tr() asks by class, a .ts holds strings under other names.
+Run from src/Gui/Language after changing translations: python3 make_fallback.py"""
+import collections
+import glob
+import re
+import xml.etree.ElementTree as ET
+
+JA = re.compile(r"[\u3040-\u30ff\u4e00-\u9fff]")
+found = collections.defaultdict(collections.Counter)
+for path in sorted(glob.glob("../../**/*_ja.ts", recursive=True)):
+    for message in ET.parse(path).getroot().iter("message"):
+        source, translation = message.find("source"), message.find("translation")
+        if source is None or translation is None or translation.get("type") == "unfinished":
+            continue
+        form = translation.find("numerusform")
+        text = (form.text if form is not None else translation.text) or ""
+        if source.text and JA.search(text):
+            found[source.text][text] += 1
+escape = lambda t: t.replace("\\", "\\\\").replace("\t", "\\t").replace("\n", "\\n")  # noqa: E731
+with open("fallback_ja.tsv", "w", encoding="utf-8", newline="\n") as f:
+    for source in sorted(found):
+        f.write("%s\t%s\n" % (escape(source), escape(found[source].most_common(1)[0][0])))
+print(len(found))
