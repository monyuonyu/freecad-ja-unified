 }  // namespace Gui
 
+namespace
+{
+/// The last translator asked (it is installed first): a string no .qm has under the context asked
+/// for, by its source text alone (PySide's self.tr() asks by class name; dialogs and tool panels
+/// stayed in English though the .ts held their words; make_fallback.py makes the table)
+class FallbackTranslator: public QTranslator
+{
+public:
+    bool load(const QString& file)
+    {
+        QFile f(file);
+        if (!f.open(QIODevice::ReadOnly | QIODevice::Text)) {
+            return false;
+        }
+        auto unescape = [](const QByteArray& t) {
+            QByteArray out;
+            out.reserve(t.size());
+            for (qsizetype i = 0; i < t.size(); ++i) {
+                if (t[i] == '\\' && i + 1 < t.size()) {
+                    ++i;
+                    out.append(t[i] == 'n' ? '\n' : t[i] == 't' ? '\t' : t[i]);
+                }
+                else {
+                    out.append(t[i]);
+                }
+            }
+            return out;
+        };
+        while (!f.atEnd()) {
+            const QByteArray line = f.readLine().chopped(1);
+            const qsizetype tab = line.indexOf('\t');
+            if (tab > 0) {
+                table.insert(unescape(line.left(tab)), QString::fromUtf8(unescape(line.mid(tab + 1))));
+            }
+        }
+        return !table.isEmpty();
+    }
+    QString translate(const char*, const char* source, const char*, int) const override
+    {
+        return table.value(QByteArray::fromRawData(source, qstrlen(source)));
+    }
+    bool isEmpty() const override
+    {
+        return table.isEmpty();
+    }
+
+private:
+    QHash<QByteArray, QString> table;
+};
+}  // namespace
+
 class Translator::ParameterObserver: public ParameterGrp::ObserverType
 {
 public:
@@ -348,6 +401,19 @@ void Translator::activateLanguage(const char* lang)
 {
     removeTranslators();  // remove the currently installed translators
     d->activatedLanguage = lang;
+    // first: Qt asks the most recently installed translator first, this one last
+    const auto domain = d->mapLanguageTopLevelDomain.find(lang);
+    if (domain != d->mapLanguageTopLevelDomain.end()) {
+        auto fallback = new FallbackTranslator;
+        if (fallback->load(QStringLiteral(":/translations/fallback_%1.tsv")
+                               .arg(QString::fromStdString(domain->second)))) {
+            d->translators.push_back(fallback);
+            qApp->installTranslator(fallback);
+        }
+        else {
+            delete fallback;
+        }
+    }
     const TLanguageList languages = supportedLanguages();
     if (std::ranges::find(languages, lang) != languages.end()) {
         refresh();
