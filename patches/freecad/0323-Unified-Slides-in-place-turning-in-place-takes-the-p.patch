 src/Mod/Unified/AssemblyCopiesGui.py          | 27 +++++++++++++++--
 src/Mod/Unified/ContextRules.py               | 12 +++++++-
 .../Gui/Resources/translations/Unified_ja.ts  | 29 +++++++++++++++++++
