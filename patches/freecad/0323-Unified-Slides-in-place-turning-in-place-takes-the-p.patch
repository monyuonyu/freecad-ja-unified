@@ -141,7 +141,12 @@ class AssemblySolveTest(unittest.TestCase):
             at = App.Placement(App.Vector(30, 20, 5), App.Rotation(App.Vector(1, 0, 0), 90))
             crank.Placement = at
             doc.recompute()
+            # the first part put in is fixed to the ground: turning in place takes that away
+            import JointObject
+
+            JointObject.GroundedJoint(doc.getObject("Joints").newObject("App::FeaturePython", "Fixed"), crank)
             joint = AssemblyCopies.hinge_to_ground(asm, crank, "Face1")
+            self.assertFalse([o for o in doc.Objects if getattr(o, "ObjectToGround", None) == crank])
             self.assertEqual(asm.solve(), 0)
             self.assertTrue(crank.Placement.isSame(at, 1e-9))
             joint.AngleDriven = True
@@ -156,6 +161,25 @@ class AssemblySolveTest(unittest.TestCase):
         finally:
             App.closeDocument(doc.Name)
 
+    def test_slide_on_ground(self):
+        import AssemblyCopies
+
+        doc = App.newDocument("slide")
+        try:
+            asm = doc.addObject("Assembly::AssemblyObject", "Assembly")
+            asm.Type = "Assembly"
+            asm.newObject("Assembly::JointGroup", "Joints")
+            piston = asm.newObject("Part::Cylinder", "Piston")
+            piston.Placement.Base = App.Vector(0, 0, 50)
+            doc.recompute()
+            joint = AssemblyCopies.slide_on_ground(asm, piston, "Face1")
+            self.assertEqual(joint.JointType, "Slider")
+            self.assertEqual(asm.solve(), 0)
+            self.assertTrue(piston.Placement.Base.isEqual(App.Vector(0, 0, 50), 1e-9))
+            self.assertEqual(asm.getBrokenJoints(), [])
+        finally:
+            App.closeDocument(doc.Name)
+
     def test_big_step_right_after_opening(self):
         # no solve that held is remembered in a file just opened: the walk starts where the parts are
         import os
