 def root_objects(doc):
-    """The tops of the document: used by nothing in it. doc.RootObjects also leaves out a part
-    that an assembly in another document links to (the part could not be drawn, dragged, ...)"""
-    return [o for o in doc.Objects if not any(p.Document == doc for p in o.InList)]
+    """The tops of the document: used by nothing in it but its drawings. doc.RootObjects also
+    leaves out a part that an assembly in another document links to, or that a drawing shows
+    (the part could not be drawn, dragged, ...)"""
+    def uses(p):
+        # a drawing's views show the part, they do not hold it
+        return p.Document == doc and not p.TypeId.startswith("TechDraw::")
+
+    return [o for o in doc.Objects if not any(uses(p) for p in o.InList)]
 
