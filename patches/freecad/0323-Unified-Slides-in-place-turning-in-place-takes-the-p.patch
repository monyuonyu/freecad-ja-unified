 7 files changed, 120 insertions(+), 9 deletions(-)

diff --git a/src/Mod/Unified/AssemblyCopies.py b/src/Mod/Unified/AssemblyCopies.py
index b15f61c39..239f6ce0e 100644
--- a/src/Mod/Unified/AssemblyCopies.py
+++ b/src/Mod/Unified/AssemblyCopies.py
@@ -103,13 +103,28 @@ def hinge_to_ground(assembly, part, sub):
     """A revolute joint between the round face or circle `sub` of `part` (a part of the assembly)
     and the ground (the assembly's origin), where the part is now: a crank turns in place
     without a case part to hold it. Returns the joint."""
+    return joint_to_ground(assembly, part, sub, "Revolute", App.Qt.translate("Unified", "Turns in place"))
+
+
+def slide_on_ground(assembly, part, sub):
+    """A slider joint between the round face (its axis) or a flat face of `part` and the ground,
+    where the part is now: a piston slides along its axis. Returns the joint."""
+    return joint_to_ground(assembly, part, sub, "Slider", App.Qt.translate("Unified", "Slides in place"))
+
+
+def joint_to_ground(assembly, part, sub, kind, label):
     import JointObject
     import UtilsAssembly
 
     group = UtilsAssembly.getJointGroup(assembly)
-    joint = group.newObject("App::FeaturePython", "Revolute")
-    JointObject.Joint(joint, JointObject.JointTypes.index("Revolute"))
-    joint.Label = App.Qt.translate("Unified", "Turns in place")
+    # The part held by the ground now moves by this joint: its fixing (the first part put in
+    # is fixed) goes, else the joint could not turn it (engine field test 0.7.4)
+    for o in list(group.Group):
+        if getattr(o, "ObjectToGround", None) == part:
+            assembly.Document.removeObject(o.Name)
+    joint = group.newObject("App::FeaturePython", kind)
+    JointObject.Joint(joint, JointObject.JointTypes.index(kind))
+    joint.Label = label
     joint.Reference2 = (part, [sub, sub])
     # the ground's side: the same place, fixed to the origin
     where = part.Placement.multiply(joint.Placement2)
diff --git a/src/Mod/Unified/AssemblyCopiesGui.py b/src/Mod/Unified/AssemblyCopiesGui.py
index 710c81f31..702a2f1e7 100644
--- a/src/Mod/Unified/AssemblyCopiesGui.py
+++ b/src/Mod/Unified/AssemblyCopiesGui.py
@@ -261,21 +261,44 @@ class HingeToGroundCommand:
     def IsActive(self):
         return not Gui.Control.activeDialog() and self.picked() is not None
 
+    def make(self, assembly, part, sub):
+        return AC.hinge_to_ground(assembly, part, sub)
+
     def Activated(self):
         found = self.picked()
         if found is None:
             return
         assembly, part, sub = found
         doc = assembly.Document
-        doc.openTransaction(translate("Unified", "Turns in place"))
+        doc.openTransaction(translate("Unified", "Joint to the ground"))
         try:
-            joint = AC.hinge_to_ground(assembly, part, sub)
+            joint = self.make(assembly, part, sub)
         finally:
             doc.commitTransaction()
         Gui.Selection.clearSelection()
         Gui.Selection.addSelection(joint)
 
 
+class SlideOnGroundCommand(HingeToGroundCommand):
+    """One round face (its axis) or flat face of a part of an assembly: the part slides along
+    it, in place (a piston in its cylinder, without the cylinder part)"""
+
+    def GetResources(self):
+        return {
+            "Pixmap": "Assembly_CreateJointSlider",
+            "MenuText": QT_TRANSLATE_NOOP("Unified_SlideOnGround", "Slides in Place"),
+            "ToolTip": QT_TRANSLATE_NOOP(
+                "Unified_SlideOnGround",
+                "The part slides along the picked round face's axis, where it is now (held by the "
+                "ground: no other part is needed).",
+            ),
+        }
+
+    def make(self, assembly, part, sub):
+        return AC.slide_on_ground(assembly, part, sub)
+
+
 Gui.addCommand("Unified_GridCopies", GridCopiesCommand())
 Gui.addCommand("Unified_AnotherPart", DuplicateCommand())
 Gui.addCommand("Unified_HingeToGround", HingeToGroundCommand())
+Gui.addCommand("Unified_SlideOnGround", SlideOnGroundCommand())
