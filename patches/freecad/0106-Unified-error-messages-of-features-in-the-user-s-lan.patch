+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+#pragma once
+
+namespace UnifiedGui
+{
+
+/**
+ * Error messages of features in the user's language. Many messages thrown by FreeCAD and OCC
+ * are not marked for translation, and some carry numbers or names ("... constraints: 5, 6",
+ * "subshape not found Pad.Face9"). A translator installed ahead of the others translates them
+ * wherever they are shown with QApplication::translate: in the notification area, the tree's
+ * tooltips and the task panels. The texts are in the "UnifiedErrors" context of the
+ * translation files.
+ */
+void installErrorMessages();
+
+}  // namespace UnifiedGui
