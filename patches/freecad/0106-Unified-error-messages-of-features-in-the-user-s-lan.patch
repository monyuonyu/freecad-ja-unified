diff --git a/src/Mod/Unified/Gui/ErrorMessages.cpp b/src/Mod/Unified/Gui/ErrorMessages.cpp
new file mode 100644
index 000000000..9c39e5059
--- /dev/null
+++ b/src/Mod/Unified/Gui/ErrorMessages.cpp
@@ -0,0 +1,172 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+#include <cstring>
+
+#include <QCoreApplication>
+#include <QRegularExpression>
+#include <QTranslator>
+
+#include <App/DocumentObject.h>
+#include <Base/Type.h>
+#include <Gui/Language/Translator.h>
+
+#include "ErrorMessages.h"
+
+namespace
+{
+constexpr const char* errorContext = "UnifiedErrors";
+
+// Messages with numbers or names in them: the pattern, and the English text of the message whose
+// translation is used ("%1" is the captured part)
+struct Pattern
+{
+    const char* regex;
+    const char* text;
+};
+// clang-format off
+const Pattern patterns[] = {
+    {R"(Sketch with conflicting constraints\s*Remove at least one of the following conflicting constraints:\s*([\d\s,]+))",
+     QT_TRANSLATE_NOOP("UnifiedErrors", "Conflicting constraints; remove one of: %1")},
+    {R"(Sketch with redundant constraints\s*Remove the following redundant constraints?:\s*([\d\s,]+))",
+     QT_TRANSLATE_NOOP("UnifiedErrors", "Redundant constraints; remove: %1")},
+    {R"(Sketch with partially redundant constraints\s*.*?:\s*([\d\s,]+))",
+     QT_TRANSLATE_NOOP("UnifiedErrors", "Partially redundant constraints: %1")},
+    {R"(Sketch with malformed constraints\s*.*?:\s*([\d\s,]+))",
+     QT_TRANSLATE_NOOP("UnifiedErrors", "Malformed constraints; remove: %1")},
+    {R"(AttachEngine\w*: subshape not found (\S+))",
+     QT_TRANSLATE_NOOP("UnifiedErrors", "Attachment target %1 not found")},
+    {R"(AttachEngine\w*::calculateAttachedPlacement:\s*(.*))",
+     QT_TRANSLATE_NOOP("UnifiedErrors", "Attachment placement cannot be calculated (%1)")},
+    {R"(makeOffset2D:\s*(.*))",
+     QT_TRANSLATE_NOOP("UnifiedErrors", "Offset failed (%1)")},
+};
+// clang-format on
+
+QString lookup(const QString& text, const char* disambiguation = nullptr)
+{
+    const QByteArray utf8 = text.toUtf8();
+    QString result = QCoreApplication::translate(errorContext, utf8.constData(), disambiguation);
+    return result == text ? QString() : result;
+}
+
+// "5\n, 6\n" -> "5, 6"
+QString tidyList(QString list)
+{
+    static const QRegularExpression separators(QStringLiteral(R"(\s*,\s*|\s+)"));
+    return list.trimmed().split(separators, Qt::SkipEmptyParts).join(QStringLiteral(", "));
+}
+
+class ErrorTranslator: public QTranslator
+{
+public:
+    using QTranslator::QTranslator;
+
+    bool isEmpty() const override
+    {
+        return false;
+    }
+
+    QString translate(const char* context, const char* source, const char* disambiguation, int n)
+        const override
+    {
+        (void)disambiguation;
+        (void)n;
+        if (busy || !context || !source || !isErrorContext(context)) {
+            return {};
+        }
+        // The lookups below go through all translators again, this one included
+        busy = true;
+        QString result;
+        const QString text = QString::fromUtf8(source);
+        // A translation of the whole message in the module's own files comes first
+        if (QCoreApplication::translate(context, source) == text) {
+            // The tree asks with the object's type as context, the modules declare their
+            // messages in the "Exception" context
+            QString exception = std::strstr(context, "::") ? QCoreApplication::translate("Exception", source)
+                                                             : text;
+            result = exception != text ? exception : translateMessage(text.trimmed(), context);
+        }
+        busy = false;
+        return result;
+    }
+
+private:
+    // Error messages are translated in these contexts: "Exception" (task panels, the design
+    // check), "Notifications" (the notification area) and the type of the object (its tooltip
+    // in the tree)
+    static bool isErrorContext(const char* context)
+    {
+        if (std::strcmp(context, "Exception") == 0 || std::strcmp(context, "Notifications") == 0) {
+            return true;
+        }
+        if (!std::strstr(context, "::")) {
+            return false;
+        }
+        Base::Type type = Base::Type::fromName(context);
+        return !type.isBad() && type.isDerivedFrom(App::DocumentObject::getClassTypeId());
+    }
+
+    static QString translateMessage(const QString& message, const char* context)
+    {
+        if (message.isEmpty()) {
+            return {};
+        }
+        // Worded for the kind of object, e.g. OCC's "command not done" for a fillet
+        if (std::strstr(context, "::")) {
+            if (QString t = lookup(message, context); !t.isEmpty()) {
+                return t;
+            }
+        }
+        if (QString t = lookup(message); !t.isEmpty()) {
+            return t;
+        }
+        for (const Pattern& pattern : patterns) {
+            const QRegularExpression regex(
+                QStringLiteral("^%1$").arg(QString::fromLatin1(pattern.regex)),
+                QRegularExpression::DotMatchesEverythingOption
+            );
+            QRegularExpressionMatch match = regex.match(message);
+            if (match.hasMatch()) {
+                QString t = lookup(QString::fromLatin1(pattern.text));
+                if (t.isEmpty()) {
+                    return {};
+                }
+                QString captured = match.captured(1);
+                if (captured.contains(QLatin1Char(',')) || captured.contains(QLatin1Char('\n'))) {
+                    captured = tidyList(captured);
+                }
+                return t.arg(captured.trimmed());
+            }
+        }
+        // A known message followed by a name or a number: "Sub shape not found: Face3". Try the
+        // text before each ": " or quote, then shorter and shorter beginnings at word breaks
+        // (messages put together from several strings)
+        for (int i = message.size() - 1; i > 0; --i) {
+            const QChar c = message.at(i);
+            const bool colon = c == QLatin1Char(':');
+            const bool quote = c == QLatin1Char('\'');
+            if (!colon && !quote && c != QLatin1Char(' ')) {
+                continue;
+            }
+            const QString head = message.left(colon || quote ? i + 1 : i).trimmed();
+            if (head.size() < 8) {  // NOLINT(*-avoid-magic-numbers)
+                break;
+            }
+            if (QString t = lookup(head); !t.isEmpty()) {
+                return t + QLatin1Char(' ') + message.mid(colon || quote ? i + 1 : i).trimmed();
+            }
+        }
+        return {};
+    }
+
+    static thread_local bool busy;
+};
+
+thread_local bool ErrorTranslator::busy = false;
+}  // namespace
+
+void UnifiedGui::installErrorMessages()
+{
+    static ErrorTranslator translator;
+    Gui::Translator::instance()->addOverride(&translator);
+}
