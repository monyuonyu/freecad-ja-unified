From: shota <monyuonyu@gmail.com>
Date: Sun, 27 Sep 2026 09:06:44 +0900
Subject: [PATCH 59/68] Preferences: no add-on hint in the integrated
 environment, TechDraw pages as "drawings" in Japanese

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/Gui/PreferencePages/DlgSettingsGeneral.cpp             | 2 ++
 src/Mod/TechDraw/Gui/Resources/translations/TechDraw_ja.ts | 2 +-
 src/Mod/Unified/Gui/Resources/translations/Unified_ja.ts   | 4 ----
 3 files changed, 3 insertions(+), 5 deletions(-)

diff --git a/src/Gui/PreferencePages/DlgSettingsGeneral.cpp b/src/Gui/PreferencePages/DlgSettingsGeneral.cpp
index 01b8be2f8..c0cb1922b 100644
--- a/src/Gui/PreferencePages/DlgSettingsGeneral.cpp
+++ b/src/Gui/PreferencePages/DlgSettingsGeneral.cpp
@@ -150,6 +150,8 @@ DlgSettingsGeneral::DlgSettingsGeneral(QWidget* parent)
     ui->moreThemesLabel->setEnabled(
         Application::Instance->commandManager().getCommandByName("Std_AddonMgr") != nullptr
     );
+    // No add-on manager in the integrated environment: no hint that points to it
+    ui->moreThemesLabel->setVisible(!App::Application::Config().contains("SingleWorkbench"));
 }
 
 /**
