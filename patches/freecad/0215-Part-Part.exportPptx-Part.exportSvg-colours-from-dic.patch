+    def _file_with_colors(self):
+        """A document saved headless, then given the GuiDocument.xml the GUI would write:
+        Red (ShapeAppearance), Faces (one material per face), Old (ShapeColor and
+        DiffuseColor of FreeCAD 0.21), a link with OverrideMaterial and a plain link."""
+        doc = App.newDocument("PartViewsColors")
+        doc.addObject("Part::Box", "Red")
+        doc.addObject("Part::Box", "Faces").Placement.Base = App.Vector(20, 0, 0)
+        doc.addObject("Part::Box", "Old").Placement.Base = App.Vector(40, 0, 0)
+        for name, x in (("LinkOver", 60), ("LinkPlain", 80)):
+            link = doc.addObject("App::Link", name)
+            link.LinkedObject = doc.Red
+            link.Placement.Base = App.Vector(x, 0, 0)
+        doc.recompute()
+        path = os.path.join(self.tmp, "colors.FCStd")
+        doc.saveAs(path)
+        App.closeDocument(doc.Name)
+
+        def packed(rgb):
+            r, g, b = (int(round(c * 255)) for c in rgb)
+            return (r << 24) | (g << 16) | (b << 8)
+
+        def materials(colors):
+            blob = struct.pack("<I", len(colors))
+            for c in colors:
+                blob += struct.pack("<IIIIff", 0, packed(c), 0, 0, 0.2, 0.0)
+            return blob + struct.pack("<III", 0, 0, 0) * len(colors)
+
+        def appearance(name, file, extra=""):
+            return ('<ViewProvider name="%s" expanded="0"><Properties Count="2">%s'
+                    '<Property name="ShapeAppearance" type="App::PropertyMaterialList">'
+                    '<MaterialList file="%s" version="3"/></Property></Properties></ViewProvider>'
+                    % (name, extra, file))  # fmt: skip
+
+        override = ('<Property name="OverrideMaterial" type="App::PropertyBool">'
+                    '<Bool value="%s"/></Property>')  # fmt: skip
+        gui = (
+            '<?xml version="1.0" encoding="utf-8"?><Document SchemaVersion="1"><ViewProviderData Count="5">'
+            + appearance("Red", "SA1")
+            + appearance("Faces", "SA2")
+            + '<ViewProvider name="Old"><Properties Count="2">'
+            '<Property name="DiffuseColor" type="App::PropertyColorList"><ColorList file="DC"/></Property>'
+            '<Property name="ShapeColor" type="App::PropertyColor"><PropertyColor value="%d"/></Property>'
+            "</Properties></ViewProvider>" % packed((0, 0, 1))
+            + appearance("LinkOver", "SA3", override % "true")
+            + appearance("LinkPlain", "SA4", override % "false")
+            + "</ViewProviderData></Document>"
+        )
+        old = [(0, 0, 1)] * 5 + [(1, 0, 1)]  # magenta top face
+        with zipfile.ZipFile(path, "a") as z:
+            z.writestr("GuiDocument.xml", gui)
+            z.writestr("SA1", materials([(1, 0, 0)]))
+            z.writestr("SA2", materials([(0, 1, 0)] * 5 + [(1, 1, 0)]))
+            z.writestr("DC", struct.pack("<I", 6) + b"".join(struct.pack("<I", packed(c)) for c in old))
+            z.writestr("SA3", materials([(0, 1, 1)]))
+            z.writestr("SA4", materials([(0.5, 0.5, 0.5)]))
+        return path
+
