+// Part.exportPptx / Part.exportSvg: the writers are Python (PartViews)
+PyObject* callPartViews(const char* name, PyObject* args, PyObject* kwds)
+{
+    PyObject* module = PyImport_ImportModule("PartViews");
+    if (!module) {
+        return nullptr;
+    }
+    PyObject* fn = PyObject_GetAttrString(module, name);
+    Py_DECREF(module);
+    if (!fn) {
+        return nullptr;
+    }
+    PyObject* result = PyObject_Call(fn, args, kwds);
+    Py_DECREF(fn);
+    return result;
+}
+
+PyObject* exportPptx(PyObject* /*self*/, PyObject* args, PyObject* kwds)
+{
+    return callPartViews("part_export_pptx", args, kwds);
+}
+
+PyObject* exportSvg(PyObject* /*self*/, PyObject* args, PyObject* kwds)
+{
+    return callPartViews("part_export_svg", args, kwds);
