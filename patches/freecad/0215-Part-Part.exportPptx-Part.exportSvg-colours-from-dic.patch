+# ------------------------------------------------------------------ colours of objects
+
+_STORED = {}  # FCStd path -> (mtime, {object name: {"colors": [...], "override": bool|None}})
+
+
+def _unpack_rgb(value):
+    return ((value >> 24) & 255) / 255.0, ((value >> 16) & 255) / 255.0, ((value >> 8) & 255) / 255.0
+
+
+def _read_material_list(blob, version):
+    """Diffuse colours of a PropertyMaterialList file (little endian, see PropertyStandard.cpp)."""
+    import struct
+
+    pos = 0
+    (count,) = struct.unpack_from("<i", blob, pos)
+    pos += 4
+    if version not in ("2", "3") and count < 0:  # an early versioned format
+        (count,) = struct.unpack_from("<I", blob, pos)
+        pos += 4
+    colors = []
+    for _ in range(max(count, 0)):
+        _ambient, diffuse = struct.unpack_from("<II", blob, pos)
+        colors.append(_unpack_rgb(diffuse))
+        pos += 24  # four colours, shininess, transparency
+    return colors
+
+
+def _read_color_list(blob):
+    import struct
+
+    (count,) = struct.unpack_from("<I", blob, 0)
+    return [_unpack_rgb(v) for v in struct.unpack_from("<%dI" % count, blob, 4)]
+
+
+def _stored_colors(doc):
+    """{object name: {"colors", "override"}} from the GuiDocument.xml of the document's file:
+    the colours the GUI showed when it was saved, for headless runs."""
+    import xml.etree.ElementTree as ET
+    import zipfile
+
+    path = getattr(doc, "FileName", "")
+    if not path or not os.path.isfile(path):
+        return {}
+    mtime = os.path.getmtime(path)
+    cached = _STORED.get(path)
+    if cached and cached[0] == mtime:
+        return cached[1]
+    result = {}
+    try:
+        with zipfile.ZipFile(path) as z:
+            names = set(z.namelist())
+            if "GuiDocument.xml" not in names:
+                _STORED[path] = (mtime, result)
+                return result
+            root = ET.fromstring(z.read("GuiDocument.xml"))
+            for vp in root.iter("ViewProvider"):
+                props = {p.get("name"): p for p in vp.iter("Property")}
+                colors = None
+                try:
+                    prop = props.get("ShapeAppearance")
+                    ml = prop.find("MaterialList") if prop is not None else None
+                    if ml is not None and ml.get("file") in names:
+                        colors = _read_material_list(z.read(ml.get("file")), ml.get("version"))
+                    elif prop is None and "ShapeColor" in props:  # before FreeCAD 1.0
+                        pc = props["ShapeColor"].find("PropertyColor")
+                        colors = [_unpack_rgb(int(pc.get("value")))]
+                        cl = props["DiffuseColor"].find("ColorList") if "DiffuseColor" in props else None
+                        if cl is not None and cl.get("file") in names:
+                            per_face = _read_color_list(z.read(cl.get("file")))
+                            if len(per_face) > 1:
+                                colors = per_face
+                except Exception:
+                    colors = None
+                override = None
+                if "OverrideMaterial" in props:
+                    b = props["OverrideMaterial"].find("Bool")
+                    override = b is not None and b.get("value") == "true"
+                result[vp.get("name")] = {"colors": colors or None, "override": override}
+    except Exception:
+        result = {}
+    _STORED[path] = (mtime, result)
+    return result
+
+
+def _view_colors(obj):
+    """{"colors", "override"} of the object's view provider (GUI) or as stored in its file."""
+    vo = getattr(obj, "ViewObject", None) if App.GuiUp else None
+    if vo is None:
+        return _stored_colors(obj.Document).get(obj.Name)
+    override = bool(vo.OverrideMaterial) if hasattr(vo, "OverrideMaterial") else None
+    colors = None
+    try:
+        if hasattr(vo, "ShapeAppearance"):
+            mats = vo.ShapeAppearance
+            mats = mats if isinstance(mats, (list, tuple)) else [mats]
+            colors = [tuple(m.DiffuseColor[:3]) for m in mats]
+        elif hasattr(vo, "ShapeColor"):
+            colors = [tuple(vo.ShapeColor[:3])]
+    except Exception:
+        colors = None
+    return {"colors": colors or None, "override": override}
+
+
+def object_colors(obj, _depth=0):
+    """Colours of a document object as shown in the GUI: [(r, g, b)] or one per face (in the
+    order of Shape.Faces), or None.  Headless, the colours stored in the FCStd file
+    (GuiDocument.xml) are used.  Links show their own colour only with OverrideMaterial."""
+    try:
+        info = _view_colors(obj)
+    except Exception:
+        info = None
+    if info and info["override"] is not None:  # a link
+        if info["override"] and info["colors"]:
+            return info["colors"][:1]
+        linked = obj.getLinkedObject(True) if hasattr(obj, "getLinkedObject") else None
+        if linked is not None and linked is not obj and _depth < 16:
+            return object_colors(linked, _depth + 1)
+        return None
+    return info["colors"] if info else None
+
+
+def _link_override(obj):
+    """The colour a link puts on everything below it (OverrideMaterial), or None."""
+    if not (obj.isDerivedFrom("App::Link") or obj.isDerivedFrom("App::LinkElement")):
+        return None
+    try:
+        info = _view_colors(obj)
+    except Exception:
+        return None
+    if info and info["override"] and info["colors"]:
+        return info["colors"][:1]
+    return None
+
+
