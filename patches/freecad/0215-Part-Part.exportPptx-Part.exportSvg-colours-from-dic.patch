+// Colours stored for a document object (its view provider, or the GuiDocument.xml of
+// its FCStd file when there is no GUI), by PartViews.object_colors; false if none
+bool storedColors(const Py::Object& obj, SceneItem& item)
+{
+    try {
+        PyObject* module = PyImport_ImportModule("PartViews");
+        if (!module) {
+            PyErr_Clear();
+            return false;
+        }
+        Py::Module mod(module, true);
+        Py::Callable fn(mod.getAttr("object_colors"));
+        Py::Object res = fn.apply(Py::TupleN(obj));
+        if (res.isNone()) {
+            return false;
+        }
+        Py::Sequence list(res);
+        if (list.size() == 0) {
+            return false;
+        }
+        item.color = toColor(list[0]);
+        if (list.size() > 1) {
+            for (const auto& c : list) {
+                item.faceColors.push_back(toColor(c));
+            }
+        }
+        return true;
+    }
+    catch (const Py::Exception&) {
+        PyErr_Clear();  // keep the palette colour
+        return false;
+    }
+}
