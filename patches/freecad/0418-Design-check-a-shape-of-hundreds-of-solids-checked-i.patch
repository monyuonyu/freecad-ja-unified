+def _touches(a, b, tol):
+    """Whether shapes a and b come within tol of each other. Solid by solid, only the solids whose
+    boxes come that close, stopping at the first: distToShape between two shapes of hundreds of
+    solids took 100 s a pair (a cart of 496 solids ran for more than 23 minutes)"""
+    sa = a.Solids or [a]
+    sb = b.Solids or [b]
+    if len(sa) == 1 and len(sb) == 1:
+        return _dist(a, b) <= tol
+    near = []
+    for x in sa:
+        grown = _grown(x.BoundBox, tol)
+        near += [(x, y) for y in sb if grown.intersect(y.BoundBox)]
+    # the pairs whose boxes overlap most are the likeliest to touch
+    near.sort(key=lambda p: -_box_overlap(p[0].BoundBox, p[1].BoundBox, tol))
+    return any(_dist(x, y) <= tol for x, y in near)
+
+
+def _box_overlap(p, q, tol):
+    box = _grown(p, tol).intersected(q)
+    return box.XLength * box.YLength * box.ZLength if box.isValid() else 0.0
+
