+def _round_faces(solid):
+    """The round faces of a solid: [(face, cylinder, shaft)]; shaft is true for a face around
+    material (a screw's shank), false for a hole"""
+    out = []
+    for f, surf in _cylinders(solid):
+        lo, hi = f.ParameterRange[2:]
+        mid = surf.Center + surf.Axis * ((lo + hi) / 2)
+        try:
+            shaft = solid.isInside(mid, 1e-6, True)
+        except Exception:
+            continue
+        out.append((f, surf, shaft))
+    return out
+
+
+def _thread_fit(x, y, volume, faces):
+    """Solids x and y overlap as a drawn screw in a threaded hole: a round shank of x in a round
+    hole of y on the same axis, smaller by at most a thread's depth (a fifth of the radius: M6 drawn
+    at 6 mm in a 5 mm tap drill), and no more overlap than that ring along the length they share.
+    Told by the shapes, not by names or a list. faces: a cache {id(solid): _round_faces}"""
+    import math
+
+    for screw, nut in ((x, y), (y, x)):
+        shanks = [(f, s) for f, s, shaft in faces.setdefault(id(screw), _round_faces(screw)) if shaft]
+        holes = [(f, s) for f, s, shaft in faces.setdefault(id(nut), _round_faces(nut)) if not shaft]
+        ring = 0.0
+        for fa, sa in shanks:
+            for fb, sb in holes:
+                big, small = sa.Radius, sb.Radius
+                if not 0 < big - small <= 0.2 * big or abs(abs(sa.Axis.dot(sb.Axis)) - 1) > 1e-6:
+                    continue
+                d = sb.Center - sa.Center
+                if (d - sa.Axis * d.dot(sa.Axis)).Length > 1e-3:
+                    continue
+                ta = sorted(sa.Axis.dot(v.Point) for v in fa.Vertexes) or [0]
+                tb = sorted(sa.Axis.dot(v.Point) for v in fb.Vertexes) or [0]
+                length = min(ta[-1], tb[-1]) - max(ta[0], tb[0])
+                if length > 1e-6:
+                    ring += math.pi * (big * big - small * small) * length
+        if ring > 0 and volume <= ring * 1.05 + 1e-3:
+            return True
+    return False
+
+
