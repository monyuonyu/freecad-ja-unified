+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""The parts shelf (部品の棚) in the window: a task panel to pick a screw, a nut, a washer, an
+aluminium profile or a company part and put it with clicks.
+
+- Screws and the like: click a hole (its round face or its edge) and the screw goes in: the size
+  from the hole, the length from what it holds and the thread it goes into, on the hole's axis.
+  Size, length, washers and nut can be set in the panel; a change redoes the last one.
+- Profiles: click two points (or click one and type the length); the profile lies on the face
+  that was clicked.
+- Company parts: click a face; the part's origin goes there, its Z out of the face.
+
+Commands: Unified_PartsShelf (the tool strip, Ctrl+K), Unified_InsertScrew (the bar next to a
+picked hole: the panel opens with what fits that hole), Unified_PlaceProfile.
+The geometry is in PartsShelf.py.
+"""
+
+import os
+import time
+
+import FreeCAD as App
+import FreeCADGui as Gui
+from PySide import QtCore, QtGui, QtWidgets
+
+import PartsShelf as PS
+import SnapMath as S
+import SnapToolsGui as STG
+
+translate = App.Qt.translate
+CTX = "PartsShelf"
+HERE = os.path.dirname(os.path.abspath(__file__))
+
+
+def QT_TRANSLATE_NOOP(context, text):
+    return text
+
+
+def tr(text):
+    return translate(CTX, text)
+
+
+AUTO = "auto"
+
+
+# --------------------------------------------------------------------------- picks
+def _picked_hole():
+    """(element, Pick) of a picked hole (round face or circle edge), or (None, None)"""
+    picks = STG.selection_picks()
+    if len(picks) != 1:
+        return None, None
+    pick = picks[0]
+    shape = pick.shape()
+    if shape is None or shape.ShapeType not in ("Face", "Edge"):
+        return None, None
+    if PS._axis_of(shape) is None:
+        return None, None
+    return shape, pick
+
+
+def _shapes_for(doc):
+    return PS.solids_of_document(doc)
+
+
+def _view_direction():
+    try:
+        return App.Vector(Gui.ActiveDocument.ActiveView.getViewDirection())
+    except Exception:
+        return None
+
+
+def analyze(element, pick):
+    """The hole of a pick, or None"""
+    doc = pick.root.Document
+    owner = pick.owner()
+    if PS.is_shelf_part(owner) or PS.is_shelf_part(pick.root):
+        return None
+    shapes = _shapes_for(doc)
+    try:
+        return PS.analyze_hole(element, shapes, pick.point, _view_direction())
+    except Exception as e:
+        App.Console.PrintLog("Parts shelf: {}\n".format(e))
+        return None
+
+
+def _hole_cached():
+    key = ("PartsShelf.hole",) + tuple(
+        (s.Object.Name, s.Object.Document.Name, tuple(s.SubElementNames))
+        for s in Gui.Selection.getSelectionEx("", 0)
+    )
+    cache = STG._classify_cache
+    if key not in cache:
+        element, pick = _picked_hole()
+        hole = None
+        if element is not None:
+            try:
+                hole = analyze(element, pick)
+            except Exception:
+                hole = None
+        cache[key] = hole
+    return cache[key]
+
+
+# --------------------------------------------------------------------------- the clicks
+class FreePicker(STG.Picker):
+    """Clicks that also count in empty space: then the point is on the ground plane (z = 0) or,
+    after a first point, on the plane through it facing the camera's up direction."""
+
+    def __init__(self, view, on_click, on_escape, on_hover=None):
+        super().__init__(view, on_click, on_escape, on_hover)
+        self.snapping = True
+        self.plane_point = App.Vector(0, 0, 0)
+        self.plane_normal = App.Vector(0, 0, 1)
+
+    def free_point(self, pos):
+        try:
+            p = App.Vector(self.view.getPoint(int(pos[0]), int(pos[1])))
+            d = App.Vector(self.view.getViewDirection())
+        except Exception:
+            return None
+        n = self.plane_normal
+        denom = d.dot(n)
+        if abs(denom) < 1e-9:
+            return p
+        t = (self.plane_point - p).dot(n) / denom
+        return p + d * t
+
+    def hit(self, pos):
+        h = self.snapped(pos)
+        if h is not None:
+            return h
+        p = self.free_point(pos)
+        return (None, p, "free") if p is not None else None
+
+    def _moved(self, cb):
+        ev = cb.getEvent()
+        pos = tuple(ev.getPosition().getValue())
+        h = self.hit(pos)
+        self.last = h
+        if h is None or h[2] == "free":
+            self.overlay.show_point("snap", h[1] if h else None, "face")
+        else:
+            self.overlay.show_point("snap", h[1], h[2])
+        if self.on_hover:
+            self.on_hover(h)
+
+    def _button(self, cb):
+        coin = STG._coin()
+        ev = cb.getEvent()
+        if ev.getButton() != coin.SoMouseButtonEvent.BUTTON1:
+            return
+        cb.setHandled()
+        if ev.getState() != coin.SoButtonEvent.DOWN:
+            return
+        pos = tuple(ev.getPosition().getValue())
+        h = self.hit(pos)
+        if h is None:
+            return
+        pick, point, kind = h
+        ctrl = ev.wasCtrlDown()
+        QtCore.QTimer.singleShot(0, lambda: self.on_click(pick, point, kind, ctrl))
+
+
+def _face_normal(pick, point):
+    if pick is None:
+        return None
+    shape = pick.shape()
+    if shape is None or shape.ShapeType != "Face":
+        return None
+    try:
+        f = S.face_feature(shape, point)
+    except S.SnapError:
+        return None
+    return f.direction if f.kind == "plane" else None
+
+
+# --------------------------------------------------------------------------- the panel
+class ShelfPanel:
+    ROLE_KIND = QtCore.Qt.UserRole
+    ROLE_KEY = QtCore.Qt.UserRole + 1
+
+    def __init__(self, start=None, hole=None, query=""):
+        self.doc = App.ActiveDocument
+        self.view = STG._active_view()
+        self.hole = hole  # the hole the next "Insert" puts a screw into
+        self.last = None  # (what, args, links) of the last thing put: options redo it
+        self.first = None  # profile: the first point (point, face normal)
+        self.closed = False
+        self._ghost = None
+        self._build()
+        self._fill()
+        self.picker = FreePicker(self.view, self._clicked, self._escape, self._hover) if self.view else None
+        if query:
+            self.search.setText(query)
+        self._select(start or ("fastener", hole and PS.default_kind(hole) or "socket_head"))
+        if hole is not None:
+            self._suggest(hole)
+        Gui.Selection.clearSelection()
+        self._update()
+
+    # ------------------------------------------------------------------ widgets
+    def _build(self):
+        w = QtWidgets.QWidget()
+        w.setObjectName("PartsShelfPanel")
+        w.setWindowTitle(tr("Parts shelf"))
+        w.setWindowIcon(QtGui.QIcon(os.path.join(HERE, "PartsShelf.svg")))
+        self.form = w
+        lay = QtWidgets.QVBoxLayout(w)
+
+        self.step = STG._bold(QtWidgets.QLabel())
+        self.step.setWordWrap(True)
+        lay.addWidget(self.step)
+
+        self.search = QtWidgets.QLineEdit()
+        self.search.setPlaceholderText(tr("Find, e.g. M6×20, nut, washer, profile"))
+        self.search.setClearButtonEnabled(True)
+        self.search.textChanged.connect(self._filter)
+        lay.addWidget(self.search)
+
+        self.tree = QtWidgets.QTreeWidget()
+        self.tree.setObjectName("PartsShelfList")
+        self.tree.setHeaderHidden(True)
+        self.tree.setMinimumHeight(220)
+        self.tree.currentItemChanged.connect(lambda *a: self._changed_item())
+        lay.addWidget(self.tree, 1)
+
+        # Screws and the like
+        self.fopts = QtWidgets.QWidget()
+        g = QtWidgets.QGridLayout(self.fopts)
+        g.setContentsMargins(0, 0, 0, 0)
+        g.addWidget(QtWidgets.QLabel(tr("Size:")), 0, 0)
+        self.size = QtWidgets.QComboBox()
+        self.size.setObjectName("PartsShelfSize")
+        self.size.addItem(tr("From the hole"), AUTO)
+        for m in PS.SIZES:
+            self.size.addItem(m.name, m.name)
+        self.size.currentIndexChanged.connect(self._size_changed)
+        g.addWidget(self.size, 0, 1)
+        g.addWidget(QtWidgets.QLabel(tr("Length:")), 1, 0)
+        self.length = QtWidgets.QComboBox()
+        self.length.setObjectName("PartsShelfLength")
+        self.length.currentIndexChanged.connect(self._option_changed)
+        g.addWidget(self.length, 1, 1)
+        self.washers = QtWidgets.QCheckBox(tr("Washers under the head (plain and spring)"))
+        self.washers.toggled.connect(self._option_changed)
+        g.addWidget(self.washers, 2, 0, 1, 2)
+        self.nut = QtWidgets.QCheckBox(tr("A nut on the other side"))
+        self.nut.setTristate(False)
+        self.nut.toggled.connect(self._option_changed)
+        g.addWidget(self.nut, 3, 0, 1, 2)
+        g.addWidget(QtWidgets.QLabel(tr("Plate on top:")), 4, 0)
+        self.plate = QtWidgets.QDoubleSpinBox()
+        self.plate.setRange(0, 1000)
+        self.plate.setDecimals(1)
+        self.plate.setSuffix(" mm")
+        self.plate.setToolTip(tr("The thickness of a plate the screw also holds that is not drawn (the head sits that much higher)"))
+        self.plate.valueChanged.connect(self._option_changed)
+        g.addWidget(self.plate, 4, 1)
+        lay.addWidget(self.fopts)
+
+        self.hole_box = QtWidgets.QLabel()
+        self.hole_box.setObjectName("PartsShelfHole")
+        self.hole_box.setWordWrap(True)
+        self.hole_box.setTextFormat(QtCore.Qt.RichText)
+        lay.addWidget(self.hole_box)
+        self.insert = QtWidgets.QPushButton(tr("Insert"))
+        self.insert.setObjectName("PartsShelfInsert")
+        self.insert.setDefault(True)
+        self.insert.clicked.connect(self._insert_into_hole)
+        lay.addWidget(self.insert)
+
+        # Profiles
+        self.popts = QtWidgets.QWidget()
+        g = QtWidgets.QGridLayout(self.popts)
+        g.setContentsMargins(0, 0, 0, 0)
+        g.addWidget(QtWidgets.QLabel(tr("Length:")), 0, 0)
+        self.plength = QtWidgets.QDoubleSpinBox()
+        self.plength.setObjectName("PartsShelfProfileLength")
+        self.plength.setRange(1, 100000)
+        self.plength.setDecimals(1)
+        self.plength.setSuffix(" mm")
+        self.plength.setValue(App.ParamGet(
+            "User parameter:BaseApp/Preferences/Mod/Unified/PartsShelf").GetFloat("ProfileLength", 500.0))
+        self.plength.setToolTip(tr("Follows the cursor after the first click; type a length and press Enter to put it"))
+        self.plength.editingFinished.connect(self._typed_length)
+        g.addWidget(self.plength, 0, 1)
+        lay.addWidget(self.popts)
+
+        # Company parts
+        self.copts = QtWidgets.QWidget()
+        g = QtWidgets.QHBoxLayout(self.copts)
+        g.setContentsMargins(0, 0, 0, 0)
+        self.folders = QtWidgets.QLabel()
+        self.folders.setWordWrap(True)
+        g.addWidget(self.folders, 1)
+        add = QtWidgets.QPushButton(tr("Folder…"))
+        add.setToolTip(tr("Add a folder of the company's parts (FCStd and STEP files, see the README)"))
+        add.clicked.connect(self._add_folder)
+        g.addWidget(add)
+        lay.addWidget(self.copts)
+
+        self.message = QtWidgets.QLabel()
+        self.message.setObjectName("PartsShelfMessage")
+        self.message.setWordWrap(True)
+        lay.addWidget(self.message)
+
+    def getStandardButtons(self):
+        return QtWidgets.QDialogButtonBox.Close
+
+    def isAllowedAlterSelection(self):
+        return True
+
+    def isAllowedAlterView(self):
+        return True
+
+    def _fill(self):
+        self.tree.clear()
+        groups = {}
+
+        def group(name):
+            if name not in groups:
+                item = QtWidgets.QTreeWidgetItem(self.tree, [translate(CTX, name)])
+                item.setFlags(item.flags() & ~QtCore.Qt.ItemIsSelectable)
+                item.setExpanded(True)
+                f = item.font(0)
+                f.setBold(True)
+                item.setFont(0, f)
+                groups[name] = item
+            return groups[name]
+
+        for k in PS.KINDS:
+            item = QtWidgets.QTreeWidgetItem(group(k.group), ["{}  ({})".format(k.name(), k.standard)])
+            item.setData(0, self.ROLE_KIND, "fastener")
+            item.setData(0, self.ROLE_KEY, k.key)
+            item.setToolTip(0, "{} {}".format(k.standard, k.iso))
+        for p in PS.PROFILES:
+            item = QtWidgets.QTreeWidgetItem(group(PS.G_PROFILE), [p.name()])
+            item.setData(0, self.ROLE_KIND, "profile")
+            item.setData(0, self.ROLE_KEY, p.key)
+        self.company = PS.company_parts()
+        top = group(PS.G_COMPANY)
+        cats = {}
+        for i, part in enumerate(self.company):
+            parent = top
+            if part.category:
+                if part.category not in cats:
+                    cats[part.category] = QtWidgets.QTreeWidgetItem(top, [part.category])
+                    cats[part.category].setFlags(cats[part.category].flags() & ~QtCore.Qt.ItemIsSelectable)
+                    cats[part.category].setExpanded(True)
+                parent = cats[part.category]
+            text = part.name + ("  ({})".format(part.number) if part.number else "")
+            item = QtWidgets.QTreeWidgetItem(parent, [text])
+            item.setData(0, self.ROLE_KIND, "company")
+            item.setData(0, self.ROLE_KEY, i)
+            item.setToolTip(0, part.path + ("\n" + part.note if part.note else ""))
+        if not self.company:
+            hint = QtWidgets.QTreeWidgetItem(top, [tr("(none yet: add a folder below)")])
+            hint.setData(0, self.ROLE_KIND, "company-hint")
+            hint.setFlags(QtCore.Qt.ItemIsEnabled | QtCore.Qt.ItemIsSelectable)
+        folders = PS.company_folders()
+        self.folders.setText(tr("Company parts: {}").format(", ".join(folders)) if folders else
+                             tr("Company parts: no folder yet"))
+
+    def _items(self):
+        it = QtWidgets.QTreeWidgetItemIterator(self.tree)
+        while it.value():
+            yield it.value()
+            it += 1
+
+    def _select(self, start):
+        what, key = start
+        for item in self._items():
+            if item.data(0, self.ROLE_KIND) == what and item.data(0, self.ROLE_KEY) == key:
+                self.tree.setCurrentItem(item)
+                return
+
+    def _current(self):
+        item = self.tree.currentItem()
+        if item is None:
+            return None, None
+        return item.data(0, self.ROLE_KIND), item.data(0, self.ROLE_KEY)
+
+    def _filter(self, text):
+        size, length, rest = PS.parse_query(text)
+        words = [w for w in rest.replace("、", " ").replace(",", " ").split() if w]
+        if size:
+            i = self.size.findData(size)
+            if i >= 0:
+                self.size.setCurrentIndex(i)
+        if length:
+            self._want_length = length
+            self._fill_lengths()
+        first = None
+        for item in self._items():
+            what = item.data(0, self.ROLE_KIND)
+            if what is None:
+                continue
+            key = item.data(0, self.ROLE_KEY)
+            if what == "fastener":
+                show = PS.matches(key, words)
+            elif what == "profile":
+                show = not words or all(any(w.lower() in a.lower() for a in PS.ALIASES["profile"] + [item.text(0)])
+                                        for w in words)
+            elif what == "company":
+                part = self.company[key]
+                hay = " ".join([part.name, part.category, part.keywords, part.number, part.note]).lower()
+                show = all(w.lower() in hay for w in words)
+            else:
+                show = not words
+            item.setHidden(not show)
+            if show and first is None and what != "company-hint":
+                first = item
+        # The groups with nothing shown
+        for item in self._items():
+            if item.data(0, self.ROLE_KIND) is None:
+                item.setHidden(not any(not item.child(i).isHidden() or item.child(i).childCount() and
+                                       any(not item.child(i).child(j).isHidden() for j in range(item.child(i).childCount()))
+                                       for i in range(item.childCount())))
+        cur = self.tree.currentItem()
+        if first is not None and (cur is None or cur.isHidden()):
+            self.tree.setCurrentItem(first)
+
+    # ------------------------------------------------------------------ options
+    _want_length = None
+    _quiet = False
+
+    def _kind(self):
+        what, key = self._current()
+        return key if what == "fastener" else None
+
+    def _size(self):
+        data = self.size.currentData()
+        if data == AUTO:
+            return self.hole.metric.name if self.hole is not None and self.hole.metric else "M6"
+        return data
+
+    def _fill_lengths(self):
+        kind = self._kind()
+        self._quiet = True
+        try:
+            keep = self._want_length or self.length.currentData()
+            self.length.clear()
+            if kind and PS.KIND[kind].length:
+                self.length.addItem(tr("From the hole"), AUTO)
+                for l in PS.standard_lengths(kind, self._size()):
+                    self.length.addItem("{:g} mm".format(l), l)
+                if keep not in (None, AUTO):
+                    i = self.length.findData(float(keep))
+                    if i >= 0:
+                        self.length.setCurrentIndex(i)
+                self.length.setEnabled(True)
+            else:
+                self.length.setEnabled(False)
+        finally:
+            self._quiet = False
+            self._want_length = None
+
+    def _changed_item(self):
+        self._fill_lengths()
+        self.first = None
+        self._show_ghost(None)
+        self._update()
+        self._option_changed()
+
+    def _size_changed(self):
+        self._fill_lengths()
+        self._option_changed()
+
+    def _suggest(self, hole):
+        """The options for a hole: the kind from the hole, the nut for a bolt through it"""
+        self._quiet = True
+        try:
+            self.nut.setChecked(PS.default_kind(hole) in PS.HEADED and hole.thread <= 1e-6 and not hole.blind)
+        finally:
+            self._quiet = False
+
+    def _option_changed(self, *args):
+        if self._quiet:
+            return
+        self._update()
+        # Redo the last one with the new options
+        if self.last is not None and self.last[0] == "fastener":
+            self._redo_last()
+
+    def _options(self):
+        kind = self._kind()
+        size = None if self.size.currentData() == AUTO else self.size.currentData()
+        length = self.length.currentData()
+        length = None if length in (None, AUTO) else float(length)
+        return dict(kind=kind, size=size, length=length, washers=self.washers.isChecked(),
+                    nut=self.nut.isChecked(), plate=self.plate.value())
+
+    # ------------------------------------------------------------------ messages
+    def _update(self):
+        what, key = self._current()
+        fastener = what == "fastener"
+        self.fopts.setVisible(fastener)
+        self.popts.setVisible(what == "profile")
+        self.copts.setVisible(what in ("company", "company-hint"))
+        headed = fastener and key in PS.HEADED
+        self.washers.setEnabled(headed)
+        self.nut.setEnabled(headed)
+        self.plate.setEnabled(fastener)
+        self.hole_box.setVisible(fastener and self.hole is not None)
+        self.insert.setVisible(fastener and self.hole is not None)
+        if self.hole is not None and fastener:
+            plan = self._plan(self.hole)
+            text = "<b>{}</b><br>{}".format(tr("The hole:"), self.hole.describe())
+            if plan is not None:
+                text += "<br><b>{}</b> {}".format(tr("Goes in:"), ", ".join(
+                    _count([i.label() for i in plan.items])))
+                if plan.needed:
+                    text += "<br><small>{}</small>".format(
+                        tr("needs {:g} mm, standard length {:g} mm").format(round(plan.needed, 1), plan.length or 0))
+            self.hole_box.setText(text)
+        if what == "fastener":
+            if self.hole is not None:
+                self.step.setText(tr("Insert puts it into the hole. Or click another hole"))
+            else:
+                self.step.setText(tr("Click a hole: the screw that fits goes in (size and length from the hole)"))
+        elif what == "profile":
+            if self.first is None:
+                self.step.setText(tr("Click where the profile starts (on a face it lies on the face)"))
+            else:
+                self.step.setText(tr("Click where it ends, or type the length and press Enter"))
+        elif what == "company":
+            self.step.setText(tr("Click a face: the part goes there"))
+        elif what == "company-hint":
+            self.step.setText(tr("Add the folder with the company's parts (FCStd, STEP; an index shelf.csv is optional)"))
+        else:
+            self.step.setText(tr("Pick a part on the shelf"))
+
+    def _say(self, text, error=False):
+        self.message.setStyleSheet("color: #b00020;" if error else "")
+        self.message.setText(text)
+
+    # ------------------------------------------------------------------ putting
+    def _plan(self, hole):
+        o = self._options()
+        if o["kind"] is None:
+            return None
+        try:
+            return PS.plan_for_hole(hole, **o)
+        except Exception as e:
+            App.Console.PrintWarning("Parts shelf: {}\n".format(e))
+            return None
+
+    def _container(self):
+        try:
+            for context in ("part",):
+                c = Gui.ActiveDocument.ActiveView.getActiveObject(context)
+                if c is not None:
+                    return c
+        except Exception:
+            pass
+        return None
+
+    def _put_fastener(self, hole):
+        plan = self._plan(hole)
+        if plan is None:
+            return
+        self.doc.openTransaction(tr("Insert screw"))
+        try:
+            QtWidgets.QApplication.setOverrideCursor(QtCore.Qt.WaitCursor)
+            links = PS.put_plan(self.doc, plan, self._container())
+            self.doc.recompute()
+        except Exception as e:
+            self.doc.abortTransaction()
+            self._say(tr("Could not put it: {}").format(e), True)
+            return
+        finally:
+            QtWidgets.QApplication.restoreOverrideCursor()
+        self.doc.commitTransaction()
+        self.last = ("fastener", hole, links)
+        self._say(tr("Put: {} (Ctrl+Z takes it back; changing the options above changes it)").format(
+            ", ".join(_count([i.label() for i in plan.items]))))
+
+    def _remove_last(self):
+        if self.last is None:
+            return
+        for link in self.last[2]:
+            try:
+                if link.Document is not None and link.Name in [o.Name for o in self.doc.Objects]:
+                    self.doc.removeObject(link.Name)
+            except Exception:
+                pass
+        _prune_originals(self.doc)
+
+    def _redo_last(self):
+        _, hole, links = self.last
+        plan = self._plan(hole)
+        if plan is None:
+            return
+        self.doc.openTransaction(tr("Change screw"))
+        try:
+            self._remove_last()
+            links = PS.put_plan(self.doc, plan, self._container())
+            self.doc.recompute()
+        except Exception as e:
+            self.doc.abortTransaction()
+            self._say(tr("Could not put it: {}").format(e), True)
+            return
+        self.doc.commitTransaction()
+        self.last = ("fastener", hole, links)
+        self._say(tr("Put: {} (Ctrl+Z takes it back; changing the options above changes it)").format(
+            ", ".join(_count([i.label() for i in plan.items]))))
+
+    def _insert_into_hole(self):
+        if self.hole is None:
+            return
+        self._put_fastener(self.hole)
+        self.hole = None
+        self._update()
+
+    def _put_profile(self, a, b, normal):
+        what, key = self._current()
+        self.doc.openTransaction(tr("Put profile"))
+        try:
+            link = PS.put_profile(self.doc, key, a, b, normal, self._container())
+            self.doc.recompute()
+        except Exception as e:
+            self.doc.abortTransaction()
+            self._say(tr("Could not put it: {}").format(e), True)
+            return
+        self.doc.commitTransaction()
+        length = (b - a).Length
+        prefs = App.ParamGet("User parameter:BaseApp/Preferences/Mod/Unified/PartsShelf")
+        prefs.SetFloat("ProfileLength", length)
+        prefs.SetString("Profile", key)
+        self.last = ("profile", (a, b, normal), [link])
+        self._say(tr("Put: {}").format(link.LinkedObject.Label))
+
+    def _put_company(self, point, normal):
+        what, key = self._current()
+        part = self.company[key]
+        self.doc.openTransaction(tr("Put part"))
+        try:
+            QtWidgets.QApplication.setOverrideCursor(QtCore.Qt.WaitCursor)
+            original = PS.company_original(self.doc, part)
+            link = PS.place_link(self.doc, original, PS.placement_on_face(point, normal or App.Vector(0, 0, 1)),
+                                 self._container())
+            self.doc.recompute()
+        except Exception as e:
+            self.doc.abortTransaction()
+            self._say(tr("Could not put it: {}").format(e), True)
+            return
+        finally:
+            QtWidgets.QApplication.restoreOverrideCursor()
+        self.doc.commitTransaction()
+        self.last = ("company", None, [link])
+        self._say(tr("Put: {}").format(original.Label))
+
+    # ------------------------------------------------------------------ clicks
+    def _clicked(self, pick, point, kind, ctrl):
+        if self.closed:
+            return
+        what, key = self._current()
+        if what == "fastener":
+            if pick is None:
+                return
+            shape = pick.shape()
+            hole = analyze(shape, pick) if shape is not None and PS._axis_of(shape) is not None else None
+            if hole is None:
+                self._say(tr("That is not a hole for M3 to M12: click the round face or the edge of a hole"), True)
+                return
+            if self.hole is None:
+                self._suggest(hole)
+            self._put_fastener(hole)
+            self._update()
+        elif what == "profile":
+            normal = _face_normal(pick, point)
+            if self.first is None:
+                self.first = (App.Vector(point), normal)
+                if self.picker is not None:
+                    self.picker.plane_point = App.Vector(point)
+                    self.picker.plane_normal = App.Vector(normal) if normal is not None else App.Vector(0, 0, 1)
+                    self.picker.overlay.show_point("base", point, "vertex")
+                self._update()
+                return
+            a, n = self.first
+            b = App.Vector(point)
+            if (b - a).Length < 1e-6:
+                return
+            self._finish_profile(a, b, n)
+        elif what == "company":
+            self._put_company(App.Vector(point), _face_normal(pick, point))
+
+    def _finish_profile(self, a, b, n):
+        self.first = None
+        self._show_ghost(None)
+        if self.picker is not None:
+            self.picker.overlay.show_point("base", None)
+            self.picker.overlay.show_line(None, None)
+            self.picker.plane_point = App.Vector(0, 0, 0)
+            self.picker.plane_normal = App.Vector(0, 0, 1)
+        self._put_profile(a, b, n)
+        self._update()
+
+    def _hover(self, hit):
+        what, key = self._current()
+        if what != "profile" or self.first is None or self.picker is None:
+            return
+        if hit is None:
+            return
+        a = self.first[0]
+        b = App.Vector(hit[1])
+        self.picker.overlay.show_line(a, b)
+        length = (b - a).Length
+        self._hover_dir = (b - a) if length > 1e-9 else None
+        if length > 1e-6:
+            if not self.plength.hasFocus():
+                self.plength.blockSignals(True)
+                self.plength.setValue(length)
+                self.plength.blockSignals(False)
+            self._show_ghost((key, a, b, self.first[1]))
+            QtWidgets.QToolTip.showText(QtGui.QCursor.pos() + QtCore.QPoint(16, 8), "{:.1f} mm".format(length))
+
+    _hover_dir = None
+
+    def _typed_length(self):
+        what, key = self._current()
+        if what != "profile" or self.first is None or not self.plength.hasFocus():
+            return
+        a, n = self.first
+        d = App.Vector(self._hover_dir) if self._hover_dir is not None else App.Vector(1, 0, 0)
+        d.normalize()
+        self._finish_profile(a, a + d * self.plength.value(), n)
+
+    def _show_ghost(self, spec):
+        """A see-through profile from the first point to the cursor (one of unit length, scaled)"""
+        if self.picker is None:
+            return
+        coin = STG._coin()
+        ov = self.picker.overlay
+        if spec is None:
+            ov.clear_ghosts()
+            self._ghost = None
+            return
+        key, a, b, n = spec
+        if self._ghost is None or self._ghost[0] != key:
+            ov.clear_ghosts()
+            sep = coin.SoSeparator()
+            move = coin.SoTransform()
+            scale = coin.SoTransform()
+            look = coin.SoMaterial()
+            look.diffuseColor.setValue(1.0, 0.6, 0.1)
+            look.transparency.setValue(0.55)
+            sep.addChild(move)
+            sep.addChild(scale)
+            sep.addChild(look)
+            node = coin.SoDB.readAll(_inventor_input(PS.profile_shape(key, 1.0)))
+            if node is not None:
+                sep.addChild(node)
+            ov.ghosts.addChild(sep)
+            self._ghost = (key, move, scale)
+        _, move, scale = self._ghost
+        pl = PS.profile_placement(key, a, b, n)
+        STG._set_transform(move, pl)
+        scale.scaleFactor.setValue(1, 1, max((b - a).Length, 1e-3))
+        ov.ghost_switch.whichChild = 0
+
+    def _add_folder(self):
+        folder = QtWidgets.QFileDialog.getExistingDirectory(Gui.getMainWindow(), tr("Folder of the company's parts"))
+        if not folder:
+            return
+        folders = PS.company_folders()
+        if folder not in folders:
+            mine = [f for f in App.ParamGet("User parameter:BaseApp/Preferences/Mod/Unified/PartsShelf")
+                    .GetString("CompanyFolders", "").split(";") if f]
+            PS.set_company_folders(mine + [folder])
+        self._fill()
+        self._filter(self.search.text())
+
+    # ------------------------------------------------------------------ closing
+    def _finish(self):
+        self.closed = True
+        if self.picker is not None:
+            self.picker.remove()
+            self.picker = None
+
+    def accept(self):
+        self._finish()
+        Gui.Control.closeDialog()
+        return True
+
+    def reject(self):
+        self._finish()
+        Gui.Control.closeDialog()
+        return True
+
+    def _escape(self):
+        what, _ = self._current()
+        if what == "profile" and self.first is not None:
+            self.first = None
+            self._show_ghost(None)
+            if self.picker is not None:
+                self.picker.overlay.show_point("base", None)
+                self.picker.overlay.show_line(None, None)
+            self._update()
+            return
+        if not self.closed:
+            self.reject()
+
+
+def _inventor_input(shape):
+    coin = STG._coin()
+    data = shape.writeInventor()
+    inp = coin.SoInput()
+    inp.setBuffer(data)
+    return inp
+
+
+def _count(labels):
+    """["A", "B", "A"] → ["A ×2", "B"] in their first order"""
+    out, seen = [], {}
+    for l in labels:
+        seen[l] = seen.get(l, 0) + 1
+    for l in labels:
+        if l in seen:
+            n = seen.pop(l)
+            out.append(l if n == 1 else "{} ×{}".format(l, n))
+    return out
+
+
+def _prune_originals(doc):
+    """Originals no link uses any more go away (after "change")"""
+    used = {o.LinkedObject.Name for o in doc.Objects if o.isDerivedFrom("App::Link") and o.LinkedObject is not None}
+    for o in PS.originals(doc):
+        if o.Name not in used:
+            doc.removeObject(o.Name)
+
+
+def show(start=None, hole=None, query=""):
+    if Gui.Control.activeDialog():
+        Gui.Control.closeDialog()
+    panel = ShelfPanel(start, hole, query)
+    Gui.Control.showDialog(panel)
+    return panel
+
+
+def _recent_query():
+    """What was typed into the tool search, if it was used to open the shelf just now"""
+    try:
+        import CommandSearchGui
+
+        text, when = getattr(CommandSearchGui, "last_query", ("", 0))
+        if time.monotonic() - when < 3:
+            return text
+    except Exception:
+        pass
+    return ""
+
+
+# --------------------------------------------------------------------------- commands
+class _Command:
+    def IsActive(self):
+        return App.ActiveDocument is not None and STG._active_view() is not None and not Gui.Control.activeDialog()
+
+
+class PartsShelfCommand(_Command):
+    def GetResources(self):
+        return {
+            "Pixmap": os.path.join(HERE, "PartsShelf.svg"),
+            "MenuText": QT_TRANSLATE_NOOP("Unified_PartsShelf", "Parts Shelf"),
+            "ToolTip": QT_TRANSLATE_NOOP(
+                "Unified_PartsShelf",
+                "Screws, nuts and washers (JIS, M3–M12), aluminium profiles and the company's own parts: "
+                "click a hole and the screw that fits goes in",
+            ),
+        }
+
+    def Activated(self):
+        hole = _hole_cached()
+        query = _recent_query()
+        start = None
+        if query:
+            size, length, rest = PS.parse_query(query)
+            words = rest.split()
+            for k in PS.KINDS:
+                if words and PS.matches(k.key, words):
+                    start = ("fastener", k.key)
+                    break
+            if start is None and words and any(w.lower() in " ".join(PS.ALIASES["profile"]).lower() for w in words):
+                start = ("profile", PS.PROFILES[0].key)
+        show(start, hole, query)
+
+
+class InsertScrewCommand(_Command):
+    def GetResources(self):
+        return {
+            "Pixmap": os.path.join(HERE, "PartsShelf.svg"),
+            "MenuText": QT_TRANSLATE_NOOP("Unified_InsertScrew", "Insert Screw"),
+            "ToolTip": QT_TRANSLATE_NOOP(
+                "Unified_InsertScrew",
+                "A screw for the picked hole: the size from its diameter (tap drill or clearance hole), the length "
+                "from what it holds, on its axis",
+            ),
+        }
+
+    def IsActive(self):
+        if not _Command.IsActive(self):
+            return False
+        return _hole_cached() is not None
+
+    def Activated(self):
+        hole = _hole_cached()
+        if hole is None:
+            return
+        show(("fastener", PS.default_kind(hole)), hole)
+
+
+class PlaceProfileCommand(_Command):
+    def GetResources(self):
+        return {
+            "Pixmap": os.path.join(HERE, "Profile.svg"),
+            "MenuText": QT_TRANSLATE_NOOP("Unified_PlaceProfile", "Aluminium Profile"),
+            "ToolTip": QT_TRANSLATE_NOOP(
+                "Unified_PlaceProfile",
+                "A generic aluminium extrusion profile (20/30/40 series, slot 6/8) between two clicked points",
+            ),
+        }
+
+    def Activated(self):
+        key = App.ParamGet("User parameter:BaseApp/Preferences/Mod/Unified/PartsShelf").GetString("Profile", "20-6")
+        show(("profile", key if key in PS.PROFILE else "20-6"))
+
+
+for _name, _cmd in (
+    ("Unified_PartsShelf", PartsShelfCommand()),
+    ("Unified_InsertScrew", InsertScrewCommand()),
+    ("Unified_PlaceProfile", PlaceProfileCommand()),
+):
+    Gui.addCommand(_name, _cmd)
