From d52d1dc2c69dec69c044ebe6506bad0a1673835a Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Sun, 25 Oct 2026 02:06:00 +0900
Subject: [PATCH 343/398] Assembly: turned past 360 degrees, and a solve that
 does not hold says so

- "Turn to an angle" takes any angle (720 is two turns of a four-stroke
  cycle); it stopped at 360. A video turns the joint with its angle as a
  formula, so the formulas that use it (a valve's lift over 720 degrees)
  see the whole angle.
- A joint change whose solve does not hold says on the status bar which
  joints do not hold and how far: an engine stood still without a word
  because of one spring's joint (engine field test 0.7.7).

Test: FreeCADCmd -t TestMotionVideo, -t TestAssemblySolve

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/Mod/Assembly/JointObject.py               | 29 ++++++++++++++++++-
 .../translations/UnifiedWording_ja.ts         | 11 +++++++
 src/Mod/Unified/MotionVideo.py                | 10 +++----
 src/Mod/Unified/TestMotionVideo.py            | 22 ++++++++++++++
 4 files changed, 66 insertions(+), 6 deletions(-)

diff --git a/src/Mod/Assembly/JointObject.py b/src/Mod/Assembly/JointObject.py
index a98bf2082..af9537aa2 100644
--- a/src/Mod/Assembly/JointObject.py
+++ b/src/Mod/Assembly/JointObject.py
@@ -147,7 +147,31 @@ def solveIfAllowed(assembly, storePrev=False):
     if assembly.Type == "Assembly" and Preferences.preferences().GetBool(
         "SolveInJointCreation", True
     ):
-        assembly.solve(storePrev)
+        rc = assembly.solve(storePrev)
+        if rc != 0:
+            tellNotHeld(assembly)
+
+
+def tellNotHeld(assembly):
+    """Say on the status bar which joints do not hold: the parts stay where they were, and a
+    whole engine stood still without a word because of one spring's joint (engine field test
+    0.7.7)"""
+    if not App.GuiUp:
+        return
+    try:
+        broken = assembly.getBrokenJoints()
+    except Exception:
+        broken = []
+    if broken:
+        parts = ["{} ({:.2f} mm, {:.1f}°)".format(j.Label, gap, angle) for j, gap, angle in broken[:4]]
+        text = translate("Assembly", "The assembly did not move: these joints do not hold: {}").format(", ".join(parts))
+    else:
+        text = translate("Assembly", "The assembly did not move: its joints could not be solved")
+    try:
+        Gui.getMainWindow().statusBar().showMessage(text, 15000)
+    except Exception:
+        pass
+    App.Console.PrintWarning(text + "\n")
 
 
 def getContext(obj):
@@ -2050,6 +2074,9 @@ class TaskAssemblyCreateJoint(QtCore.QObject):
         self.driveAngleSpinbox = Gui.UiLoader().createWidget("Gui::QuantitySpinBox")
         self.driveAngleSpinbox.setObjectName("driveAngleSpinbox")
         self.driveAngleSpinbox.setProperty("unit", "deg")
+        # any angle: 720 is two turns (it stopped at 360; a four-stroke cycle is 720)
+        self.driveAngleSpinbox.setProperty("minimum", -1.0e6)
+        self.driveAngleSpinbox.setProperty("maximum", 1.0e6)
         self.driveAngleSpinbox.setSizePolicy(
             QtWidgets.QSizePolicy.Expanding, QtWidgets.QSizePolicy.Fixed
         )
