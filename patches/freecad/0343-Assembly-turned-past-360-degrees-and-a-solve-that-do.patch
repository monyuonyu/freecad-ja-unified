diff --git a/src/Mod/Unified/MotionVideo.py b/src/Mod/Unified/MotionVideo.py
index 23dd25f85..53aaea101 100644
--- a/src/Mod/Unified/MotionVideo.py
+++ b/src/Mod/Unified/MotionVideo.py
@@ -48,11 +48,10 @@ def formula(obj, prop):
 
 def pose(joint, angle):
     """Turn the joint to the angle and solve its assembly. False if it does not hold there."""
-    if formula(joint, "Angle"):
-        joint.setExpression("Angle", None)
-    # the angle property stops at +-360 degrees; a turned joint is the same a whole turn on
-    # (a 0 to 720 degree video stood still past 360; gears keep their timing over whole turns)
-    joint.Angle = math.fmod(angle, 360.0)
+    # As a formula: a value set from Python stops at +-360 degrees, a formula's does not, and the
+    # formulas that use this angle (a valve's lift over 720 degrees) see the whole angle (a 0 to
+    # 720 degree video stood still past 360; engine field test 0.7.7)
+    joint.setExpression("Angle", "%.12g deg" % angle)
     asm = assembly_of(joint)
     doc = joint.Document
     doc.recompute()
@@ -166,6 +165,7 @@ def export(joint, out, start=0.0, end=360.0, frames=72, fps=24, view="iso", size
         if was_formula:
             joint.setExpression("Angle", was_formula)
         else:
+            joint.setExpression("Angle", None)
             joint.Angle = was
         doc.recompute()
         asm = assembly_of(joint)
diff --git a/src/Mod/Unified/TestMotionVideo.py b/src/Mod/Unified/TestMotionVideo.py
index eb0890dd6..2283a38ff 100644
--- a/src/Mod/Unified/TestMotionVideo.py
+++ b/src/Mod/Unified/TestMotionVideo.py
@@ -17,6 +17,28 @@ class MotionVideoTest(unittest.TestCase):
         self.assertEqual(MotionVideo.angles(0, 360, 4), [0, 90, 180, 270])  # a whole turn: 360 left out
         self.assertEqual(MotionVideo.angles(0, 90, 4), [0, 30, 60, 90])
 
+    def test_past_a_whole_turn(self):
+        # 0 to 720 degrees: the angles past 360 are given as they are (it stood still past 360)
+        import TestAssemblySolve
+
+        doc, sheet, asm, piston, r, L = TestAssemblySolve.build(revolute_drive=True)
+        try:
+            asm.Type = "Assembly"
+            drive = doc.getObject("Drive")
+            seen = []
+
+            def draw(path):
+                from PIL import Image
+
+                seen.append(round(drive.Angle.Value, 6))
+                Image.new("RGB", (4, 4)).save(path)
+
+            MotionVideo.export(drive, os.path.join(tempfile.gettempdir(), "turns.gif"), 0, 720, 8, draw=draw)
+            self.assertEqual(seen, [0, 90, 180, 270, 360, 450, 540, 630])
+            self.assertIn("Params.theta", MotionVideo.formula(drive, "Angle"))
+        finally:
+            App.closeDocument(doc.Name)
+
     def test_crank(self):
         import TestAssemblySolve
 
