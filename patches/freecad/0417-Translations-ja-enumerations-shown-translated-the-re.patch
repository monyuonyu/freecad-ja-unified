+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""The words of an enumeration as they are shown in a combo box: translated, in the same order.
+What is kept in the object stays the enumeration's own word, so panels go by the index.
+"""
+
+import FreeCAD
+
+translate = FreeCAD.Qt.translate
+
+
+def shown(values):
