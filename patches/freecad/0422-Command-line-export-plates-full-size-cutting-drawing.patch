@@ -0,0 +1,82 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+# Full-size cutting drawings of the flat plates:
+#   FreeCADCmd -t TestPlateCut
+
+import json
+import os
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+import FreeCAD as App
+import Part
+
+import PlateCut
+
+V = App.Vector
+
+
+def tilted_plate():
+    """A 200 x 120 x 6 plate with a hole of 10 mm, a slot with round ends and a rounded corner,
+    turned and lifted: it must come out flat and the same size"""
+    s = Part.makeBox(200, 120, 6)
+    s = s.cut(Part.makeCylinder(5, 10, V(30, 30, -2)))
+    slot = Part.makeBox(40, 8, 10, V(100, 56, -2)).fuse([Part.makeCylinder(4, 10, V(100, 60, -2)),
+                                                          Part.makeCylinder(4, 10, V(140, 60, -2))]).removeSplitter()
+    s = s.cut(slot)
+    corner = [e for e in s.Edges if all(abs(v.Point.x - 200) < 1e-6 and abs(v.Point.y - 120) < 1e-6 for v in e.Vertexes)]
+    s = s.makeFillet(10, corner)
+    s.rotate(V(0, 0, 0), V(1, 1, 0), 35)
+    s.translate(V(500, 200, 300))
+    return s
+
+
+class PlateCutTest(unittest.TestCase):
+    def setUp(self):
+        self.doc = App.newDocument("platecut")
+        self.tmp = tempfile.mkdtemp()
+
+    def tearDown(self):
+        App.closeDocument(self.doc.Name)
+        shutil.rmtree(self.tmp)
+
+    def test_plates_found_and_laid_flat(self):
+        self.doc.addObject("Part::Feature", "Plate").Shape = tilted_plate()
+        self.doc.addObject("Part::Feature", "Block").Shape = Part.makeBox(50, 50, 50, V(0, 0, 400))  # not thin
+        self.doc.addObject("Part::Feature", "Rod").Shape = Part.makeCylinder(5, 100, V(0, 300, 0))  # no flat pair
+        self.doc.recompute()
+        found = PlateCut.plates(self.doc)
+        self.assertEqual([p.name for p in found], ["Plate"])
+        p = found[0]
+        self.assertAlmostEqual(p.thickness, 6, places=6)
+        bb = p.flat.BoundBox
+        self.assertAlmostEqual(bb.ZLength, 0, places=6)
+        self.assertEqual(sorted((round(bb.XLength, 3), round(bb.YLength, 3))), [120, 200])
+        self.assertEqual(p.summary()["holes"], 2)
+
+    def test_files_written(self):
+        self.doc.addObject("Part::Feature", "Plate").Shape = tilted_plate()
+        self.doc.recompute()
+        found = PlateCut.export(self.doc, self.tmp)
+        self.assertEqual(found[0]["files"], ["Plate.dxf", "Plate.svg"])
+        dxf = open(os.path.join(self.tmp, "Plate.dxf"), encoding="ascii").read().split()
+        self.assertEqual(dxf.count("CIRCLE"), 1)  # the hole
+        self.assertGreaterEqual(dxf.count("ARC"), 3)  # the slot's ends and the corner
+        svg = open(os.path.join(self.tmp, "Plate.svg"), encoding="utf-8").read()
+        self.assertIn('width="220.000mm"', svg.replace('"140.000mm"', ""))  # 1:1 with a 10 mm margin
+        data = json.load(open(os.path.join(self.tmp, "plates.json"), encoding="utf-8"))
+        self.assertEqual(data["plates"][0]["thickness"], 6)
+
+    def test_command_line(self):
+        import DrawingPdf
+
+        self.doc.addObject("Part::Feature", "Plate").Shape = tilted_plate()
+        self.doc.recompute()
+        path = os.path.join(self.tmp, "m.FCStd")
+        self.doc.saveAs(path)
+        out = os.path.join(self.tmp, "cut")
+        proc = subprocess.run([DrawingPdf._freecadcmd(), path, "--export-plates", out], capture_output=True,
+                              timeout=300, stdin=subprocess.DEVNULL)  # fmt: skip
+        self.assertEqual(proc.returncode, 0, proc.stderr.decode("utf-8", "replace"))
+        self.assertEqual(sorted(os.listdir(out)), ["Plate.dxf", "Plate.svg", "plates.json"])
