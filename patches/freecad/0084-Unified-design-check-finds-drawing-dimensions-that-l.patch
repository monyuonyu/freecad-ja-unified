+ 'Ignore a design check problem': '設計の検査の指摘を無視'}
 
 ERROR, WARNING, INFO = "error", "warning", "info"
 
@@ -85,6 +93,8 @@ RULES = {
     "tiny_edge": QT_TRANSLATE_NOOP("DesignCheck", "Very short edges"),
     "sketch_free": QT_TRANSLATE_NOOP("DesignCheck", "Sketch not fully constrained"),
     "floating": QT_TRANSLATE_NOOP("DesignCheck", "Part touches no other part"),
+    "drawing_dim": QT_TRANSLATE_NOOP("DesignCheck", "Drawing dimension lost its geometry"),
+    "drawing_view": QT_TRANSLATE_NOOP("DesignCheck", "Drawing view shows nothing"),
 }
 
 
@@ -286,6 +296,28 @@ def iter_interference(doc, issues, opt, shapes):
                                     [n], shapes[n].BoundBox.Center))
 
 
+def check_drawings(doc, issues, opt):
+    """図面: 形を変えたあと、寸法が指す辺や点を見失っていないか。元の部品を消した投影図が無いか"""
+    for o in doc.Objects:
+        if o.isDerivedFrom("TechDraw::DrawViewDimension") and hasattr(o, "getReferenceState"):
+            try:
+                state = o.getReferenceState()
+            except Exception:
+                continue
+            if state == "broken":
+                issues.append(Issue(ERROR, "drawing_dim",
+                                    translate("DesignCheck", "{0}: the edge or point it measures is gone "
+                                              "(the value may be wrong; pick the geometry again)").format(o.Label),
+                                    [o.Name]))
+        elif (o.isDerivedFrom("TechDraw::DrawViewPart") and not o.isDerivedFrom("TechDraw::DrawProjGroupItem")) \
+                or o.isDerivedFrom("TechDraw::DrawProjGroup"):
+            src = list(getattr(o, "Source", [])) + list(getattr(o, "XSource", []))
+            if not src:
+                issues.append(Issue(WARNING, "drawing_view",
+                                    translate("DesignCheck", "{0}: the part it shows was deleted").format(o.Label),
+                                    [o.Name]))
+
+
 def check_sketches(doc, issues, opt):
     for o in doc.Objects:
         if not o.isDerivedFrom("Sketcher::SketchObject"):
@@ -362,6 +394,7 @@ def iter_run(doc=None, **options):
     check_features(doc, issues, opt)
     check_shapes(doc, issues, opt, shapes)
     check_sketches(doc, issues, opt)
+    check_drawings(doc, issues, opt)
     yield None
     yield from iter_interference(doc, issues, opt, shapes)
     kept = [i for i in issues if not _is_ignored(doc, i)]
