@@ -27,6 +27,7 @@
 #include <Base/VectorPy.h>
 
 #include "DrawViewDimension.h"
+#include "DrawViewPart.h"
 // inclusion of the generated files (generated out of DrawViewDimensionPy.xml)
 #include <Mod/TechDraw/App/DrawViewDimensionPy.h>
 #include <Mod/TechDraw/App/DrawViewDimensionPy.cpp>
@@ -65,6 +66,28 @@ PyObject* DrawViewDimensionPy::getText(PyObject* args)
     return pyText;
 }
 
+PyObject* DrawViewDimensionPy::getReferenceState(PyObject* args)
+{
+    if (!PyArg_ParseTuple(args, "")) {
+        return nullptr;
+    }
+
+    DrawViewDimension* dvd = getDrawViewDimensionPtr();
+    const char* state = "ok";
+    DrawViewPart* dvp = dvd->getViewPart();
+    if (dvd->hasBroken3dReferences()) {
+        state = "broken";
+    }
+    else if (!dvp || dvp->waitingForResult() || !dvp->hasGeometry()) {
+        state = "unknown";
+    }
+    else if (!dvd->hasGoodReferences()
+             || (dvd->References3D.getValues().empty() && !dvd->checkReferences2D())) {
+        state = "broken";
+    }
+    return Py::new_reference_to(Py::String(state));
+}
