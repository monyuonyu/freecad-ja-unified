--- /dev/null
+++ b/src/Mod/Part/parttests/TestPartViews.py
@@ -0,0 +1,95 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+
+"""Tests of the headless views and checks of the Part module (PartViews)."""
+
+import os
+import struct
+import tempfile
+import unittest
+import zlib
+
+import FreeCAD as App
+import Part
+
+
+def read_png(path):
+    """(width, height, rows of (r, g, b)) of an 8 bit RGB PNG without filters (as written)."""
+    with open(path, "rb") as f:
+        data = f.read()
+    assert data[:8] == b"\x89PNG\r\n\x1a\n"
+    pos, idat, w, h = 8, b"", 0, 0
+    while pos < len(data):
+        (length,) = struct.unpack(">I", data[pos : pos + 4])
+        kind = data[pos + 4 : pos + 8]
+        body = data[pos + 8 : pos + 8 + length]
+        if kind == b"IHDR":
+            w, h = struct.unpack(">II", body[:8])
+        elif kind == b"IDAT":
+            idat += body
+        pos += 12 + length
+    raw = zlib.decompress(idat)
+    rows = []
+    stride = w * 3 + 1
+    for y in range(h):
+        line = raw[y * stride + 1 : (y + 1) * stride]
+        rows.append([tuple(line[i : i + 3]) for i in range(0, len(line), 3)])
+    return w, h, rows
+
+
+class TestPartViews(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.mkdtemp()
+
+    def tearDown(self):
+        for name in os.listdir(self.tmp):
+            os.remove(os.path.join(self.tmp, name))
+        os.rmdir(self.tmp)
+
+    def _render(self, shapes, **kw):
+        path = os.path.join(self.tmp, "out.png")
+        Part.renderImage(shapes, path, **kw)
+        return read_png(path)
+
+    def testRenderShaded(self):
+        box = Part.makeBox(30, 20, 10)
+        cyl = Part.makeCylinder(5, 20, App.Vector(40, 10, 0))
+        w, h, rows = self._render([box, cyl], width=200, height=150)
+        self.assertEqual((w, h), (200, 150))
+        pixels = [p for row in rows for p in row]
+        white = sum(1 for p in pixels if p == (255, 255, 255))
+        dark = sum(1 for p in pixels if max(p) < 80)
+        shaded = len(pixels) - white - dark
+        self.assertGreater(shaded, len(pixels) * 0.15)  # the parts fill the picture
+        self.assertGreater(dark, 100)  # edges are drawn
+        self.assertGreater(white, len(pixels) * 0.2)  # background stays
+        # different faces of the box get different shades
+        tones = {p for p in pixels if max(p) >= 80 and p != (255, 255, 255)}
+        self.assertGreater(len(tones), 3)
+
+    def testRenderStyles(self):
+        box = Part.makeBox(10, 10, 10)
+        for style in ("hidden-lines", "lines", "shaded-only"):
+            w, h, rows = self._render(box, width=120, height=90, style=style)
+            pixels = [p for row in rows for p in row]
+            dark = sum(1 for p in pixels if max(p) < 100)
+            if style == "shaded-only":
+                self.assertEqual(sum(1 for p in pixels if max(p) < 40), 0)  # no lines
+            else:
+                self.assertGreater(dark, 60, style)
+            colored = sum(1 for p in pixels if p[0] != p[1] or p[1] != p[2])
+            if style != "shaded-only":
+                self.assertEqual(colored, 0, style)  # black and white only
+        with self.assertRaises(ValueError):
+            self._render(box, style="nonsense")
+        with self.assertRaises(ValueError):
+            self._render(box, view="nonsense")
+
+    def testRenderMesh(self):
+        points, facets = Part.makeBox(10, 10, 10).tessellate(0.1)
+        w, h, rows = self._render((points, facets), width=100, height=100, view="1,1,-1")
+        dark = sum(1 for row in rows for p in row if max(p) < 80)
+        self.assertGreater(dark, 50)  # crease edges of the mesh
+
+
+if __name__ == "__main__":
+    unittest.main()
