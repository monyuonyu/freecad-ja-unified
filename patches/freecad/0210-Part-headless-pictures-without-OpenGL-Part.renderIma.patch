+namespace
+{
+
+// ------------------------------------------------------------------ scene
+
+struct SFace
+{
+    int item = 0;
+    int face = 0;
+    Color color {};
+    bool solid = false;  // belongs to a closed solid: faces turned away are never seen
+    bool planar = false;
+    int smooth = 0;  // faces with the same key meet without a visible edge (mesh patches)
+    std::vector<gp_Pnt> p;
+    std::vector<gp_Vec> n;  // smooth vertex normals (outward)
+    std::vector<std::array<int, 3>> t;
+};
+
+struct SEdge
+{
+    int item = 0;
+    int kind = 0;  // 0 sharp, 2 smooth
+    std::vector<gp_Pnt> p;
+};
+
+// Inner edge of a curved face or a mesh: becomes a silhouette when one side faces the
+// viewer and the other does not
+struct SoftEdge
+{
+    int item = 0;
+    gp_Pnt a, b;
+    gp_Vec na, nb;
+};
+
+struct Scene
+{
+    std::vector<SFace> faces;
+    std::vector<SEdge> edges;
+    std::vector<SoftEdge> soft;
+    Bnd_Box box;
+    double deflection = 0;
+    int smoothKeys = 0;
+};
+
+gp_Vec triNormal(const gp_Pnt& a, const gp_Pnt& b, const gp_Pnt& c)
+{
+    return gp_Vec(a, b).Crossed(gp_Vec(a, c));
+}
+
+double sceneDeflection(const std::vector<SceneItem>& items, double requested, Bnd_Box& box)
+{
+    for (const auto& item : items) {
+        if (!item.shape.IsNull()) {
+            BRepBndLib::Add(item.shape, box);
+        }
+        for (const auto& p : item.meshPoints) {
+            box.Add(p);
+        }
+    }
+    if (requested > 0) {
+        return requested;
+    }
+    if (box.IsVoid()) {
+        return 0.1;
+    }
+    double diag = std::sqrt(box.SquareExtent());
+    return std::max(diag * 0.0008, 1e-4);
+}
+
+void addShape(Scene& scene, int itemIndex, const SceneItem& item)
+{
+    const TopoDS_Shape& shape = item.shape;
+    BRepMesh_IncrementalMesh(shape, scene.deflection, Standard_False, 0.35, Standard_True);
+
+    // faces inside closed solids
+    TopTools_IndexedMapOfShape solidFaces;
+    for (TopExp_Explorer xs(shape, TopAbs_SOLID); xs.More(); xs.Next()) {
+        TopExp::MapShapes(xs.Current(), TopAbs_FACE, solidFaces);
+    }
+
+    TopTools_IndexedMapOfShape faceMap;
+    TopExp::MapShapes(shape, TopAbs_FACE, faceMap);
+    for (int i = 1; i <= faceMap.Extent(); ++i) {
+        const TopoDS_Face& face = TopoDS::Face(faceMap(i));
+        std::vector<gp_Pnt> points;
+        std::vector<Poly_Triangle> facets;
+        if (!Part::Tools::getTriangulation(face, points, facets) || facets.empty()) {
+            continue;
+        }
+        SFace sf;
+        sf.item = itemIndex;
+        sf.face = i - 1;
+        sf.color = item.color;
+        sf.solid = solidFaces.Contains(face);
+        sf.smooth = scene.smoothKeys++;
+        BRepAdaptor_Surface surf(face, Standard_False);
+        sf.planar = surf.GetType() == GeomAbs_Plane;
+        Part::Tools::getPointNormals(points, facets, sf.n);
+        sf.p = std::move(points);
+        sf.t.reserve(facets.size());
+        for (const auto& f : facets) {
+            int n1 {}, n2 {}, n3 {};
+            f.Get(n1, n2, n3);
+            sf.t.push_back({n1, n2, n3});
+        }
+        if (!sf.planar) {
+            // inner mesh edges for silhouettes
+            std::map<std::pair<int, int>, std::pair<int, int>> em;  // edge -> (tri, tri)
+            for (int k = 0; k < (int)sf.t.size(); ++k) {
+                for (int e = 0; e < 3; ++e) {
+                    int u = sf.t[k][e];
+                    int v = sf.t[k][(e + 1) % 3];
+                    auto key = std::make_pair(std::min(u, v), std::max(u, v));
+                    auto it = em.find(key);
+                    if (it == em.end()) {
+                        em.emplace(key, std::make_pair(k, -1));
+                    }
+                    else {
+                        it->second.second = k;
+                    }
+                }
+            }
+            for (const auto& [key, tris] : em) {
+                if (tris.second < 0) {
+                    continue;
+                }
+                const auto& t1 = sf.t[tris.first];
+                const auto& t2 = sf.t[tris.second];
+                gp_Vec n1 = triNormal(sf.p[t1[0]], sf.p[t1[1]], sf.p[t1[2]]);
+                gp_Vec n2 = triNormal(sf.p[t2[0]], sf.p[t2[1]], sf.p[t2[2]]);
+                if (n1.SquareMagnitude() < 1e-30 || n2.SquareMagnitude() < 1e-30) {
+                    continue;
+                }
+                scene.soft.push_back({itemIndex, sf.p[key.first], sf.p[key.second], n1, n2});
+            }
+        }
+        scene.faces.push_back(std::move(sf));
+    }
+
+    // edges
+    TopTools_IndexedDataMapOfShapeListOfShape edgeFaces;
+    TopExp::MapShapesAndAncestors(shape, TopAbs_EDGE, TopAbs_FACE, edgeFaces);
+    for (int i = 1; i <= edgeFaces.Extent(); ++i) {
+        const TopoDS_Edge& edge = TopoDS::Edge(edgeFaces.FindKey(i));
+        if (BRep_Tool::Degenerated(edge)) {
+            continue;
+        }
+        const TopTools_ListOfShape& faces = edgeFaces(i);
+        SEdge se;
+        se.item = itemIndex;
+        bool seam = false;
+        std::vector<TopoDS_Face> uniqueFaces;
+        for (const auto& f : faces) {
+            const TopoDS_Face& face = TopoDS::Face(f);
+            if (BRep_Tool::IsClosed(edge, face)) {
+                seam = true;
+            }
+            bool known = false;
+            for (const auto& u : uniqueFaces) {
+                known = known || u.IsSame(face);
+            }
+            if (!known) {
+                uniqueFaces.push_back(face);
+            }
+        }
+        if (seam && uniqueFaces.size() <= 1) {
+            continue;  // seam of a cylinder etc.
+        }
+        if (uniqueFaces.size() == 2) {
+            try {
+                if (BRep_Tool::Continuity(edge, uniqueFaces[0], uniqueFaces[1]) >= GeomAbs_G1) {
+                    se.kind = 2;
+                }
+            }
+            catch (const Standard_Failure&) {
+            }
+        }
+        bool ok = false;
+        if (!uniqueFaces.empty()) {
+            ok = Part::Tools::getPolygonOnTriangulation(edge, uniqueFaces.front(), se.p);
+        }
+        if (!ok || se.p.size() < 2) {
+            se.p.clear();
+            try {
+                BRepAdaptor_Curve curve(edge);
+                GCPnts_TangentialDeflection disc(
+                    curve,
+                    curve.FirstParameter(),
+                    curve.LastParameter(),
+                    0.35,
+                    scene.deflection
+                );
+                for (int k = 1; k <= disc.NbPoints(); ++k) {
+                    se.p.push_back(disc.Value(k));
+                }
+            }
+            catch (const Standard_Failure&) {
+                continue;
+            }
+        }
+        if (se.p.size() >= 2) {
+            scene.edges.push_back(std::move(se));
+        }
+    }
+}
+
+void addMesh(Scene& scene, int itemIndex, const SceneItem& item)
+{
+    // A mesh has no faces: smooth patches (neighbours within 30 degrees) play their part.
+    // A patch whose triangles are coplanar is planar, others are handled per triangle
+    // for hidden line removal and merged again for the output.
+    const auto& P = item.meshPoints;
+    std::vector<std::array<int, 3>> tris;
+    std::vector<gp_Vec> tn;  // unit normals
+    std::vector<gp_Vec> ta;  // area weighted normals
+    for (const auto& f : item.meshFacets) {
+        if (f[0] < 0 || f[1] < 0 || f[2] < 0 || f[0] >= (int)P.size() || f[1] >= (int)P.size()
+            || f[2] >= (int)P.size()) {
+            continue;
+        }
+        gp_Vec n = triNormal(P[f[0]], P[f[1]], P[f[2]]);
+        if (n.SquareMagnitude() < 1e-30) {
+            continue;
+        }
+        tris.push_back(f);
+        ta.push_back(n);
+        tn.push_back(n.Normalized());
+    }
+    std::map<std::pair<int, int>, std::vector<int>> em;
+    for (int k = 0; k < (int)tris.size(); ++k) {
+        for (int e = 0; e < 3; ++e) {
+            int u = tris[k][e];
+            int v = tris[k][(e + 1) % 3];
+            em[std::make_pair(std::min(u, v), std::max(u, v))].push_back(k);
+        }
+    }
+    bool closed = !em.empty();
+    for (const auto& [key, list] : em) {
+        if (list.size() != 2) {
+            closed = false;
+            break;
+        }
+    }
+    const double coplanar = std::cos(0.5 * M_PI / 180.0);
+    const double crease = std::cos(30.0 * M_PI / 180.0);
+    std::vector<std::vector<int>> neighbours(tris.size());
+    for (const auto& [key, list] : em) {
+        if (list.size() == 2 && tn[list[0]].Dot(tn[list[1]]) >= crease) {
+            neighbours[list[0]].push_back(list[1]);
+            neighbours[list[1]].push_back(list[0]);
+        }
+    }
+    // smooth components (no crease inside) ...
+    std::vector<int> component(tris.size(), -1);
+    int components = 0;
+    for (int k = 0; k < (int)tris.size(); ++k) {
+        if (component[k] >= 0) {
+            continue;
+        }
+        std::vector<int> stack {k};
+        component[k] = components;
+        while (!stack.empty()) {
+            int c = stack.back();
+            stack.pop_back();
+            for (int nb : neighbours[c]) {
+                if (component[nb] < 0) {
+                    component[nb] = components;
+                    stack.push_back(nb);
+                }
+            }
+        }
+        ++components;
+    }
+    // ... split into patches that stay within 15 degrees of their first triangle, so that
+    // the flat sides of a rounded box get their own tone
+    const double patchAngle = std::cos(15.0 * M_PI / 180.0);
+    std::vector<int> group(tris.size(), -1);
+    std::vector<int> groupComponent;
+    int groups = 0;
+    for (int k = 0; k < (int)tris.size(); ++k) {
+        if (group[k] >= 0) {
+            continue;
+        }
+        const gp_Vec seed = tn[k];
+        std::vector<int> stack {k};
+        group[k] = groups;
+        while (!stack.empty()) {
+            int c = stack.back();
+            stack.pop_back();
+            for (int nb : neighbours[c]) {
+                if (group[nb] < 0 && tn[nb].Dot(seed) >= patchAngle) {
+                    group[nb] = groups;
+                    stack.push_back(nb);
+                }
+            }
+        }
+        groupComponent.push_back(component[k]);
+        ++groups;
+    }
+    std::vector<SFace> faces(groups);
+    std::vector<std::unordered_map<int, int>> remap(groups);
+    std::vector<gp_Vec> firstNormal(groups);
+    std::vector<bool> planar(groups, true);
+    for (int k = 0; k < (int)tris.size(); ++k) {
+        const int g = group[k];
+        SFace& sf = faces[g];
+        if (sf.t.empty()) {
+            firstNormal[g] = tn[k];
+        }
+        else if (planar[g] && tn[k].Dot(firstNormal[g]) < coplanar) {
+            planar[g] = false;
+        }
+        std::array<int, 3> t {};
+        for (int e = 0; e < 3; ++e) {
+            int src = tris[k][e];
+            auto it = remap[g].find(src);
+            if (it == remap[g].end()) {
+                it = remap[g].emplace(src, (int)sf.p.size()).first;
+                sf.p.push_back(P[src]);
+                sf.n.emplace_back(0, 0, 0);
+            }
+            t[e] = it->second;
+            sf.n[t[e]] += ta[k];  // smooth vertex normals inside the patch
+        }
+        sf.t.push_back(t);
+    }
+    for (int g = 0; g < groups; ++g) {
+        for (auto& n : faces[g].n) {
+            if (n.SquareMagnitude() > 1e-30) {
+                n.Normalize();
+            }
+        }
+        faces[g].item = itemIndex;
+        faces[g].face = g;
+        faces[g].color = item.color;
+        faces[g].solid = closed;
+        faces[g].planar = planar[g];
+        faces[g].smooth = scene.smoothKeys + groupComponent[g];
+        scene.faces.push_back(std::move(faces[g]));
+    }
+    scene.smoothKeys += components;
+    for (const auto& [key, list] : em) {
+        if (list.size() == 2 && component[list[0]] == component[list[1]]) {
+            // no crease: may become a silhouette
+            if (group[list[0]] != group[list[1]] || !planar[group[list[0]]]) {
+                scene.soft.push_back({itemIndex, P[key.first], P[key.second], ta[list[0]], ta[list[1]]});
+            }
+            continue;
+        }
+        // open border, crease or non-manifold edge
+        scene.edges.push_back({itemIndex, 0, {P[key.first], P[key.second]}});
+    }
+}
+
+Scene buildScene(const std::vector<SceneItem>& items, double deflection)
+{
+    Scene scene;
+    scene.deflection = sceneDeflection(items, deflection, scene.box);
+    for (int i = 0; i < (int)items.size(); ++i) {
+        if (!items[i].shape.IsNull()) {
+            addShape(scene, i, items[i]);
+        }
+        else if (!items[i].meshFacets.empty()) {
+            addMesh(scene, i, items[i]);
+        }
+    }
+    return scene;
+}
+
+// Simple two light setup in camera space, n is a unit normal facing the viewer
+double shadeOf(const Camera& cam, const gp_Vec& n)
+{
+    double nx = n.XYZ().Dot(cam.right.XYZ());
+    double ny = n.XYZ().Dot(cam.up.XYZ());
+    double nz = -n.XYZ().Dot(cam.dir.XYZ());
+    if (nz < 0) {
+        nx = -nx;
+        ny = -ny;
+        nz = -nz;
+    }
+    // key light from upper left, fill from the eye
+    const double kx = -0.40, ky = 0.62, kz = 0.68;
+    double key = std::max(0.0, nx * kx + ny * ky + nz * kz);
+    double s = 0.30 + 0.52 * key + 0.22 * nz;
+    return std::min(1.0, s);
+}
+
+// ------------------------------------------------------------------ raster
+
+struct Raster
+{
+    int w = 0, h = 0;
+    std::vector<float> depth;
+    std::vector<int> id;
+    std::vector<float> shade;
+    std::vector<std::int8_t> nrm;  // 3 per pixel, for creases
+
+    void init(int width, int height)
+    {
+        w = width;
+        h = height;
+        depth.assign((size_t)w * h, std::numeric_limits<float>::infinity());
+        id.assign((size_t)w * h, -1);
+        shade.assign((size_t)w * h, 1.0F);
+        nrm.assign((size_t)w * h * 3, 0);
+    }
+};
+
+struct Fit
+{
+    double cx = 0, cy = 0, scale = 1;
+    double W = 0, H = 0;
+    void toScreen(double x, double y, double& sx, double& sy) const
+    {
+        sx = (x - cx) * scale + W * 0.5;
+        sy = H * 0.5 - (y - cy) * scale;
+    }
+};
+
+Fit fitView(const Scene& scene, const Camera& cam, int W, int H, double margin)
+{
+    double xmin = 1e300, xmax = -1e300, ymin = 1e300, ymax = -1e300;
+    auto add = [&](const gp_Pnt& p) {
+        double x {}, y {}, d {};
+        cam.project(p, x, y, d);
+        xmin = std::min(xmin, x);
+        xmax = std::max(xmax, x);
+        ymin = std::min(ymin, y);
+        ymax = std::max(ymax, y);
+    };
+    for (const auto& f : scene.faces) {
+        for (const auto& p : f.p) {
+            add(p);
+        }
+    }
+    for (const auto& e : scene.edges) {
+        for (const auto& p : e.p) {
+            add(p);
+        }
+    }
+    Fit fit;
+    fit.W = W;
+    fit.H = H;
+    if (xmin > xmax) {
+        return fit;
+    }
+    double bw = std::max(xmax - xmin, 1e-9);
+    double bh = std::max(ymax - ymin, 1e-9);
+    double avW = W * (1 - 2 * margin);
+    double avH = H * (1 - 2 * margin);
+    fit.scale = std::min(avW / bw, avH / bh);
+    fit.cx = (xmin + xmax) / 2;
+    fit.cy = (ymin + ymax) / 2;
+    return fit;
+}
+
+void rasterize(Raster& R, const Scene& scene, const Camera& cam, const Fit& fit)
+{
+    for (int fi = 0; fi < (int)scene.faces.size(); ++fi) {
+        const SFace& f = scene.faces[fi];
+        std::vector<double> sx(f.p.size()), sy(f.p.size()), sd(f.p.size());
+        for (size_t k = 0; k < f.p.size(); ++k) {
+            double x {}, y {}, d {};
+            cam.project(f.p[k], x, y, d);
+            fit.toScreen(x, y, sx[k], sy[k]);
+            sd[k] = d;
+        }
+        for (const auto& t : f.t) {
+            const int a = t[0], b = t[1], c = t[2];
+            double area = (sx[b] - sx[a]) * (sy[c] - sy[a]) - (sx[c] - sx[a]) * (sy[b] - sy[a]);
+            if (std::fabs(area) < 1e-12) {
+                continue;
+            }
+            int x0 = std::max(0, (int)std::floor(std::min({sx[a], sx[b], sx[c]})));
+            int x1 = std::min(R.w - 1, (int)std::ceil(std::max({sx[a], sx[b], sx[c]})));
+            int y0 = std::max(0, (int)std::floor(std::min({sy[a], sy[b], sy[c]})));
+            int y1 = std::min(R.h - 1, (int)std::ceil(std::max({sy[a], sy[b], sy[c]})));
+            if (x0 > x1 || y0 > y1) {
+                continue;
+            }
+            // triangle normal (geometric) and smooth normals
+            gp_Vec tnorm = triNormal(f.p[a], f.p[b], f.p[c]);
+            const gp_Vec& na = f.n.empty() ? tnorm : f.n[a];
+            const gp_Vec& nb = f.n.empty() ? tnorm : f.n[b];
+            const gp_Vec& nc = f.n.empty() ? tnorm : f.n[c];
+            const double inv = 1.0 / area;
+            for (int py = y0; py <= y1; ++py) {
+                const double cyp = py + 0.5;
+                for (int px = x0; px <= x1; ++px) {
+                    const double cxp = px + 0.5;
+                    double w0 = ((sx[b] - cxp) * (sy[c] - cyp) - (sx[c] - cxp) * (sy[b] - cyp)) * inv;
+                    double w1 = ((sx[c] - cxp) * (sy[a] - cyp) - (sx[a] - cxp) * (sy[c] - cyp)) * inv;
+                    double w2 = 1.0 - w0 - w1;
+                    if (w0 < -1e-9 || w1 < -1e-9 || w2 < -1e-9) {
+                        continue;
+                    }
+                    double d = w0 * sd[a] + w1 * sd[b] + w2 * sd[c];
+                    size_t idx = (size_t)py * R.w + px;
+                    if (d >= R.depth[idx]) {
+                        continue;
+                    }
+                    R.depth[idx] = (float)d;
+                    R.id[idx] = fi;
+                    gp_Vec n = na * w0 + nb * w1 + nc * w2;
+                    if (n.SquareMagnitude() < 1e-30) {
+                        n = tnorm;
+                    }
+                    n.Normalize();
+                    // face the viewer (two sided)
+                    if (n.Dot(gp_Vec(cam.dir)) > 0) {
+                        n.Reverse();
+                    }
+                    R.shade[idx] = (float)shadeOf(cam, n);
+                    R.nrm[idx * 3] = (std::int8_t)std::lround(n.X() * 127);
+                    R.nrm[idx * 3 + 1] = (std::int8_t)std::lround(n.Y() * 127);
+                    R.nrm[idx * 3 + 2] = (std::int8_t)std::lround(n.Z() * 127);
+                }
+            }
+        }
+    }
+}
+
+void dilate(std::vector<std::uint8_t>& mask, int w, int h, int radius)
+{
+    if (radius <= 0) {
+        return;
+    }
+    std::vector<std::uint8_t> out(mask.size(), 0);
+    for (int y = 0; y < h; ++y) {
+        for (int x = 0; x < w; ++x) {
+            if (!mask[(size_t)y * w + x]) {
+                continue;
+            }
+            for (int dy = -radius; dy <= radius; ++dy) {
+                for (int dx = -radius; dx <= radius; ++dx) {
+                    if (dx * dx + dy * dy > radius * radius + radius) {
+                        continue;
+                    }
+                    int xx = x + dx, yy = y + dy;
+                    if (xx >= 0 && yy >= 0 && xx < w && yy < h) {
+                        out[(size_t)yy * w + xx] = 1;
+                    }
+                }
+            }
+        }
+    }
+    mask.swap(out);
+}
+
+void drawSegment(std::vector<std::uint8_t>& mask, int w, int h, double x0, double y0, double x1, double y1)
+{
+    double len = std::hypot(x1 - x0, y1 - y0);
+    int steps = std::max(1, (int)std::ceil(len * 2));
+    for (int i = 0; i <= steps; ++i) {
+        double t = (double)i / steps;
+        int x = (int)std::floor(x0 + (x1 - x0) * t);
+        int y = (int)std::floor(y0 + (y1 - y0) * t);
+        if (x >= 0 && y >= 0 && x < w && y < h) {
+            mask[(size_t)y * w + x] = 1;
+        }
+    }
+}
+
+std::uint32_t crcOf(const std::string& type, const std::vector<std::uint8_t>& data)
+{
+    uLong crc = crc32(0L, Z_NULL, 0);
+    crc = crc32(crc, reinterpret_cast<const Bytef*>(type.data()), (uInt)type.size());
+    if (!data.empty()) {
+        crc = crc32(crc, data.data(), (uInt)data.size());
+    }
+    return (std::uint32_t)crc;
+}
+
+void putChunk(std::ostream& out, const std::string& type, const std::vector<std::uint8_t>& data)
+{
+    auto be32 = [&out](std::uint32_t v) {
+        char b[4] = {(char)(v >> 24), (char)(v >> 16), (char)(v >> 8), (char)v};
+        out.write(b, 4);
+    };
+    be32((std::uint32_t)data.size());
+    out.write(type.data(), 4);
+    if (!data.empty()) {
+        out.write(reinterpret_cast<const char*>(data.data()), (std::streamsize)data.size());
+    }
+    be32(crcOf(type, data));
+}
+
+}  // namespace
+
+// ------------------------------------------------------------------ camera
+
+Camera Camera::fromDirection(const gp_Vec& d)
+{
+    if (d.Magnitude() < 1e-12) {
+        throw Base::ValueError("View direction must not be zero");
+    }
+    Camera cam;
+    cam.dir = gp_Dir(d);
+    gp_Vec up(0, 0, 1);
+    if (std::fabs(gp_Vec(cam.dir).Dot(up)) > 0.999) {
+        up = gp_Vec(0, 1, 0);  // looking straight down or up: +Y is up on the screen
+    }
+    gp_Vec right = gp_Vec(cam.dir).Crossed(up);
+    cam.right = gp_Dir(right);
+    cam.up = gp_Dir(right.Crossed(gp_Vec(cam.dir)));
+    return cam;
+}
+
+Camera Camera::fromName(const std::string& name)
+{
+    // Directions from the eye into the scene, as FreeCAD's standard views
+    static const std::map<std::string, std::array<double, 3>> views = {
+        {"iso", {-1, 1, -1}},
+        {"isometric", {-1, 1, -1}},
+        {"front", {0, 1, 0}},
+        {"back", {0, -1, 0}},
+        {"rear", {0, -1, 0}},
+        {"right", {-1, 0, 0}},
+        {"left", {1, 0, 0}},
+        {"top", {0, 0, -1}},
+        {"bottom", {0, 0, 1}},
+        {"iso-back", {1, -1, -1}},
+        {"iso-low", {-1, 1, 0.6}},
+        {"dimetric", {-0.6, 1, -0.5}},
+        {"trimetric", {-0.5, 1, -0.7}},
+    };
+    auto it = views.find(name);
+    if (it != views.end()) {
+        return fromDirection(gp_Vec(it->second[0], it->second[1], it->second[2]));
+    }
+    double x {}, y {}, z {};
+    char c1 {}, c2 {};
+    std::istringstream str(name);
+    if (str >> x >> c1 >> y >> c2 >> z && c1 == ',' && c2 == ',') {
+        return fromDirection(gp_Vec(x, y, z));
+    }
+    throw Base::ValueError(
+        "Unknown view '" + name
+        + "' (iso, front, back, right, left, top, bottom, iso-back, iso-low, dimetric, "
+          "trimetric or dx,dy,dz)"
+    );
+}
+
+// ------------------------------------------------------------------ render
+
+Image Part::ViewTools::render(const std::vector<SceneItem>& items, const Camera& cam, const RenderOptions& opt)
+{
+    if (opt.width < 8 || opt.height < 8 || opt.width > 16384 || opt.height > 16384) {
+        throw Base::ValueError("Image size must be between 8 and 16384 pixels");
+    }
+    const std::string& style = opt.style;
+    const bool wire = style == "lines" || style == "wireframe";
+    const bool hiddenLines = style == "hidden-lines" || style == "hiddenlines";
+    const bool shadedOnly = style == "shaded-only" || style == "flat";
+    if (!wire && !hiddenLines && !shadedOnly && style != "shaded") {
+        throw Base::ValueError(
+            "Unknown style '" + style + "' (shaded, shaded-only, hidden-lines, lines)"
+        );
+    }
+    int s = std::clamp(opt.supersample, 1, 4);
+    while (s > 1 && (double)opt.width * opt.height * s * s > 40e6) {
+        --s;
+    }
+    const int W = opt.width * s;
+    const int H = opt.height * s;
+
+    Scene scene = buildScene(items, opt.deflection);
+    Fit fit = fitView(scene, cam, W, H, opt.margin);
+
+    Raster R;
+    R.init(W, H);
+    std::vector<std::uint8_t> edge((size_t)W * H, 0);
+    if (!wire) {
+        rasterize(R, scene, cam, fit);
+        if (!shadedOnly) {
+            // edges from changes of face, depth jumps and creases
+            const double pix = 1.0 / fit.scale;
+            const double crease = std::cos(35.0 * M_PI / 180.0) * 127 * 127;
+            for (int y = 0; y < H; ++y) {
+                for (int x = 0; x < W; ++x) {
+                    size_t i = (size_t)y * W + x;
+                    for (int k = 0; k < 2; ++k) {
+                        int xx = x + (k == 0 ? 1 : 0);
+                        int yy = y + (k == 1 ? 1 : 0);
+                        if (xx >= W || yy >= H) {
+                            continue;
+                        }
+                        size_t j = (size_t)yy * W + xx;
+                        bool isEdge = false;
+                        if (R.id[i] != R.id[j]
+                            && (R.id[i] < 0 || R.id[j] < 0
+                                || scene.faces[R.id[i]].smooth != scene.faces[R.id[j]].smooth)) {
+                            isEdge = true;
+                        }
+                        else if (R.id[i] >= 0) {
+                            double dz = std::fabs((double)R.depth[i] - R.depth[j]);
+                            if (dz > 8 * pix) {
+                                isEdge = true;
+                            }
+                            else {
+                                double dot = (double)R.nrm[i * 3] * R.nrm[j * 3]
+                                    + (double)R.nrm[i * 3 + 1] * R.nrm[j * 3 + 1]
+                                    + (double)R.nrm[i * 3 + 2] * R.nrm[j * 3 + 2];
+                                isEdge = dot < crease;
+                            }
+                        }
+                        if (isEdge) {
+                            // mark the nearer pixel so the line sits on the front object
+                            if (R.depth[i] <= R.depth[j]) {
+                                edge[i] = 1;
+                            }
+                            else {
+                                edge[j] = 1;
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+    else {
+        for (const auto& e : scene.edges) {
+            double px0 {}, py0 {};
+            for (size_t k = 0; k < e.p.size(); ++k) {
+                double x {}, y {}, d {}, sx {}, sy {};
+                cam.project(e.p[k], x, y, d);
+                fit.toScreen(x, y, sx, sy);
+                if (k > 0) {
+                    drawSegment(edge, W, H, px0, py0, sx, sy);
+                }
+                px0 = sx;
+                py0 = sy;
+            }
+        }
+    }
+    int radius = (int)std::lround((opt.lineWidth * s - 1.0) / 2.0);
+    dilate(edge, W, H, radius);
+
+    Image img;
+    img.width = opt.width;
+    img.height = opt.height;
+    img.rgb.assign((size_t)opt.width * opt.height * 3, 0);
+    for (int y = 0; y < opt.height; ++y) {
+        for (int x = 0; x < opt.width; ++x) {
+            double acc[3] = {0, 0, 0};
+            for (int sy = 0; sy < s; ++sy) {
+                for (int sx = 0; sx < s; ++sx) {
+                    size_t i = (size_t)(y * s + sy) * W + (x * s + sx);
+                    Color c = opt.background;
+                    if (edge[i]) {
+                        c = opt.edgeColor;
+                    }
+                    else if (R.id[i] >= 0) {
+                        if (hiddenLines) {
+                            c = {1.0F, 1.0F, 1.0F};
+                        }
+                        else {
+                            const Color& fc = scene.faces[R.id[i]].color;
+                            float sh = R.shade[i];
+                            c = {fc[0] * sh, fc[1] * sh, fc[2] * sh};
+                        }
+                    }
+                    acc[0] += c[0];
+                    acc[1] += c[1];
+                    acc[2] += c[2];
+                }
+            }
+            for (int k = 0; k < 3; ++k) {
+                double v = acc[k] / (s * s);
+                img.rgb[((size_t)y * opt.width + x) * 3 + k] = (std::uint8_t)std::clamp(
+                    (int)std::lround(v * 255.0),
+                    0,
+                    255
+                );
+            }
+        }
+    }
+    return img;
+}
+
+void Part::ViewTools::writePng(const Image& img, const std::string& path)
+{
+    std::vector<std::uint8_t> raw;
+    raw.reserve((size_t)(img.width * 3 + 1) * img.height);
+    for (int y = 0; y < img.height; ++y) {
+        raw.push_back(0);
+        const auto* row = img.rgb.data() + (size_t)y * img.width * 3;
+        raw.insert(raw.end(), row, row + (size_t)img.width * 3);
+    }
+    uLongf len = compressBound((uLong)raw.size());
+    std::vector<std::uint8_t> zdata(len);
+    if (compress2(zdata.data(), &len, raw.data(), (uLong)raw.size(), 6) != Z_OK) {
+        throw Base::RuntimeError("PNG compression failed");
+    }
+    zdata.resize(len);
+
+    Base::FileInfo fi(path);
+    Base::ofstream out(fi, std::ios::out | std::ios::binary);
+    if (!out) {
+        throw Base::FileException("Cannot write file", fi);
+    }
+    const char sig[8] = {(char)0x89, 'P', 'N', 'G', '\r', '\n', 0x1a, '\n'};
+    out.write(sig, 8);
+    std::vector<std::uint8_t> ihdr(13, 0);
+    auto put32 = [](std::uint8_t* p, std::uint32_t v) {
+        p[0] = (std::uint8_t)(v >> 24);
+        p[1] = (std::uint8_t)(v >> 16);
+        p[2] = (std::uint8_t)(v >> 8);
+        p[3] = (std::uint8_t)v;
+    };
+    put32(ihdr.data(), (std::uint32_t)img.width);
+    put32(ihdr.data() + 4, (std::uint32_t)img.height);
+    ihdr[8] = 8;  // bit depth
+    ihdr[9] = 2;  // RGB
+    putChunk(out, "IHDR", ihdr);
+    putChunk(out, "IDAT", zdata);
+    putChunk(out, "IEND", {});
+    out.close();
+    if (!out) {
+        throw Base::FileException("Cannot write file", fi);
+    }
+}
