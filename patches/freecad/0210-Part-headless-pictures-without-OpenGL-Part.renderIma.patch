+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+// Python functions of the Part module for headless views and interference checks:
+// see the method table at the end
+
+#include <Python.h>
+
+#include <array>
+#include <string>
+#include <vector>
+
+#include <CXX/Objects.hxx>
+
+#include <Base/Exception.h>
+#include <Base/Interpreter.h>
+#include <Base/VectorPy.h>
+
+#include "OCCError.h"
+#include "TopoShapePy.h"
+#include "ViewTools.h"
+
+using namespace Part::ViewTools;
+
+namespace
+{
+
+const std::array<Color, 10> palette = {{
+    {0.80F, 0.82F, 0.86F},
+    {0.55F, 0.70F, 0.90F},
+    {0.95F, 0.70F, 0.45F},
+    {0.60F, 0.82F, 0.60F},
+    {0.90F, 0.60F, 0.70F},
+    {0.75F, 0.65F, 0.90F},
+    {0.95F, 0.88F, 0.50F},
+    {0.55F, 0.80F, 0.80F},
+    {0.70F, 0.70F, 0.70F},
+    {0.85F, 0.55F, 0.45F},
+}};
+
+Color toColor(const Py::Object& obj)
+{
+    Py::Sequence seq(obj);
+    if (seq.size() < 3) {
+        throw Py::ValueError("A color needs three values (r, g, b) from 0 to 1 or 0 to 255");
+    }
+    Color c {(float)(double)Py::Float(seq[0]), (float)(double)Py::Float(seq[1]), (float)(double)Py::Float(seq[2])};
+    if (c[0] > 1 || c[1] > 1 || c[2] > 1) {
+        for (auto& v : c) {
+            v /= 255.0F;
+        }
+    }
+    return c;
+}
+
+gp_Pnt toPoint(const Py::Object& obj)
+{
+    if (PyObject_TypeCheck(obj.ptr(), &Base::VectorPy::Type)) {
+        Base::Vector3d v = static_cast<Base::VectorPy*>(obj.ptr())->value();
+        return {v.x, v.y, v.z};
+    }
+    Py::Sequence seq(obj);
+    return {(double)Py::Float(seq[0]), (double)Py::Float(seq[1]), (double)Py::Float(seq[2])};
+}
+
+void setMesh(SceneItem& item, const Py::Object& topo)
+{
+    Py::Sequence pair(topo);
+    if (pair.size() != 2) {
+        throw Py::TypeError("A mesh is a tuple (points, facets)");
+    }
+    Py::Sequence pts(pair[0]);
+    Py::Sequence fcs(pair[1]);
+    item.meshPoints.reserve(pts.size());
+    for (const auto& p : pts) {
+        item.meshPoints.push_back(toPoint(p));
+    }
+    item.meshFacets.reserve(fcs.size());
+    for (const auto& f : fcs) {
+        Py::Sequence t(f);
+        item.meshFacets.push_back({(int)(long)Py::Long(t[0]), (int)(long)Py::Long(t[1]), (int)(long)Py::Long(t[2])});
+    }
+}
+
+// Shape, (points, facets), Mesh.Mesh, document object with Shape or Mesh, or a dict
+// {"shape"/"mesh"/"object": ..., "color": (r, g, b)}
+SceneItem toItem(const Py::Object& obj, std::size_t index)
+{
+    SceneItem item;
+    item.color = palette[index % palette.size()];
+    Py::Object what = obj;
+    if (PyDict_Check(obj.ptr())) {
+        Py::Dict d(obj);
+        if (d.hasKey("color")) {
+            item.color = toColor(d["color"]);
+        }
+        if (d.hasKey("shape")) {
+            what = d["shape"];
+        }
+        else if (d.hasKey("mesh")) {
+            what = d["mesh"];
+        }
+        else if (d.hasKey("object")) {
+            what = d["object"];
+        }
+        else {
+            throw Py::ValueError("An item dict needs 'shape', 'mesh' or 'object'");
+        }
+    }
+    if (PyObject_TypeCheck(what.ptr(), &Part::TopoShapePy::Type)) {
+        item.shape = static_cast<Part::TopoShapePy*>(what.ptr())->getTopoShapePtr()->getShape();
+        return item;
+    }
+    if (PyTuple_Check(what.ptr()) || PyList_Check(what.ptr())) {
+        setMesh(item, what);
+        return item;
+    }
+    if (what.hasAttr("Topology") && !what.hasAttr("Shape")) {
+        setMesh(item, what.getAttr("Topology"));  // Mesh.Mesh
+        return item;
+    }
+    if (what.hasAttr("Shape")) {
+        Py::Object shp = what.getAttr("Shape");
+        if (PyObject_TypeCheck(shp.ptr(), &Part::TopoShapePy::Type)) {
+            item.shape = static_cast<Part::TopoShapePy*>(shp.ptr())->getTopoShapePtr()->getShape();
+            return item;
+        }
+    }
+    if (what.hasAttr("Mesh")) {
+        Py::Object mesh = what.getAttr("Mesh");
+        if (mesh.hasAttr("Topology")) {
+            setMesh(item, mesh.getAttr("Topology"));
+            return item;
+        }
+    }
+    throw Py::TypeError(
+        "Expected a Part.Shape, a mesh (points, facets), a Mesh.Mesh or an object with a Shape or Mesh"
+    );
+}
+
+std::vector<SceneItem> toItems(PyObject* objs)
+{
+    std::vector<SceneItem> items;
+    if (PyObject_TypeCheck(objs, &Part::TopoShapePy::Type) || PyDict_Check(objs)
+        || !PySequence_Check(objs)) {
+        items.push_back(toItem(Py::Object(objs), 0));
+        return items;
+    }
+    Py::Sequence seq(objs);
+    // a single mesh tuple (points, facets)
+    if (seq.size() == 2 && PySequence_Check(seq[0].ptr()) && PySequence_Check(seq[1].ptr())) {
+        Py::Sequence second(seq[1]);
+        if (second.size() > 0 && PySequence_Check(second[0].ptr())
+            && Py::Sequence(second[0]).size() == 3 && PyLong_Check(Py::Sequence(second[0])[0].ptr())) {
+            items.push_back(toItem(Py::Object(objs), 0));
+            return items;
+        }
+    }
+    for (Py::Sequence::size_type i = 0; i < seq.size(); ++i) {
+        items.push_back(toItem(seq[i], i));
+    }
+    return items;
+}
+
+Camera toCamera(PyObject* view)
+{
+    if (!view || view == Py_None) {
+        return Camera::fromName("iso");
+    }
+    if (PyUnicode_Check(view)) {
+        return Camera::fromName(PyUnicode_AsUTF8(view));
+    }
+    gp_Pnt p = toPoint(Py::Object(view));
+    return Camera::fromDirection(gp_Vec(p.XYZ()));
+}
+
+PyObject* renderImage(PyObject* /*self*/, PyObject* args, PyObject* kwds)
+{
+    static const char* kwlist[] = {
+        "objects", "filename", "view", "width", "height", "style", "lineWidth",
+        "deflection", "background", "supersample", nullptr
+    };
+    PyObject* objs {};
+    const char* filename {};
+    PyObject* view = nullptr;
+    int width = 1200, height = 900, supersample = 3;
+    const char* style = "shaded";
+    double lineWidth = 1.0, deflection = 0.0;
+    PyObject* background = nullptr;
+    if (!PyArg_ParseTupleAndKeywords(
+            args, kwds, "Os|OiisddOi", const_cast<char**>(kwlist), &objs, &filename, &view,
+            &width, &height, &style, &lineWidth, &deflection, &background, &supersample
+        )) {
+        return nullptr;
+    }
+    try {
+        RenderOptions opt;
+        opt.width = width;
+        opt.height = height;
+        opt.style = style;
+        opt.lineWidth = lineWidth;
+        opt.deflection = deflection;
+        opt.supersample = supersample;
+        if (background && background != Py_None) {
+            opt.background = toColor(Py::Object(background));
+        }
+        std::vector<SceneItem> items = toItems(objs);
+        Camera cam = toCamera(view);
+        Image img = render(items, cam, opt);
+        writePng(img, filename);
+        Py_Return;
+    }
+    catch (const Py::Exception&) {
+        return nullptr;
+    }
+    catch (const Base::Exception& e) {
+        e.setPyException();
+        return nullptr;
+    }
+    catch (const Standard_Failure& e) {
+        PyErr_SetString(Part::PartExceptionOCCError, e.GetMessageString());
+        return nullptr;
+    }
+}
+
+PyMethodDef methods[] = {
+    {"renderImage",
+     reinterpret_cast<PyCFunction>(reinterpret_cast<void (*)()>(renderImage)),
+     METH_VARARGS | METH_KEYWORDS,
+     "renderImage(objects, filename, view='iso', width=1200, height=900, style='shaded',\n"
+     "            lineWidth=1.0, deflection=0, background=(1,1,1), supersample=3)\n"
+     "Write a PNG picture without OpenGL or a display (CPU renderer).\n"
+     "objects: a shape, a mesh (points, facets), a Mesh.Mesh, a document object, a dict\n"
+     "{'shape'|'mesh'|'object': ..., 'color': (r,g,b)} or a list of these.\n"
+     "view: iso, front, back, right, left, top, bottom, iso-back, iso-low, dimetric,\n"
+     "trimetric, 'dx,dy,dz' or a vector (direction from the eye into the scene).\n"
+     "style: shaded, shaded-only, hidden-lines, lines."},
+    {nullptr, nullptr, 0, nullptr},
+};
+
+}  // namespace
+
+namespace Part::ViewTools
+{
+void addPythonFunctions(PyObject* module)
+{
+    PyModule_AddFunctions(module, methods);
+}
+}  // namespace Part::ViewTools
