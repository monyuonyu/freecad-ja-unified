+++ b/src/Mod/Part/PartViews.py
@@ -0,0 +1,214 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+
+"""Headless pictures.
+
+Works in FreeCADCmd without OpenGL or a display.  The heavy lifting is in C++
+(Part.renderImage); this module
+collects the objects of a document and writes the files.
+
+Command line (FreeCADCmd):
+
+    FreeCADCmd model.FCStd --render out.png [--view iso] [--size 1600x1200]
+                           [--render-style shaded|shaded-only|hidden-lines|lines]
+
+Python:
+
+    import PartViews
+    PartViews.render(objects_or_doc, "out.png", view="iso", size=(1600, 1200))
+"""
+
+import os
+
+import FreeCAD as App
+import Part
+
+__all__ = [
+    "scene_objects",
+    "render",
+    "cli_main",
+]
+
+VIEW_NAMES = (
+    "iso", "isometric", "front", "back", "rear", "right", "left", "top", "bottom",
+    "iso-back", "iso-low", "dimetric", "trimetric",
+)  # fmt: skip
+
+_SKIP_TYPES = (
+    "App::Part",
+    "App::DocumentObjectGroup",
+    "App::Origin",
+    "App::Line",
+    "App::Plane",
+    "App::Point",
+    "App::LocalCoordinateSystem",
+    "PartDesign::CoordinateSystem",
+    "PartDesign::Plane",
+    "PartDesign::Line",
+    "PartDesign::Point",
+    "Sketcher::SketchObject",
+    "Spreadsheet::Sheet",
+)
+
+
+def _parent_placement(obj):
+    pl = App.Placement()
+    parent = obj.getParentGeoFeatureGroup() if hasattr(obj, "getParentGeoFeatureGroup") else None
+    while parent is not None:
+        if hasattr(parent, "Placement"):
+            pl = parent.Placement.multiply(pl)
+        parent = parent.getParentGeoFeatureGroup()
+    return pl
+
+
+def _in_body(obj):
+    parent = obj.getParentGeoFeatureGroup() if hasattr(obj, "getParentGeoFeatureGroup") else None
+    return parent is not None and parent.isDerivedFrom("PartDesign::Body")
+
+
+def _visible(obj):
+    try:
+        return bool(obj.Visibility)
+    except Exception:
+        return True
+
+
+def scene_objects(source=None):
+    """[(document object or None, item)] for the visible solids/faces/meshes of a document.
+
+    source: None (active document), a document, an object, a shape or a list of them.
+    item is what Part.renderImage / Part.projectVisible take."""
+    if source is None:
+        source = App.ActiveDocument
+        if source is None:
+            raise RuntimeError("No document is open")
+    if isinstance(source, App.Document):
+        objs = [o for o in source.Objects if _visible(o)]
+        return _items(objs, from_document=True)
+    if isinstance(source, (list, tuple)):
+        return _items(list(source), from_document=False)
+    return _items([source], from_document=False)
+
+
+def _items(objs, from_document):
+    result = []
+    for obj in objs:
+        if isinstance(obj, Part.Shape):
+            if not obj.isNull():
+                result.append((None, obj))
+            continue
+        if isinstance(obj, dict):
+            result.append((None, obj))
+            continue
+        if hasattr(obj, "Topology") and not hasattr(obj, "TypeId"):
+            result.append((None, obj))  # Mesh.Mesh
+            continue
+        if not hasattr(obj, "TypeId"):
+            raise TypeError("Cannot draw %r" % (obj,))
+        if from_document:
+            if obj.TypeId in _SKIP_TYPES or _in_body(obj):
+                continue
+        if hasattr(obj, "Mesh") and hasattr(obj.Mesh, "Topology"):
+            mesh = obj.Mesh.copy()
+            pl = _parent_placement(obj)
+            if not pl.isIdentity():
+                mesh.transform(pl.toMatrix())
+            result.append((obj, mesh.Topology))
+            continue
+        try:
+            shape = Part.getShape(obj)
+        except Exception:
+            shape = getattr(obj, "Shape", None)
+        if shape is None or shape.isNull():
+            continue
+        if from_document and not shape.Faces and not shape.Edges:
+            continue
+        if from_document and not shape.Faces and obj.TypeId.startswith("Part::Part2DObject"):
+            continue
+        pl = _parent_placement(obj)
+        if not pl.isIdentity():
+            shape = shape.transformed(pl.toMatrix())
+        result.append((obj, shape))
+    return result
+
+
+def _with_colors(pairs, colors=None):
+    items = []
+    for i, (obj, item) in enumerate(pairs):
+        color = None
+        if colors:
+            key = obj.Name if obj is not None else i
+            color = colors.get(key) or (colors.get(obj.Label) if obj is not None else None)
+        if color is not None:
+            items.append({"object" if not isinstance(item, (Part.Shape, tuple, list)) else
+                          ("shape" if isinstance(item, Part.Shape) else "mesh"): item,
+                          "color": color})  # fmt: skip
+        else:
+            items.append(item)
+    return items
+
+
+def _parse_size(size):
+    if size is None:
+        return 1200, 900
+    if isinstance(size, (int, float)):
+        return int(size), int(round(size * 0.75))
+    if isinstance(size, str):
+        parts = size.lower().replace("*", "x").split("x")
+        if len(parts) == 1:
+            w = int(parts[0])
+            return w, int(round(w * 0.75))
+        return int(parts[0]), int(parts[1])
+    return int(size[0]), int(size[1])
+
+
+def _split_views(view):
+    """'iso,front' -> ['iso', 'front'];  '-1,1,-1' stays one view."""
+    if isinstance(view, (list, tuple)) and view and isinstance(view[0], str):
+        return list(view)
+    if isinstance(view, str) and "," in view:
+        names = [v.strip() for v in view.split(",")]
+        if all(n in VIEW_NAMES for n in names):
+            return names
+    return [view]
+
+
+def render(source=None, path="view.png", view="iso", size=None, style="shaded",
+           colors=None, line_width=1.0, deflection=0.0, background=(1, 1, 1)):  # fmt: skip
+    """Write PNG picture(s).  Several views ('iso,front' or a list) write path_<view>.png.
+    Returns the list of written files."""
+    pairs = scene_objects(source)
+    if not pairs:
+        raise RuntimeError("Nothing to draw")
+    items = _with_colors(pairs, colors)
+    w, h = _parse_size(size)
+    views = _split_views(view)
+    root, ext = os.path.splitext(path)
+    written = []
+    for v in views:
+        out = path if len(views) == 1 else "%s_%s%s" % (root, v if isinstance(v, str) else "view", ext)
+        Part.renderImage(items, out, view=v, width=w, height=h, style=style,
+                         lineWidth=line_width, deflection=deflection, background=background)  # fmt: skip
+        written.append(out)
+    return written
+
+
+def _config(key):
+    try:
+        return App.ConfigGet(key)
+    except Exception:
+        return ""
+
+
+def cli_main():
+    """Run the command line options of this module (see the module docstring)."""
+    doc = App.ActiveDocument
+    if doc is None:
+        raise RuntimeError("No document is open (give a .FCStd, .step, .stl ... file)")
+    doc.recompute()
+    view = _config("RenderView") or "iso"
+    size = _config("RenderSize") or None
+    style = _config("RenderStyle") or "shaded"
+    png = _config("RenderFile")
+    if png:
+        for out in render(doc, png, view=view, size=size, style=style):
+            print("Wrote %s" % out)
