+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+/***************************************************************************
+ *   Headless views of shapes: a CPU renderer (PNG), hidden-line removed   *
+ *   2D projection (visible face polygons and visible edges) and a fast    *
+ *   pairwise interference check.  None of this needs OpenGL or a display. *
+ ***************************************************************************/
+
+#pragma once
+
+#include <Python.h>
+
+#include <array>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include <gp_Dir.hxx>
+#include <gp_Pnt.hxx>
+#include <gp_Vec.hxx>
+#include <TopoDS_Shape.hxx>
+
+#include <Mod/Part/PartGlobal.h>
+
+namespace Part::ViewTools
+{
+
+using Color = std::array<float, 3>;
+using Point2d = std::array<double, 2>;
+
+/// One thing to draw: a shape, or a triangle mesh (e.g. from an STL file)
+struct SceneItem
+{
+    TopoDS_Shape shape;
+    std::vector<gp_Pnt> meshPoints;
+    std::vector<std::array<int, 3>> meshFacets;
+    Color color {0.80F, 0.82F, 0.86F};
+};
+
+/// Orthographic camera.  \a dir points from the eye into the scene.
+struct PartExport Camera
+{
+    gp_Dir dir {0, 0, -1};
+    gp_Dir right {1, 0, 0};
+    gp_Dir up {0, 1, 0};
+
+    /// Names: iso, front, back (rear), right, left, top, bottom, iso-back, iso-low,
+    /// or a direction "dx,dy,dz" (from the eye into the scene)
+    static Camera fromName(const std::string& name);
+    static Camera fromDirection(const gp_Vec& dir);
+
+    void project(const gp_Pnt& p, double& x, double& y, double& depth) const
+    {
+        const gp_XYZ& v = p.XYZ();
+        x = v.Dot(right.XYZ());
+        y = v.Dot(up.XYZ());
+        depth = v.Dot(dir.XYZ());
+    }
+};
+
+struct RenderOptions
+{
+    int width = 1200;
+    int height = 900;
+    /// shaded (faces with edges), shaded-only, hidden-lines, lines (wireframe)
+    std::string style = "shaded";
+    Color background {1.0F, 1.0F, 1.0F};
+    Color edgeColor {0.10F, 0.10F, 0.10F};
+    double lineWidth = 1.0;  // pixels
+    double deflection = 0.0;  // 0: from the size of the scene
+    int supersample = 3;
+    double margin = 0.04;  // fraction of the image left free at each side
+};
+
+struct Image
+{
+    int width = 0;
+    int height = 0;
+    std::vector<std::uint8_t> rgb;
+};
+
+PartExport Image render(const std::vector<SceneItem>& items, const Camera& cam, const RenderOptions& opt);
+PartExport void writePng(const Image& img, const std::string& path);
+
+/// Adds the Python functions of the headless views to the Part module
+void addPythonFunctions(PyObject* module);
+
+}  // namespace Part::ViewTools
