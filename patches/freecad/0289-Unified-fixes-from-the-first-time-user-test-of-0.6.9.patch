index 000000000..fb5557fad
--- /dev/null
+++ b/src/Mod/Unified/FollowGui.py
@@ -0,0 +1,159 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""What goes with the model when it changes, and the 3D view as the face of a file
+(usability test 0.6.9, task 8):
+
+- a screw, washer or nut from the parts shelf follows its hole when the hole moves
+  (PartsShelf.follow_holes), and so do the center lines of the holes on the drawing
+  (DrawingAuto.refresh_center_lines)
+- closing the last 3D view of a file closes the file (asking to save it), instead of leaving
+  it open behind its drawing with no question
+- a file opened shows its 3D view first, not the drawing
+"""
+
+import FreeCAD as App
+import FreeCADGui as Gui
+from PySide import QtCore, QtWidgets
+
+
+class _Follow:
+    def __init__(self):
+        self.busy = False
+        self.pending = set()
+
+    def slotRecomputedDocument(self, doc):
+        if self.busy:
+            return
+        name = doc.Name
+        if name in self.pending:
+            return
+        self.pending.add(name)
+        QtCore.QTimer.singleShot(0, lambda: self.follow(name))
+
+    def follow(self, name):
+        self.pending.discard(name)
+        try:
+            doc = App.getDocument(name)
+        except Exception:
+            return
+        self.busy = True
+        try:
+            changed = 0
+            try:
+                import PartsShelf
+
+                changed += PartsShelf.follow_holes(doc)
+            except Exception as e:
+                App.Console.PrintLog("Follow holes: {}\n".format(e))
+            try:
+                import DrawingAuto
+
+                for v in doc.Objects:
+                    if v.isDerivedFrom("TechDraw::DrawViewPart") and getattr(v, "AutoCenterLines", None):
+                        if DrawingAuto.refresh_center_lines(v):
+                            changed += 1
+            except Exception as e:
+                App.Console.PrintLog("Follow center lines: {}\n".format(e))
+            if changed:
+                doc.recompute()
+        finally:
+            self.busy = False
+
+    def slotFinishRestoreDocument(self, doc):
+        name = doc.Name
+        QtCore.QTimer.singleShot(300, lambda: show_3d_first(name))
+
+
+def _mdi():
+    return Gui.getMainWindow().findChild(QtWidgets.QMdiArea)
+
+
+def _3d_subwindows(doc_name):
+    """The sub-windows of the file's 3D views"""
+    out = []
+    try:
+        gdoc = Gui.getDocument(doc_name)
+    except Exception:
+        return out
+    mdi = _mdi()
+    if mdi is None:
+        return out
+    views = []
+    for v in gdoc.mdiViewsOfType("Gui::View3DInventor"):
+        try:
+            views.append(v.graphicsView())
+        except Exception:
+            pass
+    for sub in mdi.subWindowList():
+        w = sub.widget()
+        if w is not None and any(w.isAncestorOf(g) for g in views):
+            out.append(sub)
+    return out
+
+
+def _doc_of_subwindow(sub):
+    for d in App.listDocuments():
+        if sub in _3d_subwindows(d):
+            return d
+    return None
+
+
+def show_3d_first(doc_name):
+    subs = _3d_subwindows(doc_name)
+    mdi = _mdi()
+    if subs and mdi is not None:
+        mdi.setActiveSubWindow(subs[0])
+
+
+class _CloseWatcher(QtCore.QObject):
+    """Closing the last 3D view of a file: the file's other views close too, so that FreeCAD
+    asks whether to save it and closes it"""
+
+    def eventFilter(self, obj, event):
+        if event.type() == QtCore.QEvent.Close and isinstance(obj, QtWidgets.QMdiSubWindow):
+            doc = _doc_of_subwindow(obj)
+            if doc is not None and len(_3d_subwindows(doc)) == 1:
+                mdi = _mdi()
+                others = [s for s in mdi.subWindowList() if s is not obj and _belongs(s, doc)]
+                for s in others:
+                    s.close()
+        return False
+
+    def watch(self, sub):
+        if sub is not None and not sub.property("unifiedCloseWatch"):
+            sub.setProperty("unifiedCloseWatch", True)
+            sub.installEventFilter(self)
+
+
+def _belongs(sub, doc_name):
+    """The sub-window shows the file (its title is "<file label> : n" or a page of the file)"""
+    try:
+        doc = App.getDocument(doc_name)
+    except Exception:
+        return False
+    title = sub.windowTitle()
+    if title.startswith(doc.Label + " :") or title.startswith(doc.Label + ":"):
+        return True
+    w = sub.widget()
+    # A drawing page's view: its page is an object of the file
+    for o in doc.Objects:
+        if o.isDerivedFrom("TechDraw::DrawPage") and title.startswith(o.Label):
+            return True
+    return False
+
+
+_follow = None
+_close = None
+
+
+def install():
+    global _follow, _close
+    if _follow is None:
+        _follow = _Follow()
+        App.addDocumentObserver(_follow)
+    if _close is None:
+        _close = _CloseWatcher(Gui.getMainWindow())
+        mdi = _mdi()
+        if mdi is not None:
+            for s in mdi.subWindowList():
+                _close.watch(s)
+            mdi.subWindowActivated.connect(_close.watch)
