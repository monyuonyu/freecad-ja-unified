+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""More holes and their positions in numbers, while the hole's panel is open (usability test
+0.6.9, task 1: "only one hole can be put; its position cannot be typed").
+
+After "Hole" on a face, each further click on the same face puts another hole there, and the
+panel lists the holes with their distances from the left and the bottom edge of the face, to
+type exactly (Enter). The holes are the points of the hole's sketch (Unified_Hole makes it).
+"""
+
+import FreeCAD as App
+import FreeCADGui as Gui
+import Part
+from PySide import QtCore, QtWidgets
+
+translate = App.Qt.translate
+
+
+def _num(v):
+    return "{:.2f}".format(v).rstrip("0").rstrip(".")
+
+
+class HolePositions(QtCore.QObject):
+    """The list of holes on the panel, and the clicks that add one"""
+
+    def __init__(self, hole, sketch, face_obj, face_name):
+        super().__init__(Gui.getMainWindow())
+        self.hole = hole
+        self.sketch = sketch
+        self.face_obj = face_obj
+        self.face_name = face_name
+        self.box = None
+        self.rows = []
+        self.origin = self._origin()
+        Gui.Selection.addObserver(self)
+        self.timer = QtCore.QTimer(self)
+        self.timer.setInterval(300)
+        self.timer.timeout.connect(self._watch)
+        self.timer.start()
+
+    # -- where the face is, in the sketch's plane
+    def _origin(self):
+        try:
+            face = self.face_obj.Shape.getElement(self.face_name)
+        except Exception:
+            return App.Vector(0, 0, 0)
+        inv = self.sketch.getGlobalPlacement().inverse()
+        pts = [inv.multVec(v.Point) for v in face.Vertexes]
+        if not pts:
+            return App.Vector(0, 0, 0)
+        return App.Vector(min(p.x for p in pts), min(p.y for p in pts), 0)
+
+    def points(self):
+        return [(i, g) for i, g in enumerate(self.sketch.Geometry) if isinstance(g, Part.Point)]
+
+    # -- clicks on the face add a hole
+    def addSelection(self, doc, obj, sub, pnt):
+        if not Gui.Control.activeDialog() or pnt is None or not sub.startswith("Face"):
+            return
+        if doc != self.sketch.Document.Name:
+            return
+        try:
+            target = App.getDocument(doc).getObject(obj)
+        except Exception:
+            return
+        # The face where the holes are: on the step it was picked on, or on the hole itself
+        # (after the first hole the part shows the hole's shape)
+        try:
+            shape = target.Shape.getElement(sub.split(".")[-1])
+        except Exception:
+            return
+        if type(shape.Surface).__name__ != "Plane":
+            return
+        p = App.Vector(*pnt)
+        local = self.sketch.getGlobalPlacement().inverse().multVec(p)
+        if abs(local.z) > 1e-4:
+            return  # another face
+        QtCore.QTimer.singleShot(0, lambda: self.add(local))
+
+    def add(self, local):
+        doc = self.sketch.Document
+        for _i, g in self.points():
+            if (App.Vector(g.X, g.Y, 0) - App.Vector(local.x, local.y, 0)).Length < 0.5:
+                return  # the same hole again
+        self.sketch.addGeometry(Part.Point(App.Vector(local.x, local.y, 0)))
+        doc.recompute()
+        Gui.Selection.clearSelection()
+        self.rebuild()
+
+    def move(self, index, x, y):
+        self.sketch.moveGeometry(index, 1, App.Vector(self.origin.x + x, self.origin.y + y, 0))
+        self.sketch.Document.recompute()
+        self.rebuild()
+
+    def remove(self, index):
+        if len(self.points()) > 1:
+            self.sketch.delGeometry(index)
+            self.sketch.Document.recompute()
+            self.rebuild()
+
+    # -- the list on the panel
+    def _panel_place(self):
+        panel = Gui.getMainWindow().findChild(QtWidgets.QWidget, "Tasks")
+        if panel is None:
+            return None
+        for w in panel.findChildren(QtWidgets.QWidget):
+            if w.metaObject().className() == "PartDesignGui::TaskHoleParameters" and w.isVisible():
+                return w
+        return None
+
+    def rebuild(self):
+        place = self._panel_place()
+        if place is None:
+            return
+        if self.box is None or not _alive(self.box):
+            self.box = QtWidgets.QGroupBox(translate("Unified_Hole", "Holes (click the face to add one)"))
+            self.box.setObjectName("UnifiedHolePositions")
+            QtWidgets.QGridLayout(self.box)
+            content = place.findChild(QtWidgets.QWidget, "TaskHoleParameters")
+            lay = content.layout() if content is not None else None
+            if lay is not None:
+                lay.insertWidget(0, self.box)
+            else:
+                return
+        lay = self.box.layout()
+        while lay.count():
+            w = lay.takeAt(0).widget()
+            if w is not None:
+                w.deleteLater()
+        lay.addWidget(QtWidgets.QLabel(""), 0, 0)
+        lay.addWidget(QtWidgets.QLabel(translate("Unified_Hole", "From the left edge")), 0, 1)
+        lay.addWidget(QtWidgets.QLabel(translate("Unified_Hole", "From the bottom edge")), 0, 2)
+        self.rows = []
+        for row, (index, g) in enumerate(self.points(), 1):
+            lay.addWidget(QtWidgets.QLabel(translate("Unified_Hole", "Hole {}").format(row)), row, 0)
+            fx = QtWidgets.QLineEdit(_num(g.X - self.origin.x))
+            fy = QtWidgets.QLineEdit(_num(g.Y - self.origin.y))
+            for f in (fx, fy):
+                f.setObjectName("UnifiedHoleX" if f is fx else "UnifiedHoleY")
+                f.setMaximumWidth(90)
+            fx.setProperty("unifiedHoleRow", row)
+
+            def commit(_=None, index=index, fx=fx, fy=fy):
+                try:
+                    x = float(fx.text().replace("mm", "").strip())
+                    y = float(fy.text().replace("mm", "").strip())
+                except ValueError:
+                    return
+                QtCore.QTimer.singleShot(0, lambda: self.move(index, x, y))
+
+            fx.returnPressed.connect(commit)
+            fy.returnPressed.connect(commit)
+            lay.addWidget(fx, row, 1)
+            lay.addWidget(fy, row, 2)
+            rm = QtWidgets.QToolButton()
+            rm.setText("✕")
+            rm.setToolTip(translate("Unified_Hole", "Remove this hole"))
+            rm.setEnabled(len(self.points()) > 1)
+            rm.clicked.connect(lambda _=False, index=index: QtCore.QTimer.singleShot(0, lambda: self.remove(index)))
+            lay.addWidget(rm, row, 3)
+            self.rows.append((fx, fy))
+
+    def _watch(self):
+        if not Gui.Control.activeDialog() or self._panel_place() is None:
+            if not Gui.Control.activeDialog():
+                self.close()
+            return
+        if self.box is None or not _alive(self.box):
+            self.rebuild()
+
+    def close(self):
+        self.timer.stop()
+        try:
+            Gui.Selection.removeObserver(self)
+        except Exception:
+            pass
+        global _current
+        if _current is self:
+            _current = None
+
+
+def _alive(w):
+    try:
+        import shiboken6
+
+        return shiboken6.isValid(w)
+    except Exception:
+        return True
+
+
+_current = None
+
+
+def start(sketch, face_obj, face_name):
+    """Called by Unified_Hole once the hole's panel is open"""
+    global _current
+    if _current is not None:
+        _current.close()
+    _current = HolePositions(None, sketch, face_obj, face_name)
+    return _current
+
+
+def current():
+    return _current
