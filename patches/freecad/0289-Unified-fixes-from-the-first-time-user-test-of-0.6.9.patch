@@ -0,0 +1,48 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+# Tests of LooseOutline (the outline of an opened drawing's lines), headless:
+#   FreeCADCmd -t TestLooseOutline
+
+import unittest
+
+import FreeCAD as App
+import Part
+
+import LooseOutline as L
+
+
+def rect(x0, y0, x1, y1):
+    p = [App.Vector(x0, y0, 0), App.Vector(x1, y0, 0), App.Vector(x1, y1, 0), App.Vector(x0, y1, 0)]
+    return [Part.LineSegment(p[i], p[(i + 1) % 4]).toShape() for i in range(4)]
+
+
+class LooseOutlineTest(unittest.TestCase):
+    def test_the_frame_is_no_outline(self):
+        # Usability test 0.6.9: the drawing's frame became the plate
+        frame = rect(0, 0, 297, 210)
+        part = rect(50, 50, 130, 100)
+        edges = frame + part
+        loops = L.closed_loops(edges)
+        outlines, frames = L.split_frame(loops, edges)
+        self.assertEqual(len(frames), 1)
+        self.assertEqual(len(outlines), 1)
+        self.assertAlmostEqual(outlines[0].BoundBox.XLength, 80)
+        self.assertEqual(L.open_chains(edges, loops), [])
+
+    def test_a_title_box_with_text(self):
+        edges = rect(0, 0, 297, 210) + rect(200, 5, 290, 40) + rect(50, 50, 130, 100)
+        loops = L.closed_loops(edges)
+        outlines, frames = L.split_frame(loops, edges, [App.Vector(210, 20, 0)])
+        self.assertEqual(len(frames), 2)
+        self.assertEqual([round(w.BoundBox.XLength) for w in outlines], [80])
+
+    def test_lines_that_do_not_close_are_counted(self):
+        open_line = rect(50, 50, 130, 100)[:3]
+        edges = rect(0, 0, 297, 210) + open_line
+        loops = L.closed_loops(edges)
+        outlines, frames = L.split_frame(loops, edges)
+        self.assertEqual(outlines, [])
+        self.assertEqual(len(L.open_chains(edges, loops)), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
