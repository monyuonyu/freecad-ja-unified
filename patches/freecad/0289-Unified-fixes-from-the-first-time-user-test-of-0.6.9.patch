+def hold_current_part(doc):
+    """The part this file is about goes into its assembly and stays where it is (grounded), so
+    that the parts put in move onto it (usability test 0.6.9: the first part put in was
+    grounded instead, "it cannot be moved", and swapping turned the plate upside down)"""
+    import UtilsAssembly
+
+    asm = UtilsAssembly.activeAssembly()
+    if asm is None:
+        asms = [o for o in doc.Objects if o.isDerivedFrom("Assembly::AssemblyObject")]
+        asm = asms[0] if asms else None
+    if asm is None or UtilsAssembly.isAssemblyGrounded():
+        return None
+    inside = set(o.Name for o in asm.OutListRecursive)
+    parts = [
+        o for o in doc.RootObjects
+        if o is not asm
+        and (o.isDerivedFrom("PartDesign::Body") or o.isDerivedFrom("Part::Feature") or o.isDerivedFrom("App::Part"))
+        and not o.isDerivedFrom("Assembly::AssemblyObject")
+        and o.Name not in inside
+        and _solid_volume(o) > 0
+        and getattr(o, "Visibility", True)
+    ]
+    if not parts:
+        return None
+    doc.openTransaction(translate("Unified", "Put this file's part into the assembly"))
+    try:
+        for o in parts:
+            asm.addObject(o)
+        base = max(parts, key=_solid_volume)
+        import CommandCreateJoint
+
+        CommandCreateJoint.createGroundedJoint(base)
+    except Exception:
+        doc.abortTransaction()
+        raise
+    doc.commitTransaction()
+    return base
