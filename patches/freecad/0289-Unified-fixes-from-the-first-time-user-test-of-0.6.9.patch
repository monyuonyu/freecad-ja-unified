+# SPDX-License-Identifier: LGPL-2.1-or-later
+# Tests of AssemblyCopies (more of the same part in an assembly), headless:
+#   FreeCADCmd -t TestAssemblyCopies
+
+import unittest
+
+import FreeCAD as App
+import Part
+
+import AssemblyCopies as AC
+
+
+class AssemblyCopiesTest(unittest.TestCase):
+    def setUp(self):
+        self.doc = App.newDocument("AssemblyCopiesTest")
+        self.doc.UndoMode = 1
+        self.src = App.newDocument("AssemblyCopiesPillar")
+        pillar = self.src.addObject("Part::Box", "Pillar")
+        pillar.Length, pillar.Width, pillar.Height = 20, 20, 50
+        self.src.recompute()
+        import tempfile, os
+        self.tmp = tempfile.mkdtemp()
+        self.src.saveAs(os.path.join(self.tmp, "pillar.FCStd"))
+        self.doc.saveAs(os.path.join(self.tmp, "plate.FCStd"))
+        import UtilsAssembly  # noqa: F401  (the assembly module)
+
+        self.asm = self.doc.addObject("Assembly::AssemblyObject", "Assembly")
+        self.link = self.doc.addObject("App::Link", "Pillar")
+        self.link.setLink(pillar)
+        self.asm.addObject(self.link)
+        self.doc.recompute()
+
+    def tearDown(self):
+        App.closeDocument(self.doc.Name)
+        App.closeDocument(self.src.Name)
+
+    def test_another_beside_it(self):
+        new = AC.duplicate([self.link])
+        self.assertEqual(len(new), 1)
+        self.assertIs(new[0].LinkedObject, self.link.LinkedObject)
+        self.assertIs(AC.assembly_of(new[0]), self.asm)
+        self.assertGreater(new[0].Placement.Base.x, 20)
+        self.doc.undo()
+        self.assertEqual(len([o for o in self.asm.Group if o.isDerivedFrom("App::Link")]), 1)
+
+    def test_four_corners(self):
+        self.assertEqual(len(AC.grid_offsets(2, 2, 80, 40)), 3)
