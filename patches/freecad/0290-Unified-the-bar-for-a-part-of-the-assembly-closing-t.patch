+                QtCore.QTimer.singleShot(300, lambda: _close_if_viewless(doc))
         return False
 
     def watch(self, sub):
@@ -124,6 +150,27 @@ class _CloseWatcher(QtCore.QObject):
             sub.installEventFilter(self)
 
 
+def _close_if_viewless(doc_name, uid=None, tries=20):
+    """After the last 3D view was asked to close: once the question is answered and the views
+    are gone, the file goes too. Cancel keeps the view (then nothing happens)."""
+    try:
+        doc = App.getDocument(doc_name)
+    except Exception:
+        return
+    if uid is None:
+        uid = doc.Uid
+    if doc.Uid != uid:
+        return  # another file of the same name since
+    mdi = _mdi()
+    busy = QtWidgets.QApplication.activeModalWidget() is not None
+    has_views = (mdi is not None and any(_belongs(s, doc_name) for s in mdi.subWindowList())) or _3d_subwindows(doc_name)
+    if busy or has_views:
+        if tries > 0:
+            QtCore.QTimer.singleShot(300, lambda: _close_if_viewless(doc_name, uid, tries - 1 if not busy else tries))
+        return
+    App.closeDocument(doc_name)
+
+
 def _belongs(sub, doc_name):
     """The sub-window shows the file (its title is "<file label> : n" or a page of the file)"""
     try:
