+def _linked_from_elsewhere():
+    """One pick on a part of another file put into this file's assembly (its own tools would
+    change the other file)"""
+    import FreeCADGui as Gui
+
+    top = Gui.Selection.getSelectionEx("", 0)
+    res = Gui.Selection.getSelectionEx()
+    if len(top) != 1 or len(res) != 1:
+        return False
+    return top[0].Object.Document != res[0].Object.Document
+
+
