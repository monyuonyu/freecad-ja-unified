@@ -0,0 +1,289 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""Preferences by what the user wants to do (design 6.9): basic, mouse and keys, drawings, files,
+network and accounts, AI; FreeCAD's full preferences one click away ("All preferences…").
+
+A change takes effect at once (no OK / Apply): the settings are FreeCAD's own parameters, which
+the views and modules watch. The network and AI key pages are the ones of UnifiedPreferences.py,
+shown here unchanged; they are saved when this window closes.
+"""
+
+import FreeCAD as App
+import FreeCADGui as Gui
+from PySide import QtCore, QtGui, QtWidgets
+
+translate = App.Qt.translate
+
+
+def QT_TRANSLATE_NOOP(context, text):
+    return text
+
+
+T = lambda text: QT_TRANSLATE_NOOP("UnifiedSettings", text)
+
+
+def P(path):
+    return App.ParamGet("User parameter:BaseApp/Preferences/" + path)
+
+
+# The mouse: the integrated environment's default first, then a touchpad, then the styles of
+# other programs (so people coming from them feel at home)
+MOUSE = [
+    ("Gui::TinkerCADNavigationStyle", T("Standard (right drag turns, middle drag moves)")),
+    ("Gui::TouchpadNavigationStyle", T("Touchpad (Shift moves, Alt turns; pinch to zoom)")),
+    ("Gui::GestureNavigationStyle", T("Gestures (touch screens and touchpads)")),
+    ("Gui::SolidWorksNavigationStyle", T("Like SolidWorks")),
+    ("Gui::SiemensNXNavigationStyle", T("Like Siemens NX")),
+    ("Gui::RevitNavigationStyle", T("Like Revit")),
+    ("Gui::BlenderNavigationStyle", T("Like Blender")),
+    ("Gui::OpenCascadeNavigationStyle", T("Like Open CASCADE")),
+    ("Gui::CADNavigationStyle", T("FreeCAD's CAD style")),
+    ("Gui::InventorNavigationStyle", T("FreeCAD's Inventor style")),
+    ("Gui::OpenSCADNavigationStyle", T("Like OpenSCAD")),
+    ("Gui::MayaGestureNavigationStyle", T("Like Maya")),
+]
+
+
+class Page(QtWidgets.QWidget):
+    """A page of settings: rows of a label and a control, each saved when changed"""
+
+    def __init__(self, title, parent=None):
+        super().__init__(parent)
+        self.title = title
+        self.form = QtWidgets.QFormLayout(self)
+        self.form.setLabelAlignment(QtCore.Qt.AlignRight | QtCore.Qt.AlignVCenter)
+        head = QtWidgets.QLabel("<h2>{}</h2>".format(translate("UnifiedSettings", title)), self)
+        self.form.addRow(head)
+        self.words = [translate("UnifiedSettings", title)]
+
+    def note(self, text):
+        label = QtWidgets.QLabel(translate("UnifiedSettings", text), self)
+        label.setWordWrap(True)
+        label.setStyleSheet("color: palette(mid);")
+        self.form.addRow(label)
+        self.words.append(label.text())
+
+    def check(self, text, group, name, default, on_change=None):
+        box = QtWidgets.QCheckBox(translate("UnifiedSettings", text), self)
+        box.setChecked(P(group).GetBool(name, default))
+
+        def changed(on):
+            P(group).SetBool(name, bool(on))
+            if on_change:
+                on_change(on)
+
+        box.toggled.connect(changed)
+        self.form.addRow(box)
+        self.words.append(box.text())
+        return box
+
+    def choice(self, text, items, current, on_change):
+        combo = QtWidgets.QComboBox(self)
+        for value, label in items:
+            combo.addItem(translate("UnifiedSettings", label), value)
+        index = max(0, combo.findData(current))
+        combo.setCurrentIndex(index)
+        combo.currentIndexChanged.connect(lambda i: on_change(combo.itemData(i)))
+        self.form.addRow(translate("UnifiedSettings", text), combo)
+        self.words += [translate("UnifiedSettings", text)] + [combo.itemText(i) for i in range(combo.count())]
+        return combo
+
+    def number(self, text, group, name, default, low, high, suffix=""):
+        spin = QtWidgets.QSpinBox(self)
+        spin.setRange(low, high)
+        spin.setValue(P(group).GetInt(name, default))
+        if suffix:
+            spin.setSuffix(" " + translate("UnifiedSettings", suffix))
+        spin.valueChanged.connect(lambda v: P(group).SetInt(name, int(v)))
+        self.form.addRow(translate("UnifiedSettings", text), spin)
+        self.words.append(translate("UnifiedSettings", text))
+        return spin
+
+    def embed(self, page):
+        """A page object of UnifiedPreferences (form, loadSettings, saveSettings)"""
+        page.loadSettings()
+        self.form.addRow(page.form)
+        for kind in (QtWidgets.QLabel, QtWidgets.QAbstractButton, QtWidgets.QGroupBox):
+            for w in page.form.findChildren(kind):
+                text = w.title() if isinstance(w, QtWidgets.QGroupBox) else w.text()
+                if text:
+                    self.words.append(text)
+        return page
+
+
+def basic_page():
+    page = Page(T("Basic"))
+    units = Gui.Selection  # noqa: F841 (keeps the import of the GUI)
+    schemas = [(0, T("Standard (mm, kg, s, °)")), (1, T("MKS (m, kg, s, °)")), (6, T("Metric small parts & CNC (mm, mm/min)")),
+               (5, T("Building Euro (cm, m², m³)")), (3, T("Imperial decimal (in, lb)"))]
+    page.choice(T("Units"), schemas, P("Units").GetInt("UserSchema", 0),
+                lambda v: (P("Units").SetInt("UserSchema", int(v)), _apply_units(int(v))))
+    page.number(T("Decimals"), "Units", "Decimals", 2, 0, 8)
+    page.check(T("Show the start page when FreeCAD starts"), "Mod/Start", "ShowOnStartup", True)
+    page.check(T("Show FreeCAD's menus and toolbars instead of ☰ and the tool strip (next start)"),
+               "Mod/Unified", "ClassicChrome", False)
+    page.note(T("Language and theme: in “All preferences…” › General (they need a restart)."))
+    return page
+
+
+def _apply_units(schema):
+    try:
+        App.Units.setSchema(schema)
+    except Exception:
+        pass
+
+
+def mouse_page():
+    page = Page(T("Mouse and keys"))
+    page.choice(T("How the mouse turns and moves the view"), MOUSE,
+                P("View").GetString("NavigationStyle", "Gui::TinkerCADNavigationStyle"),
+                lambda v: P("View").SetString("NavigationStyle", v))
+    page.check(T("Zoom at the cursor"), "View", "ZoomAtCursor", True)
+    page.note(T("Keys of the tool strip: S sketch, E extrude, C cut out, H hole, F fillet, M move, D measure. "
+                "Ctrl+K finds any tool. They do nothing while you type text."))
+    return page
+
+
+def drawings_page():
+    page = Page(T("Drawings"))
+    page.choice(T("Projection"), [(1, T("Third angle (JIS, ASME)")), (0, T("First angle (ISO in Europe)"))],
+                P("Mod/TechDraw/General").GetInt("ProjectionAngle", 1),
+                lambda v: P("Mod/TechDraw/General").SetInt("ProjectionAngle", int(v)))
+    page.number(T("Decimals of sizes"), "Mod/TechDraw/Dimensions", "AltDecimals", 2, 0, 6)
+    page.note(T("New drawings: an A4 sheet with a title block, three views, center lines and sizes (“Make Drawing”)."))
+    return page
+
+
+def files_page():
+    page = Page(T("Files"))
+    page.check(T("Ask how to read a DXF file each time"), "Mod/Draft", "dxfShowDialog", False)
+    page.check(T("Keep a backup when saving"), "Document", "CreateBackupFiles", True)
+    page.check(T("Save for recovery every few minutes (from the next start)"), "Document", "AutoSaveEnabled", True)
+    page.number(T("Every"), "Document", "AutoSaveTimeout", 15, 1, 120, T("minutes"))
+    page.note(T("Formats in detail (STEP, IGES, DXF/DWG, STL…): “All preferences…” › Import-Export."))
+    return page
+
+
+def network_page():
+    page = Page(T("Network and accounts"))
+    import UnifiedPreferences
+
+    page.saved = [page.embed(UnifiedPreferences.NetworkPage()), page.embed(UnifiedPreferences.AIChatPage())]
+    return page
+
+
+def ai_page():
+    page = Page(T("AI"))
+    page.note(T("The AI shows each piece of code it wants to run and runs it only when you approve it."))
+    box = QtWidgets.QCheckBox(translate("UnifiedSettings", "Run the AI's code without asking (until FreeCAD closes)"), page)
+    try:
+        import AIChatGui
+
+        panel = AIChatGui.chat.panel
+    except Exception:
+        panel = None
+    if panel is None:
+        box.setEnabled(False)
+        box.setToolTip(translate("UnifiedSettings", "Open the AI first (AI at the top right)"))
+    else:
+        box.setChecked(panel.auto_box.isChecked())
+        box.toggled.connect(lambda on: panel.auto_box.setChecked(on))
+        panel.auto_box.toggled.connect(lambda on: (box.blockSignals(True), box.setChecked(on), box.blockSignals(False)))
+    page.form.addRow(box)
+    page.words.append(box.text())
+    page.note(T("The API key and the proxy: “Network and accounts”."))
+    return page
+
+
+class SettingsWindow(QtWidgets.QDialog):
+    def __init__(self, parent):
+        super().__init__(parent)
+        self.setObjectName("UnifiedSettings")
+        self.setWindowTitle(translate("UnifiedSettings", "Preferences"))
+        self.resize(1000, 660)
+        lay = QtWidgets.QVBoxLayout(self)
+        self.search = QtWidgets.QLineEdit(self)
+        self.search.setPlaceholderText(translate("UnifiedSettings", "Find a setting, e.g. proxy, JIS, touchpad"))
+        self.search.setClearButtonEnabled(True)
+        lay.addWidget(self.search)
+        row = QtWidgets.QHBoxLayout()
+        self.list = QtWidgets.QListWidget(self)
+        self.list.setObjectName("UnifiedSettingsKinds")
+        self.list.setMaximumWidth(230)
+        self.stack = QtWidgets.QStackedWidget(self)
+        row.addWidget(self.list)
+        row.addWidget(self.stack, 1)
+        lay.addLayout(row, 1)
+        bottom = QtWidgets.QHBoxLayout()
+        more = QtWidgets.QPushButton(translate("UnifiedSettings", "All preferences…"), self)
+        more.setToolTip(translate("UnifiedSettings", "FreeCAD's full preferences, every page of every module"))
+        more.clicked.connect(self.all_preferences)
+        bottom.addWidget(more)
+        bottom.addStretch(1)
+        close = QtWidgets.QPushButton(translate("UnifiedSettings", "Close"), self)
+        close.setDefault(True)
+        close.clicked.connect(self.accept)
+        bottom.addWidget(close)
+        lay.addLayout(bottom)
+        self.pages = [basic_page(), mouse_page(), drawings_page(), files_page(), network_page(), ai_page()]
+        for p in self.pages:
+            scroll = QtWidgets.QScrollArea(self)
+            scroll.setWidgetResizable(True)
+            scroll.setHorizontalScrollBarPolicy(QtCore.Qt.ScrollBarAlwaysOff)
+            scroll.setWidget(p)
+            self.stack.addWidget(scroll)
+            self.list.addItem(translate("UnifiedSettings", p.title))
+        self.list.currentRowChanged.connect(self.stack.setCurrentIndex)
+        self.list.setCurrentRow(0)
+        self.search.textChanged.connect(self.find)
+
+    def find(self, text):
+        """The first page that has the words (labels, choices) shows; the others are dimmed"""
+        import CommandSearchCore as core
+
+        key = core.fold(text)
+        first = None
+        for i, p in enumerate(self.pages):
+            hit = not key or any(key in core.fold(w) for w in p.words)
+            item = self.list.item(i)
+            item.setForeground(self.palette().color(QtGui.QPalette.Text if hit else QtGui.QPalette.Mid))
+            if hit and first is None:
+                first = i
+        if first is not None:
+            self.list.setCurrentRow(first)
+
+    def all_preferences(self):
+        self.save()
+        Gui.runCommand("Std_DlgPreferences")
+
+    def save(self):
+        for p in self.pages:
+            for embedded in getattr(p, "saved", []):
+                try:
+                    embedded.saveSettings()
+                except Exception as e:
+                    App.Console.PrintWarning("Preferences: {}\n".format(e))
+
+    def done(self, result):
+        self.save()
+        super().done(result)
+
+
+class SettingsCommand:
+    def GetResources(self):
+        return {
+            "Pixmap": "preferences-system",
+            "MenuText": QT_TRANSLATE_NOOP("Unified_Settings", "Preferences…"),
+            "ToolTip": QT_TRANSLATE_NOOP(
+                "Unified_Settings",
+                "Units, mouse, drawings, files, network and the AI, by what you want to set; changes take effect at once",
+            ),
+        }
+
+    def IsActive(self):
+        return True
+
+    def Activated(self):
+        SettingsWindow(Gui.getMainWindow()).exec()
+
+
+Gui.addCommand("Unified_Settings", SettingsCommand())
