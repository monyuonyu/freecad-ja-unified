From ec49205df88c99ac43c0cdcfc408bb04150c8a7f Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Sun, 27 Sep 2026 08:45:46 +0900
Subject: [PATCH 051/107] TechDraw: third-angle projection by default in the
 integrated environment, plainer projection texts

Japanese drawings (JIS B 0001) use third-angle projection. The
preference page shows the same default. In Japanese, the projection
group panel says what its parts are (front view, the views around it,
horizontal and vertical spacing).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/Mod/TechDraw/App/Preferences.cpp             |  6 +++++-
 .../TechDraw/Gui/DlgPrefsTechDrawGeneralImp.cpp  |  2 ++
 .../Gui/Resources/translations/TechDraw_ja.ts    | 16 ++++++++--------
 3 files changed, 15 insertions(+), 9 deletions(-)

diff --git a/src/Mod/TechDraw/App/Preferences.cpp b/src/Mod/TechDraw/App/Preferences.cpp
index 0eeeb569b..7192f1035 100644
--- a/src/Mod/TechDraw/App/Preferences.cpp
+++ b/src/Mod/TechDraw/App/Preferences.cpp
@@ -153,7 +153,11 @@ bool Preferences::useGlobalDecimals()
 
 int Preferences::projectionAngle()
 {
-    int defaultConvention = (int)DrawProjGroup::ViewProjectionConvention::FirstAngle;
+    // The integrated working environment is made for Japanese users first: Japanese
+    // drawings (JIS B 0001) use third-angle projection
+    int defaultConvention = App::Application::Config().contains("SingleWorkbench")
+        ? (int)DrawProjGroup::ViewProjectionConvention::ThirdAngle
+        : (int)DrawProjGroup::ViewProjectionConvention::FirstAngle;
     return getPreferenceGroup("General")->GetInt("ProjectionAngle",
                                                  defaultConvention);
 }
diff --git a/src/Mod/TechDraw/Gui/DlgPrefsTechDrawGeneralImp.cpp b/src/Mod/TechDraw/Gui/DlgPrefsTechDrawGeneralImp.cpp
index 61731b6ee..baa64a5c0 100644
--- a/src/Mod/TechDraw/Gui/DlgPrefsTechDrawGeneralImp.cpp
+++ b/src/Mod/TechDraw/Gui/DlgPrefsTechDrawGeneralImp.cpp
@@ -105,6 +105,8 @@ void DlgPrefsTechDrawGeneralImp::loadSettings()
     ui->pfb_LabelFont->onRestore();
     ui->plsb_LabelSize->onRestore();
 
+    // The default depends on the environment (see Preferences::projectionAngle())
+    ui->cbProjAngle->setCurrentIndex(Preferences::projectionAngle());
     ui->cbProjAngle->onRestore();
     ui->cbSectionLineStd->onRestore();
 
