diff --git a/src/Mod/Assembly/UtilsAssembly.py b/src/Mod/Assembly/UtilsAssembly.py
index ca70482b8..c33405dd9 100644
--- a/src/Mod/Assembly/UtilsAssembly.py
+++ b/src/Mod/Assembly/UtilsAssembly.py
@@ -1235,6 +1235,36 @@ def findPlacement(ref, ignoreVertex=False):
     return plc
 
 
+def besidePlacement(assembly, added):
+    """Where `added` goes to the right of the other parts of the assembly, or None if it is the
+    first or the sizes cannot be read"""
+    others = App.BoundBox()
+    for obj in assembly.Group:  # its parts (and sub-assemblies), not what they link to
+        if obj.Name == added.Name or not hasattr(obj, "Shape"):
+            continue
+        if not (obj.isDerivedFrom("App::Link") or obj.isDerivedFrom("Part::Feature")
+                or obj.isDerivedFrom("App::Part") or obj.isDerivedFrom("PartDesign::Body")):
+            continue
+        try:
+            bb = obj.Shape.BoundBox
+        except Exception:
+            continue
+        if bb.isValid():
+            others.add(bb)
+    if not others.isValid():
+        return None
+    try:
+        own = added.Shape.BoundBox
+    except Exception:
+        return None
+    if not own.isValid():
+        return None
+    gap = max(10.0, 0.2 * max(own.XLength, own.YLength, own.ZLength))
+    base = App.Vector(added.Placement.Base)
+    # the shape's box is where it is now: move it by the difference
+    return base + App.Vector(others.XMax + gap - own.XMin, others.Center.y - own.Center.y, others.ZMin - own.ZMin)
+
+
