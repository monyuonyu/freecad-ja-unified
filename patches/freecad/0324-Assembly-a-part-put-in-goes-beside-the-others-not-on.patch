diff --git a/src/Mod/Unified/TestAssemblySolve.py b/src/Mod/Unified/TestAssemblySolve.py
index a225066b7..c0eadb1a1 100644
--- a/src/Mod/Unified/TestAssemblySolve.py
+++ b/src/Mod/Unified/TestAssemblySolve.py
@@ -161,6 +161,26 @@ class AssemblySolveTest(unittest.TestCase):
         finally:
             App.closeDocument(doc.Name)
 
+    def test_parts_put_beside_each_other(self):
+        # each part put in goes to the right of the others, not on top of them
+        import UtilsAssembly
+
+        doc = App.newDocument("beside")
+        try:
+            asm = doc.addObject("Assembly::AssemblyObject", "Assembly")
+            a = asm.newObject("Part::Box", "A")
+            a.Length = 40
+            doc.recompute()
+            self.assertIsNone(UtilsAssembly.besidePlacement(asm, a))
+            b = asm.newObject("Part::Box", "B")
+            doc.recompute()
+            b.Placement.Base = UtilsAssembly.besidePlacement(asm, b)
+            doc.recompute()
+            self.assertAlmostEqual(b.Shape.BoundBox.XMin, 40 + 10, places=6)
+            self.assertFalse(a.Shape.BoundBox.intersect(b.Shape.BoundBox))
+        finally:
+            App.closeDocument(doc.Name)
+
     def test_slide_on_ground(self):
         import AssemblyCopies
 
