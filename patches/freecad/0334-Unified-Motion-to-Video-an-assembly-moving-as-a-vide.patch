+# SPDX-License-Identifier: LGPL-2.1-or-later
+# A video of an assembly moving (MotionVideo.py), without the screen:
+#   FreeCADCmd -t TestMotionVideo
+
+import os
+import shutil
+import tempfile
+import unittest
+
+import FreeCAD as App
+
+import MotionVideo
+
+
+class MotionVideoTest(unittest.TestCase):
+    def test_angles(self):
+        self.assertEqual(MotionVideo.angles(0, 360, 4), [0, 90, 180, 270])  # a whole turn: 360 left out
+        self.assertEqual(MotionVideo.angles(0, 90, 4), [0, 30, 60, 90])
+
+    def test_crank(self):
+        import TestAssemblySolve
+
+        doc, sheet, asm, piston, r, L = TestAssemblySolve.build(revolute_drive=True)
+        tmp = tempfile.mkdtemp()
+        try:
+            asm.Type = "Assembly"
+            drive = doc.getObject("Drive")
+            out, failed = MotionVideo.export(drive, os.path.join(tmp, "crank.gif"), 0, 360, 8,
+                                             view="front", size=(160, 160))  # fmt: skip
+            self.assertEqual(failed, [])
+            self.assertTrue(out.endswith(".gif") and os.path.getsize(out) > 0)
+            from PIL import Image
+
+            self.assertEqual(Image.open(out).n_frames, 8)
+            # the formula of the angle is put back
+            self.assertIn("Params.theta", MotionVideo.formula(drive, "Angle"))
+            if MotionVideo.ffmpeg():
+                out, failed = MotionVideo.export(drive, os.path.join(tmp, "crank.mp4"), 0, 360, 8,
+                                                 view="front", size=(160, 160))  # fmt: skip
+                self.assertTrue(out.endswith(".mp4") and os.path.getsize(out) > 0)
+        finally:
+            App.closeDocument(doc.Name)
+            shutil.rmtree(tmp)
+
+
+if __name__ == "__main__":
+    unittest.main()
-- 
