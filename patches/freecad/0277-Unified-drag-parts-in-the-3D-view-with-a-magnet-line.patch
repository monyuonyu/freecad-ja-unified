diff --git a/src/Mod/Unified/MagnetDrag.py b/src/Mod/Unified/MagnetDrag.py
index c38e54bb1..c923a1437 100644
--- a/src/Mod/Unified/MagnetDrag.py
+++ b/src/Mod/Unified/MagnetDrag.py
@@ -925,3 +925,71 @@ def _overlap(alo, ahi, blo, bhi, n):
     return all(s > 1e-6 for s in sides)
 
 
+
+
+# --- the part that moves -------------------------------------------------------------------
+
+
+def choose_movable(candidates, selected=()):
+    """What a drag moves: the part the pressed face belongs to (as SnapMath reads it: a Body,
+    a shape, a link, not a step inside a body or a link); or, when a container around it is
+    selected as a whole (an App::Part, an imported assembly), that container."""
+    if not candidates:
+        return None
+    chosen = candidates[0]
+    for m in candidates:
+        if m.obj in selected:
+            chosen = m
+    return chosen
+
+
+def copy_kind(obj):
+    """How a drag with Ctrl copies: "link" for what is used as it is (imported shapes without
+    a history, App::Part assemblies, links), "copy" for what is edited here (a Body, a
+    parametric shape): a copy that can be changed on its own."""
+    if obj.isDerivedFrom("App::Link") or obj.isDerivedFrom("App::Part"):
+        return "link"
+    if obj.isDerivedFrom("PartDesign::Body"):
+        return "copy"
+    if obj.TypeId == "Part::Feature":
+        return "link"
+    return "copy"
+
+
+def _container(movable, pick):
+    obj = movable.obj
+    if pick is not None and movable.depth >= 1:
+        objs = pick.objects()
+        if movable.depth - 1 < len(objs):
+            return objs[movable.depth - 1]
+    if hasattr(obj, "getParentGeoFeatureGroup"):
+        parent = obj.getParentGeoFeatureGroup()
+        if parent is not None:
+            return parent
+    for parent in obj.InList:
+        if parent.isDerivedFrom("App::DocumentObjectGroup") and obj in parent.Group:
+            return parent
+    return None
+
+
+def duplicate(movable, pick=None):
+    """A copy of the part at the same place, in the same container; (Movable, kind)."""
+    import SnapMath as S
+
+    obj = movable.obj
+    kind = copy_kind(obj)
+    if kind == "copy":
+        return S.copy_of(movable, pick), kind
+    doc = obj.Document
+    link = doc.addObject("App::Link", obj.Name + "_Link")
+    source = obj.LinkedObject if obj.isDerivedFrom("App::Link") and obj.LinkedObject is not None else obj
+    link.LinkedObject = source
+    link.Label = obj.Label
+    link.Placement = obj.Placement
+    container = _container(movable, pick)
+    if container is not None and container.Document == doc and hasattr(container, "addObject"):
+        container.addObject(link)
+    copy = S.Movable(link, movable.parent, movable.depth)
+    copy.placement = App.Placement(movable.placement)
+    copy.offset = None
+    return copy, kind
diff --git a/src/Mod/Unified/MagnetDragGui.py b/src/Mod/Unified/MagnetDragGui.py
new file mode 100644
index 000000000..871d7dd08
--- /dev/null
+++ b/src/Mod/Unified/MagnetDragGui.py
@@ -0,0 +1,736 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+# Dragging a part in the 3D view (ドラッグで動かす) and the magnet (磁石).
+#
+# Press the left button on a part and drag: the part follows the cursor, no tool to start,
+# no handles. A click without moving still only selects. Faces that come near facing faces
+# of other parts snap flush, pins drop into holes, corners meet corners, and guide lines show
+# what lines up (MagnetDrag.py does the geometry). Alt: no magnet. Ctrl: drag a copy.
+# Esc: back to where it was. Releasing the button keeps it (one step to undo).
+#
+# The events are taken before the selection and the box selection see them: a callback node
+# in front of everything in the view's scene. While it does not take an event, the view
+# behaves as before (a drag on the empty background still selects with a box).
+
+import time
+
+import numpy as np
+
+import FreeCAD as App
+import FreeCADGui as Gui
+from PySide import QtCore, QtGui, QtWidgets
+
+import MagnetDrag as M
+import SnapMath as S
+
+translate = App.Qt.translate
+CTX = "Unified_Magnet"
+PARAMS = "User parameter:BaseApp/Preferences/Mod/Unified"
+NODE_NAME = "UnifiedMagnetDrag"
+
+
+def tr(text):
+    return translate(CTX, text)
+
+
+def _coin():
+    from pivy import coin
+
+    return coin
+
+
+def params():
+    return App.ParamGet(PARAMS)
+
+
+def enabled():
+    return params().GetBool("DragParts", True)
+
+
+def magnet_pixels():
+    return max(2, params().GetInt("MagnetPixels", 12))
+
+
+def status(text, ms=6000):
+    mw = Gui.getMainWindow()
+    if mw is not None:
+        if text:
+            mw.statusBar().showMessage(text, ms)
+        else:
+            mw.statusBar().clearMessage()
+
+
+# --- the other parts: what the moving part can snap to -------------------------------------
+
+_cache = {}  # (document, root, path) -> (signature, Lazy)
+
+
+def _is_container(obj):
+    linked = obj.getLinkedObject(True)
+    if getattr(obj, "ElementCount", 0):
+        return True
+    if linked.isDerivedFrom("PartDesign::Body"):
+        return False
+    if linked.isDerivedFrom("App::DocumentObjectGroup"):
+        return True
+    return linked.hasExtension("App::GeoFeatureGroupExtension") or linked.hasExtension("App::GroupExtension")
+
+
+def _visible(obj):
+    vo = getattr(obj, "ViewObject", None)
+    if vo is not None:
+        try:
+            return bool(vo.Visibility)
+        except Exception:
+            pass
+    return bool(getattr(obj, "Visibility", True))
+
+
+def _leaves(doc):
+    """(root, path) of every visible part of the document (Bodies, shapes, links to them),
+    through containers and links."""
+    out = []
+
+    def walk(root, obj, sub, depth):
+        if depth > 12:
+            return
+        if _is_container(obj):
+            try:
+                names = obj.getSubObjects()
+            except Exception:
+                names = ()
+            for name in names:
+                child = obj.getSubObject(name, retType=1)
+                if child is None:
+                    continue
+                vis = obj.isElementVisible(name.rstrip("."))
+                if vis == 0 or (vis < 0 and not child.Visibility):
+                    continue
+                walk(root, child, sub + name, depth + 1)
+            return
+        linked = obj.getLinkedObject(True)
+        if linked.isDerivedFrom("App::Origin") or linked.isDerivedFrom("App::DatumElement"):
+            return
+        if not hasattr(linked, "Shape") or linked.isDerivedFrom("Part::Part2DObject"):
+            return
+        out.append((root, sub))
+
+    for root in doc.RootObjects:
+        if not _visible(root):
+            continue
+        walk(root, root, "", 0)
+    return out
+
+
+def _signature(root, sub):
+    try:
+        place = root.getSubObject(sub, retType=3) if sub else root.getSubObject("", retType=3)
+        obj = root.getSubObject(sub, retType=1) if sub else root
+        linked = obj.getLinkedObject(True)
+        shape = getattr(linked, "Shape", None)
+        return (tuple(round(x, 9) for x in place.toMatrix().A), shape.hashCode() if shape is not None else 0)
+    except Exception:
+        return None
+
+
+def _global_shape(root, sub):
+    import Part
+
+    try:
+        shape = Part.getShape(root, sub, needSubElement=False, transform=True)
+    except Exception:
+        return None
+    if shape is None or shape.isNull():
+        return None
+    return shape
+
+
+def targets_for(doc, excluded):
+    """Targets of all visible parts except those that contain or are inside the excluded
+    objects (what moves)."""
+    items = []
+    seen = set()
+    for root, sub in _leaves(doc):
+        try:
+            objs = root.getSubObjectList(sub) if sub else [root]
+        except Exception:
+            objs = [root]
+        if any(o in excluded for o in objs):
+            continue
+        key = (doc.Name, root.Name, sub)
+        if key in seen:
+            continue
+        seen.add(key)
+        sig = _signature(root, sub)
+        cached = _cache.get(key)
+        if cached is not None and cached[0] == sig and sig is not None:
+            items.append((key, cached[1]))
+            continue
+        shape = _global_shape(root, sub)
+        if shape is None or not shape.Faces:
+            continue
+        bb = shape.BoundBox
+        lazy = M.Lazy((bb.XMin, bb.YMin, bb.ZMin), (bb.XMax, bb.YMax, bb.ZMax), lambda s=shape: M.capture(s))
+        _cache[key] = (sig, lazy)
+        items.append((key, lazy))
+    return M.Targets(items)
+
+
+def moving_geometry(movable):
+    import Part
+
+    try:
+        shape = Part.getShape(movable.obj, "", needSubElement=False, transform=False)
+    except Exception:
+        shape = None
+    if shape is None or shape.isNull():
+        return M.Geometry()
+    shape = shape.copy()
+    shape.Placement = movable.global_placement().multiply(shape.Placement)
+    return M.capture(shape)
+
+
+# --- what is drawn while dragging -----------------------------------------------------------
+
+
+class Overlay:
+    """The faces the part snaps to (orange), the guide lines (magenta, dashed) and the corners
+    that meet (markers)."""
+
+    FACE = (1.0, 0.5, 0.0)
+    GUIDE = (0.85, 0.0, 0.75)
+
+    def __init__(self, view):
+        coin = _coin()
+        self.view = view
+        self.root = coin.SoSeparator()
+        self.root.setName("UnifiedMagnetOverlay")
+        style = coin.SoPickStyle()
+        style.style = coin.SoPickStyle.UNPICKABLE
+        self.root.addChild(style)
+        # Faces: drawn over the model, see-through
+        faces = coin.SoSeparator()
+        mat = coin.SoMaterial()
+        mat.diffuseColor = self.FACE
+        mat.emissiveColor = (0.6, 0.25, 0.0)
+        mat.transparency = 0.45
+        faces.addChild(mat)
+        offset = coin.SoPolygonOffset()
+        offset.factor = -2.0
+        offset.units = -2.0
+        faces.addChild(offset)
+        self.face_coords = coin.SoCoordinate3()
+        self.face_set = coin.SoIndexedFaceSet()
+        faces.addChild(self.face_coords)
+        faces.addChild(self.face_set)
+        self.root.addChild(faces)
+        top = coin.SoAnnotation()
+        guides = coin.SoSeparator()
+        color = coin.SoBaseColor()
+        color.rgb = self.GUIDE
+        draw = coin.SoDrawStyle()
+        draw.lineWidth = 2
+        draw.linePattern = 0xF0F0
+        self.guide_coords = coin.SoCoordinate3()
+        self.guide_lines = coin.SoLineSet()
+        guides.addChild(color)
+        guides.addChild(draw)
+        guides.addChild(self.guide_coords)
+        guides.addChild(self.guide_lines)
+        top.addChild(guides)
+        markers = coin.SoSeparator()
+        mcolor = coin.SoBaseColor()
+        mcolor.rgb = self.FACE
+        self.marker_coords = coin.SoCoordinate3()
+        self.marker_set = coin.SoMarkerSet()
+        self.marker_set.markerIndex = Gui.getMarkerIndex("CIRCLE_FILLED", 9)
+        markers.addChild(mcolor)
+        markers.addChild(self.marker_coords)
+        markers.addChild(self.marker_set)
+        top.addChild(markers)
+        self.root.addChild(top)
+        self._tess = {}
+        self.clear()
+        view.getSceneGraph().addChild(self.root)
+
+    def clear(self):
+        self.face_coords.point.setNum(0)
+        self.face_set.coordIndex.setNum(0)
+        self.guide_coords.point.setNum(0)
+        self.guide_lines.numVertices.setNum(0)
+        self.marker_coords.point.setNum(0)
+        self.marker_set.numPoints = 0
+
+    def _triangles(self, key, face):
+        if key not in self._tess:
+            try:
+                pts, tris = face.tessellate(max(face.BoundBox.DiagonalLength / 200.0, 0.01))
+            except Exception:
+                pts, tris = [], []
+            self._tess[key] = ([(p.x, p.y, p.z) for p in pts], tris)
+        return self._tess[key]
+
+    def show(self, targets, result):
+        self.clear()
+        if result is None:
+            return
+        points, index = [], []
+        corners = []
+        for s in result.snaps:
+            if s.kind == "corner":
+                corners.append(tuple(s.point))
+                continue
+            if s.kind == "flush":
+                continue
+            key, geom = targets.items[s.part]
+            pts, tris = self._triangles((key, s.elem), geom.faces[s.elem])
+            base = len(points)
+            points.extend(pts)
+            for a, b, c in tris:
+                index.extend((base + a, base + b, base + c, -1))
+        if points:
+            self.face_coords.point.setValues(0, len(points), points)
+            self.face_set.coordIndex.setValues(0, len(index), index)
+        if result.guides:
+            line_points = []
+            for a, b in result.guides:
+                line_points.extend((tuple(a), tuple(b)))
+            self.guide_coords.point.setValues(0, len(line_points), line_points)
+            self.guide_lines.numVertices.setValues(0, len(result.guides), [2] * len(result.guides))
+        if corners:
+            self.marker_coords.point.setValues(0, len(corners), corners)
+            self.marker_set.numPoints = len(corners)
+
+    def remove(self):
+        try:
+            self.view.getSceneGraph().removeChild(self.root)
+        except Exception:
+            pass
+
+
+# --- the drag -------------------------------------------------------------------------------
+
+MESSAGES = {
+    "support": "On the face",
+    "contact": "Faces together",
+    "axis": "On one axis",
+    "hole": "Into the hole",
+    "corner": "Corner on corner",
+    "flush": "Lined up",
+}
+
+
+def _describe(result):
+    if result is None or not result.snaps:
+        return ""
+    seen = []
+    for s in result.snaps:
+        text = tr(MESSAGES[s.kind])
+        if text not in seen:
+            seen.append(text)
+    return " ・ ".join(seen)
+
+
+class _KeyFilter(QtCore.QObject):
+    """Esc and Alt while a part is dragged (the keyboard focus may be anywhere)."""
+
+    def __init__(self, drag):
+        super().__init__()
+        self.drag = drag
+
+    def eventFilter(self, obj, event):
+        t = event.type()
+        if t in (QtCore.QEvent.ShortcutOverride, QtCore.QEvent.KeyPress, QtCore.QEvent.KeyRelease):
+            key = event.key()
+            if key == QtCore.Qt.Key_Escape:
+                if t == QtCore.QEvent.KeyPress:
+                    QtCore.QTimer.singleShot(0, self.drag.cancel)
+                event.accept()
+                return True
+            if key == QtCore.Qt.Key_Alt and t != QtCore.QEvent.ShortcutOverride:
+                alt = t == QtCore.QEvent.KeyPress
+                QtCore.QTimer.singleShot(0, lambda: self.drag.refresh(alt))
+                return True
+        return False
+
+
+class Drag:
+    """One drag, from the first movement to the release (or Esc)."""
+
+    def __init__(self, handler, pick, movable, copy):
+        self.handler = handler
+        self.view = handler.view
+        self.pick = pick
+        self.doc = movable.obj.Document
+        self.copy_kind = None
+        self.started = time.perf_counter()
+        self.times = []
+        self.result = None
+        self.last_pos = None
+        self.alt = False
+        self.closed = False
+        self.attached = S.check_movable(movable) == "attached"
+        self.doc.openTransaction(tr("Drag a copy") if copy else tr("Drag"))
+        self.original = movable
+        geometry = moving_geometry(movable)
+        if copy:
+            movable, self.copy_kind = M.duplicate(movable, pick)
+        self.movable = movable
+        excluded = {movable.obj, self.original.obj}
+        self.targets = targets_for(self.doc, excluded if not copy else {movable.obj})
+        if copy:
+            # The original stays where it is and is something to snap to
+            pass
+        self.solver = M.Drag(geometry, pick.point, self._view_dir(), self.targets)
+        self.overlay = Overlay(self.view)
+        self.filter = _KeyFilter(self)
+        QtWidgets.QApplication.instance().installEventFilter(self.filter)
+
+    def _view_dir(self):
+        d = self.view.getViewDirection()
+        return (d.x, d.y, d.z)
+
+    def _ray(self, pos):
+        from pivy import coin
+
+        p = self.view.getPoint(pos[0], pos[1])
+        cam = self.view.getCameraNode()
+        if isinstance(cam, coin.SoPerspectiveCamera):
+            e = cam.position.getValue()
+            o = np.array((e[0], e[1], e[2]))
+            d = np.array((p.x, p.y, p.z)) - o
+        else:
+            vd = self.view.getViewDirection()
+            d = np.array((vd.x, vd.y, vd.z))
+            o = np.array((p.x, p.y, p.z)) - d * 1e6
+        return o, d / np.linalg.norm(d)
+
+    def _tolerance(self, pos):
+        """The magnet's reach in mm at the grabbed point: its pixels there."""
+        res = self.solver.last
+        g = self.solver.g0 if res is None else res.R.dot(self.solver.g0 - res.g0) + res.g0 + res.t
+        n = np.array(self._view_dir())
+        o1, d1 = self._ray(pos)
+        o2, d2 = self._ray((pos[0] + magnet_pixels(), pos[1]))
+        a = M.ray_plane(o1, d1, g, n)
+        b = M.ray_plane(o2, d2, g, n)
+        if a is None or b is None:
+            return 0.0
+        return float(np.linalg.norm(b - a))
+
+    def move_to(self, pos, alt):
+        if self.closed:
+            return
+        t0 = time.perf_counter()
+        self.last_pos = pos
+        self.alt = alt
+        o, d = self._ray(pos)
+        result = self.solver.solve(o, d, self._tolerance(pos), snapping=not alt)
+        if result is None:
+            return
+        self.result = result
+        try:
+            S.apply(self.movable, result.placement)
+        except Exception as err:
+            status(str(err))
+            return
+        self.overlay.show(self.targets, None if alt else result)
+        text = _describe(result) if not alt else tr("No magnet (Alt)")
+        status(text or tr("Drag: Alt without magnet, Esc puts it back"), 0)
+        self.times.append(time.perf_counter() - t0)
+
+    def refresh(self, alt):
+        if self.last_pos is not None and not self.closed:
+            self.move_to(self.last_pos, alt)
+            self.view.redraw()
+
+    def _close(self):
+        self.closed = True
+        QtWidgets.QApplication.instance().removeEventFilter(self.filter)
+        self.overlay.remove()
+        self.handler.drag = None
+
+    def finish(self):
+        if self.closed:
+            return
+        self._close()
+        try:
+            self.doc.recompute()
+        except Exception:
+            pass
+        self.doc.commitTransaction()
+        self._select()
+        moved = self.movable.obj.Label
+        if self.copy_kind == "link":
+            text = tr("Placed a link to {} (same shape, changes with it)").format(moved)
+        elif self.copy_kind == "copy":
+            text = tr("Placed a copy of {}").format(moved)
+        else:
+            text = tr("Moved {}").format(moved)
+        if self.attached:
+            text += tr(" (still attached: its offset changed)")
+        snaps = _describe(self.result)
+        if snaps:
+            text += " ― " + snaps
+        status(text)
+        if self.times and params().GetBool("DragTimingLog", False):
+            ts = sorted(self.times)
+            App.Console.PrintLog(
+                "MagnetDrag: {} moves, median {:.1f} ms, worst {:.1f} ms, {} parts\n".format(
+                    len(ts), ts[len(ts) // 2] * 1000, ts[-1] * 1000, len(self.targets.items)
+                )
+            )
+        self.handler.timings = list(self.times)
+
+    def cancel(self):
+        if self.closed:
+            return
+        self._close()
+        self.doc.abortTransaction()
+        self.handler.swallow = True
+        status(tr("Put back"))
+        self.view.redraw()
+
+    def _select(self):
+        """The part that was dragged is selected afterwards (its tools show on the bar)."""
+        try:
+            obj = self.movable.obj
+            root = self.pick.root
+            Gui.Selection.clearSelection()
+            objs = self.pick.objects()
+            if obj == root or self.movable.depth == 0:
+                Gui.Selection.addSelection(obj.Document.Name, obj.Name)
+                return
+            tokens = self.pick.tokens
+            depth = self.movable.depth
+            if obj in objs:
+                path = ".".join(tokens[:depth]) + "."
+            else:
+                # A copy: the same container as the original
+                path = ".".join(tokens[: depth - 1] + [obj.Name]) + "."
+            Gui.Selection.addSelection(root.Document.Name, root.Name, path)
+        except Exception:
+            pass
+
+
+class Handler:
+    """The callback node of one 3D view."""
+
+    def __init__(self, view):
+        coin = _coin()
+        self.view = view
+        self.node = coin.SoEventCallback()
+        self.node.setName(NODE_NAME)
+        self.node.addEventCallback(coin.SoEvent.getClassTypeId(), self._event)
+        view.getViewer().getSceneGraph().insertChild(self.node, 0)
+        self.press = None  # (x, y, ctrl, shift)
+        self.drag = None
+        self.swallow = False  # take the events up to the release (after Esc, or not movable)
+        self.timings = []
+
+    def remove(self):
+        try:
+            self.view.getViewer().getSceneGraph().removeChild(self.node)
+        except Exception:
+            pass
+
+    def _event(self, *args):
+        node = args[-1]
+        try:
+            self._handle(node)
+        except Exception as err:  # never break the view
+            App.Console.PrintWarning("Drag: {}\n".format(err))
+            if self.drag is not None:
+                try:
+                    self.drag.cancel()
+                except Exception:
+                    pass
+
+    def _handle(self, node):
+        coin = _coin()
+        ev = node.getEvent()
+        if ev.isOfType(coin.SoMouseButtonEvent.getClassTypeId()):
+            if ev.getButton() != coin.SoMouseButtonEvent.BUTTON1:
+                if self.drag is not None or self.swallow:
+                    node.setHandled()
+                return
+            down = ev.getState() == coin.SoButtonEvent.DOWN
+            if down:
+                self.press = None
+                self.swallow = False
+                if self.drag is None and self._may_start():
+                    pos = ev.getPosition().getValue()
+                    self.press = (int(pos[0]), int(pos[1]), ev.wasCtrlDown(), ev.wasShiftDown())
+                return
+            # released
+            self.press = None
+            if self.drag is not None:
+                node.setHandled()
+                self.drag.finish()
+            elif self.swallow:
+                node.setHandled()
+                self.swallow = False
+            return
+        if ev.isOfType(coin.SoLocation2Event.getClassTypeId()):
+            pos = ev.getPosition().getValue()
+            pos = (int(pos[0]), int(pos[1]))
+            if self.drag is not None:
+                node.setHandled()
+                self.drag.move_to(pos, ev.wasAltDown())
+                return
+            if self.swallow:
+                node.setHandled()
+                return
+            if self.press is None:
+                return
+            dx, dy = pos[0] - self.press[0], pos[1] - self.press[1]
+            if (dx * dx + dy * dy) ** 0.5 <= QtWidgets.QApplication.startDragDistance():
+                return
+            press, self.press = self.press, None
+            if self._start(press):
+                node.setHandled()
+                if self.drag is not None:
+                    self.drag.move_to(pos, ev.wasAltDown())
+            return
+        if ev.isOfType(coin.SoKeyboardEvent.getClassTypeId()) and (self.drag is not None):
+            if ev.getKey() == coin.SoKeyboardEvent.ESCAPE:
+                node.setHandled()
+                if ev.getState() == coin.SoButtonEvent.DOWN:
+                    self.drag.cancel()
+
+    def _may_start(self):
+        if not enabled():
+            return False
+        gdoc = Gui.ActiveDocument
+        if gdoc is None or gdoc.getInEdit() is not None:
+            return False
+        try:
+            if Gui.Control.activeDialog():
+                return False
+        except Exception:
+            pass
+        return True
+
+    def _pick(self, pos):
+        info = self.view.getObjectInfo(pos)
+        if not info:
+            return None
+        root = info.get("ParentObject")
+        sub = info.get("SubName")
+        if root is None or not sub:
+            try:
+                root = App.getDocument(info["Document"]).getObject(info["Object"])
+            except Exception:
+                return None
+            sub = info.get("Component")
+        if root is None or not sub:
+            return None
+        return S.Pick(root, sub, App.Vector(info["x"], info["y"], info["z"]))
+
+    def _start(self, press):
+        """Start dragging what is under the press; True if the events are ours from now on."""
+        x, y, ctrl, shift = press
+        if shift:
+            return False
+        pick = self._pick((x, y))
+        if pick is None:
+            return False
+        try:
+            candidates = S.movable_candidates(pick)
+        except Exception:
+            candidates = []
+        selected = {s.Object for s in Gui.Selection.getSelectionEx("", 0) if not s.SubElementNames}
+        selected |= {s.Object for s in Gui.Selection.getSelectionEx() if not s.SubElementNames}
+        movable = M.choose_movable(candidates, selected)
+        if movable is None:
+            return False
+        problem = S.check_movable(movable)
+        if problem in ("expression", "readonly"):
+            status(
+                tr("{} does not move by dragging: its place is set by a formula or locked").format(movable.obj.Label),
+                8000,
+            )
+            self.swallow = True
+            return True
+        if _grounded(movable.obj):
+            status(tr("{} is fixed in its assembly (grounded): it does not move by dragging").format(movable.obj.Label), 8000)
+            self.swallow = True
+            return True
+        Gui.Selection.clearPreselection()
+        self.drag = Drag(self, pick, movable, copy=ctrl)
+        return True
+
+
+def _grounded(obj):
+    for parent in obj.InList:
+        if getattr(parent, "ObjectToGround", None) == obj:
+            return True
+    return False
+
+
+# --- every 3D view gets one --------------------------------------------------------------------
+
+_handlers = []
+
+
+def _attach(view):
+    if view is None or not hasattr(view, "getViewer") or not hasattr(view, "getObjectInfo"):
+        return None
+    try:
+        root = view.getViewer().getSceneGraph()
+    except Exception:
+        return None
+    for h in _handlers:
+        try:
+            if h.view.getViewer().getSceneGraph() == root:
+                return h
+        except Exception:
+            continue
+    if root.getNumChildren() and root.getChild(0).getName() == NODE_NAME:
+        return None
+    h = Handler(view)
+    _handlers.append(h)
+    return h
+
+
+def _prune():
+    alive = []
+    for h in _handlers:
+        try:
+            h.view.getViewer()
+            alive.append(h)
+        except Exception:
+            pass
+    _handlers[:] = alive
+
+
+def attach_active(*_args):
+    _prune()
+    gdoc = Gui.ActiveDocument
+    if gdoc is None:
+        return None
+    return _attach(gdoc.ActiveView)
+
+
+def handler_of(view):
+    for h in _handlers:
+        try:
+            if h.view.getViewer().getSceneGraph() == view.getViewer().getSceneGraph():
+                return h
+        except Exception:
+            continue
+    return None
+
+
+_installed = []
+
+
+def install():
+    if _installed:
+        return
+    mw = Gui.getMainWindow()
+    mdi = mw.findChild(QtWidgets.QMdiArea) if mw else None
+    if mdi is None:
+        return
+    mdi.subWindowActivated.connect(lambda *_: QtCore.QTimer.singleShot(0, attach_active))
+    QtCore.QTimer.singleShot(0, attach_active)
+    _installed.append(mdi)
