+class DuplicateTest(unittest.TestCase):
+    """Ctrl+drag: what the copy is."""
+
+    def setUp(self):
+        self.doc = App.newDocument("MagnetDuplicate")
+
+    def tearDown(self):
+        App.closeDocument(self.doc.Name)
+
+    def test_kinds(self):
+        import SnapMath as S
+
+        body = self.doc.addObject("PartDesign::Body", "Body")
+        boxf = self.doc.addObject("Part::Box", "Box")
+        imported = self.doc.addObject("Part::Feature", "Imported")
+        imported.Shape = Part.makeBox(1, 2, 3)
+        asm = self.doc.addObject("App::Part", "Assembly")
+        link = self.doc.addObject("App::Link", "L")
+        link.LinkedObject = boxf
+        self.assertEqual(M.copy_kind(body), "copy")
+        self.assertEqual(M.copy_kind(boxf), "copy")
+        self.assertEqual(M.copy_kind(imported), "link")
+        self.assertEqual(M.copy_kind(asm), "link")
+        self.assertEqual(M.copy_kind(link), "link")
+
+    def test_link_copy_in_the_same_container_at_the_same_place(self):
+        import SnapMath as S
+
+        asm = self.doc.addObject("App::Part", "Assembly")
+        asm.Placement.Base = App.Vector(10, 0, 0)
+        imported = self.doc.addObject("Part::Feature", "Imported")
+        imported.Shape = Part.makeBox(1, 2, 3)
+        imported.Placement.Base = App.Vector(0, 5, 0)
+        asm.addObject(imported)
+        self.doc.recompute()
+        pick = S.Pick(asm, "Imported.Face1", App.Vector(10, 5, 0))
+        movable = S.movable_candidates(pick)[0]
+        self.assertEqual(movable.obj, imported)
+        copy, kind = M.duplicate(movable, pick)
+        self.assertEqual(kind, "link")
+        self.assertTrue(copy.obj.isDerivedFrom("App::Link"))
+        self.assertIn(copy.obj, asm.Group)
+        S.apply(copy, App.Placement(App.Vector(0, 0, 7), App.Rotation()))
+        self.doc.recompute()
+        self.assertEqual(asm.Placement.multiply(copy.obj.Placement).Base, App.Vector(10, 5, 7))
+        self.assertEqual(imported.Placement.Base, App.Vector(0, 5, 0))
+
+    def test_body_copy_is_independent(self):
+        import SnapMath as S
+
+        body = self.doc.addObject("PartDesign::Body", "Body")
+        box = self.doc.addObject("PartDesign::AdditiveBox", "Box")
+        body.addObject(box)
+        self.doc.recompute()
+        pick = S.Pick(body, "Box.Face1", App.Vector(0, 0, 0))
+        movable = M.choose_movable(S.movable_candidates(pick))
+        self.assertEqual(movable.obj, body)
+        copy, kind = M.duplicate(movable, pick)
+        self.assertEqual(kind, "copy")
+        self.assertTrue(copy.obj.isDerivedFrom("PartDesign::Body"))
+        self.assertNotEqual(copy.obj.Group[-1], box)
+
+
