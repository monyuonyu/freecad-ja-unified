+# SPDX-License-Identifier: LGPL-2.1-or-later
+# Tests of Arrange (lining parts up), headless:
+#   FreeCADCmd -t TestArrange
+
+import unittest
+
+import FreeCAD as App
+
+import Arrange as A
+import SnapMath as S
+
+
+class ArrangeTest(unittest.TestCase):
+    def setUp(self):
+        self.doc = App.newDocument("ArrangeTest")
+
+    def tearDown(self):
+        App.closeDocument(self.doc.Name)
+
+    def box(self, name, at, size=(10, 10, 10), container=None, rotation=None):
+        b = self.doc.addObject("Part::Box", name)
+        b.Length, b.Width, b.Height = size
+        b.Placement = App.Placement(App.Vector(*at), rotation or App.Rotation())
+        if container is not None:
+            container.addObject(b)
+        return b
+
+    def items(self, entries):
+        self.doc.recompute()
+        return A.items_of(A.movables_of_selection(entries))
+
+    def boxes(self):
+        a = self.box("A", (0, 0, 0))
+        b = self.box("B", (30, 7, 3), (20, 5, 8))
+        c = self.box("C", (70, -4, 1), (6, 6, 6))
+        self.entries = [(a, ""), (b, ""), (c, "")]
+        return a, b, c
+
+    def after(self):
+        self.doc.recompute()
+        return A.items_of(A.movables_of_selection(self.entries))
+
+    def test_align_left_center_right_to_the_first(self):
+        self.boxes()
+        for axis in range(3):
+            for where in ("min", "center", "max"):
+                items = A.items_of(A.movables_of_selection(self.entries))
+                ref = items[0].side(axis, where)
+                A.apply(items, A.align(items, axis, where))
+                for it in self.after():
+                    self.assertAlmostEqual(it.side(axis, where), ref, places=6)
+                # The other axes did not change
+                self.doc.recompute()
+
+    def test_align_to_the_extent_of_all(self):
+        self.boxes()
+        items = A.items_of(A.movables_of_selection(self.entries))
+        A.apply(items, A.align(items, 1, "max", A.REFERENCE_ALL))
+        for it in self.after():
+            self.assertAlmostEqual(it.high(1), 12.0, places=6)
+
+    def test_first_stays(self):
+        a, _b, _c = self.boxes()
+        items = A.items_of(A.movables_of_selection(self.entries))
+        A.apply(items, A.align(items, 2, "max"))
+        self.assertEqual(a.Placement.Base, App.Vector(0, 0, 0))
+
+    def test_equal_gaps_keep_the_outer_two(self):
+        self.boxes()
+        items = A.items_of(A.movables_of_selection(self.entries))
+        A.apply(items, A.distribute(items, 0))
+        out = sorted(self.after(), key=lambda i: i.low(0))
+        self.assertAlmostEqual(out[0].low(0), 0.0)
+        self.assertAlmostEqual(out[-1].high(0), 76.0)
+        g1 = out[1].low(0) - out[0].high(0)
+        g2 = out[2].low(0) - out[1].high(0)
+        self.assertAlmostEqual(g1, g2, places=6)
+        self.assertAlmostEqual(g1, (76 - 36) / 2.0, places=6)
+
+    def test_given_gap_around_the_reference(self):
+        self.boxes()
+        items = A.items_of(A.movables_of_selection(self.entries))
+        A.apply(items, A.distribute(items, 0, gap=5.0))
+        out = sorted(self.after(), key=lambda i: i.low(0))
+        self.assertAlmostEqual(out[0].low(0), 0.0)  # A, the reference, stays
+        self.assertAlmostEqual(out[1].low(0), 15.0)
+        self.assertAlmostEqual(out[2].low(0), 40.0)
+
+    def test_pack_in_pick_order(self):
+        a, b, c = self.boxes()
+        self.entries = [(c, ""), (a, ""), (b, "")]
+        items = A.items_of(A.movables_of_selection(self.entries))
+        A.apply(items, A.pack(items, 0))
+        out = self.after()
+        self.assertAlmostEqual(out[0].low(0), 70.0)
+        self.assertAlmostEqual(out[1].low(0), 76.0)
+        self.assertAlmostEqual(out[2].low(0), 86.0)
+        self.assertAlmostEqual(out[2].high(0), 106.0)
+
+    def test_turned_part_uses_its_tight_extent(self):
+        a = self.box("A", (0, 0, 0))
+        t = self.box("T", (50, 0, 0), (20, 2, 2), rotation=App.Rotation(App.Vector(0, 0, 1), 90))
+        self.entries = [(a, ""), (t, "")]
+        items = self.items(self.entries)
+        self.assertAlmostEqual(items[1].size(1), 20.0, places=4)
+        A.apply(items, A.align(items, 1, "min"))
+        out = self.after()
+        self.assertAlmostEqual(out[1].low(1), 0.0, places=4)
+
+    def test_parts_inside_app_parts(self):
+        outer = self.doc.addObject("App::Part", "Outer")
+        outer.Placement.Base = App.Vector(100, 0, 0)
+        inner = self.doc.addObject("App::Part", "Inner")
+        outer.addObject(inner)
+        inner.Placement = App.Placement(App.Vector(0, 50, 0), App.Rotation(App.Vector(0, 0, 1), 30))
+        deep = self.box("Deep", (5, 0, 0), container=inner)
+        top = self.box("Top", (0, 0, 20))
+        self.entries = [(top, ""), (outer, "Inner.Deep.")]
+        items = self.items(self.entries)
+        self.assertEqual(items[1].movable.obj, deep)
+        for where in ("min", "max"):
+            A.apply(items, A.align(items, 0, where))
+            out = self.after()
+            self.assertAlmostEqual(out[1].side(0, where), out[0].side(0, where), places=4)
+            items = out
+        # The containers did not move
+        self.assertEqual(outer.Placement.Base, App.Vector(100, 0, 0))
+
+    def test_attached_part_keeps_its_attachment(self):
+        a = self.box("A", (0, 0, 0))
+        b = self.box("B", (40, 0, 0))
+        b.AttachmentSupport = [(a, "Vertex1")]
+        b.MapMode = "Translate"
+        b.AttachmentOffset = App.Placement(App.Vector(40, 0, 0), App.Rotation())
+        self.doc.recompute()
+        self.entries = [(a, ""), (b, "")]
+        items = self.items(self.entries)
+        A.apply(items, A.align(items, 0, "min"))
+        self.doc.recompute()
+        self.assertEqual(b.MapMode, "Translate")
+        self.assertAlmostEqual(b.Placement.Base.x, 0.0, places=6)
+
+    def test_faces_are_not_parts(self):
+        a = self.box("A", (0, 0, 0))
+        self.doc.recompute()
+        self.assertEqual(A.movables_of_selection([(a, "Face1")]), [])
+
+    def test_words_follow_the_view(self):
+        top = A.axis_words(App.Vector(0, 0, -1), App.Vector(0, 1, 0), App.Vector(1, 0, 0))
+        self.assertEqual(top[0][:3], ("Left", "Center", "Right"))
+        self.assertEqual(top[1][:3], ("Bottom", "Middle", "Top"))
+        self.assertEqual(top[2][:3], ("Far", "Center", "Near"))
+        rear = A.axis_words(App.Vector(0, -1, 0), App.Vector(0, 0, 1), App.Vector(-1, 0, 0))
+        self.assertEqual(rear[0][:3], ("Right", "Center", "Left"))
+        iso = A.axis_words(App.Vector(-1, -1, -1), App.Vector(0, 0, 1), App.Vector(1, -1, 0))
+        self.assertEqual(iso, A.WORLD_WORDS)
+
+
+if __name__ == "__main__":
+    unittest.main()
