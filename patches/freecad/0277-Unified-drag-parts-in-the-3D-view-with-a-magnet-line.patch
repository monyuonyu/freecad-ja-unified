diff --git a/src/Mod/Unified/Arrange.py b/src/Mod/Unified/Arrange.py
new file mode 100644
index 000000000..805497bc4
--- /dev/null
+++ b/src/Mod/Unified/Arrange.py
@@ -0,0 +1,218 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+# Lining up several parts (そろえる), like the alignment of shapes in a slide program:
+# left / center / right (and front / back, bottom / top), spreading them with equal gaps or a
+# given gap, and packing them side by side in the order they were picked.
+#
+# No GUI here (ArrangeGui.py is the menu). Parts are SnapMath Movables (the part as the
+# selection names it: a Body, a shape, a link, an App::Part); their extents are the tight
+# boxes along the global axes (optimalBoundingBox of the shape where it is). A move is a
+# translation along one axis; attached parts move through their offset (SnapMath.apply).
+# Tests: FreeCADCmd -t TestArrange
+
+import math
+
+import FreeCAD as App
+
+import SnapMath as S
+
+AXES = ("x", "y", "z")
+REFERENCE_ALL = "all"
+
+
+class Item:
+    """A part to line up and its extent [lo, hi] on the three axes."""
+
+    def __init__(self, movable, lo, hi):
+        self.movable = movable
+        self.lo = list(lo)
+        self.hi = list(hi)
+
+    def low(self, axis):
+        return self.lo[axis]
+
+    def high(self, axis):
+        return self.hi[axis]
+
+    def center(self, axis):
+        return (self.lo[axis] + self.hi[axis]) / 2
+
+    def size(self, axis):
+        return self.hi[axis] - self.lo[axis]
+
+    def side(self, axis, where):
+        return {"min": self.low, "center": self.center, "max": self.high}[where](axis)
+
+    def __repr__(self):
+        return "Item({}, {}, {})".format(self.movable.obj.Label, self.lo, self.hi)
+
+
+def extent(movable):
+    """(lo, hi) of the part where it is, along the global axes (tight for turned parts)."""
+    import Part
+
+    shape = Part.getShape(movable.obj, "", needSubElement=False, transform=False)
+    if shape is None or shape.isNull():
+        raise S.SnapError("{} has no shape".format(movable.obj.Label))
+    shape = shape.copy()
+    shape.Placement = movable.global_placement().multiply(shape.Placement)
+    try:
+        bb = shape.optimalBoundingBox()
+    except Exception:
+        bb = shape.BoundBox
+    return (bb.XMin, bb.YMin, bb.ZMin), (bb.XMax, bb.YMax, bb.ZMax)
+
+
+def items_of(movables):
+    return [Item(m, *extent(m)) for m in movables]
+
+
+def movables_of_selection(entries):
+    """The parts of a selection of whole objects: entries are (root, path) as the selection
+    gives them ("" for a top-level object, "Part.Body." below a container). The same part
+    picked twice counts once; things that cannot move are left out."""
+    out = []
+    seen = set()
+    for root, sub in entries:
+        if sub and not sub.endswith("."):
+            continue  # a face, an edge: not a whole part
+        try:
+            candidates = S.movable_candidates(S.Pick(root, sub))
+        except Exception:
+            continue
+        if not candidates:
+            continue
+        m = candidates[0]
+        if m.obj in seen:
+            continue
+        seen.add(m.obj)
+        out.append(m)
+    return out
+
+
+def _target(items, axis, where, reference):
+    if reference == REFERENCE_ALL:
+        lo = min(i.low(axis) for i in items)
+        hi = max(i.high(axis) for i in items)
+        return {"min": lo, "center": (lo + hi) / 2, "max": hi}[where]
+    return items[reference].side(axis, where)
+
+
+def _vector(axis, d):
+    v = [0.0, 0.0, 0.0]
+    v[axis] = d
+    return App.Vector(*v)
+
+
+def align(items, axis, where, reference=0):
+    """Moves (App.Vector each) that put the side `where` ("min", "center", "max") of every
+    part on the axis at the reference's (the first part; or REFERENCE_ALL: the extent of all)."""
+    value = _target(items, axis, where, reference)
+    return [_vector(axis, value - i.side(axis, where)) for i in items]
+
+
+def distribute(items, axis, gap=None, reference=0):
+    """Spread the parts along the axis in the order they are along it.
+
+    gap None: the two outermost stay, the ones between get equal gaps (3 parts or more).
+    gap given: that gap between neighbours; the reference part stays (with REFERENCE_ALL
+    the lowest one)."""
+    order = sorted(range(len(items)), key=lambda k: (items[k].center(axis), k))
+    n = len(items)
+    moves = [App.Vector() for _ in items]
+    if n < 2:
+        return moves
+    if gap is None:
+        if n < 3:
+            return moves
+        first, last = items[order[0]], items[order[-1]]
+        span = last.high(axis) - first.low(axis)
+        total = sum(items[k].size(axis) for k in order)
+        gap = (span - total) / (n - 1)
+        fixed = order[0]
+    else:
+        fixed = order[0] if reference == REFERENCE_ALL else reference
+    pos = {}
+    p = 0.0
+    for k in order:
+        pos[k] = p
+        p += items[k].size(axis) + gap
+    shift = items[fixed].low(axis) - pos[fixed]
+    for k in order:
+        moves[k] = _vector(axis, pos[k] + shift - items[k].low(axis))
+    return moves
+
+
+def pack(items, axis, gap=0.0):
+    """Side by side in the order picked: the first stays, each next one starts where the one
+    before ends (plus gap), towards the positive side of the axis."""
+    moves = [App.Vector() for _ in items]
+    if not items:
+        return moves
+    end = items[0].high(axis)
+    for k in range(1, len(items)):
+        it = items[k]
+        moves[k] = _vector(axis, end + gap - it.low(axis))
+        end = end + gap + it.size(axis)
+    return moves
+
+
+def apply(items, moves, attachment="offset"):
+    """Move the parts (from where they are now)."""
+    for it, v in zip(items, moves):
+        if v.Length < 1e-12:
+            continue
+        S.apply(it.movable, App.Placement(v, App.Rotation()), attachment)
+
+
+def restore(items):
+    for it in items:
+        S.restore(it.movable)
+
+
+def problems(items):
+    """[(label, reason)] of the parts that cannot be moved this way."""
+    out = []
+    for it in items:
+        p = S.check_movable(it.movable)
+        if p in ("expression", "readonly"):
+            out.append((it.movable.obj.Label, p))
+    return out
+
+
+# --- the words of the axes as the view shows them --------------------------------------------
+
+# Seen from the front (the usual names): X left/right, Y front/back, Z bottom/top.
+# Each axis: (word of its min side, of its center, of its max side, name of the row, letter)
+WORLD_WORDS = {
+    0: ("Left", "Center", "Right", "Left-right", "X"),
+    1: ("Front", "Center", "Back", "Front-back", "Y"),
+    2: ("Bottom", "Middle", "Top", "Bottom-top", "Z"),
+}
+
+
+def axis_words(view_dir=None, view_up=None, view_right=None, angle=10.0):
+    """The words of each axis (see WORLD_WORDS). Looking straight along an axis (top view,
+    front view, ...) they follow the screen (left/right, bottom/top, near/far); otherwise the
+    usual world names."""
+    words = dict(WORLD_WORDS)
+    if view_dir is None or view_up is None or view_right is None:
+        return words
+    d = App.Vector(view_dir).normalize()
+    axes = [App.Vector(1, 0, 0), App.Vector(0, 1, 0), App.Vector(0, 0, 1)]
+    along = [abs(d.dot(a)) for a in axes]
+    k = max(range(3), key=lambda i: along[i])
+    if along[k] < math.cos(math.radians(angle)):
+        return words
+    up = App.Vector(view_up).normalize()
+    right = App.Vector(view_right).normalize()
+    out = {}
+    for i, a in enumerate(axes):
+        if i == k:
+            # Along the view: its positive side is near (towards the camera) or far
+            out[i] = ("Far", "Center", "Near", "Depth") if d.dot(a) < 0 else ("Near", "Center", "Far", "Depth")
+        elif abs(a.dot(right)) >= abs(a.dot(up)):
+            out[i] = ("Left", "Center", "Right", "Left-right") if a.dot(right) > 0 else ("Right", "Center", "Left", "Left-right")
+        else:
+            out[i] = ("Bottom", "Middle", "Top", "Bottom-top") if a.dot(up) > 0 else ("Top", "Middle", "Bottom", "Bottom-top")
+        out[i] = out[i] + ("XYZ"[i],)
+    return out
diff --git a/src/Mod/Unified/ArrangeGui.py b/src/Mod/Unified/ArrangeGui.py
new file mode 100644
index 000000000..23badb501
--- /dev/null
+++ b/src/Mod/Unified/ArrangeGui.py
@@ -0,0 +1,375 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+# 「そろえる」: line up the selected parts (Ctrl+click two or more whole parts), like the
+# alignment of shapes in a slide program. A small panel next to the cursor: left / center /
+# right (and front / back, bottom / top), equal gaps, a given gap, side by side. Pointing at a
+# button shows the result in the view; clicking it keeps it (one step to undo); Esc or a
+# click elsewhere puts everything back. The first picked part stays (it is the reference,
+# outlined in the view), or the extent of all of them. The arithmetic is in Arrange.py.
+
+import FreeCAD as App
+import FreeCADGui as Gui
+from PySide import QtCore, QtGui, QtWidgets
+
+import Arrange as A
+
+translate = App.Qt.translate
+CTX = "Unified_Arrange"
+PARAMS = "User parameter:BaseApp/Preferences/Mod/Unified/Arrange"
+
+
+def tr(text):
+    return translate(CTX, text)
+
+
+def selection_entries():
+    """(root, path) of the whole objects selected, in the order they were picked."""
+    out = []
+    for sel in Gui.Selection.getSelectionEx("", 0):
+        names = list(sel.SubElementNames) or [""]
+        for name in names:
+            out.append((sel.Object, name))
+    return out
+
+
+def selected_movables():
+    return A.movables_of_selection(selection_entries())
+
+
+def _view_words():
+    gdoc = Gui.ActiveDocument
+    view = gdoc.ActiveView if gdoc else None
+    if view is None or not hasattr(view, "getCameraNode"):
+        return A.axis_words()
+    try:
+        cam = view.getCameraNode()
+        rot = cam.orientation.getValue()
+        d = rot.multVec(__import__("pivy").coin.SbVec3f(0, 0, -1))
+        u = rot.multVec(__import__("pivy").coin.SbVec3f(0, 1, 0))
+        r = rot.multVec(__import__("pivy").coin.SbVec3f(1, 0, 0))
+        vec = lambda v: App.Vector(v[0], v[1], v[2])
+        return A.axis_words(vec(d), vec(u), vec(r))
+    except Exception:
+        return A.axis_words()
+
+
+class _Outline:
+    """The box around the reference part, drawn in the view."""
+
+    def __init__(self):
+        from pivy import coin
+
+        gdoc = Gui.ActiveDocument
+        self.view = gdoc.ActiveView if gdoc else None
+        self.root = coin.SoSeparator()
+        style = coin.SoPickStyle()
+        style.style = coin.SoPickStyle.UNPICKABLE
+        self.root.addChild(style)
+        top = coin.SoAnnotation()
+        color = coin.SoBaseColor()
+        color.rgb = (1.0, 0.5, 0.0)
+        draw = coin.SoDrawStyle()
+        draw.lineWidth = 2
+        draw.linePattern = 0xFF00
+        self.coords = coin.SoCoordinate3()
+        self.lines = coin.SoIndexedLineSet()
+        for n in (color, draw, self.coords, self.lines):
+            top.addChild(n)
+        self.root.addChild(top)
+        if self.view is not None and hasattr(self.view, "getSceneGraph"):
+            self.view.getSceneGraph().addChild(self.root)
+
+    def show(self, lo, hi):
+        if lo is None:
+            self.coords.point.setNum(0)
+            self.lines.coordIndex.setNum(0)
+            return
+        pts = [(x, y, z) for z in (lo[2], hi[2]) for y in (lo[1], hi[1]) for x in (lo[0], hi[0])]
+        idx = [0, 1, 3, 2, 0, -1, 4, 5, 7, 6, 4, -1, 0, 4, -1, 1, 5, -1, 2, 6, -1, 3, 7, -1]
+        self.coords.point.setValues(0, len(pts), pts)
+        self.lines.coordIndex.setValues(0, len(idx), idx)
+
+    def remove(self):
+        try:
+            if self.view is not None:
+                self.view.getSceneGraph().removeChild(self.root)
+        except Exception:
+            pass
+
+
+class ArrangePanel(QtWidgets.QFrame):
+    """The panel of 「そろえる」. Pointing at a button previews, clicking keeps."""
+
+    def __init__(self, movables, parent=None):
+        super().__init__(parent, QtCore.Qt.Popup)
+        self.setFrameShape(QtWidgets.QFrame.StyledPanel)
+        self.setObjectName("UnifiedArrangePanel")
+        self.items = A.items_of(movables)
+        self.doc = movables[0].obj.Document
+        self.preview_open = False
+        self.done = False
+        self.last_action = None
+        self.outline = _Outline()
+        words = _view_words()
+
+        layout = QtWidgets.QVBoxLayout(self)
+        layout.setContentsMargins(8, 8, 8, 8)
+        layout.setSpacing(4)
+        title = QtWidgets.QLabel(tr("Line up {} parts").format(len(self.items)))
+        font = title.font()
+        font.setBold(True)
+        title.setFont(font)
+        layout.addWidget(title)
+
+        ref_row = QtWidgets.QHBoxLayout()
+        ref_row.addWidget(QtWidgets.QLabel(tr("Reference:")))
+        self.reference = QtWidgets.QComboBox()
+        self.reference.addItem(tr("{} (picked first, stays)").format(self.items[0].movable.obj.Label), 0)
+        self.reference.addItem(tr("The extent of all picked"), A.REFERENCE_ALL)
+        saved = App.ParamGet(PARAMS).GetString("Reference", "first")
+        self.reference.setCurrentIndex(1 if saved == "all" else 0)
+        self.reference.currentIndexChanged.connect(self._reference_changed)
+        ref_row.addWidget(self.reference, 1)
+        layout.addLayout(ref_row)
+
+        grid = QtWidgets.QGridLayout()
+        grid.setHorizontalSpacing(4)
+        grid.setVerticalSpacing(4)
+        self.buttons = []
+        row = 0
+        for axis in range(3):
+            w = words[axis]
+            grid.addWidget(QtWidgets.QLabel("{} ({})".format(tr(w[3]), w[4])), row, 0)
+            for col, where in enumerate(("min", "center", "max")):
+                b = self._button(tr(w[col]), ("align", axis, where))
+                b.setToolTip(tr("Put the {} of every part where the reference's is").format(tr(w[col])))
+                grid.addWidget(b, row, col + 1)
+            row += 1
+        line = QtWidgets.QFrame()
+        line.setFrameShape(QtWidgets.QFrame.HLine)
+        grid.addWidget(line, row, 0, 1, 4)
+        row += 1
+        axis_names = ["{} ({})".format(tr(words[a][3]), words[a][4]) for a in range(3)]
+        short = [tr("X"), tr("Y"), tr("Z")]
+
+        grid.addWidget(QtWidgets.QLabel(tr("Equal gaps")), row, 0)
+        for a in range(3):
+            b = self._button(short[a], ("spread", a, None))
+            b.setToolTip(tr("The two outermost stay, the ones between get equal gaps (3 parts or more): {}").format(axis_names[a]))
+            b.setEnabled(len(self.items) >= 3)
+            grid.addWidget(b, row, a + 1)
+        row += 1
+
+        gap_row = QtWidgets.QHBoxLayout()
+        gap_row.setContentsMargins(0, 0, 0, 0)
+        gap_label = QtWidgets.QLabel(tr("Gap"))
+        self.gap = QtWidgets.QDoubleSpinBox()
+        self.gap.setDecimals(2)
+        self.gap.setRange(-10000, 10000)
+        self.gap.setSuffix(" mm")
+        self.gap.setValue(App.ParamGet(PARAMS).GetFloat("Gap", 10.0))
+        self.gap.valueChanged.connect(self._gap_changed)
+        gap_row.addWidget(gap_label)
+        gap_row.addWidget(self.gap, 1)
+        gap_box = QtWidgets.QWidget()
+        gap_box.setLayout(gap_row)
+        grid.addWidget(gap_box, row, 0)
+        for a in range(3):
+            b = self._button(short[a], ("gap", a, None))
+            b.setToolTip(tr("This gap between neighbours, the reference stays: {}").format(axis_names[a]))
+            grid.addWidget(b, row, a + 1)
+        row += 1
+
+        grid.addWidget(QtWidgets.QLabel(tr("Side by side")), row, 0)
+        for a in range(3):
+            b = self._button(short[a], ("pack", a, None))
+            b.setToolTip(tr("Touching, in the order they were picked, the first stays: {}").format(axis_names[a]))
+            grid.addWidget(b, row, a + 1)
+        layout.addLayout(grid)
+
+        self.message = QtWidgets.QLabel("")
+        self.message.setWordWrap(True)
+        self.message.setStyleSheet("color: #a33;")
+        layout.addWidget(self.message)
+        hint = QtWidgets.QLabel(tr("Point at a button to see it, click to keep, Esc to close"))
+        hint.setStyleSheet("color: gray;")
+        layout.addWidget(hint)
+        bad = A.problems(self.items)
+        if bad:
+            self.message.setText(
+                tr("Not moved (place set by a formula or locked): {}").format(", ".join(l for l, _ in bad))
+            )
+            self.items = [i for i in self.items if i.movable.obj.Label not in {l for l, _ in bad}] or self.items[:1]
+        self._reference_changed()
+
+    # ---------------------------------------------------------------- buttons and preview
+
+    def _button(self, text, action):
+        b = QtWidgets.QToolButton()
+        b.setText(text)
+        b.setAutoRaise(False)
+        b.setMinimumWidth(56)
+        b.setProperty("arrangeAction", action)
+        b.installEventFilter(self)
+        b.clicked.connect(lambda checked=False, a=action: self.commit(a))
+        self.buttons.append(b)
+        return b
+
+    def eventFilter(self, obj, event):
+        action = obj.property("arrangeAction") if isinstance(obj, QtWidgets.QToolButton) else None
+        if action is not None:
+            if event.type() == QtCore.QEvent.Enter:
+                self.preview(tuple(action))
+            elif event.type() == QtCore.QEvent.Leave:
+                self.unpreview()
+        return False
+
+    def _ref(self):
+        return self.reference.currentData()
+
+    def _reference_changed(self, *_):
+        ref = self._ref()
+        App.ParamGet(PARAMS).SetString("Reference", "all" if ref == A.REFERENCE_ALL else "first")
+        if ref == A.REFERENCE_ALL:
+            lo = [min(i.lo[k] for i in self.items) for k in range(3)]
+            hi = [max(i.hi[k] for i in self.items) for k in range(3)]
+            self.outline.show(lo, hi)
+        else:
+            self.outline.show(self.items[0].lo, self.items[0].hi)
+        if self.last_action is not None and self.preview_open:
+            self.preview(self.last_action)
+        Gui.updateGui()
+
+    def _gap_changed(self, value):
+        App.ParamGet(PARAMS).SetFloat("Gap", value)
+        if self.preview_open and self.last_action and self.last_action[0] == "gap":
+            self.preview(self.last_action)
+
+    def moves(self, action):
+        kind, axis, where = action
+        ref = self._ref()
+        if kind == "align":
+            return A.align(self.items, axis, where, ref)
+        if kind == "spread":
+            return A.distribute(self.items, axis, None, ref)
+        if kind == "gap":
+            return A.distribute(self.items, axis, self.gap.value(), ref)
+        if kind == "pack":
+            return A.pack(self.items, axis, 0.0)
+        return []
+
+    def _name(self, action):
+        return {
+            "align": tr("Line up"),
+            "spread": tr("Equal gaps"),
+            "gap": tr("Gap"),
+            "pack": tr("Side by side"),
+        }[action[0]]
+
+    def preview(self, action):
+        self.unpreview()
+        if action[0] == "spread" and len(self.items) < 3:
+            return
+        self.last_action = action
+        self.doc.openTransaction(self._name(action))
+        self.preview_open = True
+        try:
+            A.apply(self.items, self.moves(action))
+        except Exception as err:
+            self.message.setText(str(err))
+        Gui.updateGui()
+
+    def unpreview(self):
+        if self.preview_open:
+            self.preview_open = False
+            self.doc.abortTransaction()
+            Gui.updateGui()
+
+    def commit(self, action):
+        if self.done:
+            return
+        self.preview(action)
+        if not self.preview_open:
+            return
+        self.preview_open = False
+        try:
+            self.doc.recompute()
+        except Exception:
+            pass
+        self.doc.commitTransaction()
+        self.done = True
+        self.close()
+
+    def keyPressEvent(self, event):
+        if event.key() == QtCore.Qt.Key_Escape:
+            self.close()
+            return
+        super().keyPressEvent(event)
+
+    def closeEvent(self, event):
+        self.unpreview()
+        self.outline.remove()
+        global _panel
+        _panel = None
+        super().closeEvent(event)
+
+
+_panel = None
+
+
+def open_panel(pos=None):
+    global _panel
+    movables = selected_movables()
+    if len(movables) < 2:
+        Gui.getMainWindow().statusBar().showMessage(tr("Pick two or more whole parts (Ctrl+click) to line them up"), 6000)
+        return None
+    if len({m.obj.Document for m in movables}) > 1:
+        Gui.getMainWindow().statusBar().showMessage(tr("The parts are in different files"), 6000)
+        return None
+    if _panel is not None:
+        _panel.close()
+    _panel = ArrangePanel(movables, Gui.getMainWindow())
+    _panel.adjustSize()
+    if pos is None:
+        pos = QtGui.QCursor.pos() + QtCore.QPoint(12, 12)
+    screen = QtGui.QGuiApplication.screenAt(pos) or QtGui.QGuiApplication.primaryScreen()
+    area = screen.availableGeometry()
+    size = _panel.sizeHint()
+    x = min(pos.x(), area.right() - size.width())
+    y = min(pos.y(), area.bottom() - size.height())
+    _panel.move(max(area.left(), x), max(area.top(), y))
+    _panel.show()
+    return _panel
+
+
+class ArrangeCommand:
+    def GetResources(self):
+        return {
+            "MenuText": QT_TRANSLATE_NOOP("Unified_Align", "Line up"),
+            "ToolTip": QT_TRANSLATE_NOOP(
+                "Unified_Align",
+                "Line up the picked parts: left, center, right (front, back, bottom, top), equal gaps, side by side",
+            ),
+            "Pixmap": "Std_Placement",
+        }
+
+    def IsActive(self):
+        if Gui.ActiveDocument is None:
+            return False
+        sel = Gui.Selection.getSelectionEx("", 0)
+        whole = 0
+        for s in sel:
+            names = list(s.SubElementNames) or [""]
+            if any(n and not n.endswith(".") for n in names):
+                return False
+            whole += len(names)
+        return whole >= 2
+
+    def Activated(self):
+        open_panel()
+
+
+def QT_TRANSLATE_NOOP(context, text):
+    return text
+
+
+Gui.addCommand("Unified_Align", ArrangeCommand())
