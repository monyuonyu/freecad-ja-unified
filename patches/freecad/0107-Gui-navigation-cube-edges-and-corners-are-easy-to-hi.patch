+SoNaviCube::PickId SoNaviCube::refineByZone(PickId face, const SbVec3f& point) const
+{
+    if (!pickZones.getValue()) {
+        return face;
+    }
+    const int faceIndex = static_cast<int>(face);
+    if (faceIndex < static_cast<int>(PickId::Front) || faceIndex > static_cast<int>(PickId::Left)) {
+        return face;  // only the main faces have border zones
+    }
+    // Back into the coordinates of the cube (-1..1): the cube is turned into the view by the
+    // inverse of the camera orientation and moved away from the camera
+    SbVec3f p;
+    cameraOrientation.getValue().multVec(point - SbVec3f(0.0F, 0.0F, OVERLAY_CUBE_Z), p);
+
+    const auto centroid = [this](PickId id) {
+        SbVec3f c(0.0F, 0.0F, 0.0F);
+        for (const SbVec3f& v : faces[pickIndex(id)]) {
+            c += v;
+        }
+        if (c.length() > 0.0F) {
+            c.normalize();
+        }
+        return c;
+    };
+    const SbVec3f normal = centroid(face);
+    // Outer part of each side of the face (of the half size 1) that counts as the next edge
+    constexpr float zone = 0.62F;
+    SbVec3f direction = normal;
+    bool border = false;
+    for (int axis = 0; axis < 3; ++axis) {
+        if (std::abs(normal[axis]) > 0.5F) {
+            continue;  // the axis the face is on
+        }
+        if (std::abs(p[axis]) > zone) {
+            SbVec3f step(0.0F, 0.0F, 0.0F);
+            step[axis] = p[axis] > 0.0F ? 1.0F : -1.0F;
+            direction += step;
+            border = true;
+        }
+    }
+    if (!border) {
+        return face;
+    }
+    direction.normalize();
+    // The edge or corner face that points that way
+    PickId best = face;
+    float bestDot = -2.0F;
+    for (PickId id : kCubeFacePickOrder) {
+        const float d = centroid(id).dot(direction);
+        if (d > bestDot) {
+            bestDot = d;
+            best = id;
+        }
+    }
+    return best;
+}
