+// What a click on each part of the cube does, for the tooltip. The faces, edges and corners
+// are named by the sides they are between.
+QString NaviCubeImplementation::tipText(PickId pick) const
+{
+    struct Sides
+    {
+        PickId id;
+        std::array<const char*, 3> sides;
+    };
+    // clang-format off
+    static const Sides table[] = {
+        {PickId::Front, {"front"}}, {PickId::Top, {"top"}}, {PickId::Right, {"right"}},
+        {PickId::Rear, {"rear"}}, {PickId::Bottom, {"bottom"}}, {PickId::Left, {"left"}},
+        {PickId::FrontTop, {"front", "top"}}, {PickId::FrontBottom, {"front", "bottom"}},
+        {PickId::FrontRight, {"front", "right"}}, {PickId::FrontLeft, {"front", "left"}},
+        {PickId::RearTop, {"rear", "top"}}, {PickId::RearBottom, {"rear", "bottom"}},
+        {PickId::RearRight, {"rear", "right"}}, {PickId::RearLeft, {"rear", "left"}},
+        {PickId::TopRight, {"top", "right"}}, {PickId::TopLeft, {"top", "left"}},
+        {PickId::BottomRight, {"bottom", "right"}}, {PickId::BottomLeft, {"bottom", "left"}},
+        {PickId::FrontTopRight, {"front", "top", "right"}}, {PickId::FrontTopLeft, {"front", "top", "left"}},
+        {PickId::FrontBottomRight, {"front", "bottom", "right"}},
+        {PickId::FrontBottomLeft, {"front", "bottom", "left"}},
+        {PickId::RearTopRight, {"rear", "top", "right"}}, {PickId::RearTopLeft, {"rear", "top", "left"}},
+        {PickId::RearBottomRight, {"rear", "bottom", "right"}},
+        {PickId::RearBottomLeft, {"rear", "bottom", "left"}},
+    };
+    // clang-format on
+    // For lupdate: the names of the sides
+    (void)QT_TRANSLATE_NOOP("Gui::NaviCube", "front");
+    (void)QT_TRANSLATE_NOOP("Gui::NaviCube", "rear");
+    (void)QT_TRANSLATE_NOOP("Gui::NaviCube", "top");
+    (void)QT_TRANSLATE_NOOP("Gui::NaviCube", "bottom");
+    (void)QT_TRANSLATE_NOOP("Gui::NaviCube", "left");
+    (void)QT_TRANSLATE_NOOP("Gui::NaviCube", "right");
+    const auto tr = [](const char* text) {
+        return QApplication::translate("Gui::NaviCube", text);
+    };
+    for (const Sides& entry : table) {
+        if (entry.id != pick) {
+            continue;
+        }
+        QString view;
+        if (!entry.sides[1]) {
+            view = tr("View from the %1").arg(tr(entry.sides[0]));
+        }
+        else if (!entry.sides[2]) {
+            view = tr("View from between %1 and %2").arg(tr(entry.sides[0]), tr(entry.sides[1]));
+        }
+        else {
+            view = tr("View from the %1, %2 and %3 corner")
+                       .arg(tr(entry.sides[0]), tr(entry.sides[1]), tr(entry.sides[2]));
+        }
+        return view + QLatin1Char('\n')
+            + tr("Drag to turn freely, double-click to also center the model");
+    }
+    const int degrees = 360 / static_cast<int>(Base::clamp(long(naviStepByTurn), 4L, 36L));
+    switch (pick) {
+        case PickId::ArrowNorth:
+            return tr("Turn up by %1°").arg(degrees);
+        case PickId::ArrowSouth:
+            return tr("Turn down by %1°").arg(degrees);
+        case PickId::ArrowEast:
+            return tr("Turn right by %1°").arg(degrees);
+        case PickId::ArrowWest:
+            return tr("Turn left by %1°").arg(degrees);
+        case PickId::ArrowRight:
+            return tr("Roll clockwise by %1°").arg(degrees);
+        case PickId::ArrowLeft:
+            return tr("Roll counterclockwise by %1°").arg(degrees);
+        case PickId::Backside:
+            return tr("View from the opposite side");
+        case PickId::Home:
+            return tr("Home view");
+        case PickId::ViewMenu:
+            return tr("More views and settings");
+        default:
+            return {};
+    }
+}
+
+void NaviCubeImplementation::showTip(PickId pick)
+{
+    if (!showTips || pick == tipId) {
+        return;
+    }
+    tipId = pick;
+    QString text = tipText(pick);
+    if (text.isEmpty()) {
+        QToolTip::hideText();
+    }
+    else {
+        QToolTip::showText(QCursor::pos() + QPoint(14, 18), text, viewer->getGLWidget());  // NOLINT
+    }
+}
