+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""AI チャットの道具の中身（FreeCAD の中で動く）。AIAgentBridge から頼まれて実行し、MCP の content を返す。
+
+GUI が無くても get_document / run_python / design_check は動く（試験用）。screenshot だけ GUI が要る。
+"""
+
+import ast
+import base64
+import contextlib
+import io
+import os
+import tempfile
+import traceback
+
+import FreeCAD as App
+
+MAX_TEXT = 12000
+
+# run_python の名前空間は会話のあいだ続く（前の回で作った変数を次の回で使える）
+_namespace = {}
+
+
+def _text(t, is_error=False):
+    if len(t) > MAX_TEXT:
+        t = t[:MAX_TEXT] + "\n…（長いので %d 文字で切った）" % MAX_TEXT
+    return {"content": [{"type": "text", "text": t}], "is_error": is_error}
+
+
+def _gui():
+    try:
+        import FreeCADGui as Gui
+        return Gui if App.GuiUp else None
+    except ImportError:
+        return None
+
+
+def _selection():
+    Gui = _gui()
+    if Gui is None:
+        return []
+    out = []
+    for s in Gui.Selection.getSelectionEx("", 0):
+        # "Body" + "Sketch.Edge3" のような道のりを、実際に選んだ物（Sketch）と要素（Edge3）に直す
+        leaves = {}
+        for sub in s.SubElementNames or [""]:
+            leaf = s.Object.getSubObject(sub, 1) if sub else s.Object
+            leaf = leaf or s.Object
+            element = sub.split(".")[-1] if sub else ""
+            entry = leaves.setdefault(leaf.Name, {"name": leaf.Name, "label": leaf.Label, "sub": []})
+            if element:
+                entry["sub"].append(element)
+        out.extend(leaves.values())
+    return out
+
+
+def _parent(o):
+    for p in o.InList:
+        if p.isDerivedFrom("App::DocumentObjectGroup") or p.isDerivedFrom("App::Part") \
+                or p.isDerivedFrom("PartDesign::Body"):
+            if o in getattr(p, "Group", []):
+                return p.Name
+    return None
+
+
+def _describe(o):
+    d = {"name": o.Name, "label": o.Label, "type": o.TypeId}
+    par = _parent(o)
+    if par:
+        d["parent"] = par
+    try:
+        d["visible"] = bool(o.Visibility)
+    except Exception:
+        pass
+    try:
+        if not o.isValid():
+            d["error"] = " ".join((o.getStatusString() or "").split())
+    except Exception:
+        pass
+    if o.isDerivedFrom("Sketcher::SketchObject"):
+        d["geometry"] = len(o.Geometry)
+        d["constraints"] = len(o.Constraints)
+        d["dof"] = getattr(o, "DoF", None)
+        sup = getattr(o, "AttachmentSupport", None)
+        if sup:
+            d["on"] = ["%s:%s" % (x[0].Name, ",".join(x[1])) for x in sup]
+    elif o.isDerivedFrom("PartDesign::Body"):
+        d["tip"] = o.Tip.Name if o.Tip else None
+    elif o.isDerivedFrom("PartDesign::Feature"):
+        prof = getattr(o, "Profile", None)
+        if prof:
+            d["profile"] = prof[0].Name
+        for p in ("Length", "Length2", "Angle", "Radius", "Size", "Occurrences", "Type"):
+            if hasattr(o, p):
+                v = getattr(o, p)
+                d[p.lower()] = str(v) if not isinstance(v, (int, float, str)) else v
+    if hasattr(o, "Shape") and not o.isDerivedFrom("Sketcher::SketchObject"):
+        try:
+            s = o.Shape
+            if not s.isNull():
+                bb = s.BoundBox
+                d["bbox"] = [round(v, 2) for v in (bb.XMin, bb.YMin, bb.ZMin, bb.XMax, bb.YMax, bb.ZMax)]
+                if s.Solids:
+                    d["volume"] = round(s.Volume, 2)
+                    d["solids"] = len(s.Solids)
+        except Exception:
+            pass
+    return d
+
+
+def get_document(args):
+    doc = App.ActiveDocument
+    if doc is None:
+        return _text("開いている文書は無い")
+    import json
+    info = {
+        "document": doc.Name, "label": doc.Label, "file": doc.FileName or None,
+        "objects": [_describe(o) for o in doc.Objects[:400]],
+        "selection": _selection(),
+    }
+    if len(doc.Objects) > 400:
+        info["note"] = "物が %d 個あるので最初の 400 個だけ" % len(doc.Objects)
+    return _text(json.dumps(info, ensure_ascii=False))
+
+
+def run_python(args):
+    code = args.get("code", "")
+    desc = (args.get("description") or "AI").strip()[:60]
+    doc = App.ActiveDocument
+    ns = _namespace
+    ns.update({"App": App, "FreeCAD": App, "doc": doc})
+    Gui = _gui()
+    if Gui is not None:
+        ns.update({"Gui": Gui, "FreeCADGui": Gui})
+    for mod in ("Part", "Sketcher"):
+        if mod not in ns:
+            try:
+                ns[mod] = __import__(mod)
+            except ImportError:
+                pass
+    try:
+        tree = ast.parse(code, "<AI>", "exec")
+    except SyntaxError as e:
+        return _text("文法の誤り: %s" % e, True)
+    last = None
+    if tree.body and isinstance(tree.body[-1], ast.Expr):
+        last = ast.Expression(tree.body.pop().value)
+    out = io.StringIO()
+    if doc is not None:
+        doc.openTransaction("AI: " + desc)
+    before = set(o.Name for o in doc.Objects) if doc else set()
+    value = None
+    try:
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(out):
+            exec(compile(tree, "<AI>", "exec"), ns)
+            if last is not None:
+                value = eval(compile(last, "<AI>", "eval"), ns)
+            cur = App.ActiveDocument
+            if cur is not None:
+                cur.recompute()
+    except Exception:
+        if doc is not None and App.getDocument(doc.Name) is not None:
+            doc.abortTransaction()
+        return _text(out.getvalue() + traceback.format_exc(limit=6) + "\n（この回の変更は取り消した）", True)
+    if doc is not None and App.getDocument(doc.Name) is not None:
+        doc.commitTransaction()
+    lines = []
+    if out.getvalue():
+        lines.append(out.getvalue().rstrip())
+    if value is not None:
+        lines.append(repr(value))
+    cur = App.ActiveDocument
+    if cur is not None:
+        after = set(o.Name for o in cur.Objects)
+        added = sorted(after - before) if cur is doc else []
+        removed = sorted(before - after) if cur is doc else []
+        if added:
+            lines.append("増えた物: " + ", ".join("%s（%s）" % (n, cur.getObject(n).Label) for n in added))
+        if removed:
+            lines.append("消えた物: " + ", ".join(removed))
+        bad = [o for o in cur.Objects if not o.isValid() and not o.isDerivedFrom("Sketcher::SketchObject")]
+        if bad:
+            lines.append("計算に失敗している物: " + "; ".join(
+                "%s（%s）: %s" % (o.Name, o.Label, " ".join((o.getStatusString() or "").split())) for o in bad))
+    return _text("\n".join(lines) or "（出力なし）")
+
+
+_VIEWS = {"isometric": "viewIsometric", "front": "viewFront", "back": "viewRear", "top": "viewTop",
+          "bottom": "viewBottom", "left": "viewLeft", "right": "viewRight"}
+
+
+def screenshot(args):
+    Gui = _gui()
+    if Gui is None or Gui.ActiveDocument is None:
+        return _text("画面が無い（GUI が無いか、文書が開いていない）", True)
+    view = Gui.ActiveDocument.ActiveView
+    if not hasattr(view, "saveImage"):
+        return _text("今の画面は 3D の画面ではない", True)
+    cam = view.getCamera()
+    try:
+        name = args.get("view") or "current"
+        if name in _VIEWS:
+            getattr(view, _VIEWS[name])()
+        if args.get("fit") or name in _VIEWS:
+            view.fitAll()
+        fd, path = tempfile.mkstemp(suffix=".png")
+        os.close(fd)
+        view.saveImage(path, 1000, 750, "Current")
+        with open(path, "rb") as f:
+            data = base64.b64encode(f.read()).decode("ascii")
+        os.remove(path)
+    finally:
+        view.setCamera(cam)
+    return {"content": [{"type": "image", "data": data, "mimeType": "image/png"}], "is_error": False}
+
+
+def design_check(args):
+    import json
+    import DesignCheck
+    doc = App.ActiveDocument
+    if doc is None:
+        return _text("開いている文書は無い")
+    issues = DesignCheck.run(doc)
+    return _text(json.dumps({"summary": DesignCheck.summary(issues),
+                             "ignored": issues.ignored,
+                             "issues": [i.as_dict(doc) for i in issues]}, ensure_ascii=False))
+
+
+TOOLS = {"get_document": get_document, "run_python": run_python, "screenshot": screenshot,
+         "design_check": design_check}
+
+
+def call(name, args):
+    fn = TOOLS.get(name)
+    if fn is None:
+        return _text("知らない道具: %s" % name, True)
+    try:
+        return fn(args or {})
+    except Exception:
+        return _text(traceback.format_exc(limit=6), True)
+
+
+def reset():
+    _namespace.clear()
