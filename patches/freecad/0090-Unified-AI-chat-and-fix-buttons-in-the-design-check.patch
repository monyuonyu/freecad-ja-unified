+++ b/src/Mod/Unified/AIAgentBridge.py
@@ -0,0 +1,246 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""FreeCAD の AI チャットの仲介役（FreeCAD の外の Python で動く。claude-agent-sdk が要る）
+
+FreeCAD（AIChatGui）とは標準入出力の JSON 行でやり取りする。
+  FreeCAD → ここ: {"type": "user", "text"} / {"type": "result", "id", "content", "is_error"} /
+                  {"type": "interrupt"} / {"type": "reset"}
+  ここ → FreeCAD: {"type": "ready"} / {"type": "text", "text"} / {"type": "call", "id", "tool", "args"} /
+                  {"type": "done", "error"} / {"type": "fatal", "text"}
+AI の道具（FreeCAD を見る・動かす）は、呼ばれるたびに FreeCAD へ頼んで結果を待つ。
+"""
+
+import argparse
+import asyncio
+import itertools
+import json
+import os
+import sys
+
+# API キーの置き場所: OS の鍵保管庫（Windows の資格情報マネージャー・macOS のキーチェーン・Linux の Secret Service）。
+# 使えない環境（鍵保管庫の無い Linux など）では、本人だけが読めるファイル
+KEY_SERVICE = "freecad-ja-unified"
+KEY_USER = "anthropic-api-key"
+
+
+def _key_file(datadir):
+    return os.path.join(datadir, "ai-api-key")
+
+
+def store_key(key, datadir):
+    try:
+        import keyring
+        keyring.set_password(KEY_SERVICE, KEY_USER, key)
+        return "keyring"
+    except Exception:
+        path = _key_file(datadir)
+        os.makedirs(datadir, exist_ok=True)
+        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+        with os.fdopen(fd, "w") as f:
+            f.write(key)
+        return "file"
+
+
+def load_key(datadir):
+    try:
+        import keyring
+        k = keyring.get_password(KEY_SERVICE, KEY_USER)
+        if k:
+            return k
+    except Exception:
+        pass
+    try:
+        with open(_key_file(datadir)) as f:
+            return f.read().strip() or None
+    except OSError:
+        return None
+
+
+def delete_key(datadir):
+    try:
+        import keyring
+        keyring.delete_password(KEY_SERVICE, KEY_USER)
+    except Exception:
+        pass
+    try:
+        os.remove(_key_file(datadir))
+    except OSError:
+        pass
+
+SYSTEM = """あなたは FreeCAD（日本語の統合環境）に組み込まれた設計の助手です。利用者と同じ画面を見ながら、
+モデルを調べ、直し、作ります。答えは日本語で、短く具体的に。
+
+道具（mcp__freecad__*）:
+- get_document: 開いている文書の物の一覧（名前・ラベル・種類・親・妥当性・大きさ）と、今の選択
+- run_python: FreeCAD の中で Python を実行する。App/FreeCAD, Gui/FreeCADGui, Part, Sketcher, doc（開いている文書）が使える。
+  1 回の実行が「元に戻す」の 1 段になり、エラーが起きたらその回の変更は取り消される。最後に doc.recompute() は自動で行う
+- screenshot: 3D の画面を撮って見る（向きを指定できる。利用者の視点は元に戻す）
+- design_check: 設計の検査（失敗した手順・干渉・スケッチの拘束の矛盾・浮いた部品など）の結果
+
+進め方:
+- 変える前に get_document で今の状態を見る。物は Name（内部名）で指し、利用者にはラベルで伝える
+- 部品は PartDesign の Body の中で、スケッチ→押し出し…の手順で作るのが基本（後から直せるように）。
+  新しい物のラベルは日本語で付ける
+- 変えたら design_check と screenshot で確かめてから「できた」と言う。確かめていないことは、確かめていないと言う
+- 利用者のファイルを保存・上書き・削除するのは、頼まれたときだけ
+- 何をしたかは、利用者が「元に戻す」で戻せることも含めて一言で伝える"""
+
+TOOLS = [
+    ("get_document", "開いている文書の物の一覧と、今の選択を返す", {}, []),
+    ("run_python", "FreeCAD の中で Python を実行する（1 回が元に戻すの 1 段。エラーなら取り消す）。"
+                   "print の出力と、最後の式の値を返す",
+     {"code": {"type": "string", "description": "実行する Python"},
+      "description": {"type": "string", "description": "何をするか（元に戻すの一覧に出る。日本語で短く）"}},
+     ["code", "description"]),
+    ("screenshot", "3D の画面を撮って画像で返す",
+     {"view": {"type": "string", "enum": ["current", "isometric", "front", "back", "top", "bottom", "left", "right"],
+               "description": "向き（current は利用者が見ている向き）"},
+      "fit": {"type": "boolean", "description": "全体が収まるように寄せる"}},
+     []),
+    ("design_check", "設計の検査を行い、問題の一覧を返す", {}, []),
+]
+
+
+class Bridge:
+    def __init__(self, args):
+        self.args = args
+        self.ids = itertools.count(1)
+        self.pending = {}
+        self.inbox = asyncio.Queue()
+        self.client = None
+        self.busy = False
+
+    def send(self, **msg):
+        sys.stdout.write(json.dumps(msg, ensure_ascii=False) + "\n")
+        sys.stdout.flush()
+
+    async def call_freecad(self, name, args):
+        n = next(self.ids)
+        fut = asyncio.get_running_loop().create_future()
+        self.pending[n] = fut
+        self.send(type="call", id=n, tool=name, args=args)
+        res = await fut
+        return {"content": res.get("content", []), "is_error": bool(res.get("is_error"))}
+
+    def make_server(self):
+        def handler(name):
+            async def run(args):
+                return await self.call_freecad(name, args)
+            return run
+        tools = [tool(n, d, {"type": "object", "properties": p, "required": r, "additionalProperties": False})(handler(n))
+                 for n, d, p, r in TOOLS]
+        return create_sdk_mcp_server("freecad", tools=tools)
+
+    def options(self):
+        env = {"CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1", "ENABLE_CLAUDEAI_MCP_SERVERS": "false"}
+        if self.api_key:
+            env["ANTHROPIC_API_KEY"] = self.api_key
+        os.makedirs(self.args.workdir, exist_ok=True)
+        return ClaudeAgentOptions(
+            model=self.args.model, system_prompt=SYSTEM,
+            cli_path=self.args.claude or None,
+            tools=[], allowed_tools=["mcp__freecad__*"], mcp_servers={"freecad": self.make_server()},
+            strict_mcp_config=True, setting_sources=[], cwd=self.args.workdir, max_turns=40, env=env)
+
+    def _stdin_thread(self, loop):
+        # Windows でも動くように、標準入力はスレッドで読む（asyncio のパイプは Windows で使えない）
+        for line in sys.stdin:
+            try:
+                msg = json.loads(line)
+            except ValueError:
+                continue
+            asyncio.run_coroutine_threadsafe(self.dispatch(msg), loop)
+        asyncio.run_coroutine_threadsafe(self.inbox.put(None), loop)
+
+    async def dispatch(self, msg):
+        if msg.get("type") == "result":
+            fut = self.pending.pop(msg.get("id"), None)
+            if fut and not fut.done():
+                fut.set_result(msg)
+        elif msg.get("type") == "interrupt":
+            if self.client is not None and self.busy:
+                try:
+                    await self.client.interrupt()
+                except Exception:
+                    pass
+        else:
+            await self.inbox.put(msg)
+
+    async def turn(self, text):
+        self.busy = True
+        error = None
+        try:
+            await self.client.query(text)
+            async for m in self.client.receive_response():
+                if isinstance(m, AssistantMessage):
+                    for b in m.content:
+                        if isinstance(b, TextBlock) and b.text.strip():
+                            self.send(type="text", text=b.text)
+                elif isinstance(m, ResultMessage) and m.is_error:
+                    error = m.subtype or "error"
+        except Exception as e:
+            error = "%s: %s" % (type(e).__name__, e)
+        finally:
+            self.busy = False
+        self.send(type="done", error=error)
+
+    async def main(self):
+        # 認証: 利用者自身の API キー。--local-login のときだけ、この PC の claude のログインを使う（本人の利用に限る）
+        self.api_key = None if self.args.local_login else load_key(self.args.datadir)
+        if not self.args.local_login and not self.api_key:
+            self.send(type="need_key")
+            return
+        import threading
+        threading.Thread(target=self._stdin_thread, args=(asyncio.get_running_loop(),), daemon=True).start()
+        while True:
+            self.client = ClaudeSDKClient(options=self.options())
+            try:
+                await self.client.connect()
+            except Exception as e:
+                self.send(type="fatal", text="Claude に接続できない: %s" % e)
+                return
+            self.send(type="ready")
+            reset = False
+            while not reset:
+                msg = await self.inbox.get()
+                if msg is None:
+                    await self.client.disconnect()
+                    return
+                if msg.get("type") == "reset":
+                    reset = True
+                elif msg.get("type") == "user":
+                    await self.turn(msg["text"])
+            await self.client.disconnect()
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--datadir", default=os.path.join(os.path.expanduser("~"), ".local", "share", "freecad-ai"))
+    ap.add_argument("--local-login", action="store_true", help="API キーではなく、この PC の claude のログインを使う")
+    ap.add_argument("--store-key", action="store_true", help="標準入力の API キーを保管して終わる")
+    ap.add_argument("--delete-key", action="store_true", help="保管した API キーを消して終わる")
+    ap.add_argument("--model", default="opus")
+    ap.add_argument("--claude", default="", help="claude の実行ファイル（空なら SDK に同梱のもの）")
+    ap.add_argument("--workdir", default=os.path.join(os.path.expanduser("~"), ".cache", "freecad-ai"))
+    args = ap.parse_args()
+    if args.store_key:
+        key = sys.stdin.read().strip()
+        if not key:
+            sys.exit("キーが空")
+        print(store_key(key, args.datadir))
+        return
+    if args.delete_key:
+        delete_key(args.datadir)
+        return
+    global AssistantMessage, ClaudeAgentOptions, ClaudeSDKClient, ResultMessage, TextBlock
+    global create_sdk_mcp_server, tool
+    try:
+        from claude_agent_sdk import (AssistantMessage, ClaudeAgentOptions, ClaudeSDKClient, ResultMessage,
+                                      TextBlock, create_sdk_mcp_server, tool)
+    except ImportError as e:  # 準備ができていない
+        print(json.dumps({"type": "fatal", "text": "claude-agent-sdk が見つからない: %s" % e}), flush=True)
+        sys.exit(2)
+    asyncio.run(Bridge(args).main())
+
+
+if __name__ == "__main__":
+    main()
