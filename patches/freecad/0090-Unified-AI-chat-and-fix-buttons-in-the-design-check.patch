--- /dev/null
+++ b/src/Mod/Unified/AIChatGui.py
@@ -0,0 +1,547 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""AI チャット（右側のドック）。Claude（Agent SDK）が FreeCAD を見て、直して、作る。
+
+AI は別のプロセス（AIAgentBridge.py、claude-agent-sdk の入った Python）で動き、
+FreeCAD を見る・動かす道具（AITools）を呼ぶたびに、ここへ頼みに来る。
+AI が形を変えるたびに「元に戻す」の 1 段になる。
+"""
+
+import html
+import json
+import os
+import shutil
+import sys
+
+import FreeCAD as App
+import FreeCADGui as Gui
+from PySide import QtCore, QtGui, QtWidgets
+
+import AITools
+
+translate = App.Qt.translate
+QT_TRANSLATE_NOOP = App.Qt.QT_TRANSLATE_NOOP
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+PARAMS = "User parameter:BaseApp/Preferences/Mod/Unified/AI"
+
+
+def _params():
+    return App.ParamGet(PARAMS)
+
+
+def _venv_dir():
+    return os.path.join(App.getUserAppDataDir(), "ai-venv")
+
+
+def _venv_python(d):
+    return os.path.join(d, "Scripts", "python.exe") if sys.platform == "win32" else os.path.join(d, "bin", "python")
+
+
+def find_python():
+    """claude-agent-sdk の入った Python。設定 → 準備で作った venv の順"""
+    p = _params().GetString("PythonPath", "")
+    if p and os.path.exists(p):
+        return p
+    v = _venv_python(_venv_dir())
+    return v if os.path.exists(v) else None
+
+
+def _datadir():
+    return os.path.join(App.getUserAppDataDir(), "ai")
+
+
+def find_claude():
+    """claude の実行ファイル。見つからなければ空（SDK に同梱のものを使う）"""
+    p = _params().GetString("ClaudePath", "")
+    if p and os.path.exists(p):
+        return p
+    w = shutil.which("claude")
+    if w:
+        return w
+    home = os.path.expanduser("~")
+    for c in (os.path.join(home, ".local", "bin", "claude"), os.path.join(home, ".local", "bin", "claude.exe"),
+              os.path.join(home, ".claude", "local", "claude")):
+        if os.path.exists(c):
+            return c
+    return ""
+
+
+def _base_python():
+    """venv を作るための Python（システムのもの。無ければ FreeCAD に同梱のもの）"""
+    for name in ("python3", "python"):
+        w = shutil.which(name)
+        if w and "WindowsApps" not in w:
+            return w
+    exe = os.path.join(os.path.dirname(sys.executable), "python.exe" if sys.platform == "win32" else "python")
+    return exe if os.path.exists(exe) else sys.executable
+
+
+def _selection_note():
+    sel = AITools._selection()
+    if not sel:
+        return ""
+    parts = []
+    for s in sel:
+        if s["sub"]:
+            parts.append("%s（%s）の %s" % (s["name"], s["label"], ", ".join(s["sub"])))
+        else:
+            parts.append("%s（%s）" % (s["name"], s["label"]))
+    return "\n\n［今の選択: " + "; ".join(parts) + "］"
+
+
+class ChatPanel(QtWidgets.QWidget):
+    def __init__(self, parent=None):
+        super().__init__(parent)
+        self.proc = None
+        self.buffer = b""
+        self.ready = False
+        self.busy = False
+        self.queue = []
+        self.codes = []
+        self.in_call = False
+        self.later = []        # 道具を実行している間に届いたもの（入れ子にしない）
+        lay = QtWidgets.QVBoxLayout(self)
+        lay.setContentsMargins(4, 4, 4, 4)
+        self.view = QtWidgets.QTextBrowser()
+        self.view.setOpenLinks(False)
+        self.view.anchorClicked.connect(self.on_link)
+        lay.addWidget(self.view, 1)
+        self.status = QtWidgets.QLabel()
+        self.status.setWordWrap(True)
+        lay.addWidget(self.status)
+        self.setup_btn = QtWidgets.QPushButton(translate("AIChat", "Set up the AI (install claude-agent-sdk)"))
+        self.setup_btn.clicked.connect(self.setup)
+        self.setup_btn.hide()
+        lay.addWidget(self.setup_btn)
+        self.input = QtWidgets.QPlainTextEdit()
+        self.input.setPlaceholderText(translate("AIChat", "Ask or instruct (Ctrl+Enter to send). "
+                                                          "What you have selected is passed along."))
+        self.input.setMaximumHeight(90)
+        self.input.installEventFilter(self)
+        lay.addWidget(self.input)
+        row = QtWidgets.QHBoxLayout()
+        self.send_btn = QtWidgets.QPushButton(translate("AIChat", "Send"))
+        self.send_btn.clicked.connect(self.on_send)
+        row.addWidget(self.send_btn)
+        self.stop_btn = QtWidgets.QPushButton(translate("AIChat", "Stop"))
+        self.stop_btn.setEnabled(False)
+        self.stop_btn.clicked.connect(self.on_stop)
+        row.addWidget(self.stop_btn)
+        new = QtWidgets.QPushButton(translate("AIChat", "New conversation"))
+        new.clicked.connect(self.on_new)
+        row.addWidget(new)
+        self.key_btn = QtWidgets.QPushButton(translate("AIChat", "API key…"))
+        self.key_btn.setToolTip(translate("AIChat", "Set or remove your Anthropic API key"))
+        self.key_btn.clicked.connect(self.on_key)
+        row.addWidget(self.key_btn)
+        lay.addLayout(row)
+        self._note(translate("AIChat", "The AI looks at the model, changes it and checks the result. "
+                                       "Every change it makes is one step in Undo."))
+
+    # ---------------------------------------------------------------- 表示
+    def _new_block(self):
+        """末尾に、前の段落の書式（AI の返事の箇条書きなど）を引き継がない段落を足す"""
+        c = self.view.textCursor()
+        c.movePosition(QtGui.QTextCursor.End)
+        c.insertBlock(QtGui.QTextBlockFormat(), QtGui.QTextCharFormat())
+        lst = c.currentList()
+        if lst is not None:
+            lst.remove(c.block())
+        return c
+
+    def _append_html(self, h):
+        c = self._new_block()
+        c.insertHtml(h)
+        self.view.setTextCursor(c)
+        self.view.ensureCursorVisible()
+
+    def _note(self, text):
+        self._append_html('<span style="color:#888">%s</span>' % html.escape(text))
+
+    def _user(self, text):
+        self._append_html('<div style="color:#2f5fb3"><b>%s</b> %s</div>' % (
+            html.escape(translate("AIChat", "You:")), html.escape(text).replace("\n", "<br>")))
+
+    def _assistant(self, text):
+        c = self._new_block()
+        c.insertHtml("<b>AI:</b> ")
+        if hasattr(c, "insertMarkdown"):
+            c.insertMarkdown(text)
+        else:
+            c.insertText(text)
+        self.view.setTextCursor(c)
+        self.view.ensureCursorVisible()
+
+    def _tool(self, name, args):
+        labels = {
+            "get_document": translate("AIChat", "Looking at the model"),
+            "run_python": translate("AIChat", "Changing: {0}"),
+            "screenshot": translate("AIChat", "Taking a look at the view"),
+            "design_check": translate("AIChat", "Running the design check"),
+        }
+        text = labels.get(name, name)
+        if name == "run_python":
+            text = text.format(args.get("description", ""))
+            self.codes.append(args.get("code", ""))
+            link = ' <a href="code:%d">%s</a>' % (len(self.codes) - 1, html.escape(translate("AIChat", "code")))
+        else:
+            link = ""
+        self._append_html('<span style="color:#888">🔧 %s%s</span>' % (html.escape(text), link))
+
+    def approve(self, args):
+        """AI のコードを実行する前に、利用者に見せて承認を取る（任意の Python なので、黙っては実行しない）"""
+        dlg = QtWidgets.QDialog(self)
+        dlg.setWindowTitle(translate("AIChat", "Run the AI's code?"))
+        v = QtWidgets.QVBoxLayout(dlg)
+        head = QtWidgets.QLabel(translate("AIChat", "The AI wants to run this code: {0}").format(
+            args.get("description", "")))
+        head.setWordWrap(True)
+        v.addWidget(head)
+        t = QtWidgets.QPlainTextEdit(args.get("code", ""))
+        t.setReadOnly(True)
+        t.setFont(QtGui.QFontDatabase.systemFont(QtGui.QFontDatabase.FixedFont))
+        v.addWidget(t)
+        note = QtWidgets.QLabel(translate("AIChat", "Changes to the model can be undone in one step. "
+                                                    "The code can also do things outside FreeCAD, so read it first."))
+        note.setWordWrap(True)
+        v.addWidget(note)
+        bb = QtWidgets.QDialogButtonBox()
+        run = bb.addButton(translate("AIChat", "Run"), QtWidgets.QDialogButtonBox.AcceptRole)
+        bb.addButton(translate("AIChat", "Don't run"), QtWidgets.QDialogButtonBox.RejectRole)
+        bb.accepted.connect(dlg.accept)
+        bb.rejected.connect(dlg.reject)
+        v.addWidget(bb)
+        run.setDefault(True)
+        dlg.resize(720, 480)
+        return dlg.exec() == QtWidgets.QDialog.Accepted
+
+    def on_link(self, url):
+        s = url.toString()
+        if s.startswith("code:"):
+            code = self.codes[int(s[5:])]
+            dlg = QtWidgets.QDialog(self)
+            dlg.setWindowTitle(translate("AIChat", "Code the AI ran"))
+            v = QtWidgets.QVBoxLayout(dlg)
+            t = QtWidgets.QPlainTextEdit(code)
+            t.setReadOnly(True)
+            t.setFont(QtGui.QFontDatabase.systemFont(QtGui.QFontDatabase.FixedFont))
+            v.addWidget(t)
+            dlg.resize(700, 450)
+            dlg.exec()
+
+    def _set_busy(self, busy):
+        self.busy = busy
+        self.stop_btn.setEnabled(busy)
+        self.status.setText(translate("AIChat", "Thinking…") if busy else "")
+
+    # ---------------------------------------------------------------- 仲介役のプロセス
+    def ensure_started(self):
+        if self.proc is not None and self.proc.state() != QtCore.QProcess.NotRunning:
+            return True
+        py = find_python()
+        if py is None:
+            self.status.setText(translate("AIChat", "The AI is not set up yet: it needs claude-agent-sdk "
+                                                     "(installed with the button below) and your Anthropic API key."))
+            self.setup_btn.show()
+            return False
+        self.setup_btn.hide()
+        self.proc = QtCore.QProcess(self)
+        self.proc.setProcessChannelMode(QtCore.QProcess.SeparateChannels)
+        self.proc.readyReadStandardOutput.connect(self.on_stdout)
+        self.proc.readyReadStandardError.connect(self.on_stderr)
+        self.proc.finished.connect(self.on_finished)
+        self.ready = False
+        self.buffer = b""
+        args = [os.path.join(HERE, "AIAgentBridge.py"),
+                "--model", _params().GetString("Model", "opus"),
+                "--claude", find_claude(),
+                "--workdir", os.path.join(App.getUserCachePath(), "ai-work"),
+                "--datadir", _datadir()]
+        # 隠し設定: API キーではなく、この PC の claude のログインを使う（本人の利用に限る。配る版の既定は API キー）
+        if _params().GetBool("UseLocalClaudeLogin", False):
+            args.append("--local-login")
+        self.status.setText(translate("AIChat", "Starting the AI…"))
+        self.proc.start(py, args)
+        return True
+
+    def send_json(self, **msg):
+        if self.proc is not None:
+            self.proc.write((json.dumps(msg, ensure_ascii=False) + "\n").encode("utf-8"))
+
+    def on_stdout(self):
+        self.buffer += bytes(self.proc.readAllStandardOutput())
+        while b"\n" in self.buffer:
+            line, self.buffer = self.buffer.split(b"\n", 1)
+            try:
+                msg = json.loads(line.decode("utf-8"))
+            except ValueError:
+                continue
+            self.handle(msg)
+
+    def on_stderr(self):
+        err = bytes(self.proc.readAllStandardError()).decode("utf-8", "replace")
+        App.Console.PrintLog("AIChat: " + err)
+
+    def on_finished(self, *args):
+        self.ready = False
+        self._set_busy(False)
+        self._note(translate("AIChat", "The AI stopped."))
+
+    def handle(self, msg):
+        if self.in_call:
+            self.later.append(msg)
+            return
+        self._handle(msg)
+        while self.later and not self.in_call:
+            self._handle(self.later.pop(0))
+
+    def _handle(self, msg):
+        t = msg.get("type")
+        if t == "ready":
+            self.ready = True
+            self.status.setText("")
+            if self.queue:
+                self._start_turn(self.queue.pop(0))
+        elif t == "text":
+            self._assistant(msg.get("text", ""))
+        elif t == "call":
+            self._tool(msg.get("tool"), msg.get("args") or {})
+            self.in_call = True
+            try:
+                QtWidgets.QApplication.processEvents(QtCore.QEventLoop.ExcludeUserInputEvents)
+                if msg.get("tool") == "run_python" and not self.approve(msg.get("args") or {}):
+                    res = {"content": [{"type": "text", "text": "利用者が実行を断った。何を変えようとしたか説明し、指示を待つ"}],
+                           "is_error": True}
+                else:
+                    res = AITools.call(msg.get("tool"), msg.get("args"))
+            finally:
+                self.in_call = False
+            self.send_json(type="result", id=msg.get("id"), **res)
+        elif t == "done":
+            self._set_busy(False)
+            if msg.get("error"):
+                self._note(translate("AIChat", "Stopped with an error: {0}").format(msg["error"]))
+            if self.queue:
+                self._start_turn(self.queue.pop(0))
+        elif t == "need_key":
+            self._set_busy(False)
+            self.ready = False
+            self._note(translate("AIChat", "An Anthropic API key is needed. Create one at "
+                                           "console.anthropic.com (usage is billed to your account) "
+                                           "and enter it with “API key…”. It is kept in the key store of "
+                                           "your system, not in the FreeCAD settings."))
+            self.key_btn.setFocus()
+        elif t == "fatal":
+            self._set_busy(False)
+            self._note(msg.get("text", ""))
+            if "claude-agent-sdk" in msg.get("text", ""):
+                self.setup_btn.show()
+
+    # ---------------------------------------------------------------- 操作
+    def eventFilter(self, obj, ev):
+        if obj is self.input and ev.type() == QtCore.QEvent.KeyPress \
+                and ev.key() in (QtCore.Qt.Key_Return, QtCore.Qt.Key_Enter) \
+                and ev.modifiers() & QtCore.Qt.ControlModifier:
+            self.on_send()
+            return True
+        return super().eventFilter(obj, ev)
+
+    def ask(self, text):
+        """外から頼む（設計の検査の「AI に相談」など）"""
+        self.input.setPlainText(text)
+        self.on_send()
+
+    def on_send(self):
+        text = self.input.toPlainText().strip()
+        if not text:
+            return
+        self.input.clear()
+        self._user(text)
+        full = text + _selection_note()
+        if not self.ensure_started():
+            return
+        if self.ready and not self.busy:
+            self._start_turn(full)
+        else:
+            self.queue.append(full)
+
+    def _start_turn(self, text):
+        self._set_busy(True)
+        self.send_json(type="user", text=text)
+
+    def on_stop(self):
+        self.send_json(type="interrupt")
+
+    def on_new(self):
+        self.queue.clear()
+        self.codes.clear()
+        self.view.clear()
+        AITools.reset()
+        if self.proc is not None and self.proc.state() != QtCore.QProcess.NotRunning:
+            self.ready = False
+            self.send_json(type="reset")
+        self._note(translate("AIChat", "New conversation."))
+
+    def shutdown(self):
+        if self.proc is not None and self.proc.state() != QtCore.QProcess.NotRunning:
+            self.proc.closeWriteChannel()
+            if not self.proc.waitForFinished(3000):
+                self.proc.kill()
+
+    # ---------------------------------------------------------------- API キー
+    def on_key(self):
+        py = find_python()
+        if py is None:
+            self.setup_btn.show()
+            self._note(translate("AIChat", "Set up the AI first."))
+            return
+        key, ok = QtWidgets.QInputDialog.getText(
+            self, translate("AIChat", "Anthropic API key"),
+            translate("AIChat", "Your API key (sk-ant-…). Leave empty to remove the stored key."),
+            QtWidgets.QLineEdit.Password)
+        if not ok:
+            return
+        key = key.strip()
+        p = QtCore.QProcess(self)
+        p.setProcessChannelMode(QtCore.QProcess.MergedChannels)
+        bridge = os.path.join(HERE, "AIAgentBridge.py")
+
+        def done(code, *rest):
+            out = bytes(p.readAll()).decode("utf-8", "replace").strip()
+            if code != 0:
+                self._note(translate("AIChat", "Could not store the key: {0}").format(out))
+                return
+            if not key:
+                self._note(translate("AIChat", "The stored API key was removed."))
+            elif out == "file":
+                self._note(translate("AIChat", "Stored (no key store on this system: in a file only you can read)."))
+            else:
+                self._note(translate("AIChat", "Stored in the key store of the system."))
+            # 新しいキーで始め直す
+            self.shutdown()
+            self.proc = None
+            if key and self.queue:
+                self.ensure_started()
+        p.finished.connect(done)
+        # キーはコマンドラインに載せない（他のプロセスから見える）。標準入力で渡す
+        if key:
+            p.start(py, [bridge, "--store-key", "--datadir", _datadir()])
+            p.waitForStarted(5000)
+            p.write(key.encode("utf-8"))
+            p.closeWriteChannel()
+        else:
+            p.start(py, [bridge, "--delete-key", "--datadir", _datadir()])
+
+    # ---------------------------------------------------------------- 準備（venv に SDK を入れる）
+    def setup(self):
+        d = _venv_dir()
+        steps = []
+        if not os.path.exists(_venv_python(d)):
+            steps.append((_base_python(), ["-m", "venv", d]))
+        steps.append((_venv_python(d), ["-m", "pip", "install", "--upgrade", "claude-agent-sdk", "keyring"]))
+        self.setup_btn.setEnabled(False)
+        self._note(translate("AIChat", "Setting up in {0} …").format(d))
+        self._run_steps(steps)
+
+    def _run_steps(self, steps):
+        if not steps:
+            self.setup_btn.setEnabled(True)
+            self.setup_btn.hide()
+            self._note(translate("AIChat", "Set up. Next, enter your Anthropic API key with “API key…”."))
+            self.status.setText("")
+            return
+        prog, args = steps[0]
+        p = QtCore.QProcess(self)
+        p.setProcessChannelMode(QtCore.QProcess.MergedChannels)
+
+        def done(code, *rest):
+            out = bytes(p.readAll()).decode("utf-8", "replace").strip().splitlines()
+            if code != 0:
+                self.setup_btn.setEnabled(True)
+                self._note(translate("AIChat", "Setup failed: {0}").format("\n".join(out[-5:])))
+                return
+            self._run_steps(steps[1:])
+        p.finished.connect(done)
+        self.status.setText(" ".join([os.path.basename(prog)] + args[:3]) + " …")
+        p.start(prog, args)
+
+
+class Chat:
+    """ドックの出し入れ"""
