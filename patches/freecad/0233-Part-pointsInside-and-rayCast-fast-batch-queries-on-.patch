+// ------------------------------------------------------------------ triangles and tree
+
+struct Triangles
+{
+    std::vector<gp_XYZ> p;
+    std::vector<std::array<int, 3>> t;
+    std::vector<int> shape;  // per triangle
+    std::vector<int> face;  // per triangle, index in the shape's face map (0 based)
+    std::vector<std::vector<TopoDS_Face>> faces;  // per shape, faces of the meshed copy
+    Bnd_Box box;
+    double deflection = 0;
+};
+
+double defaultDeflection(const Bnd_Box& box, double requested)
+{
+    if (requested > 0) {
+        return requested;
+    }
+    return box.IsVoid() ? 0.01 : std::max(std::sqrt(box.SquareExtent()) * 2e-4, 1e-6);
+}
+
+void addTriangles(Triangles& tri, const TopoDS_Shape& in, int shapeIndex)
+{
+    // a copy: no mesh is left on the caller's shape, and a finer one already there
+    // (exportStl's 0.01 mm) is not used
+    TopoDS_Shape shape = BRepBuilderAPI_Copy(in, Standard_False, Standard_False).Shape();
+    BRepMesh_IncrementalMesh(shape, tri.deflection, Standard_False, 0.3, Standard_True);
+    TopTools_IndexedMapOfShape faceMap;
+    TopExp::MapShapes(shape, TopAbs_FACE, faceMap);
+    if ((int)tri.faces.size() <= shapeIndex) {
+        tri.faces.resize(shapeIndex + 1);
+    }
+    for (int i = 1; i <= faceMap.Extent(); ++i) {
+        const TopoDS_Face& face = TopoDS::Face(faceMap(i));
+        tri.faces[shapeIndex].push_back(face);
+        std::vector<gp_Pnt> points;
+        std::vector<Poly_Triangle> facets;
+        if (!Part::Tools::getTriangulation(face, points, facets)) {
+            continue;
+        }
+        const int base = (int)tri.p.size();
+        for (const auto& p : points) {
+            tri.p.push_back(p.XYZ());
+        }
+        for (const auto& f : facets) {
+            int a {}, b {}, c {};
+            f.Get(a, b, c);
+            tri.t.push_back({base + a, base + b, base + c});
+            tri.shape.push_back(shapeIndex);
+            tri.face.push_back(i - 1);
+        }
+    }
+}
+
+class Bvh
+{
+public:
+    explicit Bvh(const Triangles& tri)
+        : tri(tri)
+    {
+        order.resize(tri.t.size());
+        for (std::size_t i = 0; i < order.size(); ++i) {
+            order[i] = (int)i;
+        }
+        centroid.resize(tri.t.size());
+        for (std::size_t i = 0; i < tri.t.size(); ++i) {
+            const auto& t = tri.t[i];
+            centroid[i] = (tri.p[t[0]] + tri.p[t[1]] + tri.p[t[2]]) / 3.0;
+        }
+        if (!order.empty()) {
+            build(0, (int)order.size());
+        }
+    }
+
+    // f(triangle) for triangles whose box the ray o + t d (0 <= t <= tmax) passes;
+    // f returns the new tmax (to stop early) or tmax
+    template<typename F>
+    void ray(const gp_XYZ& o, const gp_XYZ& d, double tmax, F&& f) const
+    {
+        if (nodes.empty()) {
+            return;
+        }
+        gp_XYZ inv(1.0 / d.X(), 1.0 / d.Y(), 1.0 / d.Z());
+        int stack[128];
+        int top = 0;
+        stack[top++] = 0;
+        while (top > 0) {
+            const Node& n = nodes[stack[--top]];
+            if (!slab(n, o, inv, tmax)) {
+                continue;
+            }
+            if (n.count > 0) {
+                for (int k = n.start; k < n.start + n.count; ++k) {
+                    tmax = f(order[k], tmax);
+                }
+            }
+            else if (top + 2 < 128) {
+                stack[top++] = n.left;
+                stack[top++] = n.left + 1;
+            }
+        }
+    }
+
+    // is any triangle within r of p
+    bool within(const gp_XYZ& p, double r) const
+    {
+        if (nodes.empty()) {
+            return false;
+        }
+        const double r2 = r * r;
+        int stack[128];
+        int top = 0;
+        stack[top++] = 0;
+        while (top > 0) {
+            const Node& n = nodes[stack[--top]];
+            if (boxDistance2(n, p) > r2) {
+                continue;
+            }
+            if (n.count > 0) {
+                for (int k = n.start; k < n.start + n.count; ++k) {
+                    if (triangleDistance2(order[k], p) <= r2) {
+                        return true;
+                    }
+                }
+            }
+            else if (top + 2 < 128) {
+                stack[top++] = n.left;
+                stack[top++] = n.left + 1;
+            }
+        }
+        return false;
+    }
+
+private:
+    struct Node
+    {
+        double lo[3];
+        double hi[3];
+        int left = -1;  // children left and left + 1
+        int start = 0, count = 0;
+    };
+
+    void build(int start, int end)
+    {
+        // iterative with an explicit stack of (node, start, end)
+        nodes.reserve(2 * (end - start) / 4 + 1);
+        nodes.push_back(Node());
+        std::vector<std::array<int, 3>> work {{0, start, end}};
+        while (!work.empty()) {
+            auto [ni, s, e] = work.back();
+            work.pop_back();
+            Node n;
+            for (int k = 0; k < 3; ++k) {
+                n.lo[k] = 1e300;
+                n.hi[k] = -1e300;
+            }
+            double clo[3] = {1e300, 1e300, 1e300}, chi[3] = {-1e300, -1e300, -1e300};
+            for (int k = s; k < e; ++k) {
+                const auto& t = tri.t[order[k]];
+                for (int v = 0; v < 3; ++v) {
+                    const gp_XYZ& q = tri.p[t[v]];
+                    for (int a = 0; a < 3; ++a) {
+                        n.lo[a] = std::min(n.lo[a], q.Coord(a + 1));
+                        n.hi[a] = std::max(n.hi[a], q.Coord(a + 1));
+                    }
+                }
+                for (int a = 0; a < 3; ++a) {
+                    clo[a] = std::min(clo[a], centroid[order[k]].Coord(a + 1));
+                    chi[a] = std::max(chi[a], centroid[order[k]].Coord(a + 1));
+                }
+            }
+            if (e - s <= 4) {
+                n.start = s;
+                n.count = e - s;
+                nodes[ni] = n;
+                continue;
+            }
+            int axis = 0;
+            for (int a = 1; a < 3; ++a) {
+                if (chi[a] - clo[a] > chi[axis] - clo[axis]) {
+                    axis = a;
+                }
+            }
+            int mid = (s + e) / 2;
+            std::nth_element(order.begin() + s, order.begin() + mid, order.begin() + e, [&](int x, int y) {
+                return centroid[x].Coord(axis + 1) < centroid[y].Coord(axis + 1);
+            });
+            n.left = (int)nodes.size();
+            nodes[ni] = n;
+            nodes.push_back(Node());
+            nodes.push_back(Node());
+            work.push_back({n.left, s, mid});
+            work.push_back({n.left + 1, mid, e});
+        }
+    }
+
+    static bool slab(const Node& n, const gp_XYZ& o, const gp_XYZ& inv, double tmax)
+    {
+        double t0 = 0, t1 = tmax;
+        for (int a = 0; a < 3; ++a) {
+            double ia = inv.Coord(a + 1), oa = o.Coord(a + 1);
+            double ta = (n.lo[a] - oa) * ia, tb = (n.hi[a] - oa) * ia;
+            if (std::isnan(ta) || std::isnan(tb)) {
+                // ray parallel to the slab, origin on its plane
+                if (oa < n.lo[a] || oa > n.hi[a]) {
+                    return false;
+                }
+                continue;
+            }
+            if (ta > tb) {
+                std::swap(ta, tb);
+            }
+            t0 = std::max(t0, ta);
+            t1 = std::min(t1, tb);
+            if (t0 > t1 * (1 + 1e-12) + 1e-300) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    static double boxDistance2(const Node& n, const gp_XYZ& p)
+    {
+        double d2 = 0;
+        for (int a = 0; a < 3; ++a) {
+            double v = p.Coord(a + 1);
+            double d = v < n.lo[a] ? n.lo[a] - v : (v > n.hi[a] ? v - n.hi[a] : 0);
+            d2 += d * d;
+        }
+        return d2;
+    }
+
+    // squared distance from p to triangle i (Ericson, Real-Time Collision Detection 5.1.5)
+    double triangleDistance2(int i, const gp_XYZ& p) const
+    {
+        const auto& t = tri.t[i];
+        const gp_XYZ& a = tri.p[t[0]];
+        const gp_XYZ& b = tri.p[t[1]];
+        const gp_XYZ& c = tri.p[t[2]];
+        gp_XYZ ab = b - a, ac = c - a, ap = p - a;
+        double d1 = ab.Dot(ap), d2 = ac.Dot(ap);
+        if (d1 <= 0 && d2 <= 0) {
+            return ap.SquareModulus();
+        }
+        gp_XYZ bp = p - b;
+        double d3 = ab.Dot(bp), d4 = ac.Dot(bp);
+        if (d3 >= 0 && d4 <= d3) {
+            return bp.SquareModulus();
+        }
+        double vc = d1 * d4 - d3 * d2;
+        if (vc <= 0 && d1 >= 0 && d3 <= 0) {
+            double v = d1 / (d1 - d3);
+            return (p - (a + ab * v)).SquareModulus();
+        }
+        gp_XYZ cp = p - c;
+        double d5 = ab.Dot(cp), d6 = ac.Dot(cp);
+        if (d6 >= 0 && d5 <= d6) {
+            return cp.SquareModulus();
+        }
+        double vb = d5 * d2 - d1 * d6;
+        if (vb <= 0 && d2 >= 0 && d6 <= 0) {
+            double w = d2 / (d2 - d6);
+            return (p - (a + ac * w)).SquareModulus();
+        }
+        double va = d3 * d6 - d5 * d4;
+        if (va <= 0 && (d4 - d3) >= 0 && (d5 - d6) >= 0) {
+            double w = (d4 - d3) / ((d4 - d3) + (d5 - d6));
+            return (p - (b + (c - b) * w)).SquareModulus();
+        }
+        double denom = 1.0 / (va + vb + vc);
+        double v = vb * denom, w = vc * denom;
+        return (p - (a + ab * v + ac * w)).SquareModulus();
+    }
+
+    const Triangles& tri;
+    std::vector<int> order;
+    std::vector<gp_XYZ> centroid;
+    std::vector<Node> nodes;
+};
+
+// Moeller-Trumbore; t, and whether the hit is close to an edge of the triangle
+bool rayTriangle(const Triangles& tri, int i, const gp_XYZ& o, const gp_XYZ& d, double& t, bool& nearEdge)
+{
+    const auto& tr = tri.t[i];
+    const gp_XYZ& a = tri.p[tr[0]];
+    gp_XYZ e1 = tri.p[tr[1]] - a, e2 = tri.p[tr[2]] - a;
+    gp_XYZ pv = d.Crossed(e2);
+    double det = e1.Dot(pv);
+    double scale = e1.Modulus() * e2.Modulus();
+    if (std::fabs(det) <= 1e-14 * scale) {
+        nearEdge = true;  // ray in the plane of the triangle
+        return false;
+    }
+    double inv = 1.0 / det;
+    gp_XYZ tv = o - a;
+    double u = tv.Dot(pv) * inv;
+    const double eps = 1e-9;
+    if (u < -eps || u > 1 + eps) {
+        return false;
+    }
+    gp_XYZ qv = tv.Crossed(e1);
+    double v = d.Dot(qv) * inv;
+    if (v < -eps || u + v > 1 + eps) {
+        return false;
+    }
+    t = e2.Dot(qv) * inv;
+    if (u < eps || v < eps || u + v > 1 - eps) {
+        nearEdge = true;
+    }
+    return true;
+}
+
+template<typename F>
+void parallelFor(std::size_t n, int threads, F&& f)
+{
+    int T = threads > 0 ? threads : (int)std::max(1U, std::thread::hardware_concurrency());
+    T = (int)std::max<std::size_t>(1, std::min<std::size_t>((std::size_t)T, n / 256 + 1));
+    std::atomic<std::size_t> next {0};
+    std::exception_ptr error;
+    std::mutex m;
+    auto work = [&](int tid) {
+        for (;;) {
+            std::size_t start = next.fetch_add(256);
+            if (start >= n) {
+                return;
+            }
+            for (std::size_t i = start; i < std::min(n, start + 256); ++i) {
+                try {
+                    f(i, tid);
+                }
+                catch (...) {
+                    std::lock_guard<std::mutex> lock(m);
+                    if (!error) {
+                        error = std::current_exception();
+                    }
+                    return;
+                }
+            }
+        }
+    };
+    std::vector<std::thread> pool;
+    for (int t = 1; t < T; ++t) {
+        pool.emplace_back(work, t);
+    }
+    work(0);
+    for (auto& t : pool) {
+        t.join();
+    }
+    if (error) {
+        std::rethrow_exception(error);
+    }
+}
+
+int threadCount(int threads)
+{
+    return threads > 0 ? threads : (int)std::max(1U, std::thread::hardware_concurrency());
+}
+
+}  // namespace
