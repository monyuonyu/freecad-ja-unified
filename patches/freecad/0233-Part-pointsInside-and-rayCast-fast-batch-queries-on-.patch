+// ------------------------------------------------------------------ points inside
+
+std::vector<PointState> Part::Spatial::pointsInside(
+    const TopoDS_Shape& shape,
+    const std::vector<gp_Pnt>& points,
+    double tolerance,
+    const char* method,
+    double deflection,
+    int threads,
+    InsideStats* stats
+)
+{
+    const auto t0 = std::chrono::steady_clock::now();
+    const std::string how = method ? method : "auto";
+    if (how != "auto" && how != "exact" && how != "mesh") {
+        throw Base::ValueError("method must be 'auto', 'exact' or 'mesh'");
+    }
+    TopExp_Explorer xs(shape, TopAbs_SOLID);
+    if (!xs.More()) {
+        throw Base::ValueError("pointsInside needs a solid (or a compound of solids)");
+    }
+    const double tol = std::max(tolerance, 1e-12);
+    Bnd_Box box;
+    BRepBndLib::Add(shape, box, Standard_False);
+    box.Enlarge(tol);
+
+    Triangles tri;
+    tri.deflection = defaultDeflection(box, deflection);
+    std::unique_ptr<Bvh> bvh;
+    if (how != "exact") {
+        addTriangles(tri, shape, 0);
+        bvh = std::make_unique<Bvh>(tri);
+    }
+    // the surface is within the deflection of the triangles: closer than this, ask the
+    // exact classifier
+    const double band = 2.0 * tri.deflection + tol;
+
+    std::vector<PointState> out(points.size(), PointState::Outside);
+    const int T = threadCount(threads);
+    std::vector<std::unique_ptr<BRepClass3d_SolidClassifier>> classifiers(T);
+    std::atomic<std::size_t> nBox {0}, nRay {0}, nExact {0};
+    static const gp_XYZ dirs[3] = {
+        gp_XYZ(0.5773502691896258, 0.5773502691896258, 0.5773502691896258).Added(gp_XYZ(0.0137, -0.0071, 0.0023)),
+        gp_XYZ(-0.2672612419124244, 0.5345224838248488, 0.8017837257372732),
+        gp_XYZ(0.8728715609439696, -0.2182178902359924, 0.4364357804719848),
+    };
+    auto exact = [&](const gp_Pnt& p, int tid) {
+        auto& c = classifiers[tid];
+        if (!c) {
+            c = std::make_unique<BRepClass3d_SolidClassifier>(shape);
+        }
+        c->Perform(p, tol);
+        ++nExact;
+        switch (c->State()) {
+            case TopAbs_IN:
+                return PointState::Inside;
+            case TopAbs_ON:
+                return PointState::OnBoundary;
+            default:
+                return PointState::Outside;
+        }
+    };
+    parallelFor(points.size(), T, [&](std::size_t i, int tid) {
+        const gp_Pnt& p = points[i];
+        if (box.IsOut(p)) {
+            ++nBox;
+            out[i] = PointState::Outside;
+            return;
+        }
+        if (how == "exact") {
+            out[i] = exact(p, tid);
+            return;
+        }
+        if (how == "auto" && bvh->within(p.XYZ(), band)) {
+            out[i] = exact(p, tid);
+            return;
+        }
+        for (const auto& d0 : dirs) {
+            gp_XYZ d = d0 / d0.Modulus();
+            int crossings = 0;
+            bool unsure = false;
+            bvh->ray(p.XYZ(), d, 1e300, [&](int k, double tmax) {
+                double t {};
+                bool edge = false;
+                if (rayTriangle(tri, k, p.XYZ(), d, t, edge) && t > 0) {
+                    ++crossings;
+                    unsure = unsure || edge;
+                }
+                else if (edge) {
+                    unsure = true;
+                }
+                return tmax;
+            });
+            if (!unsure) {
+                ++nRay;
+                out[i] = (crossings % 2) ? PointState::Inside : PointState::Outside;
+                return;
+            }
+        }
+        out[i] = exact(p, tid);
+    });
+    if (stats) {
+        stats->byBox = nBox;
+        stats->byRay = nRay;
+        stats->exact = nExact;
+        stats->seconds = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+    }
+    return out;
+}
+
+// ------------------------------------------------------------------ ray cast
+
+std::vector<std::vector<RayHit>> Part::Spatial::rayCast(
+    const std::vector<TopoDS_Shape>& shapes,
+    const std::vector<gp_Pnt>& origins,
+    const std::vector<gp_Dir>& dirs,
+    bool all,
+    double deflection,
+    int threads
+)
+{
+    Triangles tri;
+    for (const auto& s : shapes) {
+        if (!s.IsNull()) {
+            BRepBndLib::Add(s, tri.box, Standard_False);
+        }
+    }
+    tri.deflection = defaultDeflection(tri.box, deflection);
+    for (int i = 0; i < (int)shapes.size(); ++i) {
+        if (!shapes[i].IsNull()) {
+            addTriangles(tri, shapes[i], i);
+        }
+    }
+    Bvh bvh(tri);
+    const double diag = tri.box.IsVoid() ? 1.0 : std::sqrt(tri.box.SquareExtent());
+    const double same = std::max(diag * 1e-9, 1e-12);
+    const int T = threadCount(threads);
+    // exact intersectors per thread and face, made when first needed
+    std::vector<std::map<std::pair<int, int>, std::unique_ptr<IntCurvesFace_Intersector>>> cache(T);
+    std::vector<std::vector<RayHit>> out(origins.size());
+    parallelFor(origins.size(), T, [&](std::size_t r, int tid) {
+        const gp_XYZ o = origins[r].XYZ();
+        const gp_XYZ d = dirs[r].XYZ();
+        struct Raw
+        {
+            double t;
+            int tri;
+        };
+        std::vector<Raw> raw;
+        bvh.ray(o, d, 1e300, [&](int k, double tmax) {
+            double t {};
+            bool edge = false;
+            if (rayTriangle(tri, k, o, d, t, edge) && t >= -same && t <= tmax) {
+                raw.push_back({std::max(t, 0.0), k});
+                // only the nearest wanted: no need to look farther than this (plus the
+                // deflection, the exact surface may be a little nearer or farther)
+                return all ? tmax : t + 4 * tri.deflection;
+            }
+            return tmax;
+        });
+        std::sort(raw.begin(), raw.end(), [](const Raw& a, const Raw& b) {
+            return a.t < b.t;
+        });
+        std::vector<RayHit> hits;
+        for (const auto& h : raw) {
+            RayHit hit;
+            hit.shape = tri.shape[h.tri];
+            hit.face = tri.face[h.tri];
+            hit.distance = h.t;
+            hit.point = gp_Pnt(o + d * h.t);
+            // the triangle's normal as a fallback
+            const auto& tr = tri.t[h.tri];
+            gp_XYZ n = (tri.p[tr[1]] - tri.p[tr[0]]).Crossed(tri.p[tr[2]] - tri.p[tr[0]]);
+            if (n.Modulus() > 1e-300) {
+                hit.normal = gp_Dir(n);
+            }
+            const TopoDS_Face& face = tri.faces[hit.shape][hit.face];
+            try {
+                auto& inter = cache[tid][{hit.shape, hit.face}];
+                if (!inter) {
+                    inter = std::make_unique<IntCurvesFace_Intersector>(face, same * 10);
+                }
+                const double w = 4 * tri.deflection + same;
+                inter->Perform(gp_Lin(gp_Pnt(o), gp_Dir(d)), std::max(0.0, h.t - w) - same, h.t + w);
+                int best = 0;
+                for (int k = 1; k <= inter->NbPnt(); ++k) {
+                    if (!best || std::fabs(inter->WParameter(k) - h.t)
+                            < std::fabs(inter->WParameter(best) - h.t)) {
+                        best = k;
+                    }
+                }
+                if (best) {
+                    hit.distance = std::max(0.0, inter->WParameter(best));
+                    hit.point = inter->Pnt(best);
+                    BRepGProp_Face prop(face);
+                    gp_Pnt p;
+                    gp_Vec nv;
+                    prop.Normal(inter->UParameter(best), inter->VParameter(best), p, nv);
+                    if (nv.Magnitude() > 1e-300) {
+                        hit.normal = gp_Dir(nv);
+                    }
+                }
+            }
+            catch (const Standard_Failure&) {
+                // keep the triangle's point and normal
+            }
+            // one hit per face crossing (a ray through an edge of two triangles)
+            bool dup = false;
+            for (const auto& prev : hits) {
+                if (prev.shape == hit.shape && std::fabs(prev.distance - hit.distance) <= same * 1000) {
+                    dup = true;
+                }
+            }
+            if (!dup) {
+                hits.push_back(hit);
+            }
+        }
+        std::sort(hits.begin(), hits.end(), [](const RayHit& a, const RayHit& b) {
+            return a.distance < b.distance;
+        });
+        if (!all && hits.size() > 1) {
+            hits.resize(1);
+        }
+        out[r] = std::move(hits);
+    });
+    return out;
+}
+
+// ------------------------------------------------------------------ Python
+
+namespace
+{
+
+gp_Pnt toPnt(const Py::Object& obj)
+{
+    if (PyObject_TypeCheck(obj.ptr(), &Base::VectorPy::Type)) {
+        Base::Vector3d v = static_cast<Base::VectorPy*>(obj.ptr())->value();
+        return {v.x, v.y, v.z};
+    }
+    Py::Sequence seq(obj);
+    if (seq.size() != 3) {
+        throw Py::ValueError("A point needs three coordinates");
+    }
+    return {(double)Py::Float(seq[0]), (double)Py::Float(seq[1]), (double)Py::Float(seq[2])};
+}
+
+TopoDS_Shape toShape(const Py::Object& o)
+{
+    Py::Object obj = o;
+    if (!PyObject_TypeCheck(obj.ptr(), &Part::TopoShapePy::Type) && obj.hasAttr("Shape")) {
+        obj = obj.getAttr("Shape");
+    }
+    if (!PyObject_TypeCheck(obj.ptr(), &Part::TopoShapePy::Type)) {
+        throw Py::TypeError("Expected a shape or an object with a Shape");
+    }
+    return static_cast<Part::TopoShapePy*>(obj.ptr())->getTopoShapePtr()->getShape();
+}
+
+Py::Object vec(const gp_XYZ& v)
+{
+    return Py::asObject(new Base::VectorPy(Base::Vector3d(v.X(), v.Y(), v.Z())));
+}
+
+template<typename F>
+PyObject* guarded(F&& f)
+{
+    try {
+        return f();
+    }
+    catch (const Py::Exception&) {
+        return nullptr;
+    }
+    catch (const Base::Exception& e) {
+        e.setPyException();
+        return nullptr;
+    }
+    catch (const Standard_Failure& e) {
+        PyErr_SetString(Part::PartExceptionOCCError, e.GetMessageString());
+        return nullptr;
+    }
+}
+
+PyObject* pointsInsidePy(PyObject* /*self*/, PyObject* args, PyObject* kwds)
+{
+    static const char* kwlist[] = {"shape", "points", "tolerance", "method", "boundary",
+                                   "deflection", "threads", "stats", nullptr};
+    PyObject* shapeObj {};
+    PyObject* pointsObj {};
+    double tolerance = 1e-6, deflection = 0;
+    const char* method = "auto";
+    PyObject* boundary = Py_True;
+    PyObject* withStats = Py_False;
+    int threads = 0;
+    if (!PyArg_ParseTupleAndKeywords(args, kwds, "OO|dsOdiO", const_cast<char**>(kwlist), &shapeObj,
+                                     &pointsObj, &tolerance, &method, &boundary, &deflection,
+                                     &threads, &withStats)) {
+        return nullptr;
+    }
+    return guarded([&]() -> PyObject* {
+        TopoDS_Shape shape = toShape(Py::Object(shapeObj));
+        std::vector<gp_Pnt> points;
+        Py::Sequence seq(pointsObj);
+        points.reserve(seq.size());
+        for (const auto& p : seq) {
+            points.push_back(toPnt(p));
+        }
+        const std::string how = method;
+        InsideStats stats;
+        std::vector<PointState> states;
+        {
+            Py_BEGIN_ALLOW_THREADS
+            try {
+                states = pointsInside(shape, points, tolerance, how.c_str(), deflection, threads, &stats);
+            }
+            catch (...) {
+                Py_BLOCK_THREADS
+                throw;
+            }
+            Py_END_ALLOW_THREADS
+        }
+        const bool onIsIn = PyObject_IsTrue(boundary) == 1;
+        Py::List list(states.size());
+        for (std::size_t i = 0; i < states.size(); ++i) {
+            bool in = states[i] == PointState::Inside || (onIsIn && states[i] == PointState::OnBoundary);
+            list[i] = Py::Boolean(in);
+        }
+        if (PyObject_IsTrue(withStats) != 1) {
+            return Py::new_reference_to(list);
+        }
+        Py::Dict d;
+        d["points"] = Py::Long((long)points.size());
+        d["byBox"] = Py::Long((long)stats.byBox);
+        d["byRay"] = Py::Long((long)stats.byRay);
+        d["exact"] = Py::Long((long)stats.exact);
+        d["seconds"] = Py::Float(stats.seconds);
+        return Py::new_reference_to(Py::TupleN(list, d));
+    });
+}
+
+PyObject* rayCastPy(PyObject* /*self*/, PyObject* args, PyObject* kwds)
+{
+    static const char* kwlist[] = {"shapes", "origin", "direction", "all", "deflection", "threads", nullptr};
+    PyObject* shapesObj {};
+    PyObject* originObj {};
+    PyObject* dirObj {};
+    PyObject* allHits = Py_False;
+    double deflection = 0;
+    int threads = 0;
+    if (!PyArg_ParseTupleAndKeywords(args, kwds, "OOO|Odi", const_cast<char**>(kwlist), &shapesObj,
+                                     &originObj, &dirObj, &allHits, &deflection, &threads)) {
+        return nullptr;
+    }
+    return guarded([&]() -> PyObject* {
+        std::vector<TopoDS_Shape> shapes;
+        Py::Object so(shapesObj);
+        if (PyObject_TypeCheck(shapesObj, &Part::TopoShapePy::Type) || so.hasAttr("Shape")) {
+            shapes.push_back(toShape(so));
+        }
+        else {
+            for (const auto& s : Py::Sequence(so)) {
+                shapes.push_back(toShape(s));
+            }
+        }
+        // one ray (point, vector) or many (lists of the same length)
+        auto isPoint = [](PyObject* o) {
+            if (PyObject_TypeCheck(o, &Base::VectorPy::Type)) {
+                return true;
+            }
+            Py::Sequence s(o);
+            return s.size() == 3 && PyNumber_Check(s[0].ptr());
+        };
+        const bool single = isPoint(originObj);
+        std::vector<gp_Pnt> origins;
+        std::vector<gp_Dir> dirs;
+        if (single) {
+            origins.push_back(toPnt(Py::Object(originObj)));
+        }
+        else {
+            for (const auto& p : Py::Sequence(originObj)) {
+                origins.push_back(toPnt(p));
+            }
+        }
+        if (isPoint(dirObj)) {
+            gp_Pnt d = toPnt(Py::Object(dirObj));
+            if (gp_Vec(d.XYZ()).Magnitude() < 1e-300) {
+                throw Py::ValueError("direction must not be zero");
+            }
+            dirs.assign(origins.size(), gp_Dir(d.XYZ()));
+        }
+        else {
+            for (const auto& p : Py::Sequence(dirObj)) {
+                gp_Pnt d = toPnt(p);
+                if (gp_Vec(d.XYZ()).Magnitude() < 1e-300) {
+                    throw Py::ValueError("direction must not be zero");
+                }
+                dirs.emplace_back(d.XYZ());
+            }
+            if (dirs.size() != origins.size()) {
+                throw Py::ValueError("as many directions as origins are needed");
+            }
+        }
+        const bool wantAll = PyObject_IsTrue(allHits) == 1;
+        std::vector<std::vector<RayHit>> hits;
+        {
+            Py_BEGIN_ALLOW_THREADS
+            try {
+                hits = rayCast(shapes, origins, dirs, wantAll, deflection, threads);
+            }
+            catch (...) {
+                Py_BLOCK_THREADS
+                throw;
+            }
+            Py_END_ALLOW_THREADS
+        }
+        auto toList = [&](const std::vector<RayHit>& list) {
+            Py::List l;
+            for (const auto& h : list) {
+                Py::Dict d;
+                d["distance"] = Py::Float(h.distance);
+                d["shape"] = Py::Long(h.shape);
+                d["face"] = Py::Long(h.face);
+                d["point"] = vec(h.point.XYZ());
+                d["normal"] = vec(h.normal.XYZ());
+                l.append(d);
+            }
+            return l;
+        };
+        if (single) {
+            if (wantAll) {
+                return Py::new_reference_to(toList(hits[0]));
+            }
+            if (hits[0].empty()) {
+                Py_Return;
+            }
+            return Py::new_reference_to(toList(hits[0])[0]);
+        }
+        Py::List result;
+        for (const auto& h : hits) {
+            if (wantAll) {
+                result.append(toList(h));
+            }
+            else if (h.empty()) {
+                result.append(Py::None());
+            }
+            else {
+                result.append(toList(h)[0]);
+            }
+        }
+        return Py::new_reference_to(result);
+    });
+}
+
+PyMethodDef methods[] = {
+    {"pointsInside",
+     reinterpret_cast<PyCFunction>(reinterpret_cast<void (*)()>(pointsInsidePy)),
+     METH_VARARGS | METH_KEYWORDS,
+     "pointsInside(shape, points, tolerance=1e-6, method='auto', boundary=True, deflection=0,\n"
+     "             threads=0, stats=False) -> [bool, ...]\n"
+     "Whether each point is inside the solid (a solid or a compound of solids that do not\n"
+     "overlap); points on the surface (within tolerance) count as inside unless\n"
+     "boundary=False.  Much faster than Shape.isInside in a loop: a bounding box test, then\n"
+     "counting the crossings of a ray with a triangulation (in a tree), and the exact\n"
+     "classifier only for points near the surface (method='auto').  method='exact' uses the\n"
+     "classifier for every point (in parallel), 'mesh' never.  With stats=True returns\n"
+     "(list, {'points', 'byBox', 'byRay', 'exact', 'seconds'})."},
+    {"rayCast",
+     reinterpret_cast<PyCFunction>(reinterpret_cast<void (*)()>(rayCastPy)),
+     METH_VARARGS | METH_KEYWORDS,
+     "rayCast(shapes, origin, direction, all=False, deflection=0, threads=0)\n"
+     "Where the ray origin + t * direction (t >= 0) hits the faces of the shapes.\n"
+     "Returns the nearest hit {'distance', 'shape' (index in shapes), 'face' (index in its\n"
+     "Faces, 0 based), 'point', 'normal' (outward normal of the face)} or None; with\n"
+     "all=True a list of all hits, nearest first.  origin and direction may be lists (many\n"
+     "rays, or one direction for all): the result is then a list per ray.  A triangulation\n"
+     "in a tree finds the face, the exact intersection with it gives the point."},
+    {nullptr, nullptr, 0, nullptr}
+};
+
+}  // namespace
+
+void Part::Spatial::addPythonFunctions(PyObject* module)
+{
+    PyModule_AddFunctions(module, methods);
+}
