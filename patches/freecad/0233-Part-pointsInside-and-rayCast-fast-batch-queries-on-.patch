+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+/***************************************************************************
+ *   Fast spatial queries on shapes: many points inside/outside a solid    *
+ *   and ray casts, with a bounding volume tree over a triangulation and   *
+ *   the exact classifier only near the surface.                           *
+ ***************************************************************************/
+
+#pragma once
+
+#include <Python.h>
+
+#include <vector>
+
+#include <gp_Dir.hxx>
+#include <gp_Pnt.hxx>
+#include <TopoDS_Shape.hxx>
+
+#include <Mod/Part/PartGlobal.h>
+
+namespace Part::Spatial
+{
+
+enum class PointState
+{
+    Outside = 0,
+    Inside = 1,
+    OnBoundary = 2,
+};
+
+struct InsideStats
+{
+    std::size_t byBox = 0;  // outside the bounding box
+    std::size_t byRay = 0;  // decided by counting crossings of the triangulation
+    std::size_t exact = 0;  // near the surface: BRepClass3d_SolidClassifier
+    double seconds = 0;
+};
+
+/// State of each point.  \a method: "auto" (triangulation, exact near the surface),
+/// "exact" (the classifier for every point, still in parallel) or "mesh" (triangulation
+/// only).  \a deflection 0: from the size of the shape.
+PartExport std::vector<PointState> pointsInside(
+    const TopoDS_Shape& shape,
+    const std::vector<gp_Pnt>& points,
+    double tolerance,
+    const char* method,
+    double deflection,
+    int threads,
+    InsideStats* stats = nullptr
+);
+
+struct RayHit
+{
+    double distance = 0;
+    int shape = 0;  // index in the list of shapes
+    int face = 0;  // index in the shape's Faces (0 based)
+    gp_Pnt point;
+    gp_Dir normal;  // outward normal of the face at the point
+};
+
+/// Hits of the ray origin + t * dir (t >= 0) with the faces of \a shapes, nearest first
+/// (only the nearest unless \a all).  The triangulation finds the face, the exact
+/// intersection with that face gives the point.
+PartExport std::vector<std::vector<RayHit>> rayCast(
+    const std::vector<TopoDS_Shape>& shapes,
+    const std::vector<gp_Pnt>& origins,
+    const std::vector<gp_Dir>& dirs,
+    bool all,
+    double deflection,
+    int threads
+);
+
+void addPythonFunctions(PyObject* module);
+
+}  // namespace Part::Spatial
