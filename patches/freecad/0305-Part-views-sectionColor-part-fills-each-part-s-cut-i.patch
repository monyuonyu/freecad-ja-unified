diff --git a/src/Mod/Part/parttests/TestPartViews.py b/src/Mod/Part/parttests/TestPartViews.py
index 5a0a7f767..f747d6f6c 100644
--- a/src/Mod/Part/parttests/TestPartViews.py
+++ b/src/Mod/Part/parttests/TestPartViews.py
@@ -601,6 +601,17 @@ class TestPartViewOptions(unittest.TestCase):
                                    section=(App.Vector(0, 0, 1), App.Vector(0, 0, -1)))  # fmt: skip
         self.assertEqual({f["item"] for f in data["faces"]}, {0, 1})
 
+    def testSectionColorOfEachPart(self):
+        # sectionColor="part": each part's cut in a darker shade of its own colour
+        items = [{"shape": Part.makeBox(10, 10, 10), "color": (1, 0, 0)},
+                 {"shape": Part.makeBox(10, 10, 10, App.Vector(20, 0, 0)), "color": (0, 0, 1)}]  # fmt: skip
+        section = (App.Vector(0, 0, 5), App.Vector(0, 0, 1))
+        def cut_colors(**kw):
+            data = Part.projectVisible(items, view="top", section=section, **kw)
+            return {f["item"]: tuple(round(c, 3) for c in f["color"]) for f in data["faces"] if f["section"]}
+        self.assertEqual(cut_colors(), {0: (0.93, 0.45, 0.38), 1: (0.93, 0.45, 0.38)})
+        self.assertEqual(cut_colors(sectionColor="part"), {0: (0.72, 0, 0), 1: (0, 0, 0.72)})
+
     def testSectionInPictureAndFiles(self):
         png = os.path.join(self.dir, "s.png")
         Part.renderImage(self.holed, png, view="iso", width=80, height=60, style="hidden-lines",
