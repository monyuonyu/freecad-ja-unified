From a00e67f78e9ef925e67b01b1cb6bc23abed6bcc3 Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Fri, 23 Oct 2026 08:52:33 +0900
Subject: [PATCH 295/399] Assembly joints without activating the assembly;
 small holes win the pick; picks refused in words

- The joint tools work on the document's only assembly without
  double-clicking it first (it is made active when a joint starts).
- Picking a joint's element: a round face or circle edge a few pixels
  from a click on a flat face wins (a small pin hole lost to the face
  around it).
- A pick a tool does not take is said in words, not as
  "Unnamed.Body.Sketch001.Constraint7"; a constraint's symbol says to pick
  a line, a circle or a point.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/Gui/Selection/Selection.cpp        | 39 ++++++++++++---
 src/Mod/Assembly/CommandCreateJoint.py |  2 +
 src/Mod/Assembly/JointObject.py        | 68 ++++++++++++++++++++++++++
 src/Mod/Assembly/UtilsAssembly.py      | 31 +++++++++++-
 4 files changed, 132 insertions(+), 8 deletions(-)

diff --git a/src/Gui/Selection/Selection.cpp b/src/Gui/Selection/Selection.cpp
index c885c00bc..8f98c889b 100644
--- a/src/Gui/Selection/Selection.cpp
+++ b/src/Gui/Selection/Selection.cpp
@@ -916,6 +916,14 @@ bool SelectionSingleton::hasSelectionGate(App::Document* /*pDoc*/) const
     return ActiveGate != nullptr;
 }
 
+namespace Gui
+{
+namespace
+{
+QString describePick(const char* documentName, const char* objectName, const char* subName);
+}
+}  // namespace Gui
+
 int SelectionSingleton::setPreselect(
     const char* pDocName,
     const char* pObjectName,
@@ -977,12 +985,31 @@ int SelectionSingleton::setPreselect(
             else {
                 msg = QCoreApplication::translate("SelectionFilter", "Not allowed:");
             }
-            msg.append(QStringLiteral(" %1.%2.%3 ")
-                           .arg(
-                               QString::fromLatin1(pDocName),
-                               QString::fromLatin1(pObjectName),
-                               QString::fromLatin1(pSubName)
-                           ));
+            if (App::isSingleWorkbench()) {
+                // Words, not internal names ("Unnamed.Body.Sketch001.Constraint7"): what it is
+                // and what to pick instead (engine field test 0.6.9)
+                std::string sub = pSubName ? pSubName : "";
+                std::string element = sub.substr(sub.find_last_of('.') + 1);
+                if (element.rfind("Constraint", 0) == 0) {
+                    msg = QCoreApplication::translate(
+                        "SelectionFilter",
+                        "A constraint's symbol cannot be picked for this: pick a line, a circle or a point"
+                    );
+                }
+                else {
+                    QString words = describePick(pDocName, pObjectName, pSubName);
+                    msg = QCoreApplication::translate("SelectionFilter", "This tool does not take %1")
+                              .arg(words.isEmpty() ? QString::fromUtf8(pObjectName) : words);
+                }
+            }
+            else {
+                msg.append(QStringLiteral(" %1.%2.%3 ")
+                               .arg(
+                                   QString::fromLatin1(pDocName),
+                                   QString::fromLatin1(pObjectName),
+                                   QString::fromLatin1(pSubName)
+                               ));
+            }
 
             if (getMainWindow()) {
                 getMainWindow()->showMessage(msg);
diff --git a/src/Mod/Assembly/CommandCreateJoint.py b/src/Mod/Assembly/CommandCreateJoint.py
index b5e216407..f1cb9661b 100644
--- a/src/Mod/Assembly/CommandCreateJoint.py
+++ b/src/Mod/Assembly/CommandCreateJoint.py
@@ -52,6 +52,8 @@ def isCreateJointActive():
 def activateJoint(index):
     if JointObject.activeTask:
         JointObject.activeTask.reject()
+    # The sole assembly of the document, without double-clicking it first
+    UtilsAssembly.ensureActiveAssembly()
 
     Gui.addModule("JointObject")  # NOLINT
