--- /dev/null
+++ b/src/Mod/Unified/TaskPanels.py
@@ -0,0 +1,154 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""Short tool panels (docs/ui-redesign/00-design.md 5.5, 6.8): what each tool shows at first.
+
+A tool's panel shows its few most important fields (at most three: e.g. a pad's length and
+"reverse", and how it ends only when it is not the usual way); everything else is under
+「詳しく ▸」, closed until opened — and whether it was left open is remembered for each tool.
+
+This file is the table and the rule (tested headless, "FreeCADCmd -t TestTaskPanels");
+TaskPanelsGui.py hides and shows the rows of the panels.
+
+Each entry, by the class of the panel's box (the part after "::"):
+  first:     the fields shown at first (the Qt object names of their input widgets)
+  unusual:   fields shown at first only when not at their usual choice: name → usual index
+  with:      widgets that go with a shown field (the panel shows or hides them itself)
+  fold:      widgets under 「詳しく」 although they are in the row of a shown field
+"""
+
+PREVIEW_BOX = "TaskPreviewParameters"
+
+# Fields counted as "fields" for the at-most-three rule (labels, buttons and lists that go
+# with a field are not)
+EXTRUDE_WITH = [
+    # what the panel shows for the way it ends (two lengths, up to a face, offset…)
+    "lengthEdit2", "offsetEdit", "lineFaceName", "buttonFace", "upToShapeList",
+    "labelLength2", "labelOffset", "labelLength",
+]
+
+PANELS = {
+    "TaskPadParameters": {
+        "tool": "PartDesign_Pad",
+        "first": ["lengthEdit", "checkBoxReversed"],
+        "unusual": {"changeMode": 0, "sidesMode": 0},
+        "with": EXTRUDE_WITH,
+    },
+    "TaskPocketParameters": {
+        "tool": "PartDesign_Pocket",
+        # cutting through everything is as usual as a depth: the way it ends is always shown
+        "first": ["changeMode", "lengthEdit", "checkBoxReversed"],
+        "unusual": {"sidesMode": 0},
+        "with": EXTRUDE_WITH,
+    },
+    "TaskRevolutionParameters": {
+        "tool": "PartDesign_Revolution",
+        "first": ["axis", "revolveAngle", "checkBoxReversed"],
+        "unusual": {"changeMode": 0, "sidesMode": 0},
+        "with": ["revolveAngle2", "lineFaceName", "buttonFace", "labelAngle"],
+    },
+    "TaskGrooveParameters": {
+        "tool": "PartDesign_Groove",
+        "first": ["axis", "revolveAngle", "checkBoxReversed"],
+        "unusual": {"changeMode": 0, "sidesMode": 0},
+        "with": ["revolveAngle2", "lineFaceName", "buttonFace", "labelAngle"],
+    },
+    "TaskHoleParameters": {
+        "tool": "PartDesign_Hole",
+        "first": ["Diameter", "DepthType", "Depth"],
+        # a threaded hole shows its thread
+        "unusual": {"ThreadType": 0, "HoleCutType": 0},
+        "with": ["ThreadSize", "ThreadClass", "ThreadFit", "Threaded", "ModelThread", "labelThreadSize"],
+        # in the row of the depth, but rarely changed: the angle of the drill's tip
+        "fold": ["DrillFrame"],
+    },
+    "TaskFilletParameters": {
+        "tool": "PartDesign_Fillet",
+        "first": ["listWidgetReferences", "filletRadius"],
+        "with": ["buttonRefSel"],
+    },
+    "TaskChamferParameters": {
+        "tool": "PartDesign_Chamfer",
+        "first": ["listWidgetReferences", "chamferSize"],
+        "unusual": {"chamferType": 0},
+        "with": ["buttonRefSel", "stackedWidget", "chamferSize2", "chamferAngle"],
+    },
+    "TaskThicknessParameters": {
+        "tool": "PartDesign_Thickness",
+        "first": ["listWidgetReferences", "Value", "checkReverse"],
+        "unusual": {"modeComboBox": 0},
+        "with": ["buttonRefSel"],
+    },
+    "TaskDraftParameters": {
+        "tool": "PartDesign_Draft",
+        "first": ["listWidgetReferences", "draftAngle", "checkReverse"],
+        "with": ["buttonRefSel", "buttonPlane", "linePlane", "buttonLine", "lineLine"],
+    },
+    "TaskMirroredParameters": {
+        "tool": "PartDesign_Mirrored",
+        "first": ["listWidgetFeatures", "comboPlane"],
+        "with": ["buttonAddFeature", "buttonRemoveFeature"],
+    },
+    "TaskPatternParameters": {
+        # straight and round patterns share the panel
+        "tool": "PartDesign_LinearPattern",
+        "first": ["comboDirection", "spinExtent", "spinOccurrences"],
+        "unusual": {"comboMode": 0},
+        "with": ["PushButtonReverse", "spinOffset", "listWidgetFeatures", "buttonAddFeature", "buttonRemoveFeature"],
+    },
+    "TaskLinearPatternParameters": {
+        "tool": "PartDesign_LinearPattern",
+        "first": ["comboDirection", "spinLength", "spinOccurrences"],
+        "unusual": {"comboMode": 0},
+        "with": ["checkReverse", "spinOffset", "listWidgetFeatures", "buttonAddFeature", "buttonRemoveFeature"],
+    },
+    "TaskPolarPatternParameters": {
+        "tool": "PartDesign_PolarPattern",
+        "first": ["comboAxis", "polarAngle", "spinOccurrences"],
+        "unusual": {"comboMode": 0},
+        "with": ["checkReverse", "angleOffset", "listWidgetFeatures", "buttonAddFeature", "buttonRemoveFeature"],
+    },
+}
+
+# Always under 「詳しく」 (never one of the first fields): "recompute on change" is always on in
+# this environment and the preview switches are rarely needed (00-design.md 6.8)
+ALWAYS_FOLDED = ("checkBoxUpdateView",)
+
+# Inputs that count as fields (labels, buttons that pick, and lists of picks do not)
+NOT_FIELDS = ("buttonRefSel", "buttonAddFeature", "buttonRemoveFeature", "PushButtonReverse")
+
+
+def entry(box_class):
+    """The table entry of a panel's box, by its class name ("PartDesignGui::TaskPadParameters")"""
+    return PANELS.get(box_class.split("::")[-1])
+
+
+def shown_first(entry, current=None):
+    """The object names shown before 「詳しく」 is opened. current: name → the index chosen now
+    (for the fields that are shown only when unusual)"""
+    current = current or {}
+    names = list(entry["first"]) + list(entry.get("with", ()))
+    for name, usual in entry.get("unusual", {}).items():
+        if name in current and current[name] != usual:
+            names.append(name)
+    return [n for n in names if n not in ALWAYS_FOLDED]
+
+
+def field_count(entry, current=None):
+    """How many fields are shown at first (the at-most-three rule, usual choices)"""
+    current = current or {}
+    names = list(entry["first"])
+    for name, usual in entry.get("unusual", {}).items():
+        if name in current and current[name] != usual:
+            names.append(name)
+    return len([n for n in names if n not in NOT_FIELDS])
+
+
+def param_key(box_class, type_id=None):
+    """Where the open/closed state of 「詳しく」 is kept, per tool (by the kind of the step edited,
+    when known: straight and round patterns share a panel)"""
+    if type_id:
+        return type_id.replace("::", "_")
+    e = entry(box_class)
+    return e["tool"] if e else box_class.split("::")[-1]
+
+
+PARAM_PATH = "User parameter:BaseApp/Preferences/Mod/Unified/TaskFold"
diff --git a/src/Mod/Unified/TaskPanelsGui.py b/src/Mod/Unified/TaskPanelsGui.py
new file mode 100644
index 000000000..93305ef19
--- /dev/null
+++ b/src/Mod/Unified/TaskPanelsGui.py
@@ -0,0 +1,342 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""Short tool panels: the few important fields first, the rest under 「詳しく ▸」 (TaskPanels.py).
+
+When a tool's panel opens, the rows of its box that hold none of the first fields are hidden
+and a 「詳しく ▸」 button opens them (remembered for each tool). The panel keeps showing and hiding
+its own rows (e.g. a second length for "two lengths"): what it asks for while folded is applied
+when 「詳しく」 opens. Lists of picked edges and faces read in words (SelectionWords.py).
+"""
+
+import FreeCAD as App
+import FreeCADGui as Gui
+from PySide import QtCore, QtWidgets
+
+import TaskPanels as TP
+
+translate = App.Qt.translate
+
+
+def params():
+    return App.ParamGet(TP.PARAM_PATH)
+
+
+def _rows(layout):
+    """The rows of a layout: lists of layout items"""
+    rows = []
+    if isinstance(layout, QtWidgets.QGridLayout):
+        by_row = {}
+        for i in range(layout.count()):
+            r, _c, _rs, _cs = layout.getItemPosition(i)
+            by_row.setdefault(r, []).append(layout.itemAt(i))
+        rows = [by_row[r] for r in sorted(by_row)]
+    elif isinstance(layout, QtWidgets.QFormLayout):
+        for r in range(layout.rowCount()):
+            items = [
+                layout.itemAt(r, role)
+                for role in (QtWidgets.QFormLayout.LabelRole, QtWidgets.QFormLayout.FieldRole,
+                             QtWidgets.QFormLayout.SpanningRole)
+            ]
+            items = [i for i in items if i is not None]
+            if items:
+                rows.append(items)
+    else:
+        rows = [[layout.itemAt(i)] for i in range(layout.count())]
+    return rows
+
+
+def _widgets_of_item(item):
+    """The widgets an item of a layout holds (directly or in its nested layouts)"""
+    w = item.widget()
+    if w is not None:
+        return [w]
+    lay = item.layout()
+    if lay is None:
+        return []
+    out = []
+    for i in range(lay.count()):
+        out += _widgets_of_item(lay.itemAt(i))
+    return out
+
+
+def _stacked(layout):
+    """A layout of rows (not one row of things side by side)"""
+    if layout is None:
+        return False
+    if isinstance(layout, QtWidgets.QBoxLayout):
+        return layout.direction() in (QtWidgets.QBoxLayout.TopToBottom, QtWidgets.QBoxLayout.BottomToTop)
+    return True
+
+
+def _with_labels(proxy, names):
+    """The kept fields and their labels (by buddy, or named "label" + the field's name)"""
+    out = set(names)
+    for label in proxy.findChildren(QtWidgets.QLabel):
+        buddy = label.buddy()
+        if buddy is not None and buddy.objectName() in names:
+            out.add(label.objectName())
+    for name in names:
+        out.add("label" + name)
+    return out
+
+
+def _names_inside(widget):
+    names = {widget.objectName()}
+    for c in widget.findChildren(QtWidgets.QWidget):
+        names.add(c.objectName())
+    return names
+
+
+class Fold(QtCore.QObject):
+    """The fold of one box of a panel"""
+
+    def __init__(self, box, entry, key):
+        super().__init__(box)
+        self.box = box
+        self.entry = entry
+        self.key = key
+        self.folded = []  # widgets hidden by the fold
+        self.wanted = {}  # widget → visible as the panel wants it
+        self.boxes = []  # whole boxes folded (the preview)
+        self.open = params().GetBool(key, False)
+        self.busy = False
+        self.button = None
+
+    # -- what is shown first
+
+    def current_choices(self):
+        out = {}
+        for name in self.entry.get("unusual", {}):
+            w = self.box.findChild(QtWidgets.QComboBox, name)
+            if w is not None:
+                out[name] = w.currentIndex()
+        return out
+
+    def proxy(self):
+        """The widget of the box that holds the fields (the box's own content)"""
+        for name in self.entry["first"]:
+            w = self.box.findChild(QtWidgets.QWidget, name)
+            if w is None:
+                continue
+            while w.parentWidget() is not None and w.parentWidget().parentWidget() is not self.box:
+                w = w.parentWidget()
+            if w.parentWidget() is not None and w.layout() is not None:
+                return w
+        return None
+
+    def collect(self, layout, keep, out):
+        for row in _rows(layout):
+            widgets = [w for item in row for w in _widgets_of_item(item)]
+            if not widgets:
+                continue
+            inside = set()
+            for w in widgets:
+                inside |= _names_inside(w)
+            if not (inside & keep):
+                out += widgets
+                continue
+            # A row with a kept field: look inside its containers for rows to fold (a row laid
+            # out side by side, like a label and its field, stays whole)
+            for w in widgets:
+                if w.objectName() in keep:
+                    continue
+                if _names_inside(w) & keep and _stacked(w.layout()):
+                    self.collect(w.layout(), keep, out)
+            for item in row:
+                if item.widget() is None and _stacked(item.layout()):
+                    self.collect(item.layout(), keep, out)
+
+    def apply(self):
+        proxy = self.proxy()
+        if proxy is None:
+            return False
+        keep = _with_labels(proxy, set(TP.shown_first(self.entry, self.current_choices())))
+        keep.discard("")
+        found = []
+        self.collect(proxy.layout(), keep, found)
+        for name in tuple(TP.ALWAYS_FOLDED) + tuple(self.entry.get("fold", ())):
+            w = proxy.findChild(QtWidgets.QWidget, name)
+            if w is not None and w not in found:
+                found.append(w)
+        self.folded = [w for w in found if w is not None]
+        for w in self.folded:
+            self.wanted[w] = not w.isHidden()
+            w.installEventFilter(self)
+        self.add_button(proxy)
+        self.update()
+        return True
+
+    def add_button(self, proxy):
+        if not self.folded:
+            return
+        b = QtWidgets.QToolButton(proxy)
+        b.setObjectName("UnifiedDetails")
+        b.setAutoRaise(True)
+        b.setCheckable(True)
+        b.setChecked(self.open)
+        b.toggled.connect(self.toggle)
+        lay = proxy.layout()
+        if isinstance(lay, QtWidgets.QGridLayout):
+            lay.addWidget(b, lay.rowCount(), 0, 1, max(1, lay.columnCount()), QtCore.Qt.AlignLeft)
+        elif isinstance(lay, QtWidgets.QFormLayout):
+            lay.addRow(b)
+        else:
+            lay.addWidget(b, 0, QtCore.Qt.AlignLeft)
+        self.button = b
+
+    def fold_box(self, other):
+        """A whole other box of the panel under 「詳しく」 (the preview)"""
+        self.boxes.append(other)
+        self.wanted[other] = not other.isHidden()
+        other.installEventFilter(self)
+        self.update()
+
+    def toggle(self, on):
+        self.open = on
+        params().SetBool(self.key, on)
+        self.update()
+
+    def update(self):
+        self.busy = True
+        try:
+            for w in self.folded + self.boxes:
+                try:
+                    w.setVisible(self.wanted.get(w, True) if self.open else False)
+                except RuntimeError:
+                    pass
+        finally:
+            self.busy = False
+        if self.button is not None:
+            self.button.setText(
+                translate("Unified", "Details ▾") if self.open else translate("Unified", "Details ▸")
+            )
+            self.button.setToolTip(
+                translate("Unified", "Close the other settings")
+                if self.open
+                else translate("Unified", "Show the other settings of this tool")
+            )
+
+    def eventFilter(self, obj, event):
+        if self.busy:
+            return False
+        t = event.type()
+        if t == QtCore.QEvent.Show or t == QtCore.QEvent.Hide:
+            if obj in self.wanted and obj.parentWidget() is not None and not obj.parentWidget().isHidden():
+                # The panel showed or hid it (its own logic): remember, and keep it folded
+                if t == QtCore.QEvent.Show:
+                    self.wanted[obj] = True
+                    if not self.open:
+                        QtCore.QTimer.singleShot(0, self.update)
+                elif obj.isHidden():
+                    self.wanted[obj] = False
+        return False
+
+
+# -- picked edges and faces in words
+
+
+def _words_for_list(box, edited):
+    lw = box.findChild(QtWidgets.QListWidget, "listWidgetReferences")
+    if lw is None or edited is None:
+        return
+    base = getattr(edited, "Base", None)
+    if not isinstance(base, tuple) or not base or base[0] is None:
+        return
+    import SelectionWords as W
+
+    obj = base[0]
+
+    def relabel(*_args):
+        for i in range(lw.count()):
+            item = lw.item(i)
+            sub = item.data(QtCore.Qt.UserRole)
+            if not sub:
+                continue
+            try:
+                text = W.describe(obj, sub)
+            except Exception:
+                continue
+            if text and item.text() != text:
+                item.setText(text)
+                item.setToolTip(sub)
+
+    relabel()
+    if not lw.property("unifiedWords"):
+        lw.setProperty("unifiedWords", True)
+        lw.model().rowsInserted.connect(lambda *_a: QtCore.QTimer.singleShot(0, relabel))
+
+
+# -- watching the panel
+
+
+class Watcher(QtCore.QObject):
+    def __init__(self):
+        super().__init__(Gui.getMainWindow())
+        self.timer = QtCore.QTimer(self)
+        self.timer.setInterval(120)
+        self.timer.timeout.connect(self.scan)
+        self.timer.start()
+        self.folds = []
+
+    def edited(self):
+        try:
+            vp = Gui.ActiveDocument.getInEdit() if Gui.ActiveDocument else None
+        except Exception:
+            vp = None
+        return vp.Object if vp is not None and hasattr(vp, "Object") else None
+
+    def scan(self):
+        if Gui.Control.activeDialog() is False or not Gui.Control.activeDialog():
+            return
+        panel = Gui.getMainWindow().findChild(QtWidgets.QWidget, "Tasks")
+        if panel is None:
+            return
+        boxes = [
+            w for w in panel.findChildren(QtWidgets.QWidget)
+            if w.metaObject().className().startswith(("PartDesignGui::Task", "PartGui::Task"))
+            and w.isVisible() is not None
+        ]
+        new = [b for b in boxes if not b.property("unifiedFold")]
+        if not new:
+            return
+        edited = self.edited()
+        type_id = edited.TypeId if edited is not None else None
+        main = None
+        for b in new:
+            b.setProperty("unifiedFold", True)
+            cls = b.metaObject().className()
+            e = TP.entry(cls)
+            if e is None:
+                continue
+            fold = Fold(b, e, TP.param_key(cls, type_id))
+            try:
+                if fold.apply():
+                    self.folds.append(fold)
+                    main = fold
+                _words_for_list(b, edited)
+            except Exception as err:
+                App.Console.PrintLog("Task panel fold: {}\n".format(err))
+        if main is not None:
+            for b in boxes:
+                if b.metaObject().className().endswith(TP.PREVIEW_BOX) and not b.property("unifiedFoldBox"):
+                    b.setProperty("unifiedFoldBox", True)
+                    main.fold_box(b)
+        self.folds = [f for f in self.folds if _alive(f.box)]
+
+
+def _alive(w):
+    try:
+        import shiboken6
+
+        return shiboken6.isValid(w)
+    except Exception:
+        return True
+
+
+_watcher = None
+
+
+def install():
+    global _watcher
+    if _watcher is None:
+        _watcher = Watcher()
+    return _watcher
