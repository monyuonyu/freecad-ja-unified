+# SPDX-License-Identifier: LGPL-2.1-or-later
+# Tests of Wording (the tool names of the terminology table), headless:
+#   FreeCADCmd -t TestWording
+
+import unittest
+
+import Wording as W
+
+# The tool strip of the integrated environment (Gui/Workbench.cpp), the PartDesign ones
+STRIP = [
+    "PartDesign_NewSketch", "PartDesign_Pad", "PartDesign_Pocket", "PartDesign_Revolution",
+    "PartDesign_Fillet", "PartDesign_Chamfer", "PartDesign_Thickness", "PartDesign_Mirrored",
+    "PartDesign_LinearPattern", "PartDesign_PolarPattern", "Std_TransformManip", "Std_Measure",
+]
+# The sketch's step band (UnifiedChrome.SKETCH_TOOLS)
+SKETCH_BAND = [
+    "Sketcher_CreatePolyline", "Sketcher_CreateRectangle", "Sketcher_CreateCircle", "Sketcher_CreateArc",
+    "Sketcher_CreateHexagon", "Sketcher_Dimension", "Sketcher_ConstrainHorVer", "Sketcher_ConstrainParallel",
+    "Sketcher_ConstrainPerpendicular", "Sketcher_ConstrainEqual", "Sketcher_ConstrainCoincidentUnified",
+    "Sketcher_ConstrainSymmetric", "Sketcher_ConstrainLock", "Sketcher_Trimming", "Sketcher_Extend",
+    "Sketcher_CreateFillet",
+]
+
+
+class WordingTest(unittest.TestCase):
+    def test_no_stock_words_left(self):
+        for command, (name, _tip) in W.TOOLS.items():
+            self.assertEqual(W.problems(name), [], "{}: {}".format(command, name))
+
+    def test_the_words_of_the_table(self):
+        names = {c: n for c, (n, _t) in W.TOOLS.items()}
+        self.assertEqual(names["PartDesign_Pad"], "押し出す")
+        self.assertEqual(names["PartDesign_Pocket"], "切り抜く")
+        self.assertEqual(names["PartDesign_Revolution"], "回す")
+        self.assertEqual(names["PartDesign_Mirrored"], "鏡に映す")
+        self.assertEqual(names["Std_Measure"], "測る")
+        self.assertEqual(names["Std_TransformManip"], "動かす")
+        self.assertEqual(names["Sketcher_CreateCircle"], "円（中心から）")
+        self.assertEqual(names["Sketcher_ConstrainCoincidentUnified"], "点をつなぐ")
+        self.assertEqual(names["Sketcher_ConstrainParallel"], "平行")
+
+    def test_strip_and_band_have_names_and_tooltips(self):
+        for command in STRIP + SKETCH_BAND:
+            self.assertIn(command, W.TOOLS, command)
+            name, tip = W.TOOLS[command]
+            self.assertTrue(name)
+            self.assertTrue(tip, "{} has no tooltip saying what happens".format(command))
+            self.assertLessEqual(len(tip), 60, command)
+
+    def test_the_rule_catches_stock_names(self):
+        self.assertTrue(W.problems("中心点による円"))
+        self.assertTrue(W.problems("直線配列"))
+        self.assertTrue(W.problems("平行拘束"))
+        self.assertTrue(W.problems("先端を設定"))
+        self.assertTrue(W.problems("回転"))
+        self.assertFalse(W.problems("三角形の網（メッシュ）を書き出す…"))
+        self.assertFalse(W.problems("競合する拘束を選択"))
+        self.assertFalse(W.problems("左に回転"))  # the view turns: not a tool that makes a shape
+        self.assertFalse(W.problems("拘束"))
+
+    def test_the_same_tool_has_one_name(self):
+        # Two names for one meaning would be two words for one thing
+        by_name = {}
+        for command, (name, _tip) in W.TOOLS.items():
+            by_name.setdefault(name, []).append(command)
+        self.assertEqual(sorted(by_name["鏡に映す"]), ["PartDesign_Mirrored", "Part_Mirror", "Sketcher_Symmetry"])
+
+
+if __name__ == "__main__":
+    unittest.main()
