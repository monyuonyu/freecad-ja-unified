@@ -0,0 +1,210 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+# Tests of SelectionWords (a pick in words instead of internal names), headless:
+#   FreeCADCmd -t TestSelectionWords
+
+import unittest
+
+import FreeCAD as App
+import Part
+import Sketcher
+
+import SelectionWords as W
+
+
+def rectangle(sk, x0, y0, x1, y1):
+    pts = [App.Vector(x0, y0, 0), App.Vector(x1, y0, 0), App.Vector(x1, y1, 0), App.Vector(x0, y1, 0)]
+    first = len(sk.Geometry)
+    for i in range(4):
+        sk.addGeometry(Part.LineSegment(pts[i], pts[(i + 1) % 4]))
+    for i in range(4):
+        sk.addConstraint(Sketcher.Constraint("Coincident", first + i, 2, first + (i + 1) % 4, 1))
+
+
+def find(shape, kind, test):
+    """Names of the elements of a kind ("Face", "Edge") that pass the test"""
+    items = shape.Faces if kind == "Face" else shape.Edges
+    return ["%s%d" % (kind, i + 1) for i, x in enumerate(items) if test(x)]
+
+
+def all_planes_around(shape, edge):
+    return all(type(f.Surface).__name__ == "Plane" for f in shape.ancestorsOfType(edge, Part.Face))
+
+
+def plane_normal(face):
+    u, v = face.Surface.parameter(face.CenterOfMass)
+    return face.normalAt(u, v)
+
+
+class SelectionWordsTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.doc = doc = App.newDocument("SelectionWordsTest")
+        body = doc.addObject("PartDesign::Body", "Body")
+        sk = body.newObject("Sketcher::SketchObject", "Sketch")
+        sk.AttachmentSupport = (body.Origin.OriginFeatures[3], [""])
+        sk.MapMode = "FlatFace"
+        rectangle(sk, 0, 0, 80, 50)
+        pad = body.newObject("PartDesign::Pad", "Pad")
+        pad.Profile = sk
+        pad.Length = 5
+        pad.Label = "板"
+        doc.recompute()
+        # A through hole cut with a pocket from a circle
+        sk2 = body.newObject("Sketcher::SketchObject", "Sketch001")
+        sk2.AttachmentSupport = (body.Origin.OriginFeatures[3], [""])
+        sk2.MapMode = "FlatFace"
+        sk2.addGeometry(Part.Circle(App.Vector(20, 20, 0), App.Vector(0, 0, 1), 3))
+        pocket = body.newObject("PartDesign::Pocket", "Pocket")
+        pocket.Profile = sk2
+        pocket.Type = 1
+        pocket.Reversed = True
+        pocket.Label = "切り抜き"
+        doc.recompute()
+        # A blind square pocket (has a floor)
+        sk3 = body.newObject("Sketcher::SketchObject", "Sketch002")
+        sk3.AttachmentSupport = (body.Origin.OriginFeatures[3], [""])
+        sk3.MapMode = "FlatFace"
+        sk3.AttachmentOffset = App.Placement(App.Vector(0, 0, 5), App.Rotation())
+        rectangle(sk3, 50, 10, 70, 30)
+        pocket2 = body.newObject("PartDesign::Pocket", "Pocket001")
+        pocket2.Profile = sk3
+        pocket2.Length = 2
+        pocket2.Label = "くぼみ"
+        doc.recompute()
+        box = doc.addObject("Part::Box", "Box")
+        box.Label = "箱"
+        box.Placement.Base = App.Vector(200, 0, 0)
+        doc.recompute()
+        cls.body, cls.pad, cls.pocket, cls.pocket2, cls.box = body, pad, pocket, pocket2, box
+
+    @classmethod
+    def tearDownClass(cls):
+        App.closeDocument(cls.doc.Name)
+
+    def shape(self):
+        return self.pocket2.Shape
+
+    def test_top_and_bottom_of_the_plate(self):
+        s = self.shape()
+        top = find(s, "Face", lambda f: type(f.Surface).__name__ == "Plane" and plane_normal(f).z > 0.99
+                   and abs(f.CenterOfMass.z - 5) < 1e-6)
+        bottom = find(s, "Face", lambda f: type(f.Surface).__name__ == "Plane" and plane_normal(f).z < -0.99
+                      and abs(f.CenterOfMass.z) < 1e-6)
+        self.assertEqual(len(top), 1)
+        self.assertEqual(W.words(self.pocket2, top[0]), ("top", "板"))
+        self.assertEqual(W.words(self.pocket2, bottom[0]), ("bottom", "板"))
+        self.assertEqual(W.describe(self.pocket2, top[0]), "板: top face")
+
+    def test_the_picks_on_the_part_itself(self):
+        s = self.shape()
+        top = find(s, "Face", lambda f: type(f.Surface).__name__ == "Plane" and plane_normal(f).z > 0.99
+                   and abs(f.CenterOfMass.z - 5) < 1e-6)[0]
+        # Picked on the part (body): the step where it ends has the face
+        self.assertEqual(W.words(self.body, top), ("top", "板"))
+        self.assertEqual(W.words(self.body, ""), (None, self.body.Label))
+
+    def test_the_hole_wall_is_inside(self):
+        s = self.shape()
+        wall = find(s, "Face", lambda f: type(f.Surface).__name__ == "Cylinder")
+        self.assertEqual(len(wall), 1)
+        self.assertEqual(W.words(self.pocket2, wall[0]), ("inner", "切り抜き ⌀6"))
+
+    def test_the_pocket_floor_and_walls(self):
+        s = self.shape()
+        floor = find(s, "Face", lambda f: type(f.Surface).__name__ == "Plane" and abs(f.CenterOfMass.z - 3) < 1e-6)
+        self.assertEqual(len(floor), 1)
+        self.assertEqual(W.words(self.pocket2, floor[0]), ("floor", "くぼみ"))
+        walls = find(s, "Face", lambda f: type(f.Surface).__name__ == "Plane" and abs(plane_normal(f).z) < 1e-6
+                     and f.BoundBox.ZMin > 2.9)
+        self.assertEqual(len(walls), 4)
+        for w in walls:
+            self.assertEqual(W.words(self.pocket2, w), ("inner", "くぼみ"))
+
+    def test_four_vertical_edges_counted(self):
+        s = self.shape()
+        corners = find(s, "Edge", lambda e: type(e.Curve).__name__ == "Line"
+                       and abs(App.Vector(e.Curve.Direction).z) > 0.999 and e.Length > 4.9
+                       and all_planes_around(s, e))
+        self.assertEqual(len(corners), 4)
+        for e in corners:
+            self.assertEqual(W.words(self.pocket2, e), ("vertical edge", "板"))
+        text = W.describe_picks([(self.pocket2, e) for e in corners])
+        self.assertEqual(text, "板: vertical edge ×4")
+
+    def test_top_edges_and_the_rim_of_the_hole(self):
+        s = self.shape()
+        top_edges = find(s, "Edge", lambda e: type(e.Curve).__name__ == "Line" and e.Length > 49
+                         and abs(e.BoundBox.ZMin - 5) < 1e-6)
+        self.assertTrue(top_edges)
+        self.assertEqual(W.words(self.pocket2, top_edges[0])[0], "top edge")
+        rims = find(s, "Edge", lambda e: type(e.Curve).__name__ == "Circle")
+        self.assertEqual(len(rims), 2)
+        self.assertEqual(W.words(self.pocket2, rims[0]), ("rim", "切り抜き ⌀6"))
+
+    def test_mixed_picks(self):
+        s = self.shape()
+        wall = find(s, "Face", lambda f: type(f.Surface).__name__ == "Cylinder")[0]
+        corners = find(s, "Edge", lambda e: type(e.Curve).__name__ == "Line"
+                       and abs(App.Vector(e.Curve.Direction).z) > 0.999 and e.Length > 4.9
+                       and all_planes_around(s, e))
+        picks = [(self.pocket2, corners[0]), (self.pocket2, wall), (self.pocket2, corners[1])]
+        self.assertEqual(W.describe_picks(picks), "板: vertical edge ×2、切り抜き ⌀6: inner face")
+        many = [(self.pocket2, c) for c in corners] + [(self.pocket2, wall), (self.box, "Face1"), (self.box, "Face6")]
+        text = W.describe_picks(many)
+        self.assertTrue(text.startswith("板: vertical edge ×4、切り抜き ⌀6: inner face"), text)
+        self.assertIn("2 more", text)
+
+    def test_a_plain_solid_by_its_faces(self):
+        # Part::Box faces: 1..4 the sides, 5 bottom, 6 top
+        self.assertEqual(W.words(self.box, "Face6"), ("top", "箱"))
+        self.assertEqual(W.words(self.box, "Face5"), ("bottom", "箱"))
+        self.assertEqual(W.words(self.box, "Face1"), ("side", "箱"))
+        self.assertEqual(W.words(self.box, "Vertex1"), ("corner", "箱"))
+        self.assertEqual(W.words(self.box, ""), (None, "箱"))
+
+    def test_hole_feature_named_by_its_diameter(self):
+        doc = self.doc
+        body = doc.addObject("PartDesign::Body", "Body001")
+        sk = body.newObject("Sketcher::SketchObject", "SketchH")
+        sk.AttachmentSupport = (body.Origin.OriginFeatures[3], [""])
+        sk.MapMode = "FlatFace"
+        rectangle(sk, 0, 0, 30, 30)
+        pad = body.newObject("PartDesign::Pad", "PadH")
+        pad.Profile = sk
+        pad.Length = 8
+        doc.recompute()
+        top = find(pad.Shape, "Face", lambda f: type(f.Surface).__name__ == "Plane" and plane_normal(f).z > 0.99)[0]
+        skh = body.newObject("Sketcher::SketchObject", "SketchH2")
+        skh.AttachmentSupport = (pad, [top])
+        skh.MapMode = "FlatFace"
+        skh.addGeometry(Part.Circle(App.Vector(15, 15, 0), App.Vector(0, 0, 1), 2))
+        hole = body.newObject("PartDesign::Hole", "Hole")
+        hole.Profile = skh
+        hole.Diameter = 6
+        hole.DepthType = "ThroughAll"
+        hole.Label = "穴"
+        doc.recompute()
+        self.assertTrue(hole.Shape.isValid())
+        walls = find(hole.Shape, "Face", lambda f: type(f.Surface).__name__ == "Cylinder")
+        self.assertTrue(walls)
+        self.assertEqual(W.words(hole, walls[0]), ("inner", "穴 ⌀6"))
+        self.assertEqual(W.describe(hole, walls[0]), "穴 ⌀6: inner face")
+
+    def test_japanese_phrase_spacing(self):
+        saved = W.translate
+        try:
+            W.translate = lambda ctx, text: {"{name}: inner face": "{name}の内側の面",
+                                             "{name}: top face": "{name}の上面"}.get(text, text)
+            self.assertEqual(W.phrase("inner", "穴 ⌀6"), "穴 ⌀6 の内側の面")
+            self.assertEqual(W.phrase("top", "板"), "板の上面")
+        finally:
+            W.translate = saved
+
+    def test_numbers(self):
+        self.assertEqual(W.num(6.0), "6")
+        self.assertEqual(W.num(6.35), "6.35")
+        self.assertEqual(W.num(2.999999), "3")
+
+
+if __name__ == "__main__":
+    unittest.main()
