+            if (obj && obj->isAttachedToDocument()) {
+                return QString::fromUtf8(obj->getFullName().c_str());
+            }
+            return {};
+        }
+        if ((role == Qt::ForegroundRole || role == Qt::ToolTipRole || role == Qt::FontRole)
+            && afterTheLine(object()->getObject())) {
+            // Lighter than a hidden step and slanted: hidden steps are greyed too
