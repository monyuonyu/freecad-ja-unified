+# SPDX-License-Identifier: LGPL-2.1-or-later
+# Tests of TaskPanels (what a tool's panel shows before 「詳しく」), headless:
+#   FreeCADCmd -t TestTaskPanels
+
+import unittest
+
+import TaskPanels as TP
+
+COMMON = [
+    "TaskPadParameters",
+    "TaskPocketParameters",
+    "TaskRevolutionParameters",
+    "TaskGrooveParameters",
+    "TaskHoleParameters",
+    "TaskFilletParameters",
+    "TaskChamferParameters",
+    "TaskThicknessParameters",
+    "TaskMirroredParameters",
+    "TaskPatternParameters",
+]
+
+
+class TaskPanelsTest(unittest.TestCase):
+    def test_the_common_tools_are_covered(self):
+        for name in COMMON:
+            self.assertIsNotNone(TP.entry("PartDesignGui::" + name), name)
+
+    def test_at_most_three_fields_first(self):
+        for name, e in TP.PANELS.items():
+            self.assertLessEqual(TP.field_count(e), 3, name)
+            self.assertGreaterEqual(TP.field_count(e), 2, name)
+
+    def test_pad(self):
+        e = TP.entry("PartDesignGui::TaskPadParameters")
+        first = TP.shown_first(e, {"changeMode": 0, "sidesMode": 0})
+        self.assertIn("lengthEdit", first)
+        self.assertIn("checkBoxReversed", first)
+        self.assertNotIn("changeMode", first)  # the usual way: up to a length
+        self.assertNotIn("taperEdit", first)
+        self.assertNotIn("checkBoxUpdateView", first)
+        # "up to a face": the way it ends is shown, and what goes with it
+        first = TP.shown_first(e, {"changeMode": 2, "sidesMode": 0})
+        self.assertIn("changeMode", first)
+        self.assertIn("buttonFace", first)
+        self.assertEqual(TP.field_count(e, {"changeMode": 2, "sidesMode": 0}), 3)
+
+    def test_pocket_shows_how_it_ends(self):
+        e = TP.entry("PartDesignGui::TaskPocketParameters")
+        self.assertEqual(TP.shown_first(e)[:3], ["changeMode", "lengthEdit", "checkBoxReversed"])
+
+    def test_hole_thread_only_when_threaded(self):
+        e = TP.entry("PartDesignGui::TaskHoleParameters")
+        self.assertNotIn("ThreadType", TP.shown_first(e, {"ThreadType": 0}))
+        self.assertIn("ThreadType", TP.shown_first(e, {"ThreadType": 1}))
+
+    def test_remembered_per_tool(self):
+        self.assertEqual(TP.param_key("PartDesignGui::TaskPadParameters"), "PartDesign_Pad")
+        # straight and round patterns share a panel, not the remembered state
+        self.assertEqual(
+            TP.param_key("PartDesignGui::TaskPatternParameters", "PartDesign::PolarPattern"),
+            "PartDesign_PolarPattern",
+        )
+        self.assertNotEqual(
+            TP.param_key("PartDesignGui::TaskPatternParameters", "PartDesign::LinearPattern"),
+            TP.param_key("PartDesignGui::TaskPatternParameters", "PartDesign::PolarPattern"),
+        )
+
+    def test_unknown_panel(self):
+        self.assertIsNone(TP.entry("SketcherGui::TaskSketcherConstraints"))
+
+
+if __name__ == "__main__":
+    unittest.main()
