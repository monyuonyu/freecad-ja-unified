+namespace
+{
+// The words of the integrated environment for a pick, or empty (no Python module, an error)
+QString describePick(const char* documentName, const char* objectName, const char* subName)
+{
+    Base::PyGILStateLocker lock;
+    try {
+        Py::Module module(PyImport_ImportModule("SelectionWords"), true);
+        if (module.isNull()) {
+            PyErr_Clear();
+            return {};
+        }
+        Py::Tuple args(3);
+        args.setItem(0, Py::String(documentName ? documentName : ""));
+        args.setItem(1, Py::String(objectName ? objectName : ""));
+        args.setItem(2, Py::String(subName ? subName : ""));
+        Py::Object result = module.callMemberFunction("preselection_text", args);
+        if (result.isString()) {
+            return QString::fromStdString(Py::String(result).as_std_string("utf-8"));
+        }
+    }
+    catch (Py::Exception&) {
+        Base::PyException e;  // never in the way of the pick (the plain words are shown)
+        Base::Console().log("SelectionWords: {}\n", e.what());
+    }
+    return {};
+}
