index 000000000..e811697f5
--- /dev/null
+++ b/src/Mod/Unified/TestHistoryLine.py
@@ -0,0 +1,130 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+# Tests of HistoryLine (the "in effect up to here" line of a part's history), headless:
+#   FreeCADCmd -t TestHistoryLine
+
+import unittest
+
+import FreeCAD as App
+import Part
+import Sketcher
+
+import HistoryLine as HL
+
+
+def rectangle(sk, x0, y0, x1, y1):
+    pts = [App.Vector(x0, y0, 0), App.Vector(x1, y0, 0), App.Vector(x1, y1, 0), App.Vector(x0, y1, 0)]
+    first = len(sk.Geometry)
+    for i in range(4):
+        sk.addGeometry(Part.LineSegment(pts[i], pts[(i + 1) % 4]))
+    for i in range(4):
+        sk.addConstraint(Sketcher.Constraint("Coincident", first + i, 2, first + (i + 1) % 4, 1))
+
+
+class HistoryLineTest(unittest.TestCase):
+    def setUp(self):
+        self.doc = App.newDocument("HistoryLineTest")
+        self.doc.UndoMode = 1
+        doc = self.doc
+        self.body = body = doc.addObject("PartDesign::Body", "Body")
+        sk = body.newObject("Sketcher::SketchObject", "Sketch")
+        sk.AttachmentSupport = (body.Origin.OriginFeatures[3], [""])
+        sk.MapMode = "FlatFace"
+        rectangle(sk, 0, 0, 40, 30)
+        self.pad = body.newObject("PartDesign::Pad", "Pad")
+        self.pad.Profile = sk
+        self.pad.Length = 5
+        doc.recompute()
+        sk2 = body.newObject("Sketcher::SketchObject", "Sketch001")
+        sk2.AttachmentSupport = (body.Origin.OriginFeatures[3], [""])
+        sk2.MapMode = "FlatFace"
+        sk2.addGeometry(Part.Circle(App.Vector(10, 10, 0), App.Vector(0, 0, 1), 3))
+        self.sk2 = sk2
+        self.pocket = body.newObject("PartDesign::Pocket", "Pocket")
+        self.pocket.Profile = sk2
+        self.pocket.Type = 1  # through all
+        self.pocket.Reversed = True
+        doc.recompute()
+        self.full = 40 * 30 * 5
+        self.hole = 3.141592653589793 * 9 * 5
+
+    def tearDown(self):
+        App.closeDocument(self.doc.Name)
+
+    def test_at_the_end_after_modelling(self):
+        self.assertEqual(HL.steps(self.body), [self.pad, self.pocket])
+        self.assertEqual(HL.position(self.body), 2)
+        self.assertTrue(HL.at_end(self.body))
+        self.assertEqual(HL.not_in_effect(self.body), [])
+        self.assertAlmostEqual(self.body.Shape.Volume, self.full - self.hole, places=3)
+
+    def test_roll_back_greys_what_is_below(self):
+        self.assertTrue(HL.move_line(self.body, 1))
+        self.assertIs(self.body.Tip, self.pad)
+        self.assertFalse(HL.at_end(self.body))
+        self.assertTrue(HL.after_line(self.pocket))
+        self.assertTrue(HL.after_line(self.sk2))
+        self.assertFalse(HL.after_line(self.pad))
+        self.assertFalse(HL.after_line(self.body))
+        self.assertAlmostEqual(self.body.Shape.Volume, self.full, places=3)
+        # Moving to where it is already: nothing happens, no undo step
+        undo = self.doc.UndoCount
+        self.assertFalse(HL.move_line(self.body, 1))
+        self.assertEqual(self.doc.UndoCount, undo)
+
+    def test_one_undo_step(self):
+        undo = self.doc.UndoCount
+        HL.move_line(self.body, 1)
+        self.assertEqual(self.doc.UndoCount, undo + 1)
+        self.doc.undo()
+        self.doc.recompute()
+        self.assertIs(self.body.Tip, self.pocket)
+        self.assertTrue(HL.at_end(self.body))
+        self.doc.redo()
+        self.doc.recompute()
+        self.assertIs(self.body.Tip, self.pad)
+
+    def test_a_step_added_goes_to_the_line_and_the_end_brings_all_back(self):
+        HL.move_line(self.body, 1)
+        sk3 = self.body.newObject("Sketcher::SketchObject", "Sketch002")
+        sk3.AttachmentSupport = (self.pad, ["Face6"])  # the top face of the plate
+        sk3.MapMode = "FlatFace"
+        rectangle(sk3, 0, 0, 10, 10)
+        boss = self.body.newObject("PartDesign::Pad", "Pad001")
+        boss.Profile = sk3
+        boss.Length = 4
+        self.doc.recompute()
+        # The new step is right after the line's place, before the cut that was below it
+        self.assertEqual(HL.steps(self.body), [self.pad, boss, self.pocket])
+        self.assertIs(self.body.Tip, boss)
+        self.assertTrue(HL.after_line(self.pocket))
+        self.assertTrue(HL.to_end(self.body))
+        self.assertIs(self.body.Tip, self.pocket)
+        self.assertTrue(HL.at_end(self.body))
+        self.assertTrue(self.body.Shape.isValid())
+        self.assertGreater(self.body.Shape.Volume, self.full - self.hole + 1)
+
+    def test_above_all_steps(self):
+        self.assertTrue(HL.move_line(self.body, 0))
+        self.assertIsNone(self.body.Tip)
+        self.assertEqual(HL.position(self.body), 0)
+        self.assertEqual(set(HL.not_in_effect(self.body)), set(self.body.Group))
+        self.assertTrue(HL.to_end(self.body))
+        self.assertAlmostEqual(self.body.Shape.Volume, self.full - self.hole, places=3)
+
+    def test_insert_here_from_the_right_click(self):
+        self.assertTrue(HL.insert_after(self.pad))
+        self.assertEqual(HL.position(self.body), 1)
+        HL.to_end(self.body)
+        # On a sketch: after the last step made before it
+        self.assertTrue(HL.insert_after(self.sk2))
+        self.assertIs(self.body.Tip, self.pad)
+
+    def test_not_a_part(self):
+        box = self.doc.addObject("Part::Box", "Box")
+        self.assertIsNone(HL.body_of(box))
+        self.assertFalse(HL.after_line(box))
+        self.assertFalse(HL.insert_after(box))
+
+
+if __name__ == "__main__":
+    unittest.main()
