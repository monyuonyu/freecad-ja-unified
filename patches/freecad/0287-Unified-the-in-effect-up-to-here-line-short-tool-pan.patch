diff --git a/src/Mod/Unified/SelectionWords.py b/src/Mod/Unified/SelectionWords.py
new file mode 100644
index 000000000..1324b3cce
--- /dev/null
+++ b/src/Mod/Unified/SelectionWords.py
@@ -0,0 +1,452 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""What is picked, in words instead of internal names (docs/ui-redesign/00-design.md 6.8).
+
+"Pad.Face6" becomes 「押し出しの上面」, four vertical edges of a pad 「押し出しの縦の辺 ×4」, the wall of a
+hole 「穴 ⌀6 の内側の面」. The words come from the step that made the face or edge (the first step of
+the part whose shape has it), its role there (top / bottom / side, inside / outside, along the
+extrusion), the kind of geometry, and the picks that read the same are counted together.
+
+App side only (FreeCADCmd can test it): describe(obj, sub) and describe_picks(picks).
+"""
+
+import math
+from collections import OrderedDict
+
+import FreeCAD as App
+import Part
+
+translate = App.Qt.translate
+CONTEXT = "SelectionWords"
+
+
+def QT_TRANSLATE_NOOP(context, text):
+    return text
+
+
+def T(text):
+    return QT_TRANSLATE_NOOP(CONTEXT, text)
+
+
+# The phrase of each role; {name} is the step (or the object) that made the element
+PHRASES = {
+    "top": T("{name}: top face"),
+    "bottom": T("{name}: bottom face"),
+    "end": T("{name}: end face"),
+    "start": T("{name}: start face"),
+    "floor": T("{name}: floor"),
+    "side": T("{name}: side face"),
+    "slanted": T("{name}: slanted face"),
+    "inner": T("{name}: inner face"),
+    "outer": T("{name}: outer face"),
+    "face": T("{name}: face"),
+    "curved": T("{name}: curved face"),
+    "cone": T("{name}: conical face"),
+    "sphere": T("{name}: spherical face"),
+    "vertical edge": T("{name}: vertical edge"),
+    "top edge": T("{name}: top edge"),
+    "bottom edge": T("{name}: bottom edge"),
+    "horizontal edge": T("{name}: horizontal edge"),
+    "slanted edge": T("{name}: slanted edge"),
+    "along edge": T("{name}: edge along the extrusion"),
+    "rim": T("{name}: rim"),
+    "arc edge": T("{name}: arc edge"),
+    "curved edge": T("{name}: curved edge"),
+    "edge": T("{name}: edge"),
+    "corner": T("{name}: corner"),
+}
+
+TOL = 1e-6
+UP = App.Vector(0, 0, 1)
+
+EXTRUDE_TYPES = ("PartDesign::FeatureExtrude", "Part::Extrusion")
+CUT_TYPES = ("PartDesign::Pocket", "PartDesign::Groove", "PartDesign::Hole", "PartDesign::FeatureSubtractive")
+TRANSFORM_TYPES = ("PartDesign::Transformed",)
+
+
+def _is(obj, *types):
+    return any(obj.isDerivedFrom(t) for t in types)
+
+
+def num(value):
+    """6.0 → "6", 6.35 → "6.35" (millimetres, the way they are written on a drawing)"""
+    value = float(value)
+    text = "{:.2f}".format(value).rstrip("0").rstrip(".")
+    return text if text not in ("-0", "") else "0"
+
+
+# -- what is picked
+
+
+def resolve(obj, sub):
+    """(leaf object, element name like "Face6", or "")"""
+    sub = sub or ""
+    element = sub.split(".")[-1] if sub else ""
+    path = sub[: len(sub) - len(element)]
+    leaf = obj
+    if path:
+        try:
+            found = obj.getSubObject(path, retType=1)
+        except Exception:
+            found = None
+        if found is not None:
+            leaf = found
+    if element and leaf.isDerivedFrom("PartDesign::Body") and leaf.Tip is not None:
+        leaf = leaf.Tip  # a pick on the part is a pick on the step where it ends
+    return leaf, element
+
+
+def _element(leaf, element):
+    """The element as part of the whole shape of the object (so that its neighbours are found)"""
+    try:
+        shape = Part.getShape(leaf).getElement(element)
+    except Exception:
+        return None
+    return shape if not shape.isNull() else None
+
+
+def _face_sample(face):
+    """A point well inside the face, and the outward normal there"""
+    try:
+        pts, tris = face.tessellate(0.5)
+    except Exception:
+        pts, tris = [], []
+    best, area = None, -1.0
+    for a, b, c in tris:
+        pa, pb, pc = pts[a], pts[b], pts[c]
+        s = (pb - pa).cross(pc - pa).Length
+        if s > area:
+            best, area = (pa + pb + pc) * (1.0 / 3.0), s
+    if best is None:
+        best = face.CenterOfMass
+    u, v = face.Surface.parameter(best)
+    p = face.Surface.value(u, v)
+    try:
+        n = face.normalAt(u, v)
+    except Exception:
+        n = App.Vector(0, 0, 0)
+    return p, n
+
+
+def _edge_sample(edge):
+    a, b = edge.ParameterRange
+    t = (a + b) / 2.0
+    p = edge.valueAt(t)
+    try:
+        d = edge.tangentAt(t)
+    except Exception:
+        d = App.Vector(0, 0, 0)
+    return p, d
+
+
+def _near(box, p, tol=1e-4):
+    return (
+        box.XMin - tol <= p.x <= box.XMax + tol
+        and box.YMin - tol <= p.y <= box.YMax + tol
+        and box.ZMin - tol <= p.z <= box.ZMax + tol
+    )
+
+
+def _has_face(shape, p, n, kind):
+    v = Part.Vertex(p)
+    for f in shape.Faces:
+        if type(f.Surface).__name__ != kind or not _near(f.BoundBox, p):
+            continue
+        if f.distToShape(v)[0] > 1e-5:
+            continue
+        try:
+            u, w = f.Surface.parameter(p)
+            if f.normalAt(u, w).dot(n) < 0.999:
+                continue
+        except Exception:
+            continue
+        return True
+    return False
+
+
+def _has_edge(shape, p, d, kind):
+    v = Part.Vertex(p)
+    for e in shape.Edges:
+        if type(e.Curve).__name__ != kind or not _near(e.BoundBox, p):
+            continue
+        if e.distToShape(v)[0] > 1e-5:
+            continue
+        try:
+            t = e.Curve.parameter(p)
+            if abs(e.tangentAt(t).dot(d)) < 0.999:
+                continue
+        except Exception:
+            continue
+        return True
+    return False
+
+
+def _has_vertex(shape, p):
+    return any((x.Point - p).Length < 1e-5 for x in shape.Vertexes)
+
+
+def _steps_until(leaf):
+    """The steps of the leaf's part up to the leaf, in the order they were made"""
+    body = None
+    for parent in leaf.InList:
+        if parent.isDerivedFrom("PartDesign::Body") and leaf in parent.Group:
+            body = parent
+            break
+    if body is None or not leaf.isDerivedFrom("PartDesign::Feature"):
+        return [leaf]
+    steps = [o for o in body.Group if o.isDerivedFrom("PartDesign::Feature")]
+    return steps[: steps.index(leaf) + 1] if leaf in steps else [leaf]
+
+
+def producer(leaf, element, shape=None):
+    """The step that made the element: the first one whose shape has it"""
+    shape = shape if shape is not None else _element(leaf, element)
+    steps = _steps_until(leaf)
+    if shape is None or len(steps) == 1:
+        return steps[-1]
+    kind = element.rstrip("0123456789")
+    if kind == "Face":
+        p, n = _face_sample(shape)
+        test = lambda s: _has_face(s, p, n, type(shape.Surface).__name__)  # noqa: E731
+    elif kind == "Edge":
+        p, d = _edge_sample(shape)
+        test = lambda s: _has_edge(s, p, d, type(shape.Curve).__name__)  # noqa: E731
+    elif kind == "Vertex":
+        test = lambda s: _has_vertex(s, shape.Point)  # noqa: E731
+    else:
+        return steps[-1]
+    for step in steps:
+        try:
+            s = Part.getShape(step)
+        except Exception:
+            continue
+        if not s.isNull() and test(s):
+            return step
+    return steps[-1]
+
+
+# -- the role of the element in the step that made it
+
+
+def _origin_step(step):
+    """A copy (mirror, pattern) reads like what it copies"""
+    if _is(step, *TRANSFORM_TYPES):
+        originals = [o for o in getattr(step, "Originals", []) or [] if o is not None]
+        if originals:
+            return _origin_step(originals[0])
+    return step
+
+
+def _extrude_axis(step):
+    """The direction a pad / pocket / extrusion went in (world), or None"""
+    if step.isDerivedFrom("Part::Extrusion"):
+        d = App.Vector(step.Dir)
+        return d.normalize() if d.Length > TOL else None
+    if not step.isDerivedFrom("PartDesign::FeatureExtrude"):
+        return None
+    profile = getattr(step, "Profile", None)
+    sk = profile[0] if isinstance(profile, tuple) else profile
+    if sk is None:
+        return None
+    try:
+        n = sk.getGlobalPlacement().Rotation.multVec(UP)
+    except Exception:
+        return None
+    if getattr(step, "Reversed", False):
+        n = -n
+    if step.isDerivedFrom("PartDesign::Pocket"):
+        n = -n  # a pocket goes into the material, against the sketch's normal
+    return n
+
+
+def _name(step, extra=""):
+    label = step.Label
+    return "{} {}".format(label, extra) if extra else label
+
+
+def _cut(step):
+    return _is(step, *CUT_TYPES)
+
+
+def face_role(face, step, axis):
+    """(role, size text) of a face"""
+    kind = type(face.Surface).__name__
+    p, n = _face_sample(face)
+    if kind == "Plane":
+        if axis is not None and abs(n.dot(axis)) > 0.99:
+            if _cut(step):
+                return "floor", ""
+            if abs(axis.dot(UP)) > 0.9:
+                return ("top" if n.z > 0 else "bottom"), ""
+            return ("end" if n.dot(axis) > 0 else "start"), ""
+        if axis is not None:
+            return ("inner" if _cut(step) else "side"), ""
+        if n.z > 0.99:
+            return "top", ""
+        if n.z < -0.99:
+            return "bottom", ""
+        if abs(n.z) < 0.01:
+            return "side", ""
+        return "slanted", ""
+    if kind == "Cylinder":
+        c = face.Surface
+        a = App.Vector(c.Axis)
+        v = p - c.Center
+        radial = v - a * v.dot(a)
+        inner = radial.Length > TOL and n.dot(radial) < 0
+        if step.isDerivedFrom("PartDesign::Fillet"):
+            return "face", "R" + num(c.Radius)
+        return ("inner" if inner else "outer"), "⌀" + num(2 * c.Radius)
+    if kind == "Cone":
+        return "cone", ""
+    if kind == "Sphere":
+        return "sphere", "R" + num(face.Surface.Radius)
+    if step.isDerivedFrom("PartDesign::Fillet") and kind == "Toroid":
+        return "face", ""
+    return "curved", ""
+
+
+def edge_role(edge, step, axis, leaf_shape):
+    kind = type(edge.Curve).__name__
+    if kind == "Line":
+        d = App.Vector(edge.Curve.Direction)
+        if axis is not None and abs(d.dot(axis)) > 0.999 and abs(axis.dot(UP)) <= 0.9:
+            return "along edge", ""
+        if abs(d.z) > 0.999:
+            return "vertical edge", ""
+        if abs(d.z) < 1e-3:
+            # On the top or the bottom: by the flat faces around it
+            ups = []
+            if leaf_shape is not None:
+                try:
+                    for f in leaf_shape.ancestorsOfType(edge, Part.Face):
+                        if type(f.Surface).__name__ == "Plane":
+                            p, n = _face_sample(f)
+                            ups.append(n.z)
+                except Exception:
+                    pass
+            if any(z > 0.99 for z in ups):
+                return "top edge", ""
+            if any(z < -0.99 for z in ups):
+                return "bottom edge", ""
+            return "horizontal edge", ""
+        return "slanted edge", ""
+    if kind == "Circle":
+        r = edge.Curve.Radius
+        if edge.isClosed():
+            return "rim", "⌀" + num(2 * r)
+        return "arc edge", "R" + num(r)
+    return "curved edge", ""
+
+
+def _hole_name(step):
+    if step.isDerivedFrom("PartDesign::Hole"):
+        try:
+            return _name(step, "⌀" + num(step.Diameter.Value))
+        except Exception:
+            pass
+    return None
+
+
+def phrase(role, name):
+    text = translate(CONTEXT, PHRASES[role]).replace("{name}", name)
+    # 「穴 ⌀6 の内側の面」: a space after a number before the Japanese particle
+    if name and name[-1].isascii() and name[-1].isalnum():
+        text = text.replace(name + "の", name + " の", 1)
+    return text
+
+
+def words(obj, sub=""):
+    """(role, name) of the pick: ("top", "押し出し"), ("inner", "穴 ⌀6"); role None for a whole object"""
+    leaf, element = resolve(obj, sub)
+    if not element:
+        return None, leaf.Label
+    kind = element.rstrip("0123456789")
+    try:
+        leaf_shape = Part.getShape(leaf)
+        shape = leaf_shape.getElement(element)
+    except Exception:
+        leaf_shape = shape = None
+    if kind not in ("Face", "Edge", "Vertex") or shape is None or shape.isNull():
+        return None, leaf.Label
+    step = producer(leaf, element, shape)
+    origin = _origin_step(step)
+    axis = _extrude_axis(origin)
+    hole = _hole_name(origin)
+    if kind == "Face":
+        role, size = face_role(shape, origin, axis)
+        if hole and role in ("inner", "floor", "cone"):
+            return role, hole
+        return role, _name(origin, size)
+    if kind == "Edge":
+        role, size = edge_role(shape, origin, axis, leaf_shape)
+        if hole and role == "rim":
+            return role, hole
+        return role, _name(origin, size)
+    return "corner", _name(origin)
+
+
+def describe(obj, sub=""):
+    """The pick in words: 「押し出しの上面」"""
+    role, name = words(obj, sub)
+    return name if role is None else phrase(role, name)
+
+
+def describe_picks(picks, most=3):
+    """Several picks: the same words counted, 「押し出しの縦の辺 ×4」; picks = [(obj, sub), ...]"""
+    counts = OrderedDict()
+    for obj, sub in picks:
+        try:
+            text = describe(obj, sub)
+        except Exception:
+            text = obj.Label + (".{}".format(sub) if sub else "")
+        counts[text] = counts.get(text, 0) + 1
+    parts = ["{} ×{}".format(t, n) if n > 1 else t for t, n in counts.items()]
+    if len(parts) > most:
+        rest = sum(list(counts.values())[most - 1 :])
+        head = translate(CONTEXT, "{first}, … and {n} more").replace("{first}", "、".join(parts[: most - 1]))
+        return head.replace("{n}", str(rest))
+    return "、".join(parts)
+
+
+def selection_picks(selection):
+    """[(object, sub-element)] of Gui.Selection.getSelectionEx() (whole objects as (object, ""))"""
+    out = []
+    for s in selection:
+        subs = s.SubElementNames or ("",)
+        for sub in subs:
+            out.append((s.Object, sub))
+    return out
+
+
+# -- for the status bar while the cursor moves over the model: the same pick is asked again and
+# again; the answer is kept until the shape changes
+
+_cache = OrderedDict()
+
+
+def preselection_text(doc_name, obj_name, sub):
+    """The words for the element under the cursor ("" when there are none)"""
+    try:
+        obj = App.getDocument(doc_name).getObject(obj_name)
+    except Exception:
+        return ""
+    if obj is None or not sub:
+        return ""
+    leaf, element = resolve(obj, sub)
+    if not element:
+        return ""
+    try:
+        stamp = Part.getShape(leaf).hashCode()
+    except Exception:
+        return ""
+    key = (doc_name, obj_name, sub, stamp)
+    text = _cache.get(key)
+    if text is None:
+        try:
+            text = describe(obj, sub)
+        except Exception:
+            text = ""
+        _cache[key] = text
+        while len(_cache) > 500:
+            _cache.popitem(last=False)
+    return text
