+namespace
+{
+// The item's object as "Document#Object" (the integrated environment's Python helpers)
+constexpr int ObjectNameRole = Qt::UserRole + 1100;
+
+// A step of a part (PartDesign body) after the step where the part currently ends ("in effect
+// up to here", the body's Tip): it has no effect on the part's shape
+bool afterTheLine(App::DocumentObject* obj)
+{
+    if (!obj || !obj->isAttachedToDocument()) {
+        return false;
+    }
+    App::DocumentObject* group = App::GeoFeatureGroupExtension::getGroupOfObject(obj);
+    if (!group) {
+        return false;
+    }
+    auto tip = dynamic_cast<App::PropertyLink*>(group->getPropertyByName("Tip"));
+    auto members = dynamic_cast<App::PropertyLinkList*>(group->getPropertyByName("Group"));
+    if (!tip || !members) {
+        return false;
+    }
+    const auto& list = members->getValues();
+    auto at = std::find(list.begin(), list.end(), obj);
+    if (at == list.end()) {
+        return false;
+    }
+    if (!tip->getValue()) {
+        return true;  // the line is above the first step
+    }
+    auto tipAt = std::find(list.begin(), list.end(), tip->getValue());
+    return tipAt != list.end() && at > tipAt;
+}
+}  // namespace
+
