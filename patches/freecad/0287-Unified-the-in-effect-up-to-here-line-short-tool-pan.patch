diff --git a/src/Mod/Unified/HistoryLine.py b/src/Mod/Unified/HistoryLine.py
new file mode 100644
index 000000000..51d296d2a
--- /dev/null
+++ b/src/Mod/Unified/HistoryLine.py
@@ -0,0 +1,127 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""「ここまで有効」の線: 部品（PartDesign のボディ）の作った順のどこまでを形に効かせるか。
+
+画面では作った順（モデルの木）の青い線。線を上へ動かすとそれより後の手順は形に効かなくなり（灰色・未反映）、
+その位置で足した手順は線の所に入る。線を一番下へ戻すと全部が効く。中身は本家のボディの Tip（先端）で、
+画面には「先端」という言葉を出さない。
+
+App 側だけで動く（FreeCADCmd でも試験できる）。線を動かすのは 1 回の「元に戻す」で戻る。
+"""
+
+import FreeCAD as App
+
+translate = App.Qt.translate
+
+
+def QT_TRANSLATE_NOOP(context, text):
+    return text
+
+
+UNDO_NAME = QT_TRANSLATE_NOOP("Unified", "Move the “in effect up to here” line")
+
+
+def is_body(obj):
+    return obj is not None and obj.isDerivedFrom("PartDesign::Body")
+
+
+def body_of(obj):
+    """The part (body) the object is a step of, or None"""
+    if obj is None:
+        return None
+    if is_body(obj):
+        return obj
+    for parent in obj.InList:
+        if is_body(parent) and obj in parent.Group:
+            return parent
+    return None
+
+
+def steps(body):
+    """The steps of the part that make its shape, in the order they were made (the places the
+    line can be put after)"""
+    return [o for o in body.Group if o.isDerivedFrom("PartDesign::Feature")]
+
+
+def position(body):
+    """Where the line is: the number of steps above it (0 = above the first step)"""
+    tip = body.Tip
+    if tip is None:
+        return 0
+    s = steps(body)
+    return s.index(tip) + 1 if tip in s else len(s)
+
+
+def at_end(body):
+    return position(body) == len(steps(body))
+
+
+def after_line(obj):
+    """The object is below the line of its part: it has no effect on the shape (shown greyed)"""
+    body = body_of(obj)
+    if body is None or obj is body:
+        return False
+    group = body.Group
+    if obj not in group:
+        return False
+    tip = body.Tip
+    if tip is None:
+        return True
+    return tip in group and group.index(obj) > group.index(tip)
+
+
+def not_in_effect(body):
+    """The steps below the line"""
+    return [o for o in body.Group if after_line(o)]
+
+
+def _show_only(body, tip, old):
+    """Like the part's own command: the step where the part ends is the one shown"""
+    if not App.GuiUp:
+        return
+    if old is not None and old is not tip and old.ViewObject is not None:
+        old.ViewObject.Visibility = False
+    if tip is not None and tip.ViewObject is not None:
+        tip.ViewObject.Visibility = True
+        if body.ViewObject is not None:
+            body.ViewObject.Visibility = True
+
+
+def move_line(body, places):
+    """Put the line after the first `places` steps (0: above all; len(steps): at the end, all in
+    effect). One undo step. Returns True if the line moved."""
+    s = steps(body)
+    places = max(0, min(int(places), len(s)))
+    if places == position(body):
+        return False
+    tip = s[places - 1] if places > 0 else None
+    doc = body.Document
+    old = body.Tip
+    doc.openTransaction(translate("Unified", UNDO_NAME))
+    try:
+        body.Tip = tip
+        _show_only(body, tip, old)
+        doc.recompute()
+    except Exception:
+        doc.abortTransaction()
+        raise
+    doc.commitTransaction()
+    return True
+
+
+def to_end(body):
+    """The line back at the end: every step in effect"""
+    return move_line(body, len(steps(body)))
+
+
+def insert_after(step):
+    """Right-click 「ここに差し込む」: the line right after this step, so the next new step goes there"""
+    body = body_of(step)
+    if body is None:
+        return False
+    s = steps(body)
+    if step not in s:
+        # A sketch or a datum: the line after the last step made before it
+        group = body.Group
+        before = [o for o in group[: group.index(step)] if o in s]
+        return move_line(body, len(before))
+    return move_line(body, s.index(step) + 1)
diff --git a/src/Mod/Unified/HistoryLineGui.py b/src/Mod/Unified/HistoryLineGui.py
new file mode 100644
index 000000000..7ec09aefd
--- /dev/null
+++ b/src/Mod/Unified/HistoryLineGui.py
@@ -0,0 +1,411 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""The "in effect up to here" line in the history (the model tree) — docs/ui-redesign/00-design.md 6.1, 7.2.
+
+Under the step where a part currently ends there is a blue line. Drag it up to any earlier step:
+the steps below it stop having an effect (greyed in the tree, see Gui/Tree.cpp), and a new step is
+put in at the line. Drag it back to the bottom (or double-click it) and every step is in effect
+again. Each move is one undo step. The word for the body's "Tip" is never shown.
+
+Right-click a step → 「ここに差し込む」 puts the line right after it (also on a sketch).
+"""
+
+import FreeCAD as App
+import FreeCADGui as Gui
+from PySide import QtCore, QtGui, QtWidgets
+
+import HistoryLine as HL
+
+translate = App.Qt.translate
+
+# Gui/Tree.cpp: the role of an item that names its object, "Document#Object"
+OBJECT_ROLE = QtCore.Qt.UserRole + 1100
+LINE_COLOR = QtGui.QColor(47, 111, 208)
+
+
+def QT_TRANSLATE_NOOP(context, text):
+    return text
+
+
+# Rows are reached through the model's indexes, never through QTreeWidgetItem wrappers: the tree
+# makes and deletes its items itself and a kept wrapper may outlive its item
+
+
+def object_of(index):
+    """The document object a row of the tree shows, or None"""
+    name = index.data(OBJECT_ROLE) if index.isValid() else None
+    if not name or "#" not in name:
+        return None
+    doc_name, obj_name = name.split("#", 1)
+    try:
+        doc = App.getDocument(doc_name)
+    except Exception:
+        return None
+    return doc.getObject(obj_name)
+
+
+def trees():
+    mw = Gui.getMainWindow()
+    return [t for t in mw.findChildren(QtWidgets.QTreeWidget) if t.metaObject().className() == "Gui::TreeWidget"]
+
+
+def children(tree, index):
+    """The rows shown under a row"""
+    model = tree.model()
+    return [
+        model.index(r, 0, index)
+        for r in range(model.rowCount(index))
+        if not tree.isRowHidden(r, index)
+    ]
+
+
+def last_shown(tree, index):
+    """The last row shown of a row and what is open under it"""
+    while tree.isExpanded(index):
+        rows = children(tree, index)
+        if not rows:
+            break
+        index = rows[-1]
+    return index
+
+
+def body_items(tree, closed=False):
+    """(row, body) of the parts shown open in the tree (and the closed ones too, if asked)"""
+    out = []
+    model = tree.model()
+
+    def walk(index, top):
+        obj = object_of(index)
+        if obj is not None and HL.is_body(obj):
+            if closed or tree.isExpanded(index):
+                out.append((QtCore.QPersistentModelIndex(index), obj))
+            return
+        if top or tree.isExpanded(index):
+            for r in range(model.rowCount(index)):
+                walk(model.index(r, 0, index), False)
+
+    for r in range(model.rowCount()):
+        walk(model.index(r, 0), True)
+    return out
+
+
+def _index(row):
+    return QtCore.QModelIndex(row) if isinstance(row, QtCore.QPersistentModelIndex) else row
+
+
+def slots(tree, body_row, body):
+    """The places of the line: [(y in the viewport, number of steps above)], top to bottom"""
+    body_index = _index(body_row)
+    steps = HL.steps(body)
+    rows = {}
+    first_member = None
+    group = body.Group
+    for child in children(tree, body_index):
+        obj = object_of(child)
+        if obj is None:
+            continue
+        rows[obj.Name] = child
+        if first_member is None and obj in group:
+            first_member = child
+    out = []
+    if first_member is not None:
+        out.append((tree.visualRect(first_member).top(), 0))
+    else:
+        out.append((tree.visualRect(last_shown(tree, body_index)).bottom() + 1, 0))
+    for k, step in enumerate(steps, 1):
+        index = rows.get(step.Name)
+        if index is None:
+            continue  # shown under another step: no place of its own
+        out.append((tree.visualRect(last_shown(tree, index)).bottom() + 1, k))
+    return out
+
+
+class Line(QtWidgets.QWidget):
+    """The line of one part, over the tree's viewport. Dragged to a place between steps."""
+
+    HEIGHT = 11
+
+    def __init__(self, manager, tree, body):
+        super().__init__(tree.viewport())
+        self.setObjectName("UnifiedHistoryLine")
+        self.manager = manager
+        self.tree = tree
+        self.doc_name = body.Document.Name
+        self.body_name = body.Name
+        self.dragging = False
+        self.drag_places = None
+        self.setCursor(QtCore.Qt.SizeVerCursor)
+        self.setMouseTracking(True)
+        self.setToolTip(
+            translate(
+                "Unified",
+                "In effect up to here. Drag the line up to add a step in between, "
+                "back to the bottom (or double-click it) to bring all steps back.",
+            )
+        )
+
+    def body(self):
+        try:
+            return App.getDocument(self.doc_name).getObject(self.body_name)
+        except Exception:
+            return None
+
+    def place_at(self, y, left):
+        vw = self.tree.viewport().width()
+        self.setGeometry(left, y - self.HEIGHT // 2, max(40, vw - left - 2), self.HEIGHT)
+
+    def paintEvent(self, _event):
+        p = QtGui.QPainter(self)
+        p.setRenderHint(QtGui.QPainter.Antialiasing)
+        mid = self.height() // 2
+        pen = QtGui.QPen(LINE_COLOR, 2.5 if self.dragging else 2)
+        p.setPen(pen)
+        p.drawLine(9, mid, self.width() - 2, mid)
+        p.setBrush(LINE_COLOR)
+        p.setPen(QtCore.Qt.NoPen)
+        p.drawEllipse(QtCore.QPointF(5, mid), 4.5, 4.5)
+        p.end()
+
+    def mousePressEvent(self, event):
+        if event.button() != QtCore.Qt.LeftButton:
+            return super().mousePressEvent(event)
+        self.dragging = True
+        self.drag_places = None
+        self.grabKeyboard()
+        self.update()
+        event.accept()
+
+    def mouseMoveEvent(self, event):
+        if not self.dragging:
+            return super().mouseMoveEvent(event)
+        body = self.body()
+        if body is None:
+            return
+        body_item = self.manager.item_of(self.tree, body)
+        if body_item is None:
+            return
+        y = self.mapTo(self.tree.viewport(), event.position().toPoint() if hasattr(event, "position") else event.pos()).y()
+        places = slots(self.tree, body_item, body)
+        if not places:
+            return
+        best = min(places, key=lambda s: abs(s[0] - y))
+        self.drag_places = best[1]
+        self.place_at(best[0], self.x())
+        steps = HL.steps(body)
+        n = best[1]
+        if n >= len(steps):
+            text = translate("Unified", "All steps in effect")
+        elif n == 0:
+            text = translate("Unified", "Before the first step")
+        else:
+            text = translate("Unified", "In effect up to “{}”").format(steps[n - 1].Label)
+        Gui.getMainWindow().statusBar().showMessage(text, 3000)
+        event.accept()
+
+    def mouseReleaseEvent(self, event):
+        if not self.dragging or event.button() != QtCore.Qt.LeftButton:
+            return super().mouseReleaseEvent(event)
+        self.dragging = False
+        self.releaseKeyboard()
+        places = self.drag_places
+        self.drag_places = None
+        self.update()
+        body = self.body()
+        if body is not None and places is not None:
+            self.manager.move(body, places)
+        self.manager.layout_lines()
+        event.accept()
+
+    def keyPressEvent(self, event):
+        if self.dragging and event.key() == QtCore.Qt.Key_Escape:
+            self.dragging = False
+            self.drag_places = None
+            self.releaseKeyboard()
+            self.manager.layout_lines()
+            event.accept()
+            return
+        super().keyPressEvent(event)
+
+    def mouseDoubleClickEvent(self, event):
+        body = self.body()
+        if body is not None:
+            self.manager.move(body, len(HL.steps(body)))
+        event.accept()
+
+
+class Manager(QtCore.QObject):
+    """Keeps a line under the last step in effect of every part open in the tree"""
+
+    def __init__(self):
+        super().__init__(Gui.getMainWindow())
+        self.lines = {}  # (id(tree), doc, body) -> Line
+        self.watched = set()
+        self.opened = set()
+        self.timer = QtCore.QTimer(self)
+        self.timer.setInterval(250)
+        self.timer.timeout.connect(self.layout_lines)
+        self.timer.start()
+
+    def item_of(self, tree, body):
+        for item, b in body_items(tree):
+            if b == body:
+                return item
+        return None
+
+    def watch(self, tree):
+        if id(tree) in self.watched:
+            return
+        self.watched.add(id(tree))
+        tree.verticalScrollBar().valueChanged.connect(lambda _v: self.layout_lines())
+        tree.expanded.connect(lambda _i: QtCore.QTimer.singleShot(0, self.layout_lines))
+        tree.collapsed.connect(lambda _i: QtCore.QTimer.singleShot(0, self.layout_lines))
+
+    def move(self, body, places):
+        try:
+            moved = HL.move_line(body, places)
+        except Exception as e:
+            App.Console.PrintError("Unified: {}\n".format(e))
+            return
+        if moved:
+            for tree in trees():
+                tree.viewport().update()
+            steps = HL.steps(body)
+            if HL.at_end(body):
+                text = translate("Unified", "All steps in effect")
+            else:
+                n = HL.position(body)
+                text = (
+                    translate("Unified", "In effect up to “{}”. New steps go in here.").format(steps[n - 1].Label)
+                    if n
+                    else translate("Unified", "Before the first step. New steps go in here.")
+                )
+            Gui.getMainWindow().statusBar().showMessage(text, 5000)
+        self.layout_lines()
+
+    def layout_lines(self):
+        seen = set()
+        try:
+            for tree in trees():
+                if not tree.isVisible():
+                    continue
+                self.watch(tree)
+                for item, body in body_items(tree, closed=True):
+                    if not HL.steps(body):
+                        continue
+                    if not tree.isExpanded(_index(item)):
+                        # Open a part once, when it gets its first step, so that its line is in
+                        # sight; closed again by the user, it stays closed
+                        once = (body.Document.Uid, body.Name)
+                        if once in self.opened:
+                            continue
+                        self.opened.add(once)
+                        tree.expand(_index(item))
+                    key = (id(tree), body.Document.Name, body.Name)
+                    seen.add(key)
+                    line = self.lines.get(key)
+                    if line is None:
+                        line = self.lines[key] = Line(self, tree, body)
+                    if line.dragging:
+                        continue
+                    place = dict((n, y) for y, n in slots(tree, item, body)).get(HL.position(body))
+                    if place is None:
+                        line.hide()
+                        continue
+                    rows = children(tree, _index(item))
+                    left = max(0, tree.visualRect(rows[0] if rows else _index(item)).left() - 2)
+                    line.place_at(place, left)
+                    line.show()
+                    line.raise_()
+        except Exception as e:  # never let the timer spam: report once
+            App.Console.PrintLog("History line: {}\n".format(e))
+        for key in list(self.lines):
+            if key not in seen:
+                line = self.lines.pop(key)
+                if not line.dragging:
+                    line.hide()
+                    line.deleteLater()
+                else:
+                    self.lines[key] = line
+
+
+_manager = None
+
+
+def manager():
+    return _manager
+
+
+def install():
+    global _manager
+    if _manager is None:
+        _manager = Manager()
+    return _manager
+
+
+# -- right-click: put the line here / back to the end
+
+
+def _picked_step():
+    sel = Gui.Selection.getSelection()
+    if len(sel) != 1:
+        return None
+    body = HL.body_of(sel[0])
+    if body is None or sel[0] is body:
+        return None
+    return sel[0]
+
+
+class InsertHereCommand:
+    def GetResources(self):
+        return {
+            "Pixmap": "PartDesign_MoveTip",
+            "MenuText": QT_TRANSLATE_NOOP("Unified_InsertHere", "Insert Here"),
+            "ToolTip": QT_TRANSLATE_NOOP(
+                "Unified_InsertHere",
+                "Move the blue line right after this step: the next step you make goes here, "
+                "the steps below wait (greyed) until the line goes back down",
+            ),
+        }
+
+    def IsActive(self):
+        return _picked_step() is not None
+
+    def Activated(self):
+        step = _picked_step()
+        if step is None:
+            return
+        body = HL.body_of(step)
+        if HL.insert_after(step) and _manager is not None:
+            _manager.move(body, HL.position(body))  # the message and the line
+
+
+class LineToEndCommand:
+    def GetResources(self):
+        return {
+            "Pixmap": "PartDesign_MoveTip",
+            "MenuText": QT_TRANSLATE_NOOP("Unified_LineToEnd", "Bring All Steps Back"),
+            "ToolTip": QT_TRANSLATE_NOOP(
+                "Unified_LineToEnd", "Move the blue line back to the bottom: every step is in effect again"
+            ),
+        }
+
+    def body(self):
+        sel = Gui.Selection.getSelection()
+        if len(sel) != 1:
+            return None
+        body = HL.body_of(sel[0])
+        return body if body is not None and not HL.at_end(body) else None
+
+    def IsActive(self):
+        return self.body() is not None
+
+    def Activated(self):
+        body = self.body()
+        if body is not None:
+            if _manager is not None:
+                _manager.move(body, len(HL.steps(body)))
+            else:
+                HL.to_end(body)
+
+
+Gui.addCommand("Unified_InsertHere", InsertHereCommand())
+Gui.addCommand("Unified_LineToEnd", LineToEndCommand())
