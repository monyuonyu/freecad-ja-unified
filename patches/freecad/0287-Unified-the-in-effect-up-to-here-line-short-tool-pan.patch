@@ -0,0 +1,91 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""What is picked, in words, where the user looks: the status bar after each pick and the title
+of the bar of tools next to the picks (MeasureBarGui.decorate). The words: SelectionWords.py.
+The element under the cursor is said in words by Gui/Selection/Selection.cpp."""
+
+import FreeCAD as App
+import FreeCADGui as Gui
+from PySide import QtCore, QtWidgets
+
+import SelectionWords as W
+
+translate = App.Qt.translate
+
+
+def editing():
+    try:
+        return Gui.ActiveDocument is not None and Gui.ActiveDocument.getInEdit() is not None
+    except Exception:
+        return False
+
+
+def current_text():
+    """The words for what is picked now ("" for nothing)"""
+    try:
+        picks = W.selection_picks(Gui.Selection.getSelectionEx("", 0))
+    except Exception:
+        return ""
+    if not picks:
+        return ""
+    return W.describe_picks(picks)
+
+
+class Observer:
+    def __init__(self):
+        self.pending = False
+
+    def _later(self, *_args):
+        if not self.pending:
+            self.pending = True
+            QtCore.QTimer.singleShot(0, self.show)
+
+    addSelection = removeSelection = setSelection = _later
+
+    def clearSelection(self, *_args):
+        pass
+
+    def show(self):
+        self.pending = False
+        if editing():
+            return  # a sketch or a tool has its own words
+        text = current_text()
+        if text:
+            show_in_status(translate("Unified", "Picked: {}").format(text))
+
+
+def show_in_status(text):
+    """In the status bar's own place for what is under the cursor and picked (the one the
+    element under the cursor is said in), not over it"""
+    try:
+        sb = Gui.getMainWindow().statusBar()
+        label = sb.findChild(QtWidgets.QLabel, "actionLabel")
+        if label is not None:
+            label.setText(text)
+        else:
+            sb.showMessage(text, 8000)
+    except Exception:
+        pass
+
+
+_observer = None
+
+
+def install():
+    global _observer
+    if _observer is None:
+        _observer = Observer()
+        Gui.Selection.addObserver(_observer)
+    return _observer
+
+
+def title_label(parent):
+    """The title of the bar next to the picks"""
+    text = current_text()
+    if not text:
+        return None
+    label = QtWidgets.QLabel(text, parent)
+    label.setObjectName("UnifiedPickWords")
+    label.setStyleSheet("QLabel { font-weight: bold; padding: 0 6px; }")
+    label.setMaximumWidth(360)
+    label.setWordWrap(True)
+    return label
