+    code = {"Japanese": "ja"}.get(lang) or (os.environ.get("LANG", "")[:2] if not lang else "")
+    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "translations", "Unified_%s.qm" % code)
+    if code and os.path.exists(path):
+        try:
+            from PySide6 import QtCore
+        except ImportError:
+            try:
+                from PySide2 import QtCore
+            except ImportError:
+                QtCore = None
+        if QtCore is not None:
+            t = QtCore.QTranslator()
+            if not t.load(path):
+                t = None
+    _translator.append(t)
+    return t
+
+
 
 ERROR, WARNING, INFO = "error", "warning", "info"
 
diff --git a/src/Mod/Unified/Gui/CMakeLists.txt b/src/Mod/Unified/Gui/CMakeLists.txt
index 01f423bf4..f9c7ab111 100644
--- a/src/Mod/Unified/Gui/CMakeLists.txt
+++ b/src/Mod/Unified/Gui/CMakeLists.txt
@@ -13,6 +13,16 @@ qt_find_and_add_translation(QM_SRCS "Resources/translations/*_*.ts"
 qt_create_resource_file(${Unified_TR_QRC} ${QM_SRCS})
 qt_add_resources(UnifiedGui_QRC_SRCS ${Unified_TR_QRC} OPTIONS ${FREECAD_RCC_OPTIONS})
 
+# The design check also runs without the GUI (FreeCADCmd, fcad drc), where the translations in
+# the resources are not loaded: it reads Unified_<lang>.qm from Mod/Unified/translations
+set(Unified_CLI_QM)
+foreach(qm ${QM_SRCS})
+    get_filename_component(qmname ${qm} NAME)
+    if(qmname MATCHES "^Unified_")
+        list(APPEND Unified_CLI_QM ${qm})
+    endif()
+endforeach()
+
 SET(UnifiedGui_SRCS
     ${UnifiedGui_QRC_SRCS}
     AppUnifiedGui.cpp
@@ -45,3 +55,9 @@ SET_BIN_DIR(UnifiedGui)
 SET_PYTHON_PREFIX_SUFFIX(UnifiedGui)
 
 INSTALL(TARGETS UnifiedGui DESTINATION ${CMAKE_INSTALL_LIBDIR})
+
+add_custom_command(TARGET UnifiedGui POST_BUILD
+    COMMAND ${CMAKE_COMMAND} -E make_directory ${CMAKE_BINARY_DIR}/Mod/Unified/translations
+    COMMAND ${CMAKE_COMMAND} -E copy ${Unified_CLI_QM} ${CMAKE_BINARY_DIR}/Mod/Unified/translations
+)
+install(FILES ${Unified_CLI_QM} DESTINATION Mod/Unified/translations)
