From e654dce2eacc8982981885aeb97392fc6efa09c2 Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Sun, 27 Sep 2026 13:43:38 +0900
Subject: [PATCH 099/100] Unified: the design check reads its translations from
 the .qm without the GUI

Without the GUI the Qt translations are not loaded, so DesignCheck kept a
hand-made copy of its Japanese texts that drifted from the .ts. The build
now puts Unified_<lang>.qm into Mod/Unified/translations, and the check
reads it with a QTranslator when there is no GUI.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/Mod/Unified/DesignCheck.py     | 110 +++++++++--------------------
 src/Mod/Unified/Gui/CMakeLists.txt |  16 +++++
 2 files changed, 48 insertions(+), 78 deletions(-)

diff --git a/src/Mod/Unified/DesignCheck.py b/src/Mod/Unified/DesignCheck.py
index ec13bdb0d..19e075b63 100644
--- a/src/Mod/Unified/DesignCheck.py
+++ b/src/Mod/Unified/DesignCheck.py
@@ -12,90 +12,44 @@ QT_TRANSLATE_NOOP = App.Qt.QT_TRANSLATE_NOOP
 
 
 def translate(context, text):
-    """GUI では Qt の訳。GUI の無い FreeCADCmd では訳が読み込まれないので、日本語の環境なら _JA を使う"""
+    """GUI では Qt の訳。GUI の無い FreeCADCmd では Qt の訳が読み込まれないので、
+    Mod/Unified/translations の .qm（ビルドで作られる）を直接読む"""
     r = App.Qt.translate(context, text)
-    if r == text and context == "DesignCheck" and not App.GuiUp and _japanese():
-        return _JA.get(text, text)
+    if r == text and not App.GuiUp:
+        t = _cli_translator()
+        if t is not None:
+            return t.translate(context, text) or text
     return r
 
 
-def _japanese():
+_translator = []
+
+
+def _cli_translator():
+    """利用者の言語の Unified_<言語>.qm。無ければ None（英語のまま）"""
+    if _translator:
+        return _translator[0]
     import os
+    t = None
     lang = App.ParamGet("User parameter:BaseApp/Preferences/General").GetString("Language", "")
-    return lang == "Japanese" or (not lang and os.environ.get("LANG", "").startswith("ja"))
-
-
