From: shota <monyuonyu@gmail.com>
Date: Wed, 21 Oct 2026 10:31:29 +0900
Subject: [PATCH 285/399] =?UTF-8?q?Unified:=20a=20kept=20dimension=20is=20?=
 =?UTF-8?q?named=20in=20Japanese=20("=E8=B7=9D=E9=9B=A2:=2080=20mm")?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The Measure objects keep what is before the colon of their label when they update: name
them "Distance: …" / "Gap: …" / "Diameter: …" (translated), not "Measure: …".

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../Gui/Resources/translations/UnifiedWording_ja.ts       | 8 ++++++++
 src/Mod/Unified/MeasureMath.py                            | 6 +++++-
 src/Mod/Unified/TestMeasureMath.py                        | 2 ++
 3 files changed, 15 insertions(+), 1 deletion(-)

diff --git a/src/Mod/Unified/Gui/Resources/translations/UnifiedWording_ja.ts b/src/Mod/Unified/Gui/Resources/translations/UnifiedWording_ja.ts
index cf713825e..8a5cc6ec5 100644
--- a/src/Mod/Unified/Gui/Resources/translations/UnifiedWording_ja.ts
+++ b/src/Mod/Unified/Gui/Resources/translations/UnifiedWording_ja.ts
@@ -11047,6 +11047,14 @@ Note: Currently this selects only unconnected parts, not constrained parts that
         <source>Radius</source>
         <translation>半径</translation>
     </message>
+    <message>
+        <source>Diameter</source>
+        <translation>直径</translation>
+    </message>
+    <message>
+        <source>Radius</source>
+        <translation>半径</translation>
+    </message>
     <message>
         <source>Center distance</source>
         <translation>中心間</translation>
diff --git a/src/Mod/Unified/MeasureMath.py b/src/Mod/Unified/MeasureMath.py
index 2ba8270e7..87577ad7b 100644
--- a/src/Mod/Unified/MeasureMath.py
+++ b/src/Mod/Unified/MeasureMath.py
@@ -39,6 +39,8 @@ NAMES = {
     "radius": T("R"),
     "centers": T("Center distance"),
 }
+# The name of a kept dimension where the bar shows only a sign
+LABEL_NAMES = {"diameter": T("Diameter"), "radius": T("Radius")}
 UNITS = {"length": "mm", "angle": "°", "area": "mm²"}
 
 
@@ -396,8 +398,10 @@ def keep(result, picks, doc=None):
             obj.Element = ref(k.picks[0])
         elif k.kind == "points":
             obj.Position1, obj.Position2 = k.points
+        # "Gap: 20 mm": the Measure objects keep what is before the colon when they update
         first = result.items[0]
-        obj.Label = "{} {}".format(App.Qt.translate("UnifiedMeasure", NAMES[first.key]), first.text())
+        name = LABEL_NAMES.get(first.key, NAMES[first.key])
+        obj.Label = "{}: {}".format(App.Qt.translate("UnifiedMeasure", name), first.text())
         group = doc.getObject("Measurements")
         if group is None or not group.isDerivedFrom("App::DocumentObjectGroup"):
             try:
diff --git a/src/Mod/Unified/TestMeasureMath.py b/src/Mod/Unified/TestMeasureMath.py
index 41558d242..c23dffd2c 100644
--- a/src/Mod/Unified/TestMeasureMath.py
+++ b/src/Mod/Unified/TestMeasureMath.py
@@ -243,6 +243,7 @@ class TestMeasureMath(unittest.TestCase):
         obj = M.keep(M.measure_picks(picks), picks)
         self.assertTrue(obj.isDerivedFrom("Measure::MeasureDistanceDetached"))
         self.assertAlmostEqual(obj.Distance.Value, 20)
+        self.assertEqual(obj.Label, "Gap: 20 mm")
         a = vertex_at(self.plate.Shape, V(0, 0, 0))
         b = vertex_at(self.plate.Shape, V(80, 50, 5))
         picks = [(self.plate, a), (self.plate, b)]
@@ -252,6 +253,7 @@ class TestMeasureMath(unittest.TestCase):
         hole = cylinder_faces(self.plate.Shape)[0]
         obj = M.keep(M.measure_picks([(self.plate, hole)]), [(self.plate, hole)])
         self.assertAlmostEqual(obj.Diameter.Value, 6)
+        self.assertEqual(obj.Label, "Diameter: 6 mm")
         self.assertIn(obj, doc.getObject("Measurements").Group)
         self.assertEqual(len(doc.Objects), before + 4)  # 3 measures + the group
 
