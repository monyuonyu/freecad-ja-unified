+                writer.setOptions();
+                if (versionOverride) {
+                    writer.setVersion(versionParm);
+                }
+                writer.setPolyOverride(polyOverride);
+                writer.setLayerName(layerName);
+                writer.init();
+                Part::TopoShape* obj = static_cast<Part::TopoShapePy*>(shapeObj)->getTopoShapePtr();
+                TopoDS_Shape shape = obj->getShape();
+                writer.exportShape(shape);
+                writer.endRun();
+                return Py::None();
+            }
+            catch (const Base::Exception& e) {
+                throw Py::RuntimeError(e.what());
+            }
+        }
+
+        throw Py::TypeError("expected ([Shape],path");
+    }
+
+    static bool exportDraftText(ImpExpDxfWrite& writer, App::DocumentObject* obj)
+    {
+        auto* text = dynamic_cast<App::PropertyStringList*>(obj->getPropertyByName("Text"));
+        auto* placement = dynamic_cast<App::PropertyPlacement*>(obj->getPropertyByName("Placement"));
+        if (!text || !placement || obj->isDerivedFrom<Part::Feature>()) {
+            return false;
+        }
+        // the size is the view's; without it, the height of texts in the Draft preferences
+        const double size = App::GetApplication()
+                                .GetParameterGroupByPath("User parameter:BaseApp/Preferences/Mod/Draft")
+                                ->GetFloat("textheight", 3.5);
+        const Base::Placement plc = placement->getValue();
+        writer.setLayerName(obj->getNameInDocument());
+        const auto lines = text->getValues();
+        for (std::size_t i = 0; i < lines.size(); ++i) {
+            if (lines[i].empty()) {
+                continue;
+            }
+            Base::Vector3d at = plc.getPosition()
+                + plc.getRotation().multVec(Base::Vector3d(0, -1.5 * size * double(i), 0));
+            writer.exportText(lines[i].c_str(), at, at, size, 0);
+        }
+        return true;
+    }
+
+    Py::Object writeDXFObject(const Py::Tuple& args)
+    {
+        PyObject* docObj = nullptr;
+        char* fname = nullptr;
+        std::string filePath;
+        std::string layerName;
+        const char* optionSource = nullptr;
+        std::string defaultOptions = "User parameter:BaseApp/Preferences/Mod/Draft";
+        int versionParm = -1;
+        bool versionOverride = false;
+        bool polyOverride = false;
+        PyObject* usePolyline = Py_False;
+
+        if (PyArg_ParseTuple(
+                args.ptr(),
+                "O!et|iOs",
+                &(PyList_Type),
+                &docObj,
+                "utf-8",
+                &fname,
+                &versionParm,
+                &usePolyline,
+                &optionSource
+            )) {
+            filePath = std::string(fname);
+            layerName = "none";
+            PyMem_Free(fname);
+
+            if ((versionParm == 12) || (versionParm == 14)) {
+                versionOverride = true;
+            }
+            if (usePolyline == Py_True) {
+                polyOverride = true;
+            }
+
+            if (optionSource) {
+                defaultOptions = optionSource;
+            }
+
+            try {
+                ImpExpDxfWrite writer(filePath);
+                writer.setOptionSource(defaultOptions);
+                writer.setOptions();
+                if (versionOverride) {
+                    writer.setVersion(versionParm);
+                }
+                writer.setPolyOverride(polyOverride);
+                writer.setLayerName(layerName);
+                writer.init();
+                Py::Sequence list(docObj);
+                for (Py::Sequence::iterator it = list.begin(); it != list.end(); ++it) {
+                    // any object with a shape: Part features, but also App::Link (the block
+                    // inserts of the DXF/DWG importer), which were silently left out
+                    if (PyObject_TypeCheck((*it).ptr(), &(App::DocumentObjectPy::Type))) {
+                        PyObject* item = (*it).ptr();
+                        App::DocumentObject* obj
+                            = static_cast<App::DocumentObjectPy*>(item)->getDocumentObjectPtr();
+                        // A Draft text: its lines as TEXT (they were left out, so a DWG written
+                        // from a drawing lost every text; company test 0.7.6)
+                        if (exportDraftText(writer, obj)) {
+                            continue;
+                        }
+                        TopoDS_Shape shapeToExport = shapeForDxf(obj);
+                        if (shapeToExport.IsNull()) {
+                            continue;
+                        }
+                        layerName = obj->getNameInDocument();
+                        writer.setLayerName(layerName);
+                        writer.exportShape(shapeToExport);
+                    }
+                }
+                writer.endRun();
+                return Py::None();
+            }
+            catch (const Base::Exception& e) {
+                throw Py::RuntimeError(e.what());
+            }
+        }
+
+        PyErr_Clear();
+        if (PyArg_ParseTuple(
+                args.ptr(),
+                "O!et|iOs",
+                &(App::DocumentObjectPy::Type),
+                &docObj,
+                "utf-8",
+                &fname,
+                &versionParm,
+                &usePolyline,
+                &optionSource
+            )) {
+            filePath = std::string(fname);
+            layerName = "none";
+            PyMem_Free(fname);
+            App::DocumentObject* obj
+                = static_cast<App::DocumentObjectPy*>(docObj)->getDocumentObjectPtr();
+            Base::Console().message("Imp:writeDXFObject - docObj: {}\n", obj->getNameInDocument());
+
+            if ((versionParm == 12) || (versionParm == 14)) {
+                versionOverride = true;
+            }
+            if (usePolyline == Py_True) {
+                polyOverride = true;
+            }
+
+            if (optionSource) {
+                defaultOptions = optionSource;
+            }
+
+            try {
+                ImpExpDxfWrite writer(filePath);
+                writer.setOptionSource(defaultOptions);
+                writer.setOptions();
+                if (versionOverride) {
+                    writer.setVersion(versionParm);
+                }
+                writer.setPolyOverride(polyOverride);
+                writer.setLayerName(layerName);
+                writer.init();
+                App::DocumentObject* obj
+                    = static_cast<App::DocumentObjectPy*>(docObj)->getDocumentObjectPtr();
+                layerName = obj->getNameInDocument();
+                writer.setLayerName(layerName);
+                // was a static_cast to Part::Feature of whatever object came in
+                TopoDS_Shape shapeToExport = shapeForDxf(obj);
+                if (!shapeToExport.IsNull()) {
+                    writer.exportShape(shapeToExport);
+                }
+                writer.endRun();
+                return Py::None();
+            }
+            catch (const Base::Exception& e) {
+                throw Py::RuntimeError(e.what());
+            }
+        }
+
+        throw Py::TypeError("expected ([DocObject],path");
+    }
+};
+
+
+PyObject* initModule()
+{
+    return Base::Interpreter().addModule(new Module);
+}
+
+}  // namespace Import
