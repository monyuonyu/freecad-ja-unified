+class TestDwgText(unittest.TestCase):
+    """A DWG written from a drawing keeps its texts, in R2018, and they are read back (company
+    test 0.7.6: R14, every text lost, none read)"""
+
+    def test_round_trip(self):
+        import os
+        import shutil
+        import tempfile
+
+        import Draft
+        import importDWG
+
+        if importDWG.get_libredwg_converter("dxf2dwg") is None:
+            self.skipTest("no LibreDWG converter here (the release builds bring one)")
+        tmp = tempfile.mkdtemp()
+        doc = App.newDocument("dwgtext")
+        back = None
+        try:
+            Draft.make_text(["日本語テスト φ60", "ASCII"], App.Placement(App.Vector(10, 10, 0), App.Rotation()))
+            Draft.make_line(App.Vector(0, 0, 0), App.Vector(100, 0, 0))
+            doc.recompute()
+            path = os.path.join(tmp, "t.dwg")
+            importDWG.export(doc.Objects, path)
+            with open(path, "rb") as f:
+                self.assertEqual(f.read(6), b"AC1032")
+            back = App.newDocument("dwgback")
+            importDWG.insert(path, back.Name)
+            texts = sorted(t for o in back.Objects for t in (getattr(o, "Text", None) or []))
+            self.assertEqual(texts, ["ASCII", "日本語テスト φ60"])
+        finally:
+            App.closeDocument(doc.Name)
+            if back is not None:
+                App.closeDocument(back.Name)
+            shutil.rmtree(tmp)
+
 if __name__ == "__main__":
     unittest.main()
