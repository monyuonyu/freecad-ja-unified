diff --git a/src/Mod/Draft/importDWG.py b/src/Mod/Draft/importDWG.py
index 8ceba7eaf..5c5ca1135 100644
--- a/src/Mod/Draft/importDWG.py
+++ b/src/Mod/Draft/importDWG.py
@@ -157,6 +157,13 @@ def get_libredwg_converter(typ):
     import os
     import platform
 
+    # The converter that comes with this FreeCAD first: a path kept in the settings of an older
+    # version pointed at that version's converter after an update (company test 0.7.6)
+    for name in (typ + ".exe", typ):
+        bundled = os.path.join(FreeCAD.getHomePath(), "bin", name)
+        if os.path.isfile(bundled):
+            return bundled
+
     path = params.get_param("TeighaFileConverter")
 
     if "dwg2dxf" in path or "dxf2dwg" in path:  # path set manually
@@ -384,7 +391,11 @@ def convertToDwg(dxffilename, dwgfilename):
     if conv in [0, 1]:  # LibreDWG
         libredwg = get_libredwg_converter("dxf2dwg")
         if libredwg is not None:
-            cmdline = [libredwg, dxffilename, "-y", "-o", dwgfilename]
+            # The version to write (dxf2dwg wrote the DXF's own, R14; company test 0.7.6)
+            version = FreeCAD.ParamGet("User parameter:BaseApp/Preferences/Mod/Draft").GetString(
+                "DWGExportVersion", "r2018"
+            )
+            cmdline = [libredwg, dxffilename, "-y", "--as", version, "-o", dwgfilename]
             FCC.PrintMessage(translate("draft", "Converting:") + " " + str(cmdline) + "\n")
             proc = subprocess.Popen(cmdline)
             proc.communicate()
