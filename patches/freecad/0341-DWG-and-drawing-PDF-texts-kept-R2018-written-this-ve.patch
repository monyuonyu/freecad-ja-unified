+// Shape written to DXF for one object: sketches flattened onto XY, Part features and links with
+// their placement. Null for anything else.
+TopoDS_Shape shapeForDxf(App::DocumentObject* obj)
+{
+    if (SketchExportHelper::isSketch(obj)) {
+        // project sketch along sketch Z via hlrProjector to get geometry on XY plane
+        return SketchExportHelper::getFlatSketchXY(obj);
+    }
+    // not groups and other containers: their children are in the list on their own
+    if (!obj->isDerivedFrom<Part::Feature>() && !obj->isDerivedFrom<App::Link>()) {
+        return {};
+    }
+    return Part::Feature::getShape(
+        obj,
+        Part::ShapeOption::ResolveLink | Part::ShapeOption::Transform
+    );
+}
