+    return False
 
 
 def _box_overlap(p, q, tol):
@@ -399,8 +449,27 @@ def _cylinders(shape):
 def _fitted(a, b, clearance=0.5):
     """One shape has a round face inside a round face (a hole) of the other, on the same axis, with at
     most `clearance` mm between them, and they overlap along the axis: a pin in a hole"""
+    a, b = _prepared(a), _prepared(b)
     if not a.BoundBox.intersect(b.BoundBox):
         return False
+    ca, cb = a.round_faces(), b.round_faces()
+    for i, j in _near_pairs([box for _, _, box in ca], [box for _, _, box in cb], clearance + 1e-6):
+        fa, sa, _ = ca[i]
+        fb, sb, _ = cb[j]
+        if abs(abs(sa.Axis.dot(sb.Axis)) - 1) > 1e-6:
+            continue
+        d = (sb.Center - sa.Center)
+        off = (d - sa.Axis * d.dot(sa.Axis)).Length
+        if off > 1e-3:
+            continue
+        gap = abs(sa.Radius - sb.Radius)
+        if 1e-9 < gap <= clearance or gap <= 1e-9:
+            # overlapping along the axis
+            ta = sorted(sa.Axis.dot(v.Point) for v in fa.Vertexes) or [0]
+            tb = sorted(sa.Axis.dot(v.Point) for v in fb.Vertexes) or [0]
+            if min(ta[-1], tb[-1]) - max(ta[0], tb[0]) > 1e-6:
+                return True
+    return False
     ca, cb = _cylinders(a), _cylinders(b)
     for fa, sa in ca:
         near = _grown(fa.BoundBox, clearance + 1e-6)
