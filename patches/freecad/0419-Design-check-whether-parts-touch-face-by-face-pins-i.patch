         return float("inf")
 
 
+class _Prepared:
+    """A shape's solids, faces and round faces with their boxes, made once for all its pairs: a
+    check of a cart (STEP casters, hundreds of screws) spent 98 s measuring whole solids and 33 s
+    comparing every round face with every other"""
+
+    def __init__(self, shape):
+        self.shape = shape
+        self.BoundBox = shape.BoundBox
+        self.solids = shape.Solids or [shape]
+        self.boxes = [x.BoundBox for x in self.solids]
+        self._faces = {}
+        self._round = None
+
+    def faces(self, i):
+        if i not in self._faces:
+            self._faces[i] = [(f, f.BoundBox) for f in self.solids[i].Faces]
+        return self._faces[i]
+
+    def round_faces(self):
+        if self._round is None:
+            self._round = [(f, s, f.BoundBox) for f, s in _cylinders(self.shape)]
+        return self._round
+
+
+def _prepared(s):
+    return s if isinstance(s, _Prepared) else _Prepared(s)
+
+
+def _near_pairs(boxes_a, boxes_b, d):
+    """The (i, j) whose boxes come within d of each other, sorted along x and swept (all pairs of
+    a few thousand faces each were millions of tests)"""
+    import bisect
+
+    if not boxes_a or not boxes_b:
+        return []
+    order = sorted(range(len(boxes_b)), key=lambda j: boxes_b[j].XMin)
+    xmins = [boxes_b[j].XMin for j in order]
+    longest = max(b.XLength for b in boxes_b)
+    out = []
+    for i, p in enumerate(boxes_a):
+        grown = _grown(p, d)
+        k = bisect.bisect_left(xmins, grown.XMin - longest)
+        while k < len(order) and xmins[k] <= grown.XMax:
+            j = order[k]
+            if grown.intersect(boxes_b[j]):
+                out.append((i, j))
+            k += 1
+    return out
+
+
