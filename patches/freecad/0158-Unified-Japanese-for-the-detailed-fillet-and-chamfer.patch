From 052b9f5ec302403c3bbdf64f9a7a14642b636d6a Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Sun, 27 Sep 2026 19:58:54 +0900
Subject: [PATCH 158/200] Unified: Japanese for the detailed fillet and chamfer
 failures

The fillet and chamfer failures now say why (OCC's diagnostics): translate
them, with patterns for the ones that name an edge contour or count edges
or vertices.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/Mod/Unified/Gui/ErrorMessages.cpp         | 15 ++++
 .../translations/UnifiedWording_ja.ts         | 80 +++++++++++++++++++
 2 files changed, 95 insertions(+)

diff --git a/src/Mod/Unified/Gui/ErrorMessages.cpp b/src/Mod/Unified/Gui/ErrorMessages.cpp
index 9c39e5059..8b08af816 100644
--- a/src/Mod/Unified/Gui/ErrorMessages.cpp
+++ b/src/Mod/Unified/Gui/ErrorMessages.cpp
@@ -39,6 +39,21 @@ const Pattern patterns[] = {
      QT_TRANSLATE_NOOP("UnifiedErrors", "Attachment placement cannot be calculated (%1)")},
     {R"(makeOffset2D:\s*(.*))",
      QT_TRANSLATE_NOOP("UnifiedErrors", "Offset failed (%1)")},
+    // Fillet failures with OCC's diagnostics: the number of the edge contour or of the edges
+    {R"(Fillet failed: could not trace the blending surface along edge contour (\d+)\..*)",
+     QT_TRANSLATE_NOOP("UnifiedErrors", "Fillet: cannot trace the blend along edge contour %1")},
+    {R"(Fillet failed to start on edge contour (\d+):.*)",
+     QT_TRANSLATE_NOOP("UnifiedErrors", "Fillet: cannot start on edge contour %1")},
+    {R"(Fillet failed on edge contour (\d+): the blending surface would be self-intersecting.*)",
+     QT_TRANSLATE_NOOP("UnifiedErrors", "Fillet: blend on edge contour %1 intersects itself")},
+    {R"(Fillet failed on edge contour (\d+): OCC internal geometry error.*)",
+     QT_TRANSLATE_NOOP("UnifiedErrors", "Fillet: kernel error on edge contour %1")},
+    {R"(Fillet failed on (\d+) edge contour\(s\)\..*)",
+     QT_TRANSLATE_NOOP("UnifiedErrors", "Fillet failed on %1 edge contours")},
+    {R"(Fillet failed at (\d+) vertex/vertices\..*)",
+     QT_TRANSLATE_NOOP("UnifiedErrors", "Fillet failed at %1 vertices")},
+    {R"(Fillet failed: (.*))",
+     QT_TRANSLATE_NOOP("UnifiedErrors", "Fillet failed (%1)")},
 };
 // clang-format on
 
