+def _page_xy(view):
+    """Where the view's centre is on the page (a view of a projection group is placed relative
+    to the group)"""
+    def mm(q):
+        return float(getattr(q, "Value", q))
+
+    x, y = mm(view.X), mm(view.Y)
+    for parent in view.InList:
+        if parent.isDerivedFrom("TechDraw::DrawProjGroup"):
+            x += mm(parent.X)
+            y += mm(parent.Y)
+    return x, y
+
+
+def _on_title_block(page, view, y):
+    """A text at height y (relative to the view) would be on the title block (bottom right of
+    an A4 or A3 sheet: up to 58 mm, right of 100 mm from the left)"""
+    vx, vy = _page_xy(view)
+    return vy + float(getattr(y, "Value", y)) < 58 and vx > 100
