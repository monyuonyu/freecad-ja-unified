+    def test_connecting_rod(self):
+        # Engine field test 0.7.3: round ends past the corners gave the centre distance twice and
+        # a width in the middle of the rod (23.64); the hole sizes' leaders crossed the part
+        import Part
+
+        doc = App.newDocument("DrawingAutoRod")
+        try:
+            V = App.Vector
+            rod = Part.makeCylinder(14, 15).fuse(Part.makeCylinder(8, 15, V(0, 100, 0)))
+            rod = rod.fuse(Part.makeBox(10, 100, 15, V(-5, 0, 0)))
+            rod = rod.cut(Part.makeCylinder(7, 15, V(0, 0, 0))).cut(Part.makeCylinder(4, 15, V(0, 100, 0)))
+            obj = doc.addObject("Part::Feature", "Rod")
+            obj.Shape = rod.removeSplitter()
+            page = doc.addObject("TechDraw::DrawPage", "Page")
+            tpl = doc.addObject("TechDraw::DrawSVGTemplate", "Template")
+            tpl.Template = App.getResourceDir() + "Mod/TechDraw/Templates/ISO/A4_Landscape_ISO5457_minimal.svg"
+            page.Template = tpl
+            g = doc.addObject("TechDraw::DrawProjGroup", "ProjGroup")
+            page.addView(g)
+            g.Source = [obj]
+            g.addProjection("Front")
+            g.Anchor.Direction = V(0, 0, 1)
+            g.Anchor.XDirection = V(1, 0, 0)
+            g.addProjection("Right")
+            g.ScaleType = "Custom"
+            g.Scale = 1
+            doc.recompute()
+            DrawingAuto.complete(page, g)
+            dims = [d for d in doc.Objects if d.isDerivedFrom("TechDraw::DrawViewDimension")]
+            values = sorted((d.Type, round(d.getRawValue(), 2)) for d in dims)
+            self.assertEqual(values.count(("DistanceY", 100.0)), 1, values)
+            self.assertFalse([v for v in values if v[0] == "DistanceX" and v[1] not in (15.0,)], values)
+            # each hole's size beside its own hole: the small eye's 100 mm above the big eye's
+            # (view coordinates; the label at the circle's top right)
+            y = {round(d.getRawValue()): d.Y.Value for d in dims if d.Type == "Diameter"}
+            self.assertAlmostEqual(y[8] - y[14], (100 + 4) - 7, places=3)
+        finally:
+            App.closeDocument(doc.Name)
+
     def test_rounded_corners_are_not_holes(self):
