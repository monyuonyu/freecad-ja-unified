+// Whether the part (PartDesign body) the object belongs to already has a solid to cut into
+bool partHasSolid(const App::DocumentObject* obj)
+{
+    const App::DocumentObject* body = isDerivedFrom(obj, "PartDesign::Body") ? obj : nullptr;
+    for (const App::DocumentObject* parent : obj->getInList()) {
+        if (!body && isDerivedFrom(parent, "PartDesign::Body")) {
+            body = parent;
+        }
+    }
+    auto* tip = body ? dynamic_cast<App::PropertyLink*>(body->getPropertyByName("Tip")) : nullptr;
+    return tip && tip->getValue();
+}
