+/**
+ * Integrated working environment: instead of the full attachment editor, ask for one click
+ * on a plane or a flat face and start editing the sketch right away.
+ */
+class SketchPlanePicker: public Gui::TaskView::TaskDialog, public Gui::SelectionObserver
+{
+public:
+    SketchPlanePicker(
+        Gui::Document* guidocument,
+        PartDesign::Body* body,
+        App::DocumentObject* sketch,
+        std::function<void()> onAccept,
+        std::function<void()> onReject
+    )
+        : Gui::SelectionObserver(true)
+        , guidocument(guidocument)
+        , body(body)
+        , sketch(sketch)
+        , onAccept(std::move(onAccept))
+        , onReject(std::move(onReject))
+    {
+        auto box = new Gui::TaskView::TaskBox(text("Where to draw"), false);
+        hint = new QLabel(text("Click one of the planes, or a flat face of the part, to draw the sketch on it."));
+        hint->setWordWrap(true);
+        box->groupLayout()->addWidget(hint);
+        Content.push_back(box);
+    }
+
+    QDialogButtonBox::StandardButtons getStandardButtons() const override
+    {
+        return QDialogButtonBox::Cancel;
+    }
+
+    bool reject() override
+    {
+        if (onReject) {
+            onReject();
+        }
+        guidocument->abortCommand();
+        Gui::Command::doCommand(Gui::Command::Doc, "App.ActiveDocument.recompute()");
+        return true;
+    }
+
+private:
+    static QString text(const char* source)
+    {
+        return QApplication::translate("PartDesignGui::SketchPlanePicker", source);
+    }
+
+    void onSelectionChanged(const Gui::SelectionChanges& msg) override
+    {
+        if (msg.Type != Gui::SelectionChanges::AddSelection || done) {
+            return;
+        }
+        App::PropertyLinkSubList support;
+        Gui::Selection().getAsPropertyLinkSubList(support);
+        support.removeValue(body);
+        support.removeValue(sketch);
+        auto* attach = sketch->getExtensionByType<Part::AttachExtension>();
+        if (support.getSize() != 1 || !attach) {
+            return;
+        }
+        attach->attacher().setReferences(support);
+        Attacher::SuggestResult sugr;
+        attach->attacher().suggestMapModes(sugr);
+        bool planar = sugr.message == Attacher::SuggestResult::srOK
+            && (sugr.bestFitMode == Attacher::mmFlatFace || sugr.bestFitMode == Attacher::mmObjectXY);
+        if (!planar) {
+            hint->setText(text("That is not flat. Click a plane or a flat face."));
+            QTimer::singleShot(0, []() { Gui::Selection().clearSelection(); });
+            return;
+        }
+        done = true;
+        FCMD_OBJ_CMD(sketch, "AttachmentSupport = " << support.getPyReprString());
+        FCMD_OBJ_CMD(sketch, "MapMode = '" << Attacher::AttachEngine::getModeName(sugr.bestFitMode) << "'");
+        Gui::Command::updateActive();
+        // Leave the selection callback before closing this dialog and opening the sketch
+        auto accept = onAccept;
+        Gui::Document* doc = guidocument;
+        QTimer::singleShot(0, [doc, accept]() {
+            Gui::Control().closeDialog();
+            doc->commitCommand();
+            if (accept) {
+                accept();
+            }
+        });
+    }
+
+    Gui::Document* guidocument;
+    PartDesign::Body* body;
+    App::DocumentObject* sketch;
+    std::function<void()> onAccept;
+    std::function<void()> onReject;
+    QLabel* hint {nullptr};
+    bool done {false};
+};
