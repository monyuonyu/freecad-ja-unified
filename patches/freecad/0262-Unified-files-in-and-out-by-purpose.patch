+class Export2DCommand:
+    def GetResources(self):
+        return {
+            "Pixmap": "TechDraw_ExportPageDXF",
+            "MenuText": QT_TRANSLATE_NOOP("Unified_Export2D", "2D (DXF, PDF of a Drawing)…"),
+            "ToolTip": QT_TRANSLATE_NOOP("Unified_Export2D",
+                                         "The drawing of this file as DXF or PDF (a drawing is made first if there is none)"),
+        }
+
+    def IsActive(self):
+        return App.ActiveDocument is not None
+
+    def Activated(self):
+        Gui, QtCore, QtGui, QtWidgets = _gui()
+        doc = App.ActiveDocument
+        pages = [o for o in doc.Objects if o.isDerivedFrom("TechDraw::DrawPage")]
+        if not pages:
+            Gui.runCommand("Unified_NewDrawing")
+            pages = [o for o in doc.Objects if o.isDerivedFrom("TechDraw::DrawPage")]
+            if not pages:
+                return
+        page = pages[-1]
+        start = os.path.join(os.path.dirname(doc.FileName) if doc.FileName else os.path.expanduser("~"), doc.Label + ".pdf")
+        path, chosen = QtWidgets.QFileDialog.getSaveFileName(Gui.getMainWindow(), translate("UnifiedFiles", "2D"), start,
+                                                             "PDF (*.pdf);;DXF (*.dxf)")
+        if not path:
+            return
+        import TechDrawGui
+
+        if path.lower().endswith(".dxf") or "dxf" in chosen.lower():
+            if not path.lower().endswith(".dxf"):
+                path += ".dxf"
+            TechDrawGui.exportPageAsDxf(page, path)
+        else:
+            if not path.lower().endswith(".pdf"):
+                path += ".pdf"
+            TechDrawGui.exportPageAsPdf(page, path)
