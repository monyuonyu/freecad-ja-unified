+# --------------------------------------------------------------------------- after opening
+class OpenedBand:
+    """A band under the tool strip after a 2D drawing or a mesh was opened: what can be done with it"""
+
+    def __init__(self):
+        Gui, QtCore, QtGui, QtWidgets = _gui()
+        mw = Gui.getMainWindow()
+        bar = self.bar = QtWidgets.QToolBar(mw)
+        bar.setObjectName("UnifiedOpenedBand")
+        bar.setMovable(False)
+        bar.setToolButtonStyle(QtCore.Qt.ToolButtonTextBesideIcon)
+        bar.setStyleSheet("#UnifiedOpenedBand { background: #eef8f0; border-bottom: 2px solid #3a9b55; }"
+                          " #UnifiedOpenedTitle { font-weight: bold; color: #1f6b36; padding: 0 10px; }")
+        bar.toggleViewAction().setVisible(False)
+        mw.addToolBarBreak(QtCore.Qt.TopToolBarArea)
+        mw.addToolBar(QtCore.Qt.TopToolBarArea, bar)
+        bar.hide()
+        self.doc_name = None
+        self.dismissed = set()
+        self.timer = QtCore.QTimer(bar)
+        self.timer.timeout.connect(self.poll)
+        self.timer.start(700)
+
+    def poll(self):
+        doc = App.ActiveDocument
+        name = doc.Name if doc else None
+        if name == self.doc_name:
+            return
+        self.doc_name = name
+        kind = kind_of_document(doc) if doc and name not in self.dismissed else None
+        self.show(kind, doc)
+
+    def show(self, kind, doc):
+        Gui, QtCore, QtGui, QtWidgets = _gui()
+        self.bar.clear()
+        if kind is None:
+            self.bar.hide()
+            return
+        title = QtWidgets.QLabel(self.bar)
+        title.setObjectName("UnifiedOpenedTitle")
+        title.setText(translate("UnifiedFiles", "What you can do with this drawing:") if kind == "2d"
+                      else translate("UnifiedFiles", "What you can do with this mesh:"))
+        self.bar.addWidget(title)
+
+        def act(text, func):
+            a = self.bar.addAction(translate("UnifiedFiles", text))
+            a.triggered.connect(func)
+
+        if kind == "2d":
+            act(QT_TRANSLATE_NOOP("UnifiedFiles", "Extrude it to a solid"), self.extrude)
+            act(QT_TRANSLATE_NOOP("UnifiedFiles", "Make a sketch of it to change it"), self.to_sketch)
+            act(QT_TRANSLATE_NOOP("UnifiedFiles", "Save as another format"), lambda: Gui.runCommand("Std_Export"))
+        else:
+            act(QT_TRANSLATE_NOOP("UnifiedFiles", "Check and fix"), lambda: self.run_on_meshes("Mesh_Evaluation"))
+            act(QT_TRANSLATE_NOOP("UnifiedFiles", "Make a solid"), self.mesh_to_solid)
+            act(QT_TRANSLATE_NOOP("UnifiedFiles", "Export for 3D printing"), lambda: Gui.runCommand("Unified_Export3DPrint"))
+        spacer = QtWidgets.QWidget(self.bar)
+        spacer.setSizePolicy(QtWidgets.QSizePolicy.Expanding, QtWidgets.QSizePolicy.Preferred)
+        self.bar.addWidget(spacer)
+        close = self.bar.addAction("✕")
+        close.setToolTip(translate("UnifiedFiles", "Close this band"))
+        close.triggered.connect(self.dismiss)
+        self.bar.show()
+
+    def dismiss(self):
+        if self.doc_name:
+            self.dismissed.add(self.doc_name)
+        self.bar.hide()
+
+    def lines(self):
+        import ContextRules
+
+        return [o for o in App.ActiveDocument.Objects if ContextRules.is_loose_2d(o) and o.Visibility]
+
+    def extrude(self):
+        Gui, *_ = _gui()
+        doc = App.ActiveDocument
+        Gui.Selection.clearSelection()
+        for o in self.lines():
+            Gui.Selection.addSelection(doc.Name, o.Name)
+        Gui.runCommand("PartDesign_Pad")
+        self.dismiss()
+
+    def to_sketch(self):
+        Gui, *_ = _gui()
+        doc = App.ActiveDocument
+        Gui.Selection.clearSelection()
+        for o in self.lines():
+            Gui.Selection.addSelection(doc.Name, o.Name)
+        import ContextRules
+
+        ContextRules.run("Draft_Draft2Sketch")
+        self.dismiss()
+
+    def run_on_meshes(self, command):
+        Gui, *_ = _gui()
+        doc = App.ActiveDocument
+        Gui.Selection.clearSelection()
+        for o in doc.Objects:
+            if o.isDerivedFrom("Mesh::Feature"):
+                Gui.Selection.addSelection(doc.Name, o.Name)
+        import ContextRules
+
+        ContextRules.run(command)
+
+    def mesh_to_solid(self):
+        """Each mesh as a solid (Part.solidFromMesh of the integrated environment), in one step"""
+        doc = App.ActiveDocument
+        import Part
+
+        doc.openTransaction(translate("UnifiedFiles", "Make a solid"))
+        made = 0
+        for o in list(doc.Objects):
+            if not o.isDerivedFrom("Mesh::Feature"):
+                continue
+            try:
+                solid = Part.solidFromMesh(o.Mesh) if hasattr(Part, "solidFromMesh") else None
+                if solid is None:
+                    shape = Part.Shape()
+                    shape.makeShapeFromMesh(o.Mesh.Topology, 0.05)
+                    solid = Part.makeSolid(shape)
+                f = doc.addObject("Part::Feature", o.Name + "_solid")
+                f.Label = o.Label
+                f.Shape = solid
+                o.Visibility = False
+                made += 1
+            except Exception as e:
+                App.Console.PrintWarning("Make a solid: {}: {}\n".format(o.Label, e))
+        doc.commitTransaction()
+        doc.recompute()
+        self.dismiss()
+        return made
+
