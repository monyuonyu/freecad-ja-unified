--- /dev/null
+++ b/src/Mod/Unified/TestUnifiedFiles.py
@@ -0,0 +1,60 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""Tests of files by purpose (UnifiedFiles.py) without the GUI: the mesh check for 3D printing
+finds holes and inside-out faces and the fix closes them; opened 2D drawings and meshes are
+recognised.
+
+    FreeCADCmd -t TestUnifiedFiles
+"""
+
+import unittest
+
+import FreeCAD as App
+import Mesh
+import Part
+
+import UnifiedFiles as F
+
+
+class TestUnifiedFiles(unittest.TestCase):
+    def setUp(self):
+        self.doc = App.newDocument("UnifiedFilesTest")
+
+    def tearDown(self):
+        App.closeDocument(self.doc.Name)
+
+    def test_good_solid(self):
+        box = self.doc.addObject("Part::Box", "Box")
+        self.doc.recompute()
+        r = F.mesh_report(F.make_mesh(F.solids_to_print(self.doc)))
+        self.assertTrue(r["solid"])
+        self.assertEqual(r["holes"], 0)
+        self.assertEqual(r["flipped"], 0)
+        self.assertEqual(r["separate"], 1)
+
+    def test_hole_found_and_fixed(self):
+        m = Mesh.createBox(10, 10, 10)
+        m.removeFacets([0])
+        r = F.mesh_report(m)
+        self.assertFalse(r["solid"])
+        self.assertEqual(r["holes"], 1)
+        fixed = F.fix_mesh(m)
+        self.assertTrue(F.mesh_report(fixed)["solid"])
+
+    def test_kinds(self):
+        line = self.doc.addObject("Part::Feature", "Line")
+        line.Shape = Part.makeLine(App.Vector(0, 0, 0), App.Vector(1, 0, 0))
+        self.assertEqual(F.kind_of_document(self.doc), "2d")
+        other = App.newDocument("UnifiedFilesMesh")
+        try:
+            mesh = other.addObject("Mesh::Feature", "Mesh")
+            mesh.Mesh = Mesh.createBox(1, 1, 1)
+            self.assertEqual(F.kind_of_document(other), "mesh")
+        finally:
+            App.closeDocument(other.Name)
+        box = self.doc.addObject("Part::Box", "Box")
+        self.doc.recompute()
+        self.assertIsNone(F.kind_of_document(self.doc))
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/src/Mod/Unified/UnifiedFiles.py b/src/Mod/Unified/UnifiedFiles.py
new file mode 100644
index 000000000..79953f2f2
--- /dev/null
+++ b/src/Mod/Unified/UnifiedFiles.py
@@ -0,0 +1,476 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""Files in and out by purpose (design 6.12).
+
+- After a 2D drawing (DXF, DWG, JWW) or a mesh (STL, OBJ, 3MF) is opened, a band says what can be
+  done with it: extrude the outline, make a sketch of it, check and fix the mesh, make a solid…
+- Export by purpose: for 3D printing (3MF / STL, with a check of the mesh and "fix, then export"
+  in one window), to other CAD (STEP), 2D (DXF / PDF of a drawing), an image, or any format.
+The mesh check itself (mesh_report, fix_mesh) needs no GUI and is tested by TestUnifiedFiles.py.
+"""
+
+import os
+
+import FreeCAD as App
+
+translate = App.Qt.translate
+
+
+def QT_TRANSLATE_NOOP(context, text):
+    return text
+
+
+# --------------------------------------------------------------------------- without the GUI
+def solids_to_print(doc, picked=()):
+    """The shapes to print: the picked ones, else the visible solids that are not inside others"""
+    objs = list(picked)
+    if not objs and doc is not None:
+        for o in doc.Objects:
+            if not getattr(o, "Visibility", True) or not o.isDerivedFrom("Part::Feature"):
+                continue
+            if o.isDerivedFrom("PartDesign::Feature") and not getattr(o, "isDerivedFrom", lambda t: False)("PartDesign::Body"):
+                continue  # the steps of a part: the part (body) itself is printed
+            if any(p.isDerivedFrom("PartDesign::Body") for p in o.InList):
+                continue
+            if o.Shape.Solids:
+                objs.append(o)
+    return objs
+
+
+def make_mesh(objs, fineness="normal"):
+    import Mesh
+    import MeshPart
+
+    deflection = {"coarse": 0.2, "normal": 0.05, "fine": 0.01}[fineness]
+    mesh = Mesh.Mesh()
+    for o in objs:
+        if o.isDerivedFrom("Mesh::Feature"):
+            mesh.addMesh(o.Mesh)
+            continue
+        shape = o.Shape.copy()
+        shape.Placement = o.getGlobalPlacement() if hasattr(o, "getGlobalPlacement") else shape.Placement
+        mesh.addMesh(MeshPart.meshFromShape(Shape=shape, LinearDeflection=deflection,
+                                            AngularDeflection=0.35, Relative=False))
+    return mesh
+
+
+def boundary_loops(mesh):
+    """The number of holes: loops of edges that belong to one triangle only"""
+    count = {}
+    for tri in mesh.Topology[1]:
+        for a, b in ((tri[0], tri[1]), (tri[1], tri[2]), (tri[2], tri[0])):
+            key = (a, b) if a < b else (b, a)
+            count[key] = count.get(key, 0) + 1
+    open_edges = [e for e, n in count.items() if n == 1]
+    if not open_edges:
+        return 0
+    # Loops: connected groups of open edges
+    parent = {}
+
+    def find(x):
+        while parent.get(x, x) != x:
+            parent[x] = parent.get(parent[x], parent[x])
+            x = parent[x]
+        return x
+
+    for a, b in open_edges:
+        ra, rb = find(a), find(b)
+        if ra != rb:
+            parent[ra] = rb
+    return len({find(a) for a, _ in open_edges})
+
+
+def mesh_report(mesh):
+    """What a slicer would trip on: {holes, flipped, separate, non_manifold, solid, facets}"""
+    holes = boundary_loops(mesh)
+    return {
+        "facets": mesh.CountFacets,
+        "solid": bool(mesh.isSolid()),
+        "holes": holes,
+        "flipped": int(mesh.hasNonUniformOrientedFacets()),
+        "non_manifold": int(mesh.hasNonManifolds()),
+        "separate": len(mesh.getSeparateComponents()) if hasattr(mesh, "getSeparateComponents") else 1,
+    }
+
+
+def fix_mesh(mesh):
+    """Fix what can be fixed safely: duplicates, orientation, small holes"""
+    mesh = mesh.copy()
+    for step in ("removeDuplicatedPoints", "removeDuplicatedFacets", "removeNonManifolds",
+                 "harmonizeNormals"):
+        try:
+            getattr(mesh, step)()
+        except Exception:
+            pass
+    try:
+        mesh.fillupHoles(1000)
+    except Exception:
+        pass
+    try:
+        if mesh.isSolid() and mesh.Volume < 0:
+            mesh.flipNormals()
+    except Exception:
+        pass
+    return mesh
+
+
+def kind_of_document(doc):
+    """"2d" for a document of loose lines (an opened DXF / DWG / JWW), "mesh" for one of meshes,
+    else None"""
+    if doc is None:
+        return None
+    import ContextRules
+
+    shapes = [o for o in doc.Objects if o.isDerivedFrom("Part::Feature") or o.isDerivedFrom("Mesh::Feature")]
+    if not shapes:
+        return None
+    if all(o.isDerivedFrom("Mesh::Feature") for o in shapes):
+        return "mesh"
+    if any(ContextRules.is_loose_2d(o) for o in shapes) and not any(
+        o.isDerivedFrom("Part::Feature") and o.Shape.Solids for o in shapes
+    ):
+        return "2d"
+    return None
+
+
+# --------------------------------------------------------------------------- with the GUI
+def _gui():
+    import FreeCADGui as Gui
+    from PySide import QtCore, QtGui, QtWidgets
+
+    return Gui, QtCore, QtGui, QtWidgets
+
+
+class PrintDialog:
+    """For 3D printing: format, fineness, what the check found, fix then export"""
+
+    def __init__(self, objs):
+        Gui, QtCore, QtGui, QtWidgets = _gui()
+        self.objs = objs
+        self.mesh = None
+        d = self.dialog = QtWidgets.QDialog(Gui.getMainWindow())
+        d.setObjectName("UnifiedPrintExport")
+        d.setWindowTitle(translate("UnifiedFiles", "Export for 3D printing"))
+        lay = QtWidgets.QVBoxLayout(d)
+        lay.addWidget(QtWidgets.QLabel(translate("UnifiedFiles", "Parts: {}").format(
+            ", ".join(o.Label for o in objs))))
+        row = QtWidgets.QHBoxLayout()
+        self.fmt3mf = QtWidgets.QRadioButton(translate("UnifiedFiles", "3MF (keeps units; most slicers)"))
+        self.fmtstl = QtWidgets.QRadioButton(translate("UnifiedFiles", "STL"))
+        self.fmt3mf.setChecked(True)
+        row.addWidget(self.fmt3mf)
+        row.addWidget(self.fmtstl)
+        row.addStretch(1)
+        lay.addLayout(row)
+        row = QtWidgets.QHBoxLayout()
+        row.addWidget(QtWidgets.QLabel(translate("UnifiedFiles", "Fineness")))
+        self.fine = QtWidgets.QComboBox()
+        for key, text in (("coarse", "Coarse (small file)"), ("normal", "Normal"), ("fine", "Fine (round shapes smooth)")):
+            self.fine.addItem(translate("UnifiedFiles", text), key)
+        self.fine.setCurrentIndex(1)
+        self.fine.currentIndexChanged.connect(lambda _i: self.check())
+        row.addWidget(self.fine)
+        row.addStretch(1)
+        lay.addLayout(row)
+        self.result = QtWidgets.QLabel()
+        self.result.setObjectName("UnifiedPrintCheck")
+        self.result.setWordWrap(True)
+        self.result.setTextFormat(QtCore.Qt.RichText)
+        lay.addWidget(self.result)
+        buttons = QtWidgets.QHBoxLayout()
+        buttons.addStretch(1)
+        self.fix_btn = QtWidgets.QPushButton(translate("UnifiedFiles", "Fix, then export…"))
+        self.fix_btn.clicked.connect(lambda: self.export(fix=True))
+        self.export_btn = QtWidgets.QPushButton(translate("UnifiedFiles", "Export…"))
+        self.export_btn.setDefault(True)
+        self.export_btn.clicked.connect(lambda: self.export(fix=False))
+        cancel = QtWidgets.QPushButton(translate("UnifiedFiles", "Cancel"))
+        cancel.clicked.connect(d.reject)
+        for b in (self.fix_btn, self.export_btn, cancel):
+            buttons.addWidget(b)
+        lay.addLayout(buttons)
+        self.check()
+
+    def check(self):
+        Gui, QtCore, QtGui, QtWidgets = _gui()
+        QtWidgets.QApplication.setOverrideCursor(QtCore.Qt.WaitCursor)
+        try:
+            self.mesh = make_mesh(self.objs, self.fine.currentData())
+            r = self.report = mesh_report(self.mesh)
+        finally:
+            QtWidgets.QApplication.restoreOverrideCursor()
+        ok = "<span style='color:#1a7f37'>✓ {}</span>"
+        bad = "<span style='color:#b42318'>✕ {}</span>"
+        lines = [translate("UnifiedFiles", "{} triangles").format(r["facets"])]
+        lines.append((ok if r["solid"] and not r["holes"] else bad).format(
+            translate("UnifiedFiles", "Closed (no holes)") if r["solid"] and not r["holes"]
+            else translate("UnifiedFiles", "Has holes (open edges)")))
+        lines.append((ok if not r["flipped"] else bad).format(
+            translate("UnifiedFiles", "All faces point outwards") if not r["flipped"]
+            else translate("UnifiedFiles", "Some faces are turned inside out")))
+        lines.append((ok if not r["non_manifold"] else bad).format(
+            translate("UnifiedFiles", "No edges shared by more than two faces") if not r["non_manifold"]
+            else translate("UnifiedFiles", "Edges shared by more than two faces")))
+        lines.append(translate("UnifiedFiles", "{} separate pieces").format(r["separate"]))
+        self.result.setText("<br>".join(lines))
+        self.fix_btn.setEnabled(bool(r["holes"] or r["flipped"] or r["non_manifold"] or not r["solid"]))
+
+    def export(self, fix):
+        Gui, QtCore, QtGui, QtWidgets = _gui()
+        ext = "3mf" if self.fmt3mf.isChecked() else "stl"
+        doc = App.ActiveDocument
+        start = os.path.join(os.path.dirname(doc.FileName) if doc and doc.FileName else os.path.expanduser("~"),
+                             (self.objs[0].Label if len(self.objs) == 1 else (doc.Label if doc else "print")) + "." + ext)
+        path, _ = QtWidgets.QFileDialog.getSaveFileName(
+            self.dialog, translate("UnifiedFiles", "Export for 3D printing"), start,
+            "3MF (*.3mf)" if ext == "3mf" else "STL (*.stl)")
+        if not path:
+            return
+        if not path.lower().endswith("." + ext):
+            path += "." + ext
+        mesh = fix_mesh(self.mesh) if fix else self.mesh
+        mesh.write(path)
+        Gui.getMainWindow().statusBar().showMessage(translate("UnifiedFiles", "Exported to {}").format(path), 8000)
+        self.path = path
+        self.dialog.accept()
+
+    def exec(self):
+        return self.dialog.exec()
+
+
+def _picked():
+    Gui, *_ = _gui()
+    return [s.Object for s in Gui.Selection.getSelectionEx()]
+
+
+class Export3DPrintCommand:
+    def GetResources(self):
+        return {
+            "Pixmap": "Mesh_Export",
+            "MenuText": QT_TRANSLATE_NOOP("Unified_Export3DPrint", "For 3D Printing (3MF, STL)…"),
+            "ToolTip": QT_TRANSLATE_NOOP("Unified_Export3DPrint",
+                                         "Export the picked parts (all if none is picked) for a 3D printer, checked and fixed"),
+        }
+
+    def IsActive(self):
+        return App.ActiveDocument is not None
+
+    def Activated(self):
+        Gui, QtCore, QtGui, QtWidgets = _gui()
+        objs = solids_to_print(App.ActiveDocument, _picked())
+        if not objs:
+            Gui.getMainWindow().statusBar().showMessage(
+                translate("UnifiedFiles", "There is no solid to print yet"), 6000)
+            return
+        PrintDialog(objs).exec()
