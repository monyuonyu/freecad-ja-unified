+// Removes the view keywords from \a kwds (a copy) and returns them as ViewOptions
+ViewOptions takeViewOptions(Py::Dict& kw, PyObject*& up)
+{
+    ViewOptions vo;
+    auto take = [&kw](const char* key) -> PyObject* {
+        if (!kw.hasKey(key)) {
+            return nullptr;
+        }
+        Py::Object v = kw[key];
+        kw.delItem(key);
