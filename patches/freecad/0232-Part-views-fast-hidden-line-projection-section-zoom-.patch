+// Bounding box of a BoundBox, a shape, a mesh, a document object or a list of them
+void addBounds(const Py::Object& obj, std::array<double, 6>& box, bool& any)
+{
+    Py::Object o = obj;
+    if (o.hasAttr("XMin") && o.hasAttr("ZMax")) {
+        double v[6] = {
+            (double)Py::Float(o.getAttr("XMin")), (double)Py::Float(o.getAttr("YMin")),
+            (double)Py::Float(o.getAttr("ZMin")), (double)Py::Float(o.getAttr("XMax")),
+            (double)Py::Float(o.getAttr("YMax")), (double)Py::Float(o.getAttr("ZMax"))
+        };
+        if (v[0] > v[3]) {
+            return;  // empty box
+        }
+        for (int k = 0; k < 3; ++k) {
+            box[k] = any ? std::min(box[k], v[k]) : v[k];
+            box[k + 3] = any ? std::max(box[k + 3], v[k + 3]) : v[k + 3];
+        }
+        any = true;
+        return;
+    }
+    if (o.hasAttr("Shape") && !PyObject_TypeCheck(o.ptr(), &Part::TopoShapePy::Type)) {
+        addBounds(o.getAttr("Shape"), box, any);
+        return;
+    }
+    if (o.hasAttr("Mesh") && !o.hasAttr("Topology")) {
+        addBounds(o.getAttr("Mesh"), box, any);
+        return;
+    }
+    if (o.hasAttr("BoundBox")) {
+        addBounds(o.getAttr("BoundBox"), box, any);
+        return;
+    }
+    if (PySequence_Check(o.ptr()) && !PyUnicode_Check(o.ptr())) {
+        for (const auto& e : Py::Sequence(o)) {
+            addBounds(Py::Object(e), box, any);
+        }
+        return;
+    }
+    throw Py::TypeError("region/focus: expected a BoundBox, a shape, an object or a list of them");
+}
