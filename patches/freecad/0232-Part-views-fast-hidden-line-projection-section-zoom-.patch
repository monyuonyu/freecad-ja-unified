+// Time budget, cancel flag and progress messages of one projection or picture
+class Budget
+{
+public:
+    explicit Budget(const ViewOptions& vo)
+        : progress(vo.progress)
+        , maxSeconds(vo.maxSeconds)
+        , threads(vo.threads)
+        , t0(std::chrono::steady_clock::now())
+    {}
+    double elapsed() const
+    {
+        return std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+    }
+    bool expired()
+    {
+        if (!stop && maxSeconds > 0 && elapsed() > maxSeconds) {
+            stop = true;
+        }
+        return stop;
+    }
+    void say(const char* what, std::size_t done, std::size_t total) const
+    {
+        if (progress) {
+            std::fprintf(stderr, "  %s: %zu/%zu (%.1f s)\n", what, done, total, elapsed());
+            std::fflush(stderr);
+        }
+    }
+    int threadCount(std::size_t n) const
+    {
+        int t = threads > 0 ? threads : (int)std::max(1U, std::thread::hardware_concurrency());
+        return (int)std::max<std::size_t>(1, std::min<std::size_t>((std::size_t)t, n));
+    }
+
+    const bool progress;
+    const double maxSeconds;
+    const int threads;
+    std::atomic<bool> stop {false};
+
+private:
+    std::chrono::steady_clock::time_point t0;
+};
+
+// f(index, thread) for index 0..n-1 on several threads; stops early when the budget runs
+// out.  The calling thread watches the clock and prints progress every two seconds.
+template<typename F>
+void parallelFor(std::size_t n, Budget& budget, const char* what, F&& f, bool always = false)
+{
+    if (n == 0) {
+        return;
+    }
+    const int T = budget.threadCount(n);
+    std::atomic<std::size_t> next {0}, done {0};
+    std::atomic<int> running {T};
+    std::atomic<bool> failed {false};
+    std::exception_ptr error;
+    std::mutex errorMutex;
+    auto work = [&](int tid) {
+        for (;;) {
+            if (failed || (!always && budget.stop)) {
+                break;
+            }
+            std::size_t i = next++;
+            if (i >= n) {
+                break;
+            }
+            try {
+                f(i, tid);
+            }
+            catch (...) {
+                std::lock_guard<std::mutex> lock(errorMutex);
+                if (!error) {
+                    error = std::current_exception();
+                }
+                failed = true;
+            }
+            ++done;
+        }
+        --running;
+    };
+    std::vector<std::thread> pool;
+    for (int t = 0; t < T; ++t) {
+        pool.emplace_back(work, t);
+    }
+    double lastSay = budget.elapsed();
+    while (running > 0) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(50));
+        budget.expired();
+        if (budget.progress && budget.elapsed() - lastSay >= 2.0) {
+            lastSay = budget.elapsed();
+            budget.say(what, done, n);
+        }
+    }
+    for (auto& t : pool) {
+        t.join();
+    }
+    budget.say(what, done, n);
+    if (error) {
+        std::rethrow_exception(error);
+    }
+}
