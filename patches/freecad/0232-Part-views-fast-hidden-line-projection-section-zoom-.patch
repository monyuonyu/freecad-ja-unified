+
+std::vector<SceneItem> Part::ViewTools::sectionItems(
+    const std::vector<SceneItem>& items,
+    const ViewOptions& vo,
+    std::vector<std::string>* warnings
+)
+{
+    std::vector<SceneItem> out(items.size());
+    if (!vo.hasSection) {
+        return items;
+    }
+    const gp_Pnt P = vo.sectionPoint;
+    const gp_Dir N = vo.sectionNormal;
+    std::mutex warnMutex;
+    Budget budget(vo);
+    parallelFor(items.size(), budget, "section", [&](std::size_t i, int) {
+        const SceneItem& in = items[i];
+        SceneItem& res = out[i];
+        res = in;
+        res.sectionColor = vo.sectionColor;
+        if (in.shape.IsNull()) {
+            if (!in.meshFacets.empty()) {
+                clipMesh(res, P, N);
+            }
+            return;
+        }
+        Bnd_Box box;
+        BRepBndLib::Add(in.shape, box, Standard_False);
+        if (box.IsVoid()) {
+            return;
+        }
+        double x0 {}, y0 {}, z0 {}, x1 {}, y1 {}, z1 {};
+        box.Get(x0, y0, z0, x1, y1, z1);
+        double smin = 1e300, smax = -1e300;
+        for (int k = 0; k < 8; ++k) {
+            gp_Pnt c((k & 1) ? x1 : x0, (k & 2) ? y1 : y0, (k & 4) ? z1 : z0);
+            double d = gp_Vec(P, c).Dot(gp_Vec(N));
+            smin = std::min(smin, d);
+            smax = std::max(smax, d);
+        }
+        const double diag = std::sqrt(box.SquareExtent());
+        const double tol = std::max(diag * 1e-9, 1e-9);
+        if (smax <= tol) {
+            return;  // all on the kept side
+        }
+        if (smin >= -tol) {
+            res.shape.Nullify();  // all cut away
+            res.faceColors.clear();
+            return;
+        }
+        // a box on the removed side, large enough to hold the shape
+        gp_Pnt center((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2);
+        gp_Pnt onPlane = center.Translated(-gp_Vec(N) * gp_Vec(P, center).Dot(gp_Vec(N)));
+        gp_Ax2 ax(onPlane, N);
+        const double L = 2 * diag + 1;
+        gp_Pnt corner = onPlane.Translated(-gp_Vec(ax.XDirection()) * L - gp_Vec(ax.YDirection()) * L);
+        TopoDS_Shape tool = BRepPrimAPI_MakeBox(gp_Ax2(corner, N, ax.XDirection()), 2 * L, 2 * L, L).Shape();
+        BRepAlgoAPI_Cut cut(in.shape, tool);
+        if (!cut.IsDone() || cut.HasErrors() || cut.Shape().IsNull()) {
+            std::lock_guard<std::mutex> lock(warnMutex);
+            if (warnings) {
+                warnings->push_back("section: item " + std::to_string(i) + " could not be cut, shown whole");
+            }
+            return;
+        }
+        const TopoDS_Shape result = cut.Shape();
+        // colours of the faces that came from the shape's faces, section colour on the plane
+        TopTools_IndexedMapOfShape oldFaces, newFaces;
+        TopExp::MapShapes(in.shape, TopAbs_FACE, oldFaces);
+        TopExp::MapShapes(result, TopAbs_FACE, newFaces);
+        std::vector<Color> colors(newFaces.Extent(), in.color);
+        if (!in.faceColors.empty()) {
+            for (int k = 1; k <= oldFaces.Extent() && k <= (int)in.faceColors.size(); ++k) {
+                const Color& c = in.faceColors[k - 1];
+                int same = newFaces.FindIndex(oldFaces(k));
+                if (same > 0) {
+                    colors[same - 1] = c;
+                }
+                for (const auto& m : cut.Modified(oldFaces(k))) {
+                    int idx = newFaces.FindIndex(m);
+                    if (idx > 0) {
+                        colors[idx - 1] = c;
+                    }
+                }
+            }
+        }
+        res.shape = result;
+        res.faceColors = in.faceColors.empty() ? std::vector<Color>() : colors;
+        res.sectionFaces.assign(newFaces.Extent(), 0);
+        const gp_Pln plane(P, N);
+        for (int k = 1; k <= newFaces.Extent(); ++k) {
+            BRepAdaptor_Surface surf(TopoDS::Face(newFaces(k)), Standard_False);
+            if (surf.GetType() != GeomAbs_Plane) {
+                continue;
+            }
+            gp_Pln pl = surf.Plane();
+            if (std::fabs(pl.Axis().Direction().Dot(N)) > 1 - 1e-9
+                && plane.Distance(pl.Location()) < std::max(tol * 100, 1e-7)) {
+                res.sectionFaces[k - 1] = 1;
+            }
+        }
+    });
+    return out;
+}
