+// ------------------------------------------------------------------ section and zoom
+
+namespace
+{
+
+struct Rect2
+{
+    double x0 = 0, y0 = 0, x1 = 0, y1 = 0;
+    bool overlaps(const Rect2& o) const
+    {
+        return !(o.x1 < x0 || o.x0 > x1 || o.y1 < y0 || o.y0 > y1);
+    }
+};
+
+Rect2 projectBox(const Bnd_Box& box, const Camera& cam)
+{
+    double x0 {}, y0 {}, z0 {}, x1 {}, y1 {}, z1 {};
+    box.Get(x0, y0, z0, x1, y1, z1);
+    Rect2 r {1e300, 1e300, -1e300, -1e300};
+    for (int k = 0; k < 8; ++k) {
+        gp_Pnt p((k & 1) ? x1 : x0, (k & 2) ? y1 : y0, (k & 4) ? z1 : z0);
+        double x {}, y {}, d {};
+        cam.project(p, x, y, d);
+        r.x0 = std::min(r.x0, x);
+        r.y0 = std::min(r.y0, y);
+        r.x1 = std::max(r.x1, x);
+        r.y1 = std::max(r.y1, y);
+    }
+    return r;
+}
+
+Bnd_Box regionBox(const ViewOptions& vo)
+{
+    Bnd_Box box;
+    const auto& r = vo.region;
+    box.Update(std::min(r[0], r[3]), std::min(r[1], r[4]), std::min(r[2], r[5]),
+               std::max(r[0], r[3]), std::max(r[1], r[4]), std::max(r[2], r[5]));
