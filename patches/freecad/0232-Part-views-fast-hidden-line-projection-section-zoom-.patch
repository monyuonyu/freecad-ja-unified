+// a mesh with the triangles clipped to where (p - point).normal <= 0
+void clipMesh(SceneItem& item, const gp_Pnt& point, const gp_Dir& normal)
+{
+    std::vector<gp_Pnt> pts;
+    std::vector<std::array<int, 3>> facets;
+    auto dist = [&](const gp_Pnt& p) {
+        return gp_Vec(point, p).Dot(gp_Vec(normal));
+    };
+    for (const auto& f : item.meshFacets) {
+        std::vector<gp_Pnt> poly;
+        for (int e = 0; e < 3; ++e) {
+            const gp_Pnt& a = item.meshPoints[f[e]];
+            const gp_Pnt& b = item.meshPoints[f[(e + 1) % 3]];
+            double da = dist(a), db = dist(b);
+            if (da <= 0) {
+                poly.push_back(a);
+            }
+            if ((da <= 0) != (db <= 0)) {
+                double t = da / (da - db);
+                poly.emplace_back(a.XYZ() + (b.XYZ() - a.XYZ()) * t);
+            }
+        }
+        if (poly.size() < 3) {
+            continue;
+        }
+        int base = (int)pts.size();
+        pts.insert(pts.end(), poly.begin(), poly.end());
+        for (int k = 1; k + 1 < (int)poly.size(); ++k) {
+            facets.push_back({base, base + k, base + k + 1});
+        }
+    }
+    item.meshPoints = std::move(pts);
+    item.meshFacets = std::move(facets);
+}
+
+// The items as the view shows them: cut by the section plane, and those outside the zoom
+// region left out (empty items keep the indices)
+const std::vector<SceneItem>& prepareItems(
+    const std::vector<SceneItem>& items,
+    const Camera& cam,
+    const ViewOptions& vo,
+    std::vector<SceneItem>& storage,
+    std::vector<std::string>* warnings
+)
+{
+    if (!vo.hasSection && !vo.hasRegion) {
+        return items;
+    }
+    storage = vo.hasSection ? sectionItems(items, vo, warnings) : items;
+    if (vo.hasRegion) {
+        const Rect2 rect = projectBox(regionBox(vo), cam);
+        for (auto& item : storage) {
+            Bnd_Box box = itemBox(item);
+            if (box.IsVoid() || !projectBox(box, cam).overlaps(rect)) {
+                Color c = item.color;
+                item = SceneItem();
+                item.color = c;
+            }
+        }
+    }
+    return storage;
+}
+
+double regionDeflection(const ViewOptions& vo, double requested)
+{
+    if (requested > 0 || !vo.hasRegion) {
+        return requested;
+    }
+    Bnd_Box box = regionBox(vo);
+    return std::max(std::sqrt(box.SquareExtent()) * 0.0008, 1e-4);
+}
