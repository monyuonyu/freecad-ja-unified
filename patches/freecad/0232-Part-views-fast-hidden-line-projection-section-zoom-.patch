+void addMesh(Scene& scene, int itemIndex, const SceneItem& item);
+
+// A shape made of planar triangles only (Part.Shape.makeShapeFromMesh of an STL) as a mesh,
+// or false.  The mesh path merges coplanar triangles and shows no edges between them, and
+// needs no BRepMesh (which took most of the time for such shapes).
+bool meshOfTriangleShape(const SceneItem& item, SceneItem& mesh)
+{
+    if (!item.faceColors.empty() || !item.sectionFaces.empty()) {
+        return false;
+    }
+    TopTools_IndexedMapOfShape faceMap;
+    TopExp::MapShapes(item.shape, TopAbs_FACE, faceMap);
+    if (faceMap.Extent() < 4) {
+        return false;
+    }
+    Bnd_Box box;
+    BRepBndLib::Add(item.shape, box);
+    if (box.IsVoid()) {
+        return false;
+    }
+    const double tol = std::max(std::sqrt(box.SquareExtent()) * 1e-9, 1e-12);
+    std::map<std::array<long long, 3>, int> index;
+    mesh.color = item.color;
+    for (int i = 1; i <= faceMap.Extent(); ++i) {
+        const TopoDS_Face& face = TopoDS::Face(faceMap(i));
+        BRepAdaptor_Surface surf(face, Standard_False);
+        if (surf.GetType() != GeomAbs_Plane) {
+            return false;
+        }
+        TopTools_IndexedMapOfShape vertices, edges;
+        TopExp::MapShapes(face, TopAbs_VERTEX, vertices);
+        TopExp::MapShapes(face, TopAbs_EDGE, edges);
+        if (vertices.Extent() != 3 || edges.Extent() != 3) {
+            return false;
+        }
+        std::array<int, 3> tri {};
+        std::array<gp_Pnt, 3> pts;
+        for (int k = 0; k < 3; ++k) {
+            pts[k] = BRep_Tool::Pnt(TopoDS::Vertex(vertices(k + 1)));
+            std::array<long long, 3> key {
+                std::llround(pts[k].X() / tol),
+                std::llround(pts[k].Y() / tol),
+                std::llround(pts[k].Z() / tol)
+            };
+            auto it = index.find(key);
+            if (it == index.end()) {
+                it = index.emplace(key, (int)mesh.meshPoints.size()).first;
+                mesh.meshPoints.push_back(pts[k]);
+            }
+            tri[k] = it->second;
+        }
+        gp_Dir normal = surf.Plane().Axis().Direction();
+        if (face.Orientation() == TopAbs_REVERSED) {
+            normal.Reverse();
+        }
+        if (triNormal(pts[0], pts[1], pts[2]).Dot(gp_Vec(normal)) < 0) {
+            std::swap(tri[1], tri[2]);
+        }
+        mesh.meshFacets.push_back(tri);
+    }
+    return true;
+}
