+def _poly_area(poly):
+    def ring(r):
+        a = 0.0
+        for i in range(len(r)):
+            x0, y0 = r[i - 1]
+            x1, y1 = r[i]
+            a += x0 * y1 - x1 * y0
+        return abs(a) / 2
+
+    return ring(poly["outer"]) - sum(ring(h) for h in poly["holes"])
+
