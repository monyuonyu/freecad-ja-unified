index 000000000..0459a84da
--- /dev/null
+++ b/src/App/SingleWorkbench.h
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+#pragma once
+
+#include <App/Application.h>
+
+namespace App
+{
+
+/// True in the integrated working environment: one workbench (Config "SingleWorkbench")
+/// instead of a choice of workbenches. Behavior that differs from standard FreeCAD asks here.
+inline bool isSingleWorkbench()
+{
+    return Application::Config().contains("SingleWorkbench");
+}
+
+}  // namespace App
