+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""Hovering a tool shows what it would do (ツールの下見): a see-through ghost over the 3D view.
+
+The tools of the tool strip and of the bar next to a pick: after the mouse rests on the
+button for a moment (300 ms), the result is worked out on copies of the picked shapes
+(ToolPreview.py, in a thread) and drawn over the view: green where material is added, red
+where it is taken away, blue for a new copy. Leaving the button (or pressing it) removes the
+ghost and cancels the work. What takes longer than a second is not shown; the tooltip, one
+plain sentence of what the tool does, is shown in any case.
+The document is never changed.
+"""
+
+import FreeCAD as App
+import FreeCADGui as Gui
+from PySide import QtCore, QtWidgets
+
+import ToolPreview
+
+translate = App.Qt.translate
+CTX = "UnifiedPreview"
+
+
+def QT_TRANSLATE_NOOP(context, text):
+    return text
+
+
+DELAY_MS = 300
+POLL_MS = 30
+
+# One plain sentence of what each tool does (Japanese in UnifiedWording_ja.ts)
+TIPS = {
+    "PartDesign_NewSketch": QT_TRANSLATE_NOOP(CTX, "Draws an outline on a flat face or a plane."),
+    "PartDesign_Pad": QT_TRANSLATE_NOOP(CTX, "Pulls a sketch or a flat face out into a solid."),
+    "PartDesign_Pocket": QT_TRANSLATE_NOOP(CTX, "Cuts the shape of a sketch or face into the part."),
+    "PartDesign_Revolution": QT_TRANSLATE_NOOP(CTX, "Turns a sketch around an axis into a solid."),
+    "Unified_Hole": QT_TRANSLATE_NOOP(CTX, "Drills a hole where you clicked on a flat face."),
+    "PartDesign_Fillet": QT_TRANSLATE_NOOP(CTX, "Rounds off the picked edges."),
+    "PartDesign_Chamfer": QT_TRANSLATE_NOOP(CTX, "Cuts the picked edges off at a slant."),
+    "PartDesign_Thickness": QT_TRANSLATE_NOOP(CTX, "Hollows the part out, leaving walls of the given thickness."),
+    "PartDesign_Mirrored": QT_TRANSLATE_NOOP(CTX, "Makes a mirror image of the picked feature on the other side."),
+    "PartDesign_LinearPattern": QT_TRANSLATE_NOOP(CTX, "Repeats the picked feature in a straight row."),
+    "PartDesign_PolarPattern": QT_TRANSLATE_NOOP(CTX, "Repeats the picked feature in a circle around an axis."),
+    "Part_Mirror": QT_TRANSLATE_NOOP(CTX, "Makes a mirrored copy of the picked part."),
+}
+
+COLORS = {
+    ToolPreview.ADD: (0.15, 0.75, 0.25),
+    ToolPreview.REMOVE: (0.9, 0.15, 0.1),
+    ToolPreview.COPY: (0.2, 0.45, 0.95),
+}
+
+
+def tip_for(command):
+    text = TIPS.get(command)
+    return translate(CTX, text) if text else ""
+
+
+# --- the ghost over the view --------------------------------------------------------------
+
+
+class Ghost:
+    """See-through shapes drawn over the active 3D view; not part of the document"""
+
+    def __init__(self):
+        self.view = None
+        self.root = None
+
+    def show(self, shapes):
+        from pivy import coin
+
+        self.clear()
+        doc = Gui.ActiveDocument
+        view = doc.ActiveView if doc else None
+        if view is None or not hasattr(view, "getSceneGraph"):
+            return False
+        root = coin.SoSeparator()
+        style = coin.SoPickStyle()
+        style.style = coin.SoPickStyle.UNPICKABLE
+        root.addChild(style)
+        # In front of the faces it lies on (a fillet's sliver, an extrusion on a face)
+        offset = coin.SoPolygonOffset()
+        offset.factor = -1.0
+        offset.units = -1.0
+        root.addChild(offset)
+        for shape, role in shapes:
+            node = self._node(shape)
+            if node is None:
+                continue
+            sep = coin.SoSeparator()
+            look = coin.SoMaterial()
+            look.diffuseColor.setValue(*COLORS.get(role, COLORS[ToolPreview.COPY]))
+            look.emissiveColor.setValue(*[c * 0.35 for c in COLORS.get(role, COLORS[ToolPreview.COPY])])
+            look.transparency.setValue(0.45)
+            look.setOverride(True)
+            sep.addChild(look)
+            sep.addChild(node)
+            root.addChild(sep)
+        view.getSceneGraph().addChild(root)
+        self.view, self.root = view, root
+        return True
+
+    @staticmethod
+    def _node(shape):
+        from pivy import coin
+
+        try:
+            box = shape.BoundBox
+            deviation = max(0.01, box.DiagonalLength * 0.002)
+            text = shape.writeInventor(Deviation=deviation)
+        except Exception:
+            try:
+                text = shape.writeInventor()
+            except Exception:
+                return None
+        data = coin.SoInput()
+        data.setBuffer(text)
+        return coin.SoDB.readAll(data)
+
+    def clear(self):
+        if self.root is not None and self.view is not None:
+            try:
+                self.view.getSceneGraph().removeChild(self.root)
+            except Exception:
+                pass
+        self.view = self.root = None
+
+    @property
+    def shown(self):
+        return self.root is not None
+
+
+# --- what is picked ------------------------------------------------------------------------
+
+
+def current_picks():
+    picks = []
+    for sel in Gui.Selection.getSelectionEx("", 0):
+        names = list(sel.SubElementNames) or [""]
+        points = list(sel.PickedPoints)
+        for i, name in enumerate(names):
+            point = points[i] if i < len(points) else None
+            if point is not None and not _on_element(sel.Object, name, point):
+                point = None  # picked in the tree: no point
+            picks.append(ToolPreview.Pick(sel.Object, name, point))
+    return picks
+
+
+def _on_element(root, sub, point):
+    try:
+        import Part
+
+        shape = root.getSubObject(sub) if sub and sub.split(".")[-1] else None
+        if shape is None:
+            return False
+        tol = max(1e-3, shape.BoundBox.DiagonalLength * 1e-3)
+        return shape.distToShape(Part.Vertex(point))[0] <= tol
+    except Exception:
+        return False
+
+
+# --- hovering -----------------------------------------------------------------------------
+
+
+class Previewer(QtCore.QObject):
+    """One preview at a time: started by resting on a button, ended by leaving it"""
+
+    def __init__(self):
+        super().__init__()
+        self.ghost = Ghost()
+        self.button = None
+        self.command = None
+        self.job = None
+        self.delay = QtCore.QTimer(self)
+        self.delay.setSingleShot(True)
+        self.delay.timeout.connect(self._start)
+        self.poller = QtCore.QTimer(self)
+        self.poller.setInterval(POLL_MS)
+        self.poller.timeout.connect(self._poll)
+        # The last state, for tests and the acceptance run
+        self.last_state = None
+
+    def hover(self, button, command):
+        self.leave()
+        if not ToolPreview.has_preview(command):
+            return
+        self.button, self.command = button, command
+        self.delay.start(DELAY_MS)
+
+    def leave(self):
+        self.delay.stop()
+        self.poller.stop()
+        if self.job is not None:
+            self.job.cancel()
+            self.last_state = "cancelled" if self.job.state == "cancelled" else self.last_state
+            self.job = None
+        self.ghost.clear()
+        self.button = self.command = None
+
+    def _value(self):
+        """The number the tool would take: the bar's field when it is this tool's, else the
+        last one used with it (ContextRules)"""
+        button = self.button
+        bar = button.parentWidget() if button is not None else None
+        if bar is not None and bar.objectName() == "UnifiedContextBar":
+            field = bar.findChild(QtWidgets.QLineEdit, "UnifiedContextField")
+            if field is not None and field.property("unifiedCommand") == self.command:
+                return field.text()
+        try:
+            import ContextRules
+
+            return ContextRules.default_value(self.command) or None
+        except Exception:
+            return None
+
+    def _start(self):
+        if self.command is None or Gui.Control.activeDialog():
+            return
+        compute = ToolPreview.prepare(self.command, current_picks(), self._value())
+        if compute is None:
+            self.last_state = "none"
+            return
+        self.job = ToolPreview.Job(compute, deadline=1.0).start()
+        self.last_state = "pending"
+        self.poller.start()
+
+    def _poll(self):
+        job = self.job
+        if job is None:
+            self.poller.stop()
+            return
+        state = job.poll()
+        if state == "pending":
+            return
+        self.poller.stop()
+        self.last_state = state
+        if state == "done" and self.button is not None:
+            self.ghost.show(job.result)
+        self.job = None
+
+
+_previewer = None
+
+
+def previewer():
+    global _previewer
+    if _previewer is None:
+        _previewer = Previewer()
+    return _previewer
+
+
+def command_of(button):
+    """The command a button runs: set by the bar next to a pick, or the button's action"""
+    name = button.property("unifiedCommand")
+    if name:
+        return str(name)
+    action = button.defaultAction() if isinstance(button, QtWidgets.QToolButton) else None
+    return action.objectName() if action is not None else ""
+
+
+class HoverFilter(QtCore.QObject):
+    def eventFilter(self, obj, event):
+        t = event.type()
+        if t == QtCore.QEvent.Enter:
+            command = command_of(obj)
+            tip = tip_for(command)
+            if tip and obj.property("unifiedTip") != tip:
+                obj.setProperty("unifiedTip", tip)
+                obj.setToolTip(_with_key(tip, command))
+            previewer().hover(obj, command)
+        elif t in (QtCore.QEvent.Leave, QtCore.QEvent.Hide, QtCore.QEvent.MouseButtonPress):
+            if previewer().button is obj:
+                previewer().leave()
+        elif t == QtCore.QEvent.ChildAdded and isinstance(obj, QtWidgets.QToolBar):
+            # A tool added to the strip: its button is made later
+            QtCore.QTimer.singleShot(0, lambda bar=obj: watch_buttons(bar))
+        return False
+
+
+def _with_key(tip, command):
+    try:
+        import UnifiedChrome
+
+        for key, name in UnifiedChrome.KEYS.items():
+            if name == command:
+                return tip + " " + translate("Unified", "(key {})").format(key)
+    except Exception:
+        pass
+    return tip
+
+
+_filter = None
+
+
+def _hover_filter():
+    global _filter
+    if _filter is None:
+        _filter = HoverFilter()
+    return _filter
+
+
+def watch_buttons(parent):
+    """Preview and plain tooltips for the tool buttons in the widget"""
+    f = _hover_filter()
+    for button in parent.findChildren(QtWidgets.QToolButton):
+        if not button.property("unifiedHover"):
+            button.setProperty("unifiedHover", True)
+            button.installEventFilter(f)
+
+
+STRIPS = ("Unified Tools", "Unified Model", "Unified Parts")
+
+
+def install():
+    def later():
+        mw = Gui.getMainWindow()
+        for bar in mw.findChildren(QtWidgets.QToolBar):
+            if bar.objectName() in STRIPS and not bar.property("unifiedHover"):
+                bar.setProperty("unifiedHover", True)
+                bar.installEventFilter(_hover_filter())
+                watch_buttons(bar)
+
+    QtCore.QTimer.singleShot(0, later)
