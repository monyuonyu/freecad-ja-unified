diff --git a/src/Mod/Unified/MeasureBarGui.py b/src/Mod/Unified/MeasureBarGui.py
new file mode 100644
index 000000000..ae2b77730
--- /dev/null
+++ b/src/Mod/Unified/MeasureBarGui.py
@@ -0,0 +1,153 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""The numbers on the bar next to a pick, without pressing "Measure" (自動で測る).
+
+Called by the bar (ContextBar.cpp) each time it is built: on its left the measurement of the
+one or two picked things (MeasureMath.py), on its right the tools as before. A click on a
+number copies it; 「寸法を残す」 keeps the measurement in the document as a Measure object.
+It also lets the bar's buttons show the preview of their tool (ToolPreviewGui.py).
+"""
+
+import FreeCAD as App
+import FreeCADGui as Gui
+from PySide import QtCore, QtGui, QtWidgets
+
+import MeasureMath as M
+
+translate = App.Qt.translate
+CTX = "UnifiedMeasure"
+
+_cache = {}
+
+
+def _key():
+    return tuple(
+        (s.Object.Document.Name, s.Object.Name, tuple(s.SubElementNames))
+        for s in Gui.Selection.getSelectionEx("", 0)
+    )
+
+
+def picks():
+    out = []
+    for s in Gui.Selection.getSelectionEx("", 0):
+        for name in list(s.SubElementNames) or [""]:
+            out.append((s.Object, name))
+    return out
+
+
+def current():
+    """The measurement of what is picked now (cached for the selection)"""
+    key = _key()
+    if key not in _cache:
+        if len(_cache) > 20:
+            _cache.clear()
+        p = picks()
+        _cache[key] = (M.measure_picks(p) if 0 < len(p) <= 2 else M.Result(), p)
+    return _cache[key]
+
+
+def item_text(item):
+    name = translate(CTX, M.NAMES[item.key])
+    if item.key in ("diameter", "radius"):
+        return name + item.text()
+    return "{} {}".format(name, item.text())
+
+
+def _status(text):
+    try:
+        Gui.getMainWindow().statusBar().showMessage(text, 4000)
+    except Exception:
+        pass
+
+
+def copy(item):
+    QtWidgets.QApplication.clipboard().setText(item.number())
+    _status(translate(CTX, "Copied {}").format(item.number()))
+
+
+def keep(result, picked, button=None):
+    try:
+        import MeasureGui  # noqa: F401  (how the Measure objects are drawn)
+    except Exception:
+        pass
+    try:
+        obj = M.keep(result, picked)
+    except Exception as e:
+        App.Console.PrintWarning("Keep the dimension: {}\n".format(e))
+        return None
+    if obj is not None:
+        _status(translate(CTX, "Kept as {}").format(obj.Label))
+        if button is not None:
+            # Once is enough: a second click would keep the same dimension twice
+            button.setEnabled(False)
+            button.setText(translate(CTX, "Kept"))
+    return obj
+
+
+def _measure_widget(bar, result, picked):
+    box = QtWidgets.QWidget(bar)
+    box.setObjectName("UnifiedMeasure")
+    lay = QtWidgets.QHBoxLayout(box)
+    lay.setContentsMargins(4, 0, 4, 0)
+    lay.setSpacing(0)
+    tip = translate(CTX, "Click to copy the number")
+    for i, item in enumerate(result.items):
+        b = QtWidgets.QToolButton(box)
+        b.setObjectName("UnifiedMeasureValue")
+        b.setAutoRaise(True)
+        b.setText(item_text(item))
+        b.setToolTip(tip)
+        b.setProperty("unifiedValue", item.number())
+        font = b.font()
+        if result.single:
+            font.setPointSizeF(font.pointSizeF() * 0.9)
+            pal = b.palette()
+            pal.setColor(QtGui.QPalette.ButtonText, pal.color(QtGui.QPalette.Disabled, QtGui.QPalette.ButtonText))
+            b.setPalette(pal)
+        elif i == 0:
+            font.setBold(True)
+        b.setFont(font)
+        b.clicked.connect(lambda checked=False, it=item: copy(it))
+        lay.addWidget(b)
+    if result.keep is not None:
+        k = QtWidgets.QToolButton(box)
+        k.setObjectName("UnifiedMeasureKeep")
+        k.setAutoRaise(True)
+        k.setText(translate(CTX, "Keep the dimension"))
+        k.setToolTip(translate(CTX, "Leaves this measurement in the model, as a dimension that stays."))
+        font = k.font()
+        font.setPointSizeF(font.pointSizeF() * 0.85)
+        k.setFont(font)
+        k.clicked.connect(lambda checked=False, r=result, p=picked, b=k: keep(r, p, b))
+        lay.addWidget(k)
+    line = QtWidgets.QFrame(box)
+    line.setFrameShape(QtWidgets.QFrame.VLine)
+    line.setFrameShadow(QtWidgets.QFrame.Sunken)
+    lay.addSpacing(4)
+    lay.addWidget(line)
+    return box
+
+
+def decorate():
+    """The bar was built (hidden): put the measurement on its left, hook up the previews"""
+    mw = Gui.getMainWindow()
+    bar = mw.findChild(QtWidgets.QFrame, "UnifiedContextBar")
+    if bar is None:
+        return
+    layout = bar.layout()
+    try:
+        result, picked = current()
+    except Exception as e:
+        App.Console.PrintLog("Measure on the bar: {}\n".format(e))
+        result, picked = M.Result(), []
+    if result:
+        layout.insertWidget(0, _measure_widget(bar, result, picked))
+        # The numbers are there: "Measure" / "Distance" would only say them again
+        for b in bar.findChildren(QtWidgets.QToolButton):
+            if b.property("unifiedCommand") == "Std_Measure":
+                b.hide()
+    try:
+        import ToolPreviewGui
+
+        ToolPreviewGui.watch_buttons(bar)
+    except Exception as e:
+        App.Console.PrintLog("Preview on the bar: {}\n".format(e))
diff --git a/src/Mod/Unified/MeasureMath.py b/src/Mod/Unified/MeasureMath.py
new file mode 100644
index 000000000..2ba8270e7
--- /dev/null
+++ b/src/Mod/Unified/MeasureMath.py
@@ -0,0 +1,416 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""What is measured right away when one or two things are picked (自動で測る).
+
+The bar next to a pick shows the numbers without pressing "Measure": two points give their
+distance and ΔX/ΔY/ΔZ, a point and a face or edge the distance, two edges or two faces the
+gap when they are parallel and the angle when not, circles and holes their diameter and the
+distance of their centers; one edge alone its length, one face its area.
+
+No GUI here: everything in global coordinates from the picked elements (TestMeasureMath.py
+tests it headless). MeasureBarGui.py shows the result on the bar and keeps it as a Measure
+object ("寸法を残す").
+"""
+
+import math
+
+import FreeCAD as App
+
+TOL = 1e-7
+ANGLE_TOL = 1e-6  # radians: parallel / perpendicular
+
+
+def QT_TRANSLATE_NOOP(context, text):
+    return text
+
+
+T = lambda text: QT_TRANSLATE_NOOP("UnifiedMeasure", text)
+
+# The names of the values (English here, Japanese in UnifiedWording_ja.ts)
+NAMES = {
+    "distance": T("Distance"),
+    "dx": T("ΔX"),
+    "dy": T("ΔY"),
+    "dz": T("ΔZ"),
+    "gap": T("Gap"),
+    "angle": T("Angle"),
+    "length": T("Length"),
+    "area": T("Area"),
+    "diameter": T("⌀"),
+    "radius": T("R"),
+    "centers": T("Center distance"),
+}
+UNITS = {"length": "mm", "angle": "°", "area": "mm²"}
+
+
+class Item:
+    """One value: what it is ("gap"), the number and what kind of number (length, angle, area)."""
+
+    def __init__(self, key, value, kind="length"):
+        self.key = key
+        self.value = float(value)
+        self.kind = kind
+
+    @property
+    def unit(self):
+        return UNITS[self.kind]
+
+    def number(self):
+        """The number as it is copied: up to 3 decimals, no trailing zeros"""
+        return format_number(self.value, 2 if self.kind == "area" else 3)
+
+    def text(self):
+        return "{} {}".format(self.number(), self.unit) if self.kind != "angle" else self.number() + "°"
+
+    def __repr__(self):
+        return "Item({}, {:.6g} {})".format(self.key, self.value, self.unit)
+
+
+class Keep:
+    """How to keep the measurement as a Measure object.
+
+    kind: "distance" / "angle" (two picks), "length" / "area" / "diameter" / "radius" (one),
+    "points" (a distance between two points that were worked out, e.g. the gap of two parallel
+    faces or the centers of two holes; a Measure::MeasureDistanceDetached).
+    """
+
+    def __init__(self, kind, picks=(), points=None):
+        self.kind = kind
+        self.picks = tuple(picks)
+        self.points = points
+
+    def __repr__(self):
+        return "Keep({}, {})".format(self.kind, self.picks)
+
+
+class Result:
+    def __init__(self, items=(), keep=None, single=False):
+        self.items = list(items)
+        self.keep = keep
+        # One pick: a small hint (length, area), not the main thing of the bar
+        self.single = single
+
+    def __bool__(self):
+        return bool(self.items)
+
+    def get(self, key):
+        for item in self.items:
+            if item.key == key:
+                return item
+        return None
+
+    def __repr__(self):
+        return "Result({})".format(self.items)
+
+
+def format_number(value, decimals=3):
+    text = "{:.{}f}".format(value, decimals)
+    if "." in text:
+        text = text.rstrip("0").rstrip(".")
+    return "0" if text in ("-0", "") else text
+
+
+# --- what a picked element is -------------------------------------------------------------
+
+
+class Element:
+    """A picked vertex, edge or face (global coordinates) and what it is geometrically.
+
+    kind: "point", "line", "circle", "curve", "plane", "cylinder", "surface".
+    For lines and planes: origin and direction (the normal of a plane). For circles and
+    cylinders: center, axis and radius.
+    """
+
+    def __init__(self, shape):
+        import Part
+
+        self.shape = shape
+        self.kind = None
+        self.origin = None
+        self.direction = None
+        self.radius = None
+        if isinstance(shape, Part.Vertex) or shape.ShapeType == "Vertex":
+            self.kind = "point"
+            self.origin = App.Vector(shape.Point)
+        elif shape.ShapeType == "Edge":
+            curve = shape.Curve
+            if isinstance(curve, (Part.Line, Part.LineSegment)):
+                self.kind = "line"
+                a, b = shape.Vertexes[0].Point, shape.Vertexes[-1].Point
+                self.origin = App.Vector(a)
+                self.direction = _unit(b - a) if (b - a).Length > TOL else _unit(curve.Direction)
+            elif isinstance(curve, (Part.Circle, Part.ArcOfCircle)):
+                self.kind = "circle"
+                self.origin = App.Vector(curve.Center)
+                self.direction = _unit(curve.Axis)
+                self.radius = curve.Radius
+            else:
+                self.kind = "curve"
+        elif shape.ShapeType == "Face":
+            surface = shape.Surface
+            if isinstance(surface, Part.Plane):
+                self.kind = "plane"
+                u0, u1, v0, v1 = shape.ParameterRange
+                self.direction = _unit(shape.normalAt((u0 + u1) / 2, (v0 + v1) / 2))
+                self.origin = App.Vector(shape.CenterOfMass) if shape.Area > TOL else App.Vector(surface.Position)
+            elif isinstance(surface, Part.Cylinder):
+                self.kind = "cylinder"
+                self.direction = _unit(surface.Axis)
+                self.radius = surface.Radius
+                # The center: on the axis, in the middle of the face's extent along it
+                base = App.Vector(surface.Center)
+                mid = App.Vector(shape.CenterOfMass) if shape.Area > TOL else base
+                self.origin = base + self.direction * (mid - base).dot(self.direction)
+            else:
+                self.kind = "surface"
+        else:
+            self.kind = "other"
+
+    @property
+    def round(self):
+        return self.kind in ("circle", "cylinder")
+
+
+def _unit(v):
+    v = App.Vector(v)
+    if v.Length > TOL:
+        v.normalize()
+    return v
+
+
+def _parallel(a, b):
+    return a.cross(b).Length < ANGLE_TOL
+
+
+def _acute_angle(a, b):
+    """Angle between two directions without sign, 0..90 degrees"""
+    c = min(1.0, abs(a.dot(b)))
+    return math.degrees(math.acos(c))
+
+
+def _line_point_distance(origin, direction, point):
+    d = point - origin
+    return (d - direction * d.dot(direction)).Length
+
+
+def _min_distance(a, b):
+    try:
+        dist, pairs, _ = a.shape.distToShape(b.shape)
+        return dist, (App.Vector(pairs[0][0]), App.Vector(pairs[0][1])) if pairs else None
+    except Exception:
+        return None, None
+
+
+# --- measuring ----------------------------------------------------------------------------
+
+
+def measure_one(e, pick=0):
+    if e.kind == "line" or e.kind == "curve":
+        return Result([Item("length", e.shape.Length)], Keep("length", [pick]), single=True)
+    if e.kind == "circle":
+        items = [Item("diameter", 2 * e.radius), Item("radius", e.radius)]
+        return Result(items, Keep("diameter", [pick]), single=True)
+    if e.kind == "cylinder":
+        items = [Item("diameter", 2 * e.radius), Item("radius", e.radius)]
+        return Result(items, Keep("diameter", [pick]), single=True)
+    if e.kind in ("plane", "surface"):
+        return Result([Item("area", e.shape.Area, "area")], Keep("area", [pick]), single=True)
+    return Result()
+
+
+def measure_two(a, b):
+    # Point and point
+    if a.kind == "point" and b.kind == "point":
+        d = b.origin - a.origin
+        items = [
+            Item("distance", d.Length),
+            Item("dx", abs(d.x)),
+            Item("dy", abs(d.y)),
+            Item("dz", abs(d.z)),
+        ]
+        return Result(items, Keep("distance", [0, 1]))
+    # A point and something else: the point first
+    if b.kind == "point":
+        r = measure_two(b, a)
+        if r.keep is not None:
+            r.keep.picks = tuple(1 - i for i in r.keep.picks)
+        return r
+    if a.kind == "point":
+        p = a.origin
+        if b.kind == "plane":
+            dist = abs((p - b.origin).dot(b.direction))
+            foot = p - b.direction * (p - b.origin).dot(b.direction)
+            return Result([Item("distance", dist)], Keep("points", [0, 1], (p, foot)))
+        if b.kind == "line":
+            dist = _line_point_distance(b.origin, b.direction, p)
+            foot = b.origin + b.direction * (p - b.origin).dot(b.direction)
+            return Result([Item("distance", dist)], Keep("points", [0, 1], (p, foot)))
+        if b.round:
+            # A point and a hole: the distance to its center (axis) and to its rim/wall
+            items = [Item("centers", _line_point_distance(b.origin, b.direction, p))]
+            foot = b.origin + b.direction * (p - b.origin).dot(b.direction)
+            items.append(Item("diameter", 2 * b.radius))
+            return Result(items, Keep("points", [0, 1], (p, foot)))
+        dist, pts = _min_distance(a, b)
+        if dist is None:
+            return Result()
+        return Result([Item("distance", dist)], Keep("distance", [0, 1]))
+
+    # Two circles or holes: the distance of their centers (of their axes when parallel)
+    if a.round and b.round:
+        if _parallel(a.direction, b.direction) and a.kind == "cylinder" and b.kind == "cylinder":
+            dist = _line_point_distance(a.origin, a.direction, b.origin)
+            foot = a.origin + a.direction * (b.origin - a.origin).dot(a.direction)
+            pts = (foot, App.Vector(b.origin))
+        elif _parallel(a.direction, b.direction) and (a.kind == "cylinder" or b.kind == "cylinder"):
+            # A circle and a hole: the circle's center to the hole's axis
+            cyl, circ = (a, b) if a.kind == "cylinder" else (b, a)
+            dist = _line_point_distance(cyl.origin, cyl.direction, circ.origin)
+            foot = cyl.origin + cyl.direction * (circ.origin - cyl.origin).dot(cyl.direction)
+            pts = (foot, App.Vector(circ.origin)) if cyl is a else (App.Vector(circ.origin), foot)
+        else:
+            dist = (b.origin - a.origin).Length
+            pts = (App.Vector(a.origin), App.Vector(b.origin))
+        items = [Item("centers", dist)]
+        if abs(a.radius - b.radius) < 1e-6:
+            items.append(Item("diameter", 2 * a.radius))
+        else:
+            items.append(Item("diameter", 2 * a.radius))
+            items.append(Item("diameter", 2 * b.radius))
+        return Result(items, Keep("points", [0, 1], pts))
+
+    # Lines and planes: parallel → the gap between them, otherwise the angle
+    flat = ("line", "plane")
+    if a.kind in flat and b.kind in flat:
+        if a.kind == "line" and b.kind == "line":
+            same = _parallel(a.direction, b.direction)
+            angle = 0.0 if same else _acute_angle(a.direction, b.direction)
+        elif a.kind == "plane" and b.kind == "plane":
+            same = _parallel(a.direction, b.direction)
+            angle = 0.0 if same else _acute_angle(a.direction, b.direction)
+        else:
+            line, plane = (a, b) if a.kind == "line" else (b, a)
+            same = abs(line.direction.dot(plane.direction)) < ANGLE_TOL
+            angle = 0.0 if same else 90.0 - _acute_angle(line.direction, plane.direction)
+        if same:
+            if a.kind == "plane" or b.kind == "plane":
+                plane = a if a.kind == "plane" else b
+                other = b if plane is a else a
+                gap = abs((other.origin - plane.origin).dot(plane.direction))
+                foot = other.origin - plane.direction * (other.origin - plane.origin).dot(plane.direction)
+                pts = (foot, App.Vector(other.origin)) if plane is a else (App.Vector(other.origin), foot)
+            else:
+                gap = _line_point_distance(a.origin, a.direction, b.origin)
+                mid = (b.shape.Vertexes[0].Point + b.shape.Vertexes[-1].Point) * 0.5
+                foot = a.origin + a.direction * (mid - a.origin).dot(a.direction)
+                pts = (foot, mid)
+            return Result([Item("gap", gap)], Keep("points", [0, 1], pts))
+        items = [Item("angle", angle, "angle")]
+        dist, _ = _min_distance(a, b)
+        if dist is not None and dist > 1e-6:
+            items.append(Item("distance", dist))
+        return Result(items, Keep("angle", [0, 1]))
+
+    # Anything else: the shortest distance
+    dist, pts = _min_distance(a, b)
+    if dist is None:
+        return Result()
+    return Result([Item("distance", dist)], Keep("distance", [0, 1]))
+
+
+def measure_shapes(shapes):
+    """Measure one or two picked elements (Part shapes in global coordinates)."""
+    if not shapes or len(shapes) > 2 or any(s is None or s.isNull() for s in shapes):
+        return Result()
+    try:
+        elements = [Element(s) for s in shapes]
+    except Exception:
+        return Result()
+    if any(e.kind in (None, "other") for e in elements):
+        return Result()
+    try:
+        if len(elements) == 1:
+            return measure_one(elements[0])
+        return measure_two(elements[0], elements[1])
+    except Exception as e:  # never break the bar because of a measurement
+        App.Console.PrintLog("Measure: {}\n".format(e))
+        return Result()
+
+
+def element_shape(root, sub):
+    """The picked element in global coordinates, or None (a whole object, not a vertex/edge/face)."""
+    element = sub.split(".")[-1] if sub else ""
+    if not element.startswith(("Vertex", "Edge", "Face")):
+        return None
+    try:
+        shape = root.getSubObject(sub)
+    except Exception:
+        return None
+    if shape is None or not hasattr(shape, "isNull") or shape.isNull():
+        return None
+    return shape
+
+
+def measure_picks(picks):
+    """picks: [(root object, sub name "Body.Pad.Face3")] as Gui.Selection.getSelectionEx("", 0)
+    gives them. Only vertices, edges and faces are measured."""
+    if not picks or len(picks) > 2:
+        return Result()
+    shapes = [element_shape(root, sub) for root, sub in picks]
+    if any(s is None for s in shapes):
+        return Result()
+    return measure_shapes(shapes)
+
+
+# --- keeping it --------------------------------------------------------------------------
+
+
+def keep(result, picks, doc=None):
+    """Make a Measure object for the result (one undo step). Returns the new object or None."""
+    k = result.keep if result else None
+    if k is None:
+        return None
+    doc = doc or picks[0][0].Document
+    try:
+        import Measure  # noqa: F401  (registers the Measure types)
+    except Exception:
+        pass
+    ref = lambda i: (picks[i][0], [picks[i][1]])
+    types = {
+        "distance": "Measure::MeasureDistance",
+        "angle": "Measure::MeasureAngle",
+        "length": "Measure::MeasureLength",
+        "area": "Measure::MeasureArea",
+        "diameter": "Measure::MeasureDiameter",
+        "radius": "Measure::MeasureRadius",
+        "points": "Measure::MeasureDistanceDetached",
+    }
+    doc.openTransaction(App.Qt.translate("UnifiedMeasure", "Keep the dimension"))
+    try:
+        obj = doc.addObject(types[k.kind], "Measure")
+        if k.kind in ("distance", "angle"):
+            obj.Element1 = ref(k.picks[0])
+            obj.Element2 = ref(k.picks[1])
+        elif k.kind in ("length", "area"):
+            obj.Elements = [ref(k.picks[0])]
+        elif k.kind in ("diameter", "radius"):
+            obj.Element = ref(k.picks[0])
+        elif k.kind == "points":
+            obj.Position1, obj.Position2 = k.points
+        first = result.items[0]
+        obj.Label = "{} {}".format(App.Qt.translate("UnifiedMeasure", NAMES[first.key]), first.text())
+        group = doc.getObject("Measurements")
+        if group is None or not group.isDerivedFrom("App::DocumentObjectGroup"):
+            try:
+                group = doc.addObject(
+                    "App::DocumentObjectGroup", "Measurements", viewType="MeasureGui::ViewProviderMeasureGroup"
+                )
+            except Exception:
+                group = doc.addObject("App::DocumentObjectGroup", "Measurements")
+            group.Label = App.Qt.translate("UnifiedMeasure", "Measurements")
+        group.addObject(obj)
+        doc.recompute()
+    except Exception:
+        doc.abortTransaction()
+        raise
+    doc.commitTransaction()
+    return obj
