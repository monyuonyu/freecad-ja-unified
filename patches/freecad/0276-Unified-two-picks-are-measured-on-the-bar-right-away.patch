+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""Tests of what is measured right away for one or two picks (MeasureMath.py). Without the GUI:
+
+    FreeCADCmd -t TestMeasureMath
+"""
+
+import math
+import unittest
+
+import FreeCAD as App
+import Part
+
+import MeasureMath as M
+
+V = App.Vector
+
+
+def face_with_normal(shape, normal):
+    for i, f in enumerate(shape.Faces, start=1):
+        if isinstance(f.Surface, Part.Plane):
+            u0, u1, v0, v1 = f.ParameterRange
+            n = f.normalAt((u0 + u1) / 2, (v0 + v1) / 2)
+            if n.sub(normal).Length < 1e-6:
+                return "Face%d" % i
+    raise AssertionError("no face with normal %s" % normal)
+
+
+def cylinder_faces(shape):
+    return ["Face%d" % i for i, f in enumerate(shape.Faces, start=1) if isinstance(f.Surface, Part.Cylinder)]
+
+
+def vertex_at(shape, point):
+    for i, v in enumerate(shape.Vertexes, start=1):
+        if v.Point.sub(point).Length < 1e-6:
+            return "Vertex%d" % i
+    raise AssertionError("no vertex at %s" % point)
+
+
+class TestMeasureMath(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.doc = doc = App.newDocument("MeasureMathTest")
+        # A plate 80 x 50 x 5 with two holes ⌀6 at x=10 and x=70
+        plate = Part.makeBox(80, 50, 5)
+        for x in (10, 70):
+            plate = plate.cut(Part.makeCylinder(3, 5, V(x, 25, 0)))
+        cls.plate = doc.addObject("Part::Feature", "Plate")
+        cls.plate.Shape = plate
+        # A second box, 20 above the plate, turned 30° about Z
+        cls.lid = doc.addObject("Part::Box", "Lid")
+        cls.lid.Length, cls.lid.Width, cls.lid.Height = 10, 10, 2
+        cls.lid.Placement = App.Placement(V(0, 0, 25), App.Rotation(V(0, 0, 1), 30))
+        # Nested: a box in a part that is moved and turned 90° about X
+        cls.part = doc.addObject("App::Part", "Assembly")
+        cls.inner = doc.addObject("Part::Box", "Inner")
+        cls.inner.Length, cls.inner.Width, cls.inner.Height = 10, 20, 30
+        cls.inner.Placement = App.Placement(V(5, 0, 0), App.Rotation())
+        cls.part.addObject(cls.inner)
+        cls.part.Placement = App.Placement(V(100, 0, 0), App.Rotation(V(1, 0, 0), 90))
+        # A wedge-like solid with two faces at 45°
+        prism = Part.Face(Part.makePolygon([V(0, 0, 0), V(10, 0, 0), V(0, 10, 0), V(0, 0, 0)])).extrude(V(0, 0, 4))
+        cls.wedge = doc.addObject("Part::Feature", "Wedge")
+        cls.wedge.Shape = prism
+        cls.wedge.Placement = App.Placement(V(0, -50, 0), App.Rotation())
+        doc.recompute()
+
+    @classmethod
+    def tearDownClass(cls):
+        App.closeDocument(cls.doc.Name)
+
+    def measure(self, *picks):
+        return M.measure_picks(list(picks))
+
+    # --- one pick
+    def test_one_edge_length_and_face_area(self):
+        top = face_with_normal(self.plate.Shape, V(0, 0, 1))
+        r = self.measure((self.plate, top))
+        self.assertTrue(r.single)
+        self.assertAlmostEqual(r.get("area").value, 80 * 50 - 2 * math.pi * 9, places=6)
+        edge = next(
+            "Edge%d" % i
+            for i, e in enumerate(self.plate.Shape.Edges, 1)
+            if isinstance(e.Curve, Part.Line) and abs(e.Length - 80) < 1e-9
+        )
+        self.assertAlmostEqual(self.measure((self.plate, edge)).get("length").value, 80)
+
+    def test_one_circle_and_hole(self):
+        hole = cylinder_faces(self.plate.Shape)[0]
+        r = self.measure((self.plate, hole))
+        self.assertAlmostEqual(r.get("diameter").value, 6)
+        self.assertAlmostEqual(r.get("radius").value, 3)
+        circle = next(
+            "Edge%d" % i for i, e in enumerate(self.plate.Shape.Edges, 1) if isinstance(e.Curve, Part.Circle)
+        )
+        self.assertAlmostEqual(self.measure((self.plate, circle)).get("diameter").value, 6)
+
+    def test_vertex_alone_measures_nothing(self):
+        self.assertFalse(self.measure((self.plate, "Vertex1")))
+
+    def test_whole_object_measures_nothing(self):
+        self.assertFalse(self.measure((self.plate, "")))
+        self.assertFalse(self.measure((self.plate, "Face1"), (self.lid, "")))
+
+    # --- two picks
+    def test_point_point(self):
+        a = vertex_at(self.plate.Shape, V(0, 0, 0))
+        b = vertex_at(self.plate.Shape, V(80, 50, 5))
+        r = self.measure((self.plate, a), (self.plate, b))
+        self.assertAlmostEqual(r.get("distance").value, math.sqrt(80**2 + 50**2 + 25))
+        self.assertAlmostEqual(r.get("dx").value, 80)
+        self.assertAlmostEqual(r.get("dy").value, 50)
+        self.assertAlmostEqual(r.get("dz").value, 5)
+        self.assertEqual(r.keep.kind, "distance")
+
+    def test_parallel_planes_gap(self):
+        # The plate's top (z=5) and the lid's bottom (z=25): a gap of 20, also with the lid turned
+        top = face_with_normal(self.plate.Shape, V(0, 0, 1))
+        bottom = face_with_normal(self.lid.Shape, V(0, 0, -1))
+        r = self.measure((self.plate, top), (self.lid, bottom))
+        self.assertAlmostEqual(r.get("gap").value, 20)
+        self.assertIsNone(r.get("angle"))
+        self.assertEqual(r.keep.kind, "points")
+        self.assertAlmostEqual((r.keep.points[1] - r.keep.points[0]).Length, 20)
+
+    def test_planes_at_an_angle(self):
+        # The lid is turned 30°: its side and the plate's side are at 30°
+        side = face_with_normal(self.plate.Shape, V(0, -1, 0))
+        rot = App.Rotation(V(0, 0, 1), 30)
+        lid_side = face_with_normal(self.lid.Shape, rot.multVec(V(0, -1, 0)))
+        r = self.measure((self.plate, side), (self.lid, lid_side))
+        self.assertAlmostEqual(r.get("angle").value, 30, places=6)
+        self.assertIsNone(r.get("gap"))
+        self.assertEqual(r.keep.kind, "angle")
+
+    def test_wedge_faces_45(self):
+        s = self.wedge.Shape
+        slanted = face_with_normal(s, V(1, 1, 0).normalize())
+        r = self.measure((self.wedge, face_with_normal(s, V(0, -1, 0))), (self.wedge, slanted))
+        self.assertAlmostEqual(r.get("angle").value, 45, places=6)
+
+    def test_two_holes_center_distance(self):
+        h1, h2 = cylinder_faces(self.plate.Shape)
+        r = self.measure((self.plate, h1), (self.plate, h2))
+        self.assertAlmostEqual(r.get("centers").value, 60)
+        self.assertAlmostEqual(r.get("diameter").value, 6)
+        # Their rims (circle edges on the top face) too
+        circles = [
+            "Edge%d" % i
+            for i, e in enumerate(self.plate.Shape.Edges, 1)
+            if isinstance(e.Curve, Part.Circle) and abs(e.Curve.Center.z - 5) < 1e-9
+        ]
+        self.assertEqual(len(circles), 2)
+        r = self.measure((self.plate, circles[0]), (self.plate, circles[1]))
+        self.assertAlmostEqual(r.get("centers").value, 60)
+        # The rim of one hole and the wall of the other one
+        shape = self.plate.Shape
+        rim = next(c for c in circles if abs(shape.getElement(c).Curve.Center.x - 10) < 1e-9)
+        wall = next(h for h in (h1, h2) if abs(shape.getElement(h).Surface.Center.x - 70) < 1e-9)
+        r = self.measure((self.plate, rim), (self.plate, wall))
+        self.assertAlmostEqual(r.get("centers").value, 60)
+
+    def test_point_to_face_and_edge(self):
+        top = face_with_normal(self.plate.Shape, V(0, 0, 1))
+        corner = vertex_at(self.lid.Shape, self.lid.Placement.multVec(V(0, 0, 0)))
+        r = self.measure((self.lid, corner), (self.plate, top))
+        self.assertAlmostEqual(r.get("distance").value, 20)
+        # The face first: the same
+        r2 = self.measure((self.plate, top), (self.lid, corner))
+        self.assertAlmostEqual(r2.get("distance").value, 20)
+        self.assertEqual(r2.keep.picks, (1, 0))
+        # Point to a line (the plate's edge along X at y=0, z=0): sqrt(0^2 + 25^2)
+        edge = next(
+            "Edge%d" % i
+            for i, e in enumerate(self.plate.Shape.Edges, 1)
+            if isinstance(e.Curve, Part.Line)
+            and abs(e.Length - 80) < 1e-9
+            and abs(e.Vertexes[0].Point.y) < 1e-9
+            and abs(e.Vertexes[0].Point.z) < 1e-9
+        )
+        r = self.measure((self.lid, corner), (self.plate, edge))
+        self.assertAlmostEqual(r.get("distance").value, 25)
+
+    def test_edges_parallel_gap_and_angle(self):
+        s = self.plate.Shape
+        lines = [
+            (i, e)
+            for i, e in enumerate(s.Edges, 1)
+            if isinstance(e.Curve, Part.Line) and abs(e.Length - 80) < 1e-9 and abs(e.Vertexes[0].Point.z) < 1e-9
+        ]
+        (i1, _), (i2, _) = lines[:2]
+        r = self.measure((self.plate, "Edge%d" % i1), (self.plate, "Edge%d" % i2))
+        self.assertAlmostEqual(r.get("gap").value, 50)
+        # An edge of the turned lid against an edge of the plate: 30°, 20 apart in Z at least
+        lid_edges = [
+            "Edge%d" % i
+            for i, e in enumerate(self.lid.Shape.Edges, 1)
+            if isinstance(e.Curve, Part.Line)
+            and abs((e.Vertexes[1].Point - e.Vertexes[0].Point).normalize().dot(App.Rotation(V(0, 0, 1), 30).multVec(V(1, 0, 0)))) > 0.999
+        ]
+        r = self.measure((self.plate, "Edge%d" % i1), (self.lid, lid_edges[0]))
+        self.assertAlmostEqual(r.get("angle").value, 30, places=6)
+        self.assertGreaterEqual(r.get("distance").value, 20 - 1e-6)
+
+    def test_nested_and_turned_parts(self):
+        # The inner box is in a part moved by 100 in X and turned 90° about X: its top face
+        # (local +Z, height 30) points to global -Y, at y = -30
+        root = self.part
+        top_local = face_with_normal(self.inner.Shape, V(0, 0, 1))
+        bottom_local = face_with_normal(self.inner.Shape, V(0, 0, -1))
+        r = self.measure((root, "Inner." + top_local), (root, "Inner." + bottom_local))
+        self.assertAlmostEqual(r.get("gap").value, 30)
+        shape = M.element_shape(root, "Inner." + top_local)
+        e = M.Element(shape)
+        self.assertAlmostEqual(e.direction.y, -1, places=6)
+        self.assertAlmostEqual(e.origin.y, -30, places=6)
+        # Against the plate's top (normal +Z): perpendicular
+        top = face_with_normal(self.plate.Shape, V(0, 0, 1))
+        r = self.measure((root, "Inner." + top_local), (self.plate, top))
+        self.assertAlmostEqual(r.get("angle").value, 90, places=6)
+        # Corner to corner across the nesting: the inner box's local (0,0,0) is at (105,0,0)
+        v = vertex_at(self.inner.Shape, V(5, 0, 0))
+        r = self.measure((root, "Inner." + v), (self.plate, vertex_at(self.plate.Shape, V(80, 0, 0))))
+        self.assertAlmostEqual(r.get("dx").value, 25)
+        self.assertAlmostEqual(r.get("distance").value, 25)
+
+    def test_number_format(self):
+        self.assertEqual(M.format_number(20.0), "20")
+        self.assertEqual(M.format_number(12.3456), "12.346")
+        self.assertEqual(M.format_number(-0.0001), "0")
+        self.assertEqual(M.Item("angle", 30, "angle").text(), "30°")
+        self.assertEqual(M.Item("gap", 2.5).text(), "2.5 mm")
+
+    def test_keep_makes_measure_objects(self):
+        try:
+            import Measure  # noqa: F401
+        except ImportError:
+            self.skipTest("no Measure module")
+        doc = self.doc
+        before = len(doc.Objects)
+        top = face_with_normal(self.plate.Shape, V(0, 0, 1))
+        bottom = face_with_normal(self.lid.Shape, V(0, 0, -1))
+        picks = [(self.plate, top), (self.lid, bottom)]
+        obj = M.keep(M.measure_picks(picks), picks)
+        self.assertTrue(obj.isDerivedFrom("Measure::MeasureDistanceDetached"))
+        self.assertAlmostEqual(obj.Distance.Value, 20)
+        a = vertex_at(self.plate.Shape, V(0, 0, 0))
+        b = vertex_at(self.plate.Shape, V(80, 50, 5))
+        picks = [(self.plate, a), (self.plate, b)]
+        obj = M.keep(M.measure_picks(picks), picks)
+        self.assertTrue(obj.isDerivedFrom("Measure::MeasureDistance"))
+        self.assertAlmostEqual(obj.Distance.Value, math.sqrt(80**2 + 50**2 + 25), places=6)
+        hole = cylinder_faces(self.plate.Shape)[0]
+        obj = M.keep(M.measure_picks([(self.plate, hole)]), [(self.plate, hole)])
+        self.assertAlmostEqual(obj.Diameter.Value, 6)
+        self.assertIn(obj, doc.getObject("Measurements").Group)
+        self.assertEqual(len(doc.Objects), before + 4)  # 3 measures + the group
+
+
+if __name__ == "__main__":
+    unittest.main()
