+++ b/src/Mod/Unified/ToolPreview.py
@@ -0,0 +1,500 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""What a tool would do, before it is pressed (ツールの下見).
+
+Hovering a tool of the tool strip or of the bar next to a pick shows a see-through ghost of
+its result on what is picked: the corner a fillet takes off, the block an extrusion adds, the
+hole, the mirrored or repeated feature. The ghost is made from copies of the shapes; the
+document is never touched (no new object, no transaction, nothing recomputed).
+
+No GUI here (TestToolPreview.py tests it headless): prepare() reads what it needs from the
+document right away, the shapes are worked out in a thread (Job), and ToolPreviewGui.py draws
+them over the 3D view. A job can be cancelled (the mouse left the button) and gives up after a
+second (then only the tooltip is shown).
+"""
+
+import math
+import threading
+import time
+
+import FreeCAD as App
+
+TOL = 1e-7
+
+# What a ghost shape is: material added (green), material taken away (red), a whole new
+# copy of a shape (blue)
+ADD, REMOVE, COPY = "add", "remove", "copy"
+
+# The tools that have a preview, with their default number (the bar's number field, or the
+# last number used with the tool, wins)
+DEFAULTS = {
+    "PartDesign_Fillet": 2.0,
+    "PartDesign_Chamfer": 1.0,
+    "PartDesign_Pad": 10.0,
+    "PartDesign_Pocket": 10.0,
+    "Unified_Hole": 6.0,
+    "PartDesign_Mirrored": None,
+    "PartDesign_LinearPattern": None,
+    "PartDesign_PolarPattern": None,
+    "Part_Mirror": None,
+}
+HOLE_DEPTH = 25.0  # PartDesign's hole: "Dimension", 25 mm
+
+
+class NoPreview(Exception):
+    """The tool has nothing to show for what is picked."""
+
+
+class Pick:
+    """One pick: the top-level object, the path to the element ("Body.Pad.Face3") and the
+    point where it was clicked (global), as Gui.Selection.getSelectionEx("", 0) gives them."""
+
+    def __init__(self, root, sub="", point=None):
+        self.root = root
+        self.sub = sub or ""
+        self.point = App.Vector(point) if point is not None else None
+
+    @property
+    def element(self):
+        return self.sub.split(".")[-1]
+
+    @property
+    def path(self):
+        """The path of the object that owns the element: "Body.Pad." for "Body.Pad.Face3" """
+        return self.sub[: self.sub.rfind(".") + 1] if "." in self.sub else ""
+
+    def owner(self):
+        objs = self.root.getSubObjectList(self.sub) if self.sub else None
+        return list(objs)[-1] if objs else self.root
+
+    def owner_shape(self):
+        """The shape of the object that owns the element, in global coordinates (a copy)"""
+        import Part
+
+        shape = Part.getShape(self.root, self.path, transform=True)
+        if shape.isNull():
+            raise NoPreview()
+        return shape.copy()
+
+    def element_shape(self):
+        if not self.element:
+            return None
+        shape = self.root.getSubObject(self.sub)
+        return None if shape is None or shape.isNull() else shape.copy()
+
+
+def _number(command, value):
+    if value in (None, ""):
+        return DEFAULTS.get(command)
+    if isinstance(value, (int, float)):
+        return float(value)
+    try:
+        text = str(value).strip()
+        q = App.Units.Quantity(text if any(c.isalpha() for c in text) else text + " mm")
+        return float(q.Value)
+    except Exception:
+        return DEFAULTS.get(command)
+
+
+def _global_placement(obj):
+    try:
+        return obj.getGlobalPlacement()
+    except Exception:
+        return obj.Placement
+
+
+def _body_of(obj):
+    if obj.isDerivedFrom("PartDesign::Body"):
+        return obj
+    try:
+        parent = obj.getParentGeoFeatureGroup()
+    except Exception:
+        parent = None
+    return parent if parent is not None and parent.isDerivedFrom("PartDesign::Body") else None
+
+
+def _profile_sketch(feature):
+    profile = getattr(feature, "Profile", None)
+    obj = profile[0] if isinstance(profile, tuple) and profile else profile
+    return obj if obj is not None and obj.isDerivedFrom("Part::Part2DObject") else None
+
+
+def _face_normal(face):
+    u0, u1, v0, v1 = face.ParameterRange
+    n = face.normalAt((u0 + u1) / 2, (v0 + v1) / 2)
+    n.normalize()
+    return n
+
+
+# --- reading what is picked (main thread) -------------------------------------------------
+# Each prepare_* reads the document and returns a function that works on copies only: it can
+# run in another thread.
+
+
+def _edges_by_solid(picks):
+    """Picked edges (and the edges of picked faces), grouped by the solid they belong to"""
+    groups = {}
+    for p in picks:
+        if not p.element.startswith(("Edge", "Face")):
+            continue
+        key = (p.root.Name, p.path)
+        if key not in groups:
+            groups[key] = [p.owner_shape(), []]
+        solid, names = groups[key]
+        if p.element not in names:
+            names.append(p.element)
+    if not groups:
+        raise NoPreview()
+    out = []
+    for solid, names in groups.values():
+        edges = []
+        for name in names:
+            sub = solid.getElement(name)
+            for e in sub.Edges if name.startswith("Face") else [sub]:
+                if not any(e.isSame(x) for x in edges):
+                    edges.append(e)
+        if not solid.Solids:
+            raise NoPreview()
+        out.append((solid, edges))
+    return out
+
+
+def prepare_dressup(command, picks, value):
+    size = _number(command, value)
+    if not size or size <= 0:
+        raise NoPreview()
+    groups = _edges_by_solid(picks)
+
+    def compute(check):
+        result = []
+        for solid, edges in groups:
+            check()
+            if command == "PartDesign_Fillet":
+                done = solid.makeFillet(size, edges)
+            else:
+                done = solid.makeChamfer(size, edges)
+            check()
+            removed = solid.cut(done)
+            result.append((removed if removed.Volume > TOL else done, REMOVE))
+        return result
+
+    return compute
+
+
+def _profile_faces(pick):
+    """The faces to extrude for a pick: a picked flat face, or the closed outline of a sketch;
+    with the direction of extrusion (the outward normal / the sketch's normal)"""
+    import Part
+
+    if pick.element.startswith("Face"):
+        face = pick.element_shape()
+        if face is None or not isinstance(face.Surface, Part.Plane):
+            raise NoPreview()
+        return [face], _face_normal(face)
+    obj = pick.owner()
+    if pick.element or not obj.isDerivedFrom("Part::Part2DObject"):
+        raise NoPreview()
+    shape = pick.owner_shape()
+    wires = [w for w in shape.Wires if w.isClosed()]
+    if not wires:
+        raise NoPreview()
+    face = Part.makeFace(wires, "Part::FaceMakerBullseye")
+    # The sketch's normal: the shape carries the placements of the sketch and its containers
+    normal = shape.Placement.Rotation.multVec(App.Vector(0, 0, 1))
+    normal.normalize()
+    return face.Faces, normal
+
+
+def prepare_extrude(command, picks, value):
+    if len(picks) != 1:
+        raise NoPreview()
+    length = _number(command, value)
+    if not length or length <= 0:
+        raise NoPreview()
+    faces, normal = _profile_faces(picks[0])
+    pocket = command == "PartDesign_Pocket"
+    vector = normal * (-length if pocket else length)
+
+    def compute(check):
+        out = []
+        for f in faces:
+            check()
+            out.append((f.extrude(vector), REMOVE if pocket else ADD))
+        return out
+
+    return compute
+
+
+def prepare_hole(command, picks, value):
+    import Part
+
+    if len(picks) != 1 or not picks[0].element.startswith("Face") or picks[0].point is None:
+        raise NoPreview()
+    face = picks[0].element_shape()
+    if face is None or not isinstance(face.Surface, Part.Plane):
+        raise NoPreview()
+    diameter = _number(command, value)
+    normal = _face_normal(face)
+    point = picks[0].point
+    solid = picks[0].owner_shape()
+
+    def compute(check):
+        cyl = Part.makeCylinder(diameter / 2, HOLE_DEPTH, point, -normal)
+        check()
+        if solid.Solids:
+            cut = solid.common(cyl)
+            if cut.Volume > TOL:
+                return [(cut, REMOVE)]
+        return [(cyl, REMOVE)]
+
+    return compute
+
+
+def _feature_of(pick):
+    """The PartDesign feature a pick stands for: the picked feature, the one that owns the
+    picked element, or the body's last one"""
+    obj = pick.owner()
+    if obj.isDerivedFrom("PartDesign::Body"):
+        obj = obj.Tip
+    if obj is None or not obj.isDerivedFrom("PartDesign::FeatureAddSub"):
+        raise NoPreview()
+    return obj
+
+
+def _pattern_length(shape):
+    """As PartDesign's command does: twice the size, rounded up to 1, 2 or 5 times a power of 10"""
+    box = shape.BoundBox
+    size = max(box.XLength, box.YLength, box.ZLength)
+    if size <= 1e-7:
+        return 100.0
+    wanted = 2.0 * size
+    power = 10.0 ** math.floor(math.log10(wanted))
+    for step in (1.0, 2.0, 5.0, 10.0):
+        if step * power >= wanted - 1e-7:
+            return step * power
+    return 10.0 * power
+
+
+def prepare_transform(command, picks, value):
+    if not picks:
+        raise NoPreview()
+    features = []
+    for p in picks:
+        f = _feature_of(p)
+        if f not in features:
+            features.append(f)
+    body = _body_of(features[0])
+    if body is None:
+        raise NoPreview()
+    body_place = _global_placement(body)
+    tools = []
+    for f in features:
+        tool = f.AddSubShape.copy()
+        if tool.isNull():
+            raise NoPreview()
+        local_box = tool.BoundBox
+        tool.transformShape(body_place.toMatrix())
+        role = REMOVE if getattr(f, "AddSubType", "Additive") == "Subtractive" else ADD
+        tools.append((tool, role, local_box))
+    sketch = _profile_sketch(features[0])
+    sketch_place = _global_placement(sketch) if sketch is not None else None
+    if sketch_place is not None:
+        origin = sketch_place.Base
+        x_axis = sketch_place.Rotation.multVec(App.Vector(1, 0, 0))
+        normal = sketch_place.Rotation.multVec(App.Vector(0, 0, 1))
+    else:
+        origin = body_place.Base
+        x_axis = body_place.Rotation.multVec(App.Vector(1, 0, 0))
+        normal = body_place.Rotation.multVec(App.Vector(0, 0, 1))
+
+    if command == "PartDesign_Mirrored":
+        # Through the sketch's vertical axis (the plane of V and the normal), else the XY plane
+        plane_normal = x_axis if sketch_place is not None else normal
+
+        def move(shape):
+            return shape.mirror(origin, plane_normal)
+
+    elif command == "PartDesign_LinearPattern":
+        # Along the sketch's horizontal axis (else X), 2 times, twice the size apart
+        length = _pattern_length(_union_box(t[2] for t in tools))
+
+        def move(shape):
+            s = shape.copy()
+            s.translate(x_axis * length)
+            return s
+
+    elif command == "PartDesign_PolarPattern":
+        # Around the sketch's normal (else Z), 2 times over 360°
+
+        def move(shape):
+            s = shape.copy()
+            s.rotate(origin, normal, 180)
+            return s
+
+    else:
+        raise NoPreview()
+
+    def compute(check):
+        out = []
+        for tool, role, _ in tools:
+            check()
+            out.append((move(tool), role))
+        return out
+
+    return compute
+
+
+def _union_box(boxes):
+    total = None
+    for b in boxes:
+        if total is None:
+            total = App.BoundBox(b)
+        else:
+            total.add(b)
+    import Part
+
+    if total is None:
+        return Part.Shape()
+    return Part.makeBox(max(total.XLength, 1e-6), max(total.YLength, 1e-6), max(total.ZLength, 1e-6))
+
+
+def prepare_part_mirror(command, picks, value):
+    """Part's mirror: a copy of the whole shape in the XY plane through the origin"""
+    shapes = []
+    for p in picks:
+        if p.element:
+            raise NoPreview()
+        shape = p.owner_shape()
+        if shape.isNull() or not shape.Solids and not shape.Faces:
+            raise NoPreview()
+        shapes.append(shape)
+    if not shapes:
+        raise NoPreview()
+
+    def compute(check):
+        out = []
+        for s in shapes:
+            check()
+            out.append((s.mirror(App.Vector(0, 0, 0), App.Vector(0, 0, 1)), COPY))
+        return out
+
+    return compute
+
+
+PREPARE = {
+    "PartDesign_Fillet": prepare_dressup,
+    "PartDesign_Chamfer": prepare_dressup,
+    "PartDesign_Pad": prepare_extrude,
+    "PartDesign_Pocket": prepare_extrude,
+    "Unified_Hole": prepare_hole,
+    "PartDesign_Mirrored": prepare_transform,
+    "PartDesign_LinearPattern": prepare_transform,
+    "PartDesign_PolarPattern": prepare_transform,
+    "Part_Mirror": prepare_part_mirror,
+}
+
+
+def has_preview(command):
+    return command in PREPARE
+
+
+def prepare(command, picks, value=None):
+    """Read what the tool needs from the document now; returns compute(check) → [(shape, role)]
+    that works on copies only, or None when there is nothing to show."""
+    fn = PREPARE.get(command)
+    if fn is None or not picks:
+        return None
+    try:
+        return fn(command, list(picks), value)
+    except NoPreview:
+        return None
+    except Exception as e:
+        App.Console.PrintLog("Preview of {}: {}\n".format(command, e))
+        return None
+
+
+def build(command, picks, value=None):
+    """Prepare and compute right here (for tests and scripts): [(shape, role)] or None"""
+    compute = prepare(command, picks, value)
+    if compute is None:
+        return None
+    try:
+        out = compute(lambda: None)
+    except Exception:
+        return None
+    return [(s, r) for s, r in out if s is not None and not s.isNull()] or None
+
+
+# --- doing it in the background -----------------------------------------------------------
+
+
+class Cancelled(Exception):
+    pass
+
+
+class Job:
+    """A preview worked out in a thread.
+
+    poll() says how it goes: "pending", "done" (result has the shapes), "cancelled",
+    "slow" (it took longer than the deadline: only the tooltip is shown) or "failed".
+    A job that was cancelled or is late never hands out its result.
+    """
+
+    def __init__(self, compute, deadline=1.0):
+        self._compute = compute
+        self.deadline = deadline
+        self.state = "pending"
+        self.result = None
+        self._cancel = threading.Event()
+        self._lock = threading.Lock()
+        self._started = None
+        self._thread = None
+
+    def _check(self):
+        if self._cancel.is_set():
+            raise Cancelled()
+
+    def _run(self):
+        try:
+            out = self._compute(self._check)
+            out = [(s, r) for s, r in out if s is not None and not s.isNull()]
+            with self._lock:
+                if self.state == "pending":
+                    late = time.monotonic() - self._started > self.deadline
+                    self.state = "slow" if late else ("done" if out else "failed")
+                    self.result = out if self.state == "done" else None
+        except Cancelled:
+            with self._lock:
+                if self.state == "pending":
+                    self.state = "cancelled"
+        except Exception as e:
+            App.Console.PrintLog("Preview: {}\n".format(e))
+            with self._lock:
+                if self.state == "pending":
+                    self.state = "failed"
+
+    def start(self):
+        self._started = time.monotonic()
+        self._thread = threading.Thread(target=self._run, name="ToolPreview", daemon=True)
+        self._thread.start()
+        return self
+
+    def cancel(self):
+        self._cancel.set()
+        with self._lock:
+            if self.state == "pending":
+                self.state = "cancelled"
+            self.result = None
+
+    def poll(self):
+        with self._lock:
+            if self.state == "pending" and self._started is not None:
+                if time.monotonic() - self._started > self.deadline:
+                    # Too slow: give up (the thread ends on its own; its result is dropped)
+                    self.state = "slow"
+                    self._cancel.set()
+            return self.state
+
+    def wait(self, timeout=None):
+        if self._thread is not None:
+            self._thread.join(timeout)
+        return self.poll()
