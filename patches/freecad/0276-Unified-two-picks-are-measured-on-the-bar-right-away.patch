new file mode 100644
index 000000000..3a9545f04
--- /dev/null
+++ b/src/Mod/Unified/TestToolPreview.py
@@ -0,0 +1,236 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""Tests of the preview of a tool (ToolPreview.py): the ghosts have the right size and place,
+the document is never changed, and a job can be cancelled or gives up when slow. Without the GUI:
+
+    FreeCADCmd -t TestToolPreview
+"""
+
+import math
+import time
+import unittest
+
+import FreeCAD as App
+import Part
+import Sketcher
+
+import ToolPreview as P
+
+V = App.Vector
+
+
+def rectangle(sketch, x0, y0, x1, y1):
+    pts = [V(x0, y0, 0), V(x1, y0, 0), V(x1, y1, 0), V(x0, y1, 0)]
+    for i in range(4):
+        sketch.addGeometry(Part.LineSegment(pts[i], pts[(i + 1) % 4]))
+    for i in range(4):
+        sketch.addConstraint(Sketcher.Constraint("Coincident", i, 2, (i + 1) % 4, 1))
+
+
+def snapshot(doc):
+    """Everything a preview must not change"""
+    state = {
+        "names": [o.Name for o in doc.Objects],
+        "undo": doc.UndoCount,
+        "redo": doc.RedoCount,
+        "transacting": doc.HasPendingTransaction,
+    }
+    for o in doc.Objects:
+        state[o.Name] = (
+            tuple(o.State),
+            # (the origin's planes and axes make a new shape each time: only real shapes)
+            o.Shape.hashCode() if o.isDerivedFrom("Part::Feature") and not o.Shape.isNull() else None,
+            round(o.Shape.Volume, 9) if hasattr(o, "Shape") and o.Shape.Solids else None,
+            str(o.Placement) if hasattr(o, "Placement") else None,
+        )
+    return state
+
+
+class TestToolPreview(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.doc = doc = App.newDocument("ToolPreviewTest")
+        doc.UndoMode = 1
+        # A body, moved and turned (all previews are in global coordinates), with a plate 80x50x5
+        body = doc.addObject("PartDesign::Body", "Body")
+        body.Placement = App.Placement(V(10, 20, 30), App.Rotation(V(0, 0, 1), 90))
+        sketch = body.newObject("Sketcher::SketchObject", "Sketch")
+        sketch.AttachmentSupport = [(body.Origin.OriginFeatures[3], "")]  # XY plane
+        sketch.MapMode = "FlatFace"
+        rectangle(sketch, 0, 0, 80, 50)
+        doc.recompute()
+        pad = body.newObject("PartDesign::Pad", "Pad")
+        pad.Profile = sketch
+        pad.Length = 5
+        sketch.Visibility = False
+        doc.recompute()
+        # A second sketch on the XY plane, not used yet: the extrusion preview
+        free = body.newObject("Sketcher::SketchObject", "Free")
+        free.AttachmentSupport = [(body.Origin.OriginFeatures[3], "")]
+        free.MapMode = "FlatFace"
+        rectangle(free, 100, 0, 110, 10)
+        doc.recompute()
+        cls.body, cls.sketch, cls.pad, cls.free = body, sketch, pad, free
+        cls.box = doc.addObject("Part::Box", "Box")
+        cls.box.Placement = App.Placement(V(0, 0, 100), App.Rotation())
+        doc.recompute()
+        # Nothing to undo from building the test document itself
+        doc.clearUndos()
+
+    @classmethod
+    def tearDownClass(cls):
+        App.closeDocument(cls.doc.Name)
+
+    def setUp(self):
+        self.before = snapshot(self.doc)
+
+    def tearDown(self):
+        self.assertEqual(snapshot(self.doc), self.before, "the preview changed the document")
+
+    def face(self, normal):
+        """The pad's face with the global normal, as a pick through the body"""
+        shape = Part.getShape(self.body, "Pad.", transform=True)
+        for i, f in enumerate(shape.Faces, start=1):
+            if f.normalAt(0, 0).sub(normal).Length < 1e-6 and isinstance(f.Surface, Part.Plane):
+                return "Face%d" % i, f
+        self.fail("no face with normal %s" % normal)
+
+    def vertical_edges(self):
+        shape = Part.getShape(self.body, "Pad.", transform=True)
+        return [
+            "Edge%d" % i
+            for i, e in enumerate(shape.Edges, start=1)
+            if abs(abs((e.Vertexes[1].Point - e.Vertexes[0].Point).normalize().z) - 1) < 1e-9
+        ]
+
+    def test_fillet_takes_off_the_corners(self):
+        edges = self.vertical_edges()
+        self.assertEqual(len(edges), 4)
+        picks = [P.Pick(self.body, "Pad." + e) for e in edges]
+        out = P.build("PartDesign_Fillet", picks, "3 mm")
+        self.assertEqual(len(out), 1)
+        shape, role = out[0]
+        self.assertEqual(role, P.REMOVE)
+        # Four corners of r=3, 5 high: (r² - πr²/4) · h each
+        self.assertAlmostEqual(shape.Volume, 4 * (9 - math.pi * 9 / 4) * 5, places=4)
+        # Where the plate is: the body is moved to z=30
+        self.assertAlmostEqual(shape.BoundBox.ZMin, 30, places=6)
+
+    def test_fillet_of_a_face_uses_its_edges(self):
+        name, _ = self.face(V(0, 0, 1))
+        out = P.build("PartDesign_Fillet", [P.Pick(self.body, "Pad." + name)], 1.0)
+        self.assertGreater(out[0][0].Volume, 0)
+
+    def test_chamfer(self):
+        e = self.vertical_edges()[0]
+        out = P.build("PartDesign_Chamfer", [P.Pick(self.body, "Pad." + e)], "2")
+        self.assertAlmostEqual(out[0][0].Volume, 2 * 2 / 2 * 5, places=6)
+
+    def test_extrude_sketch_10mm(self):
+        out = P.build("PartDesign_Pad", [P.Pick(self.body, "Free.")], None)
+        shape, role = out[0]
+        self.assertEqual(role, P.ADD)
+        self.assertAlmostEqual(shape.Volume, 10 * 10 * 10, places=6)
+        # Upwards from the sketch (z = 30 .. 40), turned with the body
+        self.assertAlmostEqual(shape.BoundBox.ZMin, 30, places=6)
+        self.assertAlmostEqual(shape.BoundBox.ZMax, 40, places=6)
+        self.assertAlmostEqual(shape.BoundBox.XMax, 10, places=6)  # x' = -y + 10
+        self.assertAlmostEqual(shape.BoundBox.YMin, 120, places=6)  # y' = x + 20
+
+    def test_extrude_and_cut_a_face(self):
+        name, face = self.face(V(0, 0, 1))
+        out = P.build("PartDesign_Pad", [P.Pick(self.body, "Pad." + name)], "7 mm")
+        self.assertAlmostEqual(out[0][0].Volume, 80 * 50 * 7, places=4)
+        self.assertAlmostEqual(out[0][0].BoundBox.ZMax, 35 + 7, places=6)
+        out = P.build("PartDesign_Pocket", [P.Pick(self.body, "Pad." + name)], "2")
+        self.assertEqual(out[0][1], P.REMOVE)
+        self.assertAlmostEqual(out[0][0].BoundBox.ZMin, 33, places=6)
+
+    def test_hole_at_the_picked_point(self):
+        name, face = self.face(V(0, 0, 1))
+        point = face.CenterOfMass
+        out = P.build("Unified_Hole", [P.Pick(self.body, "Pad." + name, point)])
+        shape, role = out[0]
+        self.assertEqual(role, P.REMOVE)
+        # ⌀6 through the 5 mm plate (the 25 mm deep drill is cut to the plate)
+        self.assertAlmostEqual(shape.Volume, math.pi * 9 * 5, places=3)
+        c = shape.BoundBox.Center
+        self.assertAlmostEqual(c.x, point.x, places=6)
+        self.assertAlmostEqual(c.y, point.y, places=6)
+        # No point: nothing to show
+        self.assertIsNone(P.build("Unified_Hole", [P.Pick(self.body, "Pad." + name)]))
+
+    def test_mirror_and_patterns_of_a_feature(self):
+        pick = [P.Pick(self.body, "Pad.")]
+        pad_box = Part.getShape(self.body, "Pad.", transform=True).BoundBox
+        # Mirrored through the sketch's vertical axis: local x → -x; global: the body turns x to y
+        shape, role = P.build("PartDesign_Mirrored", pick)[0]
+        self.assertEqual(role, P.ADD)
+        self.assertAlmostEqual(shape.Volume, 80 * 50 * 5, places=4)
+        self.assertAlmostEqual(shape.BoundBox.YMax, 20, places=6)
+        self.assertAlmostEqual(shape.BoundBox.YMin, 20 - 80, places=6)
+        # Linear: along the sketch's x (global y), 200 apart (twice 80, rounded up to 200)
+        shape, _ = P.build("PartDesign_LinearPattern", pick)[0]
+        self.assertAlmostEqual(shape.BoundBox.YMin, pad_box.YMin + 200, places=6)
+        # Polar: half a turn about the sketch's normal through its origin
+        shape, _ = P.build("PartDesign_PolarPattern", pick)[0]
+        self.assertAlmostEqual(shape.BoundBox.YMax, 20, places=6)
+        self.assertAlmostEqual(shape.BoundBox.XMin, 10, places=6)
+
+    def test_part_mirror(self):
+        shape, role = P.build("Part_Mirror", [P.Pick(self.box, "")])[0]
+        self.assertEqual(role, P.COPY)
+        self.assertAlmostEqual(shape.BoundBox.ZMax, -100, places=6)
+
+    def test_nothing_to_show(self):
+        self.assertIsNone(P.build("PartDesign_Fillet", []))
+        self.assertIsNone(P.build("PartDesign_Fillet", [P.Pick(self.box, "")]))
+        self.assertIsNone(P.build("PartDesign_Pad", [P.Pick(self.box, "Edge1")]))
+        self.assertIsNone(P.build("Std_Delete", [P.Pick(self.box, "")]))
+        self.assertIsNone(P.build("PartDesign_Fillet", [P.Pick(self.box, "Edge1")], "-1"))
+
+    # --- the background job
+    def test_job_in_a_thread(self):
+        name = self.vertical_edges()[0]
+        compute = P.prepare("PartDesign_Fillet", [P.Pick(self.body, "Pad." + name)], 2)
+        job = P.Job(compute, deadline=30).start()
+        self.assertEqual(job.wait(30), "done")
+        self.assertGreater(job.result[0][0].Volume, 0)
+
+    def test_cancel(self):
+        steps = []
+
+        def slow(check):
+            for i in range(100):
+                check()
+                steps.append(i)
+                time.sleep(0.01)
+            return [(Part.makeBox(1, 1, 1), P.ADD)]
+
+        job = P.Job(slow, deadline=30).start()
+        time.sleep(0.05)
+        job.cancel()
+        self.assertEqual(job.wait(5), "cancelled")
+        self.assertIsNone(job.result)
+        self.assertLess(len(steps), 100)  # it stopped at the next check
+
+    def test_slow_gives_up(self):
+        def slow(check):
+            time.sleep(0.3)
+            return [(Part.makeBox(1, 1, 1), P.ADD)]
+
+        job = P.Job(slow, deadline=0.1).start()
+        time.sleep(0.15)
+        self.assertEqual(job.poll(), "slow")
+        job.wait(5)
+        self.assertEqual(job.poll(), "slow")
+        self.assertIsNone(job.result)
+
+    def test_failure_is_quiet(self):
+        def broken(check):
+            raise RuntimeError("no")
+
+        self.assertEqual(P.Job(broken).start().wait(5), "failed")
+
+
+if __name__ == "__main__":
+    unittest.main()
