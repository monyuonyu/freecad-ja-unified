+def _tree_path(obj):
+    """[(id, label)] of the containers above obj, outermost first."""
+    path = []
+    parent = _parents(obj)
+    seen = set()
+    while parent is not None and parent.Name not in seen:
+        seen.add(parent.Name)
+        path.insert(0, (parent.Document.Name + "#" + parent.Name, parent.Label))
+        parent = _parents(parent)
+    return path
