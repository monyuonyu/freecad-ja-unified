+def scene_entries(source=None, group=True, colors=None):
+    """[SceneEntry] for the visible solids/faces/meshes.
+
+    source: None (active document), a document, an object, a shape, a mesh (points,
+    facets), a Mesh.Mesh, a dict {"shape"|"mesh"|"object": ..., "color": (r, g, b),
+    "group": "a/b/c", "label": "name"} or a list of these.  Containers (App::Part,
+    groups, links to them) are drawn with everything visible inside.
+
+    The group path of an entry comes from, in this order: the "group" of a dict item,
+    the group argument (a function obj -> path or a dict {Name or Label: path}), a string
+    property named "Group" of the object, the document tree (App::Part, groups, links,
+    a hidden Part::Compound) and finally nothing (top level).  Groups are told apart by
+    the objects (and link paths), never by labels, so renamed duplicates (間口001) stay
+    apart.  group=False: no groups."""
+    if source is None:
+        source = App.ActiveDocument
+        if source is None:
+            raise RuntimeError("No document is open")
+    out = []
+    if isinstance(source, App.Document):
+        for root in _roots(source):
+            if _visible(root) or root.isDerivedFrom("App::DocumentObjectGroup"):
+                _walk(root, out, from_document=True)
+    elif isinstance(source, (list, tuple)) and not _is_mesh_tuple(source):
+        for obj in source:
+            _add_entries(obj, out)
+    else:
+        _add_entries(source, out)
+    for i, e in enumerate(out):
+        if e.obj is None and e.name is None:
+            e.name = e.label = "item%d" % i
+        if e.label is None:
+            e.label = e.name
+    _apply_options(out, group, colors)
+    return out
+
+
+def _add_entries(obj, out):
+    if isinstance(obj, dict):
+        what = obj.get("shape", obj.get("mesh", obj.get("object")))
+        if what is None:
+            raise ValueError("An item dict needs 'shape', 'mesh' or 'object'")
+        start = len(out)
+        _add_entries(what, out)
+        path = _split_path(obj.get("group"))
+        label = obj.get("label", obj.get("name"))
+        for e in out[start:]:
+            if "color" in obj:
+                e.color = obj["color"]
+            if "faceColors" in obj:
+                e.face_colors = obj["faceColors"]
+            if path is not None:
+                e.group = _named_path(path)
+            if label is not None and len(out) - start == 1:
+                e.label = str(label)
+                if e.obj is None:
+                    e.name = str(label)
+        return
+    if isinstance(obj, Part.Shape):
+        if not obj.isNull():
+            out.append(SceneEntry(None, obj, None, None))
+        return
+    if _is_mesh_tuple(obj) or (hasattr(obj, "Topology") and not hasattr(obj, "TypeId")):
+        out.append(SceneEntry(None, obj, None, None))
+        return
+    if not hasattr(obj, "TypeId"):
+        raise TypeError("Cannot draw %r" % (obj,))
+    _walk(obj, out, from_document=False)
+
+
+def _apply_options(entries, group, colors):
+    if group is False or group is None or group == "none":
+        for e in entries:
+            e.group = []
+    elif callable(group) or isinstance(group, dict):
+        for i, e in enumerate(entries):
+            if callable(group):
+                path = group(e.obj if e.obj is not None else e.item)
+            else:
+                path = None
+                for key in ((e.obj.Name, e.obj.Label) if e.obj is not None else ()) + (e.name, e.label, i):
+                    if key in group:
+                        path = group[key]
+                        break
+            path = _split_path(path)
+            if path is not None:
+                e.group = _named_path(path)
+    if colors:
+        for i, e in enumerate(entries):
+            keys = ((e.obj.Name, e.obj.Label) if e.obj is not None else ()) + (e.name, e.label, i)
+            for key in keys:
+                if key in colors:
+                    e.color = colors[key]
+                    break
+
