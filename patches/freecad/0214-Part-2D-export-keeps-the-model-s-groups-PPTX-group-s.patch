+    def visit(obj, sub, key, label, path):
+        if _is_container(obj):
+            node = path + [(key, label)]
+            for s in obj.getSubObjects():
+                name = s.rstrip(".")
+                try:
+                    child = obj.getSubObject(s, retType=1)
+                except Exception:
+                    child = None
+                if child is None:
+                    continue
+                shown = obj.isElementVisible(name)
+                if shown == 0 or (shown < 0 and not _visible(child)):
+                    continue
+                if child.TypeId in _SKIP_TYPES:
+                    continue
+                child_label = child.Label
+                if name.isdigit() and not child.isDerivedFrom("App::LinkElement"):
+                    child_label = "%s[%s]" % (child.Label, name)
+                visit(child, sub + s, key + "." + name, child_label, node)
+            return
+        if from_document and (obj.TypeId in _SKIP_TYPES or (not sub and _in_body(obj))):
