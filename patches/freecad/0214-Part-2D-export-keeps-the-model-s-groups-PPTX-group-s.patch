+def _parents(obj):
+    """The containers holding obj in the document tree (App::Part, groups; a hidden
+    Part::Compound when obj is drawn on its own)."""
+    parent = None
+    try:
+        parent = obj.getParentGroup() or obj.getParentGeoFeatureGroup()
