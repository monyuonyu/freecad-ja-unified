+class _GroupNode:
+    __slots__ = ("label", "children", "faces", "edges", "far")
+
+    def __init__(self, label):
+        self.label = label
+        self.children = {}
+        self.faces = []
+        self.edges = []
+        self.far = float("-inf")
+
+    def child(self, key, label):
+        node = self.children.get(key)
+        if node is None:
+            node = self.children[key] = _GroupNode(label)
+        return node
+
+    def ordered(self):
+        """Children far to near (by their farthest face)."""
+        return sorted(self.children.values(), key=lambda n: -n.far)
+
+
+def _group_tree(data, grouped=True):
+    """Tree of the groups of a project() result: a node per group (data["items"][i]["group"])
+    and below it a node per object holding its faces and edges.  None without groups."""
+    items = data.get("items")
+    if not grouped or not items:
+        return None
+    root = _GroupNode(None)
+    leaves = {}
+
+    def leaf(i):
+        node = leaves.get(i)
+        if node is None:
+            node = root
+            it = items[i]
+            for gid, label in zip(it["groupId"], it["group"]):
+                node = node.child(gid, label)
+            node = leaves[i] = node.child(("item", i), it["label"])
+        return node
+
+    for f in data["faces"]:
+        leaf(f["item"]).faces.append(f)
+    for e in data["edges"]:
+        leaf(e["item"]).edges.append(e)
+
+    def far(node):
+        node.far = max([f["depth"] for f in node.faces] + [far(c) for c in node.children.values()]
+                       + [float("-inf")])  # fmt: skip
+        return node.far
+
+    far(root)
+    return root
+
+
