+def group_tree(parent):
+    """{name: (box, children)} of the group shapes below a spTree or grpSp element; checks
+    that every group's frame (off/ext and chOff/chExt) is the union of its children."""
+    P = "{%s}" % NS["p"]
+    result = {}
+    for el in parent:
+        if el.tag == P + "grpSp":
+            x = el.find("p:grpSpPr/a:xfrm", NS)
+            off, ext = x.find("a:off", NS), x.find("a:ext", NS)
+            choff, chext = x.find("a:chOff", NS), x.find("a:chExt", NS)
+            box = (int(off.get("x")), int(off.get("y")), int(ext.get("cx")), int(ext.get("cy")))
+            chbox = (int(choff.get("x")), int(choff.get("y")), int(chext.get("cx")), int(chext.get("cy")))
+            assert box == chbox, (box, chbox)
+            kids = child_boxes(el)
+            l, t = min(b[0] for b in kids), min(b[1] for b in kids)
+            r, b_ = max(b[0] + b[2] for b in kids), max(b[1] + b[3] for b in kids)
+            assert box == (l, t, r - l, b_ - t), (box, (l, t, r - l, b_ - t))
+            name = el.find("p:nvGrpSpPr/p:cNvPr", NS).get("name")
+            result[name] = (box, group_tree(el))
+    return result
+
+
+def child_boxes(parent):
+    P = "{%s}" % NS["p"]
+    boxes = []
+    for el in parent:
+        if el.tag == P + "grpSp":
+            x = el.find("p:grpSpPr/a:xfrm", NS)
+        elif el.tag == P + "sp":
+            x = el.find("p:spPr/a:xfrm", NS)
+        else:
+            continue
+        off, ext = x.find("a:off", NS), x.find("a:ext", NS)
+        boxes.append((int(off.get("x")), int(off.get("y")), int(ext.get("cx")), int(ext.get("cy"))))
+    return boxes
