-                    import ImportGui
-
-                    name = os.path.splitext(requested_file)[0]
-                    imported = App.newDocument("Unnamed", name)
-                    ImportGui.insert(filename, imported.Name)
-                else:
-                    continue
-                App.setActiveDocument(self.doc.Name)
-                self.buildPartList()
+                # A STEP or IGES file is read into a document of its own (not saved); its parts
+                # are copied into the assembly when put
+                self.openPartFile(filename)
 
     def onItemClicked(self, item):
+        path = item.data(0, self.FILE_ROLE)
+        if path:
+            self.openPartFile(path)
+            return
         selectedPart = item.data(0, QtCore.Qt.UserRole)
         if not selectedPart:
             # If there's no part associated, toggle the expanded state
