 src/Mod/Unified/ContextRules.py               |  2 +-
 .../translations/UnifiedWording_ja.ts         |  8 ++
 src/Mod/Unified/UnifiedChrome.py              |  2 +-
 4 files changed, 70 insertions(+), 16 deletions(-)

diff --git a/src/Mod/Assembly/CommandInsertLink.py b/src/Mod/Assembly/CommandInsertLink.py
index 4d3e49a77..6b043f9a8 100644
--- a/src/Mod/Assembly/CommandInsertLink.py
+++ b/src/Mod/Assembly/CommandInsertLink.py
@@ -291,8 +291,61 @@ class TaskAssemblyInsertLink(QtCore.QObject):
             else:
                 self.form.partList.expandToDepth(0)
 
+        self.addFolderFiles()
         self.adjustTreeWidgetSize()
 
+    FILE_ROLE = QtCore.Qt.UserRole + 201
+    PART_FILES = (".fcstd", ".step", ".stp", ".iges", ".igs")
+
+    def partsFolder(self):
+        """Where parts to put are looked for: the assembly's folder, else the last folder used"""
+        name = self.doc.FileName
+        if name and "Unsaved" not in os.path.normpath(name).split(os.sep):
+            return os.path.dirname(name)
+        last = App.ParamGet("User parameter:BaseApp/Preferences/General").GetString("FileOpenSavePath", "")
+        return last if last and os.path.isdir(last) else os.path.expanduser("~")
+
+    def addFolderFiles(self):
+        """The part files of the folder that are not open yet: a click opens one and lists its parts"""
+        folder = self.partsFolder()
+        try:
+            names = sorted(n for n in os.listdir(folder) if n.lower().endswith(self.PART_FILES))
+        except OSError:
+            return
+        open_files = {os.path.normcase(os.path.abspath(d.FileName)) for d in App.listDocuments().values() if d.FileName}
+        open_files |= getattr(self, "openedFiles", set())
+        names = [n for n in names if os.path.normcase(os.path.abspath(os.path.join(folder, n))) not in open_files]
+        if not names:
+            return
+        top = QtGui.QTreeWidgetItem()
+        top.setText(0, translate("Assembly", "Part files in {}").format(os.path.basename(folder) or folder))
+        top.setIcon(0, QIcon.fromTheme("folder", QIcon(":/icons/folder.svg")))
+        self.form.partList.addTopLevelItem(top)
+        for n in names[:200]:
+            item = QtGui.QTreeWidgetItem(top)
+            item.setText(0, n)
+            item.setToolTip(0, translate("Assembly", "Click to open it and list its parts"))
+            item.setData(0, self.FILE_ROLE, os.path.join(folder, n))
+        top.setExpanded(True)
+
+    def openPartFile(self, filename):
+        if not hasattr(self, "openedFiles"):
+            self.openedFiles = set()
+        self.openedFiles.add(os.path.normcase(os.path.abspath(filename)))
+        lower = filename.lower()
+        if lower.endswith(".fcstd"):
+            App.openDocument(filename, True)
+        elif lower.endswith((".step", ".stp", ".iges", ".igs")):
+            import ImportGui
+
+            name = os.path.splitext(os.path.basename(filename))[0]
+            imported = App.newDocument("Unnamed", name)
+            ImportGui.insert(filename, imported.Name)
+        else:
+            return
+        App.setActiveDocument(self.doc.Name)
+        self.buildPartList()
+
     def adjustTreeWidgetSize(self):
         # Adjust the height of the part list based on item count
         item_count = 1
@@ -352,22 +405,15 @@ class TaskAssemblyInsertLink(QtCore.QObject):
             )
 
             if not import_doc_is_open:
-                if filename.lower().endswith(".fcstd"):
-                    App.openDocument(filename, True)
-                elif filename.lower().endswith((".step", ".stp", ".iges", ".igs")):
-                    # A STEP or IGES file: read into a document of its own (not saved); its
