@@ -33,6 +33,76 @@ KEY_USER = "anthropic-api-key"
 TOKEN_ENV = "JA_CLAUDE_OAUTH_TOKEN"
 
 
+# claude（CLI）が認証に使う環境変数。利用者の環境から受け継いだものは使わない（SDK は os.environ を足して claude を起こすので、
+# 受け継いだ古いキーが、こちらで渡したものより先に使われたり、混ざったりする）
+AUTH_VARS = ("ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "CLAUDE_CODE_OAUTH_TOKEN")
+
+# コピーのときに紛れ込みやすい、見えない文字・全角の空白・引用符
+_INVISIBLE = "\u200b\u200c\u200d\u2060\ufeff\u00a0\u3000\t\r\n "
+_QUOTES = "\"'`\u201c\u201d\u2018\u2019\u300c\u300d\u300e\u300f"
+
+
+def normalize_key(raw):
+    """貼り付けたキーを整える。(キー, 問題の説明)。問題が無ければ説明は None
+
+    前後と中の空白・改行・見えない文字・全角の空白、前後の引用符、「ANTHROPIC_API_KEY=」「Bearer 」を外す。
+    残りに半角英数字と記号以外があれば問題とする（全角の文字などはキーに含まれない）"""
+    key = raw or ""
+    for c in _INVISIBLE:
+        key = key.replace(c, "")
+    for _ in range(2):
+        key = key.strip(_QUOTES)
+        for prefix in ("ANTHROPIC_API_KEY=", "CLAUDE_CODE_OAUTH_TOKEN=", "Bearer"):
+            if key.startswith(prefix):
+                key = key[len(prefix):]
+    if not key:
+        return "", "キーが空です"
+    bad = sorted({c for c in key if not (33 <= ord(c) < 127)})
+    if bad:
+        return key, "キーに使えない文字（%s）が含まれています。全角の文字が混ざっていないか確かめて、" \
+                    "console.anthropic.com からもう一度コピーしてください" % "".join(bad[:5])
+    return key, None
+
+
+def key_kind(key):
+    """種類: "api"（API キー sk-ant-api…）・"oauth"（claude setup-token のログインのトークン sk-ant-oat…）・"unknown"。"""
+    if key.startswith("sk-ant-oat"):
+        return "oauth"
+    if key.startswith("sk-ant-api"):
+        return "api"
+    return "unknown"
+
+
+def mask(key):
+    """キーを表示するときの形（先頭 10 文字と長さだけ。キーそのものは出さない）"""
+    return "%s…（%d 文字）" % (key[:10], len(key))
+
+
+def kind_name(kind):
+    return {"api": "API キー", "oauth": "ログインのトークン"}.get(kind, "Claude のキーの形ではないもの")
+
+
+AUTH_HINT = ("API キーが受け付けられませんでした。console.anthropic.com で作った sk-ant-api… のキーか確かめて、"
+             "設定 → AI チャット で入れ直してください（コピーのときの空白や改行にも注意）")
+
+
+def is_auth_error(texts):
+    t = "\n".join(x for x in texts if x).lower()
+    return any(k in t for k in ("invalid api key", "fix external api key", "401", "authenticate",
+                                "invalid bearer token", "oauth token has expired", "invalid x-api-key"))
+
+
+def auth_message(kind, key):
+    """認証の失敗の説明（使ったものの種類と、先頭だけ）"""
+    used = "（使ったもの: %s %s）" % (kind_name(kind), mask(key)) if key else ""
+    if kind == "oauth":
+        return ("ログインのトークンが受け付けられませんでした。claude setup-token で発行し直すか、"
+                "console.anthropic.com で作った sk-ant-api… の API キーを 設定 → AI チャット で入れてください" + used)
+    if kind == "unknown":
+        return AUTH_HINT + "。しまってあるものは Claude のキー（sk-ant-api…）の形ではありません" + used
+    return AUTH_HINT + used
+
+
 def _key_file(datadir):
     return os.path.join(datadir, "ai-api-key")
 
@@ -56,12 +126,12 @@ def load_key(datadir):
         import keyring
         k = keyring.get_password(KEY_SERVICE, KEY_USER)
         if k:
-            return k
+            return normalize_key(k)[0] or None
     except Exception:
         pass
     try:
         with open(_key_file(datadir)) as f:
-            return f.read().strip() or None
+            return normalize_key(f.read())[0] or None
     except OSError:
         return None
 
