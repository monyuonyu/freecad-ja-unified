@@ -235,13 +306,16 @@ class Bridge:
             error = "%s: %s" % (type(e).__name__, e)
         finally:
             self.busy = False
-        # 認証の失敗（401）: API キーなら入れ直してもらう。長期トークンなら発行し直してもらう
-        if error is not None and any("401" in t or "authenticate" in t.lower() for t in said + [error]):
-            if self.oauth_token:
+        # 認証の失敗（401・claude の "Invalid API key · Fix external API key"）: 何を使ったかを添えて、入れ直してもらう
+        cli_says_invalid = any("invalid api key" in t.lower() for t in said)  # 失敗の印が付かないことがある
+        if (error is not None and is_auth_error(said + [error])) or cli_says_invalid:
+            if self.oauth_token and self.key_kind is None:
                 error = "長期トークン（%s）が正しくないか、期限が切れています。claude setup-token で発行し直してください" % TOKEN_ENV
+            elif self.args.local_login:
+                error = "この PC の claude のログインが使えません。claude でログインし直してください"
             else:
+                error = auth_message(self.key_kind, self.oauth_token or self.api_key or "")
                 self.send(type="need_key")
-                error = None
         elif error is not None and (describe_error(error) or describe_error("\n".join(said))):
             # プロキシ・証明書の問題: 何を確かめればよいかを添える
             error = describe_error(error) or describe_error("\n".join(said))
@@ -251,13 +325,20 @@ class Bridge:
 
     async def main(self):
         # 認証: 利用者自身の API キー。本人用に、長期トークン（環境変数）か、この PC の claude のログイン（--local-login）も使える
-        self.oauth_token = os.environ.pop(TOKEN_ENV, "").strip() or None
+        self.oauth_token = normalize_key(os.environ.pop(TOKEN_ENV, ""))[0] or None
+        self.key_kind = None   # しまってあるものの種類（"api"・"oauth"・"unknown"）。長期トークンの環境変数なら None
+        # 利用者の環境から受け継いだ認証の環境変数は使わない（--local-login のときも、ログインの方を使わせる）
+        for k in AUTH_VARS:
+            os.environ.pop(k, None)
         if self.oauth_token or self.args.local_login:
-            # API キーがあると claude はそちらを使うので、環境からも外す
-            os.environ.pop("ANTHROPIC_API_KEY", None)
             self.api_key = None
         else:
             self.api_key = load_key(self.args.datadir)
+            if self.api_key:
+                self.key_kind = key_kind(self.api_key)
+                if self.key_kind == "oauth":
+                    # claude setup-token のトークンを API キーの欄に入れた: ログインのトークンとして渡す
+                    self.oauth_token, self.api_key = self.api_key, None
         if not self.oauth_token and not self.args.local_login and not self.api_key:
             self.send(type="need_key")
             return
@@ -314,9 +395,14 @@ def main():
     ap.add_argument("--workdir", default=os.path.join(os.path.expanduser("~"), ".cache", "freecad-ai"))
     args = ap.parse_args()
     if args.store_key:
-        key = sys.stdin.read().strip()
-        if not key:
-            sys.exit("キーが空")
+        key, problem = normalize_key(sys.stdin.read())
+        if problem:
