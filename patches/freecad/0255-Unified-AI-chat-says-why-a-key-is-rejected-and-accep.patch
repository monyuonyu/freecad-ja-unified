+class TestKeys(unittest.TestCase):
+    def setUp(self):
+        import AIAgentBridge
+        self.b = AIAgentBridge
+
+    def test_normalize(self):
+        n = self.b.normalize_key
+        key = "sk-ant-api03-abcDEF_123-xyz"
+        for raw in (key, " %s \n" % key, "\"%s\"" % key, "「%s」" % key, "　%s​" % key,
+                    "﻿%s\r\n" % key, "sk-ant-api03-abc\nDEF_123-xyz", "ANTHROPIC_API_KEY=%s" % key,
+                    "'%s'" % key, "Bearer %s" % key):
+            self.assertEqual(n(raw), (key, None), repr(raw))
+        got, problem = n("sk-ant-api03-ａｂｃ")
+        self.assertIsNotNone(problem)
+        self.assertIn("使えない文字", problem)
+        self.assertEqual(n("  \n")[1], "キーが空です")
+
+    def test_kind(self):
+        self.assertEqual(self.b.key_kind("sk-ant-api03-x"), "api")
+        self.assertEqual(self.b.key_kind("sk-ant-oat01-x"), "oauth")
+        self.assertEqual(self.b.key_kind("sk-proj-x"), "unknown")
+
+    def test_messages_hide_the_key(self):
+        secret = "sk-ant-api03-" + "s" * 80
+        m = self.b.auth_message("api", secret)
+        self.assertIn("API キーが受け付けられませんでした", m)
+        self.assertIn("sk-ant-api…（93 文字）", m)
+        self.assertNotIn(secret, m)
+        self.assertIn("ログインのトークン", self.b.auth_message("oauth", "sk-ant-oat01-" + "t" * 80))
+        self.assertTrue(self.b.is_auth_error(["Invalid API key · Fix external API key"]))
+        self.assertFalse(self.b.is_auth_error(["箱を作りました"]))
+
+
 if __name__ == "__main__":
     unittest.main()
