From 0973ae94100af9a02cd721196d64cb7fd347d320 Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Sun, 27 Sep 2026 21:43:33 +0900
Subject: [PATCH 168/201] Main: Set up the integrated environment in one place,
 also for the command line and Python

UserDataDirName, the single workbench and the JIS drawing standard are
set by App::configureIntegratedEnvironment() when built with Unified.
FreeCAD imported as a Python module now uses the same settings directory,
and TechDraw's third-angle default no longer depends on the GUI.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/App/SingleWorkbench.h            |  18 +
 src/Main/CMakeLists.txt              |   5 +
 src/Main/MainCmd.cpp                 | 407 ++++++-------
 src/Main/MainGui.cpp                 | 822 +++++++++++++--------------
 src/Main/MainPy.cpp                  | 388 ++++++-------
 src/Mod/TechDraw/App/Preferences.cpp |   7 +-
 6 files changed, 837 insertions(+), 810 deletions(-)

diff --git a/src/App/SingleWorkbench.h b/src/App/SingleWorkbench.h
index 0459a84da..23e74ea3e 100644
--- a/src/App/SingleWorkbench.h
+++ b/src/App/SingleWorkbench.h
@@ -14,4 +14,22 @@ inline bool isSingleWorkbench()
     return Application::Config().contains("SingleWorkbench");
 }
 
+/// Set up the integrated working environment's configuration, the same for the GUI, the
+/// command line and FreeCAD imported as a Python module. Called before the application is
+/// initialized.
+inline void configureIntegratedEnvironment(bool gui)
+{
+    auto& cfg = Application::Config();
+    // Settings, macros and add-ons of their own, apart from those of FreeCAD: the integrated
+    // environment writes defaults of its own (mouse navigation, sketch editing, ...)
+    cfg["UserDataDirName"] = "FreeCAD-ja-unified";
+    // Drawings follow JIS B 0001 by default (third-angle projection)
+    cfg["DrawingStandard"] = "JIS";
+    if (gui) {
+        // One integrated working environment instead of a choice of workbenches
+        cfg["StartWorkbench"] = "UnifiedWorkbench";
+        cfg["SingleWorkbench"] = "UnifiedWorkbench";
+    }
+}
+
 }  // namespace App
