 """Tests of the headless views and checks of the Part module (PartViews)."""
 
 import json
+import math
 import os
 import struct
 import tempfile
@@ -645,6 +646,51 @@ class TestPartViewOptions(unittest.TestCase):
             self.assertEqual(len(base64.b64decode(part["nrm"])), len(tri))
