@@ -2,8 +2,15 @@
 """A 3D view to turn in a browser, in one HTML file: WebGL without libraries (FreeCAD's WebGL
 export loads three.js from the internet: not without the net, not always on a phone).
 
-    FreeCADCmd model.FCStd --export-web model.html [--deflection 0.5]
-    PartWebView.export(doc_or_objects, "model.html", title="", notes=[], walls={})
+    FreeCADCmd model.FCStd --export-web model.html [--deflection 0.5] [--web-exclude "ボルト_*"]
+                [--web-simplify fasteners]
+    PartWebView.export(doc_or_objects, "model.html", title="", notes=[], walls={}, exclude=[], simplify=[])
+
+exclude: parts left out (labels or names of the parts or of their groups, * and ?).
+simplify: parts drawn as cylinders (round ones: shank and head) or boxes, without edges;
+"fasteners" names the bolts, nuts, washers and screws (ボルト・ナット・座金・ワッシャ・ねじ・bolt…).
+A page over 30 MB is said: some antivirus programs stop big HTML files (a model of 1,000 parts,
+54 MB, of which a third were bolts, was blocked on a company PC).
 
 The visible objects of the document with their colours (as PartViews draws them); curved faces
 shaded smoothly (normals from the triangulation), edges drawn. In the page: turn, zoom, pan
@@ -38,6 +45,80 @@ def _shape_data(shape, deflection, edges):
     return pack(tri), pack(nrm), pack(seg)
 
 
+FASTENER_WORDS = ("ボルト", "ナット", "座金", "ワッシャ", "ねじ", "ネジ", "ビス", "スクリュー", "リベット",
+                  "bolt", "nut", "washer", "screw", "rivet")  # fmt: skip
+WARN_BYTES = 30 * 1024 * 1024
+
+
+def _names(e):
+    return [e.label, e.name] + [g[1] for g in e.group]
+
+
+def _matches(e, patterns):
+    import fnmatch
+
+    words = []
+    for p in patterns:
+        if p == "fasteners":
+            words += ["*%s*" % w for w in FASTENER_WORDS]
+        else:
+            words.append(p)
+    return any(fnmatch.fnmatch(n.lower(), w.lower()) for n in _names(e) if n for w in words)
+
+
+def _simple_solid(solid):
+    """A solid as one to three cylinders along its largest round face (a bolt: shank and head),
+    else its box"""
+    import Part
+
+    cyls = [f for f in solid.Faces if f.Surface.TypeId == "Part::GeomCylinder"]
+    if not cyls:
+        bb = solid.BoundBox
+        return Part.makeBox(max(bb.XLength, 1e-3), max(bb.YLength, 1e-3), max(bb.ZLength, 1e-3),
+                            App.Vector(bb.XMin, bb.YMin, bb.ZMin))  # fmt: skip
+    main = max(cyls, key=lambda f: f.Area)
+    axis, c = App.Vector(main.Surface.Axis).normalize(), main.Surface.Center
+    pts = [v.Point for v in solid.Vertexes] + [p for f in solid.Faces for p in (f.BoundBox.Center,)]
+
+    def t_r(p):
+        d = p - c
+        t = d.dot(axis)
+        return t, (d - axis * t).Length
+
+    tr = [t_r(p) for p in pts]
+    ts = [t for t, _ in tr]
+    lo, hi = min(ts), max(ts)
+    mt = [t_r(v.Point)[0] for v in main.Vertexes] or [lo, hi]
+    s0, s1 = max(min(mt), lo), min(max(mt), hi)
+    r = main.Surface.Radius
+    pieces = []
+
+    def cyl(a, b, radius):
+        if b - a > 1e-6 and radius > 1e-6:
+            pieces.append(Part.makeCylinder(radius, b - a, c + axis * a, axis))
+
+    cyl(s0, s1, r)
+    for a, b in ((lo, s0), (s1, hi)):
+        rad = max([rr for t, rr in tr if a - 1e-6 <= t <= b + 1e-6] or [r])
+        cyl(a, b, rad)
+    if not pieces:
+        cyl(lo, hi, r)
+    return Part.makeCompound(pieces)
+
+
+def _simple_data(shape, deflection):
+    """The triangles of the simplified solids, each coarse for its size (about 8 sides a circle)"""
+    tri, nrm = [], []
+    for x in shape.Solids or [shape]:
+        simple = _simple_solid(x)
+        size = max(min(simple.BoundBox.XLength, simple.BoundBox.YLength, simple.BoundBox.ZLength), 1e-3)
+        points, facets, normals = simple.tessellate(max(deflection, size * 0.04), normals=True)
+        tri += [c for t in facets for k in t for c in (points[k].x, points[k].y, points[k].z)]
+        nrm += [c for t in facets for k in t for c in (normals[k].x, normals[k].y, normals[k].z)]
+    pack = lambda xs: base64.b64encode(struct.pack("<%df" % len(xs), *xs)).decode()  # noqa: E731
+    return pack(tri), pack(nrm), ""
+
+
 def _mesh_data(mesh):
     pts, facets = mesh.Topology if hasattr(mesh, "Topology") else mesh
     tri = [c for t in facets for k in t for c in (pts[k].x, pts[k].y, pts[k].z)]
@@ -45,7 +126,7 @@ def _mesh_data(mesh):
 
 
 def export(source=None, path="view.html", title="", notes=(), walls=None, alpha=None, deflection=0.0,
-           edges=True):  # fmt: skip
+           edges=True, exclude=(), simplify=()):  # fmt: skip
     """Write the 3D view of `source` (a document, objects or shapes; see PartViews.scene_entries)
     to the HTML file `path`. walls: {label or name: (x, y, z)} the outward side of a wall,
     hidden when looked at from that side; alpha: {label or name: 0..1}. deflection: the size of
@@ -53,6 +134,8 @@ def export(source=None, path="view.html", title="", notes=(), walls=None, alpha=
     import PartViews
 
     entries = PartViews.scene_entries(source, colors=None)
+    if exclude:
+        entries = [e for e in entries if not _matches(e, exclude)]
     if not entries:
         raise RuntimeError("Nothing visible to write")
     if not deflection:
@@ -74,7 +157,10 @@ def export(source=None, path="view.html", title="", notes=(), walls=None, alpha=
         if hasattr(e.item, "tessellate"):
             if not e.item.Faces:
                 continue
-            tri, nrm, seg = _shape_data(e.item, deflection, edges)
+            if simplify and _matches(e, simplify):
+                tri, nrm, seg = _simple_data(e.item, deflection)
+            else:
+                tri, nrm, seg = _shape_data(e.item, deflection, edges)
         else:
             tri, nrm, seg = _mesh_data(e.item)
         group = (e.label.split("_")[0] if "_" in e.label else e.label) if one_group else group_of(e)
@@ -95,4 +181,16 @@ def export(source=None, path="view.html", title="", notes=(), walls=None, alpha=
     os.makedirs(folder, exist_ok=True)
     with open(path, "w", encoding="utf-8") as f:
         f.write(html)
+    size = os.path.getsize(path)
+    if size > WARN_BYTES:
+        heavy = sorted(((len(p["tri"]) + len(p["nrm"]) + len(p["seg"]), p["group"]) for p in parts), reverse=True)
+        by_group = {}
+        for n, g in heavy:
+            by_group[g] = by_group.get(g, 0) + n
+        top = sorted(by_group.items(), key=lambda kv: -kv[1])[:5]
+        App.Console.PrintWarning(
+            "%s is %.0f MB: some antivirus programs stop HTML files over about 30 MB (the page does not open). "
+            "Lighter: --web-simplify fasteners (bolts and nuts as cylinders), --web-exclude \"pattern\", a larger "
+            "--deflection. Heaviest groups: %s\n"
+            % (path, size / 1048576.0, ", ".join("%s %.1f MB" % (g, n / 1048576.0) for g, n in top)))
     return path
