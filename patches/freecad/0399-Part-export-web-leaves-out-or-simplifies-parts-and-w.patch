+    def testWebViewLighterBolts(self):
+        # a page of 54 MB (a third bolts) was stopped by a company PC's antivirus (reported on 0.8.4)
+        import base64
+        import PartWebView
+
+        doc = App.newDocument("WebBolts")
+        try:
+            plate = doc.addObject("Part::Box", "Plate")
+            plate.Length, plate.Width, plate.Height = 100, 60, 5
+            bolts = []
+            for k in range(6):
+                head = Part.makePolygon([App.Vector(5 * math.cos(math.radians(a)), 5 * math.sin(math.radians(a)), 0)
+                                         for a in range(0, 361, 60)])  # fmt: skip
+                # the shank with rings like a thread (many faces, as a real bolt's)
+                prof = [App.Vector(0, 0, -20)] + [App.Vector(3 if i % 2 else 2.6, 0, -20 + 0.5 * i) for i in range(41)]
+                prof += [App.Vector(0, 0, 0.5), App.Vector(0, 0, -20)]
+                shank = Part.Face(Part.makePolygon(prof)).revolve(App.Vector(), App.Vector(0, 0, 1), 360)
+                bolt = Part.Face(head).extrude(App.Vector(0, 0, 4)).fuse(Part.Solid(Part.Shell(shank.Faces)))
+                bolt.translate(App.Vector(15 + 14 * k, 30, 5))
+                bolts.append(bolt.removeSplitter())
+            feature = doc.addObject("Part::Feature", "Bolts")
+            feature.Shape = Part.makeCompound(bolts)
+            feature.Label = "ボルト_A"
+            doc.recompute()
+
+            def page(**kw):
+                path = os.path.join(self.dir, "b.html")
+                PartWebView.export(doc, path, **kw)
+                with open(path, encoding="utf-8") as f:
+                    html = f.read()
+                return os.path.getsize(path), json.loads(html.split("const DATA = ", 1)[1].split(";\n", 1)[0])
+
+            full, data = page()
+            self.assertEqual(sorted(p["name"] for p in data["parts"]), ["Plate", "ボルト_A"])
+            light, data = page(simplify=["fasteners"])
+            bolt = [p for p in data["parts"] if p["name"] == "ボルト_A"][0]
+            self.assertEqual(bolt["seg"], "")  # no edges
+            self.assertLess(len(base64.b64decode(bolt["tri"])), len(base64.b64decode(
+                [p for p in page()[1]["parts"] if p["name"] == "ボルト_A"][0]["tri"])))  # fmt: skip
+            self.assertLess(light, full)
+            _, data = page(exclude=["ボルト_*"])
+            self.assertEqual([p["name"] for p in data["parts"]], ["Plate"])
+        finally:
+            App.closeDocument(doc.Name)
+
     def testSectionFillsCutFaces(self):
