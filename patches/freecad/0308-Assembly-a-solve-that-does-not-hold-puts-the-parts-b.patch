@@ -295,6 +295,20 @@ private:
     Base::Placement jointPlacement(App::DocumentObject* joint, const char* plcName) const;
     int solveOnce(bool enableRedo, std::vector<App::DocumentObject*>& joints);
     bool jointsHold(const std::vector<App::DocumentObject*>& joints) const;
+
+public:
+    /// A joint whose two sides do not meet after solving: how far apart (mm) and how much
+    /// their axes are turned against each other (degrees)
+    struct BrokenJoint
+    {
+        App::DocumentObject* joint;
+        double gap;
+        double angle;
+    };
+    std::vector<BrokenJoint> brokenJoints(const std::vector<App::DocumentObject*>& joints) const;
+    std::vector<BrokenJoint> brokenJoints();
+
+private:
     void rememberHeldJoints(const std::vector<App::DocumentObject*>& joints);
 
     int lastDoF;
