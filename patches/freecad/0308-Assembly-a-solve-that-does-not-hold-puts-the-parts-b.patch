diff --git a/src/Mod/Assembly/App/AssemblyObject.cpp b/src/Mod/Assembly/App/AssemblyObject.cpp
index bf2ab1ff7..565f05761 100644
--- a/src/Mod/Assembly/App/AssemblyObject.cpp
+++ b/src/Mod/Assembly/App/AssemblyObject.cpp
@@ -338,6 +338,23 @@ int AssemblyObject::solve(bool enableRedo)
     // updateSolveStatus() solves on demand; suppress that while a solve is running.
     Base::StateLocker lock(solveInProgress);
 
+    // where the parts were: a solve whose joints do not hold puts them back (it left them in
+    // a broken pose, e.g. a crank tilted 16 degrees off its bearing)
+    std::vector<std::pair<App::DocumentObject*, Base::Placement>> before;
+    for (auto* obj : getOutListRecursive()) {
+        if (auto* plc = obj->getPlacementProperty()) {
+            before.emplace_back(obj, plc->getValue());
+        }
+    }
+    auto putBack = [&before]() {
+        for (auto& [obj, plc] : before) {
+            auto* prop = obj->getPlacementProperty();
+            if (prop && !prop->getValue().isSame(plc)) {
+                prop->setValue(plc);
+            }
+        }
+    };
+
     std::vector<App::DocumentObject*> joints;
     int rc = solveOnce(enableRedo, joints);
     if (rc != 0 || jointsHold(joints)) {
@@ -410,7 +427,14 @@ int AssemblyObject::solve(bool enableRedo)
         rememberHeldJoints(joints);
         return 0;
     }
-    FC_WARN("Assembly " << getFullName() << ": the joints do not hold after solving");
+    std::string names;
+    for (const auto& b : brokenJoints(joints)) {
+        names += std::string(names.empty() ? "" : ", ") + b.joint->Label.getValue() + " ("
+            + std::to_string(b.gap) + " mm, " + std::to_string(b.angle) + " deg)";
+    }
+    putBack();
+    FC_WARN("Assembly " << getFullName() << ": the joints do not hold after solving, the parts are "
+            "left where they were: " << names);
     return rc != 0 ? rc : -7;
 }
 
@@ -480,32 +504,66 @@ Base::Placement AssemblyObject::jointPlacement(App::DocumentObject* joint, const
 
 bool AssemblyObject::jointsHold(const std::vector<App::DocumentObject*>& joints) const
 {
-    // The joints that pin both sides together: their two placements meet (and for a fixed
-    // joint, turn the same way)
+    return brokenJoints(joints).empty();
+}
+
+std::vector<AssemblyObject::BrokenJoint> AssemblyObject::brokenJoints()
+{
+    return brokenJoints(getJoints());
+}
+
+std::vector<AssemblyObject::BrokenJoint>
+AssemblyObject::brokenJoints(const std::vector<App::DocumentObject*>& joints) const
+{
+    // The joints that hold both sides on a point or an axis: their two placements meet
+    // (fixed: also turn the same way; revolute, cylindrical, slider: the z axes line up)
+    std::vector<BrokenJoint> broken;
     for (auto* joint : joints) {
         auto* type = joint->getPropertyByName<App::PropertyEnumeration>("JointType");
         if (!type || !type->getValueAsString()) {
             continue;
         }
         const std::string kind = type->getValueAsString();
-        if (kind != "Fixed" && kind != "Revolute" && kind != "Ball") {
+        const bool point = kind == "Fixed" || kind == "Revolute" || kind == "Ball";
+        const bool axis = kind == "Cylindrical" || kind == "Slider";
+        if (!point && !axis) {
             continue;
         }
         if (joint->getPropertyByName<App::PropertyBool>("Suppressed")
             && joint->getPropertyByName<App::PropertyBool>("Suppressed")->getValue()) {
             continue;
         }
+        if (!getMovingPartFromRef(joint, "Reference1") || !getMovingPartFromRef(joint, "Reference2")) {
+            continue;
+        }
         const Base::Placement a = getJointSideGlobalPlacement(joint, "Reference1", "Placement1");
         const Base::Placement b = getJointSideGlobalPlacement(joint, "Reference2", "Placement2");
         const double scale = std::max(1.0, std::max(a.getPosition().Length(), b.getPosition().Length()));
-        if ((a.getPosition() - b.getPosition()).Length() > 1e-6 * scale) {
-            return false;
+        const Base::Vector3d za = a.getRotation().multVec(Base::Vector3d(0, 0, 1));
+        const Base::Vector3d zb = b.getRotation().multVec(Base::Vector3d(0, 0, 1));
+        Base::Vector3d d = b.getPosition() - a.getPosition();
+        double gap = d.Length();
+        if (axis) {
+            gap = (d - za * d.Dot(za)).Length();  // off the axis
+        }
+        double angle = 0.0;
+        if (kind == "Fixed" || isAngleDriven(joint)) {
+            Base::Vector3d ax;
+            (a.getRotation().inverse() * b.getRotation()).getValue(ax, angle);
+            angle = std::fabs(angle);
+            if (angle > M_PI) {
+                angle = 2 * M_PI - angle;
+            }
         }
-        if ((kind == "Fixed" || isAngleDriven(joint)) && !a.getRotation().isSame(b.getRotation(), 1e-6)) {
-            return false;
+        else if (kind != "Ball") {
+            angle = std::acos(std::clamp(std::fabs(za.Dot(zb)), -1.0, 1.0));
+        }
+        // the solver converges to about 1e-9 of the model's size; well above that is broken
+        if (gap > std::max(1e-4, 1e-7 * scale) || angle > 1e-5) {
+            broken.push_back({joint, gap, Base::toDegrees(angle)});
         }
     }
-    return true;
+    return broken;
 }
 
 void AssemblyObject::rememberHeldJoints(const std::vector<App::DocumentObject*>& joints)
diff --git a/src/Mod/Assembly/App/AssemblyObject.h b/src/Mod/Assembly/App/AssemblyObject.h
