diff --git a/src/Mod/Unified/TestAssemblySolve.py b/src/Mod/Unified/TestAssemblySolve.py
index 248529cca..424418017 100644
--- a/src/Mod/Unified/TestAssemblySolve.py
+++ b/src/Mod/Unified/TestAssemblySolve.py
@@ -80,6 +80,32 @@ class AssemblySolveTest(unittest.TestCase):
         finally:
             App.closeDocument(doc.Name)
 
+    def test_a_joint_that_cannot_hold(self):
+        # a solve whose joints do not hold puts the parts back and says which joint, how far
+        import DesignCheck
+        import JointObject
+
+        doc, sheet, asm, piston, r, L = build()
+        try:
+            self.assertEqual(asm.solve(), 0)
+            self.assertEqual(asm.getBrokenJoints(), [])
+            before = App.Placement(piston.Placement)
+            bad = doc.getObject("Joints").newObject("App::FeaturePython", "Bad")
+            JointObject.Joint(bad, JointObject.JointTypes.index("Fixed"))
+            bad.Detach1 = True; bad.Detach2 = True
+            bad.Reference1 = (doc.getObject("Base"), ["", ""]); bad.Reference2 = (piston, ["", ""])
+            bad.Placement1 = App.Placement(App.Vector(50, 0, 0), App.Rotation())
+            bad.Placement2 = App.Placement()
+            self.assertEqual(asm.solve(), -7)
+            self.assertTrue(piston.Placement.isSame(before, 1e-9))
+            broken = asm.getBrokenJoints()
+            self.assertEqual([j.Name for j, gap, angle in broken], ["Bad"])
+            self.assertGreater(broken[0][1], 50)
+            issues = [i for i in DesignCheck.run(doc) if i.rule == "joint_broken"]
+            self.assertEqual([i.objects for i in issues], [["Bad"]])
+        finally:
+            App.closeDocument(doc.Name)
+
     def test_big_step_right_after_opening(self):
