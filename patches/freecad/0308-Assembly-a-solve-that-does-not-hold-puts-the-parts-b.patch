diff --git a/src/Mod/Assembly/App/AssemblyObjectPyImp.cpp b/src/Mod/Assembly/App/AssemblyObjectPyImp.cpp
index ddd002de8..fbf82658b 100644
--- a/src/Mod/Assembly/App/AssemblyObjectPyImp.cpp
+++ b/src/Mod/Assembly/App/AssemblyObjectPyImp.cpp
@@ -103,6 +103,18 @@ PyObject* AssemblyObjectPy::updateForFrame(PyObject* args) const
     Py_Return;
 }
 
+PyObject* AssemblyObjectPy::getBrokenJoints(PyObject* args) const
+{
+    if (!PyArg_ParseTuple(args, "")) {
+        return nullptr;
+    }
+    Py::List list;
+    for (const auto& b : this->getAssemblyObjectPtr()->brokenJoints()) {
+        list.append(Py::TupleN(Py::asObject(b.joint->getPyObject()), Py::Float(b.gap), Py::Float(b.angle)));
+    }
+    return Py::new_reference_to(list);
+}
+
 PyObject* AssemblyObjectPy::numberOfFrames(PyObject* args) const
 {
     if (!PyArg_ParseTuple(args, "")) {
diff --git a/src/Mod/Unified/DesignCheck.py b/src/Mod/Unified/DesignCheck.py
index 1e18e2acc..c7c8edafc 100644
--- a/src/Mod/Unified/DesignCheck.py
+++ b/src/Mod/Unified/DesignCheck.py
@@ -67,6 +67,7 @@ RULES = {
     "split": QT_TRANSLATE_NOOP("DesignCheck", "Part split into pieces"),
     "not_solid": QT_TRANSLATE_NOOP("DesignCheck", "Not a closed solid"),
     "interference": QT_TRANSLATE_NOOP("DesignCheck", "Parts overlap"),
+    "joint_broken": QT_TRANSLATE_NOOP("DesignCheck", "Joint does not hold"),
     "sketch_conflict": QT_TRANSLATE_NOOP("DesignCheck", "Conflicting constraints"),
     "sketch_redundant": QT_TRANSLATE_NOOP("DesignCheck", "Redundant constraints"),
     "sketch_malformed": QT_TRANSLATE_NOOP("DesignCheck", "Malformed constraints"),
@@ -623,6 +624,29 @@ def check_drawings(doc, issues, opt):
                                     [o.Name], fix="delete_view"))
 
 
+def check_assemblies(doc, issues, opt):
+    """組立: 解いてもジョイントが成り立っていない（2 つの部品が離れたまま・向きがずれたまま）。
+    解けなかった組立は部品を解く前の位置に戻すので、どのジョイントがどれだけずれているかをここで言う"""
+    for o in doc.Objects:
+        if o.TypeId != "Assembly::AssemblyObject" or not hasattr(o, "getBrokenJoints"):
+            continue
+        try:
+            broken = o.getBrokenJoints()
+        except Exception:
+            continue
+        for joint, gap, angle in broken:
+            if gap > 1e-3 and angle > 0.01:
+                text = translate("DesignCheck", "{0}: the two parts do not meet: {1:.2f} mm apart and turned {2:.2f}° "
+                                 "(another joint or an offset keeps them apart)")
+            elif gap > 1e-3:
+                text = translate("DesignCheck", "{0}: the two parts do not meet: {1:.2f} mm apart "
+                                 "(another joint or an offset keeps them apart)")
+            else:
+                text = translate("DesignCheck", "{0}: the two parts are turned {2:.2f}° against each other "
+                                 "(another joint or an offset keeps them apart)")
+            issues.append(Issue(ERROR, "joint_broken", text.format(joint.Label, gap, angle), [joint.Name]))
+
+
 def check_sketches(doc, issues, opt):
     for o in doc.Objects:
         if not o.isDerivedFrom("Sketcher::SketchObject"):
@@ -864,6 +888,7 @@ def iter_run(doc=None, **options):
     check_shapes(doc, issues, opt, shapes)
     check_sketches(doc, issues, opt)
     check_drawings(doc, issues, opt)
+    check_assemblies(doc, issues, opt)
     yield from iter_interference(doc, issues, opt, shapes)
     kept = Issues(i for i in issues if not _is_ignored(doc, i))
     kept.ignored = len(issues) - len(kept)
