@@ -0,0 +1,116 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+
+"""Part.solidFromMesh, Part.filletMeshSolid, Part.pointsInside, Part.rayCast"""
+
+import random
+import unittest
+
+import FreeCAD as App
+import Part
+
+
+def _soup(shape, deflection=0.1, jitter=0.0, flip_every=0, seed=1):
+    """An STL-like triangle soup of a shape: no shared points, optional noise and
+    flipped facets."""
+    import Mesh
+
+    rnd = random.Random(seed)
+    points, facets = shape.tessellate(deflection)
+    pts, fcs = [], []
+    for k, f in enumerate(facets):
+        idx = list(range(len(pts), len(pts) + 3))
+        if flip_every and k % flip_every == 0:
+            idx = [idx[0], idx[2], idx[1]]
+        fcs.append(tuple(idx))
+        for i in f:
+            p = points[i]
+            pts.append(App.Vector(p.x + rnd.uniform(-jitter, jitter), p.y + rnd.uniform(-jitter, jitter),
+                                  p.z + rnd.uniform(-jitter, jitter)))  # fmt: skip
+    return Mesh.Mesh((pts, fcs))
+
+
+class TestSolidFromMesh(unittest.TestCase):
+    def setUp(self):
+        self.box = Part.makeBox(20, 20, 10)
+        self.holed = self.box.cut(Part.makeCylinder(4, 10, App.Vector(10, 10, 0)))
+
+    def testRepairsAndRefines(self):
+        mesh = _soup(self.holed, jitter=1e-4, flip_every=7)
+        mesh.flipNormals()  # inverted as well
+        solid, rep = Part.solidFromMesh(mesh, 0.01, report=True)
+        self.assertEqual(solid.ShapeType, "Solid")
+        self.assertTrue(rep["valid"] and rep["closed"])
+        self.assertAlmostEqual(solid.Volume, self.holed.Volume, delta=0.01 * self.holed.Volume)
+        # the flat top and bottom (with the hole) and the four sides are one face each
+        self.assertLess(len(solid.Faces), len(mesh.Facets) / 2)
+        self.assertEqual(rep["problems"], [])
+
+    def testHoleIsFilled(self):
+        mesh = _soup(self.box)
+        mesh.removeFacets([0])
+        solid, rep = Part.solidFromMesh(mesh, 0.01, report=True)
+        self.assertEqual(solid.ShapeType, "Solid")
+        self.assertAlmostEqual(solid.Volume, 4000, delta=1)
+
+    def testBooleansWithFuzzy(self):
+        a = Part.solidFromMesh(_soup(self.box, jitter=1e-4))
+        b = Part.solidFromMesh(_soup(Part.makeBox(10, 20, 10, App.Vector(20, 0, 0)), jitter=1e-4, seed=2))
+        c = Part.solidFromMesh(_soup(Part.makeBox(10, 10, 10, App.Vector(15, 5, 0)), jitter=1e-4, seed=3))
+        self.assertLess(a.common(b, 0.01).Volume, 0.1)  # touching only
+        self.assertAlmostEqual(a.common(c, 0.01).Volume, 500, delta=1)
+        pairs = Part.findInterferences([a, b, c], tolerance=0.01)
+        self.assertEqual(sorted((p[0], p[1]) for p in pairs), [(0, 2), (1, 2)])
+
+
+class TestFilletMeshSolid(unittest.TestCase):
+    def testPrismaticPart(self):
+        bracket = Part.makeBox(30, 20, 5).fuse(Part.makeBox(5, 20, 25)).removeSplitter()
+        mesh = _soup(bracket)
+        rounded, rep = Part.filletMeshSolid(mesh, 1.0, report=True)
+        self.assertTrue(rounded.isValid())
+        self.assertGreater(len(rep["filleted"]), 6)
+        self.assertLess(rounded.Volume, bracket.Volume)
+        self.assertTrue(any(f.Surface.TypeId == "Part::GeomCylinder" for f in rounded.Faces))
+
+    def testCurvedRegionsLeftAlone(self):
+        mesh = _soup(Part.makeCylinder(5, 10), deflection=0.3)
