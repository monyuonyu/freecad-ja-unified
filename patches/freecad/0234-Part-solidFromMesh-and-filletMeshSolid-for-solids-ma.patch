+# SPDX-License-Identifier: LGPL-2.1-or-later
+
+"""Solids from triangle meshes (STL) that booleans, sections and fillets can work with.
+
+    shape, report = Part.solidFromMesh(mesh, tolerance=0.01, report=True)
+    rounded, report = Part.filletMeshSolid(shape_or_mesh, 1.0, report=True)
+
+Part.Shape.makeShapeFromMesh + Part.makeSolid gives a solid of thousands of planar
+triangles.  Booleans (common, cut, section) on such solids are slow and fail when the
+triangle soup is not closed, has flipped or duplicated facets, or touches another part
+on coincident faces.  solidFromMesh repairs the mesh first (duplicates, degenerated
+facets, orientation, small holes), sews, makes a closed solid with the right
+orientation, merges coplanar triangles into faces (removeSplitter) and reports what it
+found.  For the booleans use a fuzzy value of about the mesh accuracy, for example
+a.common(b, 0.01), Part.findInterferences(shapes, tolerance=0.01), a.section(b, 0.01).
+"""
+
+import FreeCAD as App
+import Part
+
+__all__ = ["solid_from_mesh", "fillet_mesh_solid"]
+
+
+def _to_mesh(source):
+    import Mesh
+
+    if isinstance(source, str):
+        return Mesh.Mesh(source)
+    if hasattr(source, "Topology") and hasattr(source, "Facets"):
+        return source.copy()
+    if hasattr(source, "Mesh") and hasattr(source.Mesh, "Topology"):
+        return source.Mesh.copy()
+    if isinstance(source, (tuple, list)) and len(source) == 2:
+        return Mesh.Mesh(source)
+    if isinstance(source, Part.Shape):
+        return None
+    raise TypeError("Expected a Mesh.Mesh, a mesh object, (points, facets) or an STL file name")
+
+
+def solid_from_mesh(source, tolerance=0.01, refine=True, fill_holes=20, report=False):
+    """A closed, valid solid from a triangle mesh.  See the module docstring.
+
+    source: Mesh.Mesh, a mesh document object, (points, facets), a file name, or a shape
+    made by makeShapeFromMesh (then only the shape steps are done).
+    tolerance: sewing tolerance (model units, about the mesh accuracy).
+    refine: merge coplanar triangles into one face each (fewer faces: faster, more robust
+    booleans, and edges that can be filleted).
+    fill_holes: fill holes with at most this many boundary edges (0: do not).
+    Returns the solid, or (solid, report) with report=True.  report["problems"] lists
+    what could not be repaired; the solid is then the best that could be made (an open
+    shell gives a Shell, not a Solid)."""
+    info = {"problems": [], "repairs": []}
+    mesh = _to_mesh(source)
+    if mesh is not None:
+        info["facets"] = mesh.CountFacets
+        before = mesh.CountFacets
+        merged = _merge_close_points(mesh, tolerance * 0.1)
+        if merged is not None:
+            mesh, count = merged
+            info["repairs"].append("merged %d points closer than %g" % (count, tolerance * 0.1))
+        mesh.removeDuplicatedPoints()
+        mesh.removeDuplicatedFacets()
+        try:
+            mesh.fixDegenerations(tolerance * 1e-3)
+        except Exception:
+            pass
+        mesh.fixIndices()
+        if mesh.CountFacets != before:
+            info["repairs"].append("removed %d duplicated or degenerated facets" % (before - mesh.CountFacets))
+        flipped = mesh.countNonUniformOrientedFacets()
+        if flipped:
+            mesh.harmonizeNormals()
+            info["repairs"].append("turned %d facets to agree with their neighbours" % flipped)
+        if not mesh.isSolid() and fill_holes:
+            before = mesh.CountFacets
+            try:
+                mesh.fillupHoles(fill_holes, 1)
+            except Exception:
+                pass
+            if mesh.CountFacets != before:
+                info["repairs"].append("filled holes with %d facets" % (mesh.CountFacets - before))
+        nm = mesh.hasNonManifolds()
+        if nm:
+            info["problems"].append("non-manifold edges (more than two facets share an edge)")
+        try:
+            si = mesh.hasSelfIntersections()
+        except Exception:
+            si = False
+        if si:
+            info["problems"].append("the mesh intersects itself")
+        if not mesh.isSolid():
+            info["problems"].append("the mesh is not closed (open edges remain)")
+        shape = Part.Shape()
+        shape.makeShapeFromMesh(mesh.Topology, tolerance, True)
+    else:
+        shape = source
+        info["facets"] = len(shape.Faces)
+    solid = _make_solid(shape, tolerance, info)
+    if refine and solid.ShapeType == "Solid":
+        try:
+            refined = _unify(solid, tolerance)
+            if refined.isValid() and refined.Solids and abs(refined.Volume - solid.Volume) <= solid.Area * tolerance:
+                solid = refined.Solids[0] if len(refined.Solids) == 1 else refined
+                info["repairs"].append("merged coplanar triangles into %d faces" % len(solid.Faces))
+            else:
+                info["problems"].append("merging coplanar triangles failed; kept the triangles")
+        except Exception as e:
+            info["problems"].append("merging coplanar triangles failed (%s); kept the triangles" % e)
+    info["type"] = solid.ShapeType
+    info["faces"] = len(solid.Faces)
+    info["closed"] = bool(solid.isClosed()) if solid.ShapeType in ("Solid", "Shell") else False
+    info["valid"] = bool(solid.isValid())
+    info["volume"] = solid.Volume if solid.ShapeType in ("Solid", "CompSolid", "Compound") else 0.0
+    if not info["valid"]:
+        info["problems"].append("the result is not a valid shape (Shape.check() tells more)")
+    return (solid, info) if report else solid
+
+
+def _merge_close_points(mesh, tol):
+    """(new mesh, number of points merged) when points closer than tol exist (an STL
+    written with a few digits, or from separately rounded facets), else None."""
+    import Mesh
+
+    points, facets = mesh.Topology
+    if tol <= 0 or not points:
+        return None
+    cells = {}
+    index = [0] * len(points)
+    kept = []
+    merged = 0
+    for i, p in enumerate(points):
+        key = (int(p.x // tol), int(p.y // tol), int(p.z // tol))
+        found = -1
+        for dx in (-1, 0, 1):
+            for dy in (-1, 0, 1):
+                for dz in (-1, 0, 1):
+                    for j in cells.get((key[0] + dx, key[1] + dy, key[2] + dz), ()):
+                        if (kept[j] - p).Length <= tol:
+                            found = j
+                            break
+                    if found >= 0:
+                        break
+                if found >= 0:
+                    break
+        if found >= 0:
+            index[i] = found
+            if (kept[found] - p).Length > 0:
+                merged += 1
+            continue
+        index[i] = len(kept)
+        cells.setdefault(key, []).append(len(kept))
+        kept.append(p)
+    if merged == 0:
+        return None
+    new_facets = []
+    for f in facets:
+        t = (index[f[0]], index[f[1]], index[f[2]])
+        if len(set(t)) == 3:
+            new_facets.append(t)
+    return Mesh.Mesh((kept, new_facets)), merged
+
+
+def _unify(solid, tolerance):
+    """Coplanar neighbouring faces merged (removeSplitter with a tolerance: the triangles
+    of an STL are flat only to the precision it was written with)."""
+    try:
+        from Part import ShapeUpgrade
+
+        usd = ShapeUpgrade.UnifySameDomain(solid, True, True, True)
+        usd.setLinearTolerance(tolerance)
+        usd.setAngularTolerance(1e-2)
+        usd.build()
+        shape = usd.shape()
+        if not shape.isValid():
+            shape.fix(tolerance, tolerance, tolerance)
+        return shape
+    except Exception:
+        return solid.removeSplitter()
+
+
+def _make_solid(shape, tolerance, info):
+    shells = shape.Shells
+    if not shells:
+        try:
+            sewed = shape.copy()
+            sewed.sewShape(tolerance)
+            shells = sewed.Shells
+        except Exception:
+            shells = []
+    if not shells:
+        info["problems"].append("no shell could be sewn from the triangles")
+        return shape
+    if len(shells) > 1:
+        info["repairs"].append("%d separate shells, each becomes a solid" % len(shells))
+    solids = []
+    for shell in shells:
+        if not shell.isClosed():
+            info["problems"].append("a shell is open; returned as a shell")
+            solids.append(shell)
+            continue
+        solid = Part.Solid(shell)
+        try:
+            solid.fix(tolerance, tolerance, tolerance)
+        except Exception:
+            pass
+        if solid.Volume < 0:
+            solid.reverse()
+            info["repairs"].append("turned the solid inside out (it was inverted)")
+        solids.append(solid)
+    return solids[0] if len(solids) == 1 else Part.Compound(solids)
+
+
+def _dihedral(shape, edge):
+    """Angle in degrees between the normals of the two faces at an edge, or None."""
+    faces = shape.ancestorsOfType(edge, Part.Face)
+    if len(faces) != 2:
+        return None
+    mid = edge.valueAt((edge.FirstParameter + edge.LastParameter) / 2)
+    normals = []
+    for f in faces:
+        u, v = f.Surface.parameter(mid)
+        n = f.normalAt(u, v)
+        normals.append(n)
+    return normals[0].getAngle(normals[1]) * 180.0 / 3.141592653589793
+
+
+def fillet_mesh_solid(source, radius, edges=None, min_angle=30.0, tolerance=0.01, report=False,
+                      max_seconds=60.0):  # fmt: skip
+    """Round edges of a solid made from a mesh (STL).
+
+    A triangle soup has no edges to fillet: its "edges" are the sides of triangles.  This
+    first makes a solid with solid_from_mesh (coplanar triangles merged into faces), so
+    flat sides become single faces and the sharp edges between them real edges.  Then it
+    fillets the straight edges whose faces meet at more than min_angle degrees (or the
+    edges given: indices into the refined solid's Edges, 0 based).  Edges that make the
+    fillet fail are left sharp and listed in the report.
+
+    Works for prismatic parts (3D printed brackets, plates, boxes).  It cannot round
+    edges on curved regions of the mesh (a cylinder is many narrow flat faces; their
+    edges are below min_angle and left alone) nor edges that run into such regions in a
+    way the fillet cannot follow.  When filleting all edges at once fails, they are tried
+    one by one for at most max_seconds (the rest stay sharp).
+    Returns the shape, or (shape, report) with report=True;
+    report has "filleted", "skipped" (edge indices) and the solid_from_mesh report."""
+    if isinstance(source, Part.Shape) and source.ShapeType == "Solid" and len(source.Faces) < 2000 \
+            and any(len(f.Edges) != 3 for f in source.Faces):  # fmt: skip
+        solid, info = source, {"problems": [], "repairs": []}
+    else:
+        solid, info = solid_from_mesh(source, tolerance=tolerance, refine=True, report=True)
+    if solid.ShapeType != "Solid":
+        raise ValueError("No closed solid could be made from the mesh: %s" % "; ".join(info["problems"]))
+    if edges is None:
+        chosen = []
+        for i, e in enumerate(solid.Edges):
+            if not isinstance(e.Curve, Part.Line):
+                continue
+            angle = _dihedral(solid, e)
+            if angle is not None and angle > min_angle:
+                chosen.append(i)
+    else:
+        chosen = list(edges)
+    result = solid
+    done, skipped = [], []
+    if chosen:
+        try:
+            result = solid.makeFillet(radius, [solid.Edges[i] for i in chosen])
+            if not result.isValid():
+                raise RuntimeError("invalid result")
+            done = list(chosen)
+        except Exception:
+            # one by one, on the original edges (matched by their end points)
+            import time
+
+            result = solid
+            start = time.time()
+            for i in chosen:
+                if time.time() - start > max_seconds:
+                    skipped.append(i)
+                    continue
+                e = solid.Edges[i]
+                ends = (e.Vertexes[0].Point, e.Vertexes[-1].Point)
+                match = None
+                for f in result.Edges:
+                    p = (f.Vertexes[0].Point, f.Vertexes[-1].Point)
+                    if (p[0].isEqual(ends[0], tolerance) and p[1].isEqual(ends[1], tolerance)) or \
+                            (p[0].isEqual(ends[1], tolerance) and p[1].isEqual(ends[0], tolerance)):  # fmt: skip
+                        match = f
+                        break
+                if match is None:
+                    skipped.append(i)
+                    continue
+                try:
+                    trial = result.makeFillet(radius, [match])
+                    if trial.isValid() and trial.Solids:
+                        result = trial.Solids[0] if len(trial.Solids) == 1 else trial
+                        done.append(i)
+                    else:
+                        skipped.append(i)
+                except Exception:
+                    skipped.append(i)
+    info = dict(info)
+    info["filleted"] = done
+    info["skipped"] = skipped
+    return (result, info) if report else result
+
+
+def part_solid_from_mesh(mesh, tolerance=0.01, refine=True, fillHoles=20, report=False):
+    """Part.solidFromMesh: see its doc string."""
+    return solid_from_mesh(mesh, tolerance=tolerance, refine=refine, fill_holes=fillHoles, report=report)
+
+
+def part_fillet_mesh_solid(shape, radius, edges=None, minAngle=30.0, tolerance=0.01, report=False,
+                           maxSeconds=60.0):  # fmt: skip
+    """Part.filletMeshSolid: see its doc string."""
+    return fillet_mesh_solid(shape, radius, edges=edges, min_angle=minAngle, tolerance=tolerance,
+                             report=report, max_seconds=maxSeconds)  # fmt: skip
