 /// Save the document
+namespace
+{
+// A document saved for the user before they chose a place (see Assembly's
+// UtilsAssembly.saveProvisionally): the first save asks for the place, as for a new document
+bool isProvisionallySaved(const App::Document* doc)
+{
+    const QString file = QDir::cleanPath(QString::fromUtf8(doc->FileName.getValue()));
+    const QString dir = QDir::cleanPath(
+        QString::fromStdString(App::Application::getUserAppDataDir()) + QStringLiteral("/Unsaved")
+    );
+    return !file.isEmpty() && file.startsWith(dir + QLatin1Char('/'));
+}
+}  // namespace
+
 bool Document::save()
 {
+    if (isProvisionallySaved(d->_pcDocument)) {
+        return saveAs();
+    }
     if (d->_pcDocument->isSaved()) {
         // Warn if this document was created with an older FreeCAD version
         if (!warnIfOlderVersion()) {
@@ -1733,7 +1751,7 @@ bool Document::saveAs()
 
