+def provisionalDir():
+    """Where documents are kept that were saved for the user before they chose a place.
+    Saving such a document (Std_Save) asks for the place, as for a new document."""
+    import os
+
+    path = os.path.join(App.getUserAppDataDir(), "Unsaved")
+    os.makedirs(path, exist_ok=True)
+    return path
+
+
+def saveProvisionally(doc):
+    """Save a document that was never saved to a provisional place, without asking.
+
+    Links to parts in other documents need a saved document. Instead of stopping the user with
+    "the document must be saved", save it where the user does not have to choose; the first
+    real save asks for the place. Returns True if the document is saved now."""
+    import os
+    import time
+
+    if doc.FileName:
+        return True
+    # Saving renames the document after the file: keep the name the user sees
+    name = "".join("_" if c in '/\\:*?"<>|' else c for c in doc.Label) or doc.Name
+    folder = os.path.join(provisionalDir(), time.strftime("%Y%m%d-%H%M%S-") + doc.Name)
+    os.makedirs(folder, exist_ok=True)
+    path = os.path.join(folder, name + ".FCStd")
+    try:
+        doc.saveAs(path)
+    except Exception as e:
+        App.Console.PrintWarning("Assembly: could not save {} provisionally: {}\n".format(doc.Name, e))
+        return False
+    # Still "not saved" for the user: closing asks to save, and saving asks for the place
+    try:
+        import FreeCADGui
+
+        FreeCADGui.getDocument(doc.Name).Modified = True
+    except Exception:
+        pass
+    return True
+
