+def _measure_overlaps(items, wanted, opt):
+    """The overlaps of the pairs `wanted` ({(name a, name b)}) of items [(name, shape)], all at
+    once in C++ threads (Part.findInterferences: boxes first, then the booleans on all cores;
+    a common at a time here took 9 of the 13 s of a room of 125 parts). The shapes are cut into
+    their solids, so that a shape of many solids is measured solid by solid; the volumes of a
+    pair of parts are added. {(a, b): (volume or None if a boolean failed, centre)}"""
+    names = {n for pair in wanted for n in pair}
+    solids, owner = [], []
+    for n, shape in items:
+        if n not in names:
+            continue
+        for x in shape.Solids or [shape]:
+            solids.append(x)
+            owner.append(n)
+    found = Part.findInterferences(solids, minVolume=opt["interference_mm3"])
+    out = {pair: [0.0, None, False] for pair in wanted}
+    for i, j, volume in found:
+        a, b = owner[i], owner[j]
+        pair = (a, b) if (a, b) in out else (b, a)
+        if a == b or pair not in out:
+            continue
+        if volume < 0:
+            out[pair][2] = True  # this pair of solids could not be measured
+            continue
+        out[pair][0] += volume
+        box = solids[i].BoundBox.intersected(solids[j].BoundBox)
+        out[pair][1] = box.Center if box.isValid() else solids[i].BoundBox.Center
+    result = {}
+    for pair, (volume, center, failed) in out.items():
+        if failed and volume <= opt["interference_mm3"]:
+            result[pair] = None  # measured again, slowly, below
+        else:
+            result[pair] = (volume, center)
+    return result
+
