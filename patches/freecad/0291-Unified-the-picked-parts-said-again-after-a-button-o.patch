diff --git a/src/Mod/Unified/SelectionWordsGui.py b/src/Mod/Unified/SelectionWordsGui.py
index 75c2b6dfb..d2282565b 100644
--- a/src/Mod/Unified/SelectionWordsGui.py
+++ b/src/Mod/Unified/SelectionWordsGui.py
@@ -44,13 +44,31 @@ class Observer:
     def clearSelection(self, *_args):
         pass
 
+    def removePreselection(self, *_args):
+        # The cursor left the model (e.g. onto the bar of tools): the status bar says what is
+        # picked again, instead of nothing
+        self._later()
+
     def show(self):
         self.pending = False
         if editing():
             return  # a sketch or a tool has its own words
         text = current_text()
         if text:
-            show_in_status(translate("Unified", "Picked: {}").format(text))
+            message = translate("Unified", "Picked: {}").format(text)
+            show_in_status(message)
+            # A button of the bar that just went away clears the status bar after this (its
+            # status tip): say it again then, unless something else is said by then
+            QtCore.QTimer.singleShot(400, lambda: _again(message))
+
+
+def _again(message):
+    try:
+        label = Gui.getMainWindow().statusBar().findChild(QtWidgets.QLabel, "actionLabel")
+    except Exception:
+        return
+    if label is not None and not label.text() and current_text():
+        label.setText(message)
 
 
 def show_in_status(text):
