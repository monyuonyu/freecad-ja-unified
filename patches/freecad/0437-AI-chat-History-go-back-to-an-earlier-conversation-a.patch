+class _History:
+    """Earlier conversations: <user data>/ai/chats/index.json (id, title, when) and <id>.html (what was
+    shown). The conversation itself is kept by Claude (resumed by its session id)"""
+
+    KEEP = 30
+
+    def _dir(self):
+        d = os.path.join(_datadir(), "chats")
+        os.makedirs(d, exist_ok=True)
+        return d
+
+    def _index(self):
+        try:
+            with open(os.path.join(self._dir(), "index.json"), encoding="utf-8") as f:
+                return json.load(f)
+        except (OSError, ValueError):
+            return []
+
+    def _write(self, items):
+        path = os.path.join(self._dir(), "index.json")
+        with open(path + ".tmp", "w", encoding="utf-8") as f:
+            json.dump(items, f, ensure_ascii=False, indent=1)
+        os.replace(path + ".tmp", path)
+
+    def items(self):
+        return self._index()
+
+    def title(self, sid):
+        return next((it.get("title") for it in self._index() if it["id"] == sid), None)
+
+    def html(self, sid):
+        try:
+            with open(os.path.join(self._dir(), _safe_name(sid) + ".html"), encoding="utf-8") as f:
+                return f.read()
+        except OSError:
+            return ""
+
+    def save(self, sid, title, html):
+        import time
+
+        with open(os.path.join(self._dir(), _safe_name(sid) + ".html"), "w", encoding="utf-8") as f:
+            f.write(html)
+        items = [it for it in self._index() if it["id"] != sid]
+        items.insert(0, {"id": sid, "title": title, "when": time.strftime("%Y-%m-%d %H:%M")})
+        for old in items[self.KEEP:]:
+            try:
+                os.remove(os.path.join(self._dir(), _safe_name(old["id"]) + ".html"))
+            except OSError:
+                pass
+        self._write(items[: self.KEEP])
+
+    def rename(self, old, new):
+        """The session id can change when a conversation is resumed: keep one entry"""
+        if not old or old == new:
+            return
+        items = self._index()
+        for it in items:
+            if it["id"] == old:
+                it["id"] = new
+                try:
+                    os.replace(os.path.join(self._dir(), _safe_name(old) + ".html"),
+                               os.path.join(self._dir(), _safe_name(new) + ".html"))
+                except OSError:
+                    pass
+        self._write(items)
+
+
+def _safe_name(sid):
+    return "".join(c for c in str(sid) if c.isalnum() or c in "-_")[:80] or "chat"
+
+
+history = _History()
+
