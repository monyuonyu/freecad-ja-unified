     def on_new(self):
+        self._save()
+        self._switch(None, "")
+        self._note(translate("AIChat", "New conversation. The previous one is in History."))
+
+    def _switch(self, session_id, html):
+        """Show another conversation (html) and have the AI go on with it (None: a new one)"""
         self.queue.clear()
         self.codes.clear()
         self.view.clear()
         AITools.reset()
+        self.session_id = session_id
+        self.title = history.title(session_id) if session_id else None
+        if html:
+            self.view.setHtml(html)
+            self.view.moveCursor(QtGui.QTextCursor.End)
         if self.proc is not None and self.proc.state() != QtCore.QProcess.NotRunning:
             self.ready = False
             self.resetting = True
             self.later.clear()
             self._set_busy(False)
-            self.send_json(type="reset")   # 仲介役が走っている回を止めてから始め直す
-        self._note(translate("AIChat", "New conversation."))
+            # 仲介役が走っている回を止めてから始め直す（resume: その会話の続きから）
+            if session_id:
+                self.send_json(type="resume", id=session_id)
+            else:
+                self.send_json(type="reset")
+        elif session_id:
+            self.pending_resume = session_id  # 仲介役を始めたら最初に頼む
+
+    def _save(self):
+        if self.session_id:
+            history.save(self.session_id, self.title or "", self.view.toHtml())
+
+    def _fill_history(self):
+        self.history_menu.clear()
+        items = history.items()
+        if not items:
+            a = self.history_menu.addAction(translate("AIChat", "No earlier conversations yet"))
+            a.setEnabled(False)
+            return
+        for it in items:
+            text = "%s  —  %s" % (it.get("when", ""), it.get("title") or translate("AIChat", "(untitled)"))
+            a = self.history_menu.addAction(text)
+            if it["id"] == self.session_id:
+                a.setCheckable(True)
+                a.setChecked(True)
+                a.setEnabled(False)
+            else:
+                a.triggered.connect(lambda _=False, sid=it["id"]: self.on_history(sid))
+
+    def on_history(self, session_id):
+        if self.busy:
+            self._note(translate("AIChat", "Stop the AI first, then go back to an earlier conversation."))
+            return
+        self._save()
+        self._switch(session_id, history.html(session_id))
+        self._note(translate("AIChat", "Going on with this conversation."))
 
     def shutdown(self):
+        try:
+            self._save()
+        except Exception:
+            pass
         if self.proc is not None and self.proc.state() != QtCore.QProcess.NotRunning:
             self.proc.closeWriteChannel()
             if not self.proc.waitForFinished(3000):
