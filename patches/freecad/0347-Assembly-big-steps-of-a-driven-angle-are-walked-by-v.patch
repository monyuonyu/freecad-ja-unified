+// The value a driven joint is driven to: a revolute's angle (degrees) or a slider's distance
+// (mm); NaN for a joint that is not driven
+double driveValue(const App::DocumentObject* joint)
+{
+    const char* name = isAngleDriven(joint) ? "Angle" : isDistanceDriven(joint) ? "SlideDistance" : nullptr;
+    auto* prop = name ? joint->getPropertyByName<App::PropertyFloat>(name) : nullptr;
+    return prop ? prop->getValue() : std::numeric_limits<double>::quiet_NaN();
+}
