+// A driven joint's first placement at a given drive value (as jointPlacementFromProp at its own)
+Base::Placement drivenPlacement1(App::DocumentObject* joint, double value)
+{
+    Base::Placement plc = App::GeoFeature::getPlacementFromProp(joint, "Placement1");
+    if (isAngleDriven(joint)) {
+        return plc * Base::Placement(Base::Vector3d(), Base::Rotation(Base::Vector3d(0, 0, 1), Base::toRadians(value)));
+    }
+    return plc * Base::Placement(Base::Vector3d(0, 0, value), Base::Rotation());
