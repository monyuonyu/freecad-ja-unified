diff --git a/src/Mod/Unified/DesignCheck.py b/src/Mod/Unified/DesignCheck.py
index 01de44046..f3337173b 100644
--- a/src/Mod/Unified/DesignCheck.py
+++ b/src/Mod/Unified/DesignCheck.py
@@ -1142,6 +1142,66 @@ def sweep(doc=None, moving=(), axis=((0, 0, 0), (0, 0, 1)), start=0.0, end=90.0,
             "hits": hits, "first": hits[0]["angle"] if hits else None}  # fmt: skip
 
 
+def sweep_joint(joint, start=0.0, end=360.0, step=10.0, progress=None, **options):
+    """Turn the assembly's revolute joint `joint` from `start` to `end` degrees by `step`, solve
+    the assembly at each angle (the parts move as the joints and formulas say: a cam's valve,
+    a rocker) and check all the parts for overlaps there. The joint's angle (and its formula)
+    is put back. progress(i, n, angle) is called before each angle; returning True stops.
+    ignore_pairs and one items as in interferences. Returns {"angles": [...], "hits": [{"angle",
+    "a", "b", "names", "volume", "center"}], "always": [[a, b]] (pairs overlapping at every
+    angle: likely on purpose), "failed": [angles where the joints did not hold], "first":
+    angle or None (of a pair not always overlapping), "stopped": bool}"""
+    import MotionVideo
+
+    if getattr(joint, "JointType", "") != "Revolute":
+        raise ValueError("sweep_joint: %s is not a revolute joint" % joint.Label)
+    if step <= 0:
+        raise ValueError("sweep_joint: the step must be more than 0")
+    doc = joint.Document
+    angles = []
+    a = float(start)
+    while (a < end - 1e-9) if end >= start else (a > end + 1e-9):
+        angles.append(round(a, 9))
+        a += step if end >= start else -step
+    angles.append(float(end))
+    was = joint.Angle.Value
+    was_formula = MotionVideo.formula(joint, "Angle")
+    was_driven = bool(getattr(joint, "AngleDriven", False))
+    hits, failed, seen, stopped = [], [], {}, False
+    try:
+        if not was_driven:
+            joint.AngleDriven = True
+        for i, angle in enumerate(angles):
+            if progress is not None and progress(i, len(angles), angle):
+                stopped = True
+                break
+            if not MotionVideo.pose(joint, angle):
+                failed.append(angle)
+            for f in interferences(doc, **options):
+                if f["volume"] is None:
+                    continue
+                hits.append(dict(f, angle=angle))
+                key = tuple(sorted(f["names"]))
+                seen.setdefault(key, set()).add(angle)
+    finally:
+        if was_formula:
+            joint.setExpression("Angle", was_formula)
+        else:
+            joint.setExpression("Angle", None)
+            joint.Angle = was
+        if not was_driven:
+            joint.AngleDriven = False
+        doc.recompute()
+        asm = MotionVideo.assembly_of(joint)
+        if asm is not None:
+            asm.solve()
+    done = angles[:len(angles) if not stopped else i]
+    always = [list(k) for k, at in seen.items() if len(done) > 1 and len(at) == len(done)]
+    moving = [h for h in hits if sorted(h["names"]) not in always]
+    return {"angles": done, "hits": hits, "always": always, "failed": failed,
+            "first": moving[0]["angle"] if moving else None, "stopped": stopped}  # fmt: skip
+
+
 def interferences(doc=None, **options):
     """Only the overlaps of the parts, as the design check finds them (the same measure from a
     script): [{"a", "b" (labels), "names", "volume" (mm³; None: could not be checked),
@@ -1253,9 +1313,22 @@ def cli_main():
             raise RuntimeError("--design-check sweep: give the motion with --sweep motion.json")
         with open(spec_file, encoding="utf-8-sig") as f:
             spec = json.load(f)
-        known = {"moving", "axis", "from", "to", "step", "carry"}
+        known = {"moving", "axis", "from", "to", "step", "carry", "joint"}
         if set(spec) - known:
             raise RuntimeError("--sweep: unknown keys %s (known: %s)" % (sorted(set(spec) - known), sorted(known)))
+        if spec.get("joint"):
+            # an assembly's revolute joint turned, the parts moving as the joints and formulas say
+            name = spec["joint"]
+            joint = doc.getObject(name) or next((o for o in doc.Objects if o.Label == name), None)
+            if joint is None:
+                raise RuntimeError("--sweep: no joint named %s" % name)
+            result = sweep_joint(joint, float(spec.get("from", 0)), float(spec.get("to", 360)),
+                                 float(spec.get("step", 10)), **options)  # fmt: skip
+            print(json.dumps({"sweep": result}, ensure_ascii=False, indent=1, default=lambda v: list(v)))
+            sys.stdout.flush()
+            if [h for h in result["hits"] if sorted(h["names"]) not in result["always"]]:
+                sys.exit(1)
+            return
         moving = spec.get("moving") or []
         axis = spec.get("axis") or [0, 0, 0, 0, 0, 1]
         if isinstance(moving, str):
