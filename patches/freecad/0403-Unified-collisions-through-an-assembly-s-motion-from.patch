diff --git a/src/Mod/Unified/SweepCheckGui.py b/src/Mod/Unified/SweepCheckGui.py
new file mode 100644
index 000000000..d2cc7b8fc
--- /dev/null
+++ b/src/Mod/Unified/SweepCheckGui.py
@@ -0,0 +1,226 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""Collisions through a motion, from the screen: the picked revolute joint is turned step by
+step, the assembly solved at each angle (the parts move as the joints and formulas say), and
+every pair of parts checked for overlaps (DesignCheck.sweep_joint). A hit in the list turns the
+joint to that angle and picks the two parts; a pair that overlaps at every angle can be marked
+as overlapping on purpose (DesignCheck.allow_overlap, kept in the file).
+"""
+
+import FreeCAD as App
+import FreeCADGui as Gui
+from PySide import QtCore, QtWidgets
+
+import DesignCheck
+import MotionVideo
+
+translate = App.Qt.translate
+
+
+def QT_TRANSLATE_NOOP(context, text):
+    return text
+
+
+def picked_joint():
+    sel = Gui.Selection.getSelection()
+    if len(sel) == 1 and getattr(sel[0], "JointType", "") == "Revolute":
+        return sel[0]
+    return None
+
+
+class SweepPanel:
+    def __init__(self, joint):
+        import MotionVideoGui
+
+        self.joint = joint
+        self.doc = joint.Document
+        self.was = joint.Angle.Value
+        self.was_formula = MotionVideo.formula(joint, "Angle")
+        self.was_driven = bool(getattr(joint, "AngleDriven", False))
+        self.posed = False
+        self.result = None
+        self.running = False
+        self.stop = False
+        self.form = QtWidgets.QWidget()
+        self.form.setWindowTitle(translate("Unified_SweepCheck", "Collisions Through the Motion"))
+        lay = QtWidgets.QVBoxLayout(self.form)
+        intro = QtWidgets.QLabel(translate(
+            "Unified_SweepCheck",
+            "The joint “{}” is turned step by step; at each angle the assembly is solved and all the "
+            "parts are checked for overlaps.").format(joint.Label))  # fmt: skip
+        intro.setWordWrap(True)
+        lay.addWidget(intro)
+        grid = QtWidgets.QFormLayout()
+
+        def number(value, low, high, suffix):
+            box = QtWidgets.QDoubleSpinBox()
+            box.setRange(low, high)
+            box.setDecimals(1)
+            box.setValue(value)
+            box.setSuffix(suffix)
+            return box
+
+        self.start = number(0, -36000, 36000, "°")
+        self.end = number(MotionVideoGui.full_turn(joint), -36000, 36000, "°")
+        self.step = number(10, 0.1, 360, "°")
+        grid.addRow(translate("Unified_SweepCheck", "From"), self.start)
+        grid.addRow(translate("Unified_SweepCheck", "To"), self.end)
+        grid.addRow(translate("Unified_SweepCheck", "Every"), self.step)
+        lay.addLayout(grid)
+        row = QtWidgets.QHBoxLayout()
+        self.run_btn = QtWidgets.QPushButton(translate("Unified_SweepCheck", "Check"))
+        self.run_btn.clicked.connect(self.run)
+        row.addWidget(self.run_btn)
+        self.status = QtWidgets.QLabel("")
+        self.status.setWordWrap(True)
+        row.addWidget(self.status, 1)
+        lay.addLayout(row)
+        self.tree = QtWidgets.QTreeWidget()
+        self.tree.setHeaderLabels([translate("Unified_SweepCheck", "Angle"), translate("Unified_SweepCheck", "Parts"),
+                                   translate("Unified_SweepCheck", "Overlap")])  # fmt: skip
+        self.tree.setRootIsDecorated(False)
+        self.tree.itemClicked.connect(self.show_hit)
+        lay.addWidget(self.tree, 1)
+        self.allow_btn = QtWidgets.QPushButton(translate("Unified_SweepCheck", "These two may overlap (on purpose)"))
+        self.allow_btn.setEnabled(False)
+        self.allow_btn.clicked.connect(self.allow)
+        lay.addWidget(self.allow_btn)
+        self.tree.itemSelectionChanged.connect(
+            lambda: self.allow_btn.setEnabled(bool(self.tree.selectedItems()) and not self.running))
+
+    # -- running
+    def run(self):
+        if self.running:
+            self.stop = True
+            return
+        self.put_back()
+        self.running, self.stop = True, False
+        self.run_btn.setText(translate("Unified_SweepCheck", "Stop"))
+        self.tree.clear()
+        QtWidgets.QApplication.setOverrideCursor(QtCore.Qt.WaitCursor)
+
+        def progress(i, n, angle):
+            self.status.setText(translate("Unified_SweepCheck", "{0:g}° ({1} of {2})").format(angle, i + 1, n))
+            QtWidgets.QApplication.processEvents()
+            return self.stop
+
+        try:
+            self.result = DesignCheck.sweep_joint(self.joint, self.start.value(), self.end.value(),
+                                                  self.step.value(), progress=progress)  # fmt: skip
+        except Exception as e:
+            self.status.setText(str(e))
+            return
+        finally:
+            QtWidgets.QApplication.restoreOverrideCursor()
+            self.running = False
+            self.run_btn.setText(translate("Unified_SweepCheck", "Check"))
+        self.fill()
+
+    def fill(self):
+        r = self.result
+        always = {tuple(p) for p in r["always"]}
+        moving = [h for h in r["hits"] if tuple(sorted(h["names"])) not in always]
+        for h in moving:
+            item = QtWidgets.QTreeWidgetItem(["%g°" % h["angle"], "%s × %s" % (h["a"], h["b"]), "%.1f mm³" % h["volume"]])
+            item.setData(0, QtCore.Qt.UserRole, (h["angle"], list(h["names"])))
+            self.tree.addTopLevelItem(item)
+        for names in sorted(always):
+            a, b = (self.doc.getObject(n) for n in names)
+            item = QtWidgets.QTreeWidgetItem([translate("Unified_SweepCheck", "always"), "%s × %s" % (a.Label, b.Label),
+                                              translate("Unified_SweepCheck", "at every angle")])  # fmt: skip
+            item.setData(0, QtCore.Qt.UserRole, (None, list(names)))
+            self.tree.addTopLevelItem(item)
+        for k in range(3):
+            self.tree.resizeColumnToContents(k)
+        text = translate("Unified_SweepCheck", "{0} angles checked").format(len(r["angles"]))
+        if r["stopped"]:
+            text += translate("Unified_SweepCheck", " (stopped)")
+        if r["first"] is not None:
+            text += translate("Unified_SweepCheck", "; first collision at {0:g}°").format(r["first"])
+        elif not moving:
+            text += translate("Unified_SweepCheck", "; no collision through the motion")
+        if always:
+            text += translate("Unified_SweepCheck", "; {0} pairs overlap at every angle (on purpose?)").format(len(always))
+        if r["failed"]:
+            text += translate("Unified_SweepCheck", "; the joints did not hold at {0} angles (e.g. {1:g}°)").format(
+                len(r["failed"]), r["failed"][0])  # fmt: skip
+        self.status.setText(text)
+
+    # -- looking at a hit
+    def show_hit(self, item, _column=0):
+        angle, names = item.data(0, QtCore.Qt.UserRole)
+        if angle is not None and not self.running:
+            if not self.joint.AngleDriven:
+                self.joint.AngleDriven = True
+            MotionVideo.pose(self.joint, angle)
+            self.posed = True
+        Gui.Selection.clearSelection()
+        for n in names:
+            o = self.doc.getObject(n)
+            if o is not None:
+                Gui.Selection.addSelection(o)
+
+    def allow(self):
+        items = self.tree.selectedItems()
+        if not items:
+            return
+        _, names = items[0].data(0, QtCore.Qt.UserRole)
+        a, b = (self.doc.getObject(n) for n in names)
+        self.doc.openTransaction(translate("Unified_SweepCheck", "Parts that may overlap"))
+        DesignCheck.allow_overlap(a, b)
+        self.doc.commitTransaction()
+        # the pair's rows go
+        for k in reversed(range(self.tree.topLevelItemCount())):
+            if sorted(self.tree.topLevelItem(k).data(0, QtCore.Qt.UserRole)[1]) == sorted(names):
+                self.tree.takeTopLevelItem(k)
+
+    def put_back(self):
+        if not self.posed:
+            return
+        if self.was_formula:
+            self.joint.setExpression("Angle", self.was_formula)
+        else:
+            self.joint.setExpression("Angle", None)
+            self.joint.Angle = self.was
+        if not self.was_driven:
+            self.joint.AngleDriven = False
+        self.doc.recompute()
+        asm = MotionVideo.assembly_of(self.joint)
+        if asm is not None:
+            asm.solve()
+        self.posed = False
+
+    def getStandardButtons(self):
+        return QtWidgets.QDialogButtonBox.Close
+
+    def reject(self):
+        if self.running:
+            self.stop = True
+            return False
+        self.put_back()
+        Gui.Selection.clearSelection()
+        Gui.Control.closeDialog()
+        return True
+
+
+class SweepCheckCommand:
+    def GetResources(self):
+        return {
+            "Pixmap": "Assembly_CreateJointRevolute",
+            "MenuText": QT_TRANSLATE_NOOP("Unified_SweepCheck", "Collisions Through the Motion"),
+            "ToolTip": QT_TRANSLATE_NOOP(
+                "Unified_SweepCheck",
+                "Turn the picked revolute joint step by step and check, at each angle, whether any "
+                "parts overlap (the assembly moves as its joints and formulas say)",
+            ),
+        }
+
+    def IsActive(self):
+        return picked_joint() is not None and not Gui.Control.activeDialog()
+
+    def Activated(self):
+        joint = picked_joint()
+        if joint is not None:
+            Gui.Control.showDialog(SweepPanel(joint))
+
+
+Gui.addCommand("Unified_SweepCheck", SweepCheckCommand())
