+class SweepJointTest(unittest.TestCase):
+    def test_parts_moved_by_the_joints_are_checked_at_each_angle(self):
+        # the sweep turned parts rigidly; an assembly's parts move as the joints say (asked to be
+        # used from the screen, 0.8.8)
+        import DesignCheck
+        import MotionVideo
+
+        doc, sheet, asm, piston, r, L = build(revolute_drive=True)
+        try:
+            drive = doc.getObject("Drive")
+            rod = doc.getObject("Rod")
+            MotionVideo.pose(drive, 90)
+            c = rod.Shape.BoundBox.Center
+            stop = doc.addObject("Part::Box", "Stop")   # outside the assembly: stands still
+            stop.Length = stop.Width = stop.Height = 2
+            stop.Placement.Base = c - App.Vector(1, 1, 1)
+            MotionVideo.pose(drive, 0)
+            doc.recompute()
+            before = drive.Angle.Value
+            got = DesignCheck.sweep_joint(drive, 0, 180, 30)
+            stops = sorted({h["angle"] for h in got["hits"] if "Stop" in h["names"]})
+            self.assertIn(90.0, stops)
+            self.assertNotIn(0.0, stops)
+            self.assertNotIn(180.0, stops)
+            self.assertEqual(got["angles"], [0, 30, 60, 90, 120, 150, 180])
+            self.assertEqual(got["failed"], [])
+            self.assertAlmostEqual(drive.Angle.Value, before)  # put back
+            self.assertNotIn(["Rod", "Stop"], got["always"])
+            # stopped from the progress
+            got = DesignCheck.sweep_joint(drive, 0, 180, 30, progress=lambda i, n, a: i == 2)
