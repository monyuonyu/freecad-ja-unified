diff --git a/src/Mod/Unified/DimensionLabels.py b/src/Mod/Unified/DimensionLabels.py
new file mode 100644
index 000000000..5d5ae744a
--- /dev/null
+++ b/src/Mod/Unified/DimensionLabels.py
@@ -0,0 +1,504 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""形の上の寸法 (dimensions on the model): the numbers that drive the picked thing, and where on
+the model each one belongs.
+
+Pick a part or a step of it (a face in the 3D view, or the step in the history): its driving
+numbers (a Pad's length, the dimensions of its sketch, a hole's diameter and depth, a fillet's
+radius, a pattern's count and spacing, a box's sizes, a push/pull's distance) are shown as labels
+on the model next to the geometry they drive (DimensionLabelsGui.py). Click one, type, Enter: the
+model is recomputed. A number, a quantity with a unit, arithmetic, or "=" and an expression.
+
+No Qt here: TestDimensionLabels.py tests it headless.
+"""
+
+import FreeCAD as App
+import Part
+
+import PushPull as PP
+
+
+def QT_TRANSLATE_NOOP(context, text):
+    return text
+
+
+# Names of the numbers (translated by the GUI in the context "Unified_Dimensions")
+NAMES = {
+    "Length": QT_TRANSLATE_NOOP("Unified_Dimensions", "Length"),
+    "Length2": QT_TRANSLATE_NOOP("Unified_Dimensions", "Second length"),
+    "Depth": QT_TRANSLATE_NOOP("Unified_Dimensions", "Depth"),
+    "Diameter": QT_TRANSLATE_NOOP("Unified_Dimensions", "Diameter"),
+    "Radius": QT_TRANSLATE_NOOP("Unified_Dimensions", "Radius"),
+    "Radius1": QT_TRANSLATE_NOOP("Unified_Dimensions", "Bottom radius"),
+    "Radius2": QT_TRANSLATE_NOOP("Unified_Dimensions", "Top radius"),
+    "Size": QT_TRANSLATE_NOOP("Unified_Dimensions", "Chamfer size"),
+    "Value": QT_TRANSLATE_NOOP("Unified_Dimensions", "Thickness"),
+    "Width": QT_TRANSLATE_NOOP("Unified_Dimensions", "Width"),
+    "Height": QT_TRANSLATE_NOOP("Unified_Dimensions", "Height"),
+    "Angle": QT_TRANSLATE_NOOP("Unified_Dimensions", "Angle"),
+    "Occurrences": QT_TRANSLATE_NOOP("Unified_Dimensions", "Count"),
+    "Offset": QT_TRANSLATE_NOOP("Unified_Dimensions", "Spacing"),
+    "LengthFwd": QT_TRANSLATE_NOOP("Unified_Dimensions", "Length"),
+    "Distance": QT_TRANSLATE_NOOP("Unified_Dimensions", "Distance"),
+    "constraint": QT_TRANSLATE_NOOP("Unified_Dimensions", "Sketch dimension"),
+}
+QT_TRANSLATE_NOOP("Unified_Dimensions", "Change a dimension")  # the undo step
+
+MAX_LABELS = 16
+
+
+class Dim:
+    """One driving number: the object and its property (or the sketch and its constraint),
+    the kind ("length", "angle", "count"), the prefix shown before it, and where it goes."""
+
+    def __init__(self, obj, prop, anchor, kind="length", prefix="", index=None, name=""):
+        self.obj = obj
+        self.prop = prop
+        self.index = index
+        self.anchor = App.Vector(anchor)
+        self.kind = kind
+        self.prefix = prefix
+        self.name = name  # a sketch dimension's own name, if it has one
+        if index is not None:
+            c = obj.Constraints[index]
+            self.path = ".Constraints." + c.Name if c.Name else ".Constraints[{}]".format(index)
+        else:
+            self.path = prop
+
+    @property
+    def value(self):
+        if self.index is not None:
+            return float(self.obj.getDatum(self.index).Value)
+        v = getattr(self.obj, self.prop)
+        return float(getattr(v, "Value", v))
+
+    @property
+    def expression(self):
+        try:
+            for path, expr in self.obj.ExpressionEngine:
+                if path.lstrip(".") == self.path.lstrip("."):
+                    return expr
+                if self.index is not None and path.lstrip(".") == "Constraints[{}]".format(self.index):
+                    return expr
+        except Exception:
+            pass
+        return None
+
+    def text(self):
+        """What the label shows: ⌀10, R2, 30°, ×4, 12.5 mm (ƒ in front when an expression sets it)."""
+        v = self.value
+        if self.kind == "count":
+            body = "×{}".format(int(round(v)))
+        elif self.kind == "angle":
+            body = "{}°".format(_fmt(v))
+        elif self.prefix:
+            body = "{}{}".format(self.prefix, _fmt(v))
+        else:
+            body = "{} mm".format(_fmt(v))
+        return ("ƒ " + body) if self.expression else body
+
+    def edit_text(self):
+        """What the field starts with when the label is clicked."""
+        expr = self.expression
+        if expr:
+            return "=" + expr
+        v = self.value
+        if self.kind == "count":
+            return str(int(round(v)))
+        if self.kind == "angle":
+            return "{} °".format(_fmt(v))
+        return "{} mm".format(_fmt(v))
+
+    def __repr__(self):
+        return "<Dim {}.{} {}>".format(self.obj.Name, self.path, self.text())
+
+
+def _fmt(value):
+    text = "{:.3f}".format(value).rstrip("0").rstrip(".")
+    return "0" if text in ("-0", "") else text
+
+
+def _is(obj, type_name):
+    try:
+        return obj.isDerivedFrom(type_name)
+    except Exception:
+        return False
+
+
+def shape_frame(obj):
+    """Placement from the coordinates of the object's shape (a body's coordinates for its steps
+    and sketches) to the global ones."""
+    body = PP._body_of(obj)
+    if body is not None and body is not obj:
+        try:
+            return body.getGlobalPlacement()
+        except Exception:
+            return App.Placement()
+    try:
+        return obj.getGlobalPlacement().multiply(obj.Placement.inverse())
+    except Exception:
+        return App.Placement()
+
+
+# --------------------------------------------------------------------------- per kind of object
+
+
+def _sketch_dims(sketch, frame=None):
+    """The driving dimensions of a sketch, each in the middle of what it measures."""
+    if frame is None:
+        frame = shape_frame(sketch)
+    to_global = frame.multiply(sketch.Placement)
+    out = []
+
+    def point(geo, pos):
+        if pos == 0:  # the line itself: its middle
+            a = App.Vector(sketch.getPoint(geo, 1))
+            b = App.Vector(sketch.getPoint(geo, 2))
+            return (a + b) * 0.5
+        return App.Vector(sketch.getPoint(geo, pos))
+
+    for i, c in enumerate(sketch.Constraints):
+        if c.Type not in ("Distance", "DistanceX", "DistanceY", "Radius", "Diameter", "Angle"):
+            continue
+        if not c.Driving or getattr(c, "InVirtualSpace", False) or not getattr(c, "IsActive", True):
+            continue
+        try:
+            if c.Type in ("Radius", "Diameter"):
+                g = sketch.Geometry[c.First]
+                r = g.Radius
+                p = App.Vector(g.Center) + App.Vector(0.7071, 0.7071, 0) * r
+                prefix = "R" if c.Type == "Radius" else "⌀"
+                out.append(Dim(sketch, "Constraints", to_global.multVec(p), "length", prefix, i, c.Name))
+                continue
+            if c.Type == "Angle":
+                p = point(c.First, 0) if c.FirstPos == 0 else point(c.First, c.FirstPos)
+                out.append(Dim(sketch, "Constraints", to_global.multVec(p), "angle", "", i, c.Name))
+                continue
+            if c.Second == -2000:
+                if c.FirstPos == 0:
+                    p = point(c.First, 0)
+                else:
+                    p = point(c.First, c.FirstPos) * 0.5
+            else:
+                a = point(c.First, c.FirstPos)
+                if c.SecondPos == 0:
+                    s = App.Vector(sketch.getPoint(c.Second, 1))
+                    e = App.Vector(sketch.getPoint(c.Second, 2))
+                    d = e - s
+                    t = 0.0 if d.Length < 1e-12 else (a - s).dot(d) / d.dot(d)
+                    b = s + d * t
+                else:
+                    b = point(c.Second, c.SecondPos)
+                p = (a + b) * 0.5
+            out.append(Dim(sketch, "Constraints", to_global.multVec(p), "length", "", i, c.Name))
+        except Exception:
+            continue
+    return out
+
+
+def _profile(feature):
+    try:
+        obj, subs = feature.Profile
+    except Exception:
+        return None, None
+    if obj is None:
+        return None, None
+    if _is(obj, "Sketcher::SketchObject") and not any(subs):
+        return obj, obj.Shape
+    try:
+        return obj, obj.Shape.getElement(subs[0])
+    except Exception:
+        return obj, None
+
+
+def _extrusion_dims(feature, frame, with_sketch=True):
+    out = []
+    sketch, profile = _profile(feature)
+    plane = PP._profile_plane(feature)
+    if profile is not None and plane is not None and profile.Edges:
+        p0, n0 = plane
+        try:
+            tool = feature.AddSubShape
+            side = (tool.CenterOfMass - p0).dot(n0) if not tool.isNull() else 1.0
+        except Exception:
+            side = 1.0
+        e = n0 * (1 if side >= 0 else -1)
+        edge = max(profile.Edges, key=lambda ed: ed.BoundBox.XMax + ed.BoundBox.YMax + ed.BoundBox.ZMax)
+        mid = edge.valueAt(sum(edge.ParameterRange) / 2)
+        if feature.Type in ("Length", "TwoLengths") or feature.Type == "?TwoLengths":
+            length = float(feature.Length.Value)
+            if getattr(feature, "Midplane", False):
+                anchor = mid + e * (length / 4)
+            else:
+                anchor = mid + e * (length / 2)
+            out.append(Dim(feature, "Length", frame.multVec(anchor)))
+            if "TwoLengths" in feature.Type:
+                out.append(Dim(feature, "Length2", frame.multVec(mid - e * (float(feature.Length2.Value) / 2))))
+    if with_sketch and sketch is not None and _is(sketch, "Sketcher::SketchObject"):
+        out += _sketch_dims(sketch, frame)
+    return out
+
+
+def _hole_dims(hole, frame):
+    out = []
+    sketch, _profile_shape = _profile(hole)
+    if sketch is None or not _is(sketch, "Sketcher::SketchObject"):
+        return out
+    pl = sketch.Placement
+    n = pl.Rotation.multVec(App.Vector(0, 0, 1))
+    down = n * (1 if hole.Reversed else -1)
+    centers = [App.Vector(g.Center) for i, g in enumerate(sketch.Geometry) if hasattr(g, "Center") and not sketch.getConstruction(i)]
+    centers += [App.Vector(g.X, g.Y, 0) for i, g in enumerate(sketch.Geometry) if type(g).__name__ == "Point"]
+    if not centers:
+        return out
+    c = pl.multVec(centers[0])
+    r = float(hole.Diameter.Value) / 2
+    across = pl.Rotation.multVec(App.Vector(0.7071, 0.7071, 0))
+    out.append(Dim(hole, "Diameter", frame.multVec(c + across * r), "length", "⌀"))
+    if hole.DepthType == "Dimension":
+        out.append(Dim(hole, "Depth", frame.multVec(c + across * r + down * float(hole.Depth.Value) / 2)))
+    return out
+
+
+def _edge_mid(obj, names):
+    for name in names or []:
+        if not name.startswith("Edge"):
+            continue
+        try:
+            edge = obj.Shape.getElement(name)
+            return edge.valueAt(sum(edge.ParameterRange) / 2)
+        except Exception:
+            continue
+    return None
+
+
+def _dress_up_dims(feature, frame, prop, prefix=""):
+    try:
+        base, subs = feature.Base
+    except Exception:
+        return []
+    p = _edge_mid(base, subs)
+    if p is None:
+        try:
+            p = base.Shape.getElement(subs[0]).CenterOfMass
+        except Exception:
+            p = feature.Shape.BoundBox.Center
+    return [Dim(feature, prop, frame.multVec(p), "length", prefix)]
+
+
+def _pattern_dims(feature, frame):
+    try:
+        center = feature.Originals[0].AddSubShape.BoundBox.Center
+    except Exception:
+        center = feature.Shape.BoundBox.Center
+    out = [Dim(feature, "Occurrences", frame.multVec(center), "count")]
+    if _is(feature, "PartDesign::LinearPattern"):
+        mode = getattr(feature, "Mode", "Extent")
+        prop = "Offset" if mode == "Spacing" and hasattr(feature, "Offset") else "Length"
+        out.append(Dim(feature, prop, frame.multVec(center)))
+    elif _is(feature, "PartDesign::PolarPattern"):
+        out.append(Dim(feature, "Angle", frame.multVec(center), "angle"))
+    return out
+
+
+def _box_dims(obj, frame):
+    pl = obj.Placement
+    l, w, h = float(obj.Length.Value), float(obj.Width.Value), float(obj.Height.Value)
+    to = frame.multiply(pl)
+    return [
+        Dim(obj, "Length", to.multVec(App.Vector(l / 2, 0, 0))),
+        Dim(obj, "Width", to.multVec(App.Vector(0, w / 2, 0))),
+        Dim(obj, "Height", to.multVec(App.Vector(0, 0, h / 2))),
+    ]
+
+
+def _cylinder_dims(obj, frame):
+    to = frame.multiply(obj.Placement)
+    r, h = float(obj.Radius.Value), float(obj.Height.Value)
+    return [
+        Dim(obj, "Radius", to.multVec(App.Vector(r * 0.7071, r * 0.7071, h)), "length", "R"),
+        Dim(obj, "Height", to.multVec(App.Vector(r, 0, h / 2))),
+    ]
+
+
+def dimensions_of(obj, with_sketch=True):
+    """The driving numbers of one object (a step of a part, a sketch, a primitive, a part)."""
+    frame = shape_frame(obj)
+    try:
+        if _is(obj, "Sketcher::SketchObject"):
+            return _sketch_dims(obj, frame)
+        if _is(obj, "PartDesign::Body"):
+            out = []
+            for f in obj.Group:
+                if _is(f, "PartDesign::Feature") and not _is(f, "Sketcher::SketchObject"):
+                    out += dimensions_of(f, with_sketch=False)
+            return out[:MAX_LABELS]
+        if _is(obj, "PartDesign::Hole"):
+            return _hole_dims(obj, frame)
+        if _is(obj, "PartDesign::Pad") or _is(obj, "PartDesign::Pocket"):
+            return _extrusion_dims(obj, frame, with_sketch)
+        if _is(obj, "PartDesign::Revolution") or _is(obj, "PartDesign::Groove"):
+            sketch, profile = _profile(obj)
+            p = profile.BoundBox.Center if profile is not None else obj.Shape.BoundBox.Center
+            out = [Dim(obj, "Angle", frame.multVec(p), "angle")]
+            if with_sketch and sketch is not None and _is(sketch, "Sketcher::SketchObject"):
+                out += _sketch_dims(sketch, frame)
+            return out
+        if _is(obj, "PartDesign::Fillet"):
+            return _dress_up_dims(obj, frame, "Radius", "R")
+        if _is(obj, "PartDesign::Chamfer"):
+            return _dress_up_dims(obj, frame, "Size")
+        if _is(obj, "PartDesign::Thickness"):
+            return _dress_up_dims(obj, frame, "Value")
+        if _is(obj, "PartDesign::LinearPattern") or _is(obj, "PartDesign::PolarPattern"):
+            return _pattern_dims(obj, frame)
+        if _is(obj, "PartDesign::AdditiveBox") or _is(obj, "PartDesign::SubtractiveBox") or _is(obj, "Part::Box"):
+            return _box_dims(obj, frame)
+        if _is(obj, "PartDesign::AdditiveCylinder") or _is(obj, "PartDesign::SubtractiveCylinder") or _is(obj, "Part::Cylinder"):
+            return _cylinder_dims(obj, frame)
+        if _is(obj, "Part::Sphere") or _is(obj, "PartDesign::AdditiveSphere"):
+            to = frame.multiply(obj.Placement)
+            return [Dim(obj, "Radius", to.multVec(App.Vector(float(obj.Radius.Value), 0, 0)), "length", "R")]
+        if _is(obj, "Part::Cone"):
+            to = frame.multiply(obj.Placement)
+            h = float(obj.Height.Value)
+            return [
+                Dim(obj, "Radius1", to.multVec(App.Vector(float(obj.Radius1.Value), 0, 0)), "length", "R"),
+                Dim(obj, "Radius2", to.multVec(App.Vector(float(obj.Radius2.Value), 0, h)), "length", "R"),
+                Dim(obj, "Height", to.multVec(App.Vector(0, 0, h / 2))),
+            ]
+        if _is(obj, "Part::Extrusion"):
+            try:
+                c = obj.Base.Shape.BoundBox.Center
+                d = App.Vector(obj.Dir)
+                d.normalize()
+                return [Dim(obj, "LengthFwd", frame.multVec(c + d * float(obj.LengthFwd.Value) / 2))]
+            except Exception:
+                return []
+        if PP._is_pushpull(obj):
+            base, subs = obj.Base
+            info = PP.FaceInfo(base.Shape.getElement(subs[0]))
+            dist = float(obj.Distance.Value)
+            return [Dim(obj, "Distance", frame.multVec(info.origin + info.normal * dist))]
+    except Exception as e:
+        App.Console.PrintLog("Dimensions on the model: {}: {}\n".format(obj.Name, e))
+    return []
+
+
+def owner_of_pick(root, sub, point=None):
+    """The object whose numbers belong to a pick: for a face or edge of a part, the step that
+    made it; for a whole object, the object."""
+    import SnapMath as S
+
+    pick = S.Pick(root, sub, point)
+    objs = pick.objects()
+    owner = objs[-1] if objs else root
+    element = pick.element
+    body = PP._body_of(owner)
+    shape_owner = owner.Tip if _is(owner, "PartDesign::Body") else owner
+    if not element or body is None or shape_owner is None or not _is(shape_owner, "PartDesign::Feature"):
+        return owner
+    try:
+        shape = shape_owner.Shape
+        sel = shape.getElement(element)
+    except Exception:
+        return owner
+    faces = []
+    if element.startswith("Face"):
+        faces = [sel]
+    elif element.startswith("Edge"):
+        faces = [f for f in shape.Faces if any(e.isSame(sel) for e in f.Edges)]
+    probe = None
+    if point is not None:
+        frame = PP._frame(pick, shape_owner, element)
+        if frame is not None:
+            probe = frame.inverse().multVec(point)
+    for face in faces:
+        p = probe if probe is not None and PP._on_face(face, probe, 1e-3) else PP._inner_point(face)
+        maker = _dress_up_maker(body, shape_owner, face, p)
+        if maker is not None:
+            return maker
+    for face in faces:
+        p = probe if probe is not None and PP._on_face(face, probe, 1e-3) else PP._inner_point(face)
+        maker = PP.creator(body, shape_owner, face, p)
+        if maker is not None:
+            return maker
+    return shape_owner
+
+
+def _dress_up_maker(body, last, face, probe):
+    """The fillet, chamfer or shell that made the face: it is in its result, not in what it
+    started from."""
+    for f in reversed(PP._features_up_to(body, last)):
+        if not any(_is(f, t) for t in ("PartDesign::Fillet", "PartDesign::Chamfer", "PartDesign::Thickness")):
+            continue
+        base = getattr(f, "BaseFeature", None)
+        try:
+            now = any(PP._same_surface(face, ff) and PP._on_face(ff, probe, 1e-3) for ff in f.Shape.Faces)
+            before = base is not None and any(
+                PP._same_surface(face, ff) and PP._on_face(ff, probe, 1e-3) for ff in base.Shape.Faces
+            )
+        except Exception:
+            continue
+        if now and not before:
+            return f
+    return None
+
+
+def dimensions_for(picks):
+    """The labels for the selection: one object picked (maybe several elements of it)."""
+    if not picks:
+        return []
+    roots = {(r.Document.Name, r.Name) for r, _s, _p in picks}
+    if len(roots) != 1:
+        return []
+    owners = []
+    for root, sub, point in picks:
+        o = owner_of_pick(root, sub, point)
+        if o is not None and o not in owners:
+            owners.append(o)
+    if len(owners) != 1:
+        return []
+    return dimensions_of(owners[0])[:MAX_LABELS]
+
+
+def set_dimension(dim, text, title="Change a dimension"):
+    """Give the number a new value (or an expression after "="), recompute; one undo step.
+    Returns None, or what went wrong."""
+    text = (text or "").strip().replace("−", "-").replace("，", ".").replace("．", ".")
+    if not text:
+        return "empty"
+    obj = dim.obj
+    doc = obj.Document
+    broken = PP.broken(doc)
+    doc.openTransaction(title)
+    try:
+        if text.startswith("="):
+            obj.setExpression(dim.path, text[1:].strip())
+        else:
+            if dim.expression:
+                obj.setExpression(dim.path, None)
+            q = App.Units.Quantity(text)
+            if dim.kind == "count":
+                setattr(obj, dim.prop, int(round(q.Value)))
+            else:
+                unit = App.Units.Angle if dim.kind == "angle" else App.Units.Length
+                if q.Unit == App.Units.Unit():
+                    q = App.Units.Quantity(q.Value, unit)
+                elif q.Unit != unit:
+                    raise ValueError("unit")
+                if dim.index is not None:
+                    obj.setDatum(dim.index, q)
+                else:
+                    setattr(obj, dim.prop, q)
+        doc.recompute()
+        if not PP.broken(doc) <= broken:
+            raise ValueError("the model cannot be made with this value")
+    except Exception as e:
+        doc.abortTransaction()
+        try:
+            doc.recompute()
+        except Exception:
+            pass
+        return str(e) or "error"
+    doc.commitTransaction()
+    return None
diff --git a/src/Mod/Unified/DimensionLabelsGui.py b/src/Mod/Unified/DimensionLabelsGui.py
new file mode 100644
index 000000000..0dea9c802
--- /dev/null
+++ b/src/Mod/Unified/DimensionLabelsGui.py
@@ -0,0 +1,327 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""形の上の寸法 in the 3D view: pick a part or a step, its driving numbers appear on the model
+next to what they drive; click one, type, Enter. Nothing picked: no labels (they never clutter
+the model). What the numbers are and where they go: DimensionLabels.py."""
+
+import FreeCAD as App
+import FreeCADGui as Gui
+from PySide import QtCore, QtGui, QtWidgets
+
+import DimensionLabels as DL
+
+CTX = "Unified_Dimensions"
+
+STYLE = (
+    "QLabel { background: rgba(255,255,255,235); color: #0b3d91; border: 1px solid #5b8def;"
+    " border-radius: 3px; padding: 1px 5px; }"
+    "QLabel:hover { background: #fff4e0; border-color: #f5a623; }"
+)
+STYLE_EXPR = STYLE.replace("#0b3d91", "#6a1b9a")
+FIELD_STYLE = "QLineEdit { border: 2px solid #f5a623; border-radius: 3px; padding: 0px 3px; background: white; }"
+
+
+def tr(text):
+    return App.Qt.translate(CTX, text)
+
+
+def _view():
+    gdoc = Gui.ActiveDocument
+    view = gdoc.ActiveView if gdoc else None
+    if view is None or not hasattr(view, "getPointOnViewport") or not hasattr(view, "graphicsView"):
+        return None
+    return view
+
+
+def _busy():
+    if Gui.Control.activeDialog():
+        return True
+    gdoc = Gui.ActiveDocument
+    if gdoc is None:
+        return True
+    try:
+        return gdoc.getInEdit() is not None
+    except Exception:
+        return True
+
+
+class DimLabel(QtWidgets.QLabel):
+    def __init__(self, manager, parent):
+        super().__init__(parent)
+        self.manager = manager
+        self.dim = None
+        self.setObjectName("UnifiedDimensionLabel")
+        self.setCursor(QtCore.Qt.PointingHandCursor)
+        font = self.font()
+        font.setPointSizeF(font.pointSizeF() * 0.95)
+        self.setFont(font)
+
+    def set_dim(self, dim):
+        self.dim = dim
+        self.setText(dim.text())
+        self.setStyleSheet(STYLE_EXPR if dim.expression else STYLE)
+        name = tr(DL.NAMES.get(dim.prop if dim.index is None else "constraint", dim.prop))
+        if dim.name:
+            name = "{} ({})".format(name, dim.name)
+        tip = "{}: {}".format(dim.obj.Label, name)
+        if dim.expression:
+            tip += "\n= " + dim.expression
+        tip += "\n" + tr("Click to change. A number, a unit (10 mm, 1/2 in), arithmetic, or = and an expression")
+        self.setToolTip(tip)
+        self.adjustSize()
+
+    def mousePressEvent(self, event):
+        if event.button() == QtCore.Qt.LeftButton:
+            self.manager.edit(self)
+            event.accept()
+            return
+        super().mousePressEvent(event)
+
+
+class DimField(QtWidgets.QLineEdit):
+    def __init__(self, manager, label):
+        super().__init__(label.parentWidget())
+        self.manager = manager
+        self.label = label
+        self.dim = label.dim
+        self.setObjectName("UnifiedDimensionField")
+        self.setStyleSheet(FIELD_STYLE)
+        self.setText(self.dim.edit_text())
+        self.setMinimumWidth(max(label.width() + 30, self.fontMetrics().horizontalAdvance("0000.00 mm") + 12))
+        self.adjustSize()
+        self.move(label.pos())
+        self.returnPressed.connect(self._enter)
+        self.closed = False
+        self.show()
+        self.raise_()
+        self.setFocus()
+        self.selectAll()
+
+    def _enter(self):
+        error = DL.set_dimension(self.dim, self.text(), tr("Change a dimension"))
+        if error:
+            self.setStyleSheet(FIELD_STYLE.replace("#f5a623", "#d32f2f"))
+            QtWidgets.QToolTip.showText(
+                self.mapToGlobal(QtCore.QPoint(0, self.height())), tr("Cannot use this value") + ": " + error, self
+            )
+            return
+        self.close_field()
+        self.manager.refresh()
+
+    def keyPressEvent(self, event):
+        if event.key() == QtCore.Qt.Key_Escape:
+            self.close_field()
+            return
+        super().keyPressEvent(event)
+
+    def focusOutEvent(self, event):
+        super().focusOutEvent(event)
+        QtCore.QTimer.singleShot(0, self.close_field)
+
+    def close_field(self):
+        if self.closed:
+            return
+        self.closed = True
+        self.manager.field_closed(self)
+        self.hide()
+        self.deleteLater()
+
+
+class _SelectionObserver:
+    def __init__(self, manager):
+        self.manager = manager
+
+    def addSelection(self, doc, obj, sub, pnt):
+        self.manager.later()
+
+    def removeSelection(self, doc, obj, sub):
+        self.manager.later()
+
+    def setSelection(self, doc):
+        self.manager.later()
+
+    def clearSelection(self, doc):
+        self.manager.later()
+
+
+class _DocObserver:
+    def __init__(self, manager):
+        self.manager = manager
+
+    def slotRecomputedDocument(self, doc):
+        self.manager.later()
+
+    def slotUndoDocument(self, doc):
+        self.manager.later()
+
+    def slotRedoDocument(self, doc):
+        self.manager.later()
+
+
+class Manager(QtCore.QObject):
+    def __init__(self):
+        super().__init__()
+        self.labels = []
+        self.dims = []
+        self.view = None
+        self.viewport = None
+        self.field = None
+        self.camera = None
+        self.pending = QtCore.QTimer(self)
+        self.pending.setSingleShot(True)
+        self.pending.setInterval(30)
+        self.pending.timeout.connect(self.refresh)
+        self.follow = QtCore.QTimer(self)
+        self.follow.setInterval(60)
+        self.follow.timeout.connect(self._follow)
+        self.sel = _SelectionObserver(self)
+        Gui.Selection.addObserver(self.sel)
+        self.docs = _DocObserver(self)
+        App.addDocumentObserver(self.docs)
+
+    def later(self):
+        self.pending.start()
+
+    def _picks(self):
+        picks = []
+        for s in Gui.Selection.getSelectionEx("", 0):
+            names = list(s.SubElementNames) or [""]
+            points = list(s.PickedPoints)
+            for i, name in enumerate(names):
+                point = points[i] if i < len(points) else None
+                picks.append((s.Object, name, App.Vector(point) if point is not None else None))
+        return picks
+
+    def refresh(self):
+        if self.field is not None:
+            return  # a number is being typed: leave the labels where they are
+        view = _view()
+        dims = []
+        if view is not None and not _busy():
+            picks = self._picks()
+            if picks and all(p[0].Document == App.ActiveDocument for p in picks):
+                try:
+                    dims = DL.dimensions_for(picks)
+                except Exception as e:
+                    App.Console.PrintLog("Dimensions on the model: {}\n".format(e))
+        self._show(view, dims)
+
+    def _show(self, view, dims):
+        viewport = None
+        if view is not None and dims:
+            try:
+                viewport = view.graphicsView().viewport()
+            except Exception:
+                viewport = None
+        if viewport is not self.viewport:
+            self._clear_widgets()
+            self.viewport = viewport
+            if viewport is not None:
+                viewport.destroyed.connect(self._view_gone)
+        self.view = view
+        self.dims = dims if viewport is not None else []
+        while len(self.labels) < len(self.dims):
+            self.labels.append(DimLabel(self, viewport))
+        for label, dim in zip(self.labels, self.dims):
+            label.set_dim(dim)
+        for label in self.labels[len(self.dims):]:
+            label.hide()
+        if self.dims:
+            self.camera = None
+            self._follow()
+            self.follow.start()
+        else:
+            self.follow.stop()
+
+    def _view_gone(self, *_args):
+        """The view closed: its labels went with it."""
+        self.follow.stop()
+        self.labels = []
+        self.dims = []
+        self.view = None
+        self.viewport = None
+        self.field = None
+
+    def _clear_widgets(self):
+        for label in self.labels:
+            try:
+                label.hide()
+                label.deleteLater()
+            except RuntimeError:
+                pass
+        self.labels = []
+
+    def _camera_key(self):
+        cam = self.view.getCameraNode()
+        key = [tuple(cam.position.getValue().getValue()), tuple(cam.orientation.getValue().getValue())]
+        for field in ("height", "heightAngle"):
+            if hasattr(cam, field):
+                key.append(getattr(cam, field).getValue())
+        key.append((self.viewport.width(), self.viewport.height()))
+        return tuple(key)
+
+    def _follow(self):
+        """Put each label where its point is on the screen (again when the view turns)."""
+        if not self.dims or self.viewport is None or _view() is not self.view:
+            if self.dims and _view() is not self.view:
+                self.later()
+            return
+        try:
+            key = self._camera_key()
+        except Exception:
+            self._show(None, [])
+            return
+        if key == self.camera:
+            return
+        self.camera = key
+        dpr = self.viewport.devicePixelRatioF()
+        h = self.viewport.height() * dpr
+        placed = []
+        cam = self.view.getCameraNode()
+        eye = App.Vector(*cam.position.getValue().getValue())
+        look = App.Vector(*self.view.getViewDirection())
+        perspective = self.view.getCameraType() == "Perspective"
+        for label, dim in zip(self.labels, self.dims):
+            if label is self._editing_label():
+                continue
+            if perspective and (dim.anchor - eye).dot(look) <= 0:
+                label.hide()
+                continue
+            x, y = self.view.getPointOnViewport(dim.anchor)
+            pos = QtCore.QPoint(int(x / dpr) + 6, int((h - 1 - y) / dpr) - label.height() // 2)
+            rect = QtCore.QRect(pos, label.size())
+            for _ in range(6):
+                if not any(rect.intersects(r) for r in placed):
+                    break
+                rect.translate(0, label.height() + 2)
+            if not self.viewport.rect().intersects(rect):
+                label.hide()
+                continue
+            placed.append(rect)
+            label.move(rect.topLeft())
+            label.show()
+            label.raise_()
+
+    def _editing_label(self):
+        return self.field.label if self.field is not None else None
+
+    def edit(self, label):
+        if self.field is not None:
+            self.field.close_field()
+        label.hide()
+        self.field = DimField(self, label)
+
+    def field_closed(self, field):
+        if self.field is field:
+            self.field = None
+        self.camera = None
+        self.refresh()
+
+
+_manager = None
+
+
+def install():
+    global _manager
+    if _manager is None:
+        _manager = Manager()
+    return _manager
