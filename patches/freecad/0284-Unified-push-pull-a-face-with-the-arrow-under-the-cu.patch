+def _selected_face():
+    """(root, sub, point) of the one face picked, or None."""
+    sel = Gui.Selection.getSelectionEx("", 0)
+    if len(sel) != 1 or len(sel[0].SubElementNames) != 1:
+        return None
+    sub = sel[0].SubElementNames[0]
+    if not sub.split(".")[-1].startswith("Face"):
+        return None
+    points = list(sel[0].PickedPoints)
+    point = points[0] if points else None
+    pick = S.Pick(sel[0].Object, sub, point)
+    try:
+        face = pick.shape()
+        if point is not None and face.distToShape(Part.Vertex(point))[0] > 1e-3 * max(1.0, face.BoundBox.DiagonalLength):
+            point = None
+    except Exception:
+        point = None
+    return sel[0].Object, sub, point
+
+
+def selected_plan():
+    hit = _selected_face()
+    if hit is None or hit[0].Document != App.ActiveDocument:
+        return None
+    return manager().plan_at(*hit)
+
+
+def apply_typed(text, diameter=False):
+    """The number typed in the context bar: the whole push/pull at once (one undo step)."""
+    plan = selected_plan()
+    value = parse_length(text)
+    if plan is None or value is None:
+        return
+    if diameter:
+        if not plan.radial:
+            return
+        value = plan.info.sign * (value / 2 - plan.info.radius)
+    try:
+        session = Session(plan, tr("Move face"))
+    except CannotMove:
+        return
+    session.apply(value)
+    session.commit()
+    if not diameter:
+        ContextDefaults.remember(text)
+    manager().forget()
+
+
+def current_diameter():
+    plan = selected_plan()
+    if plan is None or not plan.radial:
+        return ""
+    return "{} mm".format(_fmt(2 * plan.info.radius))
+
+
+class PushPullCommand:
+    """面を動かす: the picked face, by a typed distance."""
+
+    def GetResources(self):
+        return {
+            "Pixmap": os.path.join(HERE, "PushPull.svg"),
+            "MenuText": QT_TRANSLATE_NOOP("Unified_PushPull", "Move face"),
+            "ToolTip": QT_TRANSLATE_NOOP(
+                "Unified_PushPull",
+                "Moves the picked face along its normal: outward adds material, inward removes it. "
+                "Type the distance (negative: inward), or drag the arrow that appears on a face under the cursor",
+            ),
+        }
+
+    def IsActive(self):
+        if App.ActiveDocument is None or _view() is None or _busy():
+            return False
+        plan = selected_plan()
+        return plan is not None and not plan.radial
+
+    def Activated(self):
+        plan = selected_plan()
+        if plan is not None:
+            manager().start_typed(plan)
+
+
+class FaceDiameterCommand(PushPullCommand):
+    """径: a hole's or a boss's diameter, by the picked round face."""
+
+    def GetResources(self):
+        return {
+            "Pixmap": os.path.join(HERE, "PushPull.svg"),
+            "MenuText": QT_TRANSLATE_NOOP("Unified_FaceDiameter", "Diameter"),
+            "ToolTip": QT_TRANSLATE_NOOP(
+                "Unified_FaceDiameter",
+                "Changes the diameter of the picked hole or round boss: type the new diameter",
+            ),
+        }
+
+    def IsActive(self):
+        if App.ActiveDocument is None or _view() is None or _busy():
+            return False
+        plan = selected_plan()
+        return plan is not None and plan.radial
+
+    def Activated(self):
+        plan = selected_plan()
+        if plan is not None:
+            manager().start_typed(plan, diameter=True)
+
+
+Gui.addCommand("Unified_PushPull", PushPullCommand())
+Gui.addCommand("Unified_FaceDiameter", FaceDiameterCommand())
+
+try:
+    import ContextRules
+
+    ContextRules.VALUE_HANDLERS["Unified_PushPull"] = apply_typed
+    ContextRules.VALUE_HANDLERS["Unified_FaceDiameter"] = lambda text: apply_typed(text, diameter=True)
+    ContextRules.VALUE_DEFAULTS["Unified_FaceDiameter"] = current_diameter
+except Exception as e:  # an older ContextRules: the bar's buttons still work
+    App.Console.PrintLog("Push/pull: {}\n".format(e))
