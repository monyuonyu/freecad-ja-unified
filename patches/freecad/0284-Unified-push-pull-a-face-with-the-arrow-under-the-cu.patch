+
+class Manager(QtCore.QObject):
+    """Watches the mouse over the 3D views: shows the arrow on the face under the cursor and
+    runs the drag. Nothing is started by a command: hovering is enough."""
+
+    def __init__(self):
+        super().__init__()
+        self.cache = {}
+        self.view = None
+        self.viewport = None
+        self.arrow = None
+        self.readout = None
+        self.plan = None
+        self.drag = None
+        self.typed = None
+        self.hover_xy = None
+        self.hot = False
+        self.saved_cursor = None
+        self.hover_timer = QtCore.QTimer(self)
+        self.hover_timer.setSingleShot(True)
+        self.hover_timer.setInterval(25)
+        self.hover_timer.timeout.connect(self._hover_now)
+        self.poll = QtCore.QTimer(self)
+        self.poll.setInterval(400)
+        self.poll.timeout.connect(self._attach)
+        self.poll.start()
+        self.observer = _DocObserver(self)
+        App.addDocumentObserver(self.observer)
+
+    # views ---------------------------------------------------------------------------------
+
+    def _attach(self):
+        """Watch the active 3D view (views come and go with documents)."""
+        if self.drag is not None or self.typed is not None:
+            return
+        if not self._alive():
+            self._view_gone()
+        if _busy() and self.arrow is not None:
+            self._hide()
+        view = _view()
+        if view is None:
+            return
+        viewport = _viewport(view)
+        if viewport is None:
+            return
+        if not viewport.property("unifiedPushPull"):
+            viewport.setProperty("unifiedPushPull", True)
+            viewport.installEventFilter(self)
+            viewport.destroyed.connect(self._view_gone)
+        if self.viewport is not viewport:
+            self._set_view(view, viewport)
+
+    def _view_gone(self, *_args):
+        """The view closed (with its document): forget it without touching it."""
+        self.view = None
+        self.viewport = None
+        self.arrow = None
+        self.readout = None
+        self.plan = None
+        self.hover_xy = None
+        self.hot = False
+        self.saved_cursor = None
+
+    def _alive(self):
+        if self.viewport is None:
+            return False
+        try:
+            import shiboken6
+
+            return shiboken6.isValid(self.viewport)
+        except Exception:
+            return True
+
+    def _set_view(self, view, viewport):
+        if self._alive():
+            self._hide()
+            if self.arrow is not None:
+                self.arrow.remove()
+        self.arrow = None
+        self.view = view
+        self.viewport = viewport
+        if self.readout is not None:
+            try:
+                self.readout.deleteLater()
+            except RuntimeError:
+                pass
+        self.readout = Readout(viewport)
+
+    def forget(self):
+        self.cache.clear()
+
+    # what is under the cursor --------------------------------------------------------------
+
+    def plan_at(self, root, sub, point):
+        key = (root.Document.Name, root.Name, sub)
+        if key not in self.cache:
+            try:
+                plan = PP.plan_for(root, sub, point)
+            except Exception as e:
+                App.Console.PrintLog("Push/pull: {}\n".format(e))
+                plan = None
+            if len(self.cache) > 200:
+                self.cache.clear()
+            self.cache[key] = plan
+        return self.cache[key]
+
+    def _hover_now(self):
+        if self.drag is not None or self.typed is not None or self.hover_xy is None:
+            return
+        viewport, xy = self.hover_xy
+        if not self._alive() or viewport is not self.viewport or _busy() or _view() is not self.view:
+            self._hide()
+            return
+        view = self.view
+        dpr = viewport.devicePixelRatioF()
+        if self.arrow is not None and self.arrow.visible() and self.arrow.hit(xy, dpr):
+            self._set_hot(True)
+            return
+        self._set_hot(False)
+        try:
+            hit = _pick_at(view, xy)
+        except Exception:
+            hit = None
+        plan = None
+        if hit is not None:
+            root, sub, point = hit
+            if root.Document == App.ActiveDocument:
+                plan = self.plan_at(root, sub, point)
+        if plan is None:
+            self._hide()
+            return
+        self.plan = plan
+        if self.arrow is None:
+            self.arrow = Arrow(view)
+        self.arrow.show(plan.origin, plan.normal)
+
+    def _set_hot(self, hot):
+        if hot == self.hot:
+            return
+        self.hot = hot
+        if self.arrow is not None and self.arrow.visible():
+            self.arrow.show(self.arrow.base, self.arrow.direction, hot)
+        if self.viewport is not None:
+            if hot:
+                self.saved_cursor = self.viewport.cursor()
+                self.viewport.setCursor(QtCore.Qt.OpenHandCursor)
+            elif self.saved_cursor is not None:
+                self.viewport.setCursor(self.saved_cursor)
+                self.saved_cursor = None
+
+    def _hide(self):
+        self._set_hot(False)
+        if self.arrow is not None:
+            self.arrow.hide()
+        self.plan = None
+
+    # the events ---------------------------------------------------------------------------
+
+    def eventFilter(self, obj, event):
+        try:
+            return self._event(obj, event)
+        except Exception as e:  # never break the view
+            App.Console.PrintWarning("Push/pull: {}\n".format(e))
+            return False
+
+    def _event(self, obj, event):
+        t = event.type()
+        if t == QtCore.QEvent.KeyPress:
+            if self.drag is not None and event.key() == QtCore.Qt.Key_Escape:
+                self._end_drag(cancel=True)
+                return True
+            return False
+        if obj is not self.viewport:
+            return False
+        if t == QtCore.QEvent.MouseMove:
+            xy = _coin_xy(obj, event.position() if hasattr(event, "position") else event.pos())
+            if self.drag is not None:
+                self.drag.move(xy, free=bool(event.modifiers() & QtCore.Qt.ShiftModifier))
+                return True
+            if event.buttons() == QtCore.Qt.NoButton:
+                self.hover_xy = (obj, xy)
+                self.hover_timer.start()
+            return False
+        if t == QtCore.QEvent.MouseButtonPress:
+            if self.drag is not None:
+                return True
+            if event.button() != QtCore.Qt.LeftButton or self.plan is None or self.arrow is None:
+                return False
+            if event.modifiers() & (QtCore.Qt.ControlModifier | QtCore.Qt.AltModifier):
+                return False
+            xy = _coin_xy(obj, event.position() if hasattr(event, "position") else event.pos())
+            if not self.arrow.hit(xy, obj.devicePixelRatioF()) or _busy():
+                return False
+            self._start_drag(xy)
+            return True
+        if t == QtCore.QEvent.MouseButtonRelease and self.drag is not None:
+            if event.button() == QtCore.Qt.LeftButton:
+                self._end_drag(cancel=False)
+            return True
+        if t == QtCore.QEvent.MouseButtonDblClick and self.drag is not None:
+            return True
+        if t == QtCore.QEvent.Leave and self.drag is None:
+            self.hover_xy = None
+            self._hide()
+        return False
+
+    def _start_drag(self, xy):
+        try:
+            self.drag = Drag(self, self.view, self.viewport, self.plan, xy)
+        except CannotMove:
+            self.readout.say(_qt_pos(self.viewport, xy), tr("This face cannot be moved"), warn=True)
+            QtCore.QTimer.singleShot(1500, self.readout.hide)
+            return
+        _hide_context_bar()
+        QtWidgets.QApplication.instance().installEventFilter(self)
+        self.viewport.setCursor(QtCore.Qt.ClosedHandCursor)
+        self.arrow.show(self.drag.origin, self.drag.normal, True)
+        self.show_progress(self.drag)
+
+    def _end_drag(self, cancel):
+        drag = self.drag
+        self.drag = None
+        QtWidgets.QApplication.instance().removeEventFilter(self)
+        try:
+            if cancel:
+                drag.cancel()
+            else:
+                drag.finish()
+        except Exception as e:
+            App.Console.PrintWarning("Push/pull: {}\n".format(e))
+            drag.session.cancel()
+        self.forget()
+        self.readout.hide()
+        self.saved_cursor = None
+        self.hot = False
+        self.viewport.unsetCursor()
+        self._hide()
+
+    def show_progress(self, drag):
+        if self.drag is not drag:
+            return
+        d = drag.session.applied
+        self.arrow.show(drag.origin + drag.normal * d, drag.normal, True)
+        main, detail = describe(drag.plan, d, drag.flush)
+        if drag.session.error:
+            detail = tr("Cannot go further") + ("  ·  " + detail if detail else "")
+        self.readout.say(drag.pos, main, detail, warn=drag.session.error)
+
+    # typed numbers ---------------------------------------------------------------------------
+
+    def start_typed(self, plan, diameter=False):
+        self._attach()
+        if self.view is None or self.drag is not None:
+            return
+        if self.typed is not None:
+            self.typed._close(False)
+        try:
+            self.typed = TypedEdit(self, self.view, self.viewport, plan, diameter)
+        except CannotMove:
+            return
+        if self.arrow is None:
+            self.arrow = Arrow(self.view)
+        self.show_typed(self.typed)
+
+    def show_typed(self, typed):
+        d = typed.session.applied
+        self.arrow.show(typed.plan.origin + typed.plan.normal * d, typed.plan.normal)
+        main, detail = describe(typed.plan, d)
+        pos = typed.pos() + QtCore.QPoint(-18, typed.height() - 14)
+        self.readout.say(pos, detail or main, "", warn=typed.session.error)
+
+    def typed_closed(self, typed):
+        if self.typed is typed:
+            self.typed = None
+        self.forget()
+        if self.readout is not None:
+            self.readout.hide()
+        self._hide()
+
+
+def _hide_context_bar():
+    main = Gui.getMainWindow()
+    bar = main.findChild(QtWidgets.QFrame, "UnifiedContextBar") if main else None
+    if bar is not None:
+        bar.hide()
+
+
+_manager = None
+
+
+def manager():
+    global _manager
+    if _manager is None:
+        _manager = Manager()
+    return _manager
+
+
+def install():
+    manager()
