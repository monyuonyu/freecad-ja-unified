+# SPDX-License-Identifier: LGPL-2.1-or-later
+# Tests of DimensionLabels (形の上の寸法: dimensions on the model), headless:
+#   FreeCADCmd -t TestDimensionLabels
+
+import unittest
+
+import FreeCAD as App
+import Part
+import Sketcher
+
+import DimensionLabels as DL
+import TestPushPull as TP
+
+_face_with = TP._face_with
+_round_face = TP._round_face
+
+
+class DimensionLabelsTest(unittest.TestCase):
+    setUp = TP.PushPullTest.setUp
+    tearDown = TP.PushPullTest.tearDown
+    body = TP.PushPullTest.body
+    sketch = TP.PushPullTest.sketch
+    rectangle = TP.PushPullTest.rectangle
+    padded_plate = TP.PushPullTest.padded_plate
+
+    def by_path(self, dims):
+        return {(d.obj.Name, d.path): d for d in dims}
+
+    def assertNear(self, a, b, tol=1e-6):
+        self.assertLess((App.Vector(a) - App.Vector(b)).Length, tol, "{} != {}".format(a, b))
+
+    def test_pad_face_shows_length_and_sketch_dimensions(self):
+        body, sk, pad = self.padded_plate(5)
+        top = _face_with(pad.Shape, (0, 0, 1), 5)
+        dims = DL.dimensions_for([(body, "Pad." + top, None)])
+        paths = self.by_path(dims)
+        self.assertIn(("Pad", "Length"), paths)
+        self.assertIn(("Sketch", ".Constraints.Width"), paths)
+        self.assertIn(("Sketch", ".Constraints.Height"), paths)
+        length = paths[("Pad", "Length")]
+        self.assertEqual(length.text(), "5 mm")
+        self.assertAlmostEqual(length.anchor.z, 2.5)  # half way up the side
+        width = paths[("Sketch", ".Constraints.Width")]
+        self.assertNear(width.anchor, (20, 0, 0))  # the middle of the bottom line
+        self.assertEqual(width.text(), "40 mm")
+
+    def test_labels_follow_a_moved_part(self):
+        part = self.doc.addObject("App::Part", "Part")
+        part.Placement.Base = App.Vector(100, 0, 0)
+        body, sk, pad = self.padded_plate(5, container=part)
+        dims = self.by_path(DL.dimensions_of(pad))
+        self.assertNear(dims[("Sketch", ".Constraints.Width")].anchor, (120, 0, 0))
+
+    def test_edit_a_length(self):
+        body, sk, pad = self.padded_plate(5)
+        dims = self.by_path(DL.dimensions_of(pad))
+        self.assertIsNone(DL.set_dimension(dims[("Pad", "Length")], "12"))
+        self.assertAlmostEqual(pad.Length.Value, 12)
+        self.assertAlmostEqual(body.Shape.BoundBox.ZMax, 12)
+        # with a unit and arithmetic
+        self.assertIsNone(DL.set_dimension(dims[("Pad", "Length")], "1 cm + 2 mm"))
+        self.assertAlmostEqual(pad.Length.Value, 12)
+        self.assertIsNone(DL.set_dimension(dims[("Pad", "Length")], "0.5 in"))
+        self.assertAlmostEqual(pad.Length.Value, 12.7)
+        # one undo step each
+        self.doc.undo()
+        self.doc.recompute()
+        self.assertAlmostEqual(pad.Length.Value, 12)
+
+    def test_edit_a_sketch_dimension(self):
+        body, sk, pad = self.padded_plate(5)
+        dims = self.by_path(DL.dimensions_of(pad))
+        self.assertIsNone(DL.set_dimension(dims[("Sketch", ".Constraints.Width")], "50 mm"))
+        self.assertAlmostEqual(body.Shape.BoundBox.XMax, 50)
+
+    def test_expressions(self):
+        body, sk, pad = self.padded_plate(5)
+        dims = self.by_path(DL.dimensions_of(pad))
+        length = dims[("Pad", "Length")]
+        self.assertIsNone(DL.set_dimension(length, "=Sketch.Constraints.Width / 4"))
+        self.assertAlmostEqual(pad.Length.Value, 10)
+        self.assertEqual(length.text(), "ƒ 10 mm")
+        self.assertEqual(length.edit_text(), "=Sketch.Constraints.Width / 4")
+        # a number again: the expression goes
+        self.assertIsNone(DL.set_dimension(length, "7"))
+        self.assertAlmostEqual(pad.Length.Value, 7)
+        self.assertIsNone(length.expression)
+        # an unnamed sketch dimension by expression
+        self.assertIsNone(DL.set_dimension(dims[("Sketch", ".Constraints.Height")], "=20 mm + 5 mm"))
+        self.assertAlmostEqual(body.Shape.BoundBox.YMax, 25)
+
+    def test_bad_values_change_nothing(self):
+        body, sk, pad = self.padded_plate(5)
+        dims = self.by_path(DL.dimensions_of(pad))
+        self.assertIsNotNone(DL.set_dimension(dims[("Pad", "Length")], "abc"))
+        self.assertIsNotNone(DL.set_dimension(dims[("Pad", "Length")], "30 deg"))
+        self.assertIsNotNone(DL.set_dimension(dims[("Sketch", ".Constraints.Width")], "0"))
+        self.assertAlmostEqual(pad.Length.Value, 5)
+        self.assertAlmostEqual(sk.getDatum("Width").Value, 40)
+        self.assertTrue(pad.isValid())
+
+    def test_hole_fillet_and_pattern(self):
+        body, sk, pad = self.padded_plate(10)
+        sk2 = self.sketch(body, 10)
+        sk2.addGeometry(Part.Circle(App.Vector(10, 15, 0), App.Vector(0, 0, 1), 2))
+        hole = body.newObject("PartDesign::Hole", "Hole")
+        hole.Profile = sk2
+        hole.Diameter = 6
+        hole.Depth = 4
+        hole.DepthType = "Dimension"
+        self.doc.recompute()
+        dims = self.by_path(DL.dimensions_for([(body, "Hole." + _round_face(hole.Shape, 3), None)]))
+        self.assertEqual(dims[("Hole", "Diameter")].text(), "⌀6")
+        self.assertEqual(dims[("Hole", "Depth")].text(), "4 mm")
+        self.assertAlmostEqual(dims[("Hole", "Depth")].anchor.z, 8)
+        self.assertIsNone(DL.set_dimension(dims[("Hole", "Diameter")], "8"))
+        self.assertAlmostEqual(hole.Diameter.Value, 8)
+
+        pattern = body.newObject("PartDesign::LinearPattern", "LinearPattern")
+        pattern.Originals = [hole]
+        pattern.Direction = (sk2, ["H_Axis"])
+        pattern.Length = 20
+        pattern.Occurrences = 3
+        self.doc.recompute()
+        dims = self.by_path(DL.dimensions_of(pattern))
+        self.assertEqual(dims[("LinearPattern", "Occurrences")].text(), "×3")
+        self.assertIsNone(DL.set_dimension(dims[("LinearPattern", "Occurrences")], "4"))
+        self.assertEqual(pattern.Occurrences, 4)
+
+    def test_fillet_face_shows_its_radius(self):
+        body, sk, pad = self.padded_plate(10)
+        edge = next(
+            "Edge%d" % (i + 1)
+            for i, e in enumerate(pad.Shape.Edges)
+            if type(e.Curve).__name__ == "Line" and abs(e.BoundBox.ZMin) < 1e-6 and abs(e.BoundBox.ZMax - 10) < 1e-6
+        )
+        fillet = body.newObject("PartDesign::Fillet", "Fillet")
+        fillet.Base = (pad, [edge])
+        fillet.Radius = 2
+        self.doc.recompute()
+        self.assertTrue(fillet.isValid())
+        round_face = next(
+            "Face%d" % (i + 1)
+            for i, f in enumerate(fillet.Shape.Faces)
+            if type(f.Surface).__name__ == "Cylinder" and abs(f.Surface.Radius - 2) < 1e-6
+        )
+        self.assertIs(DL.owner_of_pick(body, "Fillet." + round_face), fillet)
+        dims = self.by_path(DL.dimensions_for([(body, "Fillet." + round_face, None)]))
+        self.assertEqual(dims[("Fillet", "Radius")].text(), "R2")
+        # the top face of the plate still belongs to the pad
+        top = _face_with(fillet.Shape, (0, 0, 1), 10)
+        self.assertIs(DL.owner_of_pick(body, "Fillet." + top), pad)
+
+    def test_primitives_and_pushpull(self):
+        box = self.doc.addObject("Part::Box", "Box")
+        box.Placement.Base = App.Vector(0, 0, 100)
+        cyl = self.doc.addObject("Part::Cylinder", "Cylinder")
+        self.doc.recompute()
+        dims = self.by_path(DL.dimensions_for([(box, "Face1", None)]))
+        self.assertEqual(set(p for _o, p in dims), {"Length", "Width", "Height"})
+        self.assertNear(dims[("Box", "Height")].anchor, (0, 0, 105))
+        self.assertIsNone(DL.set_dimension(dims[("Box", "Height")], "20"))
+        self.assertAlmostEqual(box.Shape.BoundBox.ZMax, 120)
+        dims = self.by_path(DL.dimensions_of(cyl))
+        self.assertEqual(dims[("Cylinder", "Radius")].text(), "R2")
+
+        import PushPull as PP
+
+        solid = self.doc.addObject("Part::Feature", "Solid")
+        solid.Shape = Part.makeBox(10, 10, 10)
+        self.doc.recompute()
+        plan = PP.plan_for(solid, _face_with(solid.Shape, (0, 0, 1)))
+        self.doc.openTransaction("t")
+        used = PP.apply_distance(plan, 3)
+        self.doc.commitTransaction()
+        dims = DL.dimensions_of(used.feature)
+        self.assertEqual(len(dims), 1)
+        self.assertEqual(dims[0].text(), "3 mm")
+        self.assertNear(dims[0].anchor, (5, 5, 13))
+        self.assertIsNone(DL.set_dimension(dims[0], "-2"))
+        self.assertAlmostEqual(used.feature.Shape.BoundBox.ZMax, 8)
+
+    def test_body_shows_each_steps_main_numbers_only(self):
+        body, sk, pad = self.padded_plate(5)
+        dims = DL.dimensions_of(body)
+        self.assertEqual([(d.obj.Name, d.path) for d in dims], [("Pad", "Length")])
+
+    def test_nothing_for_two_objects(self):
+        box = self.doc.addObject("Part::Box", "Box")
+        box2 = self.doc.addObject("Part::Box", "Box001")
+        self.doc.recompute()
+        self.assertEqual(DL.dimensions_for([(box, "Face1", None), (box2, "Face1", None)]), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
