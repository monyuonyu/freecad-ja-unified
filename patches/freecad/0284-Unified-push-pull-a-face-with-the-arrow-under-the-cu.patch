diff --git a/src/Mod/Unified/PushPull.py b/src/Mod/Unified/PushPull.py
new file mode 100644
index 000000000..f522be164
--- /dev/null
+++ b/src/Mod/Unified/PushPull.py
@@ -0,0 +1,1047 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""Push/pull a face of a solid along its normal (面を動かす): what to change, and the change.
+
+Outward adds material, inward removes it. What changes is decided from where the face came from,
+the most parametric way first (docs/ui-redesign/00-design.md, "no modes, direct manipulation"):
+
+- the end face of a Pad or a Pocket (or the floor of a flat hole) → its Length / Depth;
+- a side face of a sketch-based Pad or Pocket → the sketch dimension that moves that line (found
+  by trying each dimension; a circle's dimension for a round face → hole or boss diameter);
+- a hole made by the Hole tool → its Diameter;
+- a face of a box or cylinder (Part or PartDesign primitive) → its size;
+- the face moved earlier by push/pull → that push/pull's distance;
+- any other flat face of a part (PartDesign body) → a new Pad or Pocket from the face itself
+  (parametric: its length stays editable);
+- any other face of a plain solid (Part, STEP) → a "push/pull" feature (PushPullFeature below) that
+  keeps the base solid, the face and the distance, so it stays editable; round faces of full
+  cylinders change their radius (hole or boss).
+
+No Qt here: TestPushPull.py tests all of it headless (FreeCADCmd -t TestPushPull). The handle in
+the 3D view, the drag and the context bar's number are in PushPullGui.py. Changes are made in the
+caller's open transaction: one drag (or one typed number) is one undo step, and aborting the
+transaction (Esc) puts everything back, also the features that were added.
+"""
+
+import math
+
+import FreeCAD as App
+import Part
+
+import SnapMath as S
+
+LIN = 1e-4  # mm: same plane, same radius
+ANG = 1e-6  # parallel normals (1 - |cos|)
+MIN_SIZE = 0.01  # mm: smallest length, radius or distance left by a push/pull
+
+
+def QT_TRANSLATE_NOOP(context, text):
+    return text
+
+
+# What changes, said in the readout (translated by the GUI in the context "Unified_PushPull")
+WORDS = {
+    "Length": QT_TRANSLATE_NOOP("Unified_PushPull", "length"),
+    "Depth": QT_TRANSLATE_NOOP("Unified_PushPull", "depth"),
+    "Diameter": QT_TRANSLATE_NOOP("Unified_PushPull", "diameter"),
+    "Radius": QT_TRANSLATE_NOOP("Unified_PushPull", "radius"),
+    "Width": QT_TRANSLATE_NOOP("Unified_PushPull", "width"),
+    "Height": QT_TRANSLATE_NOOP("Unified_PushPull", "height"),
+    "Distance": QT_TRANSLATE_NOOP("Unified_PushPull", "distance"),
+    "dimension": QT_TRANSLATE_NOOP("Unified_PushPull", "sketch dimension"),
+    "new pad": QT_TRANSLATE_NOOP("Unified_PushPull", "new extrusion"),
+    "new pocket": QT_TRANSLATE_NOOP("Unified_PushPull", "new cut"),
+    "new pushpull": QT_TRANSLATE_NOOP("Unified_PushPull", "face moved"),
+}
+
+
+# --------------------------------------------------------------------------- small helpers
+
+
+def _is(obj, type_name):
+    try:
+        return obj.isDerivedFrom(type_name)
+    except Exception:
+        return False
+
+
+def _value(q):
+    return float(getattr(q, "Value", q))
+
+
+def _has_expression(obj, path):
+    try:
+        names = [e[0] for e in obj.ExpressionEngine]
+    except Exception:
+        return False
+    path = path.lstrip(".")
+    return any(n.lstrip(".") == path for n in names)
+
+
+def _parallel(a, b):
+    return abs(abs(a.dot(b)) - 1.0) < ANG
+
+
+def _body_of(obj):
+    if _is(obj, "PartDesign::Body"):
+        return obj
+    for parent in obj.InList:
+        if _is(parent, "PartDesign::Body") and obj in parent.Group:
+            return parent
+    return None
+
+
+def _is_pushpull(obj):
+    return type(getattr(obj, "Proxy", None)).__name__ == "PushPullFeature"
+
+
+def _on_face(face, point, tol=1e-4):
+    try:
+        return face.distToShape(Part.Vertex(point))[0] < tol
+    except Exception:
+        return False
+
+
+def _normal_at(face, point):
+    """The outward normal of the face at the point (the face's orientation counts)."""
+    u, v = face.Surface.parameter(point)
+    n = face.normalAt(u, v)
+    n.normalize()
+    return n
+
+
+def _inner_point(face):
+    """A point on the face, as central as possible."""
+    c = face.CenterOfMass
+    if _on_face(face, c):
+        return App.Vector(c)
+    u0, u1, v0, v1 = face.ParameterRange
+    for fu, fv in ((0.5, 0.5), (0.3, 0.3), (0.7, 0.7), (0.3, 0.7), (0.7, 0.3), (0.1, 0.5), (0.5, 0.1)):
+        p = face.valueAt(u0 + (u1 - u0) * fu, v0 + (v1 - v0) * fv)
+        if _on_face(face, p):
+            return p
+    return App.Vector(face.Vertexes[0].Point) if face.Vertexes else App.Vector(c)
+
+
+class FaceInfo:
+    """A picked face in the coordinates of its owner's shape.
+
+    kind "plane": origin (on the face) and outward normal.
+    kind "cylinder": origin (on the face) and outward normal there, axis point and direction,
+    radius, sign +1 for a boss (outward is away from the axis) or -1 for a hole, and whether the
+    face goes all the way round."""
+
+    def __init__(self, face, probe=None):
+        self.face = face
+        surface = face.Surface
+        self.surface = type(surface).__name__
+        if probe is None or not _on_face(face, probe, 1e-3):
+            probe = _inner_point(face)
+        else:
+            probe = App.Vector(face.Surface.value(*face.Surface.parameter(probe)))
+        self.kind = None
+        self.probe = App.Vector(probe)
+        if self.surface == "Plane":
+            # The arrow sits in the middle of the face when that is on it
+            self.kind = "plane"
+            c = face.CenterOfMass
+            self.origin = App.Vector(c) if _on_face(face, c) else App.Vector(probe)
+            self.normal = _normal_at(face, self.origin)
+        elif self.surface == "Cylinder":
+            self.kind = "cylinder"
+            self.origin = App.Vector(probe)
+            self.normal = _normal_at(face, probe)
+            self.axis = App.Vector(surface.Axis)
+            self.axis.normalize()
+            self.center = App.Vector(surface.Center)
+            self.radius = surface.Radius
+            radial = probe - self.center
+            radial = radial - self.axis * radial.dot(self.axis)
+            self.sign = 1 if radial.dot(self.normal) > 0 else -1
+            u0, u1 = face.ParameterRange[:2]
+            self.full = abs((u1 - u0) - 2 * math.pi) < 1e-6
+            v0, v1 = face.ParameterRange[2:]
+            self.v_range = (v0, v1)
+
+    def level(self):
+        return self.origin.dot(self.normal)
+
+
+def _frame(pick, owner, element):
+    """The placement from the coordinates of owner.Shape to the global ones, from the picked face
+    (global, as SnapMath.Pick gives it) and the same face of the owner."""
+    try:
+        gface = pick.shape()
+        lface = owner.Shape.getElement(element)
+    except Exception:
+        return None
+    if gface is None or lface is None:
+        return None
+    candidates = []
+    try:
+        candidates.append(gface.Placement.multiply(lface.Placement.inverse()))
+    except Exception:
+        pass
+    try:
+        # The placement of the path down to the owner, without the owner's own (its shape has it)
+        tokens = pick.tokens
+        if tokens:
+            m = pick.root.getSubObject(".".join(tokens) + ".", retType=3)
+            last = pick.objects()[-1]
+            candidates.append(m)
+            if hasattr(last, "Placement"):
+                candidates.append(m.multiply(last.Placement.inverse()))
+    except Exception:
+        pass
+    candidates.append(App.Placement())
+    lc = lface.CenterOfMass
+    gc = gface.CenterOfMass
+    for g in candidates:
+        if (g.multVec(lc) - gc).Length < 1e-3 * max(1.0, gface.BoundBox.DiagonalLength):
+            return g
+    return None
+
+
+def _thickness_behind(shape, info):
+    """How far the face can be pushed in before the cut leaves nothing behind it."""
+    lowest = min(v.Point.dot(info.normal) for v in shape.Vertexes) if shape.Vertexes else 0.0
+    return max(0.0, info.level() - lowest)
+
+
+# --------------------------------------------------------------------------- the plans
+
+
+class Plan:
+    """What a push/pull of one face changes. origin/normal are global (the arrow); apply(d)
+    moves the face d mm along its outward normal (negative: inward) and recomputes."""
+
+    kind = ""
+
+    def __init__(self, owner, element, info, frame):
+        self.owner = owner
+        self.element = element
+        self.info = info
+        self.frame = frame
+        self.doc = owner.Document
+        self.origin = frame.multVec(info.origin)
+        self.normal = frame.Rotation.multVec(info.normal)
+        self.radial = info.kind == "cylinder"
+        self.d_min = -math.inf
+        self.d_max = math.inf
+        self.target = owner  # the object whose number changes (or that is made)
+        self.word = "Distance"  # key of WORDS
+        self.value0 = 0.0
+
+    def begin(self):
+        """Called once before the first apply, in the open transaction. Returns the plan to
+        use (itself, or another one when this one cannot do it), or None."""
+        return self
+
+    def apply(self, d):
+        raise NotImplementedError
+
+    def clamp(self, d):
+        return min(max(d, self.d_min), self.d_max)
+
+    def value_after(self, d):
+        """The number that changes: (word key, before, after) — after is None for new things."""
+        return self.word, self.value0, None
+
+    def __repr__(self):
+        return "<{} {} {}>".format(type(self).__name__, self.owner.Name, self.element)
+
+
+class PropertyPlan(Plan):
+    """Change a number of an object: value = value0 + k * d; a primitive's face on the negative
+    side also moves its placement (shift: parent coordinates per mm of d)."""
+
+    kind = "property"
+
+    def __init__(self, owner, element, info, frame, target, prop, k, word=None, shift=None, minimum=MIN_SIZE):
+        super().__init__(owner, element, info, frame)
+        self.target = target
+        self.prop = prop
+        self.k = k
+        self.word = word or prop
+        self.shift = shift
+        self.value0 = _value(getattr(target, prop))
+        self.placement0 = App.Placement(target.Placement) if shift is not None else None
+        if minimum is not None:
+            limit = (minimum - self.value0) / k
+            if k > 0:
+                self.d_min = limit
+            else:
+                self.d_max = limit
+
+    def value(self, d):
+        return self.value0 + self.k * d
+
+    def value_after(self, d):
+        return self.word, self.value0, self.value(d)
+
+    def apply(self, d):
+        d = self.clamp(d)
+        setattr(self.target, self.prop, self.value(d))
+        if self.shift is not None:
+            p = App.Placement(self.placement0)
+            p.Base = p.Base + self.shift * d
+            self.target.Placement = p
+        self.doc.recompute()
+
+
+class ConstraintPlan(Plan):
+    """Change a dimension of a sketch: value = value0 + d / k (k: how far the face moves when the
+    dimension grows by 1)."""
+
+    kind = "sketch"
+
+    def __init__(self, base_plan, sketch, index, k, positive):
+        super().__init__(base_plan.owner, base_plan.element, base_plan.info, base_plan.frame)
+        self.target = sketch
+        self.index = index
+        self.k = k
+        c = sketch.Constraints[index]
+        self.value0 = c.Value
+        self.angle = c.Type == "Angle"
+        self.name = c.Name
+        self.word = "dimension"
+        if positive:
+            limit = (MIN_SIZE - self.value0) * k
+            if k > 0:
+                self.d_min = limit
+            else:
+                self.d_max = limit
+
+    def value(self, d):
+        return self.value0 + d / self.k
+
+    def value_after(self, d):
+        return self.word, self.value0, self.value(d)
+
+    def apply(self, d):
+        d = self.clamp(d)
+        self.target.setDatum(self.index, App.Units.Quantity(self.value(d), App.Units.Length))
+        self.doc.recompute()
+
+
+class SketchPlan(Plan):
+    """A side face (or round face) of a sketch-based Pad/Pocket: find the sketch dimension that
+    moves the line (or changes the circle) the face was made from, by trying each one."""
+
+    kind = "sketch?"
+
+    def __init__(self, owner, element, info, frame, feature, sketch, geo, measure, fallback):
+        super().__init__(owner, element, info, frame)
+        self.feature = feature
+        self.sketch = sketch
+        self.geo = geo
+        self.measure = measure  # measure(sketch) -> position of the face (mm along its normal)
+        self.fallback = fallback
+        self.target = sketch
+        self.word = "dimension"
+
+    def begin(self):
+        found = find_driving_constraint(self.sketch, self.geo, self.measure)
+        if found is None:
+            return self.fallback.begin() if self.fallback is not None else None
+        index, k = found
+        c = self.sketch.Constraints[index]
+        plan = ConstraintPlan(self, self.sketch, index, k, positive=c.Type in ("Distance", "Radius", "Diameter"))
+        return plan
+
+    def apply(self, d):
+        raise RuntimeError("begin() first")
+
+
+def _geo_points(sketch, geo):
+    """Start, end and center of a geometry (sketch coordinates), those that exist."""
+    name = type(sketch.Geometry[geo]).__name__
+    if name == "LineSegment":
+        positions = (1, 2)
+    elif name in ("Circle", "Ellipse"):
+        positions = (3,)
+    elif name == "Point":
+        positions = (1,)
+    else:
+        positions = (1, 2, 3)
+    out = []
+    for pos in positions:
+        try:
+            out.append(App.Vector(sketch.getPoint(geo, pos)))
+        except Exception:
+            pass
+    return out
+
+
+def find_driving_constraint(sketch, geo, measure, delta=0.5):
+    """(index, k) of the dimension of the sketch that moves the face the most cleanly: change
+    each driving dimension a little, solve, see how far the face moved (k per unit) and how much
+    else moved. A dimension that moves other lines or circles as a whole (the corner of a
+    rectangle that places all of it, a width kept symmetric) is not used: the face would not move
+    alone. The sketch is put back after each try."""
+    candidates = []
+    others = [
+        i
+        for i in range(len(sketch.Geometry))
+        if i != geo and not sketch.getConstruction(i)
+    ]
+    before_others = {i: _geo_points(sketch, i) for i in others}
+    m0 = measure(sketch)
+    for index, c in enumerate(sketch.Constraints):
+        if c.Type not in ("Distance", "DistanceX", "DistanceY", "Radius", "Diameter"):
+            continue
+        if not c.Driving or not getattr(c, "IsActive", True):
+            continue
+        if _has_expression(sketch, ".Constraints[{}]".format(index)) or (
+            c.Name and _has_expression(sketch, ".Constraints." + c.Name)
+        ):
+            continue
+        v = c.Value
+        try:
+            sketch.setDatum(index, App.Units.Quantity(v + delta, App.Units.Length))
+            ok = sketch.solve() == 0
+            m1 = measure(sketch)
+            moved = 0.0
+            for i, pts in before_others.items():
+                shifts = [(a - b).Length for a, b in zip(pts, _geo_points(sketch, i))]
+                moved += sum(shifts)
+                if shifts and min(shifts) > 0.5 * delta:
+                    ok = False  # moves something else along: not this face alone
+        except Exception:
+            ok = False
+        finally:
+            try:
+                sketch.setDatum(index, App.Units.Quantity(v, App.Units.Length))
+                sketch.solve()
+            except Exception:
+                pass
+        if not ok:
+            continue
+        k = (m1 - m0) / delta
+        if abs(k) < 0.3:
+            continue
+        candidates.append((moved / delta, abs(abs(k) - 1.0), index, k))
+    try:
+        sketch.purgeTouched()
+    except Exception:
+        pass
+    if not candidates:
+        return None
+    candidates.sort()
+    _moved, _off, index, k = candidates[0]
+    return index, k
+
+
+class PDFacePlan(Plan):
+    """Any flat face of the last step of a PartDesign body: a new Pad (outward) or Pocket
+    (inward) from the face itself."""
+
+    kind = "new feature"
+
+    def __init__(self, owner, element, info, frame, body, shape):
+        super().__init__(owner, element, info, frame)
+        self.body = body
+        self.feature = None
+        self.word = "new pad"
+        self.d_min = -(_thickness_behind(shape, info) - MIN_SIZE)
+
+    def value_after(self, d):
+        return ("new pad" if d >= 0 else "new pocket"), 0.0, abs(d)
+
+    def _remove(self):
+        if self.feature is None:
+            return
+        f = self.feature
+        self.feature = None
+        try:
+            self.body.removeObject(f)
+        except Exception:
+            pass
+        self.doc.removeObject(f.Name)
+        _show(self.owner, True)
+
+    def apply(self, d):
+        d = self.clamp(d)
+        if abs(d) < 1e-7:
+            self._remove()
+            self.doc.recompute()
+            return
+        want = "PartDesign::Pad" if d > 0 else "PartDesign::Pocket"
+        if self.feature is not None and self.feature.TypeId != want:
+            self._remove()
+        if self.feature is None:
+            name = "Pad" if d > 0 else "Pocket"
+            f = self.body.newObject(want, name)
+            f.Profile = (self.owner, [self.element])
+            self.feature = f
+            self.target = f
+            _show(self.owner, False)
+            _show(f, True)
+        self.feature.Length = abs(d)
+        self.doc.recompute()
+
+
+class PartFacePlan(Plan):
+    """A face of a plain solid: a push/pull feature on it (made at the first apply)."""
+
+    kind = "new pushpull"
+
+    def __init__(self, owner, element, info, frame, shape):
+        super().__init__(owner, element, info, frame)
+        self.feature = None
+        self.word = "new pushpull"
+        self.mode = "Radius" if info.kind == "cylinder" else "Face"
+        if self.mode == "Face":
+            self.d_min = -(_thickness_behind(shape, info) - MIN_SIZE)
+        elif info.sign > 0:
+            self.d_min = -(info.radius - MIN_SIZE)
+        else:
+            self.d_max = info.radius - MIN_SIZE
+
+    def value_after(self, d):
+        if self.mode == "Radius":
+            return "Radius", self.info.radius, self.info.radius + self.info.sign * d
+        return self.word, 0.0, d
+
+    def apply(self, d):
+        d = self.clamp(d)
+        if self.feature is None:
+            self.feature = make_pushpull(self.owner, self.element, d, self.mode)
+            self.target = self.feature
+        else:
+            self.feature.Distance = d
+        self.doc.recompute()
+
+
+def _show(obj, visible):
+    vo = getattr(obj, "ViewObject", None)
+    if vo is not None:
+        try:
+            vo.Visibility = visible
+        except Exception:
+            pass
+
+
+# --------------------------------------------------------------------------- deciding
+
+
+def _profile_plane(feature):
+    """(point, unit normal) of the profile of a sketch-based feature, in body coordinates."""
+    try:
+        prof = feature.Profile
+    except Exception:
+        return None
+    if not prof or prof[0] is None:
+        return None
+    obj, subs = prof[0], prof[1]
+    if _is(obj, "Sketcher::SketchObject") and not any(subs):
+        pl = obj.Placement
+        return App.Vector(pl.Base), pl.Rotation.multVec(App.Vector(0, 0, 1))
+    try:
+        face = obj.Shape.getElement(subs[0])
+        if type(face.Surface).__name__ == "Plane":
+            p = _inner_point(face)
+            return p, _normal_at(face, p)
+    except Exception:
+        pass
+    return None
+
+
+def _features_up_to(body, last):
+    out = []
+    for obj in body.Group:
+        if _is(obj, "PartDesign::Feature") and not _is(obj, "PartDesign::Body"):
+            out.append(obj)
+        if obj == last:
+            break
+    return out
+
+
+def _same_surface(a, b):
+    """Two faces lie on the same plane, or the same cylinder."""
+    sa, sb = a.Surface, b.Surface
+    ta, tb = type(sa).__name__, type(sb).__name__
+    if ta != tb:
+        return False
+    if ta == "Plane":
+        na, nb = sa.Axis, sb.Axis
+        return _parallel(na, nb) and abs((App.Vector(sb.Position) - App.Vector(sa.Position)).dot(na)) < LIN
+    if ta == "Cylinder":
+        if abs(sa.Radius - sb.Radius) > LIN or not _parallel(sa.Axis, sb.Axis):
+            return False
+        d = App.Vector(sb.Center) - App.Vector(sa.Center)
+        d = d - App.Vector(sa.Axis) * d.dot(sa.Axis)
+        return d.Length < LIN
+    return False
+
+
+def creator(body, last, face, probe):
+    """The feature of the body (up to last) that made this part of the face: the newest one
+    whose added or removed shape has a face on the same surface through the probe point."""
+    for f in reversed(_features_up_to(body, last)):
+        try:
+            tool = f.AddSubShape
+        except Exception:
+            continue
+        if tool is None or tool.isNull():
+            continue
+        for tf in tool.Faces:
+            if _same_surface(tf, face) and _on_face(tf, probe, 1e-3):
+                return f
+    return None
+
+
+def _cap_plan(owner, element, info, frame, feature, prop):
+    """The end face of a Pad/Pocket (Length) or the floor of a flat hole (Depth)."""
+    if info.kind != "plane":
+        return None
+    plane = _profile_plane(feature)
+    if plane is None:
+        return None
+    p0, n0 = plane
+    if not _parallel(info.normal, n0):
+        return None
+    length = _value(getattr(feature, prop))
+    s = (info.origin - p0).dot(n0)
+    if abs(abs(s) - length) > 1e-3 * max(1.0, length):
+        return None
+    if abs(s) < LIN:
+        return None
+    e = n0 * (1 if s > 0 else -1)
+    k = 1.0 / e.dot(info.normal)
+    return PropertyPlan(owner, element, info, frame, feature, prop, k)
+
+
+def _sketch_plan(owner, element, info, frame, feature, fallback):
+    """A side face (line) or a round face (circle) of a sketch-based Pad/Pocket."""
+    plane = _profile_plane(feature)
+    sketch = feature.Profile[0] if plane is not None else None
+    if sketch is None or not _is(sketch, "Sketcher::SketchObject"):
+        return None
+    p0, n0 = plane
+    to_sketch = sketch.Placement.inverse()
+    if info.kind == "plane":
+        if abs(info.normal.dot(n0)) > 1e-6:
+            return None
+        n_loc = to_sketch.Rotation.multVec(info.normal)
+        n_loc.z = 0
+        if n_loc.Length < 1e-9:
+            return None
+        n_loc.normalize()
+        o_loc = to_sketch.multVec(info.origin)
+        level = App.Vector(o_loc.x, o_loc.y, 0).dot(n_loc)
+        best = None
+        for i, g in enumerate(sketch.Geometry):
+            if sketch.getConstruction(i) or type(g).__name__ != "LineSegment":
+                continue
+            a, b = App.Vector(g.StartPoint), App.Vector(g.EndPoint)
+            if abs(a.dot(n_loc) - level) > 1e-3 or abs(b.dot(n_loc) - level) > 1e-3:
+                continue
+            mid = (a + b) * 0.5
+            dist = (App.Vector(mid.x, mid.y, 0) - App.Vector(o_loc.x, o_loc.y, 0)).Length
+            if best is None or dist < best[0]:
+                best = (dist, i)
+        if best is None:
+            return None
+        geo = best[1]
+
+        def measure(sk, geo=geo, n=n_loc):
+            a, b = App.Vector(sk.getPoint(geo, 1)), App.Vector(sk.getPoint(geo, 2))
+            return ((a + b) * 0.5).dot(n)
+
+        return SketchPlan(owner, element, info, frame, feature, sketch, geo, measure, fallback)
+    if info.kind == "cylinder":
+        if not _parallel(info.axis, n0):
+            return None
+        c_loc = to_sketch.multVec(info.center)
+        for i, g in enumerate(sketch.Geometry):
+            if sketch.getConstruction(i) or type(g).__name__ not in ("Circle", "ArcOfCircle"):
+                continue
+            center = App.Vector(g.Center)
+            if abs(g.Radius - info.radius) > 1e-3 or (App.Vector(center.x - c_loc.x, center.y - c_loc.y, 0)).Length > 1e-3:
+                continue
+
+            def measure(sk, geo=i, sign=info.sign):
+                return sign * sk.Geometry[geo].Radius
+
+            return SketchPlan(owner, element, info, frame, feature, sketch, i, measure, fallback)
+    return None
+
+
+def _primitive_plan(owner, element, info, frame, prim, shiftable):
+    """A face of a box or a cylinder: its size (and its placement for the faces on the
+    negative side)."""
+    rot = prim.Placement.Rotation
+    if _is(prim, "Part::Box") or _is(prim, "PartDesign::AdditiveBox"):
+        if info.kind != "plane":
+            return None
+        n_loc = rot.inverted().multVec(info.normal)
+        for axis, prop in ((App.Vector(1, 0, 0), "Length"), (App.Vector(0, 1, 0), "Width"), (App.Vector(0, 0, 1), "Height")):
+            c = n_loc.dot(axis)
+            if abs(abs(c) - 1) > ANG:
+                continue
+            if _has_expression(prim, prop):
+                return None
+            if c > 0:
+                return PropertyPlan(owner, element, info, frame, prim, prop, 1.0)
+            if not shiftable:
+                return None
+            return PropertyPlan(owner, element, info, frame, prim, prop, 1.0, shift=App.Vector(info.normal))
+        return None
+    if _is(prim, "Part::Cylinder") or _is(prim, "PartDesign::AdditiveCylinder"):
+        if abs(_value(prim.Angle) - 360) > 1e-6:
+            return None
+        if info.kind == "cylinder" and info.sign > 0:
+            if _has_expression(prim, "Radius"):
+                return None
+            return PropertyPlan(owner, element, info, frame, prim, "Radius", 1.0)
+        if info.kind == "plane":
+            c = rot.inverted().multVec(info.normal).dot(App.Vector(0, 0, 1))
+            if abs(abs(c) - 1) > ANG or _has_expression(prim, "Height"):
+                return None
+            if c > 0:
+                return PropertyPlan(owner, element, info, frame, prim, "Height", 1.0)
+            if shiftable:
+                return PropertyPlan(owner, element, info, frame, prim, "Height", 1.0, shift=App.Vector(info.normal))
+    return None
+
+
+def _pushpull_edit_plan(owner, element, info, frame):
+    """The face that this push/pull feature moved: change its distance."""
+    try:
+        base, subs = owner.Base
+        bface = base.Shape.getElement(subs[0])
+    except Exception:
+        return None
+    binfo = FaceInfo(bface)
+    dist = _value(owner.Distance)
+    if owner.Mode == "Face":
+        if binfo.kind != "plane" or info.kind != "plane":
+            return None
+        if info.normal.dot(binfo.normal) < 1 - ANG:
+            return None
+        if abs(info.level() - (binfo.level() + dist)) > 1e-3:
+            return None
+    else:
+        if binfo.kind != "cylinder" or info.kind != "cylinder":
+            return None
+        if not _parallel(info.axis, binfo.axis) or abs(info.radius - (binfo.radius + binfo.sign * dist)) > 1e-3:
+            return None
+    plan = PropertyPlan(owner, element, info, frame, owner, "Distance", 1.0, minimum=None)
+    if owner.Mode == "Face":
+        plan.d_min = -(_thickness_behind(base.Shape, binfo) - MIN_SIZE) - dist
+    elif binfo.sign > 0:
+        plan.d_min = -(binfo.radius - MIN_SIZE) - dist
+    else:
+        plan.d_max = binfo.radius - MIN_SIZE - dist
+    return plan
+
+
+def plan_for(root, sub, point=None):
+    """What a push/pull of the picked face changes (a Plan), or None if this face cannot be
+    pushed or pulled. root/sub as in the selection (root is a top-level object, sub the path
+    to the face), point: the picked point (global), if any."""
+    pick = S.Pick(root, sub, point)
+    element = pick.element
+    if not element.startswith("Face"):
+        return None
+    objs = pick.objects()
+    owner = objs[-1]
+    body = _body_of(owner)
+    if _is(owner, "PartDesign::Body"):
+        owner = owner.Tip
+        if owner is None:
+            return None
+    if _is(owner, "Sketcher::SketchObject") or not hasattr(owner, "Shape"):
+        return None
+    shape = owner.Shape
+    if shape.isNull() or not shape.Solids:
+        return None
+    try:
+        face = shape.getElement(element)
+    except Exception:
+        return None
+    frame = _frame(pick, owner, element)
+    if frame is None:
+        return None
+    probe = frame.inverse().multVec(point) if point is not None else None
+    info = FaceInfo(face, probe)
+    if info.kind is None:
+        return None
+
+    if _is_pushpull(owner):
+        plan = _pushpull_edit_plan(owner, element, info, frame)
+        if plan is not None:
+            return plan
+
+    if body is not None and _is(owner, "PartDesign::Feature"):
+        tip = body.Tip
+        fallback = None
+        if owner == tip and info.kind == "plane":
+            fallback = PDFacePlan(owner, element, info, frame, body, shape)
+        maker = creator(body, owner, face, info.probe)
+        plan = None
+        if maker is not None:
+            if _is(maker, "PartDesign::Hole"):
+                if info.kind == "cylinder" and info.sign < 0 and not _has_expression(maker, "Diameter"):
+                    plan = PropertyPlan(owner, element, info, frame, maker, "Diameter", -2.0)
+                elif info.kind == "plane" and maker.DepthType == "Dimension" and not _has_expression(maker, "Depth"):
+                    plan = _cap_plan(owner, element, info, frame, maker, "Depth")
+            elif _is(maker, "PartDesign::Pad") or _is(maker, "PartDesign::Pocket"):
+                # the end face: its length (not when it is set from both sides)
+                if maker.Type == "Length" and not getattr(maker, "Midplane", False) and not _has_expression(maker, "Length"):
+                    plan = _cap_plan(owner, element, info, frame, maker, "Length")
+                if plan is None:
+                    plan = _sketch_plan(owner, element, info, frame, maker, fallback)
+            elif _is(maker, "PartDesign::AdditiveBox") or _is(maker, "PartDesign::AdditiveCylinder"):
+                plan = _primitive_plan(owner, element, info, frame, maker, False)
+        if plan is not None:
+            return plan
+        return fallback
+
+    if _is(owner, "PartDesign::Feature"):
+        return None  # a PartDesign feature outside a body: leave it alone
+
+    plan = None
+    if _is(owner, "Part::Box") or _is(owner, "Part::Cylinder"):
+        plan = _primitive_plan(owner, element, info, frame, owner, True)
+    if plan is not None:
+        return plan
+    if info.kind == "cylinder" and not info.full:
+        return None
+    return PartFacePlan(owner, element, info, frame, shape)
+
+
+# --------------------------------------------------------------------------- the operation
+
+
+def pushpull_shape(shape, element, distance, mode="Face"):
+    """The solid with its face moved: a flat face by distance along its outward normal (the
+    prism of the face added or cut), a full round face to radius + distance (a hole or a boss)."""
+    face = shape.getElement(element)
+    info = FaceInfo(face)
+    if abs(distance) < 1e-9:
+        return shape.copy()
+    if mode == "Face":
+        if info.kind != "plane":
+            raise ValueError("push/pull: {} is not flat".format(element))
+        prism = face.extrude(info.normal * distance)
+        result = shape.fuse(prism) if distance > 0 else shape.cut(prism)
+    else:
+        if info.kind != "cylinder" or not info.full:
+            raise ValueError("push/pull: {} is not a full round face".format(element))
+        v0, v1 = info.v_range
+        base = info.center + info.axis * v0
+        height = v1 - v0
+        r0 = info.radius
+        r1 = r0 + info.sign * distance
+        if r1 < MIN_SIZE:
+            raise ValueError("push/pull: radius {:g} too small".format(r1))
+
+        def cyl(r):
+            return Part.makeCylinder(r, height, base, info.axis)
+
+        if info.sign < 0:  # a hole
+            result = shape.cut(cyl(r1)) if r1 > r0 else shape.fuse(cyl(r0)).cut(cyl(r1))
+        else:  # a boss
+            if r1 > r0:
+                result = shape.fuse(cyl(r1))
+            else:
+                result = shape.cut(cyl(r0 + max(0.01, r0 * 1e-3)).cut(cyl(r1)))
+    try:
+        refined = result.removeSplitter()
+        if refined.isValid():
+            result = refined
+    except Exception:
+        pass
+    if not result.Solids:
+        raise ValueError("push/pull: nothing left")
+    if len(result.Solids) == 1:
+        result = result.Solids[0]
+    return result
+
+
+class PushPullFeature:
+    """A solid with one face moved (push/pull on a plain solid). Keeps the base solid, the face
+    and the distance: the distance stays editable, the base can be shown again."""
+
+    def __init__(self, obj):
+        obj.addProperty("App::PropertyLinkSub", "Base", "Push/pull", "The solid and its face that is moved")
+        obj.addProperty("App::PropertyDistance", "Distance", "Push/pull", "How far the face moves along its outward normal (negative: inward)")
+        obj.addProperty("App::PropertyEnumeration", "Mode", "Push/pull", "Face: moves a flat face; Radius: changes the radius of a round face")
+        obj.Mode = ["Face", "Radius"]
+        obj.Proxy = self
+
+    def execute(self, obj):
+        base, subs = obj.Base
+        if base is None or not subs:
+            raise ValueError("push/pull: no face")
+        obj.Shape = pushpull_shape(base.Shape, subs[0], _value(obj.Distance), obj.Mode)
+
+    def onDocumentRestored(self, obj):
+        obj.Proxy = self
+
+    def dumps(self):
+        return None
+
+    def loads(self, state):
+        return None
+
+
+class ViewProviderPushPull:
+    """Shows the push/pull feature with its base under it in the tree."""
+
+    def __init__(self, vobj):
+        vobj.Proxy = self
+
+    def attach(self, vobj):
+        self.Object = vobj.Object
+
+    def getIcon(self):
+        return ":/icons/Part_Extrude.svg"
+
+    def claimChildren(self):
+        base = getattr(self, "Object", None)
+        base = base.Base[0] if base is not None and base.Base else None
+        return [base] if base is not None else []
+
+    def onDelete(self, vobj, subelements):
+        try:
+            base = vobj.Object.Base[0]
+            if base is not None and base.ViewObject is not None:
+                base.ViewObject.Visibility = True
+        except Exception:
+            pass
+        return True
+
+    def dumps(self):
+        return None
+
+    def loads(self, state):
+        return None
+
+
+def make_pushpull(base, element, distance=0.0, mode="Face"):
+    """A push/pull feature on a face of the base solid, in the same container, looking like it;
+    the base is hidden."""
+    doc = base.Document
+    obj = doc.addObject("Part::FeaturePython", "PushPull")
+    PushPullFeature(obj)
+    obj.Base = (base, [element])
+    obj.Mode = mode
+    obj.Distance = distance
+    try:
+        obj.Label = base.Label
+    except Exception:
+        pass
+    for parent in base.InList:
+        if (_is(parent, "App::Part") or _is(parent, "App::DocumentObjectGroup")) and base in parent.Group:
+            parent.addObject(obj)
+            break
+    if getattr(obj, "ViewObject", None) is not None:
+        ViewProviderPushPull(obj.ViewObject)
+        try:
+            for prop in ("ShapeAppearance", "LineColor", "PointColor", "Transparency", "DisplayMode"):
+                if hasattr(base.ViewObject, prop):
+                    setattr(obj.ViewObject, prop, getattr(base.ViewObject, prop))
+        except Exception:
+            pass
+        _show(base, False)
+    return obj
+
+
+def broken(doc):
+    """What cannot be made: objects in error, and solids that have become flat (no volume).
+    A change is kept only when this does not grow."""
+    out = set()
+    for o in doc.Objects:
+        if not o.isValid():
+            out.add(o.Name)
+            continue
+        try:
+            if o.isDerivedFrom("Part::Feature") and not o.isDerivedFrom("Part::Part2DObject"):
+                solids = o.Shape.Solids
+                if solids and sum(abs(x.Volume) for x in solids) < 1e-6:
+                    out.add(o.Name)
+        except Exception:
+            pass
+    return out
+
+
+# --------------------------------------------------------------------------- drag helpers
+
+
+def drag_param(origin, direction, ray_origin, ray_dir):
+    """How far along the line (origin, unit direction) the point nearest to the view ray is,
+    or None when the line points along the ray."""
+    d = App.Vector(direction)
+    r = App.Vector(ray_dir)
+    if d.Length < 1e-12 or r.Length < 1e-12:
+        return None
+    d.normalize()
+    r.normalize()
+    w0 = App.Vector(origin) - App.Vector(ray_origin)
+    b = d.dot(r)
+    denom = 1.0 - b * b
+    if denom < 1e-6:
+        return None
+    dd = d.dot(w0)
+    e = r.dot(w0)
+    return (b * e - dd) / denom
+
+
+STEPS = (0.01, 0.05, 0.1, 0.5, 1, 5, 10, 50, 100, 500, 1000, 5000)
+
+
+def round_step(mm_per_pixel, pixels=6):
+    """The step of the round numbers to snap to: the smallest that is at least a few pixels."""
+    for s in STEPS:
+        if s >= mm_per_pixel * pixels:
+            return s
+    return STEPS[-1]
+
+
+def snap_distance(d, step, levels=(), tolerance=0.0):
+    """(snapped distance, the level it is flush with or None): a level (where the face is flush
+    with another face) within the tolerance wins, else the nearest multiple of step."""
+    best = None
+    for level in levels:
+        gap = abs(d - level)
+        if gap <= tolerance and (best is None or gap < best[0]):
+            best = (gap, level)
+    if best is not None:
+        return best[1], best[1]
+    if step > 0:
+        return round(d / step) * step, None
+    return d, None
+
+
+def flush_levels(origin, normal, shapes):
+    """The distances along the normal at which the moved face would be flush with a flat face
+    of the shapes (parallel to it), nearest first; 0 (where it is now) left out."""
+    out = []
+    n = App.Vector(normal)
+    n.normalize()
+    for shape in shapes:
+        for f in shape.Faces:
+            try:
+                s = f.Surface
+                if type(s).__name__ != "Plane" or not _parallel(App.Vector(s.Axis), n):
+                    continue
+                level = (App.Vector(s.Position) - origin).dot(n)
+            except Exception:
+                continue
+            if abs(level) < LIN:
+                continue
+            if all(abs(level - x) > LIN for x in out):
+                out.append(level)
+    out.sort(key=abs)
+    return out
+
+
+def apply_distance(plan, distance):
+    """A typed number: the whole push/pull in one go (the caller opens the transaction)."""
+    plan = plan.begin()
+    if plan is None:
+        return None
+    plan.apply(distance)
+    return plan
