+
+class CannotMove(Exception):
+    pass
+
+
+class Session:
+    """One push/pull: the open transaction, the plan in use and the distance so far."""
+
+    def __init__(self, plan, title):
+        self.doc = plan.doc
+        self.doc.openTransaction(title)
+        try:
+            used = plan.begin()
+        except Exception as e:
+            App.Console.PrintWarning("Push/pull: {}\n".format(e))
+            used = None
+        if used is None:
+            self.doc.abortTransaction()
+            raise CannotMove()
+        self.plan = used
+        self.broken = self._broken()  # what was broken already does not count
+        self.applied = 0.0
+        self.good = 0.0
+        self.error = False
+        self.closed = False
+
+    def _broken(self):
+        return PP.broken(self.doc)
+
+    def apply(self, d):
+        """Move the face to d (from where it was); a step that fails goes back to the last
+        good one."""
+        d = self.plan.clamp(d)
+        if abs(d - self.applied) < 1e-9:
+            return
+        try:
+            self.plan.apply(d)
+            ok = self._broken() <= self.broken
+        except Exception as e:
+            App.Console.PrintLog("Push/pull: {}\n".format(e))
+            ok = False
+        self.applied = d
+        if ok:
+            self.good = d
+            self.error = False
+        else:
+            self.error = True
+            try:
+                self.plan.apply(self.good)
+                self.applied = self.good
+            except Exception:
+                pass
+
+    def commit(self):
+        if self.closed:
+            return
+        self.closed = True
+        if abs(self.good) < 1e-9:
+            self.doc.abortTransaction()
+            return
+        if abs(self.applied - self.good) > 1e-9:
+            self.plan.apply(self.good)
+        self.doc.commitTransaction()
+
+    def cancel(self):
+        if self.closed:
+            return
+        self.closed = True
+        self.doc.abortTransaction()
+        try:
+            self.doc.recompute()
+        except Exception:
+            pass
+
+
+class Drag:
+    def __init__(self, manager, view, viewport, plan, xy):
+        self.manager = manager
+        self.view = view
+        self.viewport = viewport
+        self.session = Session(plan, tr("Move face"))
+        self.plan = self.session.plan
+        self.origin = App.Vector(plan.origin)
+        self.normal = App.Vector(plan.normal)
+        self.mm_per_px = 1.0 / _px_per_mm(view, self.origin, self.normal)
+        self.step = PP.round_step(self.mm_per_px)
+        self.levels = [] if self.plan.radial else PP.flush_levels(self.origin, self.normal, _visible_shapes(self.plan.doc))
+        self.start_xy = xy
+        self.t0 = self._param(xy)
+        self.d = 0.0
+        self.flush = None
+        self.pos = _qt_pos(viewport, xy)
+        self.timer = QtCore.QTimer()
+        self.timer.setSingleShot(True)
+        self.timer.setInterval(APPLY_MS)
+        self.timer.timeout.connect(self._apply)
+
+    def _param(self, xy):
+        ray = _ray(self.view, xy)
+        t = PP.drag_param(self.origin, self.normal, ray[0], ray[1])
+        if t is not None:
+            return t
+        # The arrow points at the eye: up and down on the screen move the face
+        return (xy[1] - self.start_xy[1]) * self.mm_per_px
+
+    def move(self, xy, free=False):
+        t = self._param(xy) - self.t0
+        d = self.plan.clamp(t)
+        self.flush = None
+        if not free:
+            d, self.flush = PP.snap_distance(d, self.step, self.levels, FLUSH_PX * self.mm_per_px)
+            d = self.plan.clamp(d)
+        self.d = d
+        self.pos = _qt_pos(self.viewport, xy)
+        if not self.timer.isActive():
+            self.timer.start()
+
+    def _apply(self):
+        self.session.apply(self.d)
+        self.manager.show_progress(self)
+
+    def finish(self):
+        self.timer.stop()
+        self.session.apply(self.d)
+        self.session.commit()
+
+    def cancel(self):
+        self.timer.stop()
+        self.session.cancel()
+
+
+class TypedEdit(QtWidgets.QLineEdit):
+    """The distance (or diameter) typed next to the face: the model follows as it is typed,
+    Enter keeps it, Esc puts it back."""
+
+    def __init__(self, manager, view, viewport, plan, diameter=False):
+        super().__init__(viewport)
+        self.manager = manager
+        self.view = view
+        self.diameter = diameter
+        self.session = Session(plan, tr("Move face"))
+        self.plan = self.session.plan
+        self.setObjectName("UnifiedPushPullField")
+        self.setFixedWidth(self.fontMetrics().horizontalAdvance("0000.000 mm") + 14)
+        if diameter:
+            self.setText("{} mm".format(_fmt(2 * plan.info.radius)))
+        else:
+            self.setText(ContextDefaults.distance())
+        self.selectAll()
+        self.setToolTip(tr("Type how far the face moves (negative: inward) and press Enter. Esc puts it back"))
+        xy = _on_screen(view, plan.origin)
+        pos = _qt_pos(viewport, xy)
+        self.move(min(pos.x() + 14, max(0, viewport.width() - self.width())), max(0, pos.y() - 30))
+        self.timer = QtCore.QTimer(self)
+        self.timer.setSingleShot(True)
+        self.timer.setInterval(250)
+        self.timer.timeout.connect(self._preview)
+        self.textEdited.connect(lambda _t: self.timer.start())
+        self.returnPressed.connect(self._enter)
+        self.done = False
+        self.show()
+        self.setFocus()
+        self._preview()
+
+    def distance(self):
+        d = parse_length(self.text())
+        if d is None:
+            return None
+        if self.diameter:
+            return self.plan.info.sign * (d / 2 - self.plan.info.radius)
+        return d
+
+    def _preview(self):
+        d = self.distance()
+        if d is None:
+            return
+        self.session.apply(d)
+        self.manager.show_typed(self)
+
+    def _enter(self):
+        d = self.distance()
+        if d is None:
+            return
+        self.timer.stop()
+        self.session.apply(d)
+        if not self.diameter:
+            ContextDefaults.remember(self.text())
+        self._close(True)
+
+    def keyPressEvent(self, event):
+        if event.key() == QtCore.Qt.Key_Escape:
+            self._close(False)
+            return
+        super().keyPressEvent(event)
+
+    def focusOutEvent(self, event):
+        super().focusOutEvent(event)
+        QtCore.QTimer.singleShot(0, lambda: self._close(False))
+
+    def _close(self, keep):
+        if self.done:
+            return
+        self.done = True
+        if keep:
+            self.session.commit()
+        else:
+            self.session.cancel()
+        self.manager.typed_closed(self)
+        self.hide()
+        self.deleteLater()
+
+
+def parse_length(text):
+    """mm from what was typed: a number (mm), a quantity with a unit, or arithmetic."""
+    text = (text or "").strip().replace("−", "-").replace("，", ".").replace("．", ".")
+    if not text:
+        return None
+    try:
+        q = App.Units.Quantity(text)
+    except Exception:
+        return None
+    if q.Unit == App.Units.Unit():
+        return float(q.Value)
+    if q.Unit != App.Units.Length:
+        return None
+    return float(q.getValueAs("mm"))
+
+
+class ContextDefaults:
+    PARAM = "User parameter:BaseApp/Preferences/Mod/Unified/ContextBar"
+
+    @classmethod
+    def distance(cls):
+        return App.ParamGet(cls.PARAM).GetString("Unified_PushPull", "5 mm")
+
+    @classmethod
+    def remember(cls, text):
+        App.ParamGet(cls.PARAM).SetString("Unified_PushPull", text)
