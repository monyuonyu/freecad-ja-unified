+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""面を動かす (push/pull) in the 3D view: no tool to start, no mode.
+
+- Hover a flat face of a solid (or a full round face): a small arrow appears on it. Drag the arrow:
+  the face follows the cursor along its normal, the model changes as it goes (the real model, in
+  one open transaction), a label next to the cursor says how far and what changes. The distance
+  snaps to round numbers and to the levels of other flat faces (flush); Shift drags freely.
+  Releasing keeps it (one undo step), Esc while dragging puts everything back.
+- Or pick the face and type the distance in the context bar (Unified_PushPull), or the new
+  diameter of a round face (Unified_FaceDiameter).
+
+What changes (a Pad's length, a sketch dimension, a new feature...) is decided in PushPull.py.
+"""
+
+import os
+
+import FreeCAD as App
+import FreeCADGui as Gui
+import Part
+from PySide import QtCore, QtGui, QtWidgets
+
+import PushPull as PP
+import SnapMath as S
+
+CTX = "Unified_PushPull"
+HERE = os.path.dirname(os.path.abspath(__file__))
+QT_TRANSLATE_NOOP = App.Qt.QT_TRANSLATE_NOOP
+
+HANDLE_PX = 56  # length of the arrow on the screen
+HIT_PX = 10  # how near the arrow the cursor has to be to take it
+FLUSH_PX = 8  # how near another face's level the face snaps to it
+APPLY_MS = 15  # the model follows the cursor at most this often (each step recomputes)
+
+
+def tr(text):
+    return App.Qt.translate(CTX, text)
+
+
+def _fmt(value):
+    """A length for the label: no trailing zeros."""
+    text = "{:.3f}".format(value).rstrip("0").rstrip(".")
+    return "0" if text in ("-0", "") else text
+
+
+# --------------------------------------------------------------------------- the view
+
+
+def _view():
+    gdoc = Gui.ActiveDocument
+    view = gdoc.ActiveView if gdoc else None
+    if view is None or not hasattr(view, "getObjectInfo") or not hasattr(view, "graphicsView"):
+        return None
+    return view
+
+
+def _viewport(view):
+    try:
+        return view.graphicsView().viewport()
+    except Exception:
+        return None
+
+
+def _busy():
+    """Something else is going on: a sketch or a feature is edited, a tool's panel is open."""
+    if Gui.Control.activeDialog():
+        return True
+    gdoc = Gui.ActiveDocument
+    if gdoc is None:
+        return True
+    try:
+        return gdoc.getInEdit() is not None
+    except Exception:
+        return True
+
+
+def _coin_xy(viewport, pos):
+    """Qt position in the viewport → Coin's pixel (device pixels, y up)."""
+    dpr = viewport.devicePixelRatioF()
+    return pos.x() * dpr, viewport.height() * dpr - 1 - pos.y() * dpr
+
+
+def _qt_pos(viewport, xy):
+    dpr = viewport.devicePixelRatioF()
+    return QtCore.QPoint(int(xy[0] / dpr), int((viewport.height() * dpr - 1 - xy[1]) / dpr))
+
+
+def _on_screen(view, point):
+    x, y = view.getPointOnViewport(App.Vector(point))
+    return float(x), float(y)
+
+
+def _px_per_mm(view, point, along):
+    """How many pixels one mm is at the point, across the view."""
+    vdir = App.Vector(*view.getViewDirection())
+    u = App.Vector(along).cross(vdir)
+    if u.Length < 1e-9:
+        u = vdir.cross(App.Vector(1, 0, 0))
+        if u.Length < 1e-9:
+            u = vdir.cross(App.Vector(0, 1, 0))
+    u.normalize()
+    a = _on_screen(view, point)
+    b = _on_screen(view, point + u * 10)
+    px = ((a[0] - b[0]) ** 2 + (a[1] - b[1]) ** 2) ** 0.5 / 10
+    return max(px, 1e-6)
+
+
+def _ray(view, xy):
+    """The view ray through the pixel: (origin, direction)."""
+    q = App.Vector(view.getPoint(int(xy[0]), int(xy[1])))
+    if view.getCameraType() == "Perspective":
+        p = App.Vector(*view.getCameraNode().position.getValue().getValue())
+        return p, q - p
+    return q, App.Vector(*view.getViewDirection())
+
+
+def _pick_at(view, xy):
+    """(root, sub, point) of the face under the pixel, or None."""
+    info = view.getObjectInfo((int(xy[0]), int(xy[1])))
+    if not info:
+        return None
+    root = info.get("ParentObject")
+    sub = info.get("SubName")
+    if root is None or not sub:
+        try:
+            root = App.getDocument(info["Document"]).getObject(info["Object"])
+        except Exception:
+            return None
+        sub = info.get("Component")
+    if root is None or not sub or not sub.split(".")[-1].startswith("Face"):
+        return None
+    return root, sub, App.Vector(info["x"], info["y"], info["z"])
+
+
+def _visible_shapes(doc):
+    out = []
+    for obj in doc.RootObjects:
+        vo = getattr(obj, "ViewObject", None)
+        if vo is None or not vo.Visibility:
+            continue
+        try:
+            shape = Part.getShape(obj)
+        except Exception:
+            continue
+        if shape is not None and not shape.isNull() and shape.Faces:
+            out.append(shape)
+    return out
+
+
+class Arrow:
+    """The handle: an arrow drawn over the model (always on top, not pickable)."""
+
+    def __init__(self, view):
+        from pivy import coin
+
+        self.view = view
+        self.root = coin.SoSeparator()
+        style = coin.SoPickStyle()
+        style.style = coin.SoPickStyle.UNPICKABLE
+        self.root.addChild(style)
+        top = coin.SoAnnotation()
+        self.root.addChild(top)
+        self.switch = coin.SoSwitch()
+        self.switch.whichChild = -1
+        top.addChild(self.switch)
+        sep = coin.SoSeparator()
+        self.switch.addChild(sep)
+        light = coin.SoLightModel()
+        light.model = coin.SoLightModel.BASE_COLOR
+        sep.addChild(light)
+        self.transform = coin.SoTransform()
+        sep.addChild(self.transform)
+        self.color = coin.SoBaseColor()
+        sep.addChild(self.color)
+        dot = coin.SoSphere()
+        dot.radius = 0.07
+        sep.addChild(dot)
+        shaft = coin.SoSeparator()
+        move = coin.SoTranslation()
+        move.translation = (0, 0.5, 0)
+        cyl = coin.SoCylinder()
+        cyl.radius = 0.035
+        cyl.height = 1.0
+        shaft.addChild(move)
+        shaft.addChild(cyl)
+        sep.addChild(shaft)
+        head = coin.SoSeparator()
+        move = coin.SoTranslation()
+        move.translation = (0, 1.14, 0)
+        cone = coin.SoCone()
+        cone.bottomRadius = 0.12
+        cone.height = 0.28
+        head.addChild(move)
+        head.addChild(cone)
+        sep.addChild(head)
+        view.getSceneGraph().addChild(self.root)
+        self.base = None
+        self.direction = None
+        self.length = 0.0
+
+    def show(self, base, direction, hot=False):
+        from pivy import coin
+
+        self.base = App.Vector(base)
+        self.direction = App.Vector(direction)
+        self.length = HANDLE_PX / _px_per_mm(self.view, self.base, self.direction)
+        self.transform.translation.setValue(tuple(self.base))
+        self.transform.rotation.setValue(coin.SbRotation(coin.SbVec3f(0, 1, 0), coin.SbVec3f(*tuple(self.direction))))
+        self.transform.scaleFactor.setValue(self.length, self.length, self.length)
+        self.color.rgb = (1.0, 0.45, 0.0) if hot else (0.1, 0.4, 0.95)
+        self.switch.whichChild = 0
+
+    def hide(self):
+        self.switch.whichChild = -1
+        self.base = None
+
+    def visible(self):
+        return self.base is not None
+
+    def hit(self, xy, dpr=1.0):
+        """The pixel is on the arrow."""
+        if self.base is None:
+            return False
+        a = _on_screen(self.view, self.base)
+        b = _on_screen(self.view, self.base + self.direction * self.length * 1.28)
+        ax, ay = b[0] - a[0], b[1] - a[1]
+        px, py = xy[0] - a[0], xy[1] - a[1]
+        seg = ax * ax + ay * ay
+        t = 0.0 if seg < 1e-9 else max(0.0, min(1.0, (px * ax + py * ay) / seg))
+        dx, dy = px - ax * t, py - ay * t
+        return (dx * dx + dy * dy) ** 0.5 <= HIT_PX * dpr
+
+    def remove(self):
+        try:
+            self.view.getSceneGraph().removeChild(self.root)
+        except Exception:
+            pass
+
+
+class Readout(QtWidgets.QLabel):
+    """How far, and what changes, next to the cursor."""
+
+    def __init__(self, parent):
+        super().__init__(parent)
+        self.setObjectName("UnifiedPushPullReadout")
+        self.setAttribute(QtCore.Qt.WA_TransparentForMouseEvents)
+        self.setTextFormat(QtCore.Qt.RichText)
+        self.setStyleSheet(
+            "QLabel { background: rgba(255,255,255,240); color: #1d1d1f; border: 1px solid #2f5fb3;"
+            " border-radius: 4px; padding: 3px 7px; }"
+        )
+        self.hide()
+
+    def say(self, pos, main, detail="", warn=False):
+        color = "#b3261e" if warn else "#1d1d1f"
+        html = "<span style='font-size:13pt; font-weight:600; color:{}'>{}</span>".format(color, main.replace("<", "&lt;"))
+        if detail:
+            html += "<br><span style='color:#555'>{}</span>".format(detail.replace("<", "&lt;"))
+        self.setText(html)
+        self.adjustSize()
+        parent = self.parentWidget()
+        x = min(pos.x() + 18, max(0, parent.width() - self.width() - 2))
+        y = min(pos.y() + 18, max(0, parent.height() - self.height() - 2))
+        self.move(x, y)
+        self.show()
+        self.raise_()
