+# SPDX-License-Identifier: LGPL-2.1-or-later
+# Tests of PushPull (面を動かす: push/pull a face), headless:
+#   FreeCADCmd -t TestPushPull
+
+import os
+import tempfile
+import unittest
+
+import FreeCAD as App
+import Part
+import Sketcher
+
+import PushPull as PP
+
+
+def _face_with(shape, normal, level=None, kind="Plane"):
+    """The name of the face of the shape with this outward normal (and level along it)."""
+    n = App.Vector(normal)
+    for i, f in enumerate(shape.Faces):
+        if type(f.Surface).__name__ != kind:
+            continue
+        info = PP.FaceInfo(f)
+        if kind == "Plane":
+            if info.normal.dot(n) < 1 - 1e-6:
+                continue
+            if level is not None and abs(info.origin.dot(n) - level) > 1e-6:
+                continue
+        return "Face%d" % (i + 1)
+    raise AssertionError("no face with normal {} at {}".format(normal, level))
+
+
+def _round_face(shape, radius):
+    for i, f in enumerate(shape.Faces):
+        if type(f.Surface).__name__ == "Cylinder" and abs(f.Surface.Radius - radius) < 1e-6:
+            return "Face%d" % (i + 1)
+    raise AssertionError("no round face of radius {}".format(radius))
+
+
+class PushPullTest(unittest.TestCase):
+    def setUp(self):
+        self.doc = App.newDocument("PushPullTest")
+        self.doc.UndoMode = 1
+
+    def tearDown(self):
+        App.closeDocument(self.doc.Name)
+
+    # helpers ------------------------------------------------------------------------------
+
+    def body(self, container=None):
+        body = self.doc.addObject("PartDesign::Body", "Body")
+        if container is not None:
+            container.addObject(body)
+        return body
+
+    def sketch(self, body, offset=0.0):
+        sk = body.newObject("Sketcher::SketchObject", "Sketch")
+        sk.AttachmentSupport = (body.Origin.OriginFeatures[3], [""])
+        sk.MapMode = "FlatFace"
+        sk.AttachmentOffset = App.Placement(App.Vector(0, 0, offset), App.Rotation())
+        return sk
+
+    def rectangle(self, sk, w, h, x=0.0, y=0.0, constrain=True):
+        pts = [App.Vector(x, y, 0), App.Vector(x + w, y, 0), App.Vector(x + w, y + h, 0), App.Vector(x, y + h, 0)]
+        first = len(sk.Geometry)
+        for i in range(4):
+            sk.addGeometry(Part.LineSegment(pts[i], pts[(i + 1) % 4]))
+        for i in range(4):
+            sk.addConstraint(Sketcher.Constraint("Coincident", first + i, 2, first + (i + 1) % 4, 1))
+        if constrain:
+            sk.addConstraint(Sketcher.Constraint("Horizontal", first))
+            sk.addConstraint(Sketcher.Constraint("Horizontal", first + 2))
+            sk.addConstraint(Sketcher.Constraint("Vertical", first + 1))
+            sk.addConstraint(Sketcher.Constraint("Vertical", first + 3))
+            sk.addConstraint(Sketcher.Constraint("DistanceX", -1, 1, first, 1, x))
+            sk.addConstraint(Sketcher.Constraint("DistanceY", -1, 1, first, 1, y))
+            width = sk.addConstraint(Sketcher.Constraint("DistanceX", first, 1, first, 2, w))
+            sk.renameConstraint(width, "Width")
+            height = sk.addConstraint(Sketcher.Constraint("DistanceY", first + 1, 1, first + 1, 2, h))
+            sk.renameConstraint(height, "Height")
+        return first
+
+    def padded_plate(self, length=5.0, container=None, constrain=True):
+        body = self.body(container)
+        sk = self.sketch(body)
+        self.rectangle(sk, 40, 30, constrain=constrain)
+        pad = body.newObject("PartDesign::Pad", "Pad")
+        pad.Profile = sk
+        pad.Length = length
+        self.doc.recompute()
+        return body, sk, pad
+
+    def plan(self, root, sub, point=None):
+        plan = PP.plan_for(root, sub, point)
+        self.assertIsNotNone(plan, "no plan for {} {}".format(root.Name, sub))
+        return plan
+
+    def push(self, plan, d):
+        """One push/pull as the GUI does it: in a transaction, committed."""
+        self.doc.openTransaction("Push/pull")
+        used = plan.begin()
+        self.assertIsNotNone(used)
+        used.apply(d)
+        self.doc.commitTransaction()
+        self.doc.recompute()
+        return used
+
+    # PartDesign ---------------------------------------------------------------------------
+
+    def test_pad_top_face_changes_length(self):
+        body, sk, pad = self.padded_plate(5)
+        top = _face_with(pad.Shape, (0, 0, 1), 5)
+        plan = self.plan(body, "Pad." + top)
+        self.assertEqual(plan.kind, "property")
+        self.assertIs(plan.target, pad)
+        self.assertEqual(plan.prop, "Length")
+        self.assertAlmostEqual(plan.normal.z, 1)
+        self.push(plan, 7)
+        self.assertAlmostEqual(pad.Length.Value, 12)
+        self.assertAlmostEqual(body.Shape.Volume, 40 * 30 * 12, 3)
+        self.assertEqual(len(body.Group), 2, "no new feature")
+
+    def test_pad_top_face_pushed_in(self):
+        body, sk, pad = self.padded_plate(5)
+        plan = self.plan(body, "Pad." + _face_with(pad.Shape, (0, 0, 1), 5))
+        self.push(plan, -3)
+        self.assertAlmostEqual(pad.Length.Value, 2)
+        # never through: the length stays positive
+        plan = self.plan(body, "Pad." + _face_with(pad.Shape, (0, 0, 1), 2))
+        self.assertGreater(plan.clamp(-10), -2)
+
+    def test_reversed_pad_top_face(self):
+        body, sk, pad = self.padded_plate(5)
+        pad.Reversed = True
+        self.doc.recompute()
+        bottom = _face_with(pad.Shape, (0, 0, -1), 5)
+        plan = self.plan(body, "Pad." + bottom)
+        self.assertEqual(plan.prop, "Length")
+        self.push(plan, 2)
+        self.assertAlmostEqual(pad.Length.Value, 7)
+        self.assertAlmostEqual(body.Shape.BoundBox.ZMin, -7)
+
+    def test_pad_side_face_changes_sketch_dimension(self):
+        body, sk, pad = self.padded_plate(5)
+        right = _face_with(pad.Shape, (1, 0, 0), 40)
+        plan = self.plan(body, "Pad." + right)
+        self.assertEqual(plan.kind, "sketch?")
+        self.doc.openTransaction("Push/pull")
+        used = plan.begin()
+        self.assertEqual(used.kind, "sketch")
+        self.assertEqual(used.name, "Width")
+        used.apply(4)
+        self.doc.commitTransaction()
+        self.assertAlmostEqual(sk.getDatum("Width").Value, 44)
+        self.assertAlmostEqual(body.Shape.BoundBox.XMax, 44)
+        self.assertAlmostEqual(body.Shape.BoundBox.XMin, 0)
+
+    def test_side_face_whose_dimension_moves_everything(self):
+        # The left line is placed by the corner's distance from the origin, which moves the
+        # whole rectangle: not that dimension, a new extrusion from the face
+        body, sk, pad = self.padded_plate(5)
+        left = _face_with(pad.Shape, (-1, 0, 0), 0)
+        used = self.push(self.plan(body, "Pad." + left), 3)
+        self.assertEqual(used.kind, "new feature")
+        self.assertAlmostEqual(body.Shape.BoundBox.XMin, -3)
+        self.assertAlmostEqual(body.Shape.BoundBox.XMax, 40)
+        self.assertAlmostEqual(sk.Constraints[8].Value, 0)
+
+    def test_unconstrained_side_face_adds_a_pad(self):
+        body, sk, pad = self.padded_plate(5, constrain=False)
+        right = _face_with(pad.Shape, (1, 0, 0), 40)
+        used = self.push(self.plan(body, "Pad." + right), 6)
+        self.assertEqual(used.kind, "new feature")
+        new = body.Tip
+        self.assertTrue(new.isDerivedFrom("PartDesign::Pad"))
+        self.assertIsNot(new, pad)
+        self.assertAlmostEqual(new.Length.Value, 6)
+        self.assertAlmostEqual(body.Shape.BoundBox.XMax, 46)
+        self.assertAlmostEqual(body.Shape.Volume, 46 * 30 * 5, 3)
+
+    def test_bottom_face_pushed_in_adds_a_pocket(self):
+        body, sk, pad = self.padded_plate(5)
+        bottom = _face_with(pad.Shape, (0, 0, -1), 0)
+        plan = self.plan(body, "Pad." + bottom)
+        self.assertEqual(plan.kind, "new feature")
+        self.push(plan, -2)
+        self.assertTrue(body.Tip.isDerivedFrom("PartDesign::Pocket"))
+        self.assertAlmostEqual(body.Shape.BoundBox.ZMin, 2)
+        self.assertAlmostEqual(body.Shape.Volume, 40 * 30 * 3, 3)
+
+    def test_new_feature_switches_between_pad_and_pocket(self):
+        body, sk, pad = self.padded_plate(5)
+        bottom = _face_with(pad.Shape, (0, 0, -1), 0)
+        self.doc.openTransaction("Push/pull")
+        plan = self.plan(body, "Pad." + bottom).begin()
+        plan.apply(3)
+        self.assertTrue(body.Tip.isDerivedFrom("PartDesign::Pad"))
+        plan.apply(-1)
+        self.assertTrue(body.Tip.isDerivedFrom("PartDesign::Pocket"))
+        plan.apply(0)
+        self.assertIs(body.Tip, pad)
+        plan.apply(2)
+        self.doc.commitTransaction()
+        self.assertEqual(len([o for o in body.Group if o.isDerivedFrom("PartDesign::Pad")]), 2)
+        self.assertAlmostEqual(body.Shape.BoundBox.ZMin, -2)
+
+    def test_escape_puts_everything_back(self):
+        body, sk, pad = self.padded_plate(5)
+        names = [o.Name for o in self.doc.Objects]
+        bottom = _face_with(pad.Shape, (0, 0, -1), 0)
+        self.doc.openTransaction("Push/pull")
+        plan = self.plan(body, "Pad." + bottom).begin()
+        plan.apply(4)
+        self.assertNotEqual([o.Name for o in self.doc.Objects], names)
+        self.doc.abortTransaction()
+        self.doc.recompute()
+        self.assertEqual([o.Name for o in self.doc.Objects], names)
