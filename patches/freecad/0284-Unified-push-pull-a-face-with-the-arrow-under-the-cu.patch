+def describe(plan, d, flush=None):
+    """(main text, detail text) of the readout for moving the face by d."""
+    word, before, after = plan.value_after(d)
+    what = tr(PP.WORDS.get(word, word))
+    target = getattr(plan.target, "Label", "")
+    if plan.radial and word in ("Radius", "Diameter", "dimension") and getattr(plan.info, "radius", None):
+        r = plan.info.radius + plan.info.sign * d
+        main = "⌀{} mm".format(_fmt(2 * r))
+    else:
+        main = "{}{} mm".format("+" if d > 0 else "", _fmt(d))
+    if after is None:
+        detail = target
+    elif word in ("new pad", "new pocket", "new pushpull"):
+        detail = tr("{what} {value} mm").format(what=what, value=_fmt(after))
+    else:
+        name = getattr(plan, "name", "") or ""
+        if name:
+            what = "{} ({})".format(what, name)
+        detail = tr("{object}: {what} {old} → {new} mm").format(object=target, what=what, old=_fmt(before), new=_fmt(after))
+    if flush is not None:
+        detail += "  ·  " + tr("flush with a face")
+    return main, detail
