+class _Background:
+    """重なりの計算を別のプロセス（GUI の無い FreeCAD）で行う。その間も画面は動き、止めるときはプロセスを
+    終わらせるだけで済む（同じプロセスで計算すると、計算の間は FreeCAD がマウスの操作を受け付けない）"""
+
+    def __init__(self, jobs, opt):
+        import json
+        import os
+        import queue
+        import subprocess
+        import sys
+        import tempfile
+        import threading
+
+        self.dir = tempfile.mkdtemp(prefix="designcheck-")
+        paths = {}
+        items = []
+        for a, b, need_touch in jobs:
+            for s in (a, b):
+                if id(s) not in paths:
+                    paths[id(s)] = os.path.join(self.dir, "%d.brep" % len(paths))
+                    s.exportBrep(paths[id(s)])
+            items.append({"a": paths[id(a)], "b": paths[id(b)], "touch": need_touch})
+        jobfile = os.path.join(self.dir, "jobs.json")
+        with open(jobfile, "w") as f:
+            json.dump({"opt": opt, "jobs": items}, f)
+        exe = os.path.join(App.getHomePath(), "bin", "FreeCADCmd.exe" if sys.platform == "win32" else "FreeCADCmd")
+        here = os.path.dirname(os.path.abspath(__file__))
+        code = "import sys; sys.path.insert(0, %r); import DesignCheck; DesignCheck.worker_main(%r)" % (here, jobfile)
+        self.proc = subprocess.Popen([exe, "-c", code], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
+                                     stdin=subprocess.DEVNULL, text=True)
+        self.results = queue.Queue()
+
+        def read():
+            for line in self.proc.stdout:
+                if line.startswith("{"):
+                    self.results.put(json.loads(line))
+            self.results.put(None)
+        threading.Thread(target=read, daemon=True).start()
+
+    def close(self):
+        import shutil
+        if self.proc.poll() is None:
+            self.proc.kill()
+        try:
+            self.proc.wait(timeout=5)
+        except Exception:
+            pass
+        shutil.rmtree(self.dir, ignore_errors=True)
+
+
+def worker_main(jobfile):
+    """別のプロセスでの重なりの計算（_Background から呼ばれる）。1 組ごとに結果を 1 行の JSON で出す"""
+    import json
+    import sys
+    with open(jobfile) as f:
+        job = json.load(f)
+    shapes = {}
+
+    def load(path):
+        if path not in shapes:
+            s = Part.Shape()
+            s.read(path)
+            shapes[path] = s
+        return shapes[path]
+    for i, j in enumerate(job["jobs"]):
+        v, center, touch = _pair_compute(load(j["a"]), load(j["b"]), j["touch"], job["opt"])
+        sys.stdout.write(json.dumps({"i": i, "v": v, "center": None if center is None else list(center),
+                                     "touch": touch}) + "\n")
+        sys.stdout.flush()
