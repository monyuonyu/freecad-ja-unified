+def cli_main():
+    """FreeCADCmd model.FCStd --design-check [interference]: the open document checked, the
+    issues as JSON on stdout, exit code 1 on an error"""
+    import json
+    import sys
+
+    doc = App.ActiveDocument
+    if doc is None:
+        raise RuntimeError("--design-check: no document is open (give a .FCStd file)")
+    doc.recompute()
+    what = App.ConfigGet("DesignCheck") or "all"
+    if what == "interference":
+        found = interferences(doc)
+        print(json.dumps({"interferences": found}, ensure_ascii=False, indent=1, default=lambda v: list(v)))
+        errors = any(f["volume"] is not None for f in found)
+    else:
+        issues = run(doc)
+        print(json.dumps({"summary": summary(issues), "issues": [i.as_dict(doc) for i in issues]},
+                         ensure_ascii=False, indent=1))  # fmt: skip
+        errors = bool(summary(issues)[ERROR])
+    sys.stdout.flush()
+    if errors:
+        sys.exit(1)
+
