+def one_items(obj):
+    """The containers (App::Part, groups) marked as one item that obj is in: the parts of one
+    item (a chair, a monitor arm, a bed welded together) overlap on purpose and are not checked
+    against each other (a room's model said 70 overlaps; reported on 0.7.9)"""
+    if obj is None:
+        return set()
+    return {o.Name for o in obj.InListRecursive if getattr(o, ONE_ITEM_PROP, False)}
+
+
+def set_one_item(container, on=True):
+    """Mark an App::Part or a group as one item (its parts are not checked against each other)"""
+    if ONE_ITEM_PROP not in container.PropertiesList:
+        container.addProperty("App::PropertyBool", ONE_ITEM_PROP, "DesignCheck",
+                              QT_TRANSLATE_NOOP("App::Property", "One item: the overlaps of its parts are "
+                                                "not checked"))  # fmt: skip
+    setattr(container, ONE_ITEM_PROP, bool(on))
+
+
+def interferences(doc=None, **options):
+    """Only the overlaps of the parts, as the design check finds them (the same measure from a
+    script): [{"a", "b" (labels), "names", "volume" (mm³; None: could not be checked),
+    "center"}]. Parts of one item are left out."""
+    doc = doc or App.ActiveDocument
+    opt = dict(DEFAULTS, floating=False, **options)
+    issues = []
+    check_interference(doc, issues, opt, parts(doc))
+    out = []
+    for i in issues:
+        if i.rule not in ("interference", "interference_unchecked") or _is_ignored(doc, i):
+            continue
+        a, b = (doc.getObject(n) for n in i.objects)
+        out.append({"a": a.Label, "b": b.Label, "names": list(i.objects), "volume": i.volume,
+                    "center": i.location})  # fmt: skip
+    return out
+
