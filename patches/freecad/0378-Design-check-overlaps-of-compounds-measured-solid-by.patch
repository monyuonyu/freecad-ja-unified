+        try:
+            c = a.common(b)
+            v = c.Volume
+            return v, (c.BoundBox.Center if v > 0 else None)
+        except Exception:
+            pass
+    total, box, failed = 0.0, None, False
+    for x in sa:
+        for y in sb:
+            if not x.BoundBox.intersect(y.BoundBox):
+                continue
+            try:
+                c = x.common(y)
+                v = c.Volume
+            except Exception:
+                failed = True
+                continue
+            if v > 0:
