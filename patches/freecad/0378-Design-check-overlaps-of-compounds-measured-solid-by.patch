@@ -0,0 +1,102 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+# The design check's overlaps (a room's model: 70 overlaps missed, a compound of 68 brackets
+# whose boolean failed taken as no overlap; reported on 0.7.9):
+#   FreeCADCmd -t TestDesignCheck
+
+import json
+import os
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+import FreeCAD as App
+import Part
+
+import DesignCheck
+
+
+def box(doc, name, x, y, z, l=10, w=10, h=10):
+    o = doc.addObject("Part::Box", name)
+    o.Length, o.Width, o.Height = l, w, h
+    o.Placement.Base = App.Vector(x, y, z)
+    return o
+
+
+class DesignCheckOverlapTest(unittest.TestCase):
+    def setUp(self):
+        DesignCheck._PAIR_CACHE.clear()
+        self.doc = App.newDocument("designcheck")
+
+    def tearDown(self):
+        App.closeDocument(self.doc.Name)
+
+    def test_a_compound_of_many_solids(self):
+        # 10 brackets in one shape; 3 of them through a bar
+        brackets = [Part.makeBox(4, 4, 4, App.Vector(10 * i, 0, 0)) for i in range(10)]
+        part = self.doc.addObject("Part::Feature", "Brackets")
+        part.Shape = Part.makeCompound(brackets)
+        box(self.doc, "Bar", 0, 1, 1, l=25, w=2, h=2)  # through brackets 0, 1, 2 (2 x 2 x 4 each)
+        self.doc.recompute()
+        found = DesignCheck.interferences(self.doc)
+        self.assertEqual(len(found), 1)
+        self.assertAlmostEqual(found[0]["volume"], 3 * 2 * 2 * 4, places=3)
+
+    def test_one_item_is_not_checked_inside(self):
+        item = self.doc.addObject("App::Part", "Chair")
+        a = box(self.doc, "Seat", 0, 0, 0)
+        b = box(self.doc, "Leg", 5, 5, 5)
+        item.addObject(a)
+        item.addObject(b)
+        c = box(self.doc, "Wall", 8, 0, 0)  # through the seat and the leg, not one item with them
+        self.doc.recompute()
+        names = lambda: sorted(tuple(sorted(f["names"])) for f in DesignCheck.interferences(self.doc))  # noqa: E731
+        self.assertIn(("Leg", "Seat"), names())
+        DesignCheck.set_one_item(item)
+        DesignCheck._PAIR_CACHE.clear()
+        self.assertNotIn(("Leg", "Seat"), names())
+        self.assertIn(("Seat", "Wall"), names())  # the item against other parts: still checked
+        self.assertTrue(c.Name)
+
+    def test_a_failed_boolean_is_said(self):
+        box(self.doc, "A", 0, 0, 0)
+        box(self.doc, "B", 5, 5, 5)
+        self.doc.recompute()
+        real = DesignCheck._common_volume
+        try:
+            DesignCheck._common_volume = lambda a, b: (None, None)
+            issues = DesignCheck.run(self.doc)
+        finally:
+            DesignCheck._common_volume = real
+        rules = [i.rule for i in issues]
+        self.assertIn("interference_unchecked", rules)
+        self.assertNotIn("interference", rules)
+        self.assertEqual([i.severity for i in issues if i.rule == "interference_unchecked"], [DesignCheck.WARNING])
+
+
+class DesignCheckCommandLineTest(unittest.TestCase):
+    def test_design_check_interference(self):
+        import DrawingPdf
+
+        tmp = tempfile.mkdtemp()
+        try:
+            doc = App.newDocument("dccli")
+            box(doc, "Shelf", 0, 0, 0, l=100, w=30, h=2)
+            box(doc, "Post", 50, 10, -20, l=3, w=3, h=60)
+            doc.recompute()
+            path = os.path.join(tmp, "m.FCStd")
+            doc.saveAs(path)
+            App.closeDocument(doc.Name)
+            proc = subprocess.run([DrawingPdf._freecadcmd(), path, "--design-check", "interference"],
+                                  capture_output=True, timeout=300, stdin=subprocess.DEVNULL)  # fmt: skip
+            out = proc.stdout.decode("utf-8", "replace")
+            self.assertEqual(proc.returncode, 1, out + proc.stderr.decode("utf-8", "replace"))
+            data = json.loads(out[out.index("{"):])
+            self.assertEqual([sorted((f["a"], f["b"])) for f in data["interferences"]], [["Post", "Shelf"]])
+            self.assertAlmostEqual(data["interferences"][0]["volume"], 3 * 3 * 2, places=3)
+        finally:
+            shutil.rmtree(tmp)
+
+
+if __name__ == "__main__":
+    unittest.main()
