index 000000000..78b9c41d1
--- /dev/null
+++ b/src/Mod/Unified/MjcfExport.py
@@ -0,0 +1,289 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""A rough MuJoCo model (MJCF) of a document: the parts as bodies with their mass, centre of
+mass and inertia (from the solids and a density), a box each for contacts with the
+surroundings (not with each other), and the assembly's joints as the bodies' joints. A starting point to edit, not a finished simulation (asked by a
+project that wrote this by hand for each model).
+
+    FreeCADCmd model.FCStd --export-mjcf model.xml [--mjcf-mesh]
+    MjcfExport.export(doc, "model.xml", density=7850, mesh=False) -> report
+
+Units: metres, kilograms (FreeCAD's mm are divided by 1000). Density: the part's material
+(ShapeMaterial's Density), else `density` (kg/m³, default 7850, steel); the report says which.
+The assembly's grounded parts are fixed to the world; from them the joints are followed:
+Revolute → hinge, Slider → slide, Cylindrical → hinge + slide, Ball → ball, Belt and Gears →
+a ratio of the two hinges (<equality joint>, teeth else radii), Fixed → the part
+rides on the other with no joint. A joint that closes a loop (a crank, its rod and the piston's
+slide) cannot be a tree's joint: it becomes an <equality connect> at the joint's point. Other
+kinds of joints, and parts no joint reaches, are said in the report (the latter get a free
+joint). Without an assembly every part is fixed to the world.
+"""
+
+import math
+import os
+import xml.etree.ElementTree as ET
+
+import FreeCAD as App
+
+TREE_JOINTS = {"Revolute": ["hinge"], "Slider": ["slide"], "Cylindrical": ["hinge", "slide"], "Ball": ["ball"]}
+
+
+def _f(x):
+    return "%.6g" % x
+
+
+def _vec(v, k=0.001):
+    return " ".join(_f(c * k) for c in (v.x, v.y, v.z))
+
+
+def _quat(rot):
+    q = rot.Q  # (x, y, z, w)
+    return " ".join(_f(c) for c in (q[3], q[0], q[1], q[2]))
+
+
+def _density(obj, default):
+    """kg/m³ of the part's material, else default; (value, from where)"""
+    for o in (obj, getattr(obj, "getLinkedObject", lambda *a: obj)(True)):
+        mat = getattr(o, "ShapeMaterial", None)
+        try:
+            d = mat.getPhysicalValue("Density") if mat is not None else None
+        except Exception:
+            d = None
+        if d is not None:
+            try:
+                value = App.Units.Quantity(d).getValueAs("kg/m^3").Value
+            except Exception:
+                value = float(getattr(d, "Value", d)) * 1e9  # kg/mm³
+            # FreeCAD's "Default" material is 1 kg/m³, a placeholder (an engine came to 1 g)
+            if value > 50 and getattr(mat, "Name", "") not in ("Default", ""):
+                return value, "material %s" % getattr(mat, "Name", "")
+    return default, "default"
+
+
+def _parts(doc):
+    """{name: (object, global shape)} of the visible solid parts (as the design check sees them)"""
+    import DesignCheck
+
+    shapes = DesignCheck.parts(doc)
+    return {n: (doc.getObject(n), s) for n, s in shapes.items() if s.Solids}
+
+
+WORLD = "__world__"
+WORLD_TYPES = ("App::Origin", "App::Line", "App::Plane", "App::Point", "Assembly::AssemblyObject")
+
+
+def _owner(obj, parts):
+    """The part (a key of parts) that obj is or is in; WORLD for the assembly's origin and its
+    axes and planes (a crank turned "in place" is joined to them)"""
+    if obj is None:
+        return None
+    if obj.TypeId in WORLD_TYPES:
+        return WORLD
+    if obj.Name in parts:
+        return obj.Name
+    for up in obj.InListRecursive:  # a feature of a body, a body of a part
+        if up.Name in parts:
+            return up.Name
+    if obj.isDerivedFrom("App::Link"):
+        return _owner(obj.getLinkedObject(True), parts)
+    return None
+
+
+def export(doc=None, path="model.xml", density=7850.0, mesh=False):
+    """Write the MJCF file. Returns a report {"bodies", "joints", "loops", "unsupported",
+    "free", "defaults" (parts given the default density)}"""
+    import Part
+
+    doc = doc or App.ActiveDocument
+    parts = _parts(doc)
+    if not parts:
+        raise RuntimeError("No visible solid part to write")
+    asm = next((o for o in doc.Objects if o.isDerivedFrom("Assembly::AssemblyObject")), None)
+    report = {"bodies": [], "joints": [], "loops": [], "coupled": [], "unsupported": [], "free": [], "defaults": []}
+
+    # the joints as edges between parts; the grounded parts
+    grounded, edges = set(), []
+    if asm is not None:
+        for j in asm.OutListRecursive:
+            if hasattr(j, "ObjectToGround"):
+                owner = _owner(j.ObjectToGround, parts)
+                if owner:
+                    grounded.add(owner)
+            elif getattr(j, "JointType", None) and hasattr(j, "Reference1"):
+                if getattr(j, "Activated", True) is False:
+                    continue
+                a = _owner(j.Reference1[0] if j.Reference1 else None, parts)
+                b = _owner(j.Reference2[0] if j.Reference2 else None, parts)
+                if a and b and a != b:
+                    edges.append((j, a, b))
+    else:
+        grounded = set(parts)
+
+    root = ET.Element("mujoco", model=doc.Label)
+    ET.SubElement(root, "compiler", angle="radian", autolimits="true")
+    asset = ET.SubElement(root, "asset") if mesh else None
+    world = ET.SubElement(root, "worldbody")
+    equality = ET.Element("equality")
+    folder = os.path.splitext(path)[0] + "_meshes"
+    placed = {}  # part name -> (xml body, global placement of the body frame)
+
+    def body_xml(parent, name, parent_plc):
+        obj, shape = parts[name]
+        plc = shape.Placement
+        rel = parent_plc.inverse().multiply(plc)
+        body = ET.SubElement(parent, "body", name=obj.Label, pos=_vec(rel.Base), quat=_quat(rel.Rotation))
+        rho, where = _density(obj, density)
+        if where == "default":
+            report["defaults"].append(obj.Label)
+        local = shape.transformed(plc.inverse().toMatrix())  # in the body frame
+        vol = local.Volume  # mm³
+        mass = vol * rho * 1e-9
+        com = local.CenterOfMass if hasattr(local, "CenterOfMass") else local.BoundBox.Center
+        try:
+            m = local.MatrixOfInertia  # about the centre of mass, unit density, mm^5
+            k = rho * 1e-9 * 1e-6  # kg/mm³ -> kg, mm² -> m²
+            full = (m.A11 * k, m.A22 * k, m.A33 * k, m.A12 * k, m.A13 * k, m.A23 * k)
+            import numpy
+
+            eig = numpy.linalg.eigvalsh(numpy.array([[full[0], full[3], full[4]], [full[3], full[1], full[5]],
+                                                     [full[4], full[5], full[2]]]))  # fmt: skip
+            if eig.min() > 1e-12:
+                ET.SubElement(body, "inertial", pos=_vec(com), mass=_f(mass), fullinertia=" ".join(_f(x) for x in full))
+            else:  # a part of a few mm: under MuJoCo's smallest number, refused; a floor instead
+                ET.SubElement(body, "inertial", pos=_vec(com), mass=_f(max(mass, 1e-6)),
+                              diaginertia=" ".join(_f(max(x, 1e-12)) for x in full[:3]))  # fmt: skip
+        except Exception:
+            ET.SubElement(body, "inertial", pos=_vec(com), mass=_f(mass), diaginertia="1e-6 1e-6 1e-6")
+        bb = local.BoundBox
+        ET.SubElement(body, "geom", type="box", name=obj.Label + "_box", pos=_vec(bb.Center),
+                      size=" ".join(_f(max(d, 1e-3) / 2 * 0.001) for d in (bb.XLength, bb.YLength, bb.ZLength)),
+                      mass="0", contype="1", conaffinity="0")  # fmt: skip
+        # the boxes do not push each other (an engine's boxes overlap: the head's holds the valves,
+        # and the crank stood jammed), only things given conaffinity="1" (a floor, a robot)
+        if mesh:
+            os.makedirs(folder, exist_ok=True)
+            stl = os.path.join(folder, obj.Name + ".stl")
+            import MeshPart
+
+            m2 = local.copy()
+            m2.scale(0.001)
+            # for the looks: coarse (a camshaft of fine features came to 29 MB, over MuJoCo's
+            # 200,000 faces, and took minutes); binary STL (MuJoCo does not read ASCII)
+            mesh_ = MeshPart.meshFromShape(Shape=m2, LinearDeflection=max(m2.BoundBox.DiagonalLength / 150.0, 1e-5),
+                                           AngularDeflection=0.6, Relative=False)  # fmt: skip
+            if mesh_.CountFacets > 190000:
+                mesh_.decimate(0.5, 0.99)
+            mesh_.write(stl)
+            ET.SubElement(asset, "mesh", name=obj.Name, file=os.path.relpath(stl, os.path.dirname(os.path.abspath(path))))
+            ET.SubElement(body, "geom", type="mesh", mesh=obj.Name, contype="0", conaffinity="0", mass="0")
+        placed[name] = (body, plc)
+        report["bodies"].append({"name": obj.Label, "mass": mass, "density": rho, "density_from": where})
+        return body
+
+    placed[WORLD] = (world, App.Placement())
+    hinge_of = {}  # part -> the name of the hinge it turns on
+    for name in sorted(grounded):
+        body_xml(world, name, App.Placement())
+    # follow the joints from the grounded parts (breadth first)
+    done = set()
+    frontier = [WORLD] + sorted(grounded)
+    while frontier:
+        nxt = []
+        for here in frontier:
+            for j, a, b in edges:
+                if j.Name in done or here not in (a, b):
+                    continue
+                other = b if here == a else a
+                kind = getattr(j, "JointType", "")
+                if kind in ("Belt", "Gears"):  # a ratio between two hinges: after the tree
+                    continue
+                done.add(j.Name)
+                jref, jplc = (j.Reference1, j.Placement1) if other == a else (j.Reference2, j.Placement2)
+                try:
+                    import UtilsAssembly
+
+                    jcs = UtilsAssembly.getJcsGlobalPlc(jplc, jref)
+                except Exception:
+                    jcs = parts[other][1].Placement.multiply(jplc)
+                if other == WORLD:  # its parts reached first from the other side: a loop to the world
+                    other, here = here, WORLD
+                if other in placed:  # closes a loop
+                    if kind in ("Revolute", "Ball", "Cylindrical", "Slider", "Fixed"):
+                        attrs = {"body1": parts[other][0].Label, "anchor": _vec(placed[other][1].inverse().multVec(jcs.Base))}
+                        if here != WORLD:
+                            attrs["body2"] = parts[here][0].Label
+                        ET.SubElement(equality, "connect", **attrs)
+                        report["loops"].append(j.Label)
+                    else:
+                        report["unsupported"].append("%s (%s)" % (j.Label, kind))
+                    continue
+                if kind != "Fixed" and kind not in TREE_JOINTS:
+                    report["unsupported"].append("%s (%s)" % (j.Label, kind))
+                    continue
+                body = body_xml(placed[here][0], other, placed[here][1])
+                if kind in TREE_JOINTS:
+                    rel = parts[other][1].Placement.inverse().multiply(jcs)  # the joint in the child's frame
+                    axis = rel.Rotation.multVec(App.Vector(0, 0, 1))
+                    for t in TREE_JOINTS[kind]:
+                        attrs = {"name": j.Label + ("" if len(TREE_JOINTS[kind]) == 1 else "_" + t), "type": t,
+                                 "pos": _vec(rel.Base)}  # fmt: skip
+                        if t != "ball":
+                            attrs["axis"] = " ".join(_f(c) for c in (axis.x, axis.y, axis.z))
+                        if t == "hinge" and getattr(j, "EnableAngleMin", False) and getattr(j, "EnableAngleMax", False):
+                            attrs["range"] = "%s %s" % (_f(math.radians(j.AngleMin.Value)), _f(math.radians(j.AngleMax.Value)))
+                        if t == "slide" and getattr(j, "EnableLengthMin", False) and getattr(j, "EnableLengthMax", False):
+                            attrs["range"] = "%s %s" % (_f(j.LengthMin.Value * 0.001), _f(j.LengthMax.Value * 0.001))
+                        ET.SubElement(body, "joint", **attrs)
+                    if kind == "Revolute":
+                        hinge_of[other] = (j.Label, jcs.Rotation.multVec(App.Vector(0, 0, 1)))
+                    report["joints"].append({"name": j.Label, "type": kind})
+                nxt.append(other)
+        frontier = nxt
+    # belts and gears: the turn of one hinge a ratio of the other's (teeth, else radii)
+    for j, a, b in edges:
+        kind = getattr(j, "JointType", "")
+        if kind not in ("Belt", "Gears"):
+            continue
+        s1 = getattr(j, "Teeth1", 0) or getattr(getattr(j, "Distance", None), "Value", 0)
+        s2 = getattr(j, "Teeth2", 0) or getattr(getattr(j, "Distance2", None), "Value", 0)
+        if a in hinge_of and b in hinge_of and s1 and s2:
+            # w1 r1 = w2 r2, turning the same way (a belt) or the other way (gears), about the
+            # hinges' own axes (one may point the other way)
+            (n1, ax1), (n2, ax2) = hinge_of[a], hinge_of[b]
+            same = ax1.dot(ax2) >= 0
+            k = s2 / s1 * (1 if kind == "Belt" else -1) * (1 if same else -1)
+            ET.SubElement(equality, "joint", joint1=n1, joint2=n2, polycoef="0 %s 0 0 0" % _f(k))
+            report["coupled"].append("%s (%s, %g)" % (j.Label, kind, k))
+        else:
+            report["unsupported"].append("%s (%s: no hinge on both parts)" % (j.Label, kind))
+    # parts no joint reaches: free bodies
+    for name in sorted(set(parts) - set(placed) - {WORLD}):
+        body = body_xml(world, name, App.Placement())
+        ET.SubElement(body, "freejoint")
+        report["free"].append(parts[name][0].Label)
+    if len(equality):
+        root.append(equality)
+    ET.indent(root)
+    folder_out = os.path.dirname(os.path.abspath(path))
+    os.makedirs(folder_out, exist_ok=True)
+    ET.ElementTree(root).write(path, encoding="utf-8", xml_declaration=True)
+    return report
+
+
+def cli_main():
+    path = App.ConfigGet("ExportMjcf")
+    doc = App.ActiveDocument
+    if doc is None:
+        raise RuntimeError("--export-mjcf: no document is open (give a .FCStd file)")
+    doc.recompute()
+    rep = export(doc, path, mesh=bool(App.ConfigGet("MjcfMesh")))
+    print("Wrote %s: %d bodies, %d joints" % (path, len(rep["bodies"]), len(rep["joints"])))
+    if rep["loops"]:
+        print("  loops closed with <equality connect>: " + ", ".join(rep["loops"]))
+    if rep["coupled"]:
+        print("  belts and gears as a ratio of two hinges: " + ", ".join(rep["coupled"]))
+    if rep["unsupported"]:
+        print("  joints left out (no MuJoCo joint for them): " + ", ".join(rep["unsupported"]))
+    if rep["free"]:
+        print("  parts no joint reaches (free joints): " + ", ".join(rep["free"]))
+    if rep["defaults"]:
+        print("  density 7850 kg/m³ assumed (no material): " + ", ".join(rep["defaults"]))
diff --git a/src/Mod/Unified/TestMjcfExport.py b/src/Mod/Unified/TestMjcfExport.py
new file mode 100644
index 000000000..dbd8a6e28
--- /dev/null
+++ b/src/Mod/Unified/TestMjcfExport.py
@@ -0,0 +1,75 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+# A rough MuJoCo model of an assembly (asked by a project that wrote it by hand each time):
+#   FreeCADCmd -t TestMjcfExport
+
+import os
+import shutil
+import tempfile
+import unittest
+import xml.etree.ElementTree as ET
+
+import FreeCAD as App
+
+import MjcfExport
+import TestAssemblySolve
+
+
+class MjcfExportTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.mkdtemp()
+        self.doc = TestAssemblySolve.build(revolute_drive=True)[0]
+
+    def tearDown(self):
+        App.closeDocument(self.doc.Name)
+        shutil.rmtree(self.tmp)
+
+    def test_crank_rod_piston(self):
+        path = os.path.join(self.tmp, "crank.xml")
+        rep = MjcfExport.export(self.doc, path, mesh=True)
+        root = ET.parse(path).getroot()
+        bodies = {b.get("name"): b for b in root.iter("body")}
+        self.assertEqual(sorted(bodies), ["Base", "Crank", "Piston", "Rod"])
+        # the tree from the grounded base: the crank and the piston on it, the rod on the crank
+        world = root.find("worldbody")
+        self.assertEqual([b.get("name") for b in world.findall("body")], ["Base"])
+        self.assertIn("Rod", [b.get("name") for b in bodies["Crank"].findall("body")])
+        joints = {j.get("name"): j.get("type") for j in root.iter("joint")}
+        self.assertEqual(joints.get("Drive"), "hinge")
+        self.assertEqual(joints.get("CrankRod"), "hinge")
+        self.assertEqual(joints.get("PistonSlide"), "slide")
+        # the loop crank-rod-piston closed by a constraint
+        self.assertEqual(len(root.findall("equality/connect")), 1)
+        self.assertEqual(rep["loops"], ["RodPiston"])
+        # 5 mm boxes of steel: 125 mm³ * 7850 kg/m³
+        mass = float(bodies["Rod"].find("inertial").get("mass"))
+        self.assertAlmostEqual(mass, 125e-9 * 7850, places=9)
+        self.assertEqual(len(rep["defaults"]), 4)
+        self.assertTrue(os.path.isfile(os.path.join(self.tmp, "crank_meshes", "Rod.stl")))
+        try:
+            import mujoco
+        except ImportError:
+            return
+        model = mujoco.MjModel.from_xml_path(path)
+        self.assertEqual(model.nbody, 5)
+
+    def test_a_joint_to_the_assembly_origin_is_to_the_world(self):
+        # a crank turned "in place" is joined to the assembly's origin: it was left a free body
+        asm = self.doc.getObject("Assembly")
+        origin = getattr(asm, "Origin", None)
+        if origin is None:
+            self.skipTest("the assembly has no origin")
+        drive = self.doc.getObject("Drive")
+        drive.Reference1 = (origin, ["", ""])
