From b22389a9c30b59e0e788b8524e998c489a366f45 Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Sun, 27 Sep 2026 08:17:35 +0900
Subject: [PATCH 41/90] Unified: sketch toolbars fit on one row

The B-spline tools and the visual helpers are used now and then and are
in the Sketch menu. Without their toolbars the drawing, constraint and
editing tools fit on one row at 1600 pixels, where some of them were
hidden behind overflow buttons before.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/Mod/Unified/Gui/Workbench.cpp | 10 +++-------
 1 file changed, 3 insertions(+), 7 deletions(-)

diff --git a/src/Mod/Unified/Gui/Workbench.cpp b/src/Mod/Unified/Gui/Workbench.cpp
index 7bc1d718d..646f5a6e5 100644
--- a/src/Mod/Unified/Gui/Workbench.cpp
+++ b/src/Mod/Unified/Gui/Workbench.cpp
@@ -250,7 +250,7 @@ Gui::ToolBarItem* Workbench::setupToolBars() const
     *check << "Std_Measure"
            << "Part_CheckGeometry";
 
-    // Sketch tools: the same toolbars as in Sketcher, shown only while a sketch is edited
+    // Sketch tools: the toolbars of Sketcher, shown only while a sketch is edited
     using Vis = Gui::ToolBarItem::DefaultVisibility;
     auto editMode = new Gui::ToolBarItem(root, Vis::Unavailable);
     editMode->setCommand("Edit Mode");
@@ -264,12 +264,8 @@ Gui::ToolBarItem* Workbench::setupToolBars() const
     auto tools = new Gui::ToolBarItem(root, Vis::Unavailable);
     tools->setCommand("Sketcher Tools");
     SketcherGui::addSketcherWorkbenchTools(*tools);
-    auto bspline = new Gui::ToolBarItem(root, Vis::Unavailable);
-    bspline->setCommand("B-Spline Tools");
-    SketcherGui::addSketcherWorkbenchBSplines(*bspline);
-    auto visual = new Gui::ToolBarItem(root, Vis::Unavailable);
-    visual->setCommand("Visual Helpers");
-    SketcherGui::addSketcherWorkbenchVisual(*visual);
+    // The B-spline tools and the visual helpers are used now and then: they are in the
+    // Sketch menu, so that the tools above fit on one row without an overflow menu
 
     return root;
 }
