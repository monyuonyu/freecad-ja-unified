From 17f3d2f8d1c01f968410475cbcfefc44be34bec8 Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Sun, 27 Sep 2026 13:22:27 +0900
Subject: [PATCH 091/202] Unified: show the task panel on dialog signals
 instead of polling

Gui::ControlSingleton gets dialogShown() and dialogClosed() signals
(closedDialog runs for every way a dialog ends). The panel is shown and
hidden on them; the model is brought into view only when a tool has
finished (after a sketch's edit mode has ended), no longer on every
correction. If the dock or its overlay is shown again while no dialog is
open, an event filter hides it; this replaces the 300 ms timer and the
objectName prefix match of the overlay.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/Gui/Control.cpp               |   2 +
 src/Gui/Control.h                 |   6 ++
 src/Mod/Unified/Gui/TaskPanel.cpp | 109 +++++++++++++++++++++++-------
 3 files changed, 92 insertions(+), 25 deletions(-)

diff --git a/src/Gui/Control.cpp b/src/Gui/Control.cpp
index 244563d4e..eda61d271 100644
--- a/src/Gui/Control.cpp
+++ b/src/Gui/Control.cpp
@@ -192,6 +192,7 @@ void ControlSingleton::showDialog(Gui::TaskView::TaskDialog* dlg, App::Document*
     connect(dlg, &TaskView::TaskDialog::aboutToBeDestroyed, this, [this, attachTo] {
         closedDialog(attachTo);
     });
+    Q_EMIT dialogShown();
 }
 
 Gui::TaskView::TaskDialog* ControlSingleton::activeDialog(App::Document* attachedTo) const
@@ -268,6 +269,7 @@ void ControlSingleton::closedDialog(App::Document* /*attachedTo*/)
             | QDockWidget::DockWidgetFloatable
         );
     }
+    Q_EMIT dialogClosed();
 }
 
 bool ControlSingleton::isAllowedAlterDocument(App::Document* attachedTo) const
diff --git a/src/Gui/Control.h b/src/Gui/Control.h
index 8941021b7..3ec601517 100644
--- a/src/Gui/Control.h
+++ b/src/Gui/Control.h
@@ -94,6 +94,12 @@ public:
      */
     bool isAllowedAlterSelection(App::Document* attachedTo = nullptr) const;
 
+Q_SIGNALS:
+    /// A task dialog was added to the task view
+    void dialogShown();
+    /// A task dialog was closed, whichever way (accepted, rejected, removed)
+    void dialogClosed();
+
 public Q_SLOTS:
     void accept(App::Document* attachedTo = nullptr);
     void reject(App::Document* attachedTo = nullptr);
diff --git a/src/Mod/Unified/Gui/TaskPanel.cpp b/src/Mod/Unified/Gui/TaskPanel.cpp
index b0c31d78c..4ef423a90 100644
--- a/src/Mod/Unified/Gui/TaskPanel.cpp
+++ b/src/Mod/Unified/Gui/TaskPanel.cpp
@@ -4,11 +4,15 @@
 #include <QTabWidget>
 #include <QTimer>
 
+#include <QEvent>
+
+#include <Gui/Application.h>
 #include <Gui/Control.h>
 #include <Gui/MainWindow.h>
 #include <Gui/TaskView/TaskView.h>
 #include <Gui/View3DInventor.h>
 #include <Gui/View3DInventorViewer.h>
+#include <Gui/ViewProviderDocumentObject.h>
 #include <Inventor/SbBox.h>
 
 #include "TaskPanel.h"
@@ -52,6 +56,20 @@ void bringModelIntoView()
     }
 }
 
+QWidget* overlayOf(QDockWidget* dock)
+{
+    // With the panel overlaid on the view, the overlay around it has a title bar of its own
+    for (QWidget* w = dock->parentWidget(); w; w = w->parentWidget()) {
+        if (w->inherits("Gui::OverlayTabWidget")) {
+            return w;
+        }
+    }
+    return nullptr;
+}
+
+QObject* showWatcher = nullptr;
+
+// Show the panel (and its overlay) exactly while a task dialog is open
 void update(Gui::TaskView::TaskView* panel)
 {
     QDockWidget* dock = dockOf(panel);
@@ -59,31 +77,51 @@ void update(Gui::TaskView::TaskView* panel)
         return;
     }
     bool inUse = Gui::Control().activeDialog() != nullptr;
-    // With the panel overlaid on the view, the overlay around it has a title bar of its own
-    // that would stay behind: hide both (the overlay shows the panel again when only one of
-    // them is hidden)
-    QWidget* overlay = nullptr;
-    for (QWidget* w = dock->parentWidget(); w; w = w->parentWidget()) {
-        if (qobject_cast<QTabWidget*>(w) && w->objectName().startsWith(QLatin1String("Overlay"))) {
-            overlay = w;
-            break;
-        }
+    QWidget* overlay = overlayOf(dock);
+    if (overlay && showWatcher) {
+        overlay->installEventFilter(showWatcher);  // the panel may have moved into an overlay
     }
+    // Hide both: the overlay shows the panel again when only one of them is hidden
     if (overlay && overlay->isVisible() != inUse) {
         dock->setVisible(inUse);
         overlay->setVisible(inUse);
-        if (!inUse) {
-            bringModelIntoView();
-        }
         return;
     }
     if (dock->isVisible() != inUse) {
         dock->setVisible(inUse);
-        if (!inUse) {
-            bringModelIntoView();
-        }
     }
 }
+
+void scheduleUpdate(Gui::TaskView::TaskView* panel)
+{
+    // The dialog is registered/removed right after the signals: look once they are through
+    QTimer::singleShot(0, panel, [panel]() { update(panel); });
+}
+
+// The overlay (or the dock) may be shown again by others, e.g. when the mouse is over the
+// edge of the view: put it back
+class ShowWatcher: public QObject
+{
+public:
+    explicit ShowWatcher(Gui::TaskView::TaskView* panel)
+        : QObject(panel)
+        , panel(panel)
+    {}
+
+protected:
+    bool eventFilter(QObject* obj, QEvent* ev) override
+    {
+        if (ev->type() == QEvent::Show && !Gui::Control().activeDialog()) {
+            scheduleUpdate(panel);
+        }
+        return QObject::eventFilter(obj, ev);
+    }
+
+private:
+    Gui::TaskView::TaskView* panel;
+};
+
+bool viewAfterEdit = false;
 }  // namespace
 
 void UnifiedGui::installTaskPanelAutoHide()
@@ -94,17 +132,38 @@ void UnifiedGui::installTaskPanelAutoHide()
         if (!panel) {
             return;
         }
-        QObject::connect(panel, &Gui::TaskView::TaskView::taskUpdate, panel, [panel]() {
-            // The dialog is registered/removed right after the signal: look once it is done.
-            // Closing a sketch takes a little longer (the edit mode is left afterwards).
-            QTimer::singleShot(0, panel, [panel]() { update(panel); });
-            QTimer::singleShot(300, panel, [panel]() { update(panel); });
+        auto& control = Gui::Control();
+        QObject::connect(&control, &Gui::ControlSingleton::dialogShown, panel, [panel]() {
+            scheduleUpdate(panel);
+        });
+        QObject::connect(&control, &Gui::ControlSingleton::dialogClosed, panel, [panel]() {
+            QTimer::singleShot(0, panel, [panel]() {
+                update(panel);
+                if (Gui::Control().activeDialog()) {
+                    return;
+                }
+                // Only when a tool has finished: make sure the model is in view. A sketch
+                // restores its camera when its edit mode ends, after the dialog: wait for it.
+                if (Gui::Application::Instance->editDocument()) {
+                    viewAfterEdit = true;
+                }
+                else {
+                    bringModelIntoView();
+                }
+            });
         });
-        // Not every way a dialog closes is announced (e.g. leaving a sketch), and the overlay
-        // may show the panel again later: also look regularly. It only compares two flags.
-        auto* timer = new QTimer(panel);
-        QObject::connect(timer, &QTimer::timeout, panel, [panel]() { update(panel); });
-        timer->start(300);
+        Gui::Application::Instance->signalResetEdit.connect(
+            [](const Gui::ViewProviderDocumentObject&) {
+                if (viewAfterEdit) {
+                    viewAfterEdit = false;
+                    QTimer::singleShot(0, []() { bringModelIntoView(); });
+                }
+            }
+        );
+        showWatcher = new ShowWatcher(panel);
+        if (QDockWidget* dock = dockOf(panel)) {
+            dock->installEventFilter(showWatcher);
+        }
         update(panel);
     });
 }
