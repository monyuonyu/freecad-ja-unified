@@ -0,0 +1,122 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""Lines of an opened DXF/DWG/JWW drawing as the outline of a new part.
+
+An opened 2D drawing is loose lines (often one object per line). Extruding a picked line used to
+stop with "an active body is required". Instead, the closed outline the picked lines belong to
+becomes a sketch in a new part, which the tool then uses. Called from PartDesign's getBody() in
+the integrated environment (PartDesignGui::adoptPickedLooseOutline).
+"""
+
+import FreeCAD as App
+import FreeCADGui as Gui
+
+def _is_loose_2d(obj):
+    """A shape of lines only (no faces or solids), not part of a part (body)"""
+    if obj is None or not obj.isDerivedFrom("Part::Feature"):
+        return False
+    if obj.isDerivedFrom("PartDesign::Feature") or obj.isDerivedFrom("Part::Part2DObject"):
+        return False
+    if any(p.isDerivedFrom("PartDesign::Body") for p in obj.InList):
+        return False
+    shape = obj.Shape
+    return not shape.isNull() and bool(shape.Edges) and not shape.Faces and not shape.Solids
+
+
+def _same_point(a, b):
+    return (a - b).Length <= 1e-4
+
+
+def closed_loops(edges):
+    """The closed wires that can be made of the edges (edges of other loops are left out)"""
+    import Part
+
+    loops = []
+    for group in Part.sortEdges(edges):
+        try:
+            wire = Part.Wire(group)
+        except Exception:
+            continue
+        if wire.isClosed() or _same_point(wire.Vertexes[0].Point, wire.Vertexes[-1].Point):
+            loops.append(wire)
+    return loops
+
+
+def _touches(wire, edges):
+    for edge in edges:
+        mid = edge.valueAt((edge.FirstParameter + edge.LastParameter) / 2)
+        if wire.distToShape(_vertex(mid))[0] <= 1e-4:
+            return True
+    return False
+
+
+def _vertex(point):
+    import Part
+
+    return Part.Vertex(point)
+
+
+def outline_for(picked_objects, picked_edges, candidates):
+    """The closed loops that contain the picked edges, from the edges of the picked objects
+    and, if those do not close, of the other loose 2D objects in the same plane"""
+    own = [e for o in picked_objects for e in o.Shape.Edges]
+    loops = [w for w in closed_loops(own) if _touches(w, picked_edges)]
+    if loops:
+        return loops, list(picked_objects)
+    everything = list(picked_objects) + [o for o in candidates if o not in picked_objects]
+    edges = [e for o in everything for e in o.Shape.Edges]
+    loops = [w for w in closed_loops(edges) if _touches(w, picked_edges)]
+    used = []
+    for obj in everything:
+        if any(_touches(w, obj.Shape.Edges) for w in loops):
+            used.append(obj)
+    return loops, used
+
+
+def adopt():
+    """Make a part (body) from the closed outline of the picked loose lines.
+
+    Returns the name of the new body, or None if the selection is not such lines (then the
+    caller goes on as before)."""
+    selection = Gui.Selection.getSelectionEx()
+    if not selection or not all(_is_loose_2d(s.Object) for s in selection):
+        return None
+    doc = selection[0].Object.Document
+    picked = [s.Object for s in selection]
+    picked_edges = []
+    for s in selection:
+        subs = [x for x in s.SubObjects if x.ShapeType == "Edge"]
+        picked_edges += subs or s.Object.Shape.Edges
+    candidates = [o for o in doc.Objects if _is_loose_2d(o) and o.Visibility]
+    loops, used = outline_for(picked, picked_edges, candidates)
+    if not loops:
+        App.Console.PrintUserWarning(
+            App.Qt.translate(
+                "Unified",
+                "The picked lines do not make a closed outline, so they cannot be extruded. "
+                "Close the gaps, or pick lines that go all the way round.",
+            )
+            + "\n"
+        )
+        return None
+
+    import Draft
+
+    doc.openTransaction(App.Qt.translate("Unified", "Part from drawing lines"))
+    try:
+        sketch = Draft.make_sketch(loops, autoconstraints=True, name="Sketch")
+        if sketch is None:
+            doc.abortTransaction()
+            return None
+        body = doc.addObject("PartDesign::Body", "Body")
+        body.addObject(sketch)
+        for obj in used:
+            obj.Visibility = False
+        doc.recompute()
+    except Exception as e:
+        doc.abortTransaction()
+        App.Console.PrintWarning("Unified: outline from lines failed: {}\n".format(e))
+        return None
+    doc.commitTransaction()
+    Gui.Selection.clearSelection()
+    Gui.Selection.addSelection(doc.Name, sketch.Name)
+    return body.Name
