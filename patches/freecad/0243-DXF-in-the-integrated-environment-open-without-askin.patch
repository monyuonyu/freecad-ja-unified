+PartDesign::Body* adoptPickedLooseOutline()
+{
+    // In Python (Unified's LooseOutline): finding closed outlines in loose lines and turning
+    // them into a sketch is done by Part and Draft there
+    std::string bodyName;
+    {
+        Base::PyGILStateLocker lock;
+        try {
+            Py::Module module(PyImport_ImportModule("LooseOutline"), true);
+            if (module.isNull()) {
+                PyErr_Clear();
+                return nullptr;
+            }
+            Py::Object result = module.callMemberFunction("adopt");
+            if (!result.isString()) {
+                return nullptr;
+            }
+            bodyName = Py::String(result).as_std_string("utf-8");
+        }
+        catch (Py::Exception&) {
+            Base::PyException e;
+            e.reportException();
+            return nullptr;
+        }
+    }
+    App::Document* doc = App::GetApplication().getActiveDocument();
+    App::DocumentObject* body = doc ? doc->getObject(bodyName.c_str()) : nullptr;
+    if (!body) {
+        return nullptr;
+    }
+    // The selection (the new sketch) is kept: the tool goes on with it
+    return makeBodyActive(body, doc, nullptr, nullptr);
+}
