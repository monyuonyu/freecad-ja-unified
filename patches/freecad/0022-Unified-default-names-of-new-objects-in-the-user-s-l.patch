index 000000000..a6195a37a
--- /dev/null
+++ b/src/Mod/Unified/Gui/Labels.cpp
@@ -0,0 +1,95 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+#include <QApplication>
+#include <QRegularExpression>
+#include <QTimer>
+
+#include <App/Application.h>
+#include <App/Document.h>
+#include <App/DocumentObject.h>
+#include <App/DocumentObserver.h>
+#include <Base/Type.h>
+
+#include "Labels.h"
+
+namespace
+{
+// Type name → English default label base, as the commands create them
+struct DefaultLabel
+{
+    const char* type;
+    const char* label;
+};
+// clang-format off
+const DefaultLabel defaultLabels[] = {
+    {"PartDesign::Body", "Body"},
+    {"Sketcher::SketchObject", "Sketch"},
+    {"PartDesign::Pad", "Pad"},
+    {"PartDesign::Pocket", "Pocket"},
+    {"PartDesign::Revolution", "Revolution"},
+    {"PartDesign::Groove", "Groove"},
+    {"PartDesign::Hole", "Hole"},
+    {"PartDesign::Fillet", "Fillet"},
+    {"PartDesign::Chamfer", "Chamfer"},
+    {"PartDesign::Draft", "Draft"},
+    {"PartDesign::Thickness", "Thickness"},
+    {"PartDesign::Mirrored", "Mirrored"},
+    {"PartDesign::LinearPattern", "LinearPattern"},
+    {"PartDesign::PolarPattern", "PolarPattern"},
+    {"PartDesign::MultiTransform", "MultiTransform"},
+    {"PartDesign::Boolean", "Boolean"},
+    {"PartDesign::AdditiveLoft", "AdditiveLoft"},
+    {"PartDesign::SubtractiveLoft", "SubtractiveLoft"},
+    {"PartDesign::AdditivePipe", "AdditivePipe"},
+    {"PartDesign::SubtractivePipe", "SubtractivePipe"},
+    {"PartDesign::AdditiveHelix", "AdditiveHelix"},
+    {"PartDesign::SubtractiveHelix", "SubtractiveHelix"},
+    {"PartDesign::Plane", "DatumPlane"},
+    {"PartDesign::Line", "DatumLine"},
+    {"PartDesign::Point", "DatumPoint"},
+    {"PartDesign::CoordinateSystem", "Local_CS"},
+    {"PartDesign::ShapeBinder", "ShapeBinder"},
+    {"PartDesign::SubShapeBinder", "Binder"},
+    {"App::Part", "Part"},
+};
+// clang-format on
+
+void localize(const App::DocumentObject* obj)
+{
+    for (const auto& entry : defaultLabels) {
+        Base::Type type = Base::Type::fromName(entry.type);
+        if (type.isBad() || obj->getTypeId() != type) {
+            continue;
+        }
+        // Only the untouched English default, with the number FreeCAD adds for uniqueness
+        QString base = QString::fromLatin1(entry.label);
+        QString label = QString::fromUtf8(obj->Label.getValue());
+        QRegularExpression pattern(QStringLiteral("^%1(\\d*)$").arg(QRegularExpression::escape(base)));
+        auto match = pattern.match(label);
+        if (!match.hasMatch()) {
+            return;
+        }
+        QString translated = QApplication::translate("UnifiedGui::Labels", entry.label);
+        if (translated == base) {
+            return;  // no translation for the current language
+        }
+        const_cast<App::DocumentObject*>(obj)->Label.setValue(
+            (translated + match.captured(1)).toUtf8().constData()
+        );
+        return;
+    }
+}
+}  // namespace
+
+void UnifiedGui::installLocalizedLabels()
+{
+    App::GetApplication().signalNewObject.connect([](const App::DocumentObject& obj) {
+        // After the command that created the object has set its label
+        App::DocumentObjectT ref(&obj);
+        QTimer::singleShot(0, [ref]() {
+            if (App::DocumentObject* o = ref.getObject()) {
+                localize(o);
+            }
+        });
+    });
+}
diff --git a/src/Mod/Unified/Gui/Labels.h b/src/Mod/Unified/Gui/Labels.h
new file mode 100644
index 000000000..9b96e49b1
--- /dev/null
+++ b/src/Mod/Unified/Gui/Labels.h
@@ -0,0 +1,15 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+#pragma once
+
+namespace UnifiedGui
+{
+
+/**
+ * New objects get the default label of their type in the user's language ("押し出し001"
+ * instead of "Pad001"), as datums and origins already do. Only labels that are still the
+ * English default are changed; the internal names used by scripts stay the same.
+ */
+void installLocalizedLabels();
+
+}  // namespace UnifiedGui
