@@ -297,6 +297,28 @@ class DocumentTest(unittest.TestCase):
         self.assertEqual(rows[screw[0]][0], "2")
         self.assertIn("JIS B 1176", rows[screw[0]][1])
 
+    def test_design_check_accepts_the_thread(self):
+        """A shelf screw in its tapped hole is no overlap for the design check; one through solid
+        material is, and the hidden originals are not reported as hidden parts"""
+        import DesignCheck
+
+        plate = self.doc.addObject("Part::Feature", "Plate")
+        plate.Shape = _plate((40, 40, 10), (0, 0, 30), [(20, 20, 6.6, None, None)])
+        block = self.doc.addObject("Part::Feature", "Block")
+        block.Shape = _plate((40, 40, 30), (0, 0, 0), [(20, 20, 5.0, 15, None)])
+        self.doc.recompute()
+        face = _cyl_face(plate.Shape, 6.6)
+        hole = PS.analyze_hole(face, PS.solids_of_document(self.doc))
+        links = PS.put_plan(self.doc, PS.plan_for_hole(hole))
+        self.doc.recompute()
+        issues = DesignCheck.run(self.doc, floating=False)
+        self.assertEqual([i for i in issues if i.rule in ("interference", "hidden_skipped")], [])
+        # Without its hole, the same screw overlaps
+        block.Shape = Part.makeBox(40, 40, 30)
+        self.doc.recompute()
+        issues = DesignCheck.run(self.doc, floating=False)
+        self.assertTrue(any(i.rule == "interference" and links[0].Name in i.objects for i in issues))
+
     def test_profile_two_points(self):
         a, b = App.Vector(10, 0, 5), App.Vector(10, 300, 5)
         link = PS.put_profile(self.doc, "20-6", a, b, face_normal=App.Vector(0, 0, 1))
