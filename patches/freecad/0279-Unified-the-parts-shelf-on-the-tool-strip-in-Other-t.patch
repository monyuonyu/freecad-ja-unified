diff --git a/src/Mod/Unified/DesignCheck.py b/src/Mod/Unified/DesignCheck.py
index 82241fb0a..1e18e2acc 100644
--- a/src/Mod/Unified/DesignCheck.py
+++ b/src/Mod/Unified/DesignCheck.py
@@ -248,6 +248,8 @@ def check_hidden(doc, issues, opt):
     for o in doc.Objects:
         if _visible(o):
             continue
+        if "ShelfKey" in o.PropertiesList:
+            continue  # the hidden originals of the parts shelf (their links are the parts)
         if o.isDerivedFrom("PartDesign::Body") or o.isDerivedFrom("App::Link") or (
                 o.isDerivedFrom("Part::Feature") and not _in_body(o) and not o.isDerivedFrom("Part::Part2DObject")
                 and not o.isDerivedFrom("Part::Datum")
@@ -374,6 +376,28 @@ def _fitted(a, b, clearance=0.5):
     return False
 
 
+def _thread_in_hole(oa, ob, volume):
+    """A screw of the parts shelf (PartsShelf.py) and a part with its tapped hole: they overlap by
+    at most the ring between the thread and the tap drill along the screw (the thread engagement)"""
+    import math
+
+    try:
+        import PartsShelf
+    except ImportError:
+        return False
+    for screw in (oa, ob):
+        info = PartsShelf.thread_engagement(screw) if screw is not None else None
+        if info is None:
+            continue
+        d, tap, length = info
+        if length <= 0:
+            length = 3 * d  # a nut: its height is less than this
+        ring = math.pi / 4 * (d * d - tap * tap) * length
+        if volume <= ring * 1.05 + 1e-3:
+            return True
+    return False
+
+
 def _pair_compute(a, b, need_touch, opt):
     """2 つの形の (重なりの体積, 重なりの中心, 接しているか)。重い（形によっては 1 組に数秒）"""
     try:
@@ -556,6 +580,9 @@ def iter_interference(doc, issues, opt, shapes):
         v, center, t = _pair(a, b, pair_touch, opt)
         if pair_touch and not t and _fitted(a, b):
             t = True  # a pin in a hole with a clearance fit is held by it, not floating
+        if v > opt["interference_mm3"] and _thread_in_hole(doc.getObject(na), doc.getObject(nb), v):
+            v = 0.0  # a screw of the parts shelf in its tapped hole: the thread overlaps, as it should
+            t = True
         if v > opt["interference_mm3"]:
             issues.append(Issue(ERROR, "interference",
                                 translate("DesignCheck", "{0} and {1} overlap by {2:.1f} mm³").format(
