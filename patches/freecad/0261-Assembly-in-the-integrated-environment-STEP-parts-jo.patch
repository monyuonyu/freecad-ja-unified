+// Something is edited (a sketch, a feature): the bar stays away. An active assembly is "edited"
+// too, but that is where its parts are put together: the bar is wanted there.
+bool editingSomething()
+{
+    Gui::Document* doc = Gui::Application::Instance->editDocument();
+    if (!doc) {
+        return false;
+    }
+    auto* vp = dynamic_cast<Gui::ViewProviderDocumentObject*>(doc->getInEdit());
+    App::DocumentObject* obj = vp ? vp->getObject() : nullptr;
+    return !(obj && isDerivedFrom(obj, "Assembly::AssemblyObject"));
+}
