From: shota <monyuonyu@gmail.com>
Date: Mon, 9 Nov 2026 14:43:09 +0900
Subject: [PATCH 424/426] Update: ask GitHub again on a 5xx (its download
 server answered 504 for a while)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/Mod/Unified/Update.py | 19 +++++++++++++++----
 1 file changed, 15 insertions(+), 4 deletions(-)

diff --git a/src/Mod/Unified/Update.py b/src/Mod/Unified/Update.py
index 8fa0f09d7..4b516c7df 100644
--- a/src/Mod/Unified/Update.py
+++ b/src/Mod/Unified/Update.py
@@ -40,10 +40,21 @@ def version_of(tag):
     return tuple(int(x) for x in m.groups()) if m else None
 
 
-def _get(url, timeout=30):
-    req = urllib.request.Request(url, headers={"User-Agent": AGENT, "Accept": "application/vnd.github+json"})
-    with urllib.request.urlopen(req, timeout=timeout) as r:
-        return r.read()
+def _get(url, timeout=30, tries=4):
+    """The body; a 5xx from GitHub (its download server answers 504 now and then) is asked again
+    after 2, 4, 8 s"""
+    import time
+    import urllib.error
+
+    for k in range(tries):
+        req = urllib.request.Request(url, headers={"User-Agent": AGENT, "Accept": "application/vnd.github+json"})
+        try:
+            with urllib.request.urlopen(req, timeout=timeout) as r:
+                return r.read()
+        except urllib.error.HTTPError as e:
+            if e.code < 500 or k == tries - 1:
+                raise
+            time.sleep(2 ** (k + 1))
 
 
 def latest():
