+def free_parts(assembly, turn=5.0, shift=1.0):
+    """The parts of the assembly that its joints leave free to move (a cylinder joined to its
+    piston only by a cylindrical joint, not fixed to the ground: it may turn about the piston, and
+    a solve then took another pose without a word; engine field test 0.7.6).
+    Each part is nudged, one way at a time (turned a little about x, y, z, shifted along them),
+    and the assembly solved again: a part the joints hold comes back (or cannot be solved
+    there), a free one stays moved. The parts are put back. [(part, how far)]."""
+    parts = [o for o in assembly.Group if hasattr(o, "Placement") and hasattr(o, "Shape")
+             and not o.isDerivedFrom("Assembly::JointGroup")]  # fmt: skip
+    grounded = set()
+    for o in assembly.OutListRecursive:
+        target = getattr(o, "ObjectToGround", None)
+        if target is not None:
+            grounded.add(target.Name)
+    if assembly.solve() != 0:
+        return []
+    start = {p.Name: App.Placement(p.Placement) for p in parts}
+    axes = (App.Vector(1, 0, 0), App.Vector(0, 1, 0), App.Vector(0, 0, 1))
+    nudges = [App.Rotation(a, turn) for a in axes] + [a * shift for a in axes]
+    free = []
+    for part in parts:
+        if part.Name in grounded:
+            continue
+        try:
+            centre = part.Shape.BoundBox.Center
+            size = max(1.0, part.Shape.BoundBox.DiagonalLength)
+        except Exception:
+            continue
+        moved = 0.0
+        for n in nudges:
+            if isinstance(n, App.Rotation):
+                nudge = App.Placement(App.Vector(), n, centre)
+            else:
+                nudge = App.Placement(n, App.Rotation())
+            part.Placement = nudge.multiply(start[part.Name])
+            if assembly.solve() == 0:
+                now, was = part.Placement, start[part.Name]
+                # how far it stayed: shift against its size, turn in radians
+                moved = max((now.Base - was.Base).Length / size, (was.Rotation.inverted() * now.Rotation).Angle)
+            for p in parts:
+                if not p.Placement.isSame(start[p.Name], 1e-12):
+                    p.Placement = start[p.Name]
+            assembly.solve()
+            if moved > 1e-3:
+                break
+        if moved > 1e-3:
+            free.append((part, moved))
+    return free
