diff --git a/src/Mod/Unified/TestAssemblySolve.py b/src/Mod/Unified/TestAssemblySolve.py
index c0eadb1a1..6f5f53887 100644
--- a/src/Mod/Unified/TestAssemblySolve.py
+++ b/src/Mod/Unified/TestAssemblySolve.py
@@ -161,6 +161,67 @@ class AssemblySolveTest(unittest.TestCase):
         finally:
             App.closeDocument(doc.Name)
 
+    def test_a_belt_keeps_its_timing(self):
+        # 14/28 teeth: the second wheel turns half as far over a whole turn of the first, and a
+        # nudge of it does not change its timing (engine field test 0.7.6: half a turn off)
+        import AssemblyCopies
+        import JointObject
+
+        V, P = App.Vector, App.Placement
+        doc = App.newDocument("timing")
+        try:
+            asm = doc.addObject("Assembly::AssemblyObject", "Assembly")
+            asm.Type = "Assembly"
+            jg = asm.newObject("Assembly::JointGroup", "Joints")
+            base = asm.newObject("Part::Box", "Base")
+            w1 = asm.newObject("Part::Cylinder", "W1")
+            w2 = asm.newObject("Part::Cylinder", "W2")
+            w2.Placement = P(V(100, 0, 0), App.Rotation())
+            doc.recompute()
+            JointObject.GroundedJoint(jg.newObject("App::FeaturePython", "Ground"), base)
+            def joint(kind, name, a, pa, b, pb):
+                j = jg.newObject("App::FeaturePython", name)
+                JointObject.Joint(j, JointObject.JointTypes.index(kind))
+                j.Detach1 = True; j.Detach2 = True
+                j.Reference1 = (a, ["", ""]); j.Reference2 = (b, ["", ""])
+                j.Placement1 = pa; j.Placement2 = pb
+                return j
+            drive = joint("Revolute", "Drive", base, P(), w1, P())
+            drive.AngleDriven = True
+            joint("Revolute", "Axle2", base, P(V(100, 0, 0), App.Rotation()), w2, P())
+            belt = joint("Belt", "Chain", w1, P(), w2, P())
+            belt.Distance = 12; belt.Distance2 = 24; belt.Teeth1 = 14; belt.Teeth2 = 28
+            doc.recompute()
+            self.assertEqual(asm.solve(), 0)
+            def turned(o):
+                r = o.Placement.Rotation
+                return math.degrees(r.Angle) * (1 if r.Axis.z >= 0 else -1) % 360
+            for t in range(0, 360, 30):
+                drive.Angle = t
+                doc.recompute()
+                self.assertEqual(asm.solve(), 0)
+                self.assertAlmostEqual(turned(w2), t / 2.0, places=4, msg="crank {}".format(t))
+            w2.Placement = P(w2.Placement.Base, App.Rotation(V(0, 0, 1), 20).multiply(w2.Placement.Rotation))
+            self.assertEqual(asm.solve(), 0)
+            self.assertAlmostEqual(turned(w2), 330 / 2.0, places=4)
+            self.assertEqual(AssemblyCopies.free_parts(asm), [])
+        finally:
+            App.closeDocument(doc.Name)
+
+    def test_free_parts(self):
+        # a part with no joint is free; the parts of a driven crank are not
+        import AssemblyCopies
+
+        doc, sheet, asm, piston, r, L = build(revolute_drive=True)
+        try:
+            asm.Type = "Assembly"
+            self.assertEqual(AssemblyCopies.free_parts(asm), [])
+            loose = asm.newObject("Part::Box", "Loose")
+            doc.recompute()
+            self.assertEqual([p.Name for p, m in AssemblyCopies.free_parts(asm)], ["Loose"])
+        finally:
+            App.closeDocument(doc.Name)
+
     def test_parts_put_beside_each_other(self):
