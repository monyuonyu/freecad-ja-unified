From 907baec8cec739c269e249460cb89fa2133fd031 Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Sat, 24 Oct 2026 15:14:09 +0900
Subject: [PATCH 328/397] Unified: a click into a number field takes the whole
 number

The count of a pattern needed three clicks to be typed over (engine field
test 0.7.3). A click that brings the focus to a number field selects the
whole number when the click ends (the press places the cursor).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/Mod/Unified/UnifiedChrome.py | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/src/Mod/Unified/UnifiedChrome.py b/src/Mod/Unified/UnifiedChrome.py
index f856c07a3..ffcfce407 100644
--- a/src/Mod/Unified/UnifiedChrome.py
+++ b/src/Mod/Unified/UnifiedChrome.py
@@ -655,6 +655,22 @@ class KeyFilter(QtCore.QObject):
             for f in EXTRA_FILTERS:
                 if f.eventFilter(obj, event):
                     return True
+        if t in (QtCore.QEvent.FocusIn, QtCore.QEvent.MouseButtonRelease):
+            # A click that brings the focus to a number takes the whole number, ready to be
+            # typed over (the count of a pattern needed three clicks; engine field test 0.7.3).
+            # Selected when the click ends: the press itself places the cursor.
+            spin = obj if isinstance(obj, QtWidgets.QAbstractSpinBox) else None
+            if spin is None and isinstance(obj, QtWidgets.QLineEdit) \
+                    and isinstance(obj.parent(), QtWidgets.QAbstractSpinBox):
+                spin = obj.parent()
+            if spin is not None:
+                if t == QtCore.QEvent.FocusIn:
+                    if event.reason() in (QtCore.Qt.MouseFocusReason, QtCore.Qt.ActiveWindowFocusReason):
+                        spin.setProperty("unifiedSelectOnRelease", True)
+                elif spin.property("unifiedSelectOnRelease"):
+                    spin.setProperty("unifiedSelectOnRelease", False)
+                    QtCore.QTimer.singleShot(0, spin.selectAll)
+                return False
         if t == QtCore.QEvent.ShortcutOverride and isinstance(obj, QtWidgets.QWidget) and _digit_while_sketching(event):
             # While a sketch is drawn the digits are numbers (a size being typed), never the
             # standard views "1"…"6" (engine field test 0.6.9: typing 1 or 3 turned the view)
