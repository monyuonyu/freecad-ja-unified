 // TODO: This code is identical with TaskTransformedParameters::removeItemFromListWidget()
 void TaskDressUpParameters::removeItemFromListWidget(QListWidget* widget, const char* itemstr)
 {
-    QList<QListWidgetItem*> items = widget->findItems(QString::fromLatin1(itemstr), Qt::MatchExactly);
-    if (!items.empty()) {
-        for (auto item : items) {
-            QListWidgetItem* it = widget->takeItem(widget->row(item));
-            delete it;
+    for (int row = widget->count() - 1; row >= 0; --row) {
+        if (referenceName(widget->item(row)) == itemstr) {
+            delete widget->takeItem(row);
         }
     }
 }
 
+QListWidgetItem* TaskDressUpParameters::referenceItem(const std::string& subName)
+{
+    auto digits = subName.find_first_of("0123456789");
+    std::string kind = subName.substr(0, digits);
+    QString number = digits == std::string::npos ? QString()
+                                                 : QString::fromStdString(subName.substr(digits));
+    QString text;
+    if (kind == "Face") {
+        text = tr("Face %1").arg(number);
+    }
+    else if (kind == "Edge") {
+        text = tr("Edge %1").arg(number);
+    }
+    else if (kind == "Vertex") {
+        text = tr("Vertex %1").arg(number);
+    }
+    else {
+        text = QString::fromStdString(subName);
+    }
+    auto* item = new QListWidgetItem(text);
+    item->setData(Qt::UserRole, QString::fromStdString(subName));
+    return item;
+}
+
+std::string TaskDressUpParameters::referenceName(const QListWidgetItem* item)
+{
+    QVariant name = item->data(Qt::UserRole);
+    return (name.isValid() ? name.toString() : item->text()).toStdString();
+}
