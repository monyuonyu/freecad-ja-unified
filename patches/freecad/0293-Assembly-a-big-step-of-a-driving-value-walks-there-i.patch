+# SPDX-License-Identifier: LGPL-2.1-or-later
+# An assembly driven by a big step (a crank from 0 to 90 degrees at once) follows, headless:
+#   FreeCADCmd -t TestAssemblySolve
+# (engine field test 0.6.9: the solver dropped the driving joint as redundant and returned 0
+# while the parts stayed)
+
+import math
+import unittest
+
+import FreeCAD as App
+
+
+def build():
+    import JointObject
+
+    V, R, P = App.Vector, App.Rotation, App.Placement
+    V, R, P = App.Vector, App.Rotation, App.Placement
+    doc = App.newDocument("bigstep")
+    sheet = doc.addObject("Spreadsheet::Sheet", "Params"); sheet.set("A1", "0"); sheet.setAlias("A1", "theta")
+    asm = doc.addObject("Assembly::AssemblyObject", "Assembly")
+    jg = asm.newObject("Assembly::JointGroup", "Joints")
+    def box(name, pl):
+        b = asm.newObject("Part::Box", name); b.Length = b.Width = b.Height = 5; b.Placement = pl; return b
+    base = box("Base", P())
+    crank = box("Crank", P())
+    L, r = 100.0, 30.0
+    h = math.sqrt(L*L - r*r)
+    rod = box("Rod", P(V(r, 0, 0), R(V(0, 1, 0), math.degrees(math.atan2(-r, h)))))
+    piston = box("Piston", P(V(0, 0, h), R()))
+    g = jg.newObject("App::FeaturePython", "Ground"); JointObject.GroundedJoint(g, base)
+    RY = R(V(1, 0, 0), -90)
+    def joint(kind, name, a, pa, b, pb, expr1=None):
+        j = jg.newObject("App::FeaturePython", name)
+        JointObject.Joint(j, JointObject.JointTypes.index(kind))
+        j.Detach1 = True; j.Detach2 = True
+        j.Reference1 = (a, ["", ""]); j.Reference2 = (b, ["", ""])
+        j.Placement1 = pa; j.Placement2 = pb
+        if expr1: j.setExpression("Placement1", expr1)
+        return j
+    joint("Fixed", "Drive", base, P(), crank, P(), "placement(vector(0; 0; 0); rotation(vector(0; 1; 0); Params.theta))")
+    joint("Revolute", "CrankRod", crank, P(V(r, 0, 0), RY), rod, P(V(0, 0, 0), RY))
+    joint("Revolute", "RodPiston", rod, P(V(0, 0, L), RY), piston, P(V(0, 0, 0), RY))
+    joint("Slider", "PistonSlide", base, P(), piston, P())
+
+    doc.recompute()
+    return doc, sheet, asm, piston, r, L
+
+
+class AssemblySolveTest(unittest.TestCase):
+    def test_big_steps_of_the_crank(self):
+        doc, sheet, asm, piston, r, L = build()
+        try:
+            self.assertEqual(asm.solve(), 0)
+            for th in (90, 180, 270, 15, 0):
+                sheet.set("theta", str(th))
+                doc.recompute()
+                self.assertEqual(asm.solve(), 0)
+                t = math.radians(th)
+                want = -r * math.sin(t) + math.sqrt(L * L - (r * math.cos(t)) ** 2)
+                self.assertAlmostEqual(piston.Placement.Base.z, want, places=3, msg="theta {}".format(th))
+        finally:
+            App.closeDocument(doc.Name)
+
+
+if __name__ == "__main__":
+    unittest.main()
