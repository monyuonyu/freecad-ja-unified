     App::DocumentObject* obj2 = getObjFromJointRef(joint, "Reference2");
-    Base::Placement plc2 = getPlacementFromProp(joint, "Placement2");
+    Base::Placement plc2 = jointPlacement(joint, "Placement2");
 
     if (!part1 || !obj1) {
