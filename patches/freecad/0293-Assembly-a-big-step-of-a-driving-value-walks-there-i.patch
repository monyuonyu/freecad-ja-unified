--- a/src/Mod/Assembly/App/AssemblyObject.cpp
+++ b/src/Mod/Assembly/App/AssemblyObject.cpp
@@ -24,6 +24,7 @@
 #include <boost/core/ignore_unused.hpp>
 #include <algorithm>
 #include <cmath>
+#include <cstring>
 #include <algorithm>
 #include <vector>
 #include <unordered_map>
@@ -315,6 +316,81 @@ int AssemblyObject::solve(bool enableRedo)
     // updateSolveStatus() solves on demand; suppress that while a solve is running.
     Base::StateLocker lock(solveInProgress);
 
+    std::vector<App::DocumentObject*> joints;
+    int rc = solveOnce(enableRedo, joints);
+    if (rc != 0 || jointsHold(joints)) {
+        if (rc == 0) {
+            rememberHeldJoints(joints);
+        }
+        return rc;
+    }
+
+    // Not held: walk from the joints' placements of the last solve that held to the asked
+    // ones in steps of at most 15 degrees, each solve starting from the last one's result
+    double angle = 0.0;
+    double distance = 0.0;
+    bool known = false;
+    for (auto* joint : joints) {
+        auto it = lastHeldJointPlacements.find(joint->getNameInDocument());
+        if (it == lastHeldJointPlacements.end()) {
+            continue;
+        }
+        known = true;
+        const Base::Placement now1 = App::GeoFeature::getPlacementFromProp(joint, "Placement1");
+        const Base::Placement now2 = App::GeoFeature::getPlacementFromProp(joint, "Placement2");
+        for (const auto& [was, now] : {std::pair {it->second.first, now1}, std::pair {it->second.second, now2}}) {
+            Base::Rotation delta = was.getRotation().inverse() * now.getRotation();
+            Base::Vector3d axis;
+            double a = 0.0;
+            delta.getValue(axis, a);
+            angle = std::max(angle, std::fabs(a));
+            distance = std::max(distance, (now.getPosition() - was.getPosition()).Length());
+        }
+    }
+    if (!known) {
+        FC_WARN("Assembly " << getFullName() << ": the joints do not hold after solving");
+        return -7;
+    }
+    const int steps = std::clamp(
+        static_cast<int>(std::ceil(angle / (M_PI / 12.0))),
+        2,
+        48
+    );
+    for (int k = 1; k <= steps; ++k) {
+        const double t = static_cast<double>(k) / steps;
+        jointPlacementOverride.clear();
+        if (k < steps) {
+            for (auto* joint : joints) {
+                auto it = lastHeldJointPlacements.find(joint->getNameInDocument());
+                if (it == lastHeldJointPlacements.end()) {
+                    continue;
+                }
+                auto blend = [t](const Base::Placement& a, const Base::Placement& b) {
+                    return Base::Placement::slerp(a, b, t);
+                };
+                jointPlacementOverride[joint] = {
+                    blend(it->second.first, App::GeoFeature::getPlacementFromProp(joint, "Placement1")),
+                    blend(it->second.second, App::GeoFeature::getPlacementFromProp(joint, "Placement2")),
+                };
+            }
+        }
+        std::vector<App::DocumentObject*> stepJoints;
+        rc = solveOnce(false, stepJoints);
+        if (rc != 0) {
+            break;
+        }
+    }
+    jointPlacementOverride.clear();
+    if (rc == 0 && jointsHold(joints)) {
+        rememberHeldJoints(joints);
+        return 0;
+    }
+    FC_WARN("Assembly " << getFullName() << ": the joints do not hold after solving");
+    return rc != 0 ? rc : -7;
+}
+
+int AssemblyObject::solveOnce(bool enableRedo, std::vector<App::DocumentObject*>& joints)
+{
     ensureIdentityPlacements();
 
     syncGroundedJoints();
@@ -331,7 +407,7 @@ int AssemblyObject::solve(bool enableRedo)
         return -6;
     }
 
-    std::vector<App::DocumentObject*> joints = getJoints();
+    joints = getJoints();
 
     removeUnconnectedJoints(joints, groundedObjs);
 
@@ -368,6 +444,56 @@ int AssemblyObject::solve(bool enableRedo)
     return 0;
 }
 
+Base::Placement AssemblyObject::jointPlacement(App::DocumentObject* joint, const char* plcName) const
+{
+    auto it = jointPlacementOverride.find(joint);
+    if (it != jointPlacementOverride.end()) {
+        return std::strcmp(plcName, "Placement2") == 0 ? it->second.second : it->second.first;
+    }
+    return App::GeoFeature::getPlacementFromProp(joint, plcName);
+}
+
+bool AssemblyObject::jointsHold(const std::vector<App::DocumentObject*>& joints) const
+{
+    // The joints that pin both sides together: their two placements meet (and for a fixed
+    // joint, turn the same way)
+    for (auto* joint : joints) {
+        auto* type = joint->getPropertyByName<App::PropertyEnumeration>("JointType");
+        if (!type || !type->getValueAsString()) {
+            continue;
+        }
+        const std::string kind = type->getValueAsString();
+        if (kind != "Fixed" && kind != "Revolute" && kind != "Ball") {
+            continue;
+        }
+        if (joint->getPropertyByName<App::PropertyBool>("Suppressed")
+            && joint->getPropertyByName<App::PropertyBool>("Suppressed")->getValue()) {
+            continue;
+        }
+        const Base::Placement a = getJointSideGlobalPlacement(joint, "Reference1", "Placement1");
+        const Base::Placement b = getJointSideGlobalPlacement(joint, "Reference2", "Placement2");
+        const double scale = std::max(1.0, std::max(a.getPosition().Length(), b.getPosition().Length()));
+        if ((a.getPosition() - b.getPosition()).Length() > 1e-6 * scale) {
+            return false;
+        }
+        if (kind == "Fixed" && !a.getRotation().isSame(b.getRotation(), 1e-6)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+void AssemblyObject::rememberHeldJoints(const std::vector<App::DocumentObject*>& joints)
+{
+    lastHeldJointPlacements.clear();
+    for (auto* joint : joints) {
+        lastHeldJointPlacements[joint->getNameInDocument()] = {
+            App::GeoFeature::getPlacementFromProp(joint, "Placement1"),
+            App::GeoFeature::getPlacementFromProp(joint, "Placement2"),
+        };
+    }
+}
+
 void AssemblyObject::updateSolveStatus()
 {
     lastRedundantJoints.clear();
