--- /dev/null
+++ b/src/Mod/Unified/ExpressionRelink.py
@@ -0,0 +1,61 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""Formulas that named an object which was deleted and made again (the same name) follow it
+again. FreeCAD keeps the formula's text, but its link to the new object is not made: the
+formula is computed once and then no more (a crank made again as "Revolute": the valves and
+rockers stood still, silently; engine field test 0.8.1). Before a recompute of a file where
+objects were made, a formula naming an object that is there but not linked is set again."""
+
+import re
+
+import FreeCAD as App
+
+_NAME = re.compile(r"(?<![\w.<])([A-Za-z_][A-Za-z0-9_]*)\s*\.")
+
+
+class _Relink:
+    def __init__(self):
+        self.pending = set()
+
+    def slotCreatedObject(self, obj):
+        doc = getattr(obj, "Document", None)
+        if doc is not None:
+            self.pending.add(doc.Name)
+
+    def slotBeforeRecomputeDocument(self, doc):
+        if doc.Name not in self.pending:
+            return
+        self.pending.discard(doc.Name)
+        relink(doc)
+
+
+def relink(doc):
+    """Set again each formula of doc that names an object of doc it is not linked to. Returns
+    the number of formulas set again."""
+    count = 0
+    for obj in doc.Objects:
+        engine = getattr(obj, "ExpressionEngine", None)
+        if not engine:
+            continue
+        linked = {o.Name for o in obj.OutList}
+        for path, expr in list(engine):
+            names = set(_NAME.findall(expr))
+            missing = [n for n in names if n not in linked and n != obj.Name and doc.getObject(n) is not None]
+            if not missing:
+                continue
+            try:
+                obj.setExpression(path, None)
+                obj.setExpression(path, expr)
+                count += 1
+            except Exception as e:
+                App.Console.PrintLog("Formula of %s.%s not linked again: %s\n" % (obj.Name, path, e))
+    return count
+
+
+_observer = None
+
+
+def install():
+    global _observer
+    if _observer is None:
+        _observer = _Relink()
+        App.addDocumentObserver(_observer)
diff --git a/src/Mod/Unified/Init.py b/src/Mod/Unified/Init.py
index a6083ca17..bac36d6de 100644
--- a/src/Mod/Unified/Init.py
