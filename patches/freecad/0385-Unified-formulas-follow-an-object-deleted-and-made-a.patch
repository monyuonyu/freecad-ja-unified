+def _install_expression_relink():
+    # formulas follow an object made again under the same name (engine field test 0.8.1)
+    try:
+        import ExpressionRelink
+
+        ExpressionRelink.install()
+    except Exception:
+        pass
+
+
+_install_expression_relink()
diff --git a/src/Mod/Unified/TestUnifiedFiles.py b/src/Mod/Unified/TestUnifiedFiles.py
index 26b55810f..b2d227b00 100644
--- a/src/Mod/Unified/TestUnifiedFiles.py
+++ b/src/Mod/Unified/TestUnifiedFiles.py
@@ -155,5 +155,32 @@ class TestDwgText(unittest.TestCase):
                 App.closeDocument(back.Name)
             shutil.rmtree(tmp)
 
+
+class FormulaRelinkTest(unittest.TestCase):
+    def test_a_formula_follows_an_object_made_again(self):
+        # a joint used by formulas deleted and made again (the same name): the formulas were
+        # computed once and then stood still (engine field test 0.8.1)
+        doc = App.newDocument("relink")
+        try:
+            def drive(value):
+                o = doc.addObject("App::FeaturePython", "Drive")
+                o.addProperty("App::PropertyAngle", "Angle")
+                o.Angle = value
+                return o
+            drive(10)
+            user = doc.addObject("App::FeaturePython", "User")
+            user.addProperty("App::PropertyAngle", "Angle")
+            user.setExpression("Angle", "Drive.Angle * 2")
+            doc.recompute()
+            doc.removeObject("Drive")
+            doc.recompute()
+            again = drive(30)
+            doc.recompute()
+            again.Angle = 40
+            doc.recompute()
+            self.assertAlmostEqual(user.Angle.Value, 80)
+        finally:
+            App.closeDocument(doc.Name)
+
 if __name__ == "__main__":
     unittest.main()
