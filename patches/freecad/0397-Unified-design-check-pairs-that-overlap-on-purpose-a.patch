+PAIRS_PROP = "DesignCheckOverlapOK"
+
+
+def load_pairs(path):
+    """The pairs allowed to overlap, from a text file: one pair a line, "A, B" (or a tab between
+    them); labels or names, * and ? match any characters; # begins a comment.
+    Returns [(pattern a, pattern b)]"""
+    pairs = []
+    with open(path, encoding="utf-8-sig") as f:
+        for n, line in enumerate(f, 1):
+            line = line.split("#", 1)[0].strip()
+            if not line:
+                continue
+            cut = line.split("\t") if "\t" in line else line.split(",")
+            cut = [c.strip() for c in cut if c.strip()]
+            if len(cut) != 2:
+                raise ValueError("%s line %d: two parts are needed, \"A, B\": %r" % (path, n, line))
+            pairs.append(tuple(cut))
+    return pairs
+
+
+def allow_overlap(a, b, on=True):
+    """Say that the parts a and b overlap on purpose (kept in the file): the pair is not checked"""
+    for x, y in ((a, b), (b, a)):
+        if PAIRS_PROP not in x.PropertiesList:
+            x.addProperty("App::PropertyStringList", PAIRS_PROP, "DesignCheck",
+                          QT_TRANSLATE_NOOP("App::Property", "Parts that may overlap this one on purpose "
+                                            "(names): the pair is not checked"))  # fmt: skip
+        names = [n for n in getattr(x, PAIRS_PROP) if n != y.Name]
+        setattr(x, PAIRS_PROP, names + [y.Name] if on else names)
+
+
+def _pair_rule(doc, patterns=None):
+    """A test (name a, name b) -> True for a pair allowed to overlap: by the parts' own list
+    (allow_overlap) or by `patterns` [(a, b)] matched to the labels or names of the parts or of
+    the groups and parts they are in"""
+    import fnmatch
+
+    patterns = list(patterns or [])
+    memo = {}
+
+    def names(n):
+        if n not in memo:
+            o = doc.getObject(n)
+            got = {o.Name, o.Label} if o is not None else {n}
+            for up in (o.InListRecursive if o is not None else []):
+                if up.isDerivedFrom("App::Part") or up.isDerivedFrom("App::DocumentObjectGroup") \
+                        or up.isDerivedFrom("PartDesign::Body"):
+                    got |= {up.Name, up.Label}
+            memo[n] = got
+        return memo[n]
+
+    def matches(n, pattern):
+        return any(fnmatch.fnmatchcase(x, pattern) for x in names(n))
+
+    def allowed(na, nb):
+        for x, y in ((na, nb), (nb, na)):
+            o = doc.getObject(x)
+            if o is not None and y in (getattr(o, PAIRS_PROP, None) or []):
+                return True
+        return any((matches(na, p) and matches(nb, q)) or (matches(na, q) and matches(nb, p)) for p, q in patterns)
+
+    return allowed
+
+
+def sweep(doc=None, moving=(), axis=((0, 0, 0), (0, 0, 1)), start=0.0, end=90.0, step=5.0, **options):
+    """Turn the parts `moving` (labels or names, * and ?; a group or App::Part takes its parts)
+    about `axis` ((point), (direction)) from `start` to `end` degrees by `step`, and check at each
+    angle whether they overlap the other parts (a bar turning 0-80 deg; asked from a gate's
+    project). ignore_pairs=[(a, b)] as in interferences. Returns {"angles": [...], "moving":
+    [labels], "hits": [{"angle", "a", "b", "volume", "center"}], "first": angle or None}"""
+    import fnmatch
+
+    doc = doc or App.ActiveDocument
+    opt = dict(DEFAULTS, floating=False, **options)
+    if not moving:
+        raise ValueError("sweep: name the parts that move")
+    shapes = {n: sh for n, sh in parts(doc).items() if sh.Solids}
+
+    def names(n):
+        o = doc.getObject(n)
+        return {o.Name, o.Label} | {u.Label for u in o.InListRecursive} | {u.Name for u in o.InListRecursive}
+
+    movers = sorted(n for n in shapes if any(fnmatch.fnmatchcase(x, p) for p in moving for x in names(n)))
+    if not movers:
+        raise ValueError("sweep: no visible solid part matches %s" % ", ".join(moving))
+    point, direction = App.Vector(*axis[0]), App.Vector(*axis[1])
+    if direction.Length < 1e-12:
+        raise ValueError("sweep: the axis has no direction")
+    if step <= 0:
+        raise ValueError("sweep: the step must be more than 0")
+    angles = []
+    a = float(start)
+    while (a < end - 1e-9) if end >= start else (a > end + 1e-9):
+        angles.append(round(a, 9))
+        a += step if end >= start else -step
+    angles.append(float(end))
+    allowed = _pair_rule(doc, opt.get("ignore_pairs"))
+    one = {n: one_items(doc.getObject(n)) for n in shapes}
+    fixed = [n for n in shapes if n not in movers]
+    wanted = {(m, f) for m in movers for f in fixed if not (one[m] & one[f]) and not allowed(m, f)}
+    hits = []
+    for angle in angles:
+        turn = App.Placement(App.Vector(), App.Rotation(direction, angle), point)
+        now = dict(shapes)
+        for m in movers:
+            moved = shapes[m].copy()
+            moved.Placement = turn.multiply(shapes[m].Placement)
+            now[m] = moved
+        near = {(m, f) for m, f in wanted if now[m].BoundBox.intersect(now[f].BoundBox)}
+        if not near:
+            continue
+        got = _measure_overlaps(list(now.items()), near, opt)
+        for (m, f), res in sorted(got.items()):
+            if res is None:
+                res = _common_volume(now[m], now[f])
+            volume, center = res
+            if volume is None or volume > opt["interference_mm3"]:
+                hits.append({"angle": angle, "a": doc.getObject(m).Label, "b": doc.getObject(f).Label,
+                             "names": [m, f], "volume": volume,
+                             "center": list(center) if center is not None else None})  # fmt: skip
+    return {"angles": angles, "moving": [doc.getObject(m).Label for m in movers], "hits": hits,
+            "first": hits[0]["angle"] if hits else None}  # fmt: skip
+
+
 def interferences(doc=None, **options):
