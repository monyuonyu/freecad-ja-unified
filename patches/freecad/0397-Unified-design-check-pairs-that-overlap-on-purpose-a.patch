+class DesignCheckPairsTest(unittest.TestCase):
+    # a line through its eyebolt, a worker and a banner: overlaps on purpose, said every time
+    # (asked from a gate's project on 0.8.2)
+    def setUp(self):
+        DesignCheck._PAIR_CACHE.clear()
+        self.doc = App.newDocument("pairs")
+        self.line = box(self.doc, "Line", 0, 0, 0)
+        self.bolt = box(self.doc, "Bolt", 5, 5, 5)
+        self.wall = box(self.doc, "Wall", 8, 0, 0)
+        self.line.Label, self.bolt.Label = "テグス", "アイボルト"
+        self.doc.recompute()
+
+    def tearDown(self):
+        App.closeDocument(self.doc.Name)
+
+    def names(self, **options):
+        return sorted(tuple(sorted(f["names"])) for f in DesignCheck.interferences(self.doc, **options))
+
+    def test_pairs_by_pattern(self):
+        self.assertIn(("Bolt", "Line"), self.names())
+        got = self.names(ignore_pairs=[("アイボルト", "テグス*")])
+        self.assertNotIn(("Bolt", "Line"), got)
+        self.assertIn(("Bolt", "Wall"), got)  # the bolt against the others: still checked
+        self.assertIn(("Line", "Wall"), got)
+
+    def test_a_pair_kept_in_the_file(self):
+        DesignCheck.allow_overlap(self.line, self.bolt)
+        self.assertNotIn(("Bolt", "Line"), self.names())
+        self.assertIn(("Bolt", "Wall"), self.names())
+
+    def test_ignoring_an_overlap_ignores_that_pair_only(self):
+        issue = [i for i in DesignCheck.run(self.doc) if i.rule == "interference"
+                 and sorted(i.objects) == ["Bolt", "Line"]][0]  # fmt: skip
+        DesignCheck.ignore(self.doc, issue)
+        issues = DesignCheck.run(self.doc)
+        pairs = [sorted(i.objects) for i in issues if i.rule == "interference"]
+        self.assertNotIn(["Bolt", "Line"], pairs)
+        self.assertIn(["Bolt", "Wall"], pairs)
+        self.assertGreaterEqual(issues.ignored, 1)
+
+    def test_load_pairs(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            path = os.path.join(tmp, "pairs.txt")
+            with open(path, "w", encoding="utf-8") as f:
+                f.write("# on purpose\nテグス, アイボルト\nWorker*\tBanner  # the banner\n\n")
+            self.assertEqual(DesignCheck.load_pairs(path), [("テグス", "アイボルト"), ("Worker*", "Banner")])
+            with open(path, "w", encoding="utf-8") as f:
+                f.write("only one\n")
+            with self.assertRaises(ValueError):
+                DesignCheck.load_pairs(path)
+        finally:
+            shutil.rmtree(tmp)
+
+
