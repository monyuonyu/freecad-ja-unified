+#include <iostream>
 #include <ostream>
 #include <QString>
 
@@ -54,6 +55,24 @@ const auto sBanner = std::format(
     Base::FCVersionInfo::CopyrightYear()
 );
 
+// exit() skips Python's finalization, so text still buffered in sys.stdout/sys.stderr
+// (e.g. print() output right before an exception or sys.exit()) would be lost.
+static void flushPythonStreams()
+{
+    if (!Py_IsInitialized()) {
+        return;
+    }
+    Base::PyGILStateLocker lock;
+    for (const char* name : {"stdout", "stderr"}) {
+        PyObject* stream = PySys_GetObject(name);  // borrowed
+        if (stream && stream != Py_None) {
+            PyObject* result = PyObject_CallMethod(stream, "flush", nullptr);
+            Py_XDECREF(result);
+        }
+    }
+    PyErr_Clear();
+}
+
 int main(int argc, char** argv)
 {
     // Make sure that we use '.' as decimal point
@@ -142,13 +161,22 @@ int main(int argc, char** argv)
         Application::runApplication();
     }
     catch (const Base::SystemExitException& e) {
-        exit(e.getExitCode());
+        flushPythonStreams();
+        // sys.exit("message") prints the message to stderr, as Python does
+        const std::string prefix = "System exit: ";
+        const std::string msg = e.what();
+        if (msg.starts_with(prefix)) {
+            std::cerr << msg.substr(prefix.size()) << std::endl;
+        }
+        exit(static_cast<int>(e.getExitCode()));
     }
     catch (const Base::Exception& e) {
+        flushPythonStreams();
         e.reportException();
         exit(1);
     }
     catch (...) {
+        flushPythonStreams();
         Console().error("Application unexpectedly terminated\n");
         exit(1);
     }
