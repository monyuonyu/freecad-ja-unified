From ce340a35eeeb342c36434ac1d71542eb475ece20 Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Tue, 20 Oct 2026 19:03:23 +0900
Subject: [PATCH 270/320] Make Drawing: a picked face is the front; holes are
 dimensioned where they are circles

A face picked before "Make Drawing" is the one the front view looks at
(as the drawing tools do). The holes' center lines and size go on the view
that shows them as circles: the front view, else the view with the most of
them (a plate drawn from its edge shows its holes on the top view).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/Mod/Unified/DrawingAuto.py                   | 16 ++++++++++++----
 .../Resources/translations/UnifiedWording_ja.ts  |  4 ++++
 src/Mod/Unified/UnifiedChrome.py                 |  8 +++++++-
 3 files changed, 23 insertions(+), 5 deletions(-)

diff --git a/src/Mod/Unified/DrawingAuto.py b/src/Mod/Unified/DrawingAuto.py
index 28c198313..6caa598dd 100644
--- a/src/Mod/Unified/DrawingAuto.py
+++ b/src/Mod/Unified/DrawingAuto.py
@@ -203,16 +203,24 @@ def complete(page, group, name=None):
     doc.recompute()
     for v in views:
         wait_for_geometry(v)
+    # The holes where they are seen as circles: on the front view, else on the view that shows
+    # the most of them (a plate drawn from its edge shows its holes on the top view)
+    holes_view = front
     groups = hole_groups(front)
+    if not groups:
+        for v in views:
+            g = hole_groups(v)
+            if sum(len(c) for c in g.values()) > sum(len(c) for c in groups.values()):
+                holes_view, groups = v, g
     for diameter, circles in sorted(groups.items()):
-        added["center_lines"] += center_lines(front, circles)
+        added["center_lines"] += center_lines(holes_view, circles)
         n = len(circles)
         spec = ("{}×⌀%.0f".format(n) if n > 1 else "⌀%.0f") + (translate("DrawingAuto", " drill") if n > 1 else "")
         # On the hole at the top right, its text outside the part up and to the right
         index, edge = max(circles, key=lambda t: t[1].Curve.Location.x + t[1].Curve.Location.y)
-        d = add_dimension(page, front, "Diameter", ["Edge%d" % index], spec)
-        box = extent(front)
-        sc = front.getScale() if hasattr(front, "getScale") else 1.0
+        d = add_dimension(page, holes_view, "Diameter", ["Edge%d" % index], spec)
+        box = extent(holes_view)
+        sc = holes_view.getScale() if hasattr(holes_view, "getScale") else 1.0
         if box:
             d.X = box[2] * sc + 6
             d.Y = box[3] * sc + 8
diff --git a/src/Mod/Unified/Gui/Resources/translations/UnifiedWording_ja.ts b/src/Mod/Unified/Gui/Resources/translations/UnifiedWording_ja.ts
index 057644cb0..acee4730f 100644
--- a/src/Mod/Unified/Gui/Resources/translations/UnifiedWording_ja.ts
+++ b/src/Mod/Unified/Gui/Resources/translations/UnifiedWording_ja.ts
@@ -10154,6 +10154,10 @@ Note: Currently this selects only unconnected parts, not constrained parts that
         <source>A drawing sheet with the three views of the picked part (of all parts if none is picked)</source>
         <translation>選んだ部品（選んでいなければ全部）の三面図の図面を作ります</translation>
     </message>
+    <message>
+        <source>A drawing sheet with the three views of the picked part (of all parts if none is picked); a picked face is the front</source>
+        <translation>選んだ部品（選んでいなければ全部）の三面図の図面を作ります。面を選んでいれば、その面が正面</translation>
+    </message>
 </context>
 <context>
     <name>Unified_PlacePart</name>
diff --git a/src/Mod/Unified/UnifiedChrome.py b/src/Mod/Unified/UnifiedChrome.py
index 0708db864..beadffb26 100644
--- a/src/Mod/Unified/UnifiedChrome.py
+++ b/src/Mod/Unified/UnifiedChrome.py
@@ -101,7 +101,8 @@ class NewDrawingCommand:
             "MenuText": QT_TRANSLATE_NOOP("Unified_NewDrawing", "Make Drawing"),
             "ToolTip": QT_TRANSLATE_NOOP(
                 "Unified_NewDrawing",
-                "A drawing sheet with the three views of the picked part (of all parts if none is picked)",
+                "A drawing sheet with the three views of the picked part (of all parts if none is picked); "
+                "a picked face is the front",
             ),
         }
 
@@ -110,6 +111,9 @@ class NewDrawingCommand:
 
     def Activated(self):
         shapes = _shapes_to_draw()
+        # A picked flat face is the one the front view looks at
+        faces = [(s.Object, sub) for s in Gui.Selection.getSelectionEx()
+                 for sub in s.SubElementNames if sub.startswith("Face")][:1]
         if not shapes:
             Gui.getMainWindow().statusBar().showMessage(
                 translate("Unified", "Make a part first: there is nothing to draw yet"), 6000
@@ -125,6 +129,8 @@ class NewDrawingCommand:
         Gui.Selection.clearSelection()
         for s in shapes:
             Gui.Selection.addSelection(doc.Name, s.Name)
+        for obj, sub in faces:
+            Gui.Selection.addSelection(doc.Name, obj.Name, sub)
         Gui.Selection.addSelection(doc.Name, page.Name)
         groups_before = {o.Name for o in doc.Objects if o.isDerivedFrom("TechDraw::DrawProjGroup")}
         Gui.runCommand("TechDraw_ProjectionGroup")
