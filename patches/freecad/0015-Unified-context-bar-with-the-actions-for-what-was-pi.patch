diff --git a/src/Mod/Unified/Gui/ContextBar.cpp b/src/Mod/Unified/Gui/ContextBar.cpp
new file mode 100644
index 000000000..e7f2e17a5
--- /dev/null
+++ b/src/Mod/Unified/Gui/ContextBar.cpp
@@ -0,0 +1,251 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+#include <QApplication>
+#include <QCursor>
+#include <QEvent>
+#include <QHBoxLayout>
+#include <QMouseEvent>
+#include <QTimer>
+#include <QToolButton>
+
+#include <App/DocumentObject.h>
+#include <Base/Type.h>
+#include <Gui/Action.h>
+#include <Gui/Application.h>
+#include <Gui/BitmapFactory.h>
+#include <Gui/Command.h>
+#include <Gui/Control.h>
+#include <Gui/MainWindow.h>
+#include <Gui/View3DInventor.h>
+#include <Gui/View3DInventorViewer.h>
+
+#include "ContextBar.h"
+
+using namespace UnifiedGui;
+
+namespace
+{
+ContextBar* instance = nullptr;
+
+QString label(const char* text)
+{
+    return QApplication::translate("UnifiedGui::ContextBar", text);
+}
+
+bool isDerivedFrom(const App::DocumentObject* obj, const char* typeName)
+{
+    Base::Type type = Base::Type::fromName(typeName);
+    return !type.isBad() && obj->getTypeId().isDerivedFrom(type);
+}
+
+bool allStartWith(const std::vector<std::string>& names, const char* prefix)
+{
+    return !names.empty() && std::all_of(names.begin(), names.end(), [prefix](const std::string& n) {
+        return n.rfind(prefix, 0) == 0;
+    });
+}
+
+Gui::View3DInventor* active3DView()
+{
+    return dynamic_cast<Gui::View3DInventor*>(Gui::getMainWindow()->activeWindow());
+}
+}  // namespace
+
+void ContextBar::install()
+{
+    if (!instance) {
+        instance = new ContextBar();
+    }
+}
+
+ContextBar::ContextBar()
+    : QFrame(Gui::getMainWindow())
+    , Gui::SelectionObserver(true)
+{
+    setObjectName(QStringLiteral("UnifiedContextBar"));
+    setFrameShape(QFrame::StyledPanel);
+    setAutoFillBackground(true);
+    layout = new QHBoxLayout(this);
+    layout->setContentsMargins(3, 3, 3, 3);
+    layout->setSpacing(1);
+    hide();
+}
+
+ContextBar::~ContextBar()
+{
+    instance = nullptr;
+}
+
+void ContextBar::onSelectionChanged(const Gui::SelectionChanges& msg)
+{
+    switch (msg.Type) {
+        case Gui::SelectionChanges::AddSelection:
+        case Gui::SelectionChanges::RmvSelection:
+        case Gui::SelectionChanges::SetSelection:
+        case Gui::SelectionChanges::ClrSelection:
+            break;
+        default:
+            return;
+    }
+    // Several messages arrive for one click; look at the selection once they are through
+    if (!refreshPending) {
+        refreshPending = true;
+        QTimer::singleShot(0, this, [this]() {
+            refreshPending = false;
+            refresh();
+        });
+    }
+}
+
+std::vector<ContextBar::Action> ContextBar::actionsForSelection() const
+{
+    auto selection = Gui::Selection().getSelectionEx();
+    if (selection.empty()) {
+        return {};
+    }
+
+    // Several edges picked: round or chamfer them all at once
+    if (selection.size() > 1) {
+        bool edgesOnly = std::all_of(selection.begin(), selection.end(), [](const auto& s) {
+            return allStartWith(s.getSubNames(), "Edge");
+        });
+        if (edgesOnly) {
+            return {{"PartDesign_Fillet", label("Fillet")}, {"PartDesign_Chamfer", label("Chamfer")}};
+        }
+        return {};
+    }
+
+    const auto& sel = selection.front();
+    const App::DocumentObject* obj = sel.getObject();
+    const auto& subs = sel.getSubNames();
+    if (!obj) {
+        return {};
+    }
+    if (allStartWith(subs, "Face")) {
+        return {
+            {"PartDesign_NewSketch", label("Sketch")},
+            {"PartDesign_Pad", label("Extrude")},
+            {"PartDesign_Pocket", label("Cut in")},
+            {"PartDesign_Thickness", label("Shell")},
+        };
+    }
+    if (allStartWith(subs, "Edge")) {
+        return {{"PartDesign_Fillet", label("Fillet")}, {"PartDesign_Chamfer", label("Chamfer")}};
+    }
+    if (!subs.empty()) {
+        return {};
+    }
+    if (isDerivedFrom(obj, "Sketcher::SketchObject")) {
+        return {
+            {"PartDesign_Pad", label("Extrude")},
+            {"PartDesign_Pocket", label("Cut in")},
+            {"PartDesign_Revolution", label("Revolve")},
+            {"Sketcher_EditSketch", label("Edit")},
+        };
+    }
+    if (isDerivedFrom(obj, "Part::Feature") || isDerivedFrom(obj, "PartDesign::Body")) {
+        return {{"Std_TransformManip", label("Move")}, {"Std_ToggleVisibility", label("Hide")}};
+    }
+    return {};
+}
+
+void ContextBar::refresh()
+{
+    Gui::View3DInventor* view = active3DView();
+    // Only for picks in the 3D view, and not while a tool is running or something is edited
+    bool usable = view && !Gui::Control().activeDialog()
+        && !Gui::Application::Instance->editDocument()
+        && view->rect().contains(view->mapFromGlobal(QCursor::pos()));
+    std::vector<Action> actions = usable ? actionsForSelection() : std::vector<Action> {};
+    if (actions.empty()) {
+        dismiss();
+        return;
+    }
+    showActions(actions, view);
+}
+
+void ContextBar::showActions(const std::vector<Action>& actions, QWidget* view)
+{
+    // Rebuild the buttons
+    while (QLayoutItem* item = layout->takeAt(0)) {
+        delete item->widget();
+        delete item;
+    }
+    auto& manager = Gui::Application::Instance->commandManager();
+    int shown = 0;
+    for (const auto& action : actions) {
+        Gui::Command* cmd = manager.getCommandByName(action.command);
+        if (!cmd) {
+            continue;
+        }
+        if (Gui::Action* a = cmd->getAction(); a && !a->isEnabled()) {
+            continue;  // e.g. no solid yet to cut into
+        }
+        auto button = new QToolButton(this);
+        button->setAutoRaise(true);
+        button->setToolButtonStyle(Qt::ToolButtonTextUnderIcon);
+        button->setIconSize(QSize(24, 24));
+        button->setIcon(Gui::BitmapFactory().iconFromTheme(cmd->getPixmap()));
+        button->setText(action.label);
+        button->setToolTip(QString::fromUtf8(cmd->getToolTipText()));
+        const std::string name = action.command;
+        connect(button, &QToolButton::clicked, this, [this, name]() {
+            dismiss();
+            Gui::Application::Instance->commandManager().runCommandByName(name.c_str());
+        });
+        layout->addWidget(button);
+        ++shown;
+    }
+    if (shown == 0) {
+        dismiss();
+        return;
+    }
+
+    // Put the bar next to the cursor, inside the view. The bar stays a child of the main
+    // window (views come and go with their documents) and is only positioned over the view.
+    QWidget* main = parentWidget();
+    adjustSize();
+    QRect area(view->mapTo(main, QPoint(0, 0)), view->size());
+    QPoint pos = main->mapFromGlobal(QCursor::pos()) + QPoint(18, 18);
+    pos.setX(std::clamp(pos.x(), area.left(), std::max(area.left(), area.right() - width())));
+    pos.setY(std::clamp(pos.y(), area.top(), std::max(area.top(), area.bottom() - height())));
+    move(pos);
+    show();
+    raise();
+
+    // Leave the bar alone while the user works with the view: orbiting, panning or
+    // zooming hides it
+    auto* viewer = static_cast<Gui::View3DInventor*>(view)->getViewer();
+    QWidget* gl = viewer->getGLWidget();
+    if (watchedView != gl) {
+        if (watchedView) {
+            watchedView->removeEventFilter(this);
+        }
+        watchedView = gl;
+        gl->installEventFilter(this);
+    }
+}
+
+bool ContextBar::eventFilter(QObject* watched, QEvent* event)
+{
+    if (watched == watchedView && isVisible()) {
+        if (event->type() == QEvent::Wheel) {
+            dismiss();
+        }
+        else if (event->type() == QEvent::MouseButtonPress) {
+            auto* mouse = static_cast<QMouseEvent*>(event);
+            if (mouse->button() != Qt::LeftButton) {
+                dismiss();
+            }
+        }
+        else if (event->type() == QEvent::KeyPress) {
+            dismiss();
+        }
+    }
+    return QFrame::eventFilter(watched, event);
+}
+
+void ContextBar::dismiss()
+{
+    hide();
+}
