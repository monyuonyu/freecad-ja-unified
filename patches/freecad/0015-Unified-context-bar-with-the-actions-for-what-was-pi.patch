+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+#pragma once
+
+#include <QFrame>
+#include <QPointer>
+
+#include <Gui/Selection/Selection.h>
+
+class QHBoxLayout;
+
+namespace UnifiedGui
+{
+
+/**
+ * A small bar that appears next to the cursor when something is picked in the 3D view and
+ * offers what can be done with it right there: a face can be sketched on, extruded or cut
+ * in, an edge can be rounded, a sketch can be turned into a solid, ... The buttons run the
+ * ordinary commands, so their task panels and drag handles are used as usual.
+ */
+class ContextBar: public QFrame, public Gui::SelectionObserver
+{
+public:
+    /// Create the bar once; it lives as long as the main window
+    static void install();
+
+private:
+    ContextBar();
+    ~ContextBar() override;
+
+    struct Action
+    {
+        const char* command;
+        QString label;
+    };
+
+    void onSelectionChanged(const Gui::SelectionChanges& msg) override;
+    bool eventFilter(QObject* watched, QEvent* event) override;
+
+    void refresh();
+    std::vector<Action> actionsForSelection() const;
+    void showActions(const std::vector<Action>& actions, QWidget* view);
+    void dismiss();
+
+    QHBoxLayout* layout {nullptr};
+    QPointer<QWidget> watchedView;
+    bool refreshPending {false};
+};
+
+}  // namespace UnifiedGui
