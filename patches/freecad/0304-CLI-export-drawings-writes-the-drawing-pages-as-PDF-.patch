+# SPDX-License-Identifier: LGPL-2.1-or-later
+# PDF of the drawing pages without the screen (engine field test: a drawing PDF needed the GUI):
+#   FreeCADCmd -t TestDrawingPdf
+
+import os
+import shutil
+import tempfile
+import unittest
+
+import FreeCAD as App
+
+import DrawingPdf
+
+
+class OutputNamesTest(unittest.TestCase):
+    def test_names(self):
+        self.assertEqual(DrawingPdf.output_names("a/out.pdf", ["Page"]), ["a/out.pdf"])
+        self.assertEqual(DrawingPdf.output_names("out.pdf", ["部品図", "組立図"]), ["out_部品図.pdf", "out_組立図.pdf"])
+        self.assertEqual(DrawingPdf.output_names("out.pdf", ["A", "A"]), ["out_A.pdf", "out_A_.pdf"])
+        self.assertEqual(DrawingPdf.output_names("d/{page}.pdf", ["x y", "z/w"]), ["d/x_y.pdf", "d/z_w.pdf"])
+
+
+class ExportTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.mkdtemp()
+        doc = App.newDocument("drawpdf")
+        box = doc.addObject("Part::Box", "Box")
+        template = os.path.join(App.getResourceDir(), "Mod", "TechDraw", "Templates",
+                                "Default_Template_A4_Landscape.svg")  # fmt: skip
+        for label in ("部品図", "Second"):
+            page = doc.addObject("TechDraw::DrawPage", "Page")
+            page.Label = label
+            tpl = doc.addObject("TechDraw::DrawSVGTemplate", "Template")
+            tpl.Template = template
+            page.Template = tpl
+            view = doc.addObject("TechDraw::DrawViewPart", "View")
+            page.addView(view)
+            view.Source = [box]
+        doc.recompute()
+        self.path = os.path.join(self.tmp, "m.FCStd")
+        doc.saveAs(self.path)
+        App.closeDocument(doc.Name)
+
+    def tearDown(self):
+        shutil.rmtree(self.tmp)
+
+    def test_all_pages(self):
+        written = DrawingPdf.export(self.path, os.path.join(self.tmp, "out.pdf"))
+        self.assertEqual([os.path.basename(w) for w in written], ["out_部品図.pdf", "out_Second.pdf"])
+        for w in written:
+            with open(w, "rb") as f:
+                self.assertEqual(f.read(5), b"%PDF-")
+
+    def test_one_page_and_a_missing_one(self):
+        out = os.path.join(self.tmp, "one.pdf")
+        self.assertEqual(DrawingPdf.export(self.path, out, pages=["Second"]), [out])
+        with self.assertRaises(RuntimeError) as ctx:
+            DrawingPdf.export(self.path, out, pages=["Nothing"])
+        self.assertIn("No drawing page", str(ctx.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
