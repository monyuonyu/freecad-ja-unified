diff --git a/src/Mod/Unified/DrawingPdf.py b/src/Mod/Unified/DrawingPdf.py
new file mode 100644
index 000000000..e709f8f17
--- /dev/null
+++ b/src/Mod/Unified/DrawingPdf.py
@@ -0,0 +1,143 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""PDF of the drawing pages without the screen:
+
+    FreeCADCmd model.FCStd --export-drawings out.pdf
+    DrawingPdf.export("model.FCStd", "out.pdf")     # -> [written files]
+
+TechDraw draws its pages with the scene of the GUI, so a child FreeCADCmd starts the GUI
+offscreen (nothing is shown), waits for the views' lines, writes the PDFs and ends without
+tearing the GUI down (that crashed in FreeCADCmd). One page: out.pdf; more: out_<page>.pdf,
+or a name with {page} in it.
+"""
+
+import json
+import os
+import re
+import subprocess
+import sys
+import tempfile
+import time
+
+import FreeCAD as App
+
+JOB_ENV = "FREECAD_DRAWING_PDF_JOB"
+
+
+def output_names(out, labels):
+    """The file of each page: out for one page, out_<label>.pdf or out with {page} for more"""
+    def safe(label):
+        return re.sub(r'[\\/:*?"<>|\s]+', "_", label).strip("_") or "page"
+
+    if "{page}" in out:
+        return [out.replace("{page}", safe(label)) for label in labels]
+    if len(labels) == 1:
+        return [out]
+    stem, ext = os.path.splitext(out)
+    names, seen = [], set()
+    for label in labels:
+        name = stem + "_" + safe(label)
+        while name in seen:
+            name += "_"
+        seen.add(name)
+        names.append(name + (ext or ".pdf"))
+    return names
+
+
+def _freecadcmd():
+    home = App.getHomePath()
+    for d in (os.path.join(home, "bin"), os.path.dirname(sys.executable)):
+        for name in ("FreeCADCmd.exe", "FreeCADCmd", "freecadcmd"):
+            path = os.path.join(d, name)
+            if os.path.isfile(path):
+                return path
+    raise RuntimeError("FreeCADCmd was not found next to " + home)
+
+
+def export(path, out, pages=None, seconds=120):
+    """Write the drawing pages of the file `path` (all, or the names/labels in `pages`) as PDF.
+    Returns the files written; raises RuntimeError with the reason otherwise."""
+    if not isinstance(path, str):  # a document
+        if not path.FileName:
+            raise RuntimeError("Save the document first: the drawings are read from its file")
+        path = path.FileName
+    with tempfile.TemporaryDirectory() as tmp:
+        result = os.path.join(tmp, "result.json")
+        job = {"path": os.path.abspath(path), "out": os.path.abspath(out), "pages": pages,
+               "seconds": seconds, "result": result}  # fmt: skip
+        env = dict(os.environ)
+        env[JOB_ENV] = json.dumps(job)
+        env["QT_QPA_PLATFORM"] = "offscreen"
+        code = "import DrawingPdf\nDrawingPdf._child()\n"
+        proc = subprocess.run([_freecadcmd(), "-c", code], env=env, stdout=subprocess.PIPE,
+                              stderr=subprocess.STDOUT, timeout=seconds + 120)  # fmt: skip
+        try:
+            with open(result, encoding="utf-8") as f:
+                done = json.load(f)
+        except (OSError, ValueError):
+            tail = proc.stdout.decode("utf-8", "replace").strip().splitlines()[-5:]
+            raise RuntimeError("The drawing export stopped: " + " / ".join(tail))
+    if done.get("error"):
+        raise RuntimeError(done["error"])
+    return done["written"]
+
+
+def _child():
+    job = json.loads(os.environ[JOB_ENV])
+
+    def finish(**result):
+        with open(job["result"], "w", encoding="utf-8") as f:
+            json.dump(result, f, ensure_ascii=False)
+        sys.stdout.flush()
+        sys.stderr.flush()
+        os._exit(0)
+
+    try:
+        import FreeCADGui as Gui
+
+        Gui.showMainWindow()
+        from PySide import QtWidgets
+
+        doc = App.openDocument(job["path"], hidden=True)  # no 3D view: offscreen has no OpenGL
+        doc.recompute()
+        pages = [o for o in doc.Objects if o.isDerivedFrom("TechDraw::DrawPage")]
+        if job["pages"]:
+            wanted = set(job["pages"])
+            pages = [p for p in pages if p.Name in wanted or p.Label in wanted]
+        if not pages:
+            finish(error="No drawing page in " + job["path"]
+                   + (" named " + ", ".join(job["pages"]) if job["pages"] else ""))
+        import TechDrawGui
+
+        views = [v for v in doc.Objects if v.isDerivedFrom("TechDraw::DrawViewPart")
+                 and any(p in v.InListRecursive for p in pages)]  # fmt: skip
+        end = time.time() + job["seconds"]
+        while time.time() < end:
+            QtWidgets.QApplication.processEvents()
+            if all(_has_lines(v) for v in views):
+                break
+            time.sleep(0.05)
+        late = [v.Label for v in views if not _has_lines(v)]
+        if late:
+            finish(error="The lines of these views were not ready in %d s: %s"
+                   % (job["seconds"], ", ".join(late)))
+        for _ in range(10):  # let the scene take the last results (dimensions, labels)
+            QtWidgets.QApplication.processEvents()
+            time.sleep(0.02)
+        names = output_names(job["out"], [p.Label for p in pages])
+        for page, name in zip(pages, names):
+            folder = os.path.dirname(name)
+            if folder:
+                os.makedirs(folder, exist_ok=True)
+            TechDrawGui.exportPageAsPdf(page, name)
+            if not os.path.isfile(name) or os.path.getsize(name) == 0:
+                finish(error="Writing %s failed" % name)
+        finish(written=names)
+    except Exception as e:  # report and end: the GUI must not be torn down
+        finish(error="%s: %s" % (type(e).__name__, e))
+
+
+def _has_lines(view):
+    try:
+        return bool(view.getVisibleEdges())
+    except Exception:
+        return False
