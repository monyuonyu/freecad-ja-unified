   "precision mediump float; uniform vec4 col; void main(){ gl_FragColor = col; }");
 
 // ---------- 部品を GPU に載せる（三角形ごとの法線で角を立てる） ----------
-function f32(b64) { const s = atob(b64), u = new Uint8Array(s.length); for (let i = 0; i < s.length; i++) u[i] = s.charCodeAt(i);
-  return new Float32Array(u.buffer); }
+function bytes(b64) { const s = atob(b64 || ""), u = new Uint8Array(s.length); for (let i = 0; i < s.length; i++) u[i] = s.charCodeAt(i);
+  return u.buffer; }
+// positions: Int16 in the box of all (DATA.q), normals: Int8; older pages: Float32
+function pos(b64) { if (!DATA.q) return new Float32Array(bytes(b64));
+  const q = new Int16Array(bytes(b64)), f = new Float32Array(q.length), lo = DATA.q.lo, st = DATA.q.step;
+  for (let i = 0; i < q.length; i++) f[i] = lo[i % 3] + (q[i] + 32767) * st[i % 3];
+  return f; }
+function nrmOf(b64) { if (!DATA.q) return new Float32Array(bytes(b64));
+  const q = new Int8Array(bytes(b64)), f = new Float32Array(q.length);
+  for (let i = 0; i < q.length; i++) f[i] = q[i] / 127;
+  return f; }
 let lo = [Infinity, Infinity, Infinity], hi = [-Infinity, -Infinity, -Infinity];
 const parts = DATA.parts.map(pt => {
-  const t = f32(pt.tri), given = pt.nrm ? f32(pt.nrm) : null, nrm = given && given.length === t.length ? given : new Float32Array(t.length);
+  const t = pos(pt.tri), given = pt.nrm ? nrmOf(pt.nrm) : null, nrm = given && given.length === t.length ? given : new Float32Array(t.length);
   for (let i = 0; i < t.length; i += 9) {
     const a = [t[i], t[i+1], t[i+2]], b = [t[i+3], t[i+4], t[i+5]], c = [t[i+6], t[i+7], t[i+8]];
     if (nrm !== given) { const n = norm(cross(sub(b, a), sub(c, a))); for (let k = 0; k < 3; k++) nrm.set(n, i + 3 * k); }
     for (const v of [a, b, c]) for (let k = 0; k < 3; k++) { lo[k] = Math.min(lo[k], v[k]); hi[k] = Math.max(hi[k], v[k]); }
   }
-  const s = f32(pt.seg), bt = gl.createBuffer(), bn = gl.createBuffer(), bs = gl.createBuffer();
+  const s = pos(pt.seg), bt = gl.createBuffer(), bn = gl.createBuffer(), bs = gl.createBuffer();
   gl.bindBuffer(gl.ARRAY_BUFFER, bt); gl.bufferData(gl.ARRAY_BUFFER, t, gl.STATIC_DRAW);
   gl.bindBuffer(gl.ARRAY_BUFFER, bn); gl.bufferData(gl.ARRAY_BUFFER, nrm, gl.STATIC_DRAW);
   gl.bindBuffer(gl.ARRAY_BUFFER, bs); gl.bufferData(gl.ARRAY_BUFFER, s, gl.STATIC_DRAW);
