                 tri, nrm, seg = _shape_data(e.item, deflection, edges)
         else:
             tri, nrm, seg = _mesh_data(e.item)
+        raw.append((tri, nrm, seg))
         group = (e.label.split("_")[0] if "_" in e.label else e.label) if one_group else group_of(e)
         color = e.color or (e.view_colors[0] if e.view_colors else (0.8, 0.8, 0.8))
         wall = walls.get(e.label, walls.get(e.name))
         parts.append({"name": e.label, "group": group, "color": [round(float(c), 3) for c in color[:3]],
                       "alpha": float(alpha.get(e.label, alpha.get(e.name, 1.0))),
                       "wall": [float(c) for c in wall] if wall is not None else None,
-                      "tri": tri, "nrm": nrm, "seg": seg})  # fmt: skip
+                      })  # fmt: skip
+    # Positions as Int16 in the box of all, normals as Int8: half the size of float32 (a page of
+    # 1,000 parts over 30 MB; reported on 0.8.6). The error: the box / 65534 (4 m: 0.06 mm)
+    xs = [v for tri, _, seg in raw for v in tri[0::3] + seg[0::3]]
+    ys = [v for tri, _, seg in raw for v in tri[1::3] + seg[1::3]]
+    zs = [v for tri, _, seg in raw for v in tri[2::3] + seg[2::3]]
+    lo = [min(a) if a else 0.0 for a in (xs, ys, zs)]
+    span = [(max(a) - m) if a else 1.0 for a, m in zip((xs, ys, zs), lo)]
+    step = [max(d, 1e-9) / 65534.0 for d in span]
+
+    def q16(vals):
+        out = [int(round((v - lo[i % 3]) / step[i % 3])) - 32767 for i, v in enumerate(vals)]
+        return base64.b64encode(struct.pack("<%dh" % len(out), *out)).decode()
+
+    def q8(vals):
+        out = [max(-127, min(127, int(round(v * 127)))) for v in vals]
+        return base64.b64encode(struct.pack("<%db" % len(out), *out)).decode()
+
+    for part, (tri, nrm, seg) in zip(parts, raw):
+        part["tri"], part["nrm"], part["seg"] = q16(tri), q8(nrm) if nrm else "", q16(seg) if seg else ""
