From 8aca4bed6d0ffc11acfafe22601cf3fd3556a77b Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Wed, 30 Sep 2026 11:48:06 +0900
Subject: [PATCH] Unified: AI chat reads the .pth files of the bundled runtime
 (pywin32 on Windows)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/Mod/Unified/AIAgentBridge.py | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/Mod/Unified/AIAgentBridge.py b/src/Mod/Unified/AIAgentBridge.py
index a1ac48931..faca07330 100644
--- a/src/Mod/Unified/AIAgentBridge.py
+++ b/src/Mod/Unified/AIAgentBridge.py
@@ -254,6 +254,15 @@ class Bridge:
             await self.client.disconnect()
 
 
+def read_bundled_pth():
+    """同梱した部品（ai-runtime）の .pth を読む。pywin32（Windows で SDK が使う）は .pth で自分の場所を足すが、
+    PYTHONPATH で足した場所や、埋め込み用 Python の ._pth に書いた場所の .pth は、Python が読まない"""
+    import site
+    for p in list(sys.path):
+        if "ai-runtime" in p and os.path.isdir(p) and any(n.endswith(".pth") for n in os.listdir(p)):
+            site.addsitedir(p)
+
+
 def main():
     # FreeCAD とのやり取りは UTF-8 の JSON 行（Windows のパイプは既定でロケールの符号 cp932 などになる）
     for stream in (sys.stdin, sys.stdout, sys.stderr):
@@ -279,6 +288,7 @@ def main():
     if args.delete_key:
         delete_key(args.datadir)
         return
+    read_bundled_pth()
     global AssistantMessage, ClaudeAgentOptions, ClaudeSDKClient, ResultMessage, TextBlock
     global create_sdk_mcp_server, tool
     try:
