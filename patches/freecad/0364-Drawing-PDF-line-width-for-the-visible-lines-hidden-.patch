diff --git a/src/Mod/Unified/DrawingPdf.py b/src/Mod/Unified/DrawingPdf.py
index 1c13167c7..0c4470232 100644
--- a/src/Mod/Unified/DrawingPdf.py
+++ b/src/Mod/Unified/DrawingPdf.py
@@ -1,8 +1,8 @@
 # SPDX-License-Identifier: LGPL-2.1-or-later
 """PDF of the drawing pages without the screen:
 
-    FreeCADCmd model.FCStd --export-drawings out.pdf
-    DrawingPdf.export("model.FCStd", "out.pdf")     # -> [written files]
+    FreeCADCmd model.FCStd --export-drawings out.pdf [--line-width 0.25]
+    DrawingPdf.export("model.FCStd", "out.pdf", line_width=0.25)     # -> [written files]
 
 TechDraw draws its pages with the scene of the GUI, so a child FreeCADCmd starts the GUI
 offscreen (nothing is shown), waits for the views' lines, writes the PDFs and ends without
@@ -53,9 +53,11 @@ def _freecadcmd():
     raise RuntimeError("FreeCADCmd was not found next to " + home)
 
 
-def export(path, out, pages=None, seconds=120):
+def export(path, out, pages=None, seconds=120, line_width=None):
     """Write the drawing pages of the file `path` (all, or the names/labels in `pages`) as PDF.
-    Returns the files written; raises RuntimeError with the reason otherwise."""
+    line_width: the visible lines in mm (hidden and thin lines half of it, dimensions too);
+    without it the views' own widths, or the line group of the preferences for a file saved
+    without the screen. Returns the files written; raises RuntimeError with the reason otherwise."""
     if not isinstance(path, str):  # a document
         if not path.FileName:
             raise RuntimeError("Save the document first: the drawings are read from its file")
@@ -63,7 +65,7 @@ def export(path, out, pages=None, seconds=120):
     with tempfile.TemporaryDirectory() as tmp:
         result = os.path.join(tmp, "result.json")
         job = {"path": os.path.abspath(path), "out": os.path.abspath(out), "pages": pages,
-               "seconds": seconds, "result": result}  # fmt: skip
+               "seconds": seconds, "result": result, "line_width": line_width}  # fmt: skip
         env = dict(os.environ)
         env[JOB_ENV] = json.dumps(job)
         env["QT_QPA_PLATFORM"] = "offscreen"
@@ -156,6 +158,7 @@ def _child():
         if late:
             finish(error="The lines of these views were not ready in %d s: %s"
                    % (job["seconds"], ", ".join(late)))
+        set_line_widths(doc, pages, job.get("line_width"))
         for _ in range(10):  # let the scene take the last results (dimensions, labels)
             QtWidgets.QApplication.processEvents()
             time.sleep(0.02)
@@ -175,6 +178,29 @@ def _child():
         finish(error="%s: %s (line %d)" % (type(e).__name__, e, where.lineno))
 
 
+def set_line_widths(doc, pages, width):
+    """The lines of the pages' views: `width` mm for the visible lines (hidden, smooth and the
+    dimensions' lines half of it). Without it the views keep theirs (a file saved without the
+    screen: the line group of the preferences)"""
+    if not width:
+        return
+    for obj in doc.Objects:
+        if not any(p in obj.InListRecursive for p in pages):
+            continue
+        vo = getattr(obj, "ViewObject", None)
+        if vo is None or not hasattr(vo, "LineWidth"):
+            continue
+        if obj.isDerivedFrom("TechDraw::DrawViewPart"):
+            vo.LineWidth = width
+            vo.HiddenWidth = width / 2
+            if hasattr(vo, "IsoWidth"):
+                vo.IsoWidth = width * 5 / 7
+            if hasattr(vo, "ExtraWidth"):
+                vo.ExtraWidth = width * 2
+        else:  # dimensions, balloons, leaders
+            vo.LineWidth = width / 2
+
+
 def _has_lines(view):
     try:
         return bool(view.getVisibleEdges())
diff --git a/src/Mod/Unified/TestDrawingPdf.py b/src/Mod/Unified/TestDrawingPdf.py
index 9ede71a38..e4a5541d4 100644
--- a/src/Mod/Unified/TestDrawingPdf.py
+++ b/src/Mod/Unified/TestDrawingPdf.py
@@ -70,6 +70,24 @@ class ExportTest(unittest.TestCase):
         written = DrawingPdf.export(self.path, os.path.join(self.tmp, "out.pdf"))
         self.assertEqual(sorted(os.path.basename(w) for w in written), ["out_Second.pdf", "out_部品図.pdf"])
 
+    def test_line_width(self):
+        # the lines on paper as asked (company test 0.7.9: 1:12.5 rivets were black dots); the
+        # page's screen mode had drawn them up to four times thicker
+        import re
+        import zlib
+
+        out = os.path.join(self.tmp, "w.pdf")
+        DrawingPdf.export(self.path, out, pages=["Second"], line_width=0.33)
+        widths = set()
+        with open(out, "rb") as f:
+            data = f.read()
+        for m in re.finditer(rb"stream\r?\n(.*?)endstream", data, re.S):
+            try:
+                widths.update(float(w) for w in re.findall(rb"([\d.]+) w\b", zlib.decompress(m.group(1))))
+            except zlib.error:
+                pass
+        self.assertIn(3.3, widths)  # 0.33 mm in the scene's 0.1 mm
+
     def test_one_page_and_a_missing_one(self):
         out = os.path.join(self.tmp, "one.pdf")
         self.assertEqual(DrawingPdf.export(self.path, out, pages=["Second"]), [out])
