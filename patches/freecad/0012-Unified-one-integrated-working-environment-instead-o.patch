 bool Application::activateWorkbench(const char* name)
 {
+    // Single workbench mode: the user works in one integrated environment. Requests to
+    // switch to another workbench (from the start page, when editing a sketch or a
+    // PartDesign feature, from a remembered "last module", ...) activate that one instead.
+    const auto& cfg = App::Application::Config();
+    auto single = cfg.find("SingleWorkbench");
+    if (single != cfg.end() && !single->second.empty() && single->second != name
+        && std::strcmp(name, "NoneWorkbench") != 0 && workbenches().contains(QString::fromStdString(single->second))) {
+        Workbench* current = WorkbenchManager::instance()->active();
+        if (current && current->name() == single->second) {
+            return true;  // stay in the integrated environment
+        }
+        return activateWorkbench(single->second.c_str());
+    }
+
