@@ -0,0 +1,169 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+#include <Gui/Application.h>
+#include <Gui/Command.h>
+#include <Gui/MenuManager.h>
+#include <Gui/ToolBarManager.h>
+#include <Mod/Sketcher/Gui/Workbench.h>
+
+#include "Workbench.h"
+
+using namespace UnifiedGui;
+
+TYPESYSTEM_SOURCE(UnifiedGui::Workbench, Gui::StdWorkbench)
+
+// The toolbar names below are also listed in SketcherGui (nonEditModeToolbarNames) so that
+// they are hidden while a sketch is edited and only the sketch tools are shown.
+
+Workbench::Workbench() = default;
+
+Workbench::~Workbench() = default;
+
+Gui::MenuItem* Workbench::setupMenuBar() const
+{
+    Gui::MenuItem* root = StdWorkbench::setupMenuBar();
+    Gui::MenuItem* windows = root->findItem("&Windows");
+
+    // Sketch: everything about 2D drawing. The frequently used tools are also on the toolbars.
+    auto sketch = new Gui::MenuItem;
+    root->insertItem(windows, sketch);
+    sketch->setCommand("&Sketch");
+    *sketch << "PartDesign_NewSketch"
+            << "Sketcher_EditSketch"
+            << "Sketcher_MapSketch"
+            << "Sketcher_ReorientSketch"
+            << "Separator";
+    auto geom = new Gui::MenuItem;
+    geom->setCommand("Sketcher geometries");
+    SketcherGui::addSketcherWorkbenchGeometries(*geom);
+    auto cons = new Gui::MenuItem;
+    cons->setCommand("Sketcher constraints");
+    SketcherGui::addSketcherWorkbenchConstraints(*cons);
+    auto tools = new Gui::MenuItem;
+    tools->setCommand("Sketcher tools");
+    SketcherGui::addSketcherWorkbenchTools(*tools);
+    auto bspline = new Gui::MenuItem;
+    bspline->setCommand("Sketcher B-spline tools");
+    SketcherGui::addSketcherWorkbenchBSplines(*bspline);
+    auto visual = new Gui::MenuItem;
+    visual->setCommand("Sketcher visual");
+    SketcherGui::addSketcherWorkbenchVisual(*visual);
+    *sketch << geom << cons << tools << bspline << visual << "Separator"
+            << "Sketcher_ValidateSketch"
+            << "Sketcher_MergeSketches"
+            << "Sketcher_MirrorSketch";
+
+    // Part: all modelling tools, including the ones that are not on the toolbars
+    auto part = new Gui::MenuItem;
+    root->insertItem(windows, part);
+    part->setCommand("&Part Design");
+    auto additives = new Gui::MenuItem;
+    additives->setCommand("Additive Features");
+    *additives << "PartDesign_Pad"
+               << "PartDesign_Revolution"
+               << "PartDesign_AdditiveLoft"
+               << "PartDesign_AdditivePipe"
+               << "PartDesign_AdditiveHelix"
+               << "PartDesign_CompPrimitiveAdditive";
+    auto subtractives = new Gui::MenuItem;
+    subtractives->setCommand("Subtractive Features");
+    *subtractives << "PartDesign_Pocket"
+                  << "PartDesign_Hole"
+                  << "PartDesign_Groove"
+                  << "PartDesign_SubtractiveLoft"
+                  << "PartDesign_SubtractivePipe"
+                  << "PartDesign_SubtractiveHelix"
+                  << "PartDesign_CompPrimitiveSubtractive";
+    auto dressups = new Gui::MenuItem;
+    dressups->setCommand("Dress-Up Features");
+    *dressups << "PartDesign_Fillet"
+              << "PartDesign_Chamfer"
+              << "PartDesign_Draft"
+              << "PartDesign_Thickness"
+              << "PartDesign_Defeaturing";
+    auto transformations = new Gui::MenuItem;
+    transformations->setCommand("Transformation Features");
+    *transformations << "PartDesign_Mirrored"
+                     << "PartDesign_LinearPattern"
+                     << "PartDesign_PolarPattern"
+                     << "PartDesign_MultiTransform";
+    *part << "PartDesign_Body" << "Separator" << additives << subtractives << dressups
+          << transformations << "Separator"
+          << "PartDesign_Boolean"
+          << "PartDesign_ShapeBinder"
+          << "PartDesign_SubShapeBinder"
+          << "PartDesign_Clone"
+          << "Separator"
+          << "Part_CheckGeometry";
+
+    // Replace "Duplicate selection" with the variant that understands bodies, as PartDesign does
+    Gui::MenuItem* edit = root->findItem("&Edit");
+    if (Gui::MenuItem* dup = edit ? edit->findItem("Std_DuplicateSelection") : nullptr) {
+        dup->setCommand("PartDesign_DuplicateSelection");
+    }
+    return root;
+}
+
+Gui::ToolBarItem* Workbench::setupToolBars() const
+{
+    Gui::ToolBarItem* root = StdWorkbench::setupToolBars();
+
+    // The main flow: draw a sketch, turn it into a solid, refine it
+    auto sketch = new Gui::ToolBarItem(root);
+    sketch->setCommand("Unified Sketch");
+    *sketch << "PartDesign_NewSketch";
+
+    auto model = new Gui::ToolBarItem(root);
+    model->setCommand("Unified Model");
+    *model << "PartDesign_Pad"
+           << "PartDesign_Pocket"
+           << "PartDesign_Revolution"
+           << "PartDesign_Hole"
+           << "Separator"
+           << "PartDesign_Fillet"
+           << "PartDesign_Chamfer"
+           << "PartDesign_Thickness"
+           << "Separator"
+           << "PartDesign_Mirrored"
+           << "PartDesign_LinearPattern"
+           << "PartDesign_PolarPattern";
+
+    auto parts = new Gui::ToolBarItem(root);
+    parts->setCommand("Unified Parts");
+    *parts << "PartDesign_Body"
+           << "Std_TransformManip"
+           << "PartDesign_Boolean";
+
+    auto check = new Gui::ToolBarItem(root);
+    check->setCommand("Unified Check");
+    *check << "Std_Measure"
+           << "Part_CheckGeometry";
+
+    // Sketch tools: the same toolbars as in Sketcher, shown only while a sketch is edited
+    using Vis = Gui::ToolBarItem::DefaultVisibility;
+    auto editMode = new Gui::ToolBarItem(root, Vis::Unavailable);
+    editMode->setCommand("Edit Mode");
+    SketcherGui::addSketcherWorkbenchSketchEditModeActions(*editMode);
+    auto geom = new Gui::ToolBarItem(root, Vis::Unavailable);
+    geom->setCommand("Geometries");
+    SketcherGui::addSketcherWorkbenchGeometries(*geom);
+    auto cons = new Gui::ToolBarItem(root, Vis::Unavailable);
+    cons->setCommand("Constraints");
+    SketcherGui::addSketcherWorkbenchConstraints(*cons);
+    auto tools = new Gui::ToolBarItem(root, Vis::Unavailable);
+    tools->setCommand("Sketcher Tools");
+    SketcherGui::addSketcherWorkbenchTools(*tools);
+    auto bspline = new Gui::ToolBarItem(root, Vis::Unavailable);
+    bspline->setCommand("B-Spline Tools");
+    SketcherGui::addSketcherWorkbenchBSplines(*bspline);
+    auto visual = new Gui::ToolBarItem(root, Vis::Unavailable);
+    visual->setCommand("Visual Helpers");
+    SketcherGui::addSketcherWorkbenchVisual(*visual);
+
+    return root;
+}
+
+Gui::ToolBarItem* Workbench::setupCommandBars() const
+{
+    return new Gui::ToolBarItem;
+}
