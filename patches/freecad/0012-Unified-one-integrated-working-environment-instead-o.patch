+++ b/src/Mod/Unified/InitGui.py
@@ -0,0 +1,23 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+# Unified: the single integrated working environment.
+#
+# FreeCAD shows only this workbench. It gathers the tools of Sketcher, PartDesign and
+# friends in one place, so the user never has to pick or switch workbenches.
+
+
+class UnifiedWorkbench(Workbench):
+    MenuText = "FreeCAD"
+    ToolTip = "Sketch, model and check parts in one place"
+
+    def Initialize(self):
+        # Load the modules whose commands are used here. Their workbenches are never shown.
+        import PartGui
+        import SketcherGui
+        import PartDesignGui
+        import UnifiedGui
+
+    def GetClassName(self):
+        return "UnifiedGui::Workbench"
+
+
+Gui.addWorkbench(UnifiedWorkbench())
