@@ -0,0 +1,29 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+#pragma once
+
+#include <Gui/Workbench.h>
+
+namespace UnifiedGui
+{
+
+/**
+ * The only workbench shown to the user. Sketching, modelling and checking parts all
+ * happen here; the tools of Sketcher and PartDesign are gathered instead of being
+ * spread over several workbenches.
+ */
+class Workbench: public Gui::StdWorkbench
+{
+    TYPESYSTEM_HEADER_WITH_OVERRIDE();
+
+public:
+    Workbench();
+    ~Workbench() override;
+
+protected:
+    Gui::MenuItem* setupMenuBar() const override;
+    Gui::ToolBarItem* setupToolBars() const override;
+    Gui::ToolBarItem* setupCommandBars() const override;
+};
+
+}  // namespace UnifiedGui
