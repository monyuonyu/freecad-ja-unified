From 05e99c51117e35f2f763d1dd0a81fd993cd5e55c Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Sun, 27 Sep 2026 08:20:53 +0900
Subject: [PATCH 043/158] Unified: translated tooltips on the context bar

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/Mod/Unified/Gui/ContextBar.cpp | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/Mod/Unified/Gui/ContextBar.cpp b/src/Mod/Unified/Gui/ContextBar.cpp
index 4a5ccd98d..cd728fb08 100644
--- a/src/Mod/Unified/Gui/ContextBar.cpp
+++ b/src/Mod/Unified/Gui/ContextBar.cpp
@@ -258,7 +258,11 @@ void ContextBar::showActions(const std::vector<Action>& actions, QWidget* view)
         button->setIconSize(QSize(24, 24));
         button->setIcon(Gui::BitmapFactory().iconFromTheme(cmd->getPixmap()));
         button->setText(action.label);
-        button->setToolTip(QString::fromUtf8(cmd->getToolTipText()));
+        // The translated tooltip, as in the menus and on the toolbars
+        Gui::Action* cmdAction = cmd->getAction();
+        button->setToolTip(
+            cmdAction ? cmdAction->toolTip() : QString::fromUtf8(cmd->getToolTipText())
+        );
         const std::string name = action.command;
         connect(button, &QToolButton::clicked, this, [this, name]() {
             dismiss();
