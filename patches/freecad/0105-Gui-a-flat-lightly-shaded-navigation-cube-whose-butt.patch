+void SoNaviCube::updateShadedCube(const RenderParams& params) const
+{
+    // The cube is turned into the view by the inverse of the camera orientation
+    const SbRotation rotation = cameraOrientation.getValue().inverse();
+    const bool changed = !style.shaded || !rotation.equals(style.shadeRotation, 1e-6F)
+        || !nearlyEqual(style.shadeBaseRgb, params.baseRgb)
+        || !nearlyEqual(style.shadeHiliteRgb, params.hiliteRgb)
+        || !nearlyEqual(style.shadeBaseTr, params.baseTr)
+        || !nearlyEqual(style.shadeHiliteTr, params.hiliteTr)
+        || style.shadeHilitePick != params.hilitePick;
+    if (!changed) {
+        return;
+    }
+
+    SbVec3f light(-0.35F, 0.55F, 0.76F);  // from the upper left, towards the viewer
+    light.normalize();
+    const int count = static_cast<int>(kCubeFacePickOrder.size());
+    cubeMaterial->diffuseColor.setNum(count);
+    cubeMaterial->transparency.setNum(count);
+    cubeFaces->materialIndex.setNum(count);
+    for (int i = 0; i < count; ++i) {
+        const PickId id = kCubeFacePickOrder[i];
+        SbVec3f normal(0.0F, 0.0F, 0.0F);
+        for (const SbVec3f& v : faces[pickIndex(id)]) {
+            normal += v;
+        }
+        if (normal.length() > 0.0F) {
+            normal.normalize();
+        }
+        rotation.multVec(normal, normal);
+        const float brightness = 0.80F + 0.20F * std::max(0.0F, normal.dot(light));
+        const bool hilite = (id == params.hilitePick);
+        const SbColor color = hilite ? params.hiliteRgb : SbColor(params.baseRgb * brightness);
+        cubeMaterial->diffuseColor.set1Value(i, color);
+        cubeMaterial->transparency.set1Value(i, hilite ? params.hiliteTr : params.baseTr);
+        cubeFaces->materialIndex.set1Value(i, i);
+    }
+
+    style.shaded = true;
+    style.shadeRotation = rotation;
+    style.shadeBaseRgb = params.baseRgb;
+    style.shadeHiliteRgb = params.hiliteRgb;
+    style.shadeBaseTr = params.baseTr;
+    style.shadeHiliteTr = params.hiliteTr;
+    style.shadeHilitePick = params.hilitePick;
+    // the unshaded update starts over when shading is turned off
+    style.lastHiliteFaceIndex = -1;
+    style.lastHilitePick = PickId::None;
+}
