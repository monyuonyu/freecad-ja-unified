From 14f14dad598d5b1421e5d3b53d3b6d0438362c99 Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Sun, 27 Sep 2026 08:12:02 +0900
Subject: [PATCH 038/100] Unified: remaining property names in Japanese, wider
 name column

A scan of the properties of all PartDesign features, sketches, datums and
containers found a few names, groups and descriptions without a Japanese
text (e.g. the attachment offset of a sketch). The name column of the
property editor starts wider in the integrated environment so that
Japanese names fit.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/Gui/propertyeditor/PropertyEditor.cpp     |  8 ++-
 .../translations/UnifiedProperties_ja.ts      | 58 ++++++++++++++++++-
 2 files changed, 64 insertions(+), 2 deletions(-)

diff --git a/src/Gui/propertyeditor/PropertyEditor.cpp b/src/Gui/propertyeditor/PropertyEditor.cpp
index cd86c1258..bd6820369 100644
--- a/src/Gui/propertyeditor/PropertyEditor.cpp
+++ b/src/Gui/propertyeditor/PropertyEditor.cpp
@@ -110,7 +110,13 @@ PropertyEditor::PropertyEditor(QWidget* parent)
     auto hGrp = App::GetApplication().GetParameterGroupByPath(
         "User parameter:BaseApp/Preferences/DockWindows/PropertyView"
     );
-    int firstColumnSize = hGrp->GetInt("FirstColumnSize", 0);
+    // Japanese property names such as "取り付けの方式" do not fit into Qt's default width of
+    // the name column: start wider in the integrated environment (a width set by the user is
+    // kept as before)
+    int firstColumnSize = hGrp->GetInt(
+        "FirstColumnSize",
+        App::Application::Config().contains("SingleWorkbench") ? 130 : 0
+    );
     if (firstColumnSize != 0) {
         header()->resizeSection(0, firstColumnSize);
     }
