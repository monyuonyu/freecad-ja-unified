--- /dev/null
+++ b/src/Mod/Unified/DrawingAuto.py
@@ -0,0 +1,232 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""What a new drawing gets from the start (design 6.11): center lines of the holes, the outer
+sizes, the holes' size (same holes together, "4×⌀6 キリ"), and the title block filled in from
+the model (name, scale, date). Works without the GUI (tested by TestDrawingAuto.py).
+"""
+
+import datetime
+import time
+
+import FreeCAD as App
+
+translate = App.Qt.translate
+
+CENTER_LINE_STYLE = 4  # dash-dot
+THIN = 0.18
+
+
+def wait_for_geometry(view, seconds=20.0):
+    """The views compute their lines in a thread: wait until they have them"""
+    end = time.time() + seconds
+    while time.time() < end:
+        try:
+            if view.getVisibleEdges():
+                return True
+        except Exception:
+            pass
+        try:
+            from PySide import QtWidgets
+
+            QtWidgets.QApplication.processEvents()
+        except Exception:
+            pass
+        time.sleep(0.05)
+        view.Document.recompute()
+    return False
+
+
+def edges_of(view):
+    out = []
+    i = 0
+    while True:
+        try:
+            e = view.getEdgeByIndex(i)
+        except Exception:
+            break
+        if e is None:
+            break
+        out.append((i, e))
+        i += 1
+    return out
+
+
+def curve_name(edge):
+    try:
+        return type(edge.Curve).__name__
+    except Exception:
+        return ""
+
+
+def add_dimension(page, view, kind, refs, spec=None):
+    doc = page.Document
+    dim = doc.addObject("TechDraw::DrawViewDimension", "Dimension")
+    dim.Type = kind
+    dim.References2D = [(view, r) for r in refs]
+    if spec:
+        dim.FormatSpec = spec
+    page.addView(dim)
+    return dim
+
+
+def hole_groups(view):
+    """Circles of the view by diameter: {diameter: [(index, edge)]}"""
+    groups = {}
+    for i, e in edges_of(view):
+        if curve_name(e) == "Circle":
+            # The view's edges are in model sizes (not scaled)
+            d = round(e.Curve.Radius * 2, 3)
+            groups.setdefault(d, []).append((i, e))
+    return groups
+
+
+def center_lines(view, circles):
+    """A cross of thin dash-dot lines through each circle, a little longer than the circle"""
+    made = 0
+    for _, e in circles:
+        c = e.Curve.Location
+        # The view's edges and cosmetic lines are both in model sizes (not scaled)
+        cx, cy, er = c.x, c.y, e.Curve.Radius * 1.3
+        try:
+            view.makeCosmeticLine(App.Vector(cx - er, cy, 0), App.Vector(cx + er, cy, 0), CENTER_LINE_STYLE, THIN)
+            view.makeCosmeticLine(App.Vector(cx, cy - er, 0), App.Vector(cx, cy + er, 0), CENTER_LINE_STYLE, THIN)
+            made += 1
+        except Exception as e:
+            App.Console.PrintLog("Drawing: center line: {}\n".format(e))
+    return made
+
+
+def vertices_of(view):
+    out = []
+    i = 0
+    while True:
+        try:
+            v = view.getVertexByIndex(i)
+        except Exception:
+            break
+        if v is None:
+            break
+        out.append((i, v.Point if hasattr(v, "Point") else App.Vector(v.X, v.Y, v.Z)))
+        i += 1
+    return out
+
+
+def extent(view):
+    """The bounding box of the view's lines (model sizes): (xmin, ymin, xmax, ymax)"""
+    pts = [p for _, p in vertices_of(view)]
+    for _, e in edges_of(view):
+        bb = e.BoundBox
+        pts += [App.Vector(bb.XMin, bb.YMin, 0), App.Vector(bb.XMax, bb.YMax, 0)]
+    if not pts:
+        return None
+    return (min(p.x for p in pts), min(p.y for p in pts), max(p.x for p in pts), max(p.y for p in pts))
+
+
+def outer_sizes(page, view, horizontal=True, vertical=True):
+    """The overall width and height, between the outermost points of the view, placed below
+    and at the left of the view"""
+    verts = vertices_of(view)
+    if len(verts) < 2:
+        return []
+    box = extent(view)
+    scale = view.getScale() if hasattr(view, "getScale") else 1.0
+    made = []
+    if horizontal:
+        left = min(verts, key=lambda t: (t[1].x, t[1].y))
+        right = min(verts, key=lambda t: (-t[1].x, t[1].y))
+        if abs(right[1].x - left[1].x) > 1e-6:
+            d = add_dimension(page, view, "DistanceX", ["Vertex%d" % left[0], "Vertex%d" % right[0]])
+            d.X, d.Y = 0, box[1] * scale - 8
+            made.append(d)
+    if vertical:
+        low = min(verts, key=lambda t: (t[1].y, t[1].x))
+        high = min(verts, key=lambda t: (-t[1].y, t[1].x))
+        if abs(high[1].y - low[1].y) > 1e-6:
+            d = add_dimension(page, view, "DistanceY", ["Vertex%d" % low[0], "Vertex%d" % high[0]])
+            d.X, d.Y = box[0] * scale - 8, 0
+            made.append(d)
+    return made
+
+
+def place_clear_of_title_block(page, group):
+    """The front view above the title block (bottom right) and a little to the left"""
+    front = group.Anchor
+    box = extent(front)
+    if box is None:
+        return
+    scale = group.Scale
+    width = page.PageWidth if hasattr(page, "PageWidth") else 297.0
+    h = (box[3] - box[1]) * scale
+    group.X = width * 0.42
+    group.Y = 76 + h / 2  # the title block and the width below the view
+
+
+def scale_text(scale):
+    if scale >= 1:
+        return "{:g} : 1".format(scale)
+    return "1 : {:g}".format(1 / scale)
+
+
+def fill_title_block(page, name, scale):
+    tpl = page.Template
+    if tpl is None or not hasattr(tpl, "EditableTexts"):
+        return
+    texts = dict(tpl.EditableTexts)
+    values = {
+        "title": name, "FC-Title": name,
+        "scale": scale_text(scale), "FC-SC": scale_text(scale),
+        "date_of_issue": datetime.date.today().isoformat(), "FC-Date": datetime.date.today().isoformat(),
+        "sheet_number": "1 / 1", "FC-SH": "1 / 1",
+        "language_code": "JA",
+        "general_tolerances": "JIS B 0405-m",
+        "document_type": translate("DrawingAuto", "Part drawing"),
+        "creator": "", "approval_person": "", "part_material": "", "drawing_number": "", "revision_index": "",
+        "Designed_by_Name": "", "Subtitle": "", "Weight": "", "Drawing_number": "",
+    }
+    for key in texts:
+        if key in values:
+            texts[key] = values[key]
+    tpl.EditableTexts = texts
+
+
+def complete(page, group, name=None):
+    """Add the center lines, sizes and title block to a new three-view drawing.
+    Returns what was added: {"center_lines": n, "dimensions": n}"""
+    doc = page.Document
+    views = list(group.Views) if group is not None else []
+    front = group.Anchor if group is not None else None
+    added = {"center_lines": 0, "dimensions": 0}
+    if front is None:
+        return added
+    for v in views:
+        wait_for_geometry(v)
+    place_clear_of_title_block(page, group)
+    doc.recompute()
+    for v in views:
+        wait_for_geometry(v)
+    groups = hole_groups(front)
+    for diameter, circles in sorted(groups.items()):
+        added["center_lines"] += center_lines(front, circles)
+        n = len(circles)
+        spec = ("{}×⌀%.0f".format(n) if n > 1 else "⌀%.0f") + (translate("DrawingAuto", " drill") if n > 1 else "")
+        # On the hole at the top right, its text outside the part up and to the right
+        index, edge = max(circles, key=lambda t: t[1].Curve.Location.x + t[1].Curve.Location.y)
+        d = add_dimension(page, front, "Diameter", ["Edge%d" % index], spec)
+        box = extent(front)
+        sc = front.getScale() if hasattr(front, "getScale") else 1.0
+        if box:
+            d.X = box[2] * sc + 6
+            d.Y = box[3] * sc + 8
+        added["dimensions"] += 1
+    added["dimensions"] += len(outer_sizes(page, front))
+    # The depth: the width of the right view
+    for v in views:
+        if v is not front and getattr(v, "Type", "") == "Right":
+            added["dimensions"] += len(outer_sizes(page, v, horizontal=True, vertical=False))
+    # The name of the part is the name of its file
+    title = name or doc.Label
+    fill_title_block(page, title, group.Scale)
+    doc.recompute()
+    for v in views:
+        v.touch()
+    doc.recompute()
+    return added
