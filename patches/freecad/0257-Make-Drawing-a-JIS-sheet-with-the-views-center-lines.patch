+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""Tests of what a new drawing gets (DrawingAuto.py), without the GUI:
+
+    FreeCADCmd -t TestDrawingAuto
+"""
+
+import unittest
+
+import FreeCAD as App
+
+import DrawingAuto
+import FirstSteps
+
+
+class TestDrawingAuto(unittest.TestCase):
+    def test_plate(self):
+        doc = FirstSteps.sample_plate("DrawingAutoTest")
+        try:
+            page = doc.addObject("TechDraw::DrawPage", "Page")
+            tpl = doc.addObject("TechDraw::DrawSVGTemplate", "Template")
+            tpl.Template = App.getResourceDir() + "Mod/TechDraw/Templates/ISO/A4_Landscape_ISO5457_minimal.svg"
+            page.Template = tpl
+            g = doc.addObject("TechDraw::DrawProjGroup", "ProjGroup")
+            page.addView(g)
+            g.Source = [doc.getObject("Body")]
+            g.addProjection("Front")
+            g.Anchor.Direction = App.Vector(0, 0, 1)
+            g.Anchor.XDirection = App.Vector(1, 0, 0)
+            g.addProjection("Top")
+            g.addProjection("Right")
+            g.ScaleType = "Custom"
+            g.Scale = 2
+            doc.recompute()
+            added = DrawingAuto.complete(page, g)
+            self.assertEqual(added["center_lines"], 4)
+            dims = {(d.Type, round(d.getRawValue(), 3)) for d in doc.Objects if d.isDerivedFrom("TechDraw::DrawViewDimension")}
+            self.assertIn(("Diameter", 6.0), dims)
+            self.assertIn(("DistanceX", 80.0), dims)
+            self.assertIn(("DistanceY", 50.0), dims)
+            self.assertIn(("DistanceX", 5.0), dims)
+            hole = [d for d in doc.Objects if d.isDerivedFrom("TechDraw::DrawViewDimension") and d.Type == "Diameter"][0]
+            self.assertTrue(hole.FormatSpec.startswith("4×⌀"))
+            texts = dict(tpl.EditableTexts)
+            self.assertEqual(texts["title"], doc.Label)
+            self.assertEqual(texts["scale"], "2 : 1")
+        finally:
+            App.closeDocument(doc.Name)
+
+
+if __name__ == "__main__":
+    unittest.main()
