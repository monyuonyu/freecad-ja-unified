-list(APPEND Unified_Scripts HistoryLine.py TestHistoryLine.py SelectionWords.py TestSelectionWords.py TestLooseOutline.py AssemblyCopies.py TestAssemblyCopies.py
+list(APPEND Unified_Scripts HistoryLine.py TestHistoryLine.py SelectionWords.py TestSelectionWords.py TestLooseOutline.py AssemblyCopies.py TestAssemblyCopies.py TestRecompute.py
     TaskPanels.py TestTaskPanels.py Wording.py TestWording.py)
 if(BUILD_GUI)
     list(APPEND Unified_Scripts HistoryLineGui.py SelectionWordsGui.py TaskPanelsGui.py HoleMultiGui.py AssemblyCopiesGui.py FollowGui.py)
diff --git a/src/Mod/Unified/TestRecompute.py b/src/Mod/Unified/TestRecompute.py
new file mode 100644
index 000000000..0c198d1ae
--- /dev/null
+++ b/src/Mod/Unified/TestRecompute.py
@@ -0,0 +1,60 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+# Parametric design: a change of a spreadsheet cell reaches what uses it, headless:
+#   FreeCADCmd -t TestRecompute
+# (engine field test 0.6.9: with the fine-grained recompute a cell "A1" with the alias "k" never
+# reached "Params.k" — the names were compared, not the properties)
+
+import os
+import tempfile
+import unittest
+
+import FreeCAD as App
+
+
+class RecomputeTest(unittest.TestCase):
+    def setUp(self):
+        self.doc = App.newDocument("RecomputeTest")
+
+    def tearDown(self):
+        App.closeDocument(self.doc.Name)
+
+    def test_alias_follows_the_cell(self):
+        d = self.doc
+        s = d.addObject("Spreadsheet::Sheet", "Params")
+        s.set("A1", "1")
+        s.setAlias("A1", "k")
+        b = d.addObject("Part::Box", "Box")
+        b.setExpression("Length", "Params.k * 10")
+        d.recompute()
+        self.assertAlmostEqual(b.Length.Value, 10)
+        for v in (2, 3, 4):
+            s.set("A1", str(v))
+            d.recompute()
+            self.assertAlmostEqual(b.Length.Value, 10 * v)
+        s.set("k", "5")
+        d.recompute()
+        self.assertAlmostEqual(b.Length.Value, 50)
+
+    def test_cell_without_alias_and_after_reopening(self):
+        d = self.doc
+        s = d.addObject("Spreadsheet::Sheet", "Params")
+        s.set("B2", "3")
+        b = d.addObject("Part::Box", "Box")
+        b.setExpression("Height", "Params.B2 * 2")
+        d.recompute()
+        s.set("B2", "4")
+        d.recompute()
+        self.assertAlmostEqual(b.Height.Value, 8)
+        path = os.path.join(tempfile.mkdtemp(), "params.FCStd")
+        d.saveAs(path)
+        App.closeDocument(d.Name)
+        self.doc = App.openDocument(path)
+        s = self.doc.getObject("Params")
+        b = self.doc.getObject("Box")
+        s.set("B2", "6")
+        self.doc.recompute()
+        self.assertAlmostEqual(b.Height.Value, 12)
+
+
+if __name__ == "__main__":
+    unittest.main()
