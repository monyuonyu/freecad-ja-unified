From c7919254a39b3d8098781eb9fbf13da212b38208 Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Fri, 23 Oct 2026 08:33:38 +0900
Subject: [PATCH 292/407] App: a spreadsheet cell's change reaches the
 expressions that use its alias

With the fine-grained recompute the dependents of a recomputed object are
touched by the names of its changed properties. A spreadsheet's cell is
known by two names ("A1" and its alias "k"): the change of "A1" never
reached "Params.k", so no expression using a cell by its alias followed a
change (engine field test 0.6.9; stock 1.1.3 had no fine-grained recompute).
The names now resolve to the property before they are compared.

Test: FreeCADCmd -t TestRecompute

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/App/Document.cpp             | 13 ++++++-
 src/Mod/Unified/CMakeLists.txt   |  2 +-
 src/Mod/Unified/TestRecompute.py | 60 ++++++++++++++++++++++++++++++++
 3 files changed, 73 insertions(+), 2 deletions(-)
 create mode 100644 src/Mod/Unified/TestRecompute.py

diff --git a/src/App/Document.cpp b/src/App/Document.cpp
index 58a35ca6d..fe9fa6384 100644
--- a/src/App/Document.cpp
+++ b/src/App/Document.cpp
@@ -2981,7 +2981,18 @@ int Document::recompute(const std::vector<DocumentObject*>& objs,
                         // set all dependent objects touched based on properties
                         std::vector<DepEdge> inList = obj->getInListProp();
                         for (auto& [objFrom, propFrom, objTo, propTo] : inList) {
-                            if (obj->touchedProps.contains(propTo) || propTo.empty()) {
+                            // A property may be known by two names: a spreadsheet's
+                            // cell "A1" and its alias "k". "Params.k" must follow a change of
+                            // "A1" (comparing the names only, it never did)
+                            auto underAnotherName = [obj](const std::string& name) {
+                                Property* target = obj->getPropertyByName(name.c_str());
+                                return target
+                                    && std::ranges::any_of(obj->touchedProps, [&](const auto& t) {
+                                           return obj->getPropertyByName(t.c_str()) == target;
+                                       });
+                            };
+                            if (obj->touchedProps.contains(propTo) || propTo.empty()
+                                || underAnotherName(propTo)) {
                                 objFrom->enforceRecompute(propFrom);
                             }
                         }
diff --git a/src/Mod/Unified/CMakeLists.txt b/src/Mod/Unified/CMakeLists.txt
index 01e387116..7b8c387e8 100644
--- a/src/Mod/Unified/CMakeLists.txt
