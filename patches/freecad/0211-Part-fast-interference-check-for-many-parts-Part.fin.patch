+    FreeCADCmd model.FCStd --interference [--interference-report report.json]
 
 Python:
 
     import PartViews
     PartViews.render(objects_or_doc, "out.png", view="iso", size=(1600, 1200))
+    PartViews.interference(objects_or_doc)                     # [(obj_a, obj_b, volume)]
 """
 
+import json
 import os
 
 import FreeCAD as App
@@ -25,6 +28,7 @@ import Part
 __all__ = [
     "scene_objects",
     "render",
+    "interference",
     "cli_main",
 ]
 
@@ -192,6 +196,28 @@ def render(source=None, path="view.png", view="iso", size=None, style="shaded",
     return written
 
 
+def _solid_shape(obj, item):
+    if isinstance(item, Part.Shape):
+        return item
+    return None
+
+
+def interference(source=None, tolerance=0.0, min_volume=1e-6, threads=0, stats=False):
+    """[(name_a, name_b, volume)] of overlapping solids.  With stats=True: (pairs, stats)."""
+    pairs = scene_objects(source)
+    shapes, names = [], []
+    for i, (obj, item) in enumerate(pairs):
+        shape = _solid_shape(obj, item)
+        if shape is None or not shape.Solids:
+            continue
+        shapes.append(shape)
+        names.append(obj.Label if obj is not None else "item%d" % i)
+    found, st = Part.findInterferences(shapes, tolerance=tolerance, minVolume=min_volume,
+                                       threads=threads, stats=True)  # fmt: skip
+    result = [(names[a], names[b], vol) for a, b, vol in found]
+    return (result, st) if stats else result
+
+
 def _config(key):
     try:
         return App.ConfigGet(key)
@@ -212,3 +238,17 @@ def cli_main():
     if png:
         for out in render(doc, png, view=view, size=size, style=style):
             print("Wrote %s" % out)
+    report = _config("InterferenceReport")
+    if report:
+        found, st = interference(doc, stats=True)
+        for a, b, vol in found:
+            if vol < 0:
+                print("CHECK FAILED  %s <-> %s" % (a, b))
+            else:
+                print("INTERFERENCE  %s <-> %s  volume %.6g" % (a, b, vol))
+        print("%d interference(s) among %d solids (%d candidate pairs, boxes %.3f s, booleans %.3f s)"
+              % (len(found), st["shapes"], st["candidates"], st["secondsBoxes"], st["secondsBooleans"]))  # fmt: skip
+        if report not in ("-", "1"):
+            with open(report, "w", encoding="utf-8") as f:
+                json.dump({"pairs": [{"a": a, "b": b, "volume": v} for a, b, v in found],
+                           "stats": st}, f, ensure_ascii=False, indent=1)  # fmt: skip
