+// ------------------------------------------------------------------ interference
+
+std::vector<InterferencePair> Part::ViewTools::findInterferences(
+    const std::vector<TopoDS_Shape>& shapes,
+    double tolerance,
+    double minVolume,
+    int threads,
+    InterferenceStats* stats
+)
+{
+    using clock = std::chrono::steady_clock;
+    auto t0 = clock::now();
+    const int n = (int)shapes.size();
+    struct Box
+    {
+        double x0, y0, z0, x1, y1, z1;
+        bool valid;
+    };
+    std::vector<Box> boxes(n);
+    for (int i = 0; i < n; ++i) {
+        Bnd_Box b;
+        if (!shapes[i].IsNull()) {
+            BRepBndLib::AddOptimal(shapes[i], b, Standard_False, Standard_False);
+        }
+        boxes[i].valid = !b.IsVoid();
+        if (boxes[i].valid) {
+            b.Get(boxes[i].x0, boxes[i].y0, boxes[i].z0, boxes[i].x1, boxes[i].y1, boxes[i].z1);
+        }
+    }
+    // sweep and prune along x
+    std::vector<int> order;
+    for (int i = 0; i < n; ++i) {
+        if (boxes[i].valid) {
+            order.push_back(i);
+        }
+    }
+    std::sort(order.begin(), order.end(), [&](int a, int b) { return boxes[a].x0 < boxes[b].x0; });
+    const double tol = std::max(tolerance, 0.0);
+    std::vector<std::pair<int, int>> candidates;
+    for (size_t i = 0; i < order.size(); ++i) {
+        const Box& A = boxes[order[i]];
+        for (size_t j = i + 1; j < order.size(); ++j) {
+            const Box& B = boxes[order[j]];
+            if (B.x0 > A.x1 + tol) {
+                break;
+            }
+            if (B.y0 > A.y1 + tol || A.y0 > B.y1 + tol || B.z0 > A.z1 + tol || A.z0 > B.z1 + tol) {
+                continue;
+            }
+            int a = std::min(order[i], order[j]);
+            int b = std::max(order[i], order[j]);
+            candidates.emplace_back(a, b);
+        }
+    }
+    std::sort(candidates.begin(), candidates.end());
+    auto t1 = clock::now();
+
+    std::vector<double> volume(candidates.size(), 0.0);
+    int nthreads = threads > 0 ? threads : (int)std::max(1U, std::thread::hardware_concurrency());
+    nthreads = std::min<int>(nthreads, std::max<int>(1, (int)candidates.size()));
+    std::atomic<size_t> next {0};
+    std::mutex errorMutex;
+    std::string firstError;
+    auto worker = [&]() {
+        // booleans may add pcurves to their arguments: give each thread its own copies
+        std::unordered_map<int, TopoDS_Shape> copies;
+        auto get = [&](int i) -> const TopoDS_Shape& {
+            if (nthreads == 1) {
+                return shapes[i];
+            }
+            auto it = copies.find(i);
+            if (it == copies.end()) {
+                it = copies.emplace(i, BRepBuilderAPI_Copy(shapes[i], Standard_True, Standard_False).Shape())
+                         .first;
+            }
+            return it->second;
+        };
+        for (size_t k = next++; k < candidates.size(); k = next++) {
+            try {
+                BRepAlgoAPI_Common op(get(candidates[k].first), get(candidates[k].second));
+                if (tol > 0) {
+                    op.SetFuzzyValue(tol);
+                }
+                op.SetRunParallel(Standard_False);
+                op.Build();
+                if (!op.IsDone()) {
+                    volume[k] = -1;
+                    continue;
+                }
+                GProp_GProps props;
+                BRepGProp::VolumeProperties(op.Shape(), props);
+                volume[k] = std::fabs(props.Mass());
+            }
+            catch (const Standard_Failure& e) {
+                std::lock_guard<std::mutex> lock(errorMutex);
+                if (firstError.empty()) {
+                    firstError = e.GetMessageString() ? e.GetMessageString() : "OCC error";
+                }
+                volume[k] = -1;
+            }
+        }
+    };
+    if (nthreads <= 1) {
+        worker();
+    }
+    else {
+        std::vector<std::thread> pool;
+        for (int i = 0; i < nthreads; ++i) {
+            pool.emplace_back(worker);
+        }
+        for (auto& th : pool) {
+            th.join();
+        }
+    }
+    auto t2 = clock::now();
+
+    std::vector<InterferencePair> result;
+    for (size_t k = 0; k < candidates.size(); ++k) {
+        if (volume[k] > minVolume) {
+            result.push_back({candidates[k].first, candidates[k].second, volume[k]});
+        }
+        else if (volume[k] < 0) {
+            // the boolean failed: report it so it is not silently taken as clear
+            result.push_back({candidates[k].first, candidates[k].second, -1.0});
+        }
+    }
+    if (stats) {
+        stats->candidates = candidates.size();
+        stats->secondsBoxes = std::chrono::duration<double>(t1 - t0).count();
+        stats->secondsBooleans = std::chrono::duration<double>(t2 - t1).count();
+    }
+    return result;
+}
