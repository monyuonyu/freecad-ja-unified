diff --git a/src/Mod/Part/App/ViewToolsPy.cpp b/src/Mod/Part/App/ViewToolsPy.cpp
index 7ec662687..f0c151465 100644
--- a/src/Mod/Part/App/ViewToolsPy.cpp
+++ b/src/Mod/Part/App/ViewToolsPy.cpp
@@ -222,6 +222,69 @@ PyObject* renderImage(PyObject* /*self*/, PyObject* args, PyObject* kwds)
     }
 }
 
+PyObject* findInterferencesPy(PyObject* /*self*/, PyObject* args, PyObject* kwds)
+{
+    static const char* kwlist[] = {"shapes", "tolerance", "minVolume", "threads", "stats", nullptr};
+    PyObject* objs {};
+    double tolerance = 0.0, minVolume = 1e-6;
+    int threads = 0;
+    PyObject* withStats = Py_False;
+    if (!PyArg_ParseTupleAndKeywords(args, kwds, "O|ddiO!", const_cast<char**>(kwlist), &objs, &tolerance, &minVolume, &threads, &PyBool_Type, &withStats)) {
+        return nullptr;
+    }
+    try {
+        std::vector<TopoDS_Shape> shapes;
+        Py::Sequence seq(objs);
+        for (const auto& o : seq) {
+            Py::Object obj(o);
+            if (obj.hasAttr("Shape") && !PyObject_TypeCheck(obj.ptr(), &Part::TopoShapePy::Type)) {
+                obj = obj.getAttr("Shape");
+            }
+            if (!PyObject_TypeCheck(obj.ptr(), &Part::TopoShapePy::Type)) {
+                throw Py::TypeError("findInterferences expects shapes or objects with a Shape");
+            }
+            shapes.push_back(static_cast<Part::TopoShapePy*>(obj.ptr())->getTopoShapePtr()->getShape());
+        }
+        InterferenceStats stats;
+        std::vector<InterferencePair> pairs;
+        {
+            Py_BEGIN_ALLOW_THREADS
+            try {
+                pairs = findInterferences(shapes, tolerance, minVolume, threads, &stats);
+            }
+            catch (...) {
+                Py_BLOCK_THREADS
+                throw;
+            }
+            Py_END_ALLOW_THREADS
+        }
+        Py::List list;
+        for (const auto& p : pairs) {
+            list.append(Py::TupleN(Py::Long(p.a), Py::Long(p.b), Py::Float(p.volume)));
+        }
+        if (!Base::asBoolean(withStats)) {
+            return Py::new_reference_to(list);
+        }
+        Py::Dict d;
+        d["shapes"] = Py::Long((long)shapes.size());
+        d["candidates"] = Py::Long((long)stats.candidates);
+        d["secondsBoxes"] = Py::Float(stats.secondsBoxes);
+        d["secondsBooleans"] = Py::Float(stats.secondsBooleans);
+        return Py::new_reference_to(Py::TupleN(list, d));
+    }
+    catch (const Py::Exception&) {
+        return nullptr;
+    }
+    catch (const Base::Exception& e) {
+        e.setPyException();
+        return nullptr;
+    }
+    catch (const Standard_Failure& e) {
+        PyErr_SetString(Part::PartExceptionOCCError, e.GetMessageString());
+        return nullptr;
+    }
+}
