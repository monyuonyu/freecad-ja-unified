+struct InterferencePair
+{
+    int a = 0;
+    int b = 0;
+    double volume = 0;
+};
+
+struct InterferenceStats
+{
+    std::size_t candidates = 0;  // pairs whose bounding boxes overlap
+    double secondsBoxes = 0;
+    double secondsBooleans = 0;
+};
+
+/// Pairs of shapes whose common volume is larger than \a minVolume.  Bounding boxes
+/// (sweep and prune) select the candidate pairs; only those get a boolean common,
+/// spread over \a threads threads (0: all cores).
+PartExport std::vector<InterferencePair> findInterferences(
+    const std::vector<TopoDS_Shape>& shapes,
+    double tolerance,
+    double minVolume,
+    int threads,
+    InterferenceStats* stats = nullptr
+);
+
 /// Adds the Python functions of the headless views to the Part module
