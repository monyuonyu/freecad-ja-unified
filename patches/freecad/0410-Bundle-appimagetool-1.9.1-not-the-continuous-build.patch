From 6ba5c8433e1bbf80dc611be8990138e29aaedf42 Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Fri, 30 Oct 2026 08:24:50 +0900
Subject: [PATCH 410/417] Bundle: appimagetool 1.9.1, not the continuous build

The continuous build of 2026-10-29 refuses an AppDir without .DirIcon:
the Linux release of 0.9.3 stopped there.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 package/bundle/linux/create_bundle.sh | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/package/bundle/linux/create_bundle.sh b/package/bundle/linux/create_bundle.sh
index cba197dce..499e04612 100755
--- a/package/bundle/linux/create_bundle.sh
+++ b/package/bundle/linux/create_bundle.sh
@@ -177,7 +177,8 @@ if [ ! -f "${conda_env}/Mod/Fasteners/FastenersCmd.py" ] || [ ! -f "${conda_env}
 fi
 tail -3 "${shelf_home}/out.txt"
 
-curl -LO https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-$(uname -m).AppImage
+# a fixed release: "continuous" of 2026-10-29 refused the AppDir (no .DirIcon) and the build stopped
+curl -LO https://github.com/AppImage/appimagetool/releases/download/1.9.1/appimagetool-$(uname -m).AppImage
 chmod a+x appimagetool-$(uname -m).AppImage
 
 if [ "${UPLOAD_RELEASE}" == "true" ]; then
-- 
2.43.0

