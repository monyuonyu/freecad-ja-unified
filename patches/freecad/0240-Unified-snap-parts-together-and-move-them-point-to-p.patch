+        body.newObject("PartDesign::AdditiveBox", "Box")
+        other = self.doc.addObject("App::Part", "Other")
+        other.Placement = App.Placement(App.Vector(-50, 0, 0), App.Rotation(App.Vector(1, 1, 1), 60))
+        self.box("B", container=other, placement=App.Placement(App.Vector(0, 0, 7), App.Rotation()))
+        self.doc.recompute()
