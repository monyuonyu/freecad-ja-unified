+                if self.objects:
+                    return tr("Click the base point (the point that is moved)")
+                return tr("Click the point on the part to move (a vertex, the middle of an edge, the center of a circle...)")
+            if self.b is None:
+                return tr("Click where the point goes (hold Ctrl for a copy)")
+            return tr("If it is right, OK. Clicking another point changes where it goes")
+        if self.a is None:
+            if self.point_first:
+                return tr("Click the point on the part to move")
+            return tr("Click the face of the part to move (a flat face, or a round one for an axis)")
+        if self.b is None:
+            if self.a[1].kind == "axis":
+                return tr("Click the round face or circle to line it up with")
+            if self.a[1].kind == "point":
+                return tr("Click the face to put the point on")
+            return tr("Click the face to put it against")
+        return tr("Adjust below, then OK. Clicking another face changes where it goes")
+
+    def _feature(self, pick, first):
+        want = "point" if (first and self.point_first) or self.mode == "point" else None
+        return S.feature_of(pick, want)
+
+    def _unmoved(self, pick, feature):
+        """A pick made on the part while it is shown moved: back to where it was."""
+        if self.move is not None and self.candidates:
+            m = self._movable()
+            if m is not None and S.contains(m, pick):
+                return feature.transformed(self.move.inverse())
+        return feature
+
+    def _take(self, pick, point, kind, ctrl, from_selection=False):
+        self.message.setText("")
+        if point is not None:
+            pick = S.Pick(pick.root, pick.sub, point)
+        try:
+            # A click on the part that moves picks it again; for "point to point" a point on
+            # it can also be the destination (e.g. move it by its own length)
+            if self.a is None or (self.mode == "snap" and self._picked_moving(pick)):
+                feature = self._unmoved(pick, self._feature(pick, True))
+                candidates = S.movable_candidates(pick)
+                if self.mode == "point" and self.objects:
+                    candidates = self.objects
+                if not candidates:
+                    raise S.SnapError(tr("This cannot be moved"))
+                self.transaction.abort()
+                self.move = None
+                self.a = (pick, feature)
+                self.b = None
+                self._set_candidates(candidates)
+            else:
+                feature = self._feature(pick, False)
+                for m in self._movables():
+                    if self.mode == "snap" and S.contains(m, pick):
+                        raise S.SnapError(tr("That is part of what moves. Click something else"))
+                if self.mode == "snap" and S.pair_kind(self.a[1], feature) is None:
+                    raise S.SnapError(
+                        tr("These two do not go together: pick two flat faces, two round faces (or circles), or a point and a face")
+                    )
+                self.b = (pick, feature)
+                if ctrl and self.mode == "point":
+                    self.copy.blockSignals(True)
+                    self.copy.setChecked(True)
+                    self.copy.blockSignals(False)
+        except S.SnapError as err:
+            self.message.setText(str(err))
+            return
+        self._show_picks()
+        self._apply()
+
+    def _picked_moving(self, pick):
+        m = self._movable()
+        return m is not None and S.contains(m, pick)
+
+    def _clicked(self, pick, point, kind, ctrl):
+        if self.closed:
+            return
+        self._take(pick, point, kind, ctrl)
+
+    def _hover(self, hit):
+        if self.closed or self.picker is None:
+            return
+        overlay = self.picker.overlay
+        if self.mode == "point" and self.a is not None and self.b is None:
+            # The parts follow the cursor from the base point
+            if hit is None:
+                overlay.show_line(None, None)
+                overlay.move_ghosts(None)
+                return
+            base = self.a[1].pick
+            overlay.show_line(base, hit[1])
+            overlay.move_ghosts(App.Placement(hit[1] - base, App.Rotation()))
+
+    def _show_picks(self):
+        """The picked elements stay highlighted."""
+        Gui.Selection.clearSelection()
+        for item in (self.a, self.b):
+            if item is None:
+                continue
+            pick = item[0]
+            try:
+                if pick.point is not None:
+                    Gui.Selection.addSelection(
+                        pick.root.Document.Name, pick.root.Name, pick.sub, pick.point.x, pick.point.y, pick.point.z
+                    )
+                else:
+                    Gui.Selection.addSelection(pick.root.Document.Name, pick.root.Name, pick.sub)
+            except Exception:
+                pass
+
+    def _set_candidates(self, candidates):
+        self.candidates = candidates
+        self.which.blockSignals(True)
+        self.which.clear()
+        if self.mode == "point" and self.objects:
+            names = ", ".join(m.obj.Label for m in candidates)
+            self.which.addItem(names)
+        else:
+            for i, m in enumerate(candidates):
+                text = m.obj.Label
+                if i > 0:
+                    text = tr("{} (the whole group)").format(text)
+                self.which.addItem(text)
+        self.which.setCurrentIndex(0)
+        self.which.setEnabled(len(candidates) > 1 and not (self.mode == "point" and self.objects))
+        self.which.blockSignals(False)
+
+    def _movable(self):
+        if not self.candidates:
+            return None
+        if self.mode == "point" and self.objects:
+            return self.candidates[0]
+        return self.candidates[max(0, self.which.currentIndex())]
+
+    def _movables(self):
+        if self.mode == "point" and self.objects:
+            return list(self.candidates)
+        m = self._movable()
+        return [m] if m is not None else []
+
+    # ------------------------------------------------------------------------- the move
+
+    def _apply(self, *args):
+        """Put the part where the picks and options say (from where it was, each time)."""
+        if self.closed:
+            return
+        self.transaction.abort()
+        self.move = None
+        self.message.setText("")
+        movables = self._movables()
+        attached = any(S.check_movable(m) == "attached" for m in movables)
+        self.attach_box.setVisible(attached)
+        if self.a is not None and self.b is not None and movables:
+            for m in movables:
+                problem = S.check_movable(m)
+                if problem in ("expression", "readonly"):
+                    self.message.setText(
+                        tr("{} cannot be moved here: its placement is set by a formula or locked").format(m.obj.Label)
+                    )
+                    self._update()
+                    return
+                if self.mode == "snap" and S.contains(m, self.b[0]):
+                    self.message.setText(
+                        tr("The target is inside {}: choose a smaller part to move").format(m.obj.Label)
+                    )
+                    self._update()
+                    return
+            try:
+                if self.mode == "snap":
+                    move = S.snap_move(
+                        self.a[1],
+                        self.b[1],
+                        flip=self.flip.isChecked(),
+                        gap=self.gap.value(),
+                        spin=self.angle.value(),
+                        align=self.align.currentData(),
+                    )
+                else:
+                    move = S.snap_move(self.a[1], self.b[1])
+            except S.SnapError as err:
+                self.message.setText(str(err))
+                self._update()
+                return
+            self.transaction.name = self._kind_title()
+            self.transaction.restart()
+            try:
+                targets = movables
+                if self.mode == "point" and self.copy.isChecked():
+                    targets = [S.copy_of(m, self.a[0] if not self.objects else None) for m in movables]
+                for m in targets:
+                    S.apply(m, move, self.attach_mode.currentData())
+                if self.mode == "point" and self.copy.isChecked():
+                    self.doc.recompute()
+            except Exception as err:
+                self.transaction.abort()
+                self.message.setText(str(err))
+                self._update()
+                return
+            self.move = move
+        self._update()
+
+    def _update(self):
+        self.step.setText(self._hint())
+        labels = []
+        if self.a is not None:
+            movables = self._movables()
+            moving = ", ".join(m.obj.Label for m in movables) or "-"
+            labels.append(tr("Moves: <b>{}</b>").format(moving))
+        if self.b is not None:
+            target = S.movable_candidates(self.b[0])
+            labels.append(tr("onto: <b>{}</b>").format(target[0].obj.Label if target else self.b[0].root.Label))
+        self.who.setText(" → ".join(labels))
+        self.swap_button.setEnabled(self.a is not None and self.b is not None and not self.objects)
+        self.who_row.setVisible(self.a is not None)
+        self.moving_row.setVisible(bool(self.candidates))
+        self.attach_box.setVisible(any(S.check_movable(m) == "attached" for m in self._movables()))
+        ready = self.a is not None and self.b is not None
+        if self.mode == "snap":
+            point = self.a is not None and self.a[1].kind == "point"
+            self.flip.setEnabled(ready and not point)
+            self.angle.setEnabled(ready and not point)
+            self.turn_left.setEnabled(ready and not point)
+            self.turn_right.setEnabled(ready and not point)
+            self.align.setEnabled(ready and not point)
+            self.gap.setEnabled(ready)
+            self.form.setWindowTitle(self._kind_title())
+        if self.picker is not None:
+            self.picker.snapping = self.mode == "point" or (self.point_first and self.a is None)
+            overlay = self.picker.overlay
+            if self.mode == "point":
+                overlay.show_point("base", self.a[1].pick if self.a and not self.b else None, "vertex")
+                if self.a is not None and self.b is None:
+                    if not overlay.ghost_transforms:
+                        overlay.set_ghosts(self._movables())
+                        overlay.move_ghosts(None)
+                else:
+                    overlay.clear_ghosts()
+                    overlay.show_line(None, None)
+                    if self.b is not None:
+                        overlay.show_point("snap", self.b[1].pick, "vertex")
+
+    def _turn(self, degrees):
+        value = self.angle.value() + degrees
+        while value > 180:
+            value -= 360
+        while value <= -180:
+            value += 360
+        self.angle.setValue(value)
+
+    def _swap(self):
+        if self.a is None or self.b is None:
+            return
+        self.transaction.abort()
+        self.move = None
+        a, b = self.b, self.a
+        try:
+            fa = self._feature(a[0], True)
+            fb = self._feature(b[0], False)
+        except S.SnapError as err:
+            self.message.setText(str(err))
+            return
+        self.a, self.b = (a[0], fa), (b[0], fb)
+        self._set_candidates(S.movable_candidates(a[0]))
+        self._show_picks()
+        self._apply()
+
+    def _again(self):
+        self.transaction.abort()
+        self.move = None
+        self.a = self.b = None
+        self.candidates = []
+        if self.objects:
+            self.candidates = self.objects
+        self.which.clear()
+        if self.picker:
+            self.picker.overlay.hide_all()
+        Gui.Selection.clearSelection()
+        self._update()
+
+    # ------------------------------------------------------------------------- closing
+
+    def _finish(self):
+        self.closed = True
+        if self.picker is not None:
+            self.picker.remove()
+            self.picker = None
+        Gui.Selection.clearSelection()
+
+    def accept(self):
+        if self.move is None:
+            if self.a is None or self.b is None:
+                self.message.setText(self._hint())
+            return False
+        self.transaction.commit()
+        self._finish()
+        Gui.Control.closeDialog()
+        return True
+
+    def reject(self):
+        self.transaction.abort()
+        self._finish()
+        Gui.Control.closeDialog()
+        return True
+
+    def _escape(self):
+        if not self.closed:
+            self.reject()
+
+
+def _show(panel):
+    if Gui.Control.activeDialog():
+        Gui.Control.closeDialog()
+    Gui.Control.showDialog(panel)
+
+
+# --- commands -----------------------------------------------------------------------------
+
+
+class _Command:
+    def IsActive(self):
+        return App.ActiveDocument is not None and _active_view() is not None and not Gui.Control.activeDialog()
+
+
+class SnapFacesCommand(_Command):
+    """くっつける: a face of one part against a face of another."""
+
+    kinds = ("faces",)
+    menu = QT_TRANSLATE_NOOP("Unified_SnapFaces", "Snap together")
+    tip = QT_TRANSLATE_NOOP(
+        "Unified_SnapFaces",
+        "Puts one part against another, face to face. Click a face of the part to move, then a face "
+        "of the other part (or pick both with Ctrl and press this). The first one moves",
+    )
+    context = "Unified_SnapFaces"
+    pixmap = "SnapFaces.svg"
+    accel = "J"
+
+    def GetResources(self):
+        return {
+            "Pixmap": os.path.join(HERE, self.pixmap),
+            "MenuText": self.menu,
+            "ToolTip": self.tip,
+            "Accel": self.accel,
+        }
+
+    def IsActive(self):
+        if not _Command.IsActive(self):
+            return False
+        picks = Gui.Selection.getSelectionEx("", 0)
+        count = sum(max(1, len(s.SubElementNames)) for s in picks)
+        if count < 2:
+            return True  # starts the tool; the panel asks for the picks
+        return classify_selection() in self.kinds
+
+    def Activated(self):
+        picks = selection_picks()
+        usable = []
+        if classify_selection() in self.kinds:
+            usable = picks
+        elif len(picks) == 1 and picks[0].element and not picks[0].element.startswith("Vertex"):
+            usable = picks
+        _show(SnapPanel("snap", usable, point_first=False))
+
+
+class SnapAxesCommand(SnapFacesCommand):
+    """軸をそろえる: round faces (a shaft and a hole) or circles on one axis."""
+
+    kinds = ("axes",)
+    menu = QT_TRANSLATE_NOOP("Unified_SnapAxes", "Line up the axes")
+    tip = QT_TRANSLATE_NOOP(
+        "Unified_SnapAxes",
+        "Puts a round part on the axis of another, e.g. a shaft into a hole. Click a round face or a "
+        "circle of the part to move, then one of the other part",
+    )
+    pixmap = "SnapAxes.svg"
+    accel = ""
+
+    def IsActive(self):
+        if not _Command.IsActive(self):
+            return False
+        count = sum(max(1, len(s.SubElementNames)) for s in Gui.Selection.getSelectionEx("", 0))
+        if count < 2:
+            return True
+        return classify_selection() in self.kinds
+
+
+class PointToFaceCommand(SnapFacesCommand):
+    """点を面に合わせる: a point of one part straight onto a face of another."""
+
+    kinds = ("point-face",)
+    menu = QT_TRANSLATE_NOOP("Unified_PointToFace", "Point onto a face")
+    tip = QT_TRANSLATE_NOOP(
+        "Unified_PointToFace",
+        "Moves a part straight (without turning it) until the picked point lies on the picked face. "
+        "Pick the point first, then the face",
+    )
+    pixmap = "PointToFace.svg"
+    accel = ""
+
+    def IsActive(self):
+        if not _Command.IsActive(self):
+            return False
+        count = sum(max(1, len(s.SubElementNames)) for s in Gui.Selection.getSelectionEx("", 0))
+        if count < 2:
+            return True
+        return classify_selection() in self.kinds
+
+    def Activated(self):
+        picks = selection_picks()
+        usable = picks if classify_selection() in self.kinds else []
+        _show(SnapPanel("snap", usable, point_first=True))
+
+
+class MovePointToPointCommand(_Command):
+    """点から点へ動かす: like Draft's move, with snapping, for parts and groups."""
+
+    def GetResources(self):
+        return {
+            "Pixmap": os.path.join(HERE, "MovePointToPoint.svg"),
+            "MenuText": QT_TRANSLATE_NOOP("Unified_MovePointToPoint", "Move point to point"),
+            "ToolTip": QT_TRANSLATE_NOOP(
+                "Unified_MovePointToPoint",
+                "Moves parts without turning them: click the point to move (it snaps to vertices, middles "
+                "of edges, centers of circles and faces), then where it goes. Hold Ctrl for a copy",
+            ),
+            "Accel": "Shift+M",
+        }
+
+    def IsActive(self):
+        if not _Command.IsActive(self):
+            return False
