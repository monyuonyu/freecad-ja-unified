+        # The candidates' global placements are where FreeCAD puts them
+        self.assertTrue(cands[0].global_placement().isSame(body.getGlobalPlacement(), 1e-9))
+        self.assertTrue(cands[1].global_placement().isSame(inner.getGlobalPlacement(), 1e-9))
+        p = App.Vector(pa.point)
+        movable, move, _, _ = self.snap(pa, pb)
+        self.assertIs(movable.obj, body)
+        self.assertFacesTouch(pa, pb)
