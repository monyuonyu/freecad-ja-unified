@@ -0,0 +1,1105 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+# "Snap together" (くっつける), "line up the axes" (軸をそろえる), "point onto a face"
+# (点を面に合わせる) and "move point to point" (点から点へ動かす): putting parts against each
+# other with clicks only, without the Placement dialog, attachment or assembly joints.
+#
+# Two ways in:
+#  - pick two things (Ctrl+click) and press the button on the context bar: the first one moves
+#    onto the second one;
+#  - or start the tool and click in the view: it says what to click next.
+# The part moves right away (preview); the task panel changes how it sits; OK keeps it (one
+# undo step), Cancel or Esc puts it back. The geometry is in SnapMath.py.
+
+import os
+
+import FreeCAD as App
+import FreeCADGui as Gui
+from PySide import QtCore, QtGui, QtWidgets
+
+import SnapMath as S
+
+translate = App.Qt.translate
