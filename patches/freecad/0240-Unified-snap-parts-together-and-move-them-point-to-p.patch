+        elements = [n for s in sel for n in s.SubElementNames]
+        if len(elements) == 2 and all(s.SubElementNames for s in sel):
+            return _cached("points", lambda: S.both_points(selection_picks()))
+        return True
+
+    def Activated(self):
+        picks = selection_picks()
+        objects = []
+        usable = []
+        if len(picks) == 2 and S.both_points(picks):
+            usable = picks
+        elif picks and all(not p.element for p in picks):
+            # Whole parts picked (in the tree, or as objects): they move together
+            for p in picks:
+                cands = S.movable_candidates(p)
+                if cands and all(c.obj != cands[0].obj for c in objects):
