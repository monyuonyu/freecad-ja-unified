diff --git a/src/Mod/Unified/Gui/ContextBar.cpp b/src/Mod/Unified/Gui/ContextBar.cpp
index 7934f9883..fced6e3fe 100644
--- a/src/Mod/Unified/Gui/ContextBar.cpp
+++ b/src/Mod/Unified/Gui/ContextBar.cpp
@@ -189,10 +189,27 @@ std::vector<ContextBar::Action> ContextBar::actionsForSelection() const
         bool edgesOnly = std::all_of(selection.begin(), selection.end(), [](const auto& s) {
             return allStartWith(s.getSubNames(), "Edge");
         });
+        std::vector<Action> actions;
+        // Two things picked on two parts, one after the other: the first one moves onto the
+        // second one. Which of these fit (two flat faces, two round faces or circles, a point
+        // and a face, two points) the commands decide; the others are not shown.
+        bool twoPicks = selection.size() == 2
+            && std::all_of(selection.begin(), selection.end(), [](const auto& s) {
+                   return s.getSubNames().size() == 1;
+               });
+        if (twoPicks) {
+            actions = {
+                {"Unified_SnapFaces", label("Snap")},
+                {"Unified_SnapAxes", label("Line up axes")},
+                {"Unified_PointToFace", label("Point onto face")},
+                {"Unified_MovePointToPoint", label("Point to point")},
+            };
+        }
         if (edgesOnly) {
-            return {{"PartDesign_Fillet", label("Fillet")}, {"PartDesign_Chamfer", label("Chamfer")}};
+            actions.push_back({"PartDesign_Fillet", label("Fillet")});
+            actions.push_back({"PartDesign_Chamfer", label("Chamfer")});
         }
-        return {};
+        return actions;
     }
 
     const auto& sel = selection.front();
@@ -220,16 +237,31 @@ std::vector<ContextBar::Action> ContextBar::actionsForSelection() const
             {"PartDesign_Pocket", label("Cut in")},
             {"Unified_Hole", label("Hole")},
             {"PartDesign_Thickness", label("Shell")},
+            // Put this part against another one: the next face clicked is where it goes
+            {"Unified_SnapFaces", label("Snap")},
         };
     }
     if (allStartWith(subs, "Edge")) {
-        return {{"PartDesign_Fillet", label("Fillet")}, {"PartDesign_Chamfer", label("Chamfer")}};
+        return {
+            {"PartDesign_Fillet", label("Fillet")},
+            {"PartDesign_Chamfer", label("Chamfer")},
+            {"Unified_MovePointToPoint", label("Point to point")},
+        };
+    }
+    if (allStartWith(subs, "Vertex")) {
+        // From this point to the next one clicked
+        return {{"Unified_MovePointToPoint", label("Point to point")}};
     }
     if (!subs.empty()) {
         return {};
     }
-    if (isDerivedFrom(obj, "Part::Feature") || isDerivedFrom(obj, "PartDesign::Body")) {
-        return {{"Std_TransformManip", label("Move")}, {"Std_ToggleVisibility", label("Hide")}};
+    if (isDerivedFrom(obj, "Part::Feature") || isDerivedFrom(obj, "PartDesign::Body")
+        || isDerivedFrom(obj, "App::Part") || isDerivedFrom(obj, "App::Link")) {
+        return {
+            {"Std_TransformManip", label("Move")},
+            {"Unified_MovePointToPoint", label("Point to point")},
+            {"Std_ToggleVisibility", label("Hide")},
+        };
     }
     return {};
 }
