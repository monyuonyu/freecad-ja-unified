+class _Transaction:
+    """The preview is made in an open transaction: Cancel aborts it, OK commits it (one undo
+    step). Each change of an option aborts and redoes the move from the start."""
+
+    def __init__(self, doc, name):
+        self.doc = doc
+        self.name = name
+        self.open = False
+
+    def restart(self):
+        self.abort()
+        self.doc.openTransaction(self.name)
+        self.open = True
+
+    def abort(self):
+        if self.open:
+            self.open = False
+            self.doc.abortTransaction()
+
+    def commit(self):
+        if self.open:
+            self.open = False
+            self.doc.recompute()
+            self.doc.commitTransaction()
+
+
+def _bold(label):
+    font = label.font()
+    font.setBold(True)
+    label.setFont(font)
+    return label
