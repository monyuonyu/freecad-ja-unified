+        # Moving the outer container instead gives the same result for the picked face
+        S.restore(movable)
+        self.doc.recompute()
+        S.apply(cands[2], move)
+        self.doc.recompute()
+        self.assertFacesTouch(pa, pb)
+        self.assertVec(body.Placement.Base, App.Vector(1, 2, 3))
