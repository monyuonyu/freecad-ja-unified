+        b = self.box("B", placement=App.Placement(App.Vector(0, 40, 0), App.Rotation(App.Vector(0, 1, 0), 20)))
+        self.doc.recompute()
+        top = max(range(len(imported.Shape.Faces)), key=lambda i: imported.Shape.Faces[i].CenterOfMass.z)
+        sub = sub.replace("Face6", "Face%d" % (top + 1))
+        pa, pb = _pick(root, sub), _pick(b, "Face3")
+        self.snap(pa, pb)
+        self.assertFacesTouch(pa, pb)
