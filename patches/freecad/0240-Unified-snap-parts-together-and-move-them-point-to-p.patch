+class SnapPanel:
+    """Task panel for both tools.
+
+    mode "snap": the first pick (a face, a round face or a circle; a point for "point onto
+    face") moves its part onto the second pick.
+    mode "point": the moving parts go from the base point to the destination point.
+    """
+
+    def __init__(self, mode, picks=(), point_first=False, objects=()):
+        self.mode = mode
+        self.point_first = point_first or mode == "point"
+        self.doc = App.ActiveDocument
+        self.view = _active_view()
+        self.a = None  # (Pick, Feature) of what moves
+        self.b = None  # (Pick, Feature) of where it goes
+        self.candidates = []  # what can be moved for pick a (innermost first)
+        self.objects = list(objects)  # mode "point": whole objects picked before the tool
+        self.move = None
+        self.closed = False
+        self.transaction = _Transaction(self.doc, self._title())
+        self._build()
+        self.picker = Picker(self.view, self._clicked, self._escape, self._hover) if self.view else None
+        Gui.Selection.clearSelection()
+        # Picks made before the tool: use them
+        for pick in picks:
+            self._take(pick, pick.point, None, False, from_selection=True)
+        self._update()
+
+    # ------------------------------------------------------------------------- the widgets
+
+    def _title(self):
+        if self.mode == "point":
