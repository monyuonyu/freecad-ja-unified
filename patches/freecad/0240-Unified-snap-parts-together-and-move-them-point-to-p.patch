+    def test_shaft_into_hole(self):
+        plate = self.doc.addObject("Part::Box", "Plate")
+        plate.Length, plate.Width, plate.Height = 40, 40, 10
+        hole = self.doc.addObject("Part::Cylinder", "HoleTool")
+        hole.Radius, hole.Height = 5, 10
+        hole.Placement.Base = App.Vector(20, 20, 0)
+        cut = self.doc.addObject("Part::Cut", "Cut")
+        cut.Base, cut.Tool = plate, hole
+        cut.Placement = App.Placement(App.Vector(0, 0, 100), App.Rotation(App.Vector(1, 0, 0), 30))
+        shaft = self.doc.addObject("Part::Cylinder", "Shaft")
+        shaft.Radius, shaft.Height = 5, 30
+        shaft.Placement = App.Placement(App.Vector(-60, 3, 0), App.Rotation(App.Vector(0, 1, 0), 70))
+        self.doc.recompute()
+        hole_face = next(
+            "Face%d" % (i + 1) for i, f in enumerate(cut.Shape.Faces) if isinstance(f.Surface, Part.Cylinder)
+        )
+        pa = _pick(shaft, "Face1")
+        pb = _pick(cut, hole_face)
+        fa, fb = S.feature_of(pa), S.feature_of(pb)
+        self.assertEqual((fa.kind, fb.kind), ("axis", "axis"))
+        self.snap(pa, pb, align=S.ALIGN_CENTER)
+        fa = S.feature_of(S.Pick(shaft, "Face1"))
+        fb = S.feature_of(S.Pick(cut, hole_face))
+        self.assertAlmostEqual(abs(fa.direction.dot(fb.direction)), 1.0, places=6)
+        self.assertVec(fa.center, fb.center)
+        # The shaft is in the hole: it overlaps the plate in nothing
