@@ -0,0 +1,499 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+# The geometry behind "snap together" (くっつける) and "move point to point" (点から点へ動かす).
+#
+# No GUI here: what moves, where it goes, and how its Placement changes, all in global
+# coordinates. SnapToolsGui.py does the clicking; TestSnapMath.py tests this file headless.
+#
+# A pick is what the 3D view gives (and Gui.Selection.getSelectionEx("", 0)): the top-level
+# object, the path of names below it down to the element ("Part.Body.Pad.Face3") and the
+# picked point in global coordinates.
+
+import math
+
+import FreeCAD as App
+
+TOL = 1e-7
+
+
+class SnapError(Exception):
+    """A pick or a pair of picks that cannot be snapped; the message is for the user."""
+
+
+def _tr(text):
+    return App.Qt.translate("Unified_Snap", text)
+
+
+# --- picks and what they mean ------------------------------------------------------------
+
+
+class Pick:
+    """One pick: root object, path below it, and the picked point (global)."""
+
+    def __init__(self, root, sub, point=None):
+        self.root = root
+        self.sub = sub or ""
+        self.point = App.Vector(point) if point is not None else None
+
+    @property
+    def tokens(self):
+        # "Body.Pad.Face3" → ["Body", "Pad"] (objects) and "Face3" (element)
+        return self.sub.split(".")[:-1]
+
+    @property
+    def element(self):
+        return self.sub.split(".")[-1]
+
+    def objects(self):
+        """[root, ..., the object that owns the element]."""
+        objs = self.root.getSubObjectList(self.sub)
+        return list(objs) if objs else [self.root]
+
+    def shape(self):
+        """The picked element in global coordinates (None for a whole object)."""
+        if not self.element:
+            return None
+        try:
+            shape = self.root.getSubObject(self.sub)
+        except Exception:
+            return None
+        if shape is None or shape.isNull():
+            return None
+        return shape
+
+    def owner(self):
+        return self.objects()[-1]
+
+    def __repr__(self):
+        return "Pick({}, {!r})".format(self.root.Name, self.sub)
+
+
+class Feature:
+    """What a picked element means for snapping.
+
+    kind "plane": a flat face; direction is its outward normal.
+    kind "axis": a round face or a circle; direction is the axis (its sign means nothing).
+    kind "point": a point (a vertex, the middle of an edge, the center of a circle).
+    """
+
+    def __init__(self, kind, direction=None, pick=None, center=None, label=""):
+        self.kind = kind
+        self.direction = App.Vector(direction) if direction is not None else None
+        if self.direction is not None:
+            self.direction.normalize()
+        self.pick = App.Vector(pick) if pick is not None else None
+        self.center = App.Vector(center) if center is not None else self.pick
+        if self.pick is None:
+            self.pick = self.center
+        self.label = label
+
+    def transformed(self, placement):
+        """The same feature after the part moved by the global placement."""
+        direction = placement.Rotation.multVec(self.direction) if self.direction is not None else None
+        return Feature(self.kind, direction, placement.multVec(self.pick), placement.multVec(self.center), self.label)
+
+    def __repr__(self):
+        return "Feature({}, dir={}, pick={}, center={})".format(
+            self.kind, self.direction, self.pick, self.center
+        )
+
+
+def _on_axis(point, origin, direction):
+    return origin + direction * (point - origin).dot(direction)
+
+
+def _is_plane(surface):
+    import Part
+
+    return isinstance(surface, Part.Plane)
+
+
+def _is_cylinder(surface):
+    import Part
+
+    return isinstance(surface, Part.Cylinder)
+
+
+def _circle_of(edge):
+    import Part
+
+    curve = edge.Curve
+    if isinstance(curve, (Part.Circle, Part.ArcOfCircle)):
+        return curve
+    return None
+
+
+def face_feature(face, point=None):
+    """The meaning of a face for "snap together": flat → plane, cylindrical → axis."""
+    surface = face.Surface
+    center = face.CenterOfMass
+    if _is_plane(surface):
+        at = point if point is not None else center
+        try:
+            u, v = face.Surface.parameter(at)
+            normal = face.normalAt(u, v)
+        except Exception:
+            normal = surface.Axis
+            if face.Orientation == "Reversed":
+                normal = -normal
+        # The point on the face's plane (a picked point lies on it up to the pick's accuracy)
+        pick = at - normal * (at - center).dot(normal)
+        return Feature("plane", normal, pick, center, "plane")
+    if _is_cylinder(surface):
+        axis = App.Vector(surface.Axis)
+        axis.normalize()
+        origin = App.Vector(surface.Center)
+        on_axis_center = _on_axis(center, origin, axis)
+        pick = _on_axis(point, origin, axis) if point is not None else on_axis_center
+        return Feature("axis", axis, pick, on_axis_center, "cylinder")
+    raise SnapError(_tr("Pick a flat face or a round (cylindrical) face"))
+
+
+def point_of(shape, point=None):
+    """A point for "move point to point" from a picked vertex, edge or face.
+
+    A vertex is the point. A circle (or arc) is its center. Another edge gives the end or the
+    middle nearest to where it was clicked. A face gives the clicked point (or its center).
+    """
+    if shape.ShapeType == "Vertex":
+        return App.Vector(shape.Point), "vertex"
+    if shape.ShapeType == "Edge":
+        circle = _circle_of(shape)
+        if circle is not None:
+            return App.Vector(circle.Center), "center"
+        candidates = [(App.Vector(v.Point), "vertex") for v in shape.Vertexes]
+        first, last = shape.ParameterRange
+        candidates.append((shape.valueAt((first + last) / 2), "midpoint"))
+        if point is None:
+            return candidates[-1]
+        return min(candidates, key=lambda c: (c[0] - point).Length)
+    if shape.ShapeType == "Face":
+        if point is not None:
+            return App.Vector(point), "face"
+        return App.Vector(shape.CenterOfMass), "face center"
+    raise SnapError(_tr("Pick a point, an edge or a face"))
+
+
+def feature_of(pick, want=None):
+    """The Feature of a pick. want: "point" to read it as a point, else plane/axis/point."""
+    shape = pick.shape()
+    if shape is None:
+        raise SnapError(_tr("Pick a face, an edge or a point of the part"))
+    if shape.ShapeType == "Face" and want != "point":
+        return face_feature(shape, pick.point)
+    if shape.ShapeType == "Edge" and want != "point":
+        circle = _circle_of(shape)
+        if circle is not None:
+            axis = App.Vector(circle.Axis)
+            return Feature("axis", axis, circle.Center, circle.Center, "circle")
+    p, label = point_of(shape, pick.point)
+    return Feature("point", None, p, p, label)
+
+
+# --- what moves ----------------------------------------------------------------------------
+
+
+def _is_link(obj):
+    try:
+        return obj.getLinkedObject(True) != obj
+    except Exception:
+        return False
+
+
+def _in_body(obj):
+    parent = obj.getParentGeoFeatureGroup() if hasattr(obj, "getParentGeoFeatureGroup") else None
+    return parent is not None and parent.isDerivedFrom("PartDesign::Body")
+
+
+def _placeable(obj):
+    if not hasattr(obj, "Placement") or obj.isDerivedFrom("App::Origin"):
+        return False
+    if obj.isDerivedFrom("App::DatumElement") or obj.isDerivedFrom("App::OriginFeature"):
+        return False
+    # A step of a PartDesign body moves with its body, not on its own
+    if obj.isDerivedFrom("PartDesign::Feature") or (_in_body(obj) and not obj.isDerivedFrom("PartDesign::Body")):
+        return False
+    return True
+
+
+class Movable:
+    """An object to move, with the placement of what contains it (global), remembered as it
+    was when the tool started, so that each preview starts from the same place."""
+
+    def __init__(self, obj, parent_placement, depth=0):
+        self.obj = obj
+        self.parent = App.Placement(parent_placement)
+        self.depth = depth  # 0: top-level
+        self.placement = App.Placement(obj.Placement)
+        self.offset = App.Placement(obj.AttachmentOffset) if hasattr(obj, "AttachmentOffset") else None
+
+    def global_placement(self):
+        return self.parent.multiply(self.placement)
+
+    def local_for(self, move):
+        """The object's own Placement after the global move `move`."""
+        return self.parent.inverse().multiply(move).multiply(self.parent).multiply(self.placement)
+
+    def __repr__(self):
+        return "Movable({})".format(self.obj.Name)
+
+
+def _global_of_path(root, tokens):
+    """Global placement of the object at the end of `tokens` below root (including its own)."""
+    if not tokens:
+        placement = root.getSubObject("", 3)
+        if placement is None:
+            placement = App.Placement(root.Placement) if hasattr(root, "Placement") else App.Placement()
+        parent = root.getParentGeoFeatureGroup() if hasattr(root, "getParentGeoFeatureGroup") else None
+        if parent is not None:
+            placement = parent.getGlobalPlacement().multiply(placement)
+        return placement
+    root_parent = root.getParentGeoFeatureGroup() if hasattr(root, "getParentGeoFeatureGroup") else None
+    placement = root.getSubObject(".".join(tokens) + ".", 3)
+    if root_parent is not None:
+        placement = root_parent.getGlobalPlacement().multiply(placement)
+    return placement
+
+
+def movable_candidates(pick):
+    """What can be moved for this pick, innermost first: the part the element belongs to
+    (a Body, a shape, a link), then the containers around it (App::Part, groups of an
+    import). Nothing inside a link: that belongs to the linked object."""
+    objs = pick.objects()
+    tokens = pick.tokens
+    # Only down to the first link: what is below it is shared with the linked object
+    last = len(objs) - 1
+    for i, obj in enumerate(objs):
+        if i < len(objs) - 1 and _is_link(obj):
+            last = i
+            break
+    # The owner of the element may be a step of a body picked on its own: add the body
+    owner = objs[-1]
+    extra = []
+    if last == len(objs) - 1 and _in_body(owner):
+        body = owner.getParentGeoFeatureGroup()
+        if body not in objs:
+            extra.append(body)
+    result = []
+    for body in extra:
+        result.append(Movable(body, body.getGlobalPlacement().multiply(body.Placement.inverse()), len(objs)))
+    for i in range(last, -1, -1):
+        obj = objs[i]
+        if not _placeable(obj):
+            continue
+        parent = _global_of_path(pick.root, tokens[: i - 1]) if i >= 1 else None
+        if i == 0:
+            g = _global_of_path(pick.root, [])
+            parent = g.multiply(App.Placement(obj.Placement).inverse())
+        result.append(Movable(obj, parent, i))
+    return result
+
+
+def check_movable(movable):
+    """None if the object can be moved freely; else "attached" or "expression" or "readonly"."""
+    obj = movable.obj
+    for path, _ in getattr(obj, "ExpressionEngine", []):
+        if path.lstrip(".").startswith("Placement"):
+            return "expression"
+    # An attached object's Placement is read-only: it is moved through its offset
+    if is_attached(obj):
+        return "attached"
+    if "ReadOnly" in obj.getPropertyStatus("Placement"):
+        return "readonly"
+    return None
+
+
+def is_attached(obj):
+    return (
+        hasattr(obj, "MapMode")
+        and obj.MapMode != "Deactivated"
+        and bool(getattr(obj, "AttachmentSupport", None))
+    )
+
+
+def contains(movable, pick):
+    """Whether the picked element moves with `movable` (then it cannot be the target)."""
+    return movable.obj in pick.objects() or (
+        _in_body(pick.owner()) and pick.owner().getParentGeoFeatureGroup() == movable.obj
+    )
+
+
+# --- the moves ----------------------------------------------------------------------------
+
+
+def _rotation_between(a, b):
+    """The smallest rotation turning direction a into b; for opposite directions a half turn
+    about an axis across a (the one nearest to the global Z, X or Y: the same every time)."""
+    a = App.Vector(a).normalize()
+    b = App.Vector(b).normalize()
+    if a.dot(b) < -1 + 1e-12:
+        for helper in (App.Vector(0, 0, 1), App.Vector(1, 0, 0), App.Vector(0, 1, 0)):
+            axis = a.cross(helper)
+            if axis.Length > 1e-6:
+                return App.Rotation(axis.normalize(), 180)
+    return App.Rotation(a, b)
+
+
+def _move(rotation, source, target):
+    """The global placement that turns by `rotation` about `source` and puts it at `target`."""
+    return App.Placement(target - rotation.multVec(source), rotation)
+
+
+ALIGN_PICKED = "picked"
+ALIGN_CENTER = "center"
+ALIGN_KEEP = "keep"
+
+
+def snap_move(a, b, flip=False, gap=0.0, spin=0.0, align=ALIGN_PICKED):
+    """The global move that puts feature a (on the moving part) onto feature b.
+
+    plane on plane: the faces touch, facing each other (flip: same direction, e.g. two top
+    faces flush); gap keeps them apart; spin turns about the normal (degrees); align puts the
+    picked points or the centers together, or keeps the position along the face.
+    axis on axis (round faces, circles): the axes become one (a shaft in a hole); the turn
+    is the smaller one unless flip; gap moves along the axis; spin turns about the axis.
+    point on plane: the point goes straight onto the plane (orientation kept).
+    point on point: a plain move.
+    """
+    kinds = (a.kind, b.kind)
+    if kinds == ("plane", "plane"):
+        target = b.direction if flip else -b.direction
+        rotation = App.Rotation(b.direction, spin).multiply(_rotation_between(a.direction, target))
+        source = a.center if align == ALIGN_CENTER else a.pick
+        if align == ALIGN_CENTER:
+            dest = b.center
+        elif align == ALIGN_KEEP:
+            dest = source + b.direction * (b.pick - source).dot(b.direction)
+        else:
+            dest = b.pick
+        return _move(rotation, source, dest + b.direction * gap)
+    if kinds == ("axis", "axis"):
+        same = a.direction.dot(b.direction) >= 0
+        target = b.direction if same != flip else -b.direction
+        rotation = App.Rotation(b.direction, spin).multiply(_rotation_between(a.direction, target))
+        source = a.center if align == ALIGN_CENTER else a.pick
+        if align == ALIGN_CENTER:
+            dest = b.center
+        elif align == ALIGN_KEEP:
+            dest = _on_axis(source, b.pick, b.direction)
+        else:
+            dest = b.pick
+        return _move(rotation, source, dest + target * gap)
+    if kinds == ("point", "plane"):
+        n = b.direction
+        return App.Placement(n * ((b.pick - a.pick).dot(n) + gap), App.Rotation())
+    if kinds == ("point", "point"):
+        return App.Placement(b.pick - a.pick, App.Rotation())
+    if a.kind == "point" and b.kind == "axis":
+        dest = _on_axis(a.pick, b.pick, b.direction)
+        return App.Placement(dest - a.pick, App.Rotation())
+    raise SnapError(_tr("These two cannot be snapped together: pick two flat faces, two round faces, or two points"))
+
+
+def pair_kind(a, b):
+    """What the tool does with features a (moving) and b (target), for the labels."""
+    return {
+        ("plane", "plane"): "faces",
+        ("axis", "axis"): "axes",
+        ("point", "plane"): "point-face",
+        ("point", "point"): "points",
+        ("point", "axis"): "point-axis",
+    }.get((a.kind, b.kind))
+
+
+def _point_like(shape):
+    return shape is not None and shape.ShapeType in ("Vertex", "Edge")
+
+
+def both_points(picks):
+    """Two picks read as points (vertices, edges), the second not on what the first moves."""
+    if len(picks) != 2:
+        return False
+    a, b = picks
+    if not (_point_like(a.shape()) and _point_like(b.shape())):
+        return False
+    candidates = movable_candidates(a)
+    return bool(candidates) and not contains(candidates[0], b)
+
+
+def classify(picks):
+    """What two picks (first moves onto second) are for: "faces" (flat on flat), "axes"
+    (round faces or circles), "point-face", "points", or None."""
+    if len(picks) != 2:
+        return None
+    a, b = picks
+    sa, sb = a.shape(), b.shape()
+    if sa is None or sb is None:
+        return None
+    candidates = movable_candidates(a)
+    if not candidates or contains(candidates[0], b):
+        return None
+    ta, tb = sa.ShapeType, sb.ShapeType
+    try:
+        if ta == "Face" and tb == "Face":
+            return pair_kind(face_feature(sa, a.point), face_feature(sb, b.point))
+        if ta == "Edge" and tb == "Edge" and _circle_of(sa) is not None and _circle_of(sb) is not None:
+            return "axes"
+        if _point_like(sa) and _point_like(sb):
+            return "points"
+        if _point_like(sa) and tb == "Face":
+            kind = face_feature(sb, b.point).kind
+            return "point-face" if kind == "plane" else None
+    except SnapError:
+        return None
+    return None
+
+
+def apply(movable, move, attachment="offset"):
+    """Move the object by the global placement `move` (from where it was when the tool
+    started). An attached object keeps its attachment and gets a new offset
+    (attachment="offset"), or is detached first ("detach")."""
+    obj = movable.obj
+    local = movable.local_for(move)
+    if is_attached(obj):
+        if attachment == "detach":
+            obj.MapMode = "Deactivated"
+        else:
+            # Placement = (where the attachment puts it) * offset: keep the first, change the second
+            obj.AttachmentOffset = movable.offset.multiply(movable.placement.inverse()).multiply(local)
+    obj.Placement = local
+
+
+def restore(movable):
+    obj = movable.obj
+    obj.Placement = movable.placement
+    if movable.offset is not None and hasattr(obj, "AttachmentOffset"):
+        obj.AttachmentOffset = movable.offset
+
+
+def copy_of(movable, pick=None):
+    """A copy of the object, in the same container, at the same place (for "move a copy")."""
+    obj = movable.obj
+    doc = obj.Document
+    deep = obj.isDerivedFrom("PartDesign::Body") or obj.isDerivedFrom("App::Part")
+    new = doc.copyObject(obj, deep)
+    container = None
+    if pick is not None and movable.depth >= 1:
+        objs = pick.objects()
+        if movable.depth - 1 < len(objs):
+            container = objs[movable.depth - 1]
+    elif hasattr(obj, "getParentGeoFeatureGroup"):
+        container = obj.getParentGeoFeatureGroup()
+    if container is None:
+        for parent in obj.InList:
+            if parent.isDerivedFrom("App::DocumentObjectGroup") and obj in parent.Group:
+                container = parent
+    if container is not None and container.Document == doc and hasattr(container, "addObject"):
+        container.addObject(new)
+    copy = Movable(new, movable.parent, movable.depth)
+    copy.placement = App.Placement(movable.placement)
+    copy.offset = App.Placement(movable.offset) if movable.offset is not None else None
+    return copy
+
+
+def describe(movable):
+    return movable.obj.Label
+
+
+def angle_between(a, b):
+    """Degrees between two directions (for messages and tests)."""
+    return math.degrees(App.Vector(a).getAngle(App.Vector(b)))
