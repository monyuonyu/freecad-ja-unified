+class Overlay:
+    """Markers, the rubber band and the ghost of the part that moves, drawn over the view."""
+
+    COLORS = {
+        "snap": (1.0, 0.45, 0.0),
+        "base": (0.1, 0.65, 0.2),
+    }
+    MARKERS = {
+        "vertex": "SQUARE_LINE",
+        "midpoint": "DIAMOND_FILLED",
+        "center": "CIRCLE_LINE",
+        "face center": "CIRCLE_FILLED",
+        "face": "CROSS",
+        "edge": "CROSS",
+    }
+
+    def __init__(self, view):
+        coin = _coin()
+        self.view = view
+        self.root = coin.SoSeparator()
+        style = coin.SoPickStyle()
+        style.style = coin.SoPickStyle.UNPICKABLE
+        self.root.addChild(style)
+        # Hidden with a switch, not moved far away: that would spoil the depth of the view
+        self.ghost_switch = coin.SoSwitch()
+        self.ghosts = coin.SoSeparator()
+        self.ghost_switch.addChild(self.ghosts)
+        self.ghost_switch.whichChild = -1
+        self.root.addChild(self.ghost_switch)
+        top = coin.SoAnnotation()
+        self.root.addChild(top)
+        self.points = {}
+        for name, color in self.COLORS.items():
+            sep = coin.SoSeparator()
+            mat = coin.SoBaseColor()
+            mat.rgb = color
+            coords = coin.SoCoordinate3()
+            marker = coin.SoMarkerSet()
+            switch = coin.SoSwitch()
+            sep.addChild(mat)
+            sep.addChild(coords)
+            sep.addChild(marker)
+            switch.addChild(sep)
+            switch.whichChild = -1
+            top.addChild(switch)
+            self.points[name] = (switch, coords, marker)
+        # The rubber band from the base point to the cursor
+        self.line_switch = coin.SoSwitch()
+        line = coin.SoSeparator()
+        color = coin.SoBaseColor()
+        color.rgb = self.COLORS["base"]
+        draw = coin.SoDrawStyle()
+        draw.lineWidth = 2
+        draw.linePattern = 0x0F0F
+        self.line_coords = coin.SoCoordinate3()
+        line.addChild(color)
+        line.addChild(draw)
+        line.addChild(self.line_coords)
+        line.addChild(coin.SoLineSet())
+        self.line_switch.addChild(line)
+        self.line_switch.whichChild = -1
+        top.addChild(self.line_switch)
+        self.ghost_transforms = []
+        view.getSceneGraph().addChild(self.root)
+
+    def show_point(self, name, point, kind="vertex"):
+        switch, coords, marker = self.points[name]
+        if point is None:
+            switch.whichChild = -1
+            return
+        coords.point.setValue(tuple(point))
+        marker.markerIndex = Gui.getMarkerIndex(self.MARKERS.get(kind, "CROSS"), 11)
+        switch.whichChild = 0
+
+    def show_line(self, a, b):
+        if a is None or b is None:
+            self.line_switch.whichChild = -1
+            return
+        self.line_coords.point.setValues(0, 2, [tuple(a), tuple(b)])
+        self.line_switch.whichChild = 0
+
+    def set_ghosts(self, movables):
+        """Copies of the parts that move, drawn where they would go (see move_ghosts)."""
+        coin = _coin()
+        self.ghosts.removeAllChildren()
+        self.ghost_transforms = []
+        for m in movables:
+            vo = getattr(m.obj, "ViewObject", None)
+            if vo is None:
+                continue
+            sep = coin.SoSeparator()
+            move = coin.SoTransform()
+            sep.addChild(move)
+            try:
+                node = vo.RootNode.copy()
+            except Exception:
+                continue
+            # The copy has the part's own placement; the containers around it are added in
+            # front of it (move_ghosts). No search actions here: paths kept from them are freed
+            # twice. One see-through color, overriding the copy's materials.
+            look = coin.SoMaterial()
+            look.diffuseColor.setValue(1.0, 0.6, 0.1)
+            look.transparency.setValue(0.55)
+            look.setOverride(True)
+            sep.addChild(look)
+            sep.addChild(node)
+            self.ghosts.addChild(sep)
+            self.ghost_transforms.append((move, m))
+
+    def move_ghosts(self, move):
+        if move is None:
+            self.ghost_switch.whichChild = -1
+            return
+        self.ghost_switch.whichChild = 0
+        for node, m in self.ghost_transforms:
+            _set_transform(node, move.multiply(m.parent))
+
+    def clear_ghosts(self):
+        self.ghost_switch.whichChild = -1
+        self.ghosts.removeAllChildren()
+        self.ghost_transforms = []
+
+    def hide_all(self):
+        for name in self.points:
+            self.show_point(name, None)
+        self.show_line(None, None)
+        self.clear_ghosts()
+
+    def remove(self):
+        try:
+            self.view.getSceneGraph().removeChild(self.root)
+        except Exception:
+            pass
+
+
+def snap_points(shape, picked):
+    """The points to snap to on a picked element, with their kind."""
+    import Part
+
+    out = []
+    if shape.ShapeType == "Vertex":
+        return [(App.Vector(shape.Point), "vertex")]
+    edges = [shape] if shape.ShapeType == "Edge" else shape.Edges
+    for edge in edges:
+        for v in edge.Vertexes:
+            out.append((App.Vector(v.Point), "vertex"))
+        circle = S._circle_of(edge)
+        if circle is not None:
+            out.append((App.Vector(circle.Center), "center"))
+        elif not edge.isClosed():
+            first, last = edge.ParameterRange
+            out.append((edge.valueAt((first + last) / 2), "midpoint"))
+    if shape.ShapeType == "Face":
+        out.append((App.Vector(shape.CenterOfMass), "face center"))
+    if shape.ShapeType == "Edge" and picked is not None:
+        try:
+            nearest = shape.distToShape(Part.Vertex(picked))[1][0][0]
+            out.append((App.Vector(nearest), "edge"))
+        except Exception:
+            pass
+    return out
+
+
+SNAP_NAMES = {
+    "vertex": QT_TRANSLATE_NOOP("Unified_Snap", "Vertex"),
+    "midpoint": QT_TRANSLATE_NOOP("Unified_Snap", "Middle of the edge"),
+    "center": QT_TRANSLATE_NOOP("Unified_Snap", "Center of the circle"),
+    "face center": QT_TRANSLATE_NOOP("Unified_Snap", "Center of the face"),
+    "face": QT_TRANSLATE_NOOP("Unified_Snap", "On the face"),
+    "edge": QT_TRANSLATE_NOOP("Unified_Snap", "On the edge"),
+}
+
+
+class Picker:
+    """Clicks and the cursor in the 3D view while a tool runs. Left clicks go to the tool and
+    do not change the selection; Esc cancels. With snapping on, the point under the cursor
+    snaps to vertices, middles of edges, centers of circles and faces."""
+
+    def __init__(self, view, on_click, on_escape, on_hover=None):
+        coin = _coin()
+        self.view = view
+        self.on_click = on_click
+        self.on_escape = on_escape
+        self.on_hover = on_hover
+        self.snapping = False
+        self.overlay = Overlay(view)
+        self._cache = {}
+        self._callbacks = [
+            (coin.SoMouseButtonEvent.getClassTypeId(), view.addEventCallbackPivy(coin.SoMouseButtonEvent.getClassTypeId(), self._button)),
+            (coin.SoLocation2Event.getClassTypeId(), view.addEventCallbackPivy(coin.SoLocation2Event.getClassTypeId(), self._moved)),
+            (coin.SoKeyboardEvent.getClassTypeId(), view.addEventCallbackPivy(coin.SoKeyboardEvent.getClassTypeId(), self._key)),
+        ]
+        self.last = None  # (pick, point, kind) under the cursor
+
+    def remove(self):
+        for type_id, cb in self._callbacks:
+            try:
+                self.view.removeEventCallbackPivy(type_id, cb)
+            except Exception:
+                pass
+        self._callbacks = []
+        self.overlay.remove()
+        QtWidgets.QToolTip.hideText()
+
+    def element_at(self, pos):
+        """(Pick, picked point) under the cursor, or None."""
+        info = self.view.getObjectInfo(pos)
+        if not info:
+            return None
+        # Inside a container (App::Part, Body, link): the top-level object and the path below
+        # it. A top-level object: the object and the element.
+        root = info.get("ParentObject")
+        sub = info.get("SubName")
+        if root is None or not sub:
+            try:
+                root = App.getDocument(info["Document"]).getObject(info["Object"])
+            except Exception:
+                return None
+            sub = info.get("Component")
+        if root is None or not sub:
+            return None
+        point = App.Vector(info["x"], info["y"], info["z"])
+        return S.Pick(root, sub, point)
+
+    def snapped(self, pos):
+        """(Pick, snapped point, kind) under the cursor."""
+        pick = self.element_at(pos)
+        if pick is None:
+            return None
+        key = (pick.root.Document.Name, pick.root.Name, pick.sub)
+        points = self._cache.get(key)
+        if points is None:
+            shape = pick.shape()
+            if shape is None:
+                return None
+            points = snap_points(shape, None) if shape.ShapeType != "Edge" else None
+            if points is not None:
+                if len(self._cache) > 200:
+                    self._cache.clear()
+                self._cache[key] = points
+        if points is None:  # an edge: the nearest point on it depends on the cursor
+            points = snap_points(pick.shape(), pick.point)
+        best, best_d = None, SNAP_RADIUS
+        for p, kind in points:
+            if kind == "edge":
+                continue
+            x, y = self.view.getPointOnScreen(p)
+            d = ((x - pos[0]) ** 2 + (y - pos[1]) ** 2) ** 0.5
+            if d < best_d:
+                best, best_d = (p, kind), d
+        if best is None:
+            shape_type = pick.element[:4]
+            best = (pick.point, "edge" if shape_type == "Edge" else "face")
+        return pick, best[0], best[1]
+
+    def _moved(self, cb):
+        ev = cb.getEvent()
+        pos = tuple(ev.getPosition().getValue())
+        if not self.snapping:
+            if self.on_hover:
+                self.on_hover(None)
+            return
+        hit = self.snapped(pos)
+        self.last = hit
+        if hit is None:
+            self.overlay.show_point("snap", None)
+            QtWidgets.QToolTip.hideText()
+        else:
+            self.overlay.show_point("snap", hit[1], hit[2])
+            QtWidgets.QToolTip.showText(
+                QtGui.QCursor.pos() + QtCore.QPoint(16, 8), translate("Unified_Snap", SNAP_NAMES[hit[2]])
+            )
+        if self.on_hover:
+            self.on_hover(hit)
+
+    def _button(self, cb):
+        coin = _coin()
+        ev = cb.getEvent()
+        if ev.getButton() != coin.SoMouseButtonEvent.BUTTON1:
+            return
+        # The tool takes the left clicks: no selection, no box selection
+        cb.setHandled()
+        if ev.getState() != coin.SoButtonEvent.DOWN:
+            return
+        pos = tuple(ev.getPosition().getValue())
+        ctrl = ev.wasCtrlDown()
+        if self.snapping:
+            hit = self.snapped(pos)
+            if hit is None:
+                return
+            pick, point, kind = hit
+            QtCore.QTimer.singleShot(0, lambda: self.on_click(pick, point, kind, ctrl))
+        else:
+            pick = self.element_at(pos)
+            if pick is None:
+                return
+            QtCore.QTimer.singleShot(0, lambda: self.on_click(pick, pick.point, None, ctrl))
+
+    def _key(self, cb):
+        coin = _coin()
+        ev = cb.getEvent()
+        if ev.getKey() == coin.SoKeyboardEvent.ESCAPE:
+            cb.setHandled()
+            if ev.getState() == coin.SoButtonEvent.DOWN:
+                QtCore.QTimer.singleShot(0, self.on_escape)
+
