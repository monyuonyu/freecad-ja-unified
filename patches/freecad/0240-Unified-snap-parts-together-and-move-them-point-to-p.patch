+++ b/src/Mod/Unified/CMakeLists.txt
@@ -18,6 +18,13 @@ if(BUILD_GUI)
     list(APPEND Unified_Scripts InitGui.py UnifiedCommands.py DesignCheckGui.py AIChatGui.py UnifiedPreferences.py AIChat.svg)
 endif(BUILD_GUI)
 
+# Snap together / move point to point: the geometry (SnapMath, tested headless by
+# "FreeCADCmd -t TestSnapMath") and the tools in the 3D view
+list(APPEND Unified_Scripts SnapMath.py TestSnapMath.py)
