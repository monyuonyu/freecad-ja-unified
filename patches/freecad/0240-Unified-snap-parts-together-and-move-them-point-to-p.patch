+def _valid_point(root, sub, point):
+    """The picked point, or None when it was not picked in the view (from the tree the point
+    is zero) or is not on the element."""
+    if point is None:
+        return None
+    try:
+        shape = root.getSubObject(sub) if sub.split(".")[-1] else None
+        if shape is None:
+            return None
+        tol = max(1e-3, shape.BoundBox.DiagonalLength * 1e-3)
+        if shape.distToShape(__import__("Part").Vertex(point))[0] > tol:
+            return None
+    except Exception:
+        return None
+    return App.Vector(point)
+
+
+def selection_picks():
+    """The picks in the order they were made (Gui.Selection keeps it)."""
+    picks = []
+    for sel in Gui.Selection.getSelectionEx("", 0):
+        names = list(sel.SubElementNames) or [""]
+        points = list(sel.PickedPoints)
+        for i, name in enumerate(names):
+            point = points[i] if i < len(points) else None
+            picks.append(S.Pick(sel.Object, name, _valid_point(sel.Object, name, point)))
+    return picks
+
+
+_classify_cache = {}
+
+
+def classify_selection():
+    """What two picked things are for: "faces", "axes", "point-face", "points" or None."""
+    key = tuple(
+        (s.Object.Name, s.Object.Document.Name, tuple(s.SubElementNames))
+        for s in Gui.Selection.getSelectionEx("", 0)
+    )
+    if key in _classify_cache:
+        return _classify_cache[key]
+    try:
+        result = S.classify(selection_picks())
+    except Exception:
+        result = None
+    if len(_classify_cache) > 50:
+        _classify_cache.clear()
+    _classify_cache[key] = result
+    return result
+
+
+def _cached(name, compute):
+    key = (name,) + tuple(
+        (s.Object.Name, s.Object.Document.Name, tuple(s.SubElementNames))
+        for s in Gui.Selection.getSelectionEx("", 0)
+    )
+    if key not in _classify_cache:
+        try:
+            _classify_cache[key] = compute()
+        except Exception:
+            _classify_cache[key] = None
+    return _classify_cache[key]
+
