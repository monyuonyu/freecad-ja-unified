+            ((c, "Edge3"), (d, "Edge2"), "axes"),
+            ((a, "Vertex1"), (b, "Face6"), "point-face"),
+            ((a, "Vertex1"), (b, "Vertex2"), "points"),
+            ((a, "Edge1"), (c, "Edge2"), "points"),
+            ((a, "Face1"), (c, "Face1"), None),  # flat and round
+            ((a, "Face1"), (a, "Face2"), None),  # the same part
