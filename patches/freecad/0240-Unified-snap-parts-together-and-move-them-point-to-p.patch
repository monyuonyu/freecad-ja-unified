+# SPDX-License-Identifier: LGPL-2.1-or-later
+# Tests of SnapMath (snap together / move point to point), headless:
+#   FreeCADCmd -t TestSnapMath
+
+import os
+import tempfile
+import unittest
+
+import FreeCAD as App
+import Part
+
+import SnapMath as S
+
+
+def _point_on(root, sub, fu=0.3, fv=0.6):
+    """A point on the picked face (global), away from its center."""
+    face = root.getSubObject(sub)
+    u0, u1, v0, v1 = face.ParameterRange
+    return face.valueAt(u0 + (u1 - u0) * fu, v0 + (v1 - v0) * fv)
+
+
+def _pick(root, sub, point=None, fu=0.3, fv=0.6):
+    if point is None and sub.split(".")[-1].startswith("Face"):
+        point = _point_on(root, sub, fu, fv)
+    return S.Pick(root, sub, point)
+
+
+class SnapMathTest(unittest.TestCase):
+    def setUp(self):
+        self.doc = App.newDocument("SnapMathTest")
+
+    def tearDown(self):
+        App.closeDocument(self.doc.Name)
+
+    # helpers -----------------------------------------------------------------------------
+
+    def box(self, name, size=(10, 20, 30), placement=None, container=None):
+        b = self.doc.addObject("Part::Box", name)
+        b.Length, b.Width, b.Height = size
+        if placement is not None:
+            b.Placement = placement
+        if container is not None:
+            container.addObject(b)
+        return b
+
+    def snap(self, a, b, **opts):
+        """Move the part of pick a so that a lands on b; returns (movable, move)."""
+        fa = S.feature_of(a)
+        fb = S.feature_of(b)
+        movable = S.movable_candidates(a)[0]
+        move = S.snap_move(fa, fb, **opts)
+        S.apply(movable, move)
+        self.doc.recompute()
+        return movable, move, fa, fb
+
+    def assertVec(self, a, b, tol=1e-6, msg=None):
+        self.assertLess((App.Vector(a) - App.Vector(b)).Length, tol, msg or "{} != {}".format(a, b))
+
+    def assertFacesTouch(self, a, b, facing=True, gap=0.0):
+        """Faces of picks a and b (re-read after the move) are coplanar and face each other."""
+        fa = S.feature_of(S.Pick(a.root, a.sub, None))
+        fb = S.feature_of(S.Pick(b.root, b.sub, None))
+        dot = fa.direction.dot(fb.direction)
+        self.assertAlmostEqual(dot, -1.0 if facing else 1.0, places=6)
+        # The plane of a lies at `gap` from the plane of b, on its outer side
+        self.assertAlmostEqual((fa.center - fb.center).dot(fb.direction), gap, places=6)
+
+    # plane on plane -----------------------------------------------------------------------
+
+    def test_boxes_face_to_face(self):
+        a = self.box("A")
+        b = self.box("B", placement=App.Placement(App.Vector(100, 50, 0), App.Rotation()))
+        self.doc.recompute()
+        pa = _pick(a, "Face6")  # top of A (+Z)
+        pb = _pick(b, "Face2")  # +X side of B
+        moved_point = App.Vector(pa.point)
+        movable, move, fa, fb = self.snap(pa, pb)
+        self.assertIs(movable.obj, a)
+        self.assertFacesTouch(pa, pb)
+        # The picked point of A went onto the picked point of B
+        self.assertVec(move.multVec(moved_point), pb.point)
+        # Touching, not overlapping
+        self.assertLess(a.Shape.common(b.Shape).Volume, 1e-6)
+        self.assertAlmostEqual(a.Shape.distToShape(b.Shape)[0], 0.0, places=6)
+
+    def test_flip_gap_spin_center(self):
+        a = self.box("A")
+        b = self.box("B", placement=App.Placement(App.Vector(0, 0, 50), App.Rotation()))
+        self.doc.recompute()
+        pa, pb = _pick(a, "Face6"), _pick(b, "Face6")
+        self.snap(pa, pb, flip=True, gap=5, align=S.ALIGN_CENTER)
+        self.assertFacesTouch(pa, pb, facing=False, gap=5)
+        fa = S.feature_of(S.Pick(a, "Face6"))
+        fb = S.feature_of(S.Pick(b, "Face6"))
+        self.assertVec(fa.center, fb.center + App.Vector(0, 0, 5))
+        # A quarter turn about the normal: A's long side (Y, 20) now lies along X
+        self.snap(pa, pb, flip=True, spin=90, align=S.ALIGN_CENTER)
+        bb = a.Shape.BoundBox
+        self.assertAlmostEqual(bb.XLength, 20, places=6)
+        self.assertAlmostEqual(bb.YLength, 10, places=6)
+
+    def test_snap_is_from_start_each_time(self):
+        """Changing an option recomputes from where the part was, not from the last preview."""
+        a = self.box("A")
+        b = self.box("B", placement=App.Placement(App.Vector(40, 0, 0), App.Rotation(App.Vector(1, 1, 0), 30)))
+        self.doc.recompute()
+        pa, pb = _pick(a, "Face1"), _pick(b, "Face5")
+        fa, fb = S.feature_of(pa), S.feature_of(pb)
+        movable = S.movable_candidates(pa)[0]
+        for gap in (3, 0, 7):
+            S.apply(movable, S.snap_move(fa, fb, gap=gap))
+        self.doc.recompute()
+        self.assertFacesTouch(pa, pb, gap=7)
+
+    def test_keep_position(self):
+        a = self.box("A", placement=App.Placement(App.Vector(3, 4, -20), App.Rotation()))
+        b = self.box("B", placement=App.Placement(App.Vector(0, 0, 50), App.Rotation()))
+        self.doc.recompute()
+        pa, pb = _pick(a, "Face5"), _pick(b, "Face6")
+        self.snap(pa, pb, align=S.ALIGN_KEEP)
+        # Bottom of A is now at the height of the top of B; X and Y did not change
+        self.assertVec(a.Placement.Base, App.Vector(3, 4, 80))
+
+    def test_rotated_parts(self):
+        ra = App.Rotation(App.Vector(1, 2, 3), 37)
+        rb = App.Rotation(App.Vector(-2, 1, 0.5), 113)
