+def _start_card(parent, title, text, slot):
+    b = QtWidgets.QPushButton(parent)
+    b.setObjectName("UnifiedFirstStepsCard")
+    b.setText(title + "\n" + text)
+    b.setStyleSheet("QPushButton { text-align: left; padding: 10px 14px; }")
+    b.setMinimumHeight(64)
+    b.clicked.connect(slot)
+    return b
+
+
+def decorate_start(view):
+    """The search field under the four ways to start, and "first steps" at the right"""
+    if view is None or view.property("unifiedDecorated"):
+        return
+    row = view.findChild(QtWidgets.QWidget, "CreateNewRow")
+    if row is None:
+        return
+    view.setProperty("unifiedDecorated", True)
+    # Keep the widgets referenced while their layouts are used (PySide drops a layout reached
+    # through a temporary wrapper)
+    page = row.parentWidget()
+    content = page.layout()
+    index = content.indexOf(row)
+    import CommandSearchGui
+
+    field = QtWidgets.QLineEdit(row.parentWidget())
+    field.setObjectName("UnifiedStartSearch")
+    field.setPlaceholderText(
+        translate("Unified", "🔍 What do you want to do? e.g. “export for 3D printing”, “DXF to solid”")
+    )
+    field.setMinimumHeight(34)
+    field.textEdited.connect(lambda text: (field.clear(), CommandSearchGui.popup().open(text)))
+    content.insertWidget(index + 1, field)
+
+    # The scroll area of the page goes into a row with the first steps at its right
+    scroll = row.parentWidget()
+    while scroll is not None and not isinstance(scroll, QtWidgets.QScrollArea):
+        scroll = scroll.parentWidget()
+    if scroll is None:
+        return
+    holder = scroll.parentWidget()
+    outer = holder.layout()
+    i = outer.indexOf(scroll)
+    outer.removeWidget(scroll)
+    box = QtWidgets.QHBoxLayout()
+    box.addWidget(scroll, 3)
+    side = QtWidgets.QWidget(holder)
+    side.setObjectName("UnifiedFirstSteps")
+    side.setMaximumWidth(420)
+    lay = QtWidgets.QVBoxLayout(side)
+    head = QtWidgets.QLabel("<h2>{}</h2>".format(translate("Unified", "New to CAD? (5 minutes)")), side)
+    lay.addWidget(head)
+    import FirstSteps
+
+    for walk in FirstSteps.WALKS:
+        lay.addWidget(_start_card(
