+            translate("FirstSteps", walk["title"]),
+            translate("FirstSteps", walk["summary"]),
+            lambda checked=False, k=walk["key"]: FirstSteps.start(k),
+        ))
+    lay.addStretch(1)
+    box.addWidget(side, 1)
+    outer.insertLayout(i, box)
+
