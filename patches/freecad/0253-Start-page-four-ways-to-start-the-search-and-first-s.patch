--- /dev/null
+++ b/src/Mod/Unified/FirstSteps.py
@@ -0,0 +1,218 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""For people new to CAD: four short walks (about 5 minutes each) from the start page.
+
+Each walk prepares what it needs (a sample part made here, no files to ship) and shows its steps
+at the right of the window, in the words of the screen. The steps are checked off by what the
+user does (the model is looked at), so the panel says what comes next.
+"""
+
+import os
+import tempfile
+
+import FreeCAD as App
+import FreeCADGui as Gui
+from PySide import QtCore, QtGui, QtWidgets
+
+translate = App.Qt.translate
+
+
+def QT_TRANSLATE_NOOP(context, text):
+    return text
+
+
+T = lambda text: QT_TRANSLATE_NOOP("FirstSteps", text)
+
+
+# --------------------------------------------------------------------------- samples
+def sample_plate(name="ベース板"):
+    """An 80 × 50 × 5 plate with four ⌀6 holes, made of a sketch with sizes, as a user would"""
+    import Part
+    import Sketcher
+
+    doc = App.newDocument(name)
+    body = doc.addObject("PartDesign::Body", "Body")
+    sk = body.newObject("Sketcher::SketchObject", "Sketch")
+    sk.AttachmentSupport = [(body.Origin.OriginFeatures[3], "")]
+    sk.MapMode = "FlatFace"
+    pts = [App.Vector(0, 0, 0), App.Vector(80, 0, 0), App.Vector(80, 50, 0), App.Vector(0, 50, 0)]
+    for i in range(4):
+        sk.addGeometry(Part.LineSegment(pts[i], pts[(i + 1) % 4]))
+    for i in range(4):
+        sk.addConstraint(Sketcher.Constraint("Coincident", i, 2, (i + 1) % 4, 1))
+    sk.addConstraint(Sketcher.Constraint("Horizontal", 0))
+    sk.addConstraint(Sketcher.Constraint("Horizontal", 2))
+    sk.addConstraint(Sketcher.Constraint("Vertical", 1))
+    sk.addConstraint(Sketcher.Constraint("Vertical", 3))
+    sk.addConstraint(Sketcher.Constraint("Coincident", 0, 1, -1, 1))
+    sk.addConstraint(Sketcher.Constraint("DistanceX", 0, 1, 0, 2, 80))
+    sk.addConstraint(Sketcher.Constraint("DistanceY", 1, 1, 1, 2, 50))
+    for x, y in ((8, 8), (72, 8), (72, 42), (8, 42)):
+        g = sk.addGeometry(Part.Circle(App.Vector(x, y, 0), App.Vector(0, 0, 1), 3))
+        sk.addConstraint(Sketcher.Constraint("Diameter", g, 6))
+        sk.addConstraint(Sketcher.Constraint("DistanceX", -1, 1, g, 3, x))
+        sk.addConstraint(Sketcher.Constraint("DistanceY", -1, 1, g, 3, y))
+    pad = body.newObject("PartDesign::Pad", "Pad")
+    pad.Profile = sk
+    pad.Length = 5
+    doc.recompute()
+    sk.Visibility = False
+    return doc
+
+
+def sample_step_files():
+    """A base with a hole and a pin, as STEP files (as from a supplier)"""
+    import Part
+
+    folder = os.path.join(tempfile.gettempdir(), "freecad-first-steps")
+    os.makedirs(folder, exist_ok=True)
+    base = Part.makeBox(60, 40, 10).cut(Part.makeCylinder(4, 10, App.Vector(30, 20, 0)))
+    pin = Part.makeCylinder(3.9, 30)
+    paths = []
+    for name, shape in (("base", base), ("pin", pin)):
+        path = os.path.join(folder, name + ".step")
+        shape.exportStep(path)
+        paths.append(path)
+    return paths
+
+
+# --------------------------------------------------------------------------- the walks
+def _has(doc, type_name):
+    return doc is not None and any(o.isDerivedFrom(type_name) for o in doc.Objects)
+
+
+def _count(doc, type_name):
+    return 0 if doc is None else sum(1 for o in doc.Objects if o.isDerivedFrom(type_name))
+
+
+WALKS = [
+    {
+        "key": "plate",
+        "title": T("Make a plate with holes"),
+        "summary": T("draw → extrude → hole → round"),
+        "steps": [
+            (T("Click the floor (XY) to draw on it"), lambda d: _has(d, "Sketcher::SketchObject")),
+            (T("Pick “Rectangle” in the band at the top and click two corners"), lambda d: any(len(o.Geometry) >= 4 for o in d.Objects if o.isDerivedFrom("Sketcher::SketchObject"))),
+            (T("Press “✓ Done”"), lambda d: _has(d, "Sketcher::SketchObject") and Gui.ActiveDocument.getInEdit() is None),
+            (T("Next to the sketch: type 5 in the number field and press Enter"), lambda d: _has(d, "PartDesign::Pad")),
+            (T("Click the top face, then “Hole”, then where the hole goes"), lambda d: _has(d, "PartDesign::Hole") or _has(d, "PartDesign::Pocket")),
+            (T("Click an upright edge, “Same direction”, type 3 and Enter"), lambda d: _has(d, "PartDesign::Fillet")),
+        ],
+        "start": lambda: Gui.runCommand("Unified_NewPart"),
+    },
+    {
+        "key": "change",
+        "title": T("Change a size afterwards"),
+        "summary": T("double-click the shape and type the number"),
+        "steps": [
+            (T("Right-click the plate in the history (left) and choose “Edit Its Sketch”"), lambda d: Gui.ActiveDocument.getInEdit() is not None),
+            (T("Double-click the size 80 and type 100, then Enter"), lambda d: any(abs(c.Value - 100) < 1e-6 for o in d.Objects if o.isDerivedFrom("Sketcher::SketchObject") for c in o.Constraints if c.Type == "DistanceX")),
+            (T("Press “✓ Done”: the plate is longer, the holes stay where their sizes put them"), lambda d: Gui.ActiveDocument.getInEdit() is None and any(abs(o.Shape.BoundBox.XLength - 100) < 1e-6 for o in d.Objects if o.isDerivedFrom("PartDesign::Pad"))),
+        ],
+        "start": lambda: sample_plate(),
+    },
+    {
+        "key": "assembly",
+        "title": T("Put STEP parts together"),
+        "summary": T("put → pick two faces → snap"),
+        "steps": [
+            (T("Press “Put Part” and click “base” in the list (the first part does not move)"), lambda d: _count(d, "App::Link") + _count(d, "Part::Feature") >= 1),
+            (T("Click “pin” in the list too, then “✓ Done”"), lambda d: _count(d, "App::Link") + _count(d, "Part::Feature") >= 2 and not Gui.Control.activeDialog()),
+            (T("Click the round face of the pin, Ctrl+click the hole, then “Line up axes”"), lambda d: False),
+        ],
+        "start": lambda: _start_assembly(),
+    },
+    {
+        "key": "drawing",
+        "title": T("Make a JIS drawing"),
+        "summary": T("make drawing → done → PDF"),
+        "steps": [
+            (T("Press “Make Drawing” in the tool strip"), lambda d: _has(d, "TechDraw::DrawProjGroup")),
+            (T("Press “✓ Done”: front, top and right views on an A4 sheet"), lambda d: _has(d, "TechDraw::DrawProjGroup") and not Gui.Control.activeDialog()),
+            (T("Click the circle of a hole: the bar offers “Diameter”"), lambda d: _has(d, "TechDraw::DrawViewDimension")),
+            (T("Click the sheet and choose “PDF / print”"), lambda d: False),
+        ],
+        "start": lambda: sample_plate(),
+    },
+]
+
+
+def _start_assembly():
+    paths = sample_step_files()
+    import ImportGui
+
+    for p in paths:
+        ImportGui.open(p)
+    Gui.runCommand("Unified_NewAssembly")
+
+
+class GuidePanel(QtWidgets.QDockWidget):
+    """The steps of a walk at the right; the next step is in bold, done steps are ticked"""
+
+    def __init__(self, mw):
+        super().__init__(translate("FirstSteps", "First steps"), mw)
+        self.setObjectName("UnifiedFirstSteps")
+        body = QtWidgets.QWidget(self)
+        self.layout_ = QtWidgets.QVBoxLayout(body)
+        self.title = QtWidgets.QLabel(body)
+        self.title.setWordWrap(True)
+        self.layout_.addWidget(self.title)
+        self.list = QtWidgets.QLabel(body)
+        self.list.setWordWrap(True)
+        self.list.setTextFormat(QtCore.Qt.RichText)
+        self.layout_.addWidget(self.list)
+        self.layout_.addStretch(1)
+        close = QtWidgets.QPushButton(translate("FirstSteps", "Close"), body)
+        close.clicked.connect(self.hide)
+        self.layout_.addWidget(close)
+        self.setWidget(body)
+        mw.addDockWidget(QtCore.Qt.RightDockWidgetArea, self)
+        self.walk = None
+        self.doc = None
+        self.timer = QtCore.QTimer(self)
+        self.timer.timeout.connect(self.update_steps)
+
+    def start(self, walk):
+        self.walk = walk
+        self.title.setText("<h3>{}</h3>".format(translate("FirstSteps", walk["title"])))
+        walk["start"]()
+        self.doc = App.ActiveDocument
+        self.show()
+        self.raise_()
+        self.timer.start(500)
+        self.update_steps()
+
+    def update_steps(self):
+        if self.walk is None or not self.isVisible():
+            self.timer.stop()
+            return
+        doc = App.ActiveDocument
+        lines = []
+        current = True
+        for text, done in self.walk["steps"]:
+            try:
+                ok = bool(doc) and done(doc)
+            except Exception:
+                ok = False
+            text = translate("FirstSteps", text)
+            if ok:
+                lines.append("<p style='color:#1a7f37'>✓ {}</p>".format(text))
+            elif current:
+                lines.append("<p><b>→ {}</b></p>".format(text))
+                current = False
+            else:
+                lines.append("<p style='color:#7b8594'>・ {}</p>".format(text))
+        if current:
+            lines.append("<p><b>{}</b></p>".format(translate("FirstSteps", "Done! Every tool can also be found with Ctrl+K.")))
+        self.list.setText("".join(lines))
+
+
+_panel = None
+
+
+def start(key):
+    global _panel
+    if _panel is None:
+        _panel = GuidePanel(Gui.getMainWindow())
+    for walk in WALKS:
+        if walk["key"] == key:
+            _panel.start(walk)
