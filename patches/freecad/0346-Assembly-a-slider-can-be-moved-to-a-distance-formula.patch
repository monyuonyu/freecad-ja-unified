+// A slider joint with SlideDriven on is moved to its SlideDistance along its axis (a valve's
+// lift as a formula of the crank's angle): solved as a fixed joint whose first placement is
+// moved by the distance along its z axis.
+bool isDistanceDriven(const App::DocumentObject* joint)
+{
+    if (!joint || getJointType(joint) != JointType::Slider) {
+        return false;
+    }
+    auto* driven = joint->getPropertyByName<App::PropertyBool>("SlideDriven");
+    return driven && driven->getValue();
+}
+
+bool isDriven(const App::DocumentObject* joint)
+{
+    return isAngleDriven(joint) || isDistanceDriven(joint);
+}
