+    def test_a_slider_moved_to_a_distance(self):
+        # a valve's lift: a slider moved along its axis to a distance (a formula of the crank)
+        import AssemblyCopies
+
+        doc = App.newDocument("lift")
+        try:
+            asm = doc.addObject("Assembly::AssemblyObject", "Assembly")
+            asm.Type = "Assembly"
+            asm.newObject("Assembly::JointGroup", "Joints")
+            valve = asm.newObject("Part::Cylinder", "Valve")
+            valve.Placement.Base = App.Vector(0, 0, 50)
+            doc.recompute()
+            slide = AssemblyCopies.slide_on_ground(asm, valve, "Face1")
+            self.assertEqual(asm.solve(), 0)
+            z0 = valve.Placement.Base.z
+            slide.SlideDriven = True
+            for d in (5, -3, 7.83):
+                slide.SlideDistance = d
+                doc.recompute()
+                self.assertEqual(asm.solve(), 0)
+                self.assertAlmostEqual(abs(valve.Placement.Base.z - z0), abs(d), places=6)
+            self.assertEqual(asm.getBrokenJoints(), [])
+        finally:
+            App.closeDocument(doc.Name)
+
     def test_free_parts(self):
         # a part with no joint is free; the parts of a driven crank are not
