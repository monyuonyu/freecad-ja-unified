@@ -127,6 +144,11 @@ Base::Placement jointPlacementFromProp(App::DocumentObject* joint, const char* p
         const double a = angle ? Base::toRadians(angle->getValue()) : 0.0;
         plc = plc * Base::Placement(Base::Vector3d(), Base::Rotation(Base::Vector3d(0, 0, 1), a));
     }
+    if (std::strcmp(plcName, "Placement1") == 0 && isDistanceDriven(joint)) {
+        auto* distance = joint->getPropertyByName<App::PropertyFloat>("SlideDistance");
+        const double d = distance ? distance->getValue() : 0.0;
+        plc = plc * Base::Placement(Base::Vector3d(0, 0, d), Base::Rotation());
+    }
     return plc;
 }
 
