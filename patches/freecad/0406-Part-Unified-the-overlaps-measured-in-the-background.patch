diff --git a/src/Mod/Unified/TestDesignCheck.py b/src/Mod/Unified/TestDesignCheck.py
index eb83a3481..3ac003e13 100644
--- a/src/Mod/Unified/TestDesignCheck.py
+++ b/src/Mod/Unified/TestDesignCheck.py
@@ -177,6 +177,26 @@ class DesignCheckSweepTest(unittest.TestCase):
             App.closeDocument(doc.Name)
 
 
+class StopBackgroundTest(unittest.TestCase):
+    def test_overlaps_measured_in_a_thread_stop_at_once(self):
+        # quitting while a background check measured: its threads ran on into the torn-down OCC
+        # (a crash and exit code 1 after a normal close; a night of runs under ASan)
+        import threading
+        import time
+
+        solids = [Part.makeSphere(5, App.Vector(i * 3, 0, 0)) for i in range(160)]
+        done = {}
+        t = threading.Thread(target=lambda: done.update(r=Part.findInterferences(solids, threads=2)), daemon=True)
+        DesignCheck._WORKERS.add(t)
+        start = time.time()
+        t.start()
+        time.sleep(0.2)
+        self.assertEqual(DesignCheck.stop_background(), 1)
+        self.assertFalse(t.is_alive())
+        self.assertLess(time.time() - start, 5)
+        self.assertIn("r", done)  # returned, the pairs not done left out
+
+
 class DesignCheckCommandLineTest(unittest.TestCase):
     def test_design_check_interference(self):
         import DrawingPdf
