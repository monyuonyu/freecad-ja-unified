diff --git a/src/Mod/Unified/DesignCheck.py b/src/Mod/Unified/DesignCheck.py
index f3337173b..1b5aeb699 100644
--- a/src/Mod/Unified/DesignCheck.py
+++ b/src/Mod/Unified/DesignCheck.py
@@ -609,6 +609,24 @@ def check_interference(doc, issues, opt, shapes):
         pass
 
 
+_WORKERS = set()  # the threads measuring overlaps now (a check left running in the background)
+
+
+def stop_background(seconds=10.0):
+    """Stop the overlap measures running in other threads and wait for them: the application
+    quits. Left running, they went on into the torn-down OCC (a crash, exit code 1 after a
+    normal close; found by a night of runs under ASan)"""
+    import Part
+
+    alive = [t for t in _WORKERS if t.is_alive()]
+    if alive:
+        Part.cancelInterferences()
+        for t in alive:
+            t.join(seconds)
+    _WORKERS.clear()
+    return len(alive)
+
+
 class Progress:
     """検査の途中経過（iter_run が yield する）: done / total 組目、いま何をしているか。
     waiting が真なら、別のプロセスの計算を待っているだけ（呼ぶ側は少し間を空けてよい）"""
@@ -651,6 +669,7 @@ def iter_interference(doc, issues, opt, shapes):
