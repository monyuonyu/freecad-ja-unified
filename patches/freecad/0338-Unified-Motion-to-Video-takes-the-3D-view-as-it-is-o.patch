+def grab(path):
+    """The 3D view's picture as it is on the screen (its section, transparency and zoom; a
+    picture drawn again lost the view's clipping)"""
+    view = Gui.ActiveDocument.ActiveView
+    view.redraw()
+    QtWidgets.QApplication.processEvents()
+    gl = view.graphicsView().viewport() if hasattr(view, "graphicsView") else None
+    if gl is not None and hasattr(gl, "grabFramebuffer"):
+        image = gl.grabFramebuffer()
+        if image.width() % 2 or image.height() % 2:  # video encoders want even sizes
+            image = image.copy(0, 0, image.width() // 2 * 2, image.height() // 2 * 2)
+        image.save(path)
+    else:
+        size = view.getSize()
+        view.saveImage(path, int(size[0]) // 2 * 2, int(size[1]) // 2 * 2, "Current")
+
+
+def record(joint, path, start, end, frames, fps):
+    doc = joint.Document
+    bar = Gui.getMainWindow().statusBar()
+    # the joints' markers and the pick's highlight are not part of the picture
+    picked = Gui.Selection.getSelectionEx()
+    Gui.Selection.clearSelection()
+    hidden = []
+    for o in doc.Objects:
+        if hasattr(o, "JointType") or hasattr(o, "ObjectToGround"):
+            vo = getattr(o, "ViewObject", None)
+            if vo is not None and vo.Visibility:
+                vo.Visibility = False
+                hidden.append(o)
+    done = [0]
+
+    def draw(p):
+        grab(p)
+        done[0] += 1
+        bar.showMessage(translate("Unified_MotionVideo", "Video: picture {} of {}").format(done[0], frames))
+
+    was_driven = bool(getattr(joint, "AngleDriven", False))
+    if not was_driven:
+        joint.AngleDriven = True
+    QtWidgets.QApplication.setOverrideCursor(QtCore.Qt.WaitCursor)
+    try:
+        written, failed = MotionVideo.export(joint, path, start, end, frames, fps, draw=draw)
+    except Exception as e:
+        QtWidgets.QApplication.restoreOverrideCursor()
+        QtWidgets.QMessageBox.warning(Gui.getMainWindow(), translate("Unified_MotionVideo", "Motion to Video"), str(e))
+        return
+    finally:
+        if not was_driven:
+            joint.AngleDriven = False
+        for o in hidden:
+            o.ViewObject.Visibility = True
+        for s in picked:
+            Gui.Selection.addSelection(s.Object)
+        bar.clearMessage()
+    QtWidgets.QApplication.restoreOverrideCursor()
+    text = translate("Unified_MotionVideo", "Written: {}").format(written)
+    if failed:
+        text += "\n" + translate(
+            "Unified_MotionVideo", "The joints did not hold at {} of the angles (e.g. {:g}°): the parts may jump there."
+        ).format(len(failed), failed[0])
+    QtWidgets.QMessageBox.information(Gui.getMainWindow(), translate("Unified_MotionVideo", "Motion to Video"), text)
+
