+++ b/src/Mod/TechDraw/TDTest/DrawViewDraftTest.py
@@ -0,0 +1,46 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+
+import FreeCAD
+import unittest
+from .TechDrawTestUtilities import createPageWithSVGTemplate
+
+
+class DrawViewDraftTest(unittest.TestCase):
+    def setUp(self):
+        self.doc = FreeCAD.newDocument("TDDraft")
+        FreeCAD.setActiveDocument("TDDraft")
+        self.page = createPageWithSVGTemplate(self.doc)
+        self.box = self.doc.addObject("Part::Box", "Box")
+        self.box.Length = 77
+        self.view = self.doc.addObject("TechDraw::DrawViewDraft", "DraftView")
+        self.view.Source = self.box
+        self.page.addView(self.view)
+        self.doc.recompute()
+
+    def tearDown(self):
+        for name in ("TDDraft", "TDDraftOther"):
+            if name in FreeCAD.listDocuments():
+                FreeCAD.closeDocument(name)
+
+    def testSymbolFromSource(self):
+        self.assertIn("77", self.view.Symbol)
+        self.assertIn("Up-to-date", self.view.State)
+
+    def testRecomputeWhileAnotherDocumentIsActive(self):
+        """The view and its source are taken from their own document, not the active one"""
+        other = FreeCAD.newDocument("TDDraftOther")
+        box = other.addObject("Part::Box", "Box")
+        box.Length = 33
+        view = other.addObject("TechDraw::DrawViewDraft", "DraftView")
+        other.recompute()
+        FreeCAD.setActiveDocument("TDDraftOther")
+        self.box.Length = 55
+        self.doc.recompute()
+        self.assertNotIn("Invalid", self.view.State)
+        self.assertIn("55", self.view.Symbol)
+        self.assertNotIn("33", self.view.Symbol)
+        self.assertEqual(view.Symbol, "")  # the other document's view was not written to
+
+
+if __name__ == "__main__":
+    unittest.main()
