From ce34557871cbd3e7ce67e17e24ff055aa0dc8ccd Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Sat, 17 Oct 2026 05:28:21 +0900
Subject: [PATCH 230/277] TechDraw: Draft and Arch views use their own
 document, not the active one

DrawViewDraft::execute and DrawViewArch::execute ran
Draft.get_svg(App.activeDocument().<Source>) and wrote
App.activeDocument().<Name>.Symbol. When the document being recomputed was
not the active one (a script that opened another file, recompute of a
background document) the view failed and kept a stale Symbol, or read the
source and wrote the Symbol of same-named objects in the other document.
Found by the bughunt corpus: ArchDetail.FCStd DraftView changed after save
and reopen. Both are now addressed by document and object name.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/Mod/TechDraw/App/DrawViewArch.cpp        | 13 ++++--
 src/Mod/TechDraw/App/DrawViewDraft.cpp       | 13 ++++--
 src/Mod/TechDraw/CMakeLists.txt              |  1 +
 src/Mod/TechDraw/TDTest/DrawViewDraftTest.py | 46 ++++++++++++++++++++
 src/Mod/TechDraw/TestTechDrawApp.py          |  1 +
 5 files changed, 66 insertions(+), 8 deletions(-)
 create mode 100644 src/Mod/TechDraw/TDTest/DrawViewDraftTest.py

diff --git a/src/Mod/TechDraw/App/DrawViewArch.cpp b/src/Mod/TechDraw/App/DrawViewArch.cpp
index 10d994cfd..a16e4ea2d 100644
--- a/src/Mod/TechDraw/App/DrawViewArch.cpp
+++ b/src/Mod/TechDraw/App/DrawViewArch.cpp
@@ -27,6 +27,7 @@
 # include <sstream>
 
 
+#include <App/Document.h>
 #include <Base/Console.h>
 #include <Base/Interpreter.h>
 
@@ -129,10 +130,14 @@ App::DocumentObjectExecReturn *DrawViewArch::execute()
                  << ", joinArch=" << (JoinArch.getValue() ? "True" : "False");
 
         Base::Interpreter().runString("import ArchSectionPlane");
-        Base::Interpreter().runStringArg("svgBody = ArchSectionPlane.getSVG(App.activeDocument().%s %s)",
-                                         SourceName.c_str(), paramStr.str().c_str());
-        Base::Interpreter().runStringArg("App.activeDocument().%s.Symbol = '%s' + svgBody + '%s'",
-                                          FeatName.c_str(), svgHead.c_str(), svgTail.c_str());
+        // the source and this view may be in a document that is not the active one (recompute of
+        // another document, a document opened by a script): name both by their documents
+        Base::Interpreter().runStringArg("svgBody = ArchSectionPlane.getSVG(App.getDocument(\"%s\").getObject(\"%s\") %s)",
+                                         sourceObj->getDocument()->getName(), SourceName.c_str(),
+                                         paramStr.str().c_str());
+        Base::Interpreter().runStringArg("App.getDocument(\"%s\").getObject(\"%s\").Symbol = '%s' + svgBody + '%s'",
+                                         getDocument()->getName(), FeatName.c_str(), svgHead.c_str(),
+                                         svgTail.c_str());
     }
     overrideKeepUpdated(false);
     return DrawView::execute();
