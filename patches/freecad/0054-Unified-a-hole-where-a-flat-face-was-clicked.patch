--- /dev/null
+++ b/src/Mod/Unified/UnifiedCommands.py
@@ -0,0 +1,102 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+# Commands of the integrated working environment that are written in Python.
+
+import FreeCAD
+import FreeCADGui
+from PySide import QtCore
+
+translate = FreeCAD.Qt.translate
+QT_TRANSLATE_NOOP = FreeCAD.Qt.QT_TRANSLATE_NOOP
+
+
+def _picked_plane_face():
+    """The planar face of a solid that was picked in the 3D view, with the picked point."""
+    import Part
+
+    selection = FreeCADGui.Selection.getSelectionEx()
+    if len(selection) != 1 or len(selection[0].SubElementNames) != 1:
+        return None
+    sel = selection[0]
+    name = sel.SubElementNames[0]
+    if not name.startswith("Face") or not sel.PickedPoints:
+        return None
+    obj = sel.Object
+    if obj.isDerivedFrom("Sketcher::SketchObject"):
+        return None
+    face = sel.SubObjects[0]
+    if not isinstance(face.Surface, Part.Plane):
+        return None
+    # Only faces without round edges: with a circle to drill through, PartDesign's hole
+    # already knows where to go
+    if any(isinstance(edge.Curve, (Part.Circle, Part.ArcOfCircle)) for edge in face.Edges):
+        return None
+    return obj, name, sel.PickedPoints[0]
+
+
+class HoleCommand:
+    """A hole where the face was clicked.
+
+    PartDesign's hole needs a sketch with circles or points. When a flat face is picked, make
+    that sketch here: a point where the face was clicked, on a sketch on the face.
+    """
+
+    def GetResources(self):
+        return {
+            "Pixmap": "PartDesign_Hole",
+            "MenuText": QT_TRANSLATE_NOOP("Unified_Hole", "Hole"),
+            "ToolTip": QT_TRANSLATE_NOOP(
+                "Unified_Hole",
+                "Makes a hole. Click a flat face where the hole should go, or pick a sketch "
+                "with circles or points",
+            ),
+        }
+
+    def IsActive(self):
+        return FreeCADGui.isCommandActive("PartDesign_Hole") or _picked_plane_face() is not None
+
+    def Activated(self):
+        picked = _picked_plane_face()
+        if not picked:
+            FreeCADGui.runCommand("PartDesign_Hole")
+            return
+        obj, face_name, point = picked
+        import Part
+
+        doc = obj.Document
+        body = obj.getParentGeoFeatureGroup()
+        if body is None or not body.isDerivedFrom("PartDesign::Body"):
+            FreeCADGui.runCommand("PartDesign_Hole")
+            return
+
+        doc.openTransaction(translate("Unified_Hole", "Hole position"))
+        sketch = body.newObject("Sketcher::SketchObject", "Sketch")
+        sketch.AttachmentSupport = [(obj, face_name)]
+        sketch.MapMode = "FlatFace"
+        doc.recompute()
+        local = sketch.getGlobalPlacement().inverse().multVec(point)
+        sketch.addGeometry(Part.Point(FreeCAD.Vector(local.x, local.y, 0)))
+        doc.recompute()
+        doc.commitTransaction()
+        sketch.ViewObject.Visibility = False
+
+        FreeCADGui.Selection.clearSelection()
+        FreeCADGui.Selection.addSelection(sketch)
+        FreeCADGui.runCommand("PartDesign_Hole")
+
+        # If the hole is cancelled, do not leave the sketch behind
+        def remove_if_unused():
+            if FreeCADGui.Control.activeDialog():
+                QtCore.QTimer.singleShot(300, remove_if_unused)
+                return
+            try:
+                unused = all(o.Name == body.Name for o in sketch.InList)
+            except Exception:
+                return  # already deleted
+            if unused:
+                doc.removeObject(sketch.Name)
+                doc.recompute()
+
+        QtCore.QTimer.singleShot(300, remove_if_unused)
+
+
+FreeCADGui.addCommand("Unified_Hole", HoleCommand())
