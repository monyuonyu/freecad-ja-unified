+_kept = []
+
+
+def sheet_areas(template_file, width, height):
+    """(frame, title block) of a sheet in page mm, y up from the bottom: the frame is the
+    drawing space (ISO templates name it), else the largest rectangle inside the sheet, else
+    10 mm in from the edges; the title block is named so, else where the template's editable
+    texts are (None without them)"""
+    import re
+
+    frame = title = None
+    try:
+        with open(template_file, encoding="utf-8") as f:
+            svg = f.read()
+    except OSError:
+        svg = ""
+    rects = []
+    for m in re.finditer(r"<rect\b([^>]*)>", svg):
+        attrs = dict(re.findall(r'([\w:-]+)="([^"]*)"', m.group(1)))
+        try:
+            x, y, w, h = (float(attrs[k]) for k in ("x", "y", "width", "height"))
+        except (KeyError, ValueError):
+            continue
+        box = (x, height - y - h, x + w, height - y)  # y up
+        name = attrs.get("id", "")
+        if "drawing_space" in name or name == "frame":
+            frame = box
+        elif "title_block" in name and title is None:
+            title = box
+        elif 0 < w < width and 0 < h < height:
+            rects.append((w * h, box))
+    if frame is None:
+        big = [b for a, b in sorted(rects, reverse=True) if a > 0.6 * width * height]
+        frame = big[0] if big else (10.0, 10.0, width - 10.0, height - 10.0)
+    if title is None:
+        points = []
+        for m in re.finditer(r"<text\b([^>]*freecad:editable[^>]*)>", svg):
+            attrs = dict(re.findall(r'([\w:-]+)="([^"]*)"', m.group(1)))
+            try:
+                points.append((float(attrs["x"]), height - float(attrs["y"])))
+            except (KeyError, ValueError):
+                continue
+        if points:
+            xs, ys = [p[0] for p in points], [p[1] for p in points]
+            title = (min(xs) - 3, min(ys) - 3, max(xs) + 20, max(ys) + 6)
+    return frame, title
+
+
+def layout_problems(doc, page):
+    """The views, texts and dimensions of the page that go out of the sheet's frame or onto
+    its title block, as they are drawn (a note centred on its X ran out to the left of the
+    frame, and onto the title block on the right; company test 0.7.9)"""
+    import TechDrawGui
+    from PySide import QtCore
+
+    tpl = getattr(page, "Template", None)
+    width = float(getattr(page, "PageWidth", 297) or 297)
+    height = float(getattr(page, "PageHeight", 210) or 210)
+    template_file = getattr(tpl, "PageResult", "") or getattr(tpl, "Template", "") if tpl is not None else ""
+    frame, title = sheet_areas(template_file, width, height)
+    scene = TechDrawGui.getSceneForPage(page)
+    if scene is None:
+        return []
+    # kept: the Python wrapper deletes the page's scene when it goes, and writing the page
+    # after that crashed
+    _kept.append(scene)
+    # the views placed on the page (a dimension's or balloon's place is its view's: drawn in it)
+    views = [o for o in doc.Objects if o.isDerivedFrom("TechDraw::DrawView") and page in o.InListRecursive
+             and not o.isDerivedFrom("TechDraw::DrawProjGroup")
+             and not o.isDerivedFrom("TechDraw::DrawViewDimension")
+             and not o.isDerivedFrom("TechDraw::DrawViewBalloon")]  # fmt: skip
+
+    def drawn(item):
+        # what is drawn: the visible leaves (not the frame and label shown on hover)
+        kids = [c for c in item.childItems() if c.isVisible()]
+        if not kids:
+            return item.sceneBoundingRect()
+        r = QtCore.QRectF()
+        for c in kids:
+            r = r.united(drawn(c))
+        return r
+
+    def mm(rect):  # the scene is in 0.1 mm, y down
+        return (rect.left() / 10, -rect.bottom() / 10, rect.right() / 10, -rect.top() / 10)
+
+    def label_of(item):
+        pos = item.scenePos()
+        x, y = pos.x() / 10, -pos.y() / 10
+        best = None
+        for v in views:
+            vx, vy = _page_xy(v)
+            d = (vx - x) ** 2 + (vy - y) ** 2
+            if best is None or d < best[0]:
+                best = (d, v.Label)
+        return best[1] if best and best[0] < 1 else "?"
+
+    # the top items: not a child of another (parentItem() is not asked: its Python wrapper of
+    # TechDraw's own item took the item with it, and writing the page crashed)
+    import shiboken6
+
+    items = scene.items()
+    children = {shiboken6.getCppPointer(c)[0] for it in items for c in it.childItems()}
+    problems = []
+    for item in items:
+        if shiboken6.getCppPointer(item)[0] in children or not item.isVisible() or item.zValue() < -1000:
+            continue
+        box = mm(drawn(item))
+        if box[2] - box[0] <= 0 or box[3] - box[1] <= 0:
+            continue
+        if (box[2] - box[0]) * (box[3] - box[1]) > 0.9 * width * height:
+            continue  # the sheet (template) itself
+        sides = {"left": frame[0] - box[0], "bottom": frame[1] - box[1], "right": box[2] - frame[2],
+                 "top": box[3] - frame[3]}  # fmt: skip
+        side = max(sides, key=sides.get)
+        out = sides[side] if sides[side] > 0.1 else None
+        name = label_of(item)
+        if name == "?":
+            continue  # not a view of the page (the sheet itself)
+        page_name = page.Label
+        if out is not None:
+            problems.append("%s: %s goes out of the frame by %.1f mm (%s)" % (page_name, name, out, side))
+        if title and box[0] < title[2] and box[2] > title[0] and box[1] < title[3] and box[3] > title[1]:
+            problems.append("%s: %s is on the title block" % (page_name, name))
+    return sorted(problems)
+
+
+def _page_xy(view):
+    """Where the view is on the page (a view of a projection group is placed in the group)"""
+    def mm(q):
+        return float(getattr(q, "Value", q))
+
+    x, y = mm(view.X), mm(view.Y)
+    for parent in view.InList:
+        if parent.isDerivedFrom("TechDraw::DrawProjGroup"):
+            x += mm(parent.X)
+            y += mm(parent.Y)
+    return x, y
+
+
