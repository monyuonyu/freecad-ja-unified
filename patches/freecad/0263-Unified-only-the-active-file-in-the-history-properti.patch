@@ -782,6 +782,8 @@ class StepBand(QtWidgets.QToolBar):
         else:
             self.undo_start = None
             text = key[1]
+            # The whole model in sight while its panel is open
+            QtCore.QTimer.singleShot(200, lambda: Gui.SendMsgToActiveView("ViewFit"))
             title.setText(
                 translate("Unified", "Working on “{}”").format(text) if text else translate("Unified", "A tool is open")
             )
@@ -970,6 +972,58 @@ def install_start():
         _on_subwindow(sub)
 
 
+# --------------------------------------------------------------------------- the left side
+def _model_splitter():
+    """The splitter of the tree (top) and the property view (bottom) in the "Model" panel"""
+    for sp in Gui.getMainWindow().findChildren(QtWidgets.QSplitter):
+        if sp.count() == 2 and sp.parentWidget() is not None and sp.parentWidget().objectName() == "Model":
+            if sp.widget(1).findChild(QtWidgets.QTabWidget, "propertyTab") is not None:
+                return sp
+    return None
+
+
+def show_properties(show=None):
+    """The detailed properties under the history: folded away unless asked for"""
+    sp = _model_splitter()
+    if sp is None:
+        return
+    total = sum(sp.sizes()) or 800
+    if show is None:
+        show = sp.sizes()[1] < 20
+    sp.setSizes([total // 2, total - total // 2] if show else [total, 0])
+    params().SetBool("ShowProperties", bool(show))
+
+
+class PropertiesCommand:
+    def GetResources(self):
+        return {
+            "Pixmap": "document-properties",
+            "MenuText": QT_TRANSLATE_NOOP("Unified_Properties", "Detailed Properties"),
+            "ToolTip": QT_TRANSLATE_NOOP(
+                "Unified_Properties", "Show or fold away all the properties of what is picked, under the history"
+            ),
+        }
+
+    def IsActive(self):
+        return True
+
+    def Activated(self):
+        show_properties()
+
+
+Gui.addCommand("Unified_Properties", PropertiesCommand())
+
+
+def install_left():
+    """Only the active file's history in the tree; the detailed properties folded away"""
+    tree = App.ParamGet("User parameter:BaseApp/Preferences/TreeView")
+    if tree.GetInt("DocumentMode", 7) == tree.GetInt("DocumentMode", 8):
+        pass  # set by the user
+    else:
+        tree.SetInt("DocumentMode", 0)
+    show_properties(params().GetBool("ShowProperties", False))
+
+
 def install():
     if classic():
         import CommandSearchGui
@@ -981,4 +1035,5 @@ def install():
     QtCore.QTimer.singleShot(0, strip_tooltips)
     QtCore.QTimer.singleShot(0, install_band)
     QtCore.QTimer.singleShot(0, install_start)
+    QtCore.QTimer.singleShot(0, install_left)
     install_keys()
