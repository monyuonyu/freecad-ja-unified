Date: Sat, 24 Oct 2026 20:46:29 +0900
Subject: [PATCH 336/397] TestMotionVideo: the release builds must bring ffmpeg
 (FREECAD_EXPECT_FFMPEG)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/Mod/Unified/TestMotionVideo.py | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/Mod/Unified/TestMotionVideo.py b/src/Mod/Unified/TestMotionVideo.py
index 4ddf6be37..eb0890dd6 100644
--- a/src/Mod/Unified/TestMotionVideo.py
+++ b/src/Mod/Unified/TestMotionVideo.py
@@ -34,6 +34,8 @@ class MotionVideoTest(unittest.TestCase):
             self.assertEqual(Image.open(out).n_frames, 8)
             # the formula of the angle is put back
             self.assertIn("Params.theta", MotionVideo.formula(drive, "Angle"))
+            if os.environ.get("FREECAD_EXPECT_FFMPEG"):  # the release builds bring it
+                self.assertIsNotNone(MotionVideo.ffmpeg())
             if MotionVideo.ffmpeg():
                 out, failed = MotionVideo.export(drive, os.path.join(tmp, "crank.mp4"), 0, 360, 8,
                                                  view="front", size=(160, 160))  # fmt: skip
