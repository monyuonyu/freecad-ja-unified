+def _mass_properties(shape):
+    """(volume mm³, centre of mass, 3×3 inertia about it for unit density) of all the solids of
+    `shape`, added with the parallel axis theorem: a Compound has no MatrixOfInertia, and its
+    centre was taken as its box's (362 mm off for 31 nuts in one part; reported on 0.9.0)"""
+    solids = shape.Solids or ([shape] if hasattr(shape, "MatrixOfInertia") else [])
+    parts = []
+    for x in solids:
+        v = x.Volume
+        if v <= 0:
+            continue
+        m = x.MatrixOfInertia
+        parts.append((v, x.CenterOfMass, [[m.A11, m.A12, m.A13], [m.A21, m.A22, m.A23], [m.A31, m.A32, m.A33]]))
+    if not parts:
+        return shape.Volume if hasattr(shape, "Volume") else 0.0, shape.BoundBox.Center, None
+    total = sum(v for v, _, _ in parts)
+    com = App.Vector()
+    for v, c, _ in parts:
+        com += c * (v / total)
+    tensor = [[0.0] * 3 for _ in range(3)]
+    for v, c, t in parts:
+        d = [c.x - com.x, c.y - com.y, c.z - com.z]
+        dd = d[0] ** 2 + d[1] ** 2 + d[2] ** 2
+        for i in range(3):
+            for j in range(3):
+                # the solid's own tensor (unit density: already times its volume) + v (|d|² δ − d dᵀ)
+                tensor[i][j] += t[i][j] + v * ((dd if i == j else 0.0) - d[i] * d[j])
+    return total, com, tensor
+
