+def load_density_map(path):
+    """{"density": {pattern: kg/m³}, "mass": {pattern: kg}} from a JSON file (a flat {pattern:
+    kg/m³} is the densities)"""
+    import json
+
+    with open(path, encoding="utf-8-sig") as f:
+        data = json.load(f)
+    if "density" not in data and "mass" not in data:
+        data = {"density": data}
+    return {"density": data.get("density", {}), "mass": data.get("mass", {})}
+
+
+def _density(obj, default, given=None):
+    """kg/m³ for the part, and from where: a mass or density given by pattern (given), a Mass
+    or Density property of the part (kg, kg/m³), its material, else default. A mass comes as
+    ("mass <kg>")"""
+    import fnmatch
+
+    names = [obj.Label, obj.Name]
+    for kind in ("mass", "density"):
+        for pattern, value in (given or {}).get(kind, {}).items():
+            if any(fnmatch.fnmatchcase(n, pattern) for n in names):
+                return (0.0, "mass %s" % float(value)) if kind == "mass" else (float(value), "given %s" % pattern)
+    for o in (obj, getattr(obj, "getLinkedObject", lambda *a: obj)(True)):
+        for prop, kind in (("Mass", "mass"), ("Density", "density")):
+            v = getattr(o, prop, None)
+            if v is None:
+                continue
+            try:
+                unit = "kg" if kind == "mass" else "kg/m^3"
+                value = App.Units.Quantity(v).getValueAs(unit).Value if hasattr(v, "Unit") else float(v)
+            except Exception:
+                continue
+            if value > 0:
+                return (0.0, "mass %s" % value) if kind == "mass" else (value, "property Density")
     for o in (obj, getattr(obj, "getLinkedObject", lambda *a: obj)(True)):
