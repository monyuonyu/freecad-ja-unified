         self.assertEqual({g.get("contype") + g.get("conaffinity") for g in root.iter("geom")}, {"10"})
 
 
+class MjcfMassTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.mkdtemp()
+        self.doc = App.newDocument("mjcfmass")
+
+    def tearDown(self):
+        App.closeDocument(self.doc.Name)
+        shutil.rmtree(self.tmp)
+
+    def inertial(self, path, name):
+        body = [b for b in ET.parse(path).getroot().iter("body") if b.get("name") == name][0]
+        return body.find("inertial")
+
+    def test_a_compound_of_solids(self):
+        # a Compound has no MatrixOfInertia: 300 of 365 parts got a placeholder inertia and their
+        # box's centre (reported on 0.9.0)
+        import Part
+
+        a, b = Part.makeBox(10, 10, 10), Part.makeBox(10, 20, 30, App.Vector(100, 0, 0))
+        comp = self.doc.addObject("Part::Feature", "Nuts")
+        comp.Shape = Part.makeCompound([a, b])
+        one = self.doc.addObject("Part::Feature", "Fused")
+        one.Shape = a.fuse(b)
+        one.Placement.Base = App.Vector(0, 500, 0)
+        self.doc.recompute()
+        path = os.path.join(self.tmp, "m.xml")
+        rep = MjcfExport.export(self.doc, path)
+        self.assertEqual(rep["no_inertia"], [])
+        c, f = self.inertial(path, "Nuts"), self.inertial(path, "Fused")
+        self.assertIsNotNone(c.get("fullinertia"))
+        self.assertEqual(c.get("mass"), f.get("mass"))
+        com = [float(x) for x in c.get("pos").split()]
+        self.assertAlmostEqual(com[0], (5 * 1000 + 105 * 6000) / 7000 * 0.001, places=6)  # not the box's 0.055
+        for x, y in zip(c.get("fullinertia").split(), f.get("fullinertia").split()):
+            self.assertAlmostEqual(float(x), float(y), delta=abs(float(y)) * 1e-6 + 1e-15)
+
+    def test_densities_and_masses_given(self):
+        import Part
+
+        for name in ("Floor_A", "PSU_A", "Worker"):
+            o = self.doc.addObject("Part::Feature", name)
+            o.Shape = Part.makeBox(100, 100, 100)  # 1e6 mm³ = 0.001 m³
+        w = self.doc.getObject("Worker")
+        w.addProperty("App::PropertyMass", "Mass")
+        w.Mass = 70.0
+        self.doc.recompute()
+        path = os.path.join(self.tmp, "d.json")
+        with open(path, "w", encoding="utf-8") as f:
+            f.write('{"density": {"Floor_*": 2700}, "mass": {"PSU_*": 0.3}}')
+        out = os.path.join(self.tmp, "d.xml")
+        rep = MjcfExport.export(self.doc, out, given=MjcfExport.load_density_map(path))
+        mass = {n: float(self.inertial(out, n).get("mass")) for n in ("Floor_A", "PSU_A", "Worker")}
+        self.assertAlmostEqual(mass["Floor_A"], 2.7, places=6)
+        self.assertAlmostEqual(mass["PSU_A"], 0.3, places=6)
+        self.assertAlmostEqual(mass["Worker"], 70.0, places=6)
+        self.assertEqual(rep["defaults"], [])
+
+
