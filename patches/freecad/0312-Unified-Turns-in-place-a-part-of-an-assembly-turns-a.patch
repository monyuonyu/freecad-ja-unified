index 40172a8b4..b15f61c39 100644
--- a/src/Mod/Unified/AssemblyCopies.py
+++ b/src/Mod/Unified/AssemblyCopies.py
@@ -97,3 +97,26 @@ def grid(obj, columns, rows, dx, dy):
         raise
     doc.commitTransaction()
     return out
+
+
+def hinge_to_ground(assembly, part, sub):
+    """A revolute joint between the round face or circle `sub` of `part` (a part of the assembly)
+    and the ground (the assembly's origin), where the part is now: a crank turns in place
+    without a case part to hold it. Returns the joint."""
+    import JointObject
+    import UtilsAssembly
+
+    group = UtilsAssembly.getJointGroup(assembly)
+    joint = group.newObject("App::FeaturePython", "Revolute")
+    JointObject.Joint(joint, JointObject.JointTypes.index("Revolute"))
+    joint.Label = App.Qt.translate("Unified", "Turns in place")
+    joint.Reference2 = (part, [sub, sub])
+    # the ground's side: the same place, fixed to the origin
+    where = part.Placement.multiply(joint.Placement2)
+    joint.Detach1 = True
+    joint.Reference1 = (assembly.Origin, ["", ""])
+    joint.Placement1 = where
+    if App.GuiUp:
+        JointObject.ViewProviderJoint(joint.ViewObject)
+    assembly.Document.recompute()
+    return joint
diff --git a/src/Mod/Unified/AssemblyCopiesGui.py b/src/Mod/Unified/AssemblyCopiesGui.py
index a10ab9cb9..710c81f31 100644
--- a/src/Mod/Unified/AssemblyCopiesGui.py
+++ b/src/Mod/Unified/AssemblyCopiesGui.py
@@ -220,5 +220,62 @@ def install():
         UnifiedChrome.EXTRA_FILTERS.append(_filter)
 
 
+class HingeToGroundCommand:
+    """One round face (or circle) of a part of an assembly: the part turns about it, in place"""
+
+    def GetResources(self):
+        return {
+            "Pixmap": "Assembly_CreateJointRevolute",
+            "MenuText": QT_TRANSLATE_NOOP("Unified_HingeToGround", "Turns in Place"),
+            "ToolTip": QT_TRANSLATE_NOOP(
+                "Unified_HingeToGround",
+                "The part turns about the picked round face, where it is now (held by the ground: "
+                "no other part is needed). Then “Turn to an angle” in the joint turns it.",
+            ),
+        }
+
+    def picked(self):
+        sel = Gui.Selection.getSelectionEx("", 0)
+        if len(sel) != 1 or len(sel[0].SubElementNames) != 1:
+            return None
+        obj, sub = sel[0].Object, sel[0].SubElementNames[0]
+        names = sub.split(".")
+        if obj.isDerivedFrom("Assembly::AssemblyObject"):
+            assembly = obj
+        else:
+            assembly = next((obj.Document.getObject(n) for n in names
+                             if obj.Document.getObject(n) is not None
+                             and obj.Document.getObject(n).isDerivedFrom("Assembly::AssemblyObject")), None)  # fmt: skip
+        if assembly is None:
+            return None
+        import UtilsAssembly
+
+        part, rel = UtilsAssembly.getComponentReference(assembly, obj, sub)
+        if part is None or not rel:
+            return None
+        element = rel.split(".")[-1]
+        if not (element.startswith("Face") or element.startswith("Edge")):
+            return None
+        return assembly, part, rel
+
+    def IsActive(self):
+        return not Gui.Control.activeDialog() and self.picked() is not None
+
+    def Activated(self):
+        found = self.picked()
+        if found is None:
+            return
+        assembly, part, sub = found
+        doc = assembly.Document
+        doc.openTransaction(translate("Unified", "Turns in place"))
+        try:
+            joint = AC.hinge_to_ground(assembly, part, sub)
+        finally:
+            doc.commitTransaction()
+        Gui.Selection.clearSelection()
+        Gui.Selection.addSelection(joint)
+
+
 Gui.addCommand("Unified_GridCopies", GridCopiesCommand())
 Gui.addCommand("Unified_AnotherPart", DuplicateCommand())
+Gui.addCommand("Unified_HingeToGround", HingeToGroundCommand())
