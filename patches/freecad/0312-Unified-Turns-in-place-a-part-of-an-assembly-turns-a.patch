diff --git a/src/Mod/Unified/TestAssemblySolve.py b/src/Mod/Unified/TestAssemblySolve.py
index 424418017..da9b2c57f 100644
--- a/src/Mod/Unified/TestAssemblySolve.py
+++ b/src/Mod/Unified/TestAssemblySolve.py
@@ -106,6 +106,34 @@ class AssemblySolveTest(unittest.TestCase):
         finally:
             App.closeDocument(doc.Name)
 
+    def test_hinge_to_ground(self):
+        # a crank turns in place on the ground (no case part); Turn to an angle turns it
+        import AssemblyCopies
+
+        doc = App.newDocument("ground")
+        try:
+            asm = doc.addObject("Assembly::AssemblyObject", "Assembly")
+            asm.Type = "Assembly"
+            asm.newObject("Assembly::JointGroup", "Joints")
+            crank = asm.newObject("Part::Cylinder", "Crank")
+            at = App.Placement(App.Vector(30, 20, 5), App.Rotation(App.Vector(1, 0, 0), 90))
+            crank.Placement = at
+            doc.recompute()
+            joint = AssemblyCopies.hinge_to_ground(asm, crank, "Face1")
+            self.assertEqual(asm.solve(), 0)
+            self.assertTrue(crank.Placement.isSame(at, 1e-9))
+            joint.AngleDriven = True
+            joint.Angle = 90
+            doc.recompute()
+            self.assertEqual(asm.solve(), 0)
+            self.assertTrue(crank.Placement.Base.isEqual(at.Base, 1e-9))
+            # turned 90 degrees about its own axis (the cylinder's z)
+            axis = at.Rotation.multVec(App.Vector(0, 0, 1))
+            self.assertTrue(crank.Placement.Rotation.multVec(App.Vector(0, 0, 1)).isEqual(axis, 1e-9))
+            self.assertAlmostEqual(math.degrees((at.Rotation.inverted() * crank.Placement.Rotation).Angle), 90, places=6)
+        finally:
+            App.closeDocument(doc.Name)
+
     def test_big_step_right_after_opening(self):
         # no solve that held is remembered in a file just opened: the walk starts where the parts are
         import os
