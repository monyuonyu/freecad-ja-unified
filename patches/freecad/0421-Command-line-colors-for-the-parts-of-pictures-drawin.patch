diff --git a/src/Mod/Part/PartViews.py b/src/Mod/Part/PartViews.py
index 472d0950a..b2586b36b 100644
--- a/src/Mod/Part/PartViews.py
+++ b/src/Mod/Part/PartViews.py
@@ -1270,6 +1270,46 @@ def _view_arg(view):
     return view
 
 
+def parse_color(text):
+    """'#rrggbb', 'r,g,b' (0..1, or 0..255 when any is above 1) -> (r, g, b) in 0..1"""
+    text = str(text).strip()
+    if text.startswith("#") and len(text) == 7:
+        return tuple(int(text[k:k + 2], 16) / 255.0 for k in (1, 3, 5))
+    rgb = _numbers(text, 3, "color")
+    return tuple(c / 255.0 for c in rgb) if any(c > 1 for c in rgb) else tuple(rgb)
+
+
+def cli_colors(doc, spec):
+    """--colors: a JSON file {pattern: colour} or 'Frame*=#808080;Screw*=200,40,40'. A pattern
+    (* and ? match any characters) is matched to the labels and names of the document's objects;
+    a later pattern wins over an earlier one. -> {object name: (r, g, b)}"""
+    import fnmatch
+    import json
+
+    if not spec:
+        return None
+    if os.path.isfile(spec):
+        with open(spec, encoding="utf-8-sig") as f:
+            pairs = list(json.load(f).items())
+    else:
+        pairs = []
+        for item in spec.split(";"):
+            if item.strip():
+                if "=" not in item:
+                    raise ValueError("--colors: write pattern=colour (e.g. Frame*=#808080): %r" % item)
+                pattern, color = item.rsplit("=", 1)
+                pairs.append((pattern.strip(), color))
+    out = {}
+    for pattern, color in pairs:
+        rgb = parse_color(color)
+        hit = [o for o in doc.Objects if fnmatch.fnmatchcase(o.Label, pattern) or fnmatch.fnmatchcase(o.Name, pattern)]
+        if not hit:
+            App.Console.PrintWarning("--colors: nothing matches %s\n" % pattern)
+        for o in hit:
+            out[o.Name] = rgb
+    return out
+
+
 def cli_main():
     """Run the command line options of this module (see the module docstring)."""
     doc = App.ActiveDocument
@@ -1281,11 +1321,12 @@ def cli_main():
     style = _config("RenderStyle") or "shaded"
     deflection = float(_config("RenderDeflection") or 0)
