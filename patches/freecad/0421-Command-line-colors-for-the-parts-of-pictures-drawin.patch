     png = _config("RenderFile")
     if png:
         views = [_view_arg(v) for v in _split_views(view)]
         for out in render(doc, png, view=views if len(views) > 1 else views[0], size=size, style=style,
-                          deflection=deflection, **view_kw):  # fmt: skip
+                          deflection=deflection, colors=colors, **view_kw):  # fmt: skip
             print("Wrote %s" % out)
     svg = _config("ExportSvg")
     poly = _config("ExportPolygons")
@@ -1296,7 +1337,7 @@ def cli_main():
                  "pptx": _edge_mode(edges, "outline")}  # fmt: skip
         need_edges = any(modes[k] == "all" for k, out in (("svg", svg), ("poly", poly), ("pptx", pptx)) if out)
         data = project(doc, view=_view_arg(_split_views(view)[0]), edges=need_edges, deflection=deflection,
-                       **view_kw)  # fmt: skip
+                       colors=colors, **view_kw)  # fmt: skip
         if not data.get("complete", True):
             App.Console.PrintWarning("Warning: %s\n" % data.get("warning", "incomplete"))
 
@@ -1318,7 +1359,7 @@ def cli_main():
 
         split = lambda v: [x.strip() for x in (v or "").split(",") if x.strip()]  # noqa: E731
         PartWebView.export(doc, web, deflection=deflection, exclude=split(_config("WebExclude")),
-                           simplify=split(_config("WebSimplify")))  # fmt: skip
