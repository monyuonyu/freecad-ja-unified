+                        for (auto& wire : shape.getSubTopoShapes(TopAbs_WIRE)) {
+                            if (!wire.isClosed()) {
+                                allClosed = false;
+                                break;
+                            }
+                            closed.push_back(TopoDS::Wire(wire.getShape()));
+                        }
+                        if (allClosed) {
+                            crossing = facesOfCrossingOutlines(closed);
+                        }
+                    }
+                    if (!crossing.IsNull()) {
+                        TopoShape faces(crossing);
+                        faces.Hasher = shape.Hasher;
+                        shape = faces;
