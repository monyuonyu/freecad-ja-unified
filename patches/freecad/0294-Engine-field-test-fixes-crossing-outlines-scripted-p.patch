+namespace
+{
+// Closed outlines of a sketch that cross each other (a connecting rod: two eyes and the web
+// between them, overlapping both). The usual face maker takes them as nested and the result
+// was only a part of the shape, without a word (engine field test 0.6.9). The faces of the
+// outlines are combined as most CAD do: the outer ones joined, the ones inside another
+// outline cut out (and so on, inside a hole: an island).
+TopoDS_Shape facesOfCrossingOutlines(const std::vector<TopoDS_Wire>& wires)
+{
+    if (wires.size() < 2) {
+        return {};
+    }
+    const double tol = Precision::Confusion() * 10;
+    bool crossing = false;
+    for (size_t i = 0; i < wires.size() && !crossing; ++i) {
+        for (size_t j = i + 1; j < wires.size() && !crossing; ++j) {
+            BRepExtrema_DistShapeShape dist(wires[i], wires[j]);
+            if (dist.IsDone() && dist.Value() <= tol) {
+                crossing = true;
+            }
+        }
+    }
+    if (!crossing) {
+        return {};
+    }
+    std::vector<TopoDS_Face> faces;
+    for (const auto& w : wires) {
+        BRepBuilderAPI_MakeFace mk(w, Standard_True);
+        if (!mk.IsDone()) {
+            return {};
+        }
+        TopoDS_Face f = mk.Face();
+        GProp_GProps props;
+        BRepGProp::SurfaceProperties(f, props);
+        if (props.Mass() < 0) {
+            f.Reverse();
+        }
+        faces.push_back(f);
+    }
+    // How deep each outline lies: inside how many other faces (a point of it inside, and not
+    // touching that one's outline)
+    std::vector<int> depth(wires.size(), 0);
+    for (size_t i = 0; i < wires.size(); ++i) {
+        TopExp_Explorer ex(wires[i], TopAbs_VERTEX);
+        if (!ex.More()) {
+            continue;
+        }
+        gp_Pnt p = BRep_Tool::Pnt(TopoDS::Vertex(ex.Current()));
+        for (size_t j = 0; j < wires.size(); ++j) {
+            if (i == j) {
+                continue;
+            }
+            BRepExtrema_DistShapeShape dist(wires[i], wires[j]);
+            if (dist.IsDone() && dist.Value() <= tol) {
+                continue;  // crossing: side by side, not inside
+            }
+            BRepClass_FaceClassifier cls(faces[j], p, tol);
+            if (cls.State() == TopAbs_IN) {
+                ++depth[i];
+            }
+        }
+    }
+    int deepest = *std::max_element(depth.begin(), depth.end());
+    TopoDS_Shape result;
+    for (int d = 0; d <= deepest; ++d) {
+        TopTools_ListOfShape tools;
+        for (size_t i = 0; i < faces.size(); ++i) {
+            if (depth[i] == d) {
+                tools.Append(faces[i]);
+            }
+        }
+        if (tools.IsEmpty()) {
+            continue;
+        }
+        if (result.IsNull()) {
+            // the outer ones joined
+            TopoDS_Shape joined = tools.First();
+            TopTools_ListOfShape rest(tools);
+            rest.RemoveFirst();
+            if (!rest.IsEmpty()) {
+                BRepAlgoAPI_Fuse fuse;
+                TopTools_ListOfShape args;
+                args.Append(joined);
+                fuse.SetArguments(args);
+                fuse.SetTools(rest);
+                fuse.Build();
+                if (!fuse.IsDone()) {
+                    return {};
+                }
+                joined = fuse.Shape();
+            }
+            result = joined;
+        }
+        else if (d % 2 == 1) {
+            BRepAlgoAPI_Cut cut;
+            TopTools_ListOfShape args;
+            args.Append(result);
+            cut.SetArguments(args);
+            cut.SetTools(tools);
+            cut.Build();
+            if (!cut.IsDone()) {
+                return {};
+            }
+            result = cut.Shape();
+        }
+        else {
+            BRepAlgoAPI_Fuse fuse;
+            TopTools_ListOfShape args;
+            args.Append(result);
+            fuse.SetArguments(args);
+            fuse.SetTools(tools);
+            fuse.Build();
+            if (!fuse.IsDone()) {
+                return {};
+            }
+            result = fuse.Shape();
+        }
+    }
+    if (result.IsNull()) {
+        return {};
+    }
+    ShapeUpgrade_UnifySameDomain unify(result, Standard_True, Standard_True, Standard_False);
+    unify.Build();
+    return unify.Shape();
+}
+}  // namespace
