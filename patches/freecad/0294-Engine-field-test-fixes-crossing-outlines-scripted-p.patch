+++ b/src/Mod/Unified/TestPartDesignFixes.py
@@ -0,0 +1,96 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+# Steps of a part that silently went wrong (engine field test 0.6.9), headless:
+#   FreeCADCmd -t TestPartDesignFixes
+
+import unittest
+
+import FreeCAD as App
+import Part
+
+V = App.Vector
+
+
+def circle(sk, c, r):
+    sk.addGeometry(Part.Circle(V(c[0], c[1], 0), V(0, 0, 1), r))
+
+
+class PartDesignFixesTest(unittest.TestCase):
+    def setUp(self):
+        self.doc = App.newDocument("PartDesignFixes")
+        self.body = self.doc.addObject("PartDesign::Body", "Body")
+
+    def tearDown(self):
+        App.closeDocument(self.doc.Name)
+
+    def sketch(self):
+        sk = self.body.newObject("Sketcher::SketchObject", "Sketch")
+        sk.AttachmentSupport = (self.body.Origin.OriginFeatures[3], [""])
+        sk.MapMode = "FlatFace"
+        return sk
+
+    def test_crossing_outlines_are_joined(self):
+        # a connecting rod: two eyes and a web over both, the bores inside the eyes
+        sk = self.sketch()
+        circle(sk, (0, 0), 20)
+        circle(sk, (100, 0), 12)
+        circle(sk, (0, 0), 8)
+        circle(sk, (100, 0), 5)
+        pts = [V(10, -12, 0), V(95, -7, 0), V(95, 7, 0), V(10, 12, 0)]
+        for i in range(4):
+            sk.addGeometry(Part.LineSegment(pts[i], pts[(i + 1) % 4]))
+        pad = self.body.newObject("PartDesign::Pad", "Pad")
+        pad.Profile = sk
+        pad.Length = 15
+        self.doc.recompute()
+        f = [Part.Face(Part.Wire(Part.Circle(V(0, 0, 0), V(0, 0, 1), 20).toShape())),
+             Part.Face(Part.Wire(Part.Circle(V(100, 0, 0), V(0, 0, 1), 12).toShape())),
+             Part.Face(Part.makePolygon(pts + [pts[0]]))]
+        want = f[0].fuse(f[1]).fuse(f[2]).removeSplitter()
+        want = want.cut(Part.Face(Part.Wire(Part.Circle(V(0, 0, 0), V(0, 0, 1), 8).toShape())))
+        want = want.cut(Part.Face(Part.Wire(Part.Circle(V(100, 0, 0), V(0, 0, 1), 5).toShape())))
+        self.assertTrue(pad.Shape.isValid())
+        self.assertEqual(len(pad.Shape.Solids), 1)
+        self.assertAlmostEqual(pad.Shape.Volume, want.Area * 15, delta=1.0)
+
+    def test_nested_outlines_unchanged(self):
+        # a ring: as before (the usual face maker)
+        sk = self.sketch()
+        circle(sk, (0, 0), 20)
+        circle(sk, (0, 0), 10)
+        pad = self.body.newObject("PartDesign::Pad", "Pad")
+        pad.Profile = sk
+        pad.Length = 5
+        self.doc.recompute()
+        self.assertAlmostEqual(pad.Shape.Volume, 3.141592653589793 * (400 - 100) * 5, delta=0.5)
+
+    def test_pattern_made_by_a_script_is_the_end(self):
+        sk = self.sketch()
+        circle(sk, (20, 0), 5)
+        pad = self.body.newObject("PartDesign::Pad", "Pad")
+        pad.Profile = sk
+        pad.Length = 5
+        self.doc.recompute()
+        for kind, setup in (
+            ("PartDesign::Mirrored", lambda o: setattr(o, "MirrorPlane", (self.body.Origin.OriginFeatures[5], [""]))),
+            ("PartDesign::PolarPattern", lambda o: (setattr(o, "Axis", (self.body.Origin.OriginFeatures[2], [""])),
+                                                    setattr(o, "Occurrences", 3))),
+        ):
+            last = self.body.Tip
+            f = self.body.newObject(kind, kind.split("::")[1])
+            f.Originals = [pad]
+            setup(f)
+            self.doc.recompute()
+            self.assertIs(self.body.Tip, f, kind)
+            self.assertIs(f.BaseFeature, last, kind)
+        # the next step builds on the pattern: one solid
+        sk2 = self.sketch()
+        circle(sk2, (0, 0), 30)
+        pad2 = self.body.newObject("PartDesign::Pad", "Pad001")
+        pad2.Profile = sk2
+        pad2.Length = 2
