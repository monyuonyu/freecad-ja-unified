diff --git a/src/Mod/Draft/importDXF.py b/src/Mod/Draft/importDXF.py
index 2424ee005..4d25fc744 100644
--- a/src/Mod/Draft/importDXF.py
+++ b/src/Mod/Draft/importDXF.py
@@ -2834,6 +2834,62 @@ def warn(dxfobject, num=None):
     badobjects.append(dxfobject)
 
 
+def _import_acis_entities(doc, filename):
+    """Add the 3DSOLID, REGION and BODY entities of the model space (ACIS data, which
+    neither importer reads) as Part features, on their layers.  Uses Part's AcisSat
+    (planes, cylinders, cones, spheres, tori, B-spline surfaces).  Returns the number of
+    objects made."""
+    try:
+        import AcisSat
+    except ImportError:
+        return 0
+    try:
+        entities = AcisSat.read_dxf(filename)
+    except Exception as e:
+        FreeCAD.Console.PrintWarning("DXF: ACIS solids not read: %s\n" % e)
+        return 0
+    layers = {}
+    for obj in doc.Objects:
+        if hasattr(obj, "Group") and (
+            obj.TypeId == "App::FeaturePython" and "Layer" in obj.Name or obj.TypeId == "App::DocumentObjectGroup"
+        ):
+            layers.setdefault(obj.Label, obj)
+    made = failed = 0
+    names = {"3DSOLID": "Solid", "REGION": "Region", "BODY": "Body"}
+    for ent in entities:
+        if ent.get("paperspace"):
+            continue
+        for k, (shape, problems) in enumerate(ent["shapes"]):
+            if shape is None or shape.isNull():
+                failed += 1
+                FreeCAD.Console.PrintWarning(
+                    "DXF: %s %s not imported: %s\n" % (ent["type"], ent["handle"], "; ".join(problems))
+                )
+                continue
+            obj = doc.addObject("Part::Feature", names.get(ent["type"], "Solid"))
+            obj.Shape = shape
+            obj.Label = "%s_%s" % (names.get(ent["type"], "Solid"), ent["handle"])
+            if problems:
+                FreeCAD.Console.PrintLog(
+                    "DXF: %s %s: %s\n" % (ent["type"], ent["handle"], "; ".join(problems))
+                )
+            layer = layers.get(ent.get("layer"))
+            if layer is not None:
+                try:
+                    if hasattr(layer, "Proxy") and hasattr(layer.Proxy, "addObject"):
+                        layer.Proxy.addObject(layer, obj)
+                    else:
+                        layer.addObject(obj)
+                except Exception:
+                    pass
+            made += 1
+    if made or failed:
+        FreeCAD.Console.PrintMessage(
+            "DXF: %d ACIS solid(s)/region(s) imported%s\n" % (made, ", %d failed" % failed if failed else "")
+        )
+    return made
+
+
 def _import_dxf_file(filename, doc_name=None):
     """
     Internal helper to handle the core logic for both open and insert.
@@ -2925,6 +2981,9 @@ def _import_dxf_file(filename, doc_name=None):
         draft_postprocessor = DxfDraftPostProcessor(doc, newly_created_objects, import_mode)
         draft_postprocessor.run()
 
+    if hGrp.GetBool("dxfImportAcis", True):
+        _import_acis_entities(doc, filename)
+
     make_text.convert_draft_texts()  # This is a general utility that should run for both importers
     doc.recompute()
 
diff --git a/src/Mod/Part/AcisSat.py b/src/Mod/Part/AcisSat.py
new file mode 100644
index 000000000..eda9a79a6
--- /dev/null
+++ b/src/Mod/Part/AcisSat.py
@@ -0,0 +1,1142 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+# ***************************************************************************
+# *   This file is part of the FreeCAD CAx development system.              *
+# *                                                                         *
+# *   This library is free software; you can redistribute it and/or         *
+# *   modify it under the terms of the GNU Library General Public           *
+# *   License as published by the Free Software Foundation; either          *
+# *   version 2 of the License, or (at your option) any later version.      *
+# ***************************************************************************
+"""A minimal reader of ACIS SAT text (the 3DSOLID, REGION and BODY of DXF
+and DWG files) into OpenCASCADE shapes.
+
+The boundary representation is rebuilt face by face: the surface of the
+face, the 3D curves of its edges trimmed at the vertices, a wire per loop,
+then the faces are sewn and closed shells become solids.
+
+Supported: plane, cone (cylinder and cone, also with an elliptic base),
+sphere, torus and spline surfaces (the B-spline of the subtype: exact, or
+the approximation stored with procedural surfaces); straight, ellipse and
+intcurve curves (the B-spline of the subtype). Everything else is reported,
+never raised.
+
+    import AcisSat
+    for shape, problems in AcisSat.read(sat_text):
+        ...
+"""
+
+import math
+import re
+
+import FreeCAD
+import Part
+
+__all__ = [
+    "read",
+    "decode_dxf_text",
+    "shapes_from_dxf_entity",
+    "read_dxf",
+    "AcisError",
+]
+
+V = FreeCAD.Vector
+
+
+class AcisError(Exception):
+    pass
+
+
+# --------------------------------------------------------------------------
+# DXF side: group codes 1 and 3, the "encryption" of the text
+# --------------------------------------------------------------------------
+
+
+def _decipher(s):
+    return "".join(chr(159 - ord(c)) if ord(c) > 32 else c for c in s)
+
+
+def decode_dxf_text(code_values):
+    """The SAT text of the group 1 (a line) and 3 (continuation of the line)
+    values of a DXF 3DSOLID/REGION/BODY, deciphered when needed.
+
+    code_values: iterable of (code, value) pairs; other codes are ignored.
+    Plain strings are taken as group 1 lines."""
+    lines = []
+    for item in code_values:
+        if isinstance(item, str):
+            code, value = 1, item
+        else:
+            code, value = item
+        code = int(code)
+        if code not in (1, 3):
+            continue
+        value = value.rstrip("\r\n").replace("^ ", "^")
+        if code == 3 and lines:
+            lines[-1] += value
+        else:
+            lines.append(value)
+    text = "\n".join(lines)
+    head = text.lstrip()
+    if head and not head[0].isdigit():
+        text = _decipher(text)
+    return text
+
+
+# --------------------------------------------------------------------------
+# SAT text: header, records, subtypes
+# --------------------------------------------------------------------------
+
+_END_MARKS = (
+    "End-of-ACIS-data",
+    "Begin-of-ACIS-History-Data",
+    "Begin-of-ASM-History-Data",
+    "End-of-ASM-data",
+    "End-of-ACIS-History-Section",
+)
+_RE_NUM = re.compile(r"^[-+]?(\d+\.?\d*|\.\d+)([eE][-+]?\d+)?$")
+
+
+def _is_num(tok):
+    return isinstance(tok, str) and _RE_NUM.match(tok) is not None
+
+
+def _is_ptr(tok):
+    return isinstance(tok, str) and len(tok) > 1 and tok[0] == "$"
+
+
+class _Str(str):
+    """A string value (@N or counted), never a keyword"""
+
+
+def _tokens(text, pos):
+    """Yields the tokens of the text from pos, @N strings as one _Str"""
+    n = len(text)
+    while True:
+        while pos < n and text[pos].isspace():
+            pos += 1
+        if pos >= n:
+            return
+        if text[pos] == "@":
+            m = re.match(r"@(\d+) ", text[pos:])
+            if m:
+                start = pos + m.end()
+                yield _Str(text[start : start + int(m.group(1))])
+                pos = start + int(m.group(1))
+                continue
+        start = pos
+        while pos < n and not text[pos].isspace():
+            pos += 1
+        tok = text[start:pos]
+        if len(tok) > 1 and tok.endswith("#") and not tok.startswith("$"):
+            yield tok[:-1]
+            tok = "#"
+        yield tok
+
+
+class _Record:
+    __slots__ = ("index", "name", "type", "toks")
+
+    def __init__(self, index, name, toks):
+        self.index = index
+        self.name = name
+        self.toks = toks
+        self.type = _base_type(name)
+
+
+def _base_type(name):
+    if name.endswith("-attrib") or name == "attrib":
+        return "attrib"
+    for t in ("surface", "curve"):
+        if name.endswith("-" + t):
+            return name  # e.g. plane-surface, straight-curve
+    return name
+
+
+class _Sat:
+    """The parsed SAT text: version, units and records"""
+
+    def __init__(self, text):
+        self.problems = []
+        self.version = 0
+        self.units = 1.0
+        self.records = []
+        self.subtypes = []  # the token lists of the subtype definitions
+        self._parse(text)
+
+    def _parse(self, text):
+        m = re.match(r"\s*(\d+)[ \t]*([^\n]*)\n", text)
+        if not m:
+            raise AcisError("not ACIS SAT text (no version line)")
+        self.version = int(m.group(1))
+        pos = m.end()
+        if self.version >= 200:
+            # product, ACIS version, date: counted strings; then units line
+            line_end = text.find("\n", pos)
+            pos = line_end + 1 if line_end >= 0 else len(text)
+            m = re.match(r"\s*(\S+)\s+(\S+)\s+(\S+)[^\n]*\n?", text[pos:])
+            if m and _is_num(m.group(1)):
+                self.units = float(m.group(1))
+                pos += m.end()
+        index = 0
+        toks = []
+        name = None
+        depth = 0
+        for tok in _tokens(text, pos):
+            if name is None:
+                if tok in _END_MARKS or tok.startswith("End-of-") or tok.startswith("Begin-of-"):
+                    break
+                if re.match(r"^-\d+$", tok):  # explicit record number
+                    index = -int(tok)
+                    continue
+                name = tok
+                toks = []
+                depth = 0
+                continue
+            if tok == "#" and depth == 0 and not isinstance(tok, _Str):
+                self.records.append(_Record(index, name, toks))
+                index += 1
+                name = None
+                continue
+            if tok == "{" and not isinstance(tok, _Str):
+                depth += 1
+            elif tok == "}" and not isinstance(tok, _Str):
+                depth -= 1
+            toks.append(tok)
+        if name is not None:
+            self.problems.append("SAT text ends inside record '%s'" % name)
+        self.by_index = {r.index: r for r in self.records}
+        # the length of the record head: attribute (and the history data
+        # since ACIS 7.0), from the points, which have just 3 values
+        head = 1 if self.version < 700 else 3
+        for r in self.records:
+            if r.name == "point":
+                n = len(r.toks) - 3
+                if 1 <= n <= 3:
+                    head = n
+                break
+        self.head = head
+        # the subtype definitions, numbered as they come, for "{ ref N }"
+        for r in self.records:
+            toks = r.toks
+            for i, t in enumerate(toks):
+                if t == "{" and not isinstance(t, _Str):
+                    if i + 1 < len(toks) and toks[i + 1] != "ref":
+                        self.subtypes.append(_subtype_tokens(toks, i))
+
+    def get(self, tok):
+        if not _is_ptr(tok):
+            return None
+        try:
+            i = int(tok[1:])
+        except ValueError:
+            return None
+        if i < 0:
+            return None
+        return self.by_index.get(i)
+
+    def fields(self, rec):
+        return rec.toks[self.head :]
+
+    def ptrs(self, rec, typ):
+        """The records of type typ pointed to by the fields of rec"""
+        out = []
+        for t in self.fields(rec):
+            r = self.get(t)
+            if r is not None and (r.type == typ or (typ.startswith("*") and r.type.endswith(typ[1:]))):
+                out.append(r)
+        return out
+
+    def ptr(self, rec, typ):
+        p = self.ptrs(rec, typ)
+        return p[0] if p else None
+
+
+def _subtype_tokens(toks, i):
+    """The tokens inside the subtype starting with '{' at i (without the
+    braces)"""
+    depth = 0
+    for j in range(i, len(toks)):
+        t = toks[j]
+        if isinstance(t, _Str):
+            continue
+        if t == "{":
+            depth += 1
+        elif t == "}":
+            depth -= 1
+            if depth == 0:
+                return toks[i + 1 : j]
+    return toks[i + 1 :]
+
+
+# --------------------------------------------------------------------------
+# Reading values
+# --------------------------------------------------------------------------
+
+
+class _Cursor:
+    def __init__(self, toks, i=0):
+        self.toks = toks
+        self.i = i
+
+    def peek(self):
+        return self.toks[self.i] if self.i < len(self.toks) else None
+
+    def next(self):
+        t = self.peek()
+        self.i += 1
+        return t
+
+    def num(self):
+        t = self.next()
+        if not _is_num(t):
+            raise AcisError("number expected, got %r" % (t,))
+        return float(t)
+
+    def int(self):
+        return int(round(self.num()))
+
+    def vec(self):
+        return V(self.num(), self.num(), self.num())
+
+    def interval_bound(self):
+        t = self.next()
+        if t == "F" and _is_num(self.peek()):
+            self.next()
+        # "I" infinite; anything else is taken as a bound without value
+
+    def word(self):
+        return self.next()
+
+
+# "I"/"F": the logicals as LibreDWG's SAB -> SAT conversion of R2013+ solids writes
+# them in coedges (true / false)
+_REVERSED = ("reversed", "reverse_v", "1", "I")
+
+
+# --------------------------------------------------------------------------
+# B-splines of subtypes
+# --------------------------------------------------------------------------
+
+
+def _resolve_subtype(sat, toks):
+    """The tokens of the first subtype in toks, with { ref N } resolved"""
+    for i, t in enumerate(toks):
+        if t == "{" and not isinstance(t, _Str):
+            sub = _subtype_tokens(toks, i)
+            for _ in range(32):
+                if len(sub) >= 2 and sub[0] == "ref" and _is_num(sub[1]):
+                    n = int(sub[1])
+                    if n < 0 or n >= len(sat.subtypes):
+                        raise AcisError("subtype ref %d out of range" % n)
+                    sub = sat.subtypes[n]
+                else:
+                    break
+            return sub
+    return None
+
+
+def _top_level_indexes(sub, words):
+    """Indexes of the tokens in words at the top level of the subtype"""
+    depth = 0
+    out = []
+    for i, t in enumerate(sub):
+        if isinstance(t, _Str):
+            continue
+        if t == "{":
+            depth += 1
+        elif t == "}":
+            depth -= 1
+        elif depth == 0 and t in words:
+            out.append(i)
+    return out
+
+
+def _read_knots(c, count):
+    knots, mults = [], []
+    for _ in range(count):
+        knots.append(c.num())
+        mults.append(c.int())
+    return knots, mults
+
+
+def _occ_mults(mults, degree, closure):
+    """ACIS (AG) end knots have the multiplicity degree, OCC degree+1"""
+    m = list(mults)
+    if closure != "periodic":
+        if m[0] == degree:
+            m[0] += 1
+        if m[-1] == degree:
+            m[-1] += 1
+    return m
+
+
+def _bs3_curve(sub):
+    """The B-spline of a curve subtype (exactcur, the approximation of
+    int_int_cur, ...), or None for nullbs"""
+    for i in _top_level_indexes(sub, ("nubs", "nurbs", "nullbs")):
+        if sub[i] == "nullbs":
+            return None
+        try:
+            return _read_bs3_curve(_Cursor(sub, i))
+        except (AcisError, Part.OCCError, ValueError, IndexError) as e:
+            last = e
+            continue
+    if "last" in locals():
+        raise AcisError("bad bs3 curve: %s" % last)
+    return None
+
+
+def _read_bs3_curve(c):
+    rational = c.next() == "nurbs"
+    degree = c.int()
+    closure = "open"
+    if not _is_num(c.peek()):
+        closure = c.word()
+    nknots = c.int()
+    knots, mults = _read_knots(c, nknots)
+    m = _occ_mults(mults, degree, closure)
+    npoles = sum(m) - degree - 1
+    if closure == "periodic":
+        npoles = sum(m) - m[-1]
+    if npoles < 2 or npoles > 100000:
+        raise AcisError("bad pole count %d" % npoles)
+    poles, weights = [], []
+    for _ in range(npoles):
+        poles.append(c.vec())
+        weights.append(c.num() if rational else 1.0)
+    bs = Part.BSplineCurve()
+    bs.buildFromPolesMultsKnots(poles, m, knots, closure == "periodic", degree, weights)
+    return bs
+
+
+def _bs3_surface(sub):
+    """The B-spline of a surface subtype: exactsur, or the approximation
+    of a procedural surface; None if there is none"""
+    last = None
+    for i in _top_level_indexes(sub, ("nubs", "nurbs", "nullbs")):
+        if sub[i] == "nullbs":
+            continue
+        try:
+            return _read_bs3_surface(_Cursor(sub, i))
+        except (AcisError, Part.OCCError, ValueError, IndexError) as e:
+            last = e
+    if last is not None:
+        raise AcisError("bad bs3 surface: %s" % last)
+    return None
+
+
+def _read_bs3_surface(c):
+    rational = c.next() == "nurbs"
+    du, dv = c.int(), c.int()
+    words = []
+    while not _is_num(c.peek()):
+        words.append(c.word())
+        if len(words) > 6:
+            raise AcisError("not a surface")
+    if len(words) < 2:
+        raise AcisError("not a surface")
+    clu, clv = words[0], words[1]
+    nku, nkv = c.int(), c.int()
+    ku, mu = _read_knots(c, nku)
+    kv, mv = _read_knots(c, nkv)
+    mu = _occ_mults(mu, du, clu)
+    mv = _occ_mults(mv, dv, clv)
+    nu = sum(mu) - du - 1 if clu != "periodic" else sum(mu) - mu[-1]
+    nv = sum(mv) - dv - 1 if clv != "periodic" else sum(mv) - mv[-1]
+    if nu < 2 or nv < 2 or nu * nv > 1000000:
+        raise AcisError("bad pole count")
+    poles, weights = [], []
+    for _ in range(nu * nv):
+        poles.append(c.vec())
+        weights.append(c.num() if rational else 1.0)
+    out = []
+    for transposed in (False, True):
+        if transposed:
+            grid = [[poles[j * nu + i] for j in range(nv)] for i in range(nu)]
+            wgt = [[weights[j * nu + i] for j in range(nv)] for i in range(nu)]
+        else:
+            grid = [poles[i * nv : (i + 1) * nv] for i in range(nu)]
+            wgt = [weights[i * nv : (i + 1) * nv] for i in range(nu)]
+        s = Part.BSplineSurface()
+        s.buildFromPolesMultsKnots(
+            grid, mu, mv, ku, kv, clu == "periodic", clv == "periodic", du, dv, wgt
+        )
+        out.append(s)
+    return out  # both orders of the poles, chosen by fit to the vertices
+
+
+# --------------------------------------------------------------------------
+# Geometry
+# --------------------------------------------------------------------------
+
+
+def _curve(sat, rec):
+    """The Part curve of an ACIS curve record (in its own direction)"""
+    c = _Cursor(sat.fields(rec))
+    if rec.name == "straight-curve":
+        root, d = c.vec(), c.vec()
+        if d.Length < 1e-300:
+            raise AcisError("straight-curve without direction")
+        return Part.Line(root, root + d)
+    if rec.name == "ellipse-curve":
+        center, normal, major = c.vec(), c.vec(), c.vec()
+        ratio = c.num()
+        r = major.Length
+        if normal.Length < 1e-300 or r < 1e-300:
+            raise AcisError("degenerate ellipse-curve")
+        normal.normalize()
+        if abs(ratio - 1.0) < 1e-12:
+            circ = Part.Circle(center, normal, r)
+            # start the parameter at the major axis, as ACIS
+            circ.XAxis = major
+            return circ
+        minor = normal.cross(major)
+        minor.normalize()
+        minor = minor * (r * abs(ratio))
+        if abs(ratio) > 1.0:
+            # Part.Ellipse wants major >= minor: swap, keep the direction
+            e = Part.Ellipse(center + minor, center - major, center)
+        else:
+            e = Part.Ellipse(center + major, center + minor, center)
+        if e.Axis.dot(normal) < 0:
+            e.reverse()
+        return e
+    if rec.name == "intcurve-curve":
+        sense = c.word()
+        sub = _resolve_subtype(sat, rec.toks)
+        if sub is None:
+            raise AcisError("intcurve without subtype")
+        bs = _bs3_curve(sub)
+        if bs is None:
+            raise AcisError("intcurve '%s' without B-spline data" % (sub[0] if sub else "?"))
+        if sense in _REVERSED:
+            bs.reverse()
+        return bs
+    raise AcisError("unsupported curve '%s'" % rec.name)
+
+
+def _surfaces(sat, rec):
+    """Candidate Part surfaces of an ACIS surface record; the caller takes
+    the one through the vertices of the face"""
+    c = _Cursor(sat.fields(rec))
+    name = rec.name
+    if name == "plane-surface":
+        root, normal = c.vec(), c.vec()
+        return [Part.Plane(root, normal)]
+    if name == "cone-surface":
+        center, axis, major = c.vec(), c.vec(), c.vec()
+        ratio = c.num()
+        c.interval_bound()
+        c.interval_bound()
+        sina, cosa = c.num(), c.num()
+        if axis.Length < 1e-300:
+            raise AcisError("cone without axis")
+        axis.normalize()
+        r = major.Length
+        if abs(sina) < 1e-12:  # cylinder
+            if abs(abs(ratio) - 1.0) < 1e-12:
+                cyl = Part.Cylinder()
+                cyl.Center = center
+                cyl.Axis = axis
+                cyl.Radius = r
+                return [cyl]
+            ell = _curve_ellipse(center, axis, major, ratio)
+            return [Part.SurfaceOfExtrusion(ell, axis)]
+        cands = []
+        tan = sina / cosa if abs(cosa) > 1e-300 else 1e12
+        for t in (tan, -tan):
+            if r + t > 0:
+                cone = Part.Cone(center, center + axis, r, r + t)
+            else:
+                cone = Part.Cone(center, center - axis, r, r - t)
+            if abs(abs(ratio) - 1.0) > 1e-12:
+                cone = _squash(cone, center, axis, major, abs(ratio))
+            cands.append(cone)
+        return cands
+    if name == "sphere-surface":
+        center = c.vec()
+        radius = c.num()
+        udir, pole = c.vec(), c.vec()
+        s = Part.Sphere()
+        s.Radius = abs(radius)
+        s.Center = center
+        if pole.Length > 1e-300:
+            s.Axis = pole
+        return [s]
+    if name == "torus-surface":
+        center, normal = c.vec(), c.vec()
+        major, minor = c.num(), c.num()
+        t = Part.Toroid()
+        t.MajorRadius = abs(major)
+        t.MinorRadius = abs(minor)
+        t.Center = center
+        if normal.Length > 1e-300:
+            t.Axis = normal
+        return [t]
+    if name == "spline-surface":
+        sub = _resolve_subtype(sat, rec.toks)
+        if sub is None:
+            raise AcisError("spline-surface without subtype")
+        res = _bs3_surface(sub)
+        if not res:
+            raise AcisError(
+                "spline-surface '%s' without B-spline data" % (sub[0] if sub else "?")
+            )
+        return res
+    raise AcisError("unsupported surface '%s'" % name)
+
+
+def _curve_ellipse(center, axis, major, ratio):
+    minor = axis.cross(major)
+    minor.normalize()
+    minor = minor * (major.Length * abs(ratio))
+    if abs(ratio) > 1.0:
+        return Part.Ellipse(center + minor, center - major, center)
+    return Part.Ellipse(center + major, center + minor, center)
+
+
+def _squash(cone, center, axis, major, ratio):
+    """An elliptic cone: the circular cone as B-spline, scaled by ratio in
+    the direction of the minor axis"""
+    bs = cone.toBSpline(0, 2 * math.pi, -1e3 * major.Length, 1e3 * major.Length)
+    minor = axis.cross(major)
+    minor.normalize()
+    for i in range(1, bs.NbUPoles + 1):
+        for j in range(1, bs.NbVPoles + 1):
+            p = bs.getPole(i, j)
+            d = (p - center).dot(minor)
+            bs.setPole(i, j, p - minor * (d * (1.0 - ratio)), bs.getWeight(i, j))
+    return bs
+
+
+def _dist_to_surface(surf, points):
+    worst = 0.0
+    for p in points:
+        try:
+            u, v = surf.parameter(p)
+            d = (surf.value(u, v) - p).Length
+        except Exception:
+            return float("inf")
+        worst = max(worst, d)
+    return worst
+
+
+# --------------------------------------------------------------------------
+# Topology
+# --------------------------------------------------------------------------
+
+
+class _Builder:
+    def __init__(self, sat):
+        self.sat = sat
+        self.problems = []
+        self.edges = {}  # edge record index -> Part.Edge (start to end)
+        self.curves = {}
+        self.tol = 1e-6
+        self.apexes = []
+        self.loops = {}  # face record index -> its loop records
+        for r in sat.records:
+            if r.type == "loop":
+                f = sat.ptr(r, "face")
+                if f is not None:
+                    self.loops.setdefault(f.index, []).append(r)
+
+    def warn(self, msg):
+        if msg not in self.problems:
+            self.problems.append(msg)
+
+    def point(self, vertex):
+        p = self.sat.ptr(vertex, "point") if vertex is not None else None
+        if p is None:
+            raise AcisError("vertex without point")
+        return _Cursor(self.sat.fields(p)).vec()
+
+    def curve(self, rec):
+        if rec.index not in self.curves:
+            self.curves[rec.index] = _curve(self.sat, rec)
+        return self.curves[rec.index]
+
+    def edge(self, rec):
+        """The Part edge of an ACIS edge, from its start to its end vertex"""
+        if rec.index in self.edges:
+            return self.edges[rec.index]
+        sat = self.sat
+        verts = sat.ptrs(rec, "vertex")
+        if not verts:
+            raise AcisError("edge without vertices")
+        ps = self.point(verts[0])
+        pe = self.point(verts[1]) if len(verts) > 1 else ps
+        crec = sat.ptr(rec, "*-curve")
+        f = sat.fields(rec)
+        sense = "forward"
+        if crec is not None:
+            k = f.index("$%d" % crec.index)
+            for t in f[k + 1 :]:
+                if t in ("forward", "reversed", "0", "1", "F", "I"):
+                    sense = t
+                    break
+        if crec is None:
+            if (ps - pe).Length < self.tol:
+                raise AcisError("edge without curve")
+            e = Part.LineSegment(ps, pe).toShape()
+            self.edges[rec.index] = e
+            return e
+        crv = self.curve(crec)
+        rev = sense in _REVERSED
+        a, b = (pe, ps) if rev else (ps, pe)
+        ta, tb = crv.parameter(a), crv.parameter(b)
+        closed = (ps - pe).Length < self.tol
+        if crv.isPeriodic():
+            per = crv.period()
+            if closed:
+                tb = ta + per
+            else:
+                while tb <= ta:
+                    tb += per
+                while tb - ta > per:
+                    tb -= per
+        elif closed and isinstance(crv, Part.BSplineCurve):
+            ta, tb = crv.FirstParameter, crv.LastParameter
+            if rev:
+                pass
+        if tb <= ta:
+            if isinstance(crv, Part.BSplineCurve) and not closed:
+                ta, tb = tb, ta
+                rev = not rev
+            else:
+                raise AcisError("edge with an empty parameter range on %s" % crec.name)
+        e = Part.Edge(crv, ta, tb)
+        if rev:
+            e.reverse()
+        self.edges[rec.index] = e
+        return e
+
+    def loop_wire(self, loop):
+        sat = self.sat
+        first = sat.ptr(loop, "coedge")
+        if first is None:
+            raise AcisError("loop without coedges")
+        edges = []
+        co = first
+        seen = set()
+        while co is not None and co.index not in seen:
+            seen.add(co.index)
+            erec = sat.ptr(co, "edge")
+            if erec is None:
+                raise AcisError("coedge without edge")
+            if sat.ptr(erec, "*-curve") is None and len({v.index for v in sat.ptrs(erec, "vertex")}) == 1:
+                # a degenerate edge (the apex of a cone)
+                self.apexes.append(self.point(sat.ptr(erec, "vertex")))
+                nxt = sat.ptrs(co, "coedge")
+                co = nxt[0] if nxt else None
+                continue
+            e = self.edge(erec)
+            f = sat.fields(co)
+            k = f.index("$%d" % erec.index)
+            sense = f[k + 1] if k + 1 < len(f) else "forward"
+            edges.append(e.reversed() if sense in _REVERSED else e)
+            nxt = sat.ptrs(co, "coedge")
+            co = nxt[0] if nxt else None
+        if not edges:
+            return None
+        try:
+            w = Part.Wire(edges)
+        except Part.OCCError:
+            w = Part.Wire(Part.__sortEdges__(edges))
+        return w
+
+    def face(self, frec):
+        sat = self.sat
+        srec = sat.ptr(frec, "*-surface")
+        if srec is None:
+            raise AcisError("face without surface")
+        f = sat.fields(frec)
+        k = f.index("$%d" % srec.index)
+        sense = "forward"
+        for t in f[k + 1 :]:
+            if t in ("forward", "reversed", "F", "I"):
+                sense = "reversed" if t in _REVERSED else "forward"
+                break
+        loops = self.loops.get(frec.index, [])
+        cands = _surfaces(sat, srec)
+        self.apexes = []
+        wires = [w for w in (self.loop_wire(lp) for lp in loops) if w is not None]
+        if len(cands) > 1 and wires:
+            pts = [v.Point for w in wires for v in w.Vertexes]
+            pts += [e.valueAt((e.FirstParameter + e.LastParameter) / 2) for w in wires for e in w.Edges]
+            cands.sort(key=lambda s: _dist_to_surface(s, pts))
+        surf = cands[0]
+        if not wires:
+            if isinstance(surf, (Part.Sphere, Part.Toroid, Part.BSplineSurface)):
+                face = surf.toShape()
+                if sense == "reversed":
+                    face.reverse()
+                return face
+            raise AcisError("unbounded %s face without loops" % srec.name)
+        # a forward face with the loops counterclockwise about the normal
+        # of the surface, then the sense of the face
+        best = None
+        variants = [(s, flip) for s in [surf] + _seam_variants(surf, wires) for flip in (sense == "reversed", sense != "reversed")]
+        for surf, flip in variants:
+            sf = Part.ShapeFix.Face()
+            sf.init(surf, self.tol, True)
+            for w in wires:
+                sf.add(w.reversed() if flip else w)
+            sf.FixOrientationMode = 1
+            sf.FixMissingSeamMode = 1
+            sf.perform()
+            face = sf.face()
+            if face.isValid() and face.Area > 0:
+                best = face
+                break
+            if best is None:
+                best = face
+        else:
+            surf = variants[0][0]
+            rev = _revolution_face(surf, wires, self.apexes, self.tol)
+            if rev is None:
+                rev = _split_face(surf, wires, self.tol)
+            if rev is not None:
+                best = rev
+            else:
+                self.warn("face on %s not valid as built" % srec.name)
+        if sense == "reversed":
+            best.reverse()
+        return best
+
+
+def _seam_variants(surf, wires):
+    """The periodic surface turned so that its seam goes through a vertex
+    of the loops (ShapeFix may fail to split an edge at the seam)"""
+    if not isinstance(surf, (Part.Cylinder, Part.Cone, Part.Sphere, Part.Toroid)):
+        return []
+    out = []
+    for w in wires[:2]:
+        for vx in w.Vertexes[:2]:
+            d = vx.Point - surf.Center
+            d = d - surf.Axis * d.dot(surf.Axis)
+            if d.Length < 1e-12:
+                continue
+            s = surf.copy()
+            try:
+                s.XAxis = d
+            except Exception:
+                continue
+            out.append(s)
+    return out
+
+
+def _split_face(surf, wires, tol):
+    """The face as the part of a bounded piece of the surface cut by the
+    loops that has only loop edges (and seams) as boundary"""
+    try:
+        if isinstance(surf, (Part.Cylinder, Part.Cone, Part.SurfaceOfExtrusion)):
+            vs = []
+            for w in wires:
+                for e in w.Edges:
+                    for k in range(9):
+                        p = e.valueAt(e.FirstParameter + k * (e.LastParameter - e.FirstParameter) / 8)
+                        vs.append(surf.parameter(p)[1])
+            v0, v1 = min(vs), max(vs)
+            d = (v1 - v0) * 0.1 + 10 * tol
+            if isinstance(surf, Part.Cone):
+                va = surf.parameter(surf.Apex)[1]
+                if va <= v0:
+                    v0 = max(v0 - d, va)
+                    v1 += d
+                else:
+                    v1 = min(v1 + d, va)
+                    v0 -= d
+            else:
+                v0, v1 = v0 - d, v1 + d
+            u0, u1 = surf.bounds()[0:2] if isinstance(surf, Part.SurfaceOfExtrusion) else (0, 2 * math.pi)
+            big = surf.toShape(u0, u1, v0, v1)
+        else:
+            big = surf.toShape()
+        pieces, _ = big.generalFuse(list(wires), tol)
+    except Exception:
+        return None
+    loops = Part.Compound(list(wires))
+    good = []
+    for fc in pieces.Faces:
+        ok = True
+        for e in fc.Edges:
+            if e.Degenerated or e.isSeam(fc):
+                continue
+            if loops.distToShape(Part.Vertex(e.valueAt((e.FirstParameter + e.LastParameter) / 2)))[0] > 100 * tol:
+                ok = False
+                break
+        if ok and fc.isValid():
+            good.append(fc)
+    if len(good) == 1:
+        return good[0]
+    return None
+
+
+def _revolution_face(surf, wires, apexes, tol):
+    """The face of a cone, cylinder or sphere between full circles about
+    its axis (and the apex), made from the parameter ranges: ShapeFix does
+    not close a cone at its apex. None if the loops are not such circles."""
+    if not isinstance(surf, (Part.Cone, Part.Cylinder, Part.Sphere)):
+        return None
+    vs = []
+    for w in wires:
+        if len(w.Edges) != 1 or not w.isClosed():
+            return None
+        e = w.Edges[0]
+        vals = []
+        for k in range(5):
+            u, v = surf.parameter(e.valueAt(e.FirstParameter + k * (e.LastParameter - e.FirstParameter) / 4))
+            vals.append(v)
+        if max(vals) - min(vals) > tol * 10:
+            return None
+        vs.append(vals[0])
+    for p in apexes:
+        vs.append(surf.parameter(p)[1])
+    if isinstance(surf, Part.Cone) and len(vs) == 1:
+        vs.append(surf.parameter(surf.Apex)[1])
+    if len(vs) == 1 and isinstance(surf, Part.Sphere):
+        # the cap the loop goes counterclockwise around, seen from outside
+        e = wires[0].Edges[0]
+        t = e.tangentAt(e.FirstParameter)
+        r = e.valueAt(e.FirstParameter) - surf.Center
+        pole = math.pi / 2 if r.cross(t).dot(surf.Axis) > 0 else -math.pi / 2
+        vs.append(pole)
+    if len(vs) != 2 or abs(vs[0] - vs[1]) < tol:
+        return None
+    face = surf.toShape(0, 2 * math.pi, min(vs), max(vs))
+    return face if face.isValid() else None
+
+
+def _transform_matrix(sat, trec):
+    # the last 13 numbers: the 3x3 matrix by rows, translation, scale
+    # (the head of a transform has no pointer after the history index)
+    nums = [t for t in trec.toks[1:] if _is_num(t)]
+    if len(nums) < 13:
+        raise AcisError("transform with %d numbers" % len(nums))
+    # before ACIS 7 the three flags (rotate, reflect, shear) are numbers too, since 7 a
+    # history index comes first and the flags are words
+    start = {13: 0, 16: 0, 14: 1, 17: 1}.get(len(nums), len(nums) - 13)
+    c = _Cursor(nums[start : start + 13])
+    a, b, d = c.vec(), c.vec(), c.vec()
+    t = c.vec()
+    scale = c.num()
+    m = FreeCAD.Matrix(
+        a.x * scale, b.x * scale, d.x * scale, t.x,
+        a.y * scale, b.y * scale, d.y * scale, t.y,
+        a.z * scale, b.z * scale, d.z * scale, t.z,
+        0, 0, 0, 1,
+    )  # fmt: skip
+    return m
+
+
+def _model_size(sat):
+    pts = []
+    for r in sat.records:
+        if r.name == "point":
+            try:
+                pts.append(_Cursor(sat.fields(r)).vec())
+            except AcisError:
+                pass
+    if not pts:
+        return 1.0
+    bb = FreeCAD.BoundBox()
+    for p in pts:
+        bb.add(p)
+    return max(bb.DiagonalLength, 1e-9)
+
+
+def _sew(faces, tol):
+    comp = Part.Compound(faces)
+    try:
+        comp.sewShape(tol)
+    except Part.OCCError:
+        return comp
+    return comp
+
+
+def _close(shell):
+    try:
+        solid = Part.Solid(shell)
+        fx = Part.ShapeFix.Solid()
+        fx.init(solid)
+        fx.perform()
+        solid = fx.solid()
+        if solid.ShapeType != "Solid" and solid.Solids:
+            solid = solid.Solids[0]
+        if solid.Volume < 0:
+            solid.reverse()
+        return solid
+    except Part.OCCError:
+        return None
+
+
+def _build_body(sat, body, apply_units):
+    b = _Builder(sat)
+    size = _model_size(sat)
+    b.tol = max(1e-7, size * 1e-9)
+    faces = []
+    nfaces = 0
+    for frec in sat.records:
+        if frec.type != "face":
+            continue
+        # the faces of this body: face -> shell -> lump -> body
+        shell = sat.ptr(frec, "shell")
+        lump = sat.ptr(shell, "lump") if shell is not None else None
+        if lump is None or sat.ptr(lump, "body") is not body:
+            continue
+        nfaces += 1
+        try:
+            faces.append(b.face(frec))
+        except (AcisError, Part.OCCError, ValueError, TypeError, IndexError, ZeroDivisionError) as e:
+            srec = sat.ptr(frec, "*-surface")
+            b.warn("face %d (%s) skipped: %s" % (frec.index, srec.name if srec else "?", e))
+    if not faces:
+        b.warn("no faces built" if nfaces else "body without faces")
+        return None, b.problems
+    shape = None
+    for k in (1e-7, 1e-6, 1e-5, 1e-4):
+        sewn = _sew(faces, size * k)
+        shells = sewn.Shells if sewn.ShapeType != "Shell" else [sewn]
+        shells = [s for s in shells]
+        free_faces = len(faces) - sum(len(s.Faces) for s in shells)
+        if shells and all(s.isClosed() for s in shells) and free_faces <= 0:
+            solids = [_close(s) for s in shells]
+            if all(s is not None and s.isValid() for s in solids):
+                shape = solids[0] if len(solids) == 1 else Part.Compound(solids)
+                break
+        if shape is None and k == 1e-4:
+            if len(faces) > 1 and nfaces == len(faces):
+                if any(s.isClosed() for s in shells):
+                    b.warn("some shells closed but not valid solids")
+                else:
+                    b.warn("shell not closed after sewing")
+            shape = sewn if len(faces) > 1 else faces[0]
+    trec = sat.ptr(body, "transform")
+    if trec is not None:
+        try:
+            m = _transform_matrix(sat, trec)
+            if not m.isUnity():
+                shape = shape.transformGeometry(m) if abs(m.determinant() - 1) > 1e-9 else _rigid(shape, m)
+        except (AcisError, Part.OCCError) as e:
+            b.warn("transform ignored: %s" % e)
+    if apply_units and abs(sat.units - 1.0) > 1e-12:
+        m = FreeCAD.Matrix()
+        m.scale(sat.units, sat.units, sat.units)
+        shape = shape.transformGeometry(m)
+    return shape, b.problems
+
+
+def _rigid(shape, m):
+    s = shape.copy()
+    s.transformShape(m)
+    return s
+
+
+def read(text, apply_units=False):
+    """Reads SAT text. Returns a list of (shape, problems) per body: shape
+    is a Part shape (a Solid when the body closes, else the sewn faces) or
+    None, problems a list of strings.
+
+    apply_units: scale by the millimeters per unit of the header (the DXF
+    and DWG keep the coordinates in drawing units: off by default)."""
+    try:
+        sat = _Sat(text)
+    except AcisError as e:
+        return [(None, [str(e)])]
+    bodies = [r for r in sat.records if r.type == "body"]
+    if not bodies:
+        return [(None, sat.problems + ["no body in SAT data"])]
+    unsupported = sorted(
+        {
+            r.name
+            for r in sat.records
+            if r.name.endswith(("-surface", "-curve"))
+            and r.name
+            not in (
+                "plane-surface",
+                "cone-surface",
+                "sphere-surface",
+                "torus-surface",
+                "spline-surface",
+                "straight-curve",
+                "ellipse-curve",
+                "intcurve-curve",
+            )
+        }
+    )
+    out = []
+    for body in bodies:
+        try:
+            shape, problems = _build_body(sat, body, apply_units)
+        except Exception as e:  # never let one body break an import
+            shape, problems = None, ["body failed: %s" % e]
+        problems = sat.problems + ["unsupported geometry: %s" % ", ".join(unsupported)] * bool(unsupported) + problems
+        out.append((shape, problems))
+    return out
+
+
+def shapes_from_dxf_entity(code_values, apply_units=False):
+    """read() of the SAT text of a DXF 3DSOLID/REGION/BODY entity given by
+    its (code, value) pairs (only the 1 and 3 groups are used)"""
+    return _read_entity_text(decode_dxf_text(code_values), apply_units)
+
+
+def _read_entity_text(text, apply_units=False):
+    if not text.strip():
+        return [(None, ["no ACIS data in the entity (R2013+ keeps it in the ACDSDATA section)"])]
+    return read(text, apply_units)
+
+
+def read_dxf(filename, types=("3DSOLID", "REGION", "BODY")):
+    """The ACIS entities of the ENTITIES section of a DXF file: a list of
+    dicts with type, handle, layer, color, paperspace, shapes (the result
+    of read())"""
+    out = []
+    with open(filename, "rb") as fh:
+        data = fh.read()
+    for enc in ("utf-8", "cp1252"):
+        try:
+            text = data.decode(enc)
+            break
+        except UnicodeDecodeError:
+            continue
+    lines = text.splitlines()
+    section = None
+    cur = None
+    i = 0
+    n = len(lines) - 1
+    while i < n:
+        code = lines[i].strip()
+        value = lines[i + 1]
+        i += 2
+        if code == "0":
+            if cur is not None:
+                cur["sat"] = decode_dxf_text(cur.pop("codes"))
+                cur["shapes"] = _read_entity_text(cur["sat"])
+                out.append(cur)
+                cur = None
+            v = value.strip()
+            if v == "SECTION":
+                section = "?"
+            elif v == "ENDSEC":
+                section = None
+            elif section == "ENTITIES" and v in types:
+                cur = {"type": v, "handle": "", "layer": "0", "color": 256, "paperspace": False, "codes": []}
+            continue
+        if section == "?" and code == "2":
+            section = value.strip()
+            continue
+        if cur is None:
+            continue
+        if code in ("1", "3"):
+            cur["codes"].append((int(code), value))
+        elif code == "5":
+            cur["handle"] = value.strip()
+        elif code == "8":
+            cur["layer"] = value.strip()
+        elif code == "62":
+            cur["color"] = int(value.strip() or 256)
+        elif code == "67":
+            cur["paperspace"] = value.strip() == "1"
+    return out
