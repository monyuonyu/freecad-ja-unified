+
+def _encode(text):
+    """DXF R13-R2010 form of SAT text: each character c > 32 as 159 - c"""
+    return "".join(chr(159 - ord(c)) if ord(c) > 32 else c for c in text)
+
+
+class TestAcisSat(unittest.TestCase):
+    def check(self, text, volume, box=None):
+        bodies = AcisSat.read(text)
+        self.assertEqual(len(bodies), 1)
+        shape, problems = bodies[0]
+        self.assertEqual(problems, [])
+        self.assertEqual(shape.ShapeType, "Solid")
+        self.assertTrue(shape.isValid())
+        self.assertAlmostEqual(shape.Volume, volume, places=3)
+        if box:
+            bb = shape.BoundBox
+            for a, b in zip((bb.XMin, bb.YMin, bb.ZMin, bb.XMax, bb.YMax, bb.ZMax), box):
+                self.assertAlmostEqual(a, b, places=4)
+        return shape
+
+    def testCylinder(self):
+        shape = self.check(CYLINDER, 3.14159265358979 * 250, (-5, -5, 0, 5, 5, 10))
+        self.assertIn("Part::GeomCylinder", [f.Surface.TypeId for f in shape.Faces])
+
+    def testCone(self):
+        shape = self.check(CONE, 3.14159265358979 * 10 / 3 * (25 + 12.5 + 6.25))
+        self.assertIn("Part::GeomCone", [f.Surface.TypeId for f in shape.Faces])
+
+    def testTransform(self):
+        self.check(BOX_R14, 125, (15.27672547, -223.35012266, 0, 20.27672547, -218.35012266, 5))
+
+    def testBrokenDataReportsProblems(self):
+        shape, problems = AcisSat.read("106 0 1 0\nbody $-1 $1 $-1 $-1 #\n")[0]
+        self.assertTrue(problems)
+        shape, problems = AcisSat.read("not ACIS")[0]
+        self.assertIsNone(shape)
+        self.assertTrue(problems)
+
+    def testDxfEntityAndImport(self):
+        lines = CYLINDER.splitlines()
+        codes = [(1, _encode(line)) for line in lines]
+        shape, problems = AcisSat.shapes_from_dxf_entity(codes)[0]
+        self.assertAlmostEqual(shape.Volume, 3.14159265358979 * 250, places=3)
+        dxf = os.path.join(tempfile.mkdtemp(), "solid.dxf")
+        body = "\n".join("1\n" + _encode(line) for line in lines)
+        with open(dxf, "w", encoding="utf-8") as f:
+            f.write("0\nSECTION\n2\nENTITIES\n0\n3DSOLID\n5\n2A\n8\nParts\n70\n1\n%s\n0\nENDSEC\n0\nEOF\n" % body)
+        ents = AcisSat.read_dxf(dxf)
+        self.assertEqual([(e["type"], e["handle"], e["layer"]) for e in ents], [("3DSOLID", "2A", "Parts")])
+        import importDXF
+
+        doc = App.newDocument("AcisImport")
+        try:
+            self.assertEqual(importDXF._import_acis_entities(doc, dxf), 1)
+            obj = doc.getObjectsByLabel("Solid_2A")[0]
+            self.assertAlmostEqual(obj.Shape.Volume, 3.14159265358979 * 250, places=3)
+        finally:
+            App.closeDocument(doc.Name)
+
