diff --git a/src/Mod/Unified/TestDrawingPdf.py b/src/Mod/Unified/TestDrawingPdf.py
index 0d248c0c5..a210c499d 100644
--- a/src/Mod/Unified/TestDrawingPdf.py
+++ b/src/Mod/Unified/TestDrawingPdf.py
@@ -142,5 +142,40 @@ class ExportTest(unittest.TestCase):
         self.assertIn("No drawing page", str(ctx.exception))
 
 
+class PageDeleteTest(unittest.TestCase):
+    def test_a_page_goes_with_its_views(self):
+        # deleting a page left its three views, section and dimension in the tree ("error while
+        # deleting children", "DPG may be corrupt - Anchor deleted"; field test of 0.8.1)
+        import TechDraw  # noqa: F401
+
+        doc = App.newDocument("pagedelete")
+        try:
+            box = doc.addObject("Part::Box", "Box")
+            page = doc.addObject("TechDraw::DrawPage", "Page")
+            page.Template = doc.addObject("TechDraw::DrawSVGTemplate", "Template")
+            group = doc.addObject("TechDraw::DrawProjGroup", "ProjGroup")
+            page.addView(group)
+            group.Source = [box]
+            for side in ("Front", "Right", "Top"):
+                group.addProjection(side)
+            doc.recompute()
+            section = doc.addObject("TechDraw::DrawViewSection", "Section")
+            page.addView(section)
+            section.BaseView, section.Source = group.Anchor, [box]
+            dim = doc.addObject("TechDraw::DrawViewDimension", "Dim")
+            dim.Type, dim.References2D = "DistanceX", [(group.Anchor, "Edge0")]
+            page.addView(dim)
+            doc.recompute()
+            doc.UndoMode = 1
+            doc.openTransaction("delete")
+            doc.removeObject("Page")
+            doc.commitTransaction()
+            self.assertEqual([o.Name for o in doc.Objects], ["Box"])
+            doc.undo()
+            self.assertEqual(len(doc.Objects), 9)
+        finally:
+            App.closeDocument(doc.Name)
+
+
 if __name__ == "__main__":
     unittest.main()
