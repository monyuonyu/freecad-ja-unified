From 545664768d94128b66e5a0d66ff24f4590c38d58 Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Wed, 28 Oct 2026 12:33:46 +0900
Subject: [PATCH 392/406] TechDraw: Japanese in a drawing in one Japanese font

osifont had 161 kanji and kana, Japanese and Chinese: in a word some were
drawn by it and the others by a font the system picked (a Korean form in
a PDF). They are taken out of the bundled osifont; osifont's substitutes
are the Japanese fonts installed.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/Mod/TechDraw/Gui/AppTechDrawGui.cpp       |  17 +++++++++++++++++
 .../Gui/Resources/fonts/osifont-italic.ttf    | Bin 123760 -> 65168 bytes
 .../Gui/Resources/fonts/osifont-lgpl3fe.ttf   | Bin 126556 -> 68688 bytes
 3 files changed, 17 insertions(+)

diff --git a/src/Mod/TechDraw/Gui/AppTechDrawGui.cpp b/src/Mod/TechDraw/Gui/AppTechDrawGui.cpp
index 0973300e9..358f95f14 100644
--- a/src/Mod/TechDraw/Gui/AppTechDrawGui.cpp
+++ b/src/Mod/TechDraw/Gui/AppTechDrawGui.cpp
@@ -22,6 +22,7 @@
  *                                                                         *
  ***************************************************************************/
 
+#include <QFont>
 #include <QFontDatabase>
 
 
@@ -97,6 +98,22 @@ void loadTechDrawResource()
                 "TechDraw failed to load font file: {} from: {}\n", rc, qPrintable(fontFile));
         }
     }
+
+    // osifont has no kanji and kana (taken out: it had 161 of them, Japanese and Chinese, and a
+    // word was drawn in two typefaces): Japanese from one Japanese font, not a Chinese or Korean
+    // form of the same character the system might pick
+    const QStringList installed = QFontDatabase::families();
+    QStringList japanese;
+    for (const char* family : {"Noto Sans CJK JP", "Noto Sans JP", "Source Han Sans JP",
+                               "IPAexGothic", "IPAGothic", "Yu Gothic", "Meiryo", "MS Gothic",
+                               "Hiragino Sans", "Hiragino Kaku Gothic ProN"}) {
+        if (installed.contains(QString::fromLatin1(family), Qt::CaseInsensitive)) {
+            japanese << QString::fromLatin1(family);
+        }
+    }
+    if (!japanese.isEmpty()) {
+        QFont::insertSubstitutions(QStringLiteral("osifont"), japanese);
+    }
 }
 
 namespace TechDrawGui
diff --git a/src/Mod/TechDraw/Gui/Resources/fonts/osifont-italic.ttf b/src/Mod/TechDraw/Gui/Resources/fonts/osifont-italic.ttf
