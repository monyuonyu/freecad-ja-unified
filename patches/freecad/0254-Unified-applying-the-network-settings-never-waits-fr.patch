+    p.finished.connect(done)
+    p.errorOccurred.connect(failed)
+    p.start(py, [os.path.join(HERE, "AIAgentBridge.py"), "--has-key", "--datadir", _datadir()])
+    p.closeWriteChannel()
+    QtCore.QTimer.singleShot(timeout, p, lambda: p.kill() if p.state() != QtCore.QProcess.NotRunning else None)
