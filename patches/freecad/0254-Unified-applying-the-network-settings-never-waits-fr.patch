+        return None
+    p = QtCore.QProcess(parent)
+    p.setProcessChannelMode(QtCore.QProcess.MergedChannels)
+    p.setProcessEnvironment(ai_environment())
+    state = {"called": False}
+
+    def finish(result):
+        if not state["called"]:
+            state["called"] = True
+            try:
+                callback(result)
+            except RuntimeError:
+                pass  # 画面はもう閉じた
+
+    def done(*_args):
+        out = bytes(p.readAll()).decode("utf-8", "replace").strip()
+        finish(None if p.exitCode() != 0 or not out else out.splitlines()[-1] == "yes")
+        p.deleteLater()
+
+    def failed(err):
+        if err == QtCore.QProcess.FailedToStart:
+            finish(None)
+            p.deleteLater()
