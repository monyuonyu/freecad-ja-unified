     url = proxies.get("https") or proxies.get("http") or ""
@@ -132,6 +141,99 @@ def apply():
         FreeCAD.Console.PrintWarning("Network settings: %s\n" % e)
 
 
+def windows_pac_only():
+    """Windows のプロキシが自動構成スクリプト（PAC）だけで、手動のプロキシが無いか（FreeCAD は PAC を読まない）"""
+    if os.name != "nt":
+        return False
+    try:
+        import winreg
+        with winreg.OpenKey(winreg.HKEY_CURRENT_USER,
+                            r"Software\Microsoft\Windows\CurrentVersion\Internet Settings") as k:
+            try:
+                pac = winreg.QueryValueEx(k, "AutoConfigURL")[0]
+            except OSError:
+                pac = ""
+            try:
+                enabled = winreg.QueryValueEx(k, "ProxyEnable")[0]
+            except OSError:
+                enabled = 0
+        return bool(pac) and not enabled
+    except Exception:
+        return False
+
+
+def current_proxy():
+    """いま当たっているプロキシ（apply() の後の環境変数）。無ければ空"""
+    return os.environ.get("HTTPS_PROXY") or os.environ.get("https_proxy") or \
+        os.environ.get("HTTP_PROXY") or os.environ.get("http_proxy") or ""
+
+
+CHECK_HOST = ("api.anthropic.com", 443)
+CHECK_TIMEOUT = 5.0
+
+
+def _reason(e, timeout):
+    import socket
+    if isinstance(e, ConnectionRefusedError):
+        return "接続を拒否されました。そのポートで動いているプロキシがありません"
+    if isinstance(e, (socket.timeout, TimeoutError)):
+        return "%d 秒待っても応答がありません" % timeout
+    if isinstance(e, socket.gaierror):
+        return "名前が見つかりません"
+    if isinstance(e, ConnectionResetError):
+        return "接続を切られました"
+    return str(e) or type(e).__name__
+
+
+def check(proxy=None, timeout=CHECK_TIMEOUT, target=CHECK_HOST):
+    """つながるかを確かめる（通信するので、画面の外のスレッドで呼ぶこと）。(つながったか, 日本語の説明)
+
+    proxy を省くと、いま当たっている設定（環境変数）で確かめる。プロキシがあれば、そこへつないで
+    target への CONNECT を頼む。無ければ target へ直接つなぐ"""
+    import socket
+    from urllib.parse import urlsplit
+    if proxy is None:
+        proxy = current_proxy()
+    host, port = target
+    if not proxy:
+        try:
+            socket.create_connection((host, port), timeout).close()
+            return True, "%s に直接つながります" % host
+        except Exception as e:
+            return False, "%s に直接つながりません（%s）" % (host, _reason(e, timeout))
+    u = urlsplit(proxy if "://" in proxy else "http://" + proxy)
+    try:
+        phost, pport = u.hostname or "", u.port or 8080
+    except ValueError:
+        return False, "プロキシの書き方が正しくありません: %s" % proxy
+    name = "%s:%d" % (phost, pport)
+    try:
+        sock = socket.create_connection((phost, pport), timeout)
+    except Exception as e:
+        return False, "プロキシ %s に接続できません（%s）" % (name, _reason(e, timeout))
+    try:
+        sock.settimeout(timeout)
+        req = "CONNECT %s:%d HTTP/1.1\r\nHost: %s:%d\r\n" % (host, port, host, port)
+        if u.username:
+            import base64
+            from urllib.parse import unquote
+            cred = "%s:%s" % (unquote(u.username), unquote(u.password or ""))
+            req += "Proxy-Authorization: Basic %s\r\n" % base64.b64encode(cred.encode()).decode()
+        sock.sendall((req + "\r\n").encode("ascii"))
+        line = sock.recv(1024).split(b"\r\n", 1)[0].decode("latin-1")
+    except Exception as e:
+        return False, "プロキシ %s につながりましたが、%s へ取り次いでもらえません（%s）" % (name, host, _reason(e, timeout))
+    finally:
+        sock.close()
+    parts = line.split()
+    code = parts[1] if len(parts) > 1 else ""
+    if code == "200":
+        return True, "プロキシ %s 経由で %s につながります" % (name, host)
+    if code == "407":
+        return False, "プロキシ %s はユーザー名とパスワードを求めています（http://名前:パスワード@%s の形で書けます）" % (name, name)
+    return False, "プロキシ %s が %s への接続を断りました（%s）" % (name, host, line or "応答なし")
+
+
 def describe_error(text):
     """接続の失敗の説明（プロキシ・証明書）を日本語で。当てはまらなければ None"""
     t = (text or "").lower()
diff --git a/src/Mod/Unified/TestNetworkSettings.py b/src/Mod/Unified/TestNetworkSettings.py
new file mode 100644
index 000000000..6536fc760
--- /dev/null
+++ b/src/Mod/Unified/TestNetworkSettings.py
@@ -0,0 +1,213 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""ネットワークの設定と AI チャットのキーの試験（FreeCADCmd -t TestNetworkSettings、画面なしで動く）
+
+- 設定を当てる（設定の画面の「適用」と同じ道筋）は通信も名前の問い合わせもせず、すぐ戻る。
+  プロキシが閉じたポート（接続拒否）でも、応答の無いアドレス（10.255.255.1、黙って捨てられる）でも
+- つながるかの確認は別のスレッドで走り、その間も画面のスレッドのタイマーが遅れない（心拍で測る）。結果は日本語
+- Qt に「システムの設定」（Windows では WPAD の自動検出が走る）を使わせない
+"""
+
+import os
+import socket
+import threading
+import time
+import unittest
+
+import FreeCAD
+
+import NetworkSettings
+
+BLACK_HOLE = "10.255.255.1:8080"
+
+
+def closed_port():
+    """何も待ち受けていないポート"""
+    s = socket.socket()
+    s.bind(("127.0.0.1", 0))
+    port = s.getsockname()[1]
+    s.close()
+    return port
+
+
+class _Params:
+    """試験の間だけ設定を変え、終わったら戻す"""
+
+    def __enter__(self):
+        p = NetworkSettings.params()
+        self.saved = (p.GetInt("ProxyMode", 0), p.GetString("ProxyURL", ""), p.GetString("NoProxy", ""),
+                      p.GetString("CACertFile", ""))
+        self.env = dict(os.environ)
+        return self
+
+    def set(self, mode, url=""):
+        p = NetworkSettings.params()
+        p.SetInt("ProxyMode", mode)
+        p.SetString("ProxyURL", url)
+
+    def __exit__(self, *exc):
+        p = NetworkSettings.params()
+        p.SetInt("ProxyMode", self.saved[0])
+        p.SetString("ProxyURL", self.saved[1])
+        p.SetString("NoProxy", self.saved[2])
+        p.SetString("CACertFile", self.saved[3])
+        os.environ.clear()
+        os.environ.update(self.env)
+        NetworkSettings.apply()
+
+
+class _NoNetworkHere:
+    """このスレッドで通信・名前の問い合わせ・OS のプロキシの自動検出をしたら記録する"""
+
+    def __enter__(self):
+        import urllib.request
+        self.calls = []
+        self.thread = threading.get_ident()
+        self.saved = [(socket, "create_connection"), (socket, "getaddrinfo"), (socket, "gethostbyname"),
+                      (urllib.request, "getproxies"), (urllib.request, "urlopen")]
+        self.saved = [(m, n, getattr(m, n)) for m, n in self.saved]
+        for m, n, f in self.saved:
+            setattr(m, n, self._wrap(n, f))
+        return self
+
+    def _wrap(self, name, f):
+        def wrapped(*a, **k):
+            if threading.get_ident() == self.thread:
+                self.calls.append(name)
+            return f(*a, **k)
+        return wrapped
+
+    def __exit__(self, *exc):
+        for m, n, f in self.saved:
+            setattr(m, n, f)
+
+
+def _qt():
+    try:
+        from PySide import QtCore, QtNetwork
+    except ImportError:
+        return None, None
+    if QtCore.QCoreApplication.instance() is None:
+        _qt.app = QtCore.QCoreApplication([])
+    return QtCore, QtNetwork
+
+
+class TestApplyDoesNotBlock(unittest.TestCase):
+    def _apply(self, mode, url):
+        import UnifiedPreferences
+        with _Params() as p, _NoNetworkHere() as guard:
+            p.set(mode, url)
+            t = time.monotonic()
+            UnifiedPreferences.apply_all()
+            took = time.monotonic() - t
+            proxy = NetworkSettings.current_proxy()
+            QtCore, QtNetwork = _qt()
+            uses_system = QtNetwork.QNetworkProxyFactory.usesSystemConfiguration() if QtNetwork else False
+            app_proxy = QtNetwork.QNetworkProxy.applicationProxy() if QtNetwork else None
+        return took, guard.calls, proxy, uses_system, app_proxy
+
+    def test_manual_closed_port(self):
+        url = "localhost:%d" % closed_port()
+        took, calls, proxy, uses_system, app_proxy = self._apply(NetworkSettings.MANUAL, url)
+        self.assertLess(took, 1.0)
+        self.assertEqual(calls, [])
+        self.assertEqual(proxy, "http://" + url)
+        self.assertFalse(uses_system)
+        if app_proxy is not None:
+            self.assertEqual((app_proxy.hostName(), app_proxy.port()), ("localhost", int(url.split(":")[1])))
+
+    def test_manual_black_hole(self):
+        took, calls, proxy, uses_system, _ = self._apply(NetworkSettings.MANUAL, BLACK_HOLE)
+        self.assertLess(took, 1.0)
+        self.assertEqual(calls, [])
+        self.assertFalse(uses_system)
+
+    def test_system_and_none(self):
+        for mode in (NetworkSettings.SYSTEM, NetworkSettings.NONE):
+            took, calls, _proxy, uses_system, _ = self._apply(mode, "")
+            self.assertLess(took, 1.0)
+            self.assertEqual(calls, [])
+            # Qt のシステムの設定は Windows では WPAD の自動検出になり、全体の錠を持ったまま数分止まる
+            self.assertFalse(uses_system)
+
+
+class TestCheck(unittest.TestCase):
+    def test_refused(self):
+        port = closed_port()
+        t = time.monotonic()
+        ok, text = NetworkSettings.check("localhost:%d" % port, timeout=5)
+        self.assertFalse(ok)
+        self.assertIn("プロキシ localhost:%d に接続できません（接続を拒否されました" % port, text)
+        self.assertLess(time.monotonic() - t, 5.5)
+
+    def test_black_hole(self):
+        t = time.monotonic()
+        ok, text = NetworkSettings.check(BLACK_HOLE, timeout=2)
+        took = time.monotonic() - t
+        self.assertFalse(ok)
+        self.assertIn("プロキシ 10.255.255.1:8080 に接続できません", text)
+        self.assertLess(took, 3.0)
+
+    def test_working_proxy(self):
+        """CONNECT に 200・407 を返すだけのプロキシ"""
+        for status, want in ((b"200 Connection established", "経由で api.anthropic.com につながります"),
+                             (b"407 Proxy Authentication Required", "ユーザー名とパスワード")):
+            srv = socket.socket()
+            srv.bind(("127.0.0.1", 0))
+            srv.listen(1)
+
+            def serve():
+                c, _ = srv.accept()
+                c.recv(4096)
+                c.sendall(b"HTTP/1.1 " + status + b"\r\n\r\n")
+                c.close()
+            th = threading.Thread(target=serve, daemon=True)
+            th.start()
+            ok, text = NetworkSettings.check("http://127.0.0.1:%d" % srv.getsockname()[1], timeout=5)
+            th.join(5)
+            srv.close()
+            self.assertEqual(ok, status.startswith(b"200"))
+            self.assertIn(want, text)
+
+    def test_heartbeat_while_checking(self):
+        """画面のスレッドのタイマー（心拍）が、確認の間も遅れない。結果は画面のスレッドに届く"""
+        QtCore, _ = _qt()
+        if QtCore is None:
+            self.skipTest("no Qt")
+        import UnifiedPreferences
+        checker = UnifiedPreferences._Checker()
+        got = []
+        beats = []
+        loop = QtCore.QEventLoop()
+        checker.done.connect(lambda ok, text: (got.append((ok, text, threading.get_ident())), loop.quit()))
+        timer = QtCore.QTimer()
+        timer.setInterval(20)
+        timer.timeout.connect(lambda: beats.append(time.monotonic()))
+        timer.start()
+        old = NetworkSettings.CHECK_TIMEOUT
+        NetworkSettings.CHECK_TIMEOUT = 2.0
+        try:
+            # 既定の引数を固定した関数で、応答の無いプロキシを確かめる
+            orig = NetworkSettings.check
+            NetworkSettings.check = lambda proxy=None: orig(BLACK_HOLE, timeout=2.0)
+            t = time.monotonic()
+            checker.start()
+            started = time.monotonic() - t
+            QtCore.QTimer.singleShot(8000, loop.quit)
+            loop.exec()
+        finally:
+            NetworkSettings.check = orig
+            NetworkSettings.CHECK_TIMEOUT = old
+            timer.stop()
+        self.assertLess(started, 0.1)
+        self.assertTrue(got, "結果が届かない")
+        ok, text, tid = got[0]
+        self.assertFalse(ok)
+        self.assertIn("応答がありません", text)
+        self.assertEqual(tid, threading.get_ident())
+        gaps = [b - a for a, b in zip(beats, beats[1:])]
+        self.assertGreater(len(beats), 20)
+        self.assertLess(max(gaps), 0.3, "心拍が %.2f 秒止まった" % max(gaps))
+
+
+if __name__ == "__main__":
+    unittest.main()
