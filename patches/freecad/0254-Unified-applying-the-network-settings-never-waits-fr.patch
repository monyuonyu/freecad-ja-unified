+class _Checker(QtCore.QObject):
+    """つながるかを別のスレッドで確かめ、結果を done で画面のスレッドへ返す"""
+
+    done = QtCore.Signal(bool, str)
+
+    def __init__(self, parent=None):
+        super().__init__(parent)
+        self.serial = 0
+
+    def start(self, proxy=None):
+        self.serial += 1
+        serial = self.serial
+
+        def run():
+            try:
+                ok, text = NetworkSettings.check(proxy)
+            except Exception as e:
+                ok, text = False, "確かめられませんでした: %s" % e
+            if serial == self.serial:  # 古い確認の結果は捨てる
+                try:
+                    self.done.emit(ok, text)
+                except RuntimeError:
+                    pass
+        threading.Thread(target=run, name="NetworkCheck", daemon=True).start()
+
+
+def apply_all():
