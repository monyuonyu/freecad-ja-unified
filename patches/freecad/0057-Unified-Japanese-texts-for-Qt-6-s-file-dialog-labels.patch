From 1e44326f2e6eeb95a434e91e47383c5812ef8ee8 Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Sun, 27 Sep 2026 09:04:03 +0900
Subject: [PATCH 057/108] Unified: Japanese texts for Qt 6's file dialog labels

Qt's own Japanese translation still has the Qt 5 texts ("Look in:"),
while Qt 6 uses "&Look in:" and "Files of &type:", so the file dialogs
showed them in English. The folder type was English as well.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../translations/UnifiedProperties_ja.ts      | 26 +++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/src/Mod/Unified/Gui/Resources/translations/UnifiedProperties_ja.ts b/src/Mod/Unified/Gui/Resources/translations/UnifiedProperties_ja.ts
index 1f2a8b232..c1af7590b 100644
--- a/src/Mod/Unified/Gui/Resources/translations/UnifiedProperties_ja.ts
+++ b/src/Mod/Unified/Gui/Resources/translations/UnifiedProperties_ja.ts
@@ -5866,4 +5866,30 @@ by negative value of 'Over Tolerance'</source>
         <translation>スケッチの再計算</translation>
     </message>
 </context>
+<context>
+    <name>QFileDialog</name>
+    <message>
+        <source>&amp;Look in:</source>
+        <translation>場所(&amp;L):</translation>
+    </message>
+    <message>
+        <source>Files of &amp;type:</source>
+        <translation>ファイルの種類(&amp;T):</translation>
+    </message>
+</context>
+<context>
+    <name>QAbstractFileIconProvider</name>
+    <message>
+        <source>Folder</source>
+        <translation>フォルダー</translation>
+    </message>
+    <message>
+        <source>File</source>
+        <translation>ファイル</translation>
+    </message>
+    <message>
+        <source>Drive</source>
+        <translation>ドライブ</translation>
+    </message>
+</context>
 </TS>
