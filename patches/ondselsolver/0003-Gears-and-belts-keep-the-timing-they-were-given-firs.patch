diff --git a/OndselSolver/GearPhase.h b/OndselSolver/GearPhase.h
new file mode 100644
index 0000000..25bca59
--- /dev/null
+++ b/OndselSolver/GearPhase.h
@@ -0,0 +1,38 @@
+/***************************************************************************
+ *   Copyright (c) 2023 Ondsel, Inc.                                       *
+ *                                                                         *
+ *   This file is part of OndselSolver.                                    *
+ *                                                                         *
+ *   See LICENSE file for details about copyright.                         *
+ ***************************************************************************/
+
+#pragma once
+
+#include <cmath>
+#include <limits>
+
+namespace MbD {
+	// A gear's (or belt's) constant: the one of its phase, the relation it was given first,
+	// shifted by whole turns of either wheel to be the nearest to the relation the wheels
+	// have now. The angles are measured within one turn when a solve starts: without the phase
+	// the constant was taken from the wheels as they were, and a wheel that had moved (dragged,
+	// or a turn measured from the other side) kept the new timing without a word.
+	inline double snapGearConstant(double phase, double now, double ratio)
+	{
+		if (std::isnan(phase)) {
+			return now;
+		}
+		const double turn = 2.0 * M_PI;
+		double best = now, bestDistance = std::numeric_limits<double>::infinity();
+		for (int n = -12; n <= 12; ++n) {
+			const double base = phase + n * turn * ratio;
+			const double c = base + std::round((now - base) / turn) * turn;
+			const double d = std::fabs(c - now);
+			if (d < bestDistance) {
+				bestDistance = d;
+				best = c;
+			}
+		}
+		return best;
+	}
+}
