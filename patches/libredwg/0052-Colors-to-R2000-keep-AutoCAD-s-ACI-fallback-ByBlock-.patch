+/* The nearest ACI color 1-255 of an RGB (squared distance). */
+EXPORT BITCODE_BS
+dwg_nearest_color_index (BITCODE_BL rgb)
+{
+  const int r = (rgb >> 16) & 0xFF, g = (rgb >> 8) & 0xFF, b = rgb & 0xFF;
+  BITCODE_BS best = 7;
+  long bestd = -1;
+  for (BITCODE_BS i = 1; i < 256; i++)
+    {
+      const long dr = r - rgb_palette[i].r, dg = g - rgb_palette[i].g,
+                 db = b - rgb_palette[i].b;
+      const long d = dr * dr + dg * dg + db * db;
+      if (bestd < 0 || d < bestd)
+        {
+          bestd = d;
+          best = i;
+        }
+    }
+  return best;
+}
