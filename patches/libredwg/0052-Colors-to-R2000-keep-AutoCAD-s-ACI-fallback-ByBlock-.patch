From 3fa17260e6f3d3ec5192108d930a5de2301931c4 Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Mon, 12 Oct 2026 16:13:56 +0900
Subject: [PATCH 52/54] Colors to R2000: keep AutoCAD's ACI fallback, ByBlock;
 the ACI palette of AutoCAD

- bit_downconvert_CMC: entity colors of R2004+ (ENC) have no method, their
  index says ByBlock (0) or ByLayer (256); every ByBlock entity became
  ByLayer. True colors keep the ACI index stored with them (AutoCAD's
  fallback, written in its own R2000 save: #803dc2 with 183), else the
  nearest ACI (dwg_nearest_color_index), not the low byte of the RGB.
- rgb_palette: the ACI colors as AutoCAD shows them (ezdxf; ACadSharp agrees
  in 251 of 256); the old table differed in most entries (8 was 65,65,65).
- Against AutoCAD's own R2000 saves of the same drawings, example_2018
  written as R2000 is now equal in all 222 entities.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/dwg.h                   |   2 +
 src/bits.c                      |  20 ++--
 src/dwg.c                       | 191 +++++++++++++++-----------------
 test/unit-testing/common_test.c |   3 +-
 4 files changed, 103 insertions(+), 113 deletions(-)

diff --git a/include/dwg.h b/include/dwg.h
index ae20237..972f5a0 100644
--- a/include/dwg.h
+++ b/include/dwg.h
@@ -11726,6 +11726,8 @@ EXPORT BITCODE_BL dwg_rgb_palette_index (BITCODE_BS index);
    returns 256 if not found, i.e. the default ByLayer.
  */
 EXPORT BITCODE_BS dwg_find_color_index (BITCODE_BL rgb);
+/* the nearest ACI color 1-255 */
+EXPORT BITCODE_BS dwg_nearest_color_index (BITCODE_BL rgb);
 
 /** Add the empty object to the DWG.
     Returns DWG_ERR_OUTOFMEM, -1 for realloced or 0 if not.
diff --git a/src/bits.c b/src/bits.c
index 2537496..7b42a26 100644
--- a/src/bits.c
+++ b/src/bits.c
@@ -4066,6 +4066,11 @@ bit_downconvert_CMC (Bit_Chain *dat, Dwg_Color *restrict color)
       switch (color->method)
         {
         case 0x0:
+          // Entity colors (ENC) of R2004+ have no method: the index says it,
+          // 0 ByBlock, 256 ByLayer. Forcing 256 turned every ByBlock entity
+          // into ByLayer when written as R2000 (sample_AC1032 vs AutoCAD's
+          // sample_AC1015: 170 entities).
+          break;
         case 0xc0:
           color->index = 256;
           break; // ByLayer
@@ -4074,17 +4079,14 @@ bit_downconvert_CMC (Bit_Chain *dat, Dwg_Color *restrict color)
           break;   // ByBlock
         case 0xc2: // Entity
         case 0xc3: // TrueColor
-          // Keep an existing palette index whose rgb round-trips: several
-          // palette entries share one rgb (e.g. 1 and 10, 5 and 170), and
-          // dwg_find_color_index returns the first match, silently
-          // recoloring the entity.
-          if (color->index > 0 && color->index < 256
-              && dwg_rgb_palette_index (color->index)
-                     == (color->rgb & 0x00FFFFFF))
+          // Keep the index stored with the true color: AutoCAD stores its
+          // ACI fallback there (sample_AC1032: #803dc2 with 183) and writes
+          // it in its own R2000 save (sample_AC1015).
+          if (color->index > 0 && color->index < 256)
             break;
           color->index = dwg_find_color_index (color->rgb);
-          if (color->index == 256)
-            color->index = color->rgb & 0xff;
+          if (color->index == 256) // the nearest ACI, not the low byte
+            color->index = dwg_nearest_color_index (color->rgb);
           break;
         case 0xc8:
           color->index = 0;
