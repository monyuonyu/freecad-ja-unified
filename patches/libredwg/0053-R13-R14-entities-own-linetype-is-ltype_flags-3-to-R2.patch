From 3bc6ff8b67ccb50a8f6edbd0135da62a7e59639c Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Mon, 12 Oct 2026 16:25:42 +0900
Subject: [PATCH 053/122] R13/R14 entities: own linetype is ltype_flags 3; to
 R2000 lineweight ByLayer

- The decoder set ltype_flags only for ByLayer; entities with their own
  linetype (CONTINUOUS) were written as ByLayer to R2000.
- R13/R14 have no lineweight: ByLayer (29), not 0 (0.00mm).
Against AutoCAD's R2000 saves of the same drawings (example_r14,
sample_AC1014), the linetype differences are gone.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/common_entity_data.spec | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/src/common_entity_data.spec b/src/common_entity_data.spec
index 981759b..cc21b51 100644
--- a/src/common_entity_data.spec
+++ b/src/common_entity_data.spec
@@ -381,8 +381,10 @@
     {
       FIELD_B (isbylayerlt, 0);
 #ifdef IS_DECODER
-      if (FIELD_VALUE (isbylayerlt))
-        FIELD_VALUE (ltype_flags) = FIELD_VALUE (isbylayerlt) ? 0 : 3;
+      // not ByLayer: the linetype handle (3). The if (isbylayerlt) before
+      // left every R13/R14 entity with an own linetype at 0 (ByLayer) when
+      // written as R2000 (example_r14: CONTINUOUS became ByLayer).
+      FIELD_VALUE (ltype_flags) = FIELD_VALUE (isbylayerlt) ? 0 : 3;
 #endif
     }
   SINCE (R_2004a) //ODA bug
@@ -555,6 +557,12 @@
   SINCE (R_2000b) {
     // DXF later after 6, see common_entity_handle_data.spec
     // Ideally CMC 60 should be deferred after layer 8, before linewt 370 also
+#ifdef IS_ENCODER
+    // R13/R14 have no lineweight: ByLayer (29) as AutoCAD 2000 opens them,
+    // not 0 (0.00mm)
+    if (dat->from_version < R_2000b && !_ent->linewt)
+      _ent->linewt = 29;
+#endif
 #ifndef IS_DXF
     FIELD_RC (linewt, 370);
 #endif
-- 
