From 652521ebc2d3eda72423d7307a9174c3bf293ccb Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Mon, 12 Oct 2026 07:23:16 +0900
Subject: [PATCH 27/54] DXF import: *Model_Space keeps its DXF handle;
 VX_CONTROL B only if free

object[0] (*Model_Space) was created with 0x1F before the TABLES; a quick
scan of the ASCII DXF now takes the handle of its *Model_Space
BLOCK_RECORD. gh209_1 (*Model_Space 2, LAYER table 1F) had duplicate
handles, two model spaces and 14 entities on the wrong layer via DXF.
The encoder set the added VX_CONTROL to B without checking; gh209_1's
DICTIONARY is B.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/encode.c | 19 +++++++++++++--
 src/in_dxf.c | 69 +++++++++++++++++++++++++++++++++++++++++++++++++++-
 2 files changed, 85 insertions(+), 3 deletions(-)

diff --git a/src/encode.c b/src/encode.c
index f76db02..143bd07 100644
--- a/src/encode.c
+++ b/src/encode.c
@@ -54,6 +54,7 @@
 #include "bits.h"
 #include "dwg.h"
 #include "encode.h"
+#include "hash.h"
 #include "decode.h"
 #include "classes.h"
 #include "dynapi.h"
@@ -3052,7 +3053,14 @@ dwg_encode (Dwg_Data *restrict dwg, Bit_Chain *restrict dat)
               obj = dwg_find_first_type (dwg, DWG_TYPE_VX_CONTROL);
               if (obj)
                 {
-                  obj->handle.value = 0xB;
+                  // AutoCAD's handle of VX_CONTROL, if free. Unconditionally it
+                  // collided with objects of non-AutoCAD drawings (gh209_1: its
+                  // DICTIONARY is B): "Duplicate handle B".
+                  if (!dwg_resolve_handle_silent (dwg, 0xB))
+                    {
+                      obj->handle.value = 0xB;
+                      hash_set (dwg->object_map, 0xB, (uint64_t)obj->index);
+                    }
                   LOG_TRACE ("adding VX_CONTROL object " FORMAT_RLL "\n",
                              obj->handle.value);
                   dwg->header_vars.VX_TABLE_RECORD
@@ -3506,7 +3514,14 @@ dwg_encode (Dwg_Data *restrict dwg, Bit_Chain *restrict dat)
             obj = dwg_find_first_type (dwg, DWG_TYPE_VX_CONTROL);
             if (obj)
               {
-                obj->handle.value = 0xB;
+                // AutoCAD's handle of VX_CONTROL, if free. Unconditionally it
+                // collided with objects of non-AutoCAD drawings (gh209_1: its
+                // DICTIONARY is B): "Duplicate handle B".
+                if (!dwg_resolve_handle_silent (dwg, 0xB))
+                  {
+                    obj->handle.value = 0xB;
+                    hash_set (dwg->object_map, 0xB, (uint64_t)obj->index);
+                  }
                 LOG_TRACE ("adding VX_CONTROL object " FORMAT_RLL "\n",
                            obj->handle.value);
                 dwg->header_vars.VX_TABLE_RECORD
diff --git a/src/in_dxf.c b/src/in_dxf.c
index 588b9bf..83c800c 100644
--- a/src/in_dxf.c
+++ b/src/in_dxf.c
@@ -10010,6 +10010,73 @@ postprocess_TEXTlike (Dwg_Object *obj)
   LOG_TRACE ("%s.dataflags => 0x%x\n", obj->name, dataflags);
 }
 
+/* The handle of the *Model_Space BLOCK_RECORD of an ASCII DXF, by a quick
+   scan, or 0x1F. object[0] is created as *Model_Space before the TABLES are
+   read; with the fixed 0x1F it collided with other objects of DXFs where
+   *Model_Space has another handle (gh209_1: *Model_Space 2, LAYER table 1F):
+   "Duplicate handle 1F", two model spaces, entities on wrong layers. */
+static BITCODE_RLL
+dxf_prescan_mspace_handle (const Bit_Chain *restrict dat)
+{
+  const char *p = (const char *)dat->chain;
+  const char *pend = p + dat->size;
+  if (dat->opts & DWG_OPTS_DXFB)
+    return 0x1F;
+  while (p < pend)
+    {
+      const char *q = NULL;
+      const char *r;
+      const char *line;
+      BITCODE_RLL h = 0;
+      int is_ms = 0;
+      // no memmem: not in MinGW
+      for (r = p; r + 12 <= pend; r++)
+        if (*r == 'B' && !memcmp (r, "BLOCK_RECORD", 12))
+          {
+            q = r;
+            break;
+          }
+      if (!q)
+        break;
+      // the code/value lines of this object, until the next code 0
+      line = q + 12;
+      while (line < pend && (*line == '\r' || *line == '\n'))
+        line++;
+      while (line < pend)
+        {
+          int code;
+          const char *val, *eol;
+          char *ep;
+          code = (int)strtol (line, &ep, 10);
+          if (ep == line)
+            break;
+          val = ep;
+          while (val < pend && *val != '\n')
+            val++;
+          val++;
+          if (val >= pend)
+            break;
+          eol = val;
+          while (eol < pend && *eol != '\n' && *eol != '\r')
+            eol++;
+          if (code == 0)
+            break;
+          if (code == 5)
+            h = strtoull (val, NULL, 16);
+          else if (code == 2 && eol - val == 12
+                   && !strncasecmp (val, "*Model_Space", 12))
+            is_ms = 1;
+          line = eol;
+          while (line < pend && (*line == '\r' || *line == '\n'))
+            line++;
+        }
+      if (is_ms && h)
+        return h;
+      p = q + 12;
+    }
+  return 0x1F;
+}
+
 int
 is_textlike (Dwg_Object *restrict obj)
 {
@@ -15474,7 +15541,7 @@ dwg_read_dxf (Bit_Chain *restrict dat, Dwg_Data *restrict dwg)
       LOG_TRACE ("%s.name = %s [TV 2]\n", dxfname, _obj->name);
       _obj->is_xref_ref = 1;
       obj->tio.object->is_xdic_missing = 1;
-      dwg_add_handle (&obj->handle, 0, 0x1F, obj);
+      dwg_add_handle (&obj->handle, 0, dxf_prescan_mspace_handle (dat), obj);
       LOG_TRACE ("%s.handle = (0.%d." FORMAT_HV ")\n", obj->name,
                  obj->handle.size, obj->handle.value);
       obj->tio.object->ownerhandle = dwg_add_handleref (dwg, 4, 1, NULL);
-- 
