+  if (o->scale.x == 0.0 && o->scale.y == 0.0 && o->scale.z == 0.0)
+    o->scale.x = o->scale.y = o->scale.z = 1.0;
+  if (o->extrusion.x == 0.0 && o->extrusion.y == 0.0
+      && o->extrusion.z == 0.0)
+    o->extrusion.z = 1.0;
+  return pair;
+
+invalid:
+  free (text);
+  free (vtext);
+  free (vfmt);
+  LOG_ERROR ("Invalid DXF code %d for TABLE", pair ? pair->code : -1);
+  if (pair)
+    dxf_free_pair (pair);
+  return NULL;
+#  undef TBL_SET_STR
+#  undef TBL_END_VALUE
+}
