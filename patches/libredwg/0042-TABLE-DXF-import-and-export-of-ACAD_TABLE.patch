diff --git a/src/encode.c b/src/encode.c
index 96c4716..af35319 100644
--- a/src/encode.c
+++ b/src/encode.c
@@ -2875,8 +2875,8 @@ dwg_encode (Dwg_Data *restrict dwg, Bit_Chain *restrict dat)
                   && (/*obj->fixedtype == DWG_TYPE_WIPEOUT (GH #244) || */
