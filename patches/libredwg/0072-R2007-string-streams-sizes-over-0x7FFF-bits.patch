From bf863dae311cf7d16952eff143d7f1de2f97727d Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Tue, 13 Oct 2026 10:11:20 +0900
Subject: [PATCH 072/116] R2007+ string streams: sizes over 0x7FFF bits

The size of the string stream before its has_strings bit was cast to a
RS, so with more than 32767 bits of strings (the classes of
aec_objects and gh44-error as R2018, about 30 classes in UTF-16) the
high RS was wrong and ACadSharp read the classes from a wrong place.

* src/bits.c (bit_write_strings_size): New, the RS size and with 0x8000
the RS with the high bits before it.
* src/bits.h: Declare it.
* src/enc_macros.h (START_HANDLE_STREAM): Use it.
* src/encode.c (encode_header_vars, encode_classes): Likewise.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/bits.c       | 16 ++++++++++++++++
 src/bits.h       |  1 +
 src/enc_macros.h | 11 +++--------
 src/encode.c     | 29 ++++++++---------------------
 4 files changed, 28 insertions(+), 29 deletions(-)

diff --git a/src/bits.c b/src/bits.c
index 82cbd34..4efaa72 100644
--- a/src/bits.c
+++ b/src/bits.c
@@ -368,6 +368,22 @@ bit_write_RS (Bit_Chain *dat, BITCODE_RS value)
   bit_write_RC (dat, value >> 8);
 }
 
+/** Write the size in bits of the R2007+ string stream, which is read
+    backwards from its has_strings bit: one RS, or with 0x8000 set, the
+    high bits in a RS before it.
+ */
+void
+bit_write_strings_size (Bit_Chain *dat, size_t bits)
+{
+  if (bits > 0x7FFF)
+    {
+      bit_write_RS (dat, (BITCODE_RS)((bits >> 15) & 0xFFFF));
+      bit_write_RS (dat, (BITCODE_RS)((bits & 0x7FFF) | 0x8000));
+    }
+  else
+    bit_write_RS (dat, (BITCODE_RS)bits);
+}
+
 /** Read 1 raw short (BE).
  */
 BITCODE_RS
diff --git a/src/bits.h b/src/bits.h
index 7d8561f..d122ac8 100644
--- a/src/bits.h
+++ b/src/bits.h
@@ -113,6 +113,7 @@ void bit_write_RC (Bit_Chain *dat, unsigned char value);
 
 BITCODE_RS bit_read_RS (Bit_Chain *dat);
 void bit_write_RS (Bit_Chain *dat, BITCODE_RS value);
+void bit_write_strings_size (Bit_Chain *dat, size_t bits);
 BITCODE_BS bit_read_RS_BE (Bit_Chain *dat);
 void bit_write_RS_BE (Bit_Chain *dat, BITCODE_BS value);
 
diff --git a/src/enc_macros.h b/src/enc_macros.h
index de48f6c..fc0fa46 100644
--- a/src/enc_macros.h
+++ b/src/enc_macros.h
@@ -832,17 +832,12 @@
     LOG_INSANE ("-str_dat: %" PRIuSIZE " bits, chain %p, dat chain %p\n",     \
                 _str_bits, (void*)str_dat->chain, (void*)dat->chain);         \
     if (_str_bits) {                                                          \
-      BITCODE_RS _data_size = (BITCODE_RS)_str_bits;                          \
       bit_copy_chain (dat, str_dat);                                          \
-      if (_data_size & 0x8000) {                                              \
-        bit_write_RS (dat, (_data_size >> 15) & 0x7FFF);                      \
-        bit_write_RS (dat, (_data_size & 0x7FFF) | 0x8000);                   \
-      } else                                                                  \
-        bit_write_RS (dat, _data_size);                                       \
+      bit_write_strings_size (dat, _str_bits);                                \
       bit_write_B (dat, 1);                                                   \
       obj->has_strings = 1;                                                   \
-      LOG_TRACE ("-obj string footer: data_size %u, has_strings 1\n",         \
-                 (unsigned)_data_size);                                        \
+      LOG_TRACE ("-obj string footer: data_size %" PRIuSIZE                   \
+                 ", has_strings 1\n", _str_bits);                             \
     } else {                                                                  \
       bit_write_B (dat, 0);                                                   \
       obj->has_strings = 0;                                                   \
diff --git a/src/encode.c b/src/encode.c
index 6481333..3bf698d 100644
--- a/src/encode.c
+++ b/src/encode.c
@@ -2809,22 +2809,15 @@ encode_header_vars (Dwg_Data *restrict dwg, Bit_Chain *restrict dat,
       size_t main_end = bit_position (dat);
       size_t str_bits = bit_position (&str_dat);
       size_t hdl_bits = bit_position (&hdl_dat);
-      BITCODE_RS data_size = (BITCODE_RS)str_bits;
 
       // Append string stream data
       if (str_bits)
         bit_copy_chain (dat, &str_dat);
       // String footer: data_size(RS) + endbit(B)
-      if (data_size & 0x8000)
-        {
-          bit_write_RS (dat, (data_size >> 15) & 0x7FFF);
-          bit_write_RS (dat, (data_size & 0x7FFF) | 0x8000);
-        }
-      else
-        bit_write_RS (dat, data_size);
+      bit_write_strings_size (dat, str_bits);
       bit_write_B (dat, str_bits ? 1 : 0); // endbit
-      LOG_TRACE ("header string stream data_size: %u endbit: %d\n",
-                 (unsigned)data_size, str_bits ? 1 : 0);
+      LOG_TRACE ("header string stream data_size: %" PRIuSIZE " endbit: %d\n",
+                 str_bits, str_bits ? 1 : 0);
 
       // bitsize: 32 (bitsize field) + main + string + footer
       bitsize = (BITCODE_RL)(32 + bit_position (dat) - data_start * 8);
@@ -2978,7 +2971,7 @@ encode_classes (Dwg_Data *restrict dwg, Bit_Chain *restrict dat)
     // Phase 2: write string data
     {
       size_t str_start = bit_position (dat);
-      BITCODE_RS data_size;
+      size_t data_size;
       for (j = 0; j < dwg->num_classes; j++)
         {
           Dwg_Class *klass = &dwg->dwg_class[j];
@@ -2990,17 +2983,11 @@ encode_classes (Dwg_Data *restrict dwg, Bit_Chain *restrict dat)
             bit_write_T (dat, klass->dxfname);
         }
       // Phase 3: string stream footer
-      data_size = (BITCODE_RS)(bit_position (dat) - str_start);
-      if (data_size & 0x8000)
-        {
-          bit_write_RS (dat, (data_size >> 15) & 0x7FFF);
-          bit_write_RS (dat, (data_size & 0x7FFF) | 0x8000);
-        }
-      else
-        bit_write_RS (dat, data_size);
+      data_size = bit_position (dat) - str_start;
+      bit_write_strings_size (dat, data_size);
       bit_write_B (dat, 1); // endbit: has strings
-      LOG_TRACE ("string stream data_size: %u endbit: 1\n",
-                 (unsigned)data_size);
+      LOG_TRACE ("string stream data_size: %" PRIuSIZE " endbit: 1\n",
+                 data_size);
     }
   }
   else
