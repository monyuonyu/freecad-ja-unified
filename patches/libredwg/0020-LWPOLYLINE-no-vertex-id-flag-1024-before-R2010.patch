From 7e2811bd65a0e961f949eae63c58e0ee653f46fa Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Thu, 8 Oct 2026 10:46:12 +0900
Subject: [PATCH 020/122] LWPOLYLINE: no vertex id flag (1024) before R2010

R2010+ LWPOLYLINEs written as R2000 kept the flag; ACadSharp then read a
num_vertexids that is not there and lost the points (Dynblocks.dwg).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/dwg.spec | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/dwg.spec b/src/dwg.spec
index 4789618..5897173 100644
--- a/src/dwg.spec
+++ b/src/dwg.spec
@@ -5542,6 +5542,12 @@ DWG_ENTITY (LWPOLYLINE)
   VALUE_BS (((FIELD_VALUE (flag) & 256) ? 128 : 0) + (FIELD_VALUE (flag) & 512 ? 1 : 0), 70);
   FIELD_BD (const_width, 43);
 #else
+  ENCODER {
+    // the vertex ids are R2010+: before, 1024 is no flag, and other readers
+    // (ACadSharp) read a num_vertexids that is not there.
+    if (dat->version < R_2010b && (FIELD_VALUE (flag) & 1024))
+      FIELD_VALUE (flag) &= ~1024;
+  }
   FIELD_BS (flag, 70); // 512 closed, 256 plinegen, 4 constwidth, 8 elevation, 2 thickness
                        // 1 extrusion, 16 num_bulges, 1024 vertexidcount, 32 numwidths
   LOG_FLAG_LWPOLYLINE
-- 
2.43.0

