From cf9e911f85708bcf7d5befb7aa6f85c6526029d9 Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Wed, 7 Oct 2026 22:40:42 +0900
Subject: [PATCH 02/54] DIMENSION_ANG2LN: keep the DXF meaning of def_pt (10)
 and xline2end_pt (16)

R13+ stores 16-pt (2RD), 13, 14, 15, 10-pt (3BD) (ODA 20.4.27).  The 2RD was
read into def_pt and the last 3BD into xline2end_pt, so dwg2dxf wrote the
arc point as group 10 and the end of the second extension line as group 16,
and DXF readers drew the dimension arc in the wrong place.  The R11 branch
already used the DXF meaning.  Read the same bits into the fields of the same
DXF codes, and write 13-16 in DXF order.  Checked on AutoCAD's R2018 sample
(ACadSharp samples/sample_AC1032.dwg, handle 516): group 10 now is the end
of the second line, group 16 the point on the arc next to the text.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/dwg.spec | 22 +++++++++++++++++-----
 1 file changed, 17 insertions(+), 5 deletions(-)

diff --git a/src/dwg.spec b/src/dwg.spec
index 79c63f5..1073a94 100644
--- a/src/dwg.spec
+++ b/src/dwg.spec
@@ -1922,13 +1922,25 @@ DWG_ENTITY (DIMENSION_ANG2LN)
       FIELD_HANDLE (dimstyle, 2, 0);
   }
   LATER_VERSIONS {
+    // ODA 20.4.27 order: 16-pt (2RD), 13, 14, 15, 10-pt (3BD).
+    // Keep the DXF meaning, as for R11 above: def_pt is DXF 10 (end of the
+    // 2nd extension line, written in AcDbDimension), xline2end_pt is DXF 16
+    // (point on the dimension arc, OCS). The 2RD used to be stored in
+    // def_pt and the last 3BD in xline2end_pt, so DXF output swapped 10/16.
+    DXF {
+      FIELD_3BD (xline1start_pt, 13);
+      FIELD_3BD (xline1end_pt, 14);
+      FIELD_3BD (xline2start_pt, 15);
+      FIELD_3BD (xline2end_pt, 16);
+    } else {
+      FIELD_2RD (xline2end_pt, 16);
+      FIELD_3BD (xline1start_pt, 13);
+      FIELD_3BD (xline1end_pt, 14);
+      FIELD_3BD (xline2start_pt, 15);
 #ifndef IS_JSON
-    FIELD_2RD (def_pt, 0);
+      FIELD_3BD (def_pt, 10);
 #endif
-    FIELD_3BD (xline1start_pt, 13);
-    FIELD_3BD (xline1end_pt, 14);
-    FIELD_3BD (xline2start_pt, 15);
-    FIELD_3BD (xline2end_pt, 16);
+    }
 
     COMMON_ENTITY_HANDLE_DATA;
     FIELD_HANDLE (dimstyle, 5, 0);
-- 
