From bf08eaef2da06b016460ec6b9947d425dced7dfe Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Thu, 8 Oct 2026 08:50:10 +0900
Subject: [PATCH 003/116] ENC: read the true color RGB before the transparency

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/common_entity_data.spec | 19 +++++++++++--------
 1 file changed, 11 insertions(+), 8 deletions(-)

diff --git a/src/common_entity_data.spec b/src/common_entity_data.spec
index f8518b0..d2a4535 100644
--- a/src/common_entity_data.spec
+++ b/src/common_entity_data.spec
@@ -430,6 +430,17 @@
         LOG_TRACE (" color.flag: 0x%x\n", _ent->color.flag);
 #endif
       flags = _ent->color.flag;
+      // The RGB comes first, then the transparency (ODA 2.11 ENC, and
+      // ACadSharp). With both, reading the transparency first swapped them:
+      // a true color line got index 183 and an RGB of 0x01000000.
+      if ((flags & 0x80) && !(flags & 0x40)) // and not a reference
+        {
+          DXF {
+            VALUE_BL (_ent->color.rgb & 0x00ffffff, 420);
+          } else {
+            FIELD_BLx (color.rgb, 420); // ODA bug, documented as BS
+          }
+        }
       if (flags & 0x20)
         {
 #ifdef IS_ENCODER
@@ -458,14 +469,6 @@
           FIELD_HANDLE (color.handle, 0, 430); // DBCOLOR 1E9F74 => 1F05B9 lgtm[cpp/use-after-free] codeql[cpp/use-after-free]
 #endif
         }
-      else if (flags & 0x80) // and not a reference
-        {
-          DXF {
-            VALUE_BL (_ent->color.rgb & 0x00ffffff, 420);
-          } else {
-            FIELD_BLx (color.rgb, 420); // ODA bug, documented as BS
-          }
-        }
       if ((flags & 0x41) == 0x41)
         {
           FIELD_TV (color.name, 430);
-- 
2.43.0

