From 79aa7a3ebda0d5efa972309c32932b6086de5c7b Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Thu, 8 Oct 2026 09:39:28 +0900
Subject: [PATCH 012/116] RENDERSETTINGS: R2013 has the class version and
 has_predefined at the end

The R2013 special case skipped class_version and read has_predefined after
display_index, so every R2013 RAPIDRTRENDERSETTINGS was shifted by 10 bits
(garbage render levels and filter sizes). Decoded bits of AutoCAD's R2013
presets (gh44-error.dwg, gh109_1.dwg) have class_version 2, then the same
layout as R2018: rapidrt_version 3, render levels 1/5/10, render times
10/60/720 min, 3x3 Gaussian filter, has_predefined 1 at the end.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/dwg2.spec | 18 +++++-------------
 1 file changed, 5 insertions(+), 13 deletions(-)

diff --git a/src/dwg2.spec b/src/dwg2.spec
index 2f7cbbe..2e7dea3 100644
--- a/src/dwg2.spec
+++ b/src/dwg2.spec
@@ -2584,11 +2584,9 @@ DWG_OBJECT_END
 
 #define AcDbRenderSettings_fields                                             \
     SUBCLASS (AcDbRenderSettings)                                             \
-    VERSION (R_2013) { /* version 0x1f */                                     \
-      VALUE_BL (_obj->class_version + 1, 90)                                  \
-    } else {                                                                  \
-      FIELD_BL (class_version, 90);                                           \
-    }                                                                         \
+    /* R2013 too: AutoCAD's R2013 and R2018 RAPIDRTRENDERSETTINGS both */   \
+    /* have the class version 2 here, and has_predefined at the end. */      \
+    FIELD_BL (class_version, 90);                                             \
     FIELD_T (name, 1);                                                        \
     FIELD_B (fog_enabled, 290);                                               \
     FIELD_B (fog_background_enabled, 290);                                    \
@@ -2596,10 +2594,7 @@ DWG_OBJECT_END
     FIELD_B (environ_image_enabled, 290);                                     \
     FIELD_T (environ_image_filename, 1);                                      \
     FIELD_T (description, 1);                                                 \
-    FIELD_BL (display_index, 90);                                             \
-    VERSION (R_2013) {                                                        \
-      FIELD_B (has_predefined, 290);                                          \
-    }
+    FIELD_BL (display_index, 90)
 
 DWG_OBJECT (RENDERSETTINGS)
   AcDbRenderSettings_fields;
@@ -2667,10 +2662,7 @@ DWG_OBJECT (RAPIDRTRENDERSETTINGS)
   FIELD_BL (filter_type, 70);
   FIELD_BD (filter_width, 40);
   FIELD_BD (filter_height, 40);
-  VERSION (R_2013)
-    {}
-  else
-    FIELD_B (has_predefined, 290); // when RENDERSETTINGS does not handle it
+  FIELD_B (has_predefined, 290);
   START_OBJECT_HANDLE_STREAM;
 DWG_OBJECT_END
 
-- 
