From 7444624a3b6323a181cd138e6dd9442df971b1ec Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Mon, 12 Oct 2026 08:32:46 +0900
Subject: [PATCH 37/37] in_dxf: SHAPE name (2) is not the shape number

dynapi has style_id as DXF 2, and the generic importer stored the string
pointer as the number: random on every run and platform (Linux and Windows
dxf2dwg wrote different DWGs). The number in the SHX file cannot be found
without reading the SHX; keep 0.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/in_dxf.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/in_dxf.c b/src/in_dxf.c
index 52c7dba..94c736a 100644
--- a/src/in_dxf.c
+++ b/src/in_dxf.c
@@ -12310,6 +12310,15 @@ static __nonnull ((1, 2, 3, 4)) Dxf_Pair *new_object (
               else
                 goto search_field;
             }
+          else if (obj->fixedtype == DWG_TYPE_SHAPE && pair->code == 2)
+            {
+              // the shape name: its number in the SHX file is unknown to us
+              // (we don't read SHX). The generic importer took dynapi's
+              // style_id (DXF 2) and stored the string pointer as the number,
+              // different on every run and platform.
+              LOG_TRACE ("SHAPE.name %s ignored [2]\n", pair->value.s.ptr);
+              goto next_pair;
+            }
           else if (obj->fixedtype == DWG_TYPE_HATCH)
             {
               // the elevation point comes before the paths (91); after them
-- 
