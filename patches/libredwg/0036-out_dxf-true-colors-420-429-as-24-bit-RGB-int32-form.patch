From efbd9a79e13936e00ce1c220ee8dfa5cd7932a9e Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Mon, 12 Oct 2026 08:15:03 +0900
Subject: [PATCH 036/116] out_dxf: true colors (420-429) as 24-bit RGB, int32
 formats

DXF 420 is the RGB (AutoCAD: 3355443), LibreDWG wrote the DWG value with
the 0xC2 method byte (3258135347), with %li: negative on Windows (long is
32-bit), undefined with uint32 everywhere. Linux and Windows dwg2dxf now
write the same DXF.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/out_dxf.c | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/src/out_dxf.c b/src/out_dxf.c
index 3f36178..3521c03 100644
--- a/src/out_dxf.c
+++ b/src/out_dxf.c
@@ -368,6 +368,13 @@ static void dxf_CMC (Bit_Chain *restrict dat, Dwg_Color *restrict color,
               {                                                               \
                 fprintf (dat->fh, "%9i\r\n", _si);                            \
               }                                                               \
+            else if (420 <= dxf && dxf < 430)                                 \
+              {                                                               \
+                /* true colors are 24-bit RGB in DXF, as AutoCAD writes */    \
+                /* them: no 0xC2 method byte of the DWG (3258135347 was */    \
+                /* 0xC2333333 for 3355443) */                                 \
+                fprintf (dat->fh, "%9i\r\n", _si & 0xffffff);                 \
+              }                                                               \
             else                                                              \
               fprintf (dat->fh, "%s\r\n", buf);                               \
           }                                                                   \
@@ -3358,11 +3365,11 @@ dxf_format (int code)
   if (410 <= code && code <= 419)
     return "%s";
   if (420 <= code && code <= 429)
-    return "%9li"; // int32_t
+    return "%9i"; // int32_t, not long: negative on Windows, UB with uint32
   if (430 <= code && code <= 439)
     return "%s";
   if (440 <= code && code <= 449)
-    return "%9li"; // int32_t
+    return "%9i"; // int32_t
   if (450 <= code && code <= 459)
     return "%12li"; // long
   if (460 <= code && code <= 469)
