From b62130e73a145f9e4a92a5c677c2a1388c8297f6 Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Thu, 8 Oct 2026 08:52:08 +0900
Subject: [PATCH 09/54] 3DSOLID & co: no leading ACIS empty bit since R2013,
 read the R2007+ unknown BL

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/dwg.h         |  1 +
 src/dwg_spec_shared.h | 14 ++++++++++++++
 src/dynapi.c          | 18 ++++++++++++++++++
 3 files changed, 33 insertions(+)

diff --git a/include/dwg.h b/include/dwg.h
index e18eeea..5e85895 100644
--- a/include/dwg.h
+++ b/include/dwg.h
@@ -3006,6 +3006,7 @@ typedef struct _dwg_3DSOLID_material
   BITCODE_BS revision_minor2;                                           \
   BITCODE_RC revision_bytes[9];                                         \
   BITCODE_BL end_marker;                                                \
+  BITCODE_BL unknown_2007; /* R2007+, before the R2013 revision guid */   \
   BITCODE_H history_id;                                                 \
   BITCODE_B has_revision_guid;                                          \
   BITCODE_B acis_empty_bit
diff --git a/src/dwg_spec_shared.h b/src/dwg_spec_shared.h
index f53f3c1..50761b7 100644
--- a/src/dwg_spec_shared.h
+++ b/src/dwg_spec_shared.h
@@ -184,6 +184,13 @@ decode_3dsolid (Bit_Chain *dat, Bit_Chain *hdl_dat, Dwg_Object *restrict obj,
   int acis_data_idx;
   int error = 0;
 
+  // R2013+: the SAB is in the AcDsPrototype_1b DataStorage section, and the
+  // entity starts directly with the wireframe data, without ACIS empty bit.
+  SINCE (R_2013b)
+    {
+      FIELD_VALUE (acis_empty) = 1;
+      return error;
+    }
   FIELD_B (acis_empty, 290);
   if (dat->byte >= dat->size)
     return DWG_ERR_VALUEOUTOFBOUNDS;
@@ -537,6 +544,13 @@ free_3dsolid (Dwg_Object *restrict obj, Dwg_Entity_3DSOLID *restrict _obj)
         END_REPEAT (materials);                                               \
       }                                                                       \
     }                                                                         \
+  /* ODA 20.4.41 "R2007+: Unknown BL". Missing it shifted the R2013 */       \
+  /* revision guid by 2 bits: AutoCAD's R2018 3DSOLID ends exactly after */  \
+  /* end_marker with it. */                                                   \
+  SINCE (R_2007a)                                                             \
+  {                                                                           \
+    FIELD_BL (unknown_2007, 0);                                               \
+  }                                                                           \
   SINCE (R_2013b)                                                             \
   {                                                                           \
     FIELD_B (has_revision_guid, 0);                                           \
