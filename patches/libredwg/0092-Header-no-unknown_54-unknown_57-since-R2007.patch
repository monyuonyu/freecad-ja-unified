From baa09095ae87155daed8266a94cdca5415c26551 Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Tue, 13 Oct 2026 11:58:43 +0900
Subject: [PATCH 092/122] Header: no unknown_54 - unknown_57 since R2007

In all R2007+ drawings of AutoCAD (example_2007 - example_2018,
sample_AC1021 - sample_AC1032) the string stream starts right after
SHADOWPLANELOCATION: these 4 BS were read from the strings (always 1,
180, 36874, 32843) and written as 56 more bits of data.

* src/header_variables.spec: unknown_54 - unknown_57 only R14 - R2004.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/header_variables.spec | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/header_variables.spec b/src/header_variables.spec
index 54b0d07..fa55e9f 100644
--- a/src/header_variables.spec
+++ b/src/header_variables.spec
@@ -714,7 +714,10 @@
       FIELD_BD (SHADOWPLANELOCATION, 40); // z height
     }
 
-  SINCE (R_14)
+  // Not in R2007+: AutoCAD's string stream starts right after
+  // SHADOWPLANELOCATION (example_2007 - example_2018, sample_AC1021 -
+  // sample_AC1032); we read 1, 180, 36874, 32843 from the strings there.
+  VERSIONS (R_14, R_2004)
     {
       FIELD_BS (unknown_54, 0); /* (type 5/6 only) these do not seem to be required */
       FIELD_BS (unknown_55, 0);
-- 
2.43.0

