From 5a418c8a69b368546e9988d488fdb11e6876a559 Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Thu, 8 Oct 2026 08:51:05 +0900
Subject: [PATCH 007/122] MLINESTYLE: write the linetype index when converting
 R2018+ to earlier

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/dwg.spec |  9 +++++++++
 src/encode.c | 28 ++++++++++++++++++++++++++++
 2 files changed, 37 insertions(+)

diff --git a/src/dwg.spec b/src/dwg.spec
index 34d8736..96b4343 100644
--- a/src/dwg.spec
+++ b/src/dwg.spec
@@ -4587,6 +4587,15 @@ DWG_OBJECT (MLINESTYLE)
                  VALUE_TFF ("", 6); break;
         }
 #else
+#  ifdef IS_ENCODER
+        // R2018+ to earlier: convert the linetype handle to the index
+        // (32767 BYLAYER, 32766 BYBLOCK, else the position in the
+        // LTYPE_CONTROL entries; AutoCAD's R2000 and R2018 saves agree).
+        // Without it every line was written as index 0, CONTINUOUS.
+        if (dat->from_version >= R_2018b)
+          _obj->lines[rcount1].lt_index = dwg_mlinestyle_ltindex (
+              dwg, _obj->lines[rcount1].lt_ltype);
+#  endif
         SUB_FIELD_BSd (lines[rcount1], lt_index, 6);
 #endif
       }
diff --git a/src/encode.c b/src/encode.c
index 0b2ea92..14e715c 100644
--- a/src/encode.c
+++ b/src/encode.c
@@ -4629,6 +4629,34 @@ fixup_invalid_tag (const Bit_Chain *restrict dat, char *restrict tag)
 }
 
 #define HANDLE_STREAM_ERROR_CLEANUP
+/* MLINESTYLE.lines[].lt_ltype: the R2018+ linetype handle as the index used
+   until R2018: 32767 BYLAYER, 32766 BYBLOCK, else the position in the
+   LTYPE_CONTROL entries (AutoCAD's R2000 and R2018 saves of the same drawing
+   agree: the BYLAYER handle is index 32767). */
+static BITCODE_BSd
+dwg_mlinestyle_ltindex (Dwg_Data *restrict dwg, BITCODE_H ltype)
+{
+  Dwg_Object *ctrl;
+  Dwg_Object_LTYPE_CONTROL *lc;
+  BITCODE_RLL ref;
+  if (!ltype)
+    return 32767;
+  ref = ltype->absolute_ref;
+  ctrl = dwg_get_first_object (dwg, DWG_TYPE_LTYPE_CONTROL);
+  lc = (ctrl && ctrl->tio.object) ? ctrl->tio.object->tio.LTYPE_CONTROL
+                                  : NULL;
+  if (!lc)
+    return 32767;
+  if (lc->bylayer && lc->bylayer->absolute_ref == ref)
+    return 32767;
+  if (lc->byblock && lc->byblock->absolute_ref == ref)
+    return 32766;
+  for (BITCODE_BS i = 0; lc->entries && i < lc->num_entries; i++)
+    if (lc->entries[i] && lc->entries[i]->absolute_ref == ref)
+      return (BITCODE_BSd)i;
+  return 32767;
+}
+
 #include "dwg.spec"
 #undef HANDLE_STREAM_ERROR_CLEANUP
 // clang-format on
-- 
