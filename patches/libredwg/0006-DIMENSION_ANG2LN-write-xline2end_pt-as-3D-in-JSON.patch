From 4a12d900df9f240a9d537b938c0caba6c910c527 Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Thu, 8 Oct 2026 08:02:35 +0900
Subject: [PATCH 06/37] DIMENSION_ANG2LN: write xline2end_pt as 3D in JSON

The previous change wrote xline2end_pt as 2RD (as stored in the DWG) in JSON
too, but in_json expects the 3D struct field: "JSON 3DPOINT must be ARRAY of
size 3", and the rest of the import failed (json.test: 0 entities after
dwgread -O json | dwgwrite).  Write it as 3BD in JSON.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/dwg.spec | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/dwg.spec b/src/dwg.spec
index 62d6d2e..34d8736 100644
--- a/src/dwg.spec
+++ b/src/dwg.spec
@@ -1933,7 +1933,11 @@ DWG_ENTITY (DIMENSION_ANG2LN)
       FIELD_3BD (xline2start_pt, 15);
       FIELD_3BD (xline2end_pt, 16);
     } else {
+#ifdef IS_JSON
+      FIELD_3BD (xline2end_pt, 16); // in_json expects the 3D struct field
+#else
       FIELD_2RD (xline2end_pt, 16);
+#endif
       FIELD_3BD (xline1start_pt, 13);
       FIELD_3BD (xline1end_pt, 14);
       FIELD_3BD (xline2start_pt, 15);
-- 
2.43.0

