From 7d39a919dcf75198b141658a64fe5e252a40b058 Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Tue, 13 Oct 2026 10:11:35 +0900
Subject: [PATCH 074/122] R2007+ TU strings without the terminating 0

AutoCAD writes the length and the UTF-16 chars of a TU string without
a terminating 0 (the NOD of aec_objects: 69 names, 69 * 16 bits less
string stream than ours).

* src/bits.c (bit_write_TU): Without the 0.
(bit_write_T): Use it for the converted TV.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/bits.c | 10 +++-------
 1 file changed, 3 insertions(+), 7 deletions(-)

diff --git a/src/bits.c b/src/bits.c
index 4efaa72..41bd17a 100644
--- a/src/bits.c
+++ b/src/bits.c
@@ -2454,11 +2454,7 @@ bit_write_T (Bit_Chain *restrict dat, BITCODE_T restrict s)
                     }
                 }
               *ws = 0;
-              // bit_write_TU (dat, orig);
-              length = (ws - orig) + 1;
-              bit_write_BS (dat, (BITCODE_BS)length);
-              for (i = 0; i < length; i++)
-                bit_write_RS (dat, orig[i]);
+              bit_write_TU (dat, orig);
               free (orig);
             }
         }
@@ -2735,8 +2731,9 @@ bit_write_TU (Bit_Chain *restrict dat, BITCODE_TU restrict chain)
 {
   size_t i, length;
 
+  // without the terminating 0, as AutoCAD
   if (chain)
-    length = bit_wcs2len (chain) + 1;
+    length = bit_wcs2len (chain);
   else
     length = 0;
   if (length > UINT16_MAX)
@@ -2744,7 +2741,6 @@ bit_write_TU (Bit_Chain *restrict dat, BITCODE_TU restrict chain)
       loglevel = dat->opts & DWG_OPTS_LOGLEVEL;
       LOG_WARN ("Overlong string truncated (len=%" PRIuSIZE ")", length);
       length = UINT16_MAX;
-      chain[UINT16_MAX - 1] = '\0';
     }
 
   bit_write_BS (dat, (BITCODE_BS)length);
-- 
