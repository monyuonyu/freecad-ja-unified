From 918e5e21caa86a1f4a0d334c88ff5e6cac33cdf9 Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Mon, 12 Oct 2026 15:12:19 +0900
Subject: [PATCH 050/122] out_dxf: TABLESTYLE in R13/R14 DXF when the drawing
 has it

sample_AC1014 has tables and their TABLESTYLE; the R14 DXF dropped it and
the tables lost their style name (STANDARD) via DXF.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/out_dxf.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/out_dxf.c b/src/out_dxf.c
index 9004e13..3f6932c 100644
--- a/src/out_dxf.c
+++ b/src/out_dxf.c
@@ -3352,7 +3352,9 @@ decl_dxf_process_INSERT (MINSERT)
 #  if defined DEBUG_CLASSES
           return dwg_dxf_TABLESTYLE (dat, obj);
 #  else
-          if (dat->version >= R_2000)
+          // an R13/R14 DWG with tables has its TABLESTYLE: keep it, else
+          // the tables lost their style name (STANDARD) via DXF
+          if (dat->version >= R_2000 || dat->from_version < R_2000)
             return dwg_dxf_TABLESTYLE (dat, obj);
           else
             {
