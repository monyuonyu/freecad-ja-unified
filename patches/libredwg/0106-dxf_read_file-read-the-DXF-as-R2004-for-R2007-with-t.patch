From 34ec6c5966c9318323da69c892fa8bca13aadc79 Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Wed, 14 Oct 2026 20:19:15 +0900
Subject: [PATCH 106/116] dxf_read_file: read the DXF as R2004 for R2007+, with
 the UTF-8 strings

The encoder of R2007+ takes the strings of a DXF as UTF-8 (bit_write_T,
not IS_FROM_TU), but in_dxf and dynapi made TU strings of most of them
when the target version was R2007+: written as UTF-8 again, the names
were cut to their first char (the block ALIGNMENT_PARAMETER as "A", the
APPIDs of the EED), and ACadSharp lost the entities in these blocks.
DXF to R2010-R2018 lost 11007 of 59883 entities, with 47757 changed
values. Read the DXF as for R2004 (dat.version stays R2007+, so the
strings stay UTF-8), then set the R2007+ version again.

* src/dwg.c (dxf_read_file): Read with header.version R_2004 for R2007+.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/dwg.c | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/src/dwg.c b/src/dwg.c
index 25c33b9..413b2e1 100644
--- a/src/dwg.c
+++ b/src/dwg.c
@@ -374,7 +374,10 @@ dxf_read_file (const char *restrict filename, Dwg_Data *restrict dwg)
   version = dwg->header.version;
   memset (dwg, 0, sizeof (Dwg_Data));
   dwg->opts = loglevel | DWG_OPTS_INDXF;
-  dwg->header.version = version;
+  /* The DXF strings stay UTF-8, as the encoder of R2007+ expects them from
+     DXF (see bit_write_T). But in_dxf and dynapi make TU strings, when the
+     version is R2007+: read as R2004, then the R2007+ version again. */
+  dwg->header.version = version >= R_2007a ? R_2004 : version;
 
   memset (&dat, 0, sizeof (Bit_Chain));
 #  ifdef HAVE_SYS_STAT_H
@@ -390,7 +393,7 @@ dxf_read_file (const char *restrict filename, Dwg_Data *restrict dwg)
   dat.byte = 0;
   dat.bit = 0;
   dat.from_version = dwg->header.from_version;
-  dat.version = dwg->header.version;
+  dat.version = version;
   dat.opts = dwg->opts;
 
   size = fread (dat.chain, sizeof (char), dat.size, fp);
@@ -453,6 +456,8 @@ ENDSEC
     }
   else
     error = dwg_read_dxf (&dat, dwg);
+  if (version >= R_2007a && dwg->header.version == R_2004)
+    dwg->header.version = version;
 
   dwg->opts |= (DWG_OPTS_INDXF | loglevel);
   if (error >= DWG_ERR_CRITICAL)
